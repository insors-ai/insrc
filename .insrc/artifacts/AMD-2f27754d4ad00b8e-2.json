    "amendment": {
      "type": "sharedContract.fieldAdd",
      "contractId": "sc1",
      "field": {
        "name": "RequirementIds.parse result",
        "type": "{ date: string; hash8: string; story?: number | undefined; fr: number } | undefined",
        "optional": false,
        "purpose": "Stored requirement ids carry only the date and the first 8 hash characters, so parse returns those parts (story and fr as numbers) instead of epicHash, ordinal and storyId."
      },
      "breaking": false
    },
    "rationale": "The interface sketch in sc1 cannot be implemented from stored requirement ids: they contain no full epic hash. The existing parseFrId result is what its tests and callers rely on.",
