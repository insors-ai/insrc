  "body": {
    "id": "AMD-2f27754d4ad00b8e-9",
    "hldBaseRunId": "wf-1792406752203-whj6zi",
    "amendment": {
      "type": "sharedContract.fieldAdd",
      "contractId": "sc3",
      "field": {
        "name": "Feedback.inReplyTo",
        "type": "string | undefined",
        "optional": true,
        "purpose": "The id of the feedback entry this entry replies to. A stored line can never be rewritten, so a reply is its own line that names its parent; the thread is built at read. An entry with no inReplyTo is a thread root."
      },
      "breaking": false
    },
    "rationale": "Feedback.feedback holds nested replies, but a stored line is immutable (k4), so a reply cannot be added to a parent that is already written. One optional field lets a reply be a separate immutable line; a3 (merge same-id lines) would weaken the integrity rule sc5 owns.",
    "proposedBy": {
      "workflow": "design.story",
      "runId": "wf-1792582680524-ox15vn",
      "storyId": "s5",
      "stepId": "s4"
    },
