    "id": "AMD-315d510cb28100e2-30",
    "epicSlug": "team-signoff-claim-based-workflow",
    "hldBaseRunId": "wf-1792177279312-j27596",
    "amendment": {
      "type": "sharedContract.methodAdd",
      "contractId": "sc1",
      "method": {
        "name": "TrackerPort.readIssueStatus",
        "signature": "readIssueStatus?(issue: IssueRef): PortResult<{ state: 'open' | 'closed'; labels: string[] }>",
        "optional": true
      },
      "capability": "status-read"
    },
    "rationale": "The HLD defers the issue-status read to this extend. syncTracker calls the GitHub CLI directly, so a non-GitHub tracker cannot be synced; adding one optional read and a status-read capability, listed in ALL_CAPABILITIES, lets one refresh serve every adapter. A tracker that lacks the capability is rejected when a refresh needs it (k8), never silently skipped.",
    "proposedBy": {
