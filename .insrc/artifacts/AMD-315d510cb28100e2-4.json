  "body": {
    "id": "AMD-315d510cb28100e2-4",
    "hldBaseRunId": "wf-1792177279312-j27596",
    "amendment": {
      "type": "sharedContract.fieldAdd",
      "contractId": "sc2",
      "field": {
        "name": "source.anchorKnown",
        "type": "boolean",
        "optional": false,
        "purpose": "States whether firstCommit and firstCommitTime are the true date the policy file first appeared on the default branch; false when history is too shallow to show it, in which case s7 must grandfather no artifact."
      },
      "breaking": false
    },
    "rationale": "A shallow clone cannot show when the policy file first appeared, and the HLD's grandfathering rule (artifacts approved before the file first appeared on the default branch) must not be applied with a substituted later date. The field is additive; no consumer Story has been designed yet, so nothing breaks.",
