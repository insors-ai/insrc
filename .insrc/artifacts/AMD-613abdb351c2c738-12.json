    "amendment": {
      "type": "sharedContract.fieldAdd",
      "contractId": "sc2",
      "breaking": false,
      "field": {
        "name": "holderGone",
        "type": "(lease: RepoLease) => boolean",
        "optional": true,
        "purpose": "optional last parameter of takeOver and reclaim: says the recorded holder window's process and the lease's CLI are gone; takeOver of a lease of the claim's own windowKey (a reloaded window) is taken at once, and another window's only after LEASE_TAKEOVER_MS without a heartbeat; the dispose of a window keeps its presence row, which ages out over PRESENCE_GRACE_MS"
      }
    },
    "rationale": "S003 made takeover and reclaim take the liveness check from the worker and added the same-windowKey rule, so a reload does not wait ten minutes. Built and approved in S003.",
