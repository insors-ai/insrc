      "breaking": false,
      "field": {
        "name": "actRetryNow",
        "type": "act(seq: number, action: 'retry-now') => { readonly ok: true } | { readonly ok: false; readonly note: string }",
        "optional": false,
        "purpose": "act also accepts 'retry-now': a retrying message becomes due at once (store.retryNow) and runs at the next tick; any other row is refused with a note"
