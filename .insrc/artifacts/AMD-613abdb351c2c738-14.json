    "amendment": {
      "type": "sharedContract.fieldAdd",
      "contractId": "sc4",
      "breaking": false,
      "field": {
        "name": "runnerNote",
        "type": "QueuedTurnRunner.note?(message: QueuedMessage, text: string): void",
        "optional": true,
        "purpose": "optional member of QueuedTurnRunner: the worker asks the chat host to say one line in the message's chat when it gives up writing a message's outcome after BUSY_GIVE_UP_MS (60 s), asking the user to reload the window"
      }
    },
    "rationale": "S004 bounded the busy outcome write at 60 s; the worker owns the store but only the chat host can speak in the chat. Additive and optional. Built and approved in S004.",
