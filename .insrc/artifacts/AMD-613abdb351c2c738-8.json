    "amendment": {
      "type": "sharedContract.fieldAdd",
      "contractId": "sc4",
      "breaking": false,
      "field": {
        "name": "onWaiting",
        "type": "(on: 'approval' | 'selection' | undefined) => void",
        "optional": true,
        "purpose": "third argument of QueuedTurnRunner.run: the chat host reports that the running queued message waits on an approval or selection card (undefined when none waits); the worker writes it with markWaiting so every window's outbox can show blockedBy"
      }
    },
    "rationale": "Only the chat host sees the cards; the worker is the only queue writer. A callback beside onSpawn, which the runner already receives, carries the card state to the worker without the host holding the store. Additive and optional.",
    "proposedBy": {
      "workflow": "design.story",
