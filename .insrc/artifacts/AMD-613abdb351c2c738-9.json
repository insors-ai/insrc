    "amendment": {
      "type": "sharedContract.methodAdd",
      "contractId": "sc1",
      "method": {
        "name": "markNotDeliveredIfHead",
        "signature": "markNotDeliveredIfHead(seq: number): boolean",
        "purpose": "marks the head message not-delivered (its window is closed) in one transaction, only if it is still the head and still queued or retrying; false otherwise"
      }
    },
    "rationale": "S003 added it to the store: a message whose window closed must leave the queue head so the queue moves on, and it must be one guarded transaction. Built and approved in S003; the HLD sketch did not name it.",
