  "body": {
    "id": "AMD-86197ac660732ceb-2",
    "hldBaseRunId": "wf-1792588079400-heeqp4",
    "amendment": {
      "type": "sharedContract.fieldAdd",
      "contractId": "sc4",
      "field": {
        "name": "role",
        "type": "'admin' | 'code-indexing' | 'document-summary' | 'session' | 'unattributed' | 'shared-state' | undefined",
        "optional": true,
        "purpose": "What a thread is for, so daemon.status can tell the code-indexing and document-summary threads apart (the summary worker serves no request class) and mark the unattributed and shared-state session workers, which ThreadStatus.cls and session alone cannot."
      },
      "breaking": false
    },
    "rationale": "s4 ac4 lists each thread with its class and the session it serves, including the code-indexing and document-summary threads; ThreadStatus.cls is MethodClass | 'router', which gives both indexing threads the same value (the summary worker has no request class) and cannot mark the unattributed or shared-state session worker. One optional field fixes that without changing any existing field.",
    "proposedBy": {
      "workflow": "design.story",
      "runId": "wf-1793257999487-zc3lem",
      "storyId": "s4",
      "stepId": "s4"
    },
