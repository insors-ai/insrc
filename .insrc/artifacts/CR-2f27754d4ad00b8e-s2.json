            "location": "src/workflow/artifact-core/history.ts:123",
            "message": "openFeedback uses strictly greater timestamps instead of reader order. A later addressing entry with the same timestamp leaves earlier feedback open; the added test explicitly enforces this departure.",
            "expectationRef": "LLD contractDetails.api History.openFeedback: feedback is closed when a log entry after it in reader order lists its id or addresses 'all'."
          },
