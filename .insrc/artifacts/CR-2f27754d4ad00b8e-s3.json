          {
            "dimension": "quality",
            "severity": "MED",
            "location": "src/workflow/artifact-core/store.ts:249",
            "message": "Avoidable complexity: cascading completion temporarily substitutes the prior status, reconciles and serializes that artificial state, then reparses and patches the serialized status. This creates a second transition path that must stay synchronized with lifecycle validation. Pass cascade context into reconciliation so it validates and prepares the actual final state directly.",
            "counterpartRef": "",
            "confidence": "observation"
          },
          {
            "dimension": "quality",
            "severity": "MED",
            "location": "src/workflow/storage.ts:194",
            "message": "Duplication: reconcileLifecycleOf hashes both payloads to determine whether content changed, then reconcileLifecycle immediately repeats those hashes and the comparison. Each write therefore repeats recursive JSON normalization and hashing, adding avoidable CPU and allocation costs for large artifacts. Let reconciliation determine both the content change and revision number.",
            "counterpartRef": "reconcileLifecycle",
            "confidence": "observation"
          },
          {
            "dimension": "quality",
            "severity": "MED",
            "location": "src/workflow/gates.ts:1019",
            "message": "Error handling: restoreStamp restores the entire pre-service head, although mirrorLegacyReview may already have committed a review and appended its history entry before approval fails. Restoring those bytes removes the committed lifecycle review without undoing its log entry. Restore only legacy stamp fields through the queued store, preserving committed lifecycle changes and pending recovery.",
            "counterpartRef": "",
            "confidence": "breach"
