            "location": "src/workflow/artifact-core/lifecycle-service.ts:98",
            "message": "Correctness: member mutations occur before nextLifecycle validates the unit's transition. Completing a withdrawn Story whose roll-up passes can freeze its members and then throw, leaving members completed under a withdrawn Story. Validate the unit transition before cascading.",
            "counterpartRef": "",
            "confidence": "breach"
