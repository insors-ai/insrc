            "location": "src/workflow/artifact-core/lifecycle-service.ts:97",
            "message": "Member completion/reopening runs before nextLifecycle validates the unit's transition. Completing a withdrawn Story whose roll-up passes can freeze its documents and then throw when transitioning the Story. Validate the unit transition before mutating members.",
            "expectationRef": "LLD LifecycleService.apply postconditions and illegal-transition error path: an illegal operation writes and appends nothing."
          },
          {
            "dimension": "adherence",
            "severity": "HIGH",
            "location": "src/workflow/gates.ts:1015",
            "message": "The legacy approval stamp is written before service approval, and failure restores an earlier whole-file snapshot. This exposes approval before the lifecycle accepts it and can erase a review mirrored by the service or a concurrent update while leaving its log entry intact. Apply service approval first, then write the legacy stamp.",
            "expectationRef": "PLAN t10 and LLD approveWorkflowTarget postconditions: approval is applied through LifecycleService.apply; the legacy meta.approvedAt stamp follows."
          },
          {
            "dimension": "adherence",
            "severity": "MED",
            "location": "src/workflow/artifact-core/lifecycle-service.ts:125",
            "message": "apply releases the update queue before rereading the lifecycle and selecting the last log entry. A competing operation can run between those steps, so an approve call can return another operation's lifecycle and entry. Capture this operation's result while its update remains serialized.",
            "expectationRef": "LLD LifecycleService.apply return contract: returns the stored lifecycle and its log entry; concurrent operations run serially under ArtifactStore.update."
          }
        ]
