            "dimension": "conventions",
            "severity": "LOW",
            "location": "src/daemon/repo-convert.ts:27",
            "message": "RepoConvertParams declares `readonly repo?: string;` and `readonly mode?: ConversionMode;` (line 28) without the explicit `| undefined` that the documented exactOptionalPropertyTypes rule asks for. The neighbouring TrackerAttachParams uses the same short form, so the local code drifts here too, but the documented rule is the baseline.",
            "expectationRef": "strict-optional-indexed",
            "confidence": "breach"
          },
