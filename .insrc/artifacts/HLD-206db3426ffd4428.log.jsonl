140429	{"artifactId":"HLD-206db3426ffd4428","entry":{"id":"4f430b5cdd284be6f5f87bb066092a44c0a7d4821d727eadc806da55d88750b2","targetHeadHash":"59c923f1602372479b07693594d9a387227de4eca3f0e48b71c1df787bdd653b","actor":{"id":"agent:design-review-daemon","kind":"agent","properties":{"party":"daemon"}},"timestamp":"2026-11-09T08:19:52.041Z","operation":"review","revision":{"number":1,"contentHash":"a6576c1604d251391caca961404ee29e9d8be410e19a4fe69c1e5be52db835a9"},"outcome":{"result":"block","summary":"Design review consolidated-chat-progress-hld attempt 1","data":{"kind":"design-chunk-review","schemaVersion":1,"reviewId":"consolidated-chat-progress-hld","project":"/Users/subhagho/work/projects/insors/insrc","artifactId":"HLD-206db3426ffd4428","subject":{"project":"/Users/subhagho/work/projects/insors/insrc","artifactId":"HLD-206db3426ffd4428","kind":"HLD","canonicalPath":"/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/HLD-206db3426ffd4428.json","documentPath":"/Users/subhagho/work/projects/insors/insrc/docs/epics/show-long-running-task-progress-chat-E20261109206db342/HLD.md","reviewer":"daemon","workflow":{"kind":"epic","rootArtifactId":"DEF-206db3426ffd4428","requiredReferences":[{"role":"definition","artifactId":"DEF-206db3426ffd4428","path":"/Users/subhagho/work/projects/insors/insrc/docs/epics/show-long-running-task-progress-chat-E20261109206db342/DEF.md"}],"availableReferences":[],"notApplicableRoles":["PLAN","TASKS","BUILD","CR"]}},"submitted":{"artifactPath":"/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/HLD-206db3426ffd4428.json","attempt":1},"reviewer":"daemon","attempts":[{"number":1,"status":"incomplete","preparationKind":"planning","baseline":{"subjectFingerprints":{"canonical":"b53c540f7dcc66e1786ff979e6f39037d3f0d7ee1d550d8c4928f4b7432a8be1","document":"b8f60f2c5a6c8c883df6629470428a2c514e63f10aab605d30ef035010f2c63a"},"contentIdentity":"49b3d1db01555fad5c75d42b76c6d9abc9d0a3a50a3eeda9964e7df18bcca881","reviewedContent":{"canonical":"{\n  \"meta\": {\n    \"workflow\": \"design.epic\",\n    \"runId\": \"wf-1794211533808-ghbhlu\",\n    \"repoPath\": \"/Users/subhagho/work/projects/insors/insrc\",\n    \"createdAt\": \"2026-11-09T08:06:42.556Z\",\n    \"epicCreatedAt\": \"2026-11-09T06:00:04.355Z\",\n    \"attribution\": {\n      \"outputs\": [\n        {\n          \"role\": \"(client)\",\n          \"tier\": \"core\",\n          \"runner\": \"cli-codex\",\n          \"model\": \"unknown\"\n        }\n      ]\n    },\n    \"elapsedMs\": 68335,\n    \"repoIndexedAt\": null,\n    \"schemaVersion\": 1,\n    \"epicHash\": \"206db3426ffd4428\",\n    \"epicSlug\": \"show-long-running-task-progress-chat\",\n    \"authoredBy\": \"controller\",\n    \"revision\": 1\n  },\n  \"body\": {\n    \"summary\": {\n      \"audience\": \"technical\",\n      \"prose\": \"Executor delegates measure progress and the daemon coordinates how it is stored and delivered. VS Code keeps the progress message in its originating chat, and supported native clients receive the same verified state through MCP. Execution owners remain responsible for results, cancellation and activity.\"\n    },\n    \"frameworkSummary\": \"Use executor delegates with a shared daemon coordinator. Preserve legacy workflow and analyze IPC frames and existing execution authority. The coordinator feeds a typed VS Code adapter, request-scoped MCP notifications and one optional fallback observation schedule.\",\n    \"architectureShape\": \"The execution owner registers a trusted project, invocation, optional chat binding, task and attempt before detach. Delegates expose progress() without side effects and signal refresh when measurements change. The daemon verifies owner epoch and monotonic source sequence, separates meaningful revision from heartbeat/freshness, persists bounded state, then publishes sanitized snapshots. Project-scoped history supports read or subscribe from an opaque cursor. A lagging observer receives the latest snapshot and explicit resync instead of replaying ticks. A failed delegate refresh preserves last verified details with their original age. Stop-observation never cancels execution. Explicit cancellation is idempotent and pending until the executor confirms termination.\\n\\nThe Unix socket carries authorized typed observations additively beside existing progress/delta traffic. VS Code updates one row per task in its originating chat and shows attempt changes without stale finalization. A read-only details action resolves bounded result/log references in the owning project. The current session owner projects waiting-input before working before done across all live turns, unresolved decisions and owned tasks. Runtime lease renewal is independent of observers, meaningful measurement and repository locks. Closing a view detaches. Removing a conversation releases its retention and leaves authorized project results recoverable.\\n\\nNative MCP binds notifications to the valid caller token for that request. Use a monotonic delivery count without a total unless the total uses the same unit, and put trustworthy measurements in the sanitized label. Disconnect drops the observer, not the execution. For authorized opt-in fallback, a single fenced observer lease issues an initial snapshot then cadence slots anchored every 60 seconds. Host timers wait when available. Additional observers attach to the same schedule. Overlapping calls are suppressed, missed slots never burst, transport loss or rate limiting is visible, and healthy recovery restores the fixed interval. Unchanged responses still include bounded details and never generate duplicate narration. Third-party background lifetime and user-visible rendering are live-qualified separately.\\n\\nProducer-specific detail validation is registered by each adapter through the generic foundation contract. Bind fallback to a single renewable, fenced scheduler lease for each task across attempts. On observer transfer retain the cadence anchor and cursor, expire the old lease, and reject old in-flight replies. A runtime status tool reports one concise line or bounded structured delta per scheduled poll. It performs no model invocation and exposes no detailed logs in the polling payload.\",\n    \"sharedContracts\": [\n      {\n        \"id\": \"sc1\",\n        \"name\": \"Task identity and delegate observation\",\n        \"purpose\": \"One verified owner binds each task attempt to one project and originating invocation. An insrc chat may own many invocations, and an invocation may launch many tasks. Each task has one current attempt, with at most one active owner epoch. External host, daemon session and extension chat identities are optional distinct bindings, never inferred from one another. Both delivery paths use this delegate snapshot. The foundation is parameterized by producer-owned detail types, so it has no type dependency on later stories.\",\n        \"interfaceSketch\": \"interface TaskRef {\\n  readonly projectId: string;\\n  readonly invocationId: string;\\n  readonly taskId: string;\\n  readonly attempt: number;\\n}\\ninterface TaskOwnerFence {\\n  readonly ownerId: string;\\n  readonly ownerEpoch: string;\\n  readonly ownerSequence: number;\\n}\\ninterface TaskOrigin {\\n  readonly extensionChatId?: string;\\n  readonly daemonSessionId?: string;\\n  readonly nativeSessionId?: string;\\n  readonly turnId?: string;\\n}\\ntype ProgressKind = 'workflow' | 'analysis' | 'design-review' | 'code-review' | 'test';\\ninterface MeasuredCount {\\n  readonly unit: string;\\n  readonly completed: number;\\n  readonly total: number | null;\\n}\\ninterface DelegateMeasurement<Details extends { readonly kind: ProgressKind }> {\\n  readonly task: TaskRef;\\n  readonly owner: TaskOwnerFence;\\n  readonly kind: ProgressKind;\\n  readonly measuredAt: string;\\n  readonly meaningfulRevision: number;\\n  readonly lastMeaningfulAt: string | null;\\n  readonly phase: string;\\n  readonly activeUnit: string | null;\\n  readonly counts: readonly MeasuredCount[];\\n  readonly milestones: readonly string[];\\n  readonly controls: readonly ('cancel')[];\\n  readonly details: Details;\\n}\\ninterface TaskProgressDelegate<Details extends { readonly kind: ProgressKind }> {\\n  progress(task: TaskRef): Promise<DelegateMeasurement<Details> | null>;\\n}\",\n        \"ownedByStory\": \"s1\",\n        \"consumedByStories\": [\n          \"s2\",\n          \"s3\",\n          \"s4\",\n          \"s5\",\n          \"s6\"\n        ],\n        \"assumptions\": [\n          \"c3\",\n          \"c4\",\n          \"c5\",\n          \"c7\"\n        ]\n      },\n      {\n        \"id\": \"sc2\",\n        \"name\": \"Scoped snapshots, subscriptions and observation control\",\n        \"purpose\": \"The daemon authorizes every operation against server-verified caller/project/origin bindings, including logs and controls. A read yields a compact snapshot, meaningful-change indicator and revision cursor. Observer loss, executor state and session retention are independent. The shared coordinator arbitrates one optional fallback schedule per task, independent of all native subscriptions. Owner credentials, internal session identifiers and fencing fields remain server-side. A structured fallback lease governs the scheduler, without granting execution authority.\",\n        \"interfaceSketch\": \"type TaskState = 'queued' | 'running' | 'waiting' | 'paused' | 'completed' | 'failed' | 'cancelled' | 'interrupted' | 'unknown';\\ntype ProgressFreshness = 'live' | 'stale' | 'unavailable';\\ntype DeliveredMeasurement<Details extends { readonly kind: ProgressKind }> = Omit<DelegateMeasurement<Details>, 'owner'>;\\ninterface ProgressSnapshot<Details extends { readonly kind: ProgressKind }> {\\n  readonly task: TaskRef;\\n  readonly cursor: string;\\n  readonly state: TaskState;\\n  readonly freshness: ProgressFreshness;\\n  readonly measurement: DeliveredMeasurement<Details> | null;\\n  readonly lastOwnerActivityAt: string | null;\\n  readonly workerHealth: 'alive' | 'lost' | 'unknown';\\n  readonly cancellation: 'none' | 'pending';\\n  readonly resultRef?: string;\\n}\\ninterface ObservationReply<Details extends { readonly kind: ProgressKind }> {\\n  readonly snapshot: ProgressSnapshot<Details>;\\n  readonly disposition: 'changed' | 'unchanged' | 'resync';\\n  readonly schedule: 'native' | 'scheduled' | 'suspended' | 'stopped';\\n  readonly nextPollNotBefore?: string;\\n}\\ninterface ObservationControl {\\n  readonly task: TaskRef;\\n  readonly action: 'stop-observation' | 'cancel-execution';\\n  readonly requestId: string;\\n}\",\n        \"ownedByStory\": \"s1\",\n        \"consumedByStories\": [\n          \"s2\",\n          \"s3\",\n          \"s4\",\n          \"s5\",\n          \"s6\"\n        ],\n        \"assumptions\": [\n          \"c3\",\n          \"c6\",\n          \"c7\"\n        ]\n      },\n      {\n        \"id\": \"sc3\",\n        \"name\": \"Execution-owned activity and chat retention\",\n        \"purpose\": \"One current owned attempt may hold at most one active association for its originating insrc conversation. Each chat may have many associations. The coordinator renews through verified executor activity, and the actual session owner consumes the lease or a runtime renewal. View closure does not release a retained conversation. Removing a conversation releases only its association and retains project-scoped authorized task results.\",\n        \"interfaceSketch\": \"interface TaskActivityLease {\\n  readonly task: TaskRef;\\n  readonly origin: TaskOrigin;\\n  readonly fence: TaskOwnerFence;\\n  readonly renewedAt: string;\\n  readonly expiresAt: string;\\n}\\ninterface ChatTaskRetention {\\n  readonly originatingChatId: string;\\n  readonly retainedTasks: readonly { task: TaskRef; expiresAt: string }[];\\n}\",\n        \"ownedByStory\": \"s1\",\n        \"consumedByStories\": [\n          \"s2\",\n          \"s3\",\n          \"s4\",\n          \"s5\"\n        ],\n        \"assumptions\": [\n          \"c3\"\n        ]\n      },\n      {\n        \"id\": \"sc4\",\n        \"name\": \"Workflow and analysis measurements\",\n        \"purpose\": \"Maps supported existing stage/delta data into task details while preserving the old frame and result channel. Use measured output production only when a producer supports it, retaining its declared unit. No text enters progress. The two delivery stories consume the mapped details.\",\n        \"interfaceSketch\": \"interface WorkflowDetails {\\n  readonly kind: 'workflow';\\n  readonly stageId: string;\\n  readonly stagePosition: MeasuredCount | null;\\n  readonly production: MeasuredCount | null;\\n}\\ninterface AnalysisDetails {\\n  readonly kind: 'analysis';\\n  readonly stageId: string;\\n  readonly stagePosition: MeasuredCount | null;\\n  readonly production: MeasuredCount | null;\\n}\",\n        \"ownedByStory\": \"s2\",\n        \"consumedByStories\": [\n          \"s5\",\n          \"s6\"\n        ],\n        \"assumptions\": [\n          \"c4\",\n          \"c5\"\n        ]\n      },\n      {\n        \"id\": \"sc5\",\n        \"name\": \"Review measurements\",\n        \"purpose\": \"Observe canonical design and task-review progress rather than infer from output. Separate retained review coverage from fresh chunks, initial units from follow-up work, and publication from review assessment. A code-review implementation exposes task counts or other verified units that its executor can actually report.\",\n        \"interfaceSketch\": \"interface DesignReviewDetails {\\n  readonly kind: 'design-review';\\n  readonly target: string;\\n  readonly checks: MeasuredCount | null;\\n  readonly freshChunks: MeasuredCount | null;\\n  readonly retainedChunks: number | null;\\n  readonly retries: number | null;\\n}\\ninterface CodeReviewDetails {\\n  readonly kind: 'code-review';\\n  readonly target: string;\\n  readonly initial: MeasuredCount | null;\\n  readonly followUp: MeasuredCount | null;\\n  readonly retries: number | null;\\n  readonly publication: 'pending' | 'complete' | 'failed' | 'unknown';\\n}\",\n        \"ownedByStory\": \"s3\",\n        \"consumedByStories\": [\n          \"s5\",\n          \"s6\"\n        ],\n        \"assumptions\": [\n          \"c3\",\n          \"c7\"\n        ]\n      },\n      {\n        \"id\": \"sc6\",\n        \"name\": \"Managed test measurements\",\n        \"purpose\": \"Reports disjoint latest leaf-case outcomes by stable suite/case identity, with retries and discovery counted separately. Suite count and active suite are separate measurements. Process exit, reporter completeness and executor result establish terminal truth. The report reference stays separate from the progress payload.\",\n        \"interfaceSketch\": \"interface ManagedTestDetails {\\n  readonly kind: 'test';\\n  readonly stage: 'discovery' | 'execution' | 'finalization';\\n  readonly suites: MeasuredCount | null;\\n  readonly cases: MeasuredCount | null;\\n  readonly passed: number | null;\\n  readonly failed: number | null;\\n  readonly skipped: number | null;\\n  readonly cancelled: number | null;\\n  readonly retries: number | null;\\n  readonly elapsedMs: number;\\n  readonly logRef?: string;\\n}\",\n        \"ownedByStory\": \"s4\",\n        \"consumedByStories\": [\n          \"s5\",\n          \"s6\"\n        ],\n        \"assumptions\": [\n          \"c3\"\n        ]\n      }\n    ],\n    \"storyBoundaries\": [\n      {\n        \"storyId\": \"s1\",\n        \"owns\": [\n          \"sc1\",\n          \"sc2\",\n          \"sc3\"\n        ],\n        \"depends\": [],\n        \"internal\": \"Own daemon coordination, verified registration, cursors, normalization, scoped read/subscribe/control, durable state, owner fencing and fallback schedule arbitration. Keep storage, fencing and expiry implementation private.\"\n      },\n      {\n        \"storyId\": \"s2\",\n        \"owns\": [\n          \"sc4\"\n        ],\n        \"depends\": [\n          \"sc1\",\n          \"sc2\",\n          \"sc3\"\n        ],\n        \"internal\": \"Own adapters for existing workflow and analyze producer signals and terminal/owner evidence. Existing stream shape and command semantics remain compatible.\"\n      },\n      {\n        \"storyId\": \"s3\",\n        \"owns\": [\n          \"sc5\"\n        ],\n        \"depends\": [\n          \"sc1\",\n          \"sc2\",\n          \"sc3\"\n        ],\n        \"internal\": \"Own DesignReviewDelegate and CodeReviewDelegate and mappings from checkpoint progress and execution ownership. Review results, admission, retries and publication remain under the existing engines.\"\n      },\n      {\n        \"storyId\": \"s4\",\n        \"owns\": [\n          \"sc6\"\n        ],\n        \"depends\": [\n          \"sc1\",\n          \"sc2\",\n          \"sc3\"\n        ],\n        \"internal\": \"Own TestDelegate and managed reporter interpretation, including suite/case identity, provisional counts and abnormal exit. Keep test orchestration and exit semantics unchanged.\"\n      },\n      {\n        \"storyId\": \"s5\",\n        \"owns\": [],\n        \"depends\": [\n          \"sc1\",\n          \"sc2\",\n          \"sc3\",\n          \"sc4\",\n          \"sc5\",\n          \"sc6\"\n        ],\n        \"internal\": \"Own typed VS Code reader and transcript row, current status projection and bindings to the session owner. Render durable snapshots by origin across turns and multiple windows without executing or polling models.\"\n      },\n      {\n        \"storyId\": \"s6\",\n        \"owns\": [],\n        \"depends\": [\n          \"sc1\",\n          \"sc2\",\n          \"sc4\",\n          \"sc5\",\n          \"sc6\"\n        ],\n        \"internal\": \"Own MCP adapter, capability qualification, explicit opt-in disclosure and connection to the coordinator's fallback lease. No vendor-specific process changes or assumptions about session identity.\"\n      }\n    ],\n    \"nonFunctional\": {\n      \"performance\": \"Proposed caps for qualification are one coalesced active snapshot per second per task, 8 KiB per snapshot, 32 retained meaningful milestones, 16 queued observer updates and a reserved terminal state. Enforce per-project limits of 128 tracked active observations and 1,024 retained terminal observations, plus a global disk budget of 128 MiB. Exceeding observation capacity must report degradation without refusing, cancelling or slowing work. Terminal updates bypass normal coalescing. Reserve the observation terminal slot and bounded storage on admission. Evict only older terminal entries by policy, and refuse new observation with a capacity state when no reservation is possible. Do not evict active owners to admit new observations.\",\n      \"security\": \"Authenticate observations via existing daemon caller identity and verify project, conversation/invocation and task attempt before returning any snapshot, detail or control. Opaque cursors and task IDs do not grant authorization. Persist and expose sanitized structured measurements only. Detailed logs remain authorized, bounded references. No direct database access in MCP or VS Code.\",\n      \"observability\": \"Measure emitted and coalesced progress, cursor gaps, scheduler degradation, stale source age, rejected owner fences and retention transitions separately. Qualify each producer end to end, verify zero extra model invocations for native paths, and live-qualify CLI token, rendering, background lifetime and scheduling per version/session. Never log raw prompts, output or credentials as progress.\",\n      \"durability\": \"Use daemon-owned atomic per-task snapshots on local storage, with bounded milestone records and terminal result pointers. Persist terminal state before delivery. Refresh verified owner activity every 30 seconds with a 120-second lease, qualifying the margin against the actual session owner's idle threshold. After daemon restart recover persisted observations before accepting new owner events. Hold stale owner retention at most through its bounded grace and show interrupted or unknown until authority is reverified. Terminal retention is seven days subject to bounded capacity, after which separately available executor results remain authoritative. For executors without durable result history, expiry is explicit and is never rendered as a success, cancellation or new execution.\"\n    },\n    \"erDefinition\": {\n      \"id\": \"progress-task-ownership\",\n      \"narrative\": \"Shows how a project and originating invocation identify an observed task, how attempts are fenced, and how an attempt can hold a lease for an insrc conversation. Optional external session IDs are bindings on the invocation, never task identities.\",\n      \"classes\": {\n        \"Project\": {\n          \"description\": \"Authorized scope for task observation and retained results.\",\n          \"attributes\": {\n            \"id\": {\n              \"range\": \"string\",\n              \"identifier\": true,\n              \"required\": true,\n              \"description\": \"Canonical project identity.\"\n            },\n            \"invocations\": {\n              \"range\": \"Invocation\",\n              \"multivalued\": true,\n              \"description\": \"Each invocation belongs to exactly one project.\"\n            }\n          }\n        },\n        \"Conversation\": {\n          \"description\": \"Originating insrc conversation, when one exists.\",\n          \"attributes\": {\n            \"id\": {\n              \"range\": \"string\",\n              \"identifier\": true,\n              \"required\": true,\n              \"description\": \"Extension conversation identifier.\"\n            },\n            \"leases\": {\n              \"range\": \"ActivityLease\",\n              \"multivalued\": true,\n              \"description\": \"Zero or more current task associations owned by this conversation.\"\n            }\n          }\n        },\n        \"Invocation\": {\n          \"description\": \"Trusted tool invocation that launches zero or more tasks.\",\n          \"attributes\": {\n            \"id\": {\n              \"range\": \"string\",\n              \"identifier\": true,\n              \"required\": true,\n              \"description\": \"Server-verified invocation identity within the project.\"\n            },\n            \"conversation\": {\n              \"range\": \"Conversation\",\n              \"description\": \"Optional originating conversation. One conversation can own many invocations.\"\n            },\n            \"tasks\": {\n              \"range\": \"Task\",\n              \"multivalued\": true,\n              \"description\": \"Tasks launched by the invocation.\"\n            }\n          }\n        },\n        \"Task\": {\n          \"description\": \"Stable observation identity spanning explicitly owned attempts.\",\n          \"attributes\": {\n            \"id\": {\n              \"range\": \"string\",\n              \"identifier\": true,\n              \"required\": true,\n              \"description\": \"Task identity within its invocation.\"\n            },\n            \"attempts\": {\n              \"range\": \"Attempt\",\n              \"required\": true,\n              \"multivalued\": true,\n              \"description\": \"One or more attempts, with at most one authoritative current attempt.\"\n            }\n          }\n        },\n        \"Attempt\": {\n          \"description\": \"A fenced observation of one executor attempt.\",\n          \"attributes\": {\n            \"number\": {\n              \"range\": \"integer\",\n              \"required\": true,\n              \"description\": \"Attempt number within the task.\"\n            },\n            \"ownerEpoch\": {\n              \"range\": \"string\",\n              \"required\": true,\n              \"description\": \"Verified owner generation fencing old callbacks.\"\n            },\n            \"lease\": {\n              \"range\": \"ActivityLease\",\n              \"description\": \"At most one active conversation association for this attempt.\"\n            }\n          }\n        },\n        \"ActivityLease\": {\n          \"description\": \"Time-bounded association protecting a conversation with verified owned work.\",\n          \"attributes\": {\n            \"expiresAt\": {\n              \"range\": \"datetime\",\n              \"required\": true,\n              \"description\": \"Expiry based on runtime owner activity, independent of progress delivery.\"\n            }\n          }\n        }\n      }\n    },\n    \"rolloutOverview\": {\n      \"phases\": [\n        {\n          \"name\": \"Phase A — daemon observation foundation\",\n          \"includesStories\": [\n            \"s1\"\n          ],\n          \"rationale\": \"Land shared identity, owner fences, storage, authorized subscriptions, activity leases and fallback arbitration first.\",\n          \"backwardCompat\": \"Keep all existing executor paths and progress streams intact when observation is unavailable or unused.\",\n          \"featureFlag\": null\n        },\n        {\n          \"name\": \"Phase B — executor measurement adapters\",\n          \"includesStories\": [\n            \"s2\",\n            \"s3\",\n            \"s4\"\n          ],\n          \"rationale\": \"Connect workflow/analyze, review and managed test measurements independently against the common contracts.\",\n          \"backwardCompat\": \"Retain current progress/delta frames, review checkpoints and gate behavior, test exit codes and process ownership. A missing measurement degrades observation only.\",\n          \"featureFlag\": null\n        },\n        {\n          \"name\": \"Phase C — client delivery and qualification\",\n          \"includesStories\": [\n            \"s5\",\n            \"s6\"\n          ],\n          \"rationale\": \"Connect VS Code lifecycle and native MCP adapters after the measurement shapes stabilize. Each delivery adapter qualifies independently.\",\n          \"backwardCompat\": \"VS Code keeps existing chat rendering and active-list rules. A missing or expired MCP token stays silent, and fallback is opt-in with capability evidence.\",\n          \"featureFlag\": null\n        }\n      ],\n      \"orderingRationale\": \"s1 owns shared contracts needed by all producers and consumers. s2–s4 own their measurement contracts and each depends only on s1. s5 and s6 consume all producer details and share no client dependency. Link the approved successor to the July scope separately from rollout.\",\n      \"riskyBits\": [\n        {\n          \"area\": \"Owner or attempt loss\",\n          \"why\": \"Delayed callbacks or stale associations could make an ended chat appear live or overwrite newer task state.\",\n          \"mitigation\": \"Persist verified snapshots, fence writes by owner epoch and attempt, bound retention leases, and test daemon restart and multiple-window races.\"\n        },\n        {\n          \"area\": \"Native client delivery and fallback drift\",\n          \"why\": \"MCP acceptance, visible progress and scheduling are independent capabilities.\",\n          \"mitigation\": \"Qualify each client/version/session separately. Use one coordinator schedule with a fake-clock cadence test, and report unsupported or suspended observation visibly.\"\n        },\n        {\n          \"area\": \"Counter and result truth\",\n          \"why\": \"Tool frames and test reporters can omit totals, duplicate events or end before a verified result.\",\n          \"mitigation\": \"Keep producer units explicit, count only verified supported measurements, preserve raw outcomes, and cover unknown totals, nested suites, retries, reporter failure and nonzero exit.\"\n        }\n      ]\n    },\n    \"alternativesConsidered\": [\n      {\n        \"id\": \"a1\",\n        \"name\": \"Executor delegates with a shared daemon coordinator\",\n        \"oneLineSummary\": \"Normalize authorized executor measurements once and deliver typed snapshots through existing transports.\",\n        \"approach\": \"Each executor remains authoritative for lifecycle and exposes a bounded, read-only delegate snapshot. A daemon coordinator orders and retains task observations, deduplicates delivery, and bridges execution-owner activity to scoped session retention.\\n\\nVS Code subscribes over the existing Unix IPC seam and projects snapshots into the originating chat. MCP maps those snapshots to request-scoped progress or a separate opted-in observation response. Existing workflow/analyze frames remain compatible.\",\n        \"pros\": [\n          \"One observation model keeps replay, loss and attempt handling consistent across VS Code and MCP.\",\n          \"Native observation requires zero model calls and separates retention renewal from delivery.\"\n        ],\n        \"cons\": [\n          \"A daemon-owned snapshot store and owner epoch checks need restart and expiry qualification.\",\n          \"Each executor needs a narrowly scoped observation bridge.\"\n        ],\n        \"costEstimate\": \"L\",\n        \"assumptionsRelied\": [\n          \"c4\",\n          \"c5\",\n          \"c6\",\n          \"c7\"\n        ]\n      },\n      {\n        \"id\": \"a2\",\n        \"name\": \"Client-local adapters over executor-specific streams\",\n        \"oneLineSummary\": \"Let each client track and interpret progress directly from the source stream.\",\n        \"approach\": \"Each executor exposes its own progress messages and the client adapts them to transcript or CLI updates. Existing streams remain the primary source.\\n\\nEach client maintains its own reconnect state and derives activity from the channels it can observe. Coordination across windows and tool lifetimes requires agreement between clients.\",\n        \"pros\": [\n          \"One active client can render existing stream events with few daemon changes.\"\n        ],\n        \"cons\": [\n          \"Disconnected observers cannot establish execution ownership or keep the correct chat active independently.\",\n          \"Multiple clients can duplicate observation schedules and disagree on terminal state.\"\n        ],\n        \"costEstimate\": \"M\",\n        \"assumptionsRelied\": [\n          \"c4\",\n          \"c5\",\n          \"c6\",\n          \"c7\"\n        ],\n        \"reasonRejected\": \"Reuses transport but loses consistent shared ownership, replay and fallback scheduling.\"\n      },\n      {\n        \"id\": \"a3\",\n        \"name\": \"Central job scheduler and progress event log\",\n        \"oneLineSummary\": \"Move execution and replay into a central job platform.\",\n        \"approach\": \"A common scheduler would dispatch workflow, review, analysis and test jobs and record each execution event. The scheduler would own retries, task state and replay.\\n\\nClients would receive progress from job subscriptions. Migration would move authority away from existing workflow and review executors.\",\n        \"pros\": [\n          \"A single scheduler could provide a uniform execution identity and lifecycle for migrated jobs.\"\n        ],\n        \"cons\": [\n          \"Changes current executor ownership and introduces retry and scheduling behavior outside this epic.\",\n          \"An event per output fragment would expand storage unless separately bounded.\"\n        ],\n        \"costEstimate\": \"L\",\n        \"assumptionsRelied\": [\n          \"c4\",\n          \"c7\"\n        ],\n        \"reasonRejected\": \"Centralizes execution and therefore conflicts with the approved ownership boundary.\"\n      }\n    ],\n    \"chosenAlternative\": \"a1\",\n    \"openQuestions\": [],\n    \"sequenceDefinition\": {\n      \"id\": \"observe-progress-across-chat-turns\",\n      \"narrative\": \"The executor registers before detaching. Subsequent measurement and retention updates remain independent of the chat view and MCP request lifetime, and terminal state is persisted before delivery.\",\n      \"participants\": [\n        {\n          \"id\": \"executor\",\n          \"label\": \"Execution owner\",\n          \"description\": \"Owns execution, lifecycle and cancellation confirmation.\"\n        },\n        {\n          \"id\": \"delegate\",\n          \"label\": \"Task delegate\",\n          \"description\": \"Reads verified producer measurements without side effects.\"\n        },\n        {\n          \"id\": \"daemon\",\n          \"label\": \"Progress coordinator\",\n          \"description\": \"Authorizes observations, fences attempts and publishes bounded snapshots.\"\n        },\n        {\n          \"id\": \"store\",\n          \"label\": \"Snapshot store\",\n          \"description\": \"Persists latest verified state and bounded milestones.\"\n        },\n        {\n          \"id\": \"session\",\n          \"label\": \"Session owner\",\n          \"description\": \"Maintains the existing chat status and active retention.\"\n        },\n        {\n          \"id\": \"vs\",\n          \"label\": \"VS Code chat\",\n          \"description\": \"Typed observer that updates a row in the owning conversation.\"\n        },\n        {\n          \"id\": \"mcp\",\n          \"label\": \"MCP adapter\",\n          \"description\": \"Request-scoped native delivery or optional observation.\"\n        }\n      ],\n      \"messages\": [\n        {\n          \"from\": \"executor\",\n          \"to\": \"daemon\",\n          \"label\": \"Register task before detach\",\n          \"description\": \"Binds project, invocation, optional conversation and executor epoch.\",\n          \"kind\": \"call\"\n        },\n        {\n          \"from\": \"daemon\",\n          \"to\": \"session\",\n          \"label\": \"Register task activity association\",\n          \"description\": \"The verified owner lease protects the correct conversation.\",\n          \"kind\": \"call\"\n        },\n        {\n          \"from\": \"vs\",\n          \"to\": \"daemon\",\n          \"label\": \"Subscribe with authorized task cursor\",\n          \"description\": \"A view observes the task without acquiring execution ownership.\",\n          \"kind\": \"call\"\n        },\n        {\n          \"from\": \"daemon\",\n          \"to\": \"vs\",\n          \"label\": \"Latest snapshot or explicit resync\",\n          \"description\": \"Reattachment updates the existing chat row.\",\n          \"kind\": \"return\"\n        },\n        {\n          \"from\": \"mcp\",\n          \"to\": \"daemon\",\n          \"label\": \"Observe within valid request lifetime\",\n          \"description\": \"Optional caller token stays with this request.\",\n          \"kind\": \"call\"\n        },\n        {\n          \"from\": \"executor\",\n          \"to\": \"daemon\",\n          \"label\": \"Signal new measurement\",\n          \"description\": \"A change triggers a read of the producer’s structured state.\",\n          \"kind\": \"call\"\n        },\n        {\n          \"from\": \"daemon\",\n          \"to\": \"delegate\",\n          \"label\": \"Read progress()\",\n          \"description\": \"No model calls, scheduling or execution side effects.\",\n          \"kind\": \"call\"\n        },\n        {\n          \"from\": \"delegate\",\n          \"to\": \"daemon\",\n          \"label\": \"Return measured phase and counters\",\n          \"description\": \"Owner fence and measurement revision are verified.\",\n          \"kind\": \"return\"\n        },\n        {\n          \"from\": \"daemon\",\n          \"to\": \"store\",\n          \"label\": \"Persist bounded snapshot\",\n          \"description\": \"Store the verified measurement and coalesced milestones.\",\n          \"kind\": \"call\"\n        },\n        {\n          \"from\": \"daemon\",\n          \"to\": \"vs\",\n          \"label\": \"Update originating chat row\",\n          \"description\": \"Routing uses origin and attempt identity, including after chat switching.\",\n          \"kind\": \"call\"\n        },\n        {\n          \"from\": \"daemon\",\n          \"to\": \"mcp\",\n          \"label\": \"Forward sanitized native update\",\n          \"description\": \"The adapter uses the caller token only while valid.\",\n          \"kind\": \"call\"\n        },\n        {\n          \"from\": \"executor\",\n          \"to\": \"daemon\",\n          \"label\": \"Renew owner activity\",\n          \"description\": \"Heartbeat may renew retention without changing measured progress.\",\n          \"kind\": \"call\"\n        },\n        {\n          \"from\": \"daemon\",\n          \"to\": \"session\",\n          \"label\": \"Renew the bounded association\",\n          \"description\": \"The session owner preserves waiting-input and other live obligations.\",\n          \"kind\": \"call\"\n        },\n        {\n          \"from\": \"executor\",\n          \"to\": \"daemon\",\n          \"label\": \"Confirm terminal outcome\",\n          \"description\": \"Only verified owner evidence closes the attempt.\",\n          \"kind\": \"call\"\n        },\n        {\n          \"from\": \"daemon\",\n          \"to\": \"store\",\n          \"label\": \"Persist terminal snapshot\",\n          \"description\": \"Commit the terminal result before final delivery.\",\n          \"kind\": \"call\"\n        },\n        {\n          \"from\": \"daemon\",\n          \"to\": \"session\",\n          \"label\": \"Release this task association\",\n          \"description\": \"Other attempts, tasks and unresolved decisions remain independent.\",\n          \"kind\": \"call\"\n        },\n        {\n          \"from\": \"daemon\",\n          \"to\": \"vs\",\n          \"label\": \"Retain one terminal message\",\n          \"description\": \"The task row records a compact outcome and authorized details.\",\n          \"kind\": \"call\"\n        },\n        {\n          \"from\": \"daemon\",\n          \"to\": \"mcp\",\n          \"label\": \"Deliver outcome while request is valid\",\n          \"description\": \"If native request ended, only authorized reattachment reads the retained result.\",\n          \"kind\": \"call\"\n        }\n      ]\n    },\n    \"componentDependencyDefinition\": {\n      \"id\": \"progress-module-boundaries\",\n      \"narrative\": \"Executor adapters depend on the common daemon observation contract. VS Code and MCP consume the authorized stream or snapshot over the existing socket, with no dependency on producer internals or snapshot storage.\",\n      \"components\": [\n        {\n          \"id\": \"executors\",\n          \"label\": \"Existing executors\",\n          \"description\": \"Workflow, analyze, design/code review and managed tests retain execution authority.\"\n        },\n        {\n          \"id\": \"delegates\",\n          \"label\": \"Executor delegates\",\n          \"description\": \"Map current producer measurements into typed detail contracts.\"\n        },\n        {\n          \"id\": \"coordinator\",\n          \"label\": \"Daemon observation coordinator\",\n          \"description\": \"Owns task routing, scopes, revisions and schedule arbitration.\"\n        },\n        {\n          \"id\": \"durability\",\n          \"label\": \"Daemon snapshot store\",\n          \"description\": \"Persists scoped bounded state for reconnect and restart.\"\n        },\n        {\n          \"id\": \"session\",\n          \"label\": \"Existing session owners\",\n          \"description\": \"Project task associations into chat retention and status.\"\n        },\n        {\n          \"id\": \"vscode\",\n          \"label\": \"VS Code adapter\",\n          \"description\": \"Consumes typed updates and renders one row per task.\"\n        },\n        {\n          \"id\": \"mcp\",\n          \"label\": \"MCP adapter\",\n          \"description\": \"Consumes verified snapshots and qualifies native or optional fallback delivery.\"\n        }\n      ],\n      \"dependencies\": [\n        {\n          \"from\": \"delegates\",\n          \"to\": \"executors\",\n          \"label\": \"Read measured state and terminal evidence\"\n        },\n        {\n          \"from\": \"delegates\",\n          \"to\": \"coordinator\",\n          \"label\": \"Register detail contract and report observation changes\"\n        },\n        {\n          \"from\": \"coordinator\",\n          \"to\": \"durability\",\n          \"label\": \"Persist snapshots and recover authorized history\"\n        },\n        {\n          \"from\": \"session\",\n          \"to\": \"coordinator\",\n          \"label\": \"Consume verified activity for the owning conversation\"\n        },\n        {\n          \"from\": \"vscode\",\n          \"to\": \"coordinator\",\n          \"label\": \"Subscribe to authorized typed observations over Unix IPC\"\n        },\n        {\n          \"from\": \"mcp\",\n          \"to\": \"coordinator\",\n          \"label\": \"Read/subscribe over Unix IPC and arbitrate fallback observation\"\n        }\n      ]\n    },\n    \"uxDefinition\": {\n      \"type\": \"AdaptiveCard\",\n      \"version\": \"1.5\",\n      \"narrative\": \"Three views of the same inline review row in its originating VS Code transcript. Running, stale observation and terminal outcome are different states. The examples are sequential and the live UI keeps one row.\",\n      \"body\": [\n        {\n          \"type\": \"TextBlock\",\n          \"text\": \"Chat A · Review progress\",\n          \"description\": \"The task belongs to the chat that launched the review.\",\n          \"wrap\": true,\n          \"weight\": \"bolder\",\n          \"size\": \"medium\"\n        },\n        {\n          \"type\": \"Container\",\n          \"description\": \"Running row with verified stage and available controls.\",\n          \"items\": [\n            {\n              \"type\": \"TextBlock\",\n              \"text\": \"Code review · Running\",\n              \"description\": \"Task title and verified execution state.\",\n              \"wrap\": true,\n              \"weight\": \"bolder\"\n            },\n            {\n              \"type\": \"TextBlock\",\n              \"text\": \"Assessing task 3 of 6 · 2 tasks completed\",\n              \"description\": \"Measured active task and completed units.\",\n              \"wrap\": true\n            },\n            {\n              \"type\": \"TextBlock\",\n              \"text\": \"Last progress 20 seconds ago · Worker active\",\n              \"description\": \"Shows progress freshness separately from worker health.\",\n              \"wrap\": true,\n              \"isSubtle\": true\n            },\n            {\n              \"type\": \"ActionSet\",\n              \"description\": \"Controls available in this observation state.\",\n              \"actions\": [\n                {\n                  \"type\": \"Action.Submit\",\n                  \"title\": \"View details\",\n                  \"description\": \"Opens authorized review progress and results.\"\n                },\n                {\n                  \"type\": \"Action.Submit\",\n                  \"title\": \"Stop updates\",\n                  \"description\": \"Detaches observation only.\"\n                },\n                {\n                  \"type\": \"Action.Submit\",\n                  \"title\": \"Cancel review\",\n                  \"description\": \"Requests cancellation and remains pending until the executor confirms termination.\"\n                }\n              ]\n            }\n          ]\n        },\n        {\n          \"type\": \"Container\",\n          \"description\": \"Same row while observation is unavailable.\",\n          \"items\": [\n            {\n              \"type\": \"TextBlock\",\n              \"text\": \"Code review · Updates unavailable\",\n              \"description\": \"Observation loss leaves the last verified execution state intact.\",\n              \"wrap\": true,\n              \"weight\": \"bolder\",\n              \"color\": \"warning\"\n            },\n            {\n              \"type\": \"TextBlock\",\n              \"text\": \"Last verified: task 3 of 6 · 2 tasks completed\",\n              \"description\": \"Preserves the last verified measurements and their freshness.\",\n              \"wrap\": true\n            },\n            {\n              \"type\": \"ActionSet\",\n              \"description\": \"Controls available in this observation state.\",\n              \"actions\": [\n                {\n                  \"type\": \"Action.Submit\",\n                  \"title\": \"Reconnect updates\",\n                  \"description\": \"Attempts authorized observation recovery without relaunching execution.\"\n                }\n              ]\n            }\n          ]\n        },\n        {\n          \"type\": \"Container\",\n          \"description\": \"Same row after the verified terminal outcome.\",\n          \"items\": [\n            {\n              \"type\": \"TextBlock\",\n              \"text\": \"Code review · Completed\",\n              \"description\": \"Displays the authoritative review outcome.\",\n              \"wrap\": true,\n              \"weight\": \"bolder\",\n              \"color\": \"good\"\n            },\n            {\n              \"type\": \"TextBlock\",\n              \"text\": \"6 tasks reviewed · Result available\",\n              \"description\": \"Compact terminal milestone with access to details.\",\n              \"wrap\": true\n            },\n            {\n              \"type\": \"ActionSet\",\n              \"description\": \"Controls available in this observation state.\",\n              \"actions\": [\n                {\n                  \"type\": \"Action.Submit\",\n                  \"title\": \"View result\",\n                  \"description\": \"Opens the authorized saved review result.\"\n                }\n              ]\n            }\n          ]\n        }\n      ]\n    },\n    \"companions\": [\n      {\n        \"kind\": \"diagram-mermaid\",\n        \"relPath\": \"docs/epics/show-long-running-task-progress-chat-E20261109206db342/er-model.html\",\n        \"title\": \"ER model\"\n      },\n      {\n        \"kind\": \"ux-mock\",\n        \"relPath\": \"docs/epics/show-long-running-task-progress-chat-E20261109206db342/ux-mock.html\",\n        \"title\": \"UX mock\"\n      },\n      {\n        \"kind\": \"diagram-mermaid\",\n        \"relPath\": \"docs/epics/show-long-running-task-progress-chat-E20261109206db342/sequence-diagram.html\",\n        \"title\": \"Sequence diagram\"\n      },\n      {\n        \"kind\": \"diagram-mermaid\",\n        \"relPath\": \"docs/epics/show-long-running-task-progress-chat-E20261109206db342/component-dependency.html\",\n        \"title\": \"Component dependencies\"\n      }\n    ]\n  },\n  \"citations\": [\n    {\n      \"id\": \"c1\",\n      \"kind\": \"prior-artifact\",\n      \"ref\": \"docs/epics/stream-incremental-progress-from-daemon-calling-E202607196d6cfaf9/DEF.md\"\n    },\n    {\n      \"id\": \"c2\",\n      \"kind\": \"prior-artifact\",\n      \"ref\": \"docs/epics/stream-incremental-progress-from-daemon-calling-E202607196d6cfaf9/HLD.md\"\n    },\n    {\n      \"id\": \"c3\",\n      \"kind\": \"prior-artifact\",\n      \"ref\": \"docs/standalone/show-background-task-progress-chat-E2026110407024f1d/SPEC.md\"\n    },\n    {\n      \"id\": \"c4\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/__tests__/workflow-progress-map.test.ts\"\n    },\n    {\n      \"id\": \"c5\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/__tests__/analyze-progress.test.ts\"\n    },\n    {\n      \"id\": \"c6\",\n      \"kind\": \"code\",\n      \"ref\": \"src/mcp/__tests__/progress-forward.test.ts\"\n    },\n    {\n      \"id\": \"c7\",\n      \"kind\": \"code\",\n      \"ref\": \"src/workflow/code-review/task-review/progress.ts\"\n    },\n    {\n      \"id\": \"c8\",\n      \"kind\": \"convention\",\n      \"ref\": \"AGENTS.md\"\n    },\n    {\n      \"id\": \"c9\",\n      \"kind\": \"prior-artifact\",\n      \"ref\": \"docs/epics/stream-incremental-progress-from-daemon-calling-E202607196d6cfaf9/DEF.md\"\n    },\n    {\n      \"id\": \"c10\",\n      \"kind\": \"prior-artifact\",\n      \"ref\": \"docs/epics/show-long-running-task-progress-chat-E20261109206db342/DEF.md\"\n    },\n    {\n      \"id\": \"c11\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/workflow-rpc.ts\"\n    },\n    {\n      \"id\": \"c12\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/analyze-rpc.ts\"\n    },\n    {\n      \"id\": \"c13\",\n      \"kind\": \"code\",\n      \"ref\": \"src/shared/types.ts\"\n    },\n    {\n      \"id\": \"c14\",\n      \"kind\": \"code\",\n      \"ref\": \"src/mcp/progress-forward.ts\"\n    },\n    {\n      \"id\": \"c15\",\n      \"kind\": \"code\",\n      \"ref\": \"src/mcp/server.ts\"\n    },\n    {\n      \"id\": \"c16\",\n      \"kind\": \"code\",\n      \"ref\": \"src/workflow/review/design-review/progress.ts\"\n    },\n    {\n      \"id\": \"c17\",\n      \"kind\": \"code\",\n      \"ref\": \"src/workflow/code-review/task-review/progress.ts\"\n    },\n    {\n      \"id\": \"c18\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/steps/build-step/validation-checks.ts\"\n    },\n    {\n      \"id\": \"c19\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/chat-sessions.ts\"\n    },\n    {\n      \"id\": \"c20\",\n      \"kind\": \"code\",\n      \"ref\": \"vscode-plugin/src/chat/protocol.ts\"\n    },\n    {\n      \"id\": \"c21\",\n      \"kind\": \"code\",\n      \"ref\": \"vscode-plugin/src/chat/session-file-store.ts\"\n    },\n    {\n      \"id\": \"c22\",\n      \"kind\": \"code\",\n      \"ref\": \"vscode-plugin/src/chat/chat-panel.ts\"\n    }\n  ]\n}\n","document":"<!-- insrc:artifact HLD-206db3426ffd4428 -->\n\n# HLD: show-long-running-task-progress-chat\n\n## Summary\n\n**Tracker:** [insors-ai/insrc#146](https://github.com/insors-ai/insrc/issues/146)\n\nExecutor delegates measure progress and the daemon coordinates how it is stored and delivered. VS Code keeps the progress message in its originating chat, and supported native clients receive the same verified state through MCP. Execution owners remain responsible for results, cancellation and activity.\n\n## Contents\n\n1. [Problem context](#1-problem-context)\n2. [Framework summary](#2-framework-summary)\n3. [Architecture shape](#3-architecture-shape)\n4. [Diagrams](#4-diagrams)\n5. [Shared contracts](#5-shared-contracts)\n6. [Story boundaries](#6-story-boundaries)\n7. [Non-functional targets](#7-non-functional-targets)\n8. [Rollout](#8-rollout)\n9. [Alternatives considered](#9-alternatives-considered)\n10. [UX](#10-ux)\n11. [References](#11-references)\n\n## 1. Problem context\n\n> See **DEF-206db3426ffd4428** § 1. Problem\n\n## 2. Framework summary\n\nUse executor delegates with a shared daemon coordinator. Preserve legacy workflow and analyze IPC frames and existing execution authority. The coordinator feeds a typed VS Code adapter, request-scoped MCP notifications and one optional fallback observation schedule.\n\n## 3. Architecture shape\n\nThe execution owner registers a trusted project, invocation, optional chat binding, task and attempt before detach. Delegates expose progress() without side effects and signal refresh when measurements change. The daemon verifies owner epoch and monotonic source sequence, separates meaningful revision from heartbeat/freshness, persists bounded state, then publishes sanitized snapshots. Project-scoped history supports read or subscribe from an opaque cursor. A lagging observer receives the latest snapshot and explicit resync instead of replaying ticks. A failed delegate refresh preserves last verified details with their original age. Stop-observation never cancels execution. Explicit cancellation is idempotent and pending until the executor confirms termination.\n\nThe Unix socket carries authorized typed observations additively beside existing progress/delta traffic. VS Code updates one row per task in its originating chat and shows attempt changes without stale finalization. A read-only details action resolves bounded result/log references in the owning project. The current session owner projects waiting-input before working before done across all live turns, unresolved decisions and owned tasks. Runtime lease renewal is independent of observers, meaningful measurement and repository locks. Closing a view detaches. Removing a conversation releases its retention and leaves authorized project results recoverable.\n\nNative MCP binds notifications to the valid caller token for that request. Use a monotonic delivery count without a total unless the total uses the same unit, and put trustworthy measurements in the sanitized label. Disconnect drops the observer, not the execution. For authorized opt-in fallback, a single fenced observer lease issues an initial snapshot then cadence slots anchored every 60 seconds. Host timers wait when available. Additional observers attach to the same schedule. Overlapping calls are suppressed, missed slots never burst, transport loss or rate limiting is visible, and healthy recovery restores the fixed interval. Unchanged responses still include bounded details and never generate duplicate narration. Third-party background lifetime and user-visible rendering are live-qualified separately.\n\nProducer-specific detail validation is registered by each adapter through the generic foundation contract. Bind fallback to a single renewable, fenced scheduler lease for each task across attempts. On observer transfer retain the cadence anchor and cursor, expire the old lease, and reject old in-flight replies. A runtime status tool reports one concise line or bounded structured delta per scheduled poll. It performs no model invocation and exposes no detailed logs in the polling payload.\n\n## 4. Diagrams\n\n- [ER model](docs/epics/show-long-running-task-progress-chat-E20261109206db342/er-model.html)\n- [Sequence diagram](docs/epics/show-long-running-task-progress-chat-E20261109206db342/sequence-diagram.html)\n- [Component dependencies](docs/epics/show-long-running-task-progress-chat-E20261109206db342/component-dependency.html)\n\n## 5. Shared contracts\n\n### 5.1 sc1: Task identity and delegate observation\n\n**Owner Story:** `s1`\n**Consumed by:** `s2`, `s3`, `s4`, `s5`, `s6`\n\n**Purpose:** One verified owner binds each task attempt to one project and originating invocation. An insrc chat may own many invocations, and an invocation may launch many tasks. Each task has one current attempt, with at most one active owner epoch. External host, daemon session and extension chat identities are optional distinct bindings, never inferred from one another. Both delivery paths use this delegate snapshot. The foundation is parameterized by producer-owned detail types, so it has no type dependency on later stories.\n\n**Interface sketch (type-level):**\n\n```\ninterface TaskRef {\n  readonly projectId: string;\n  readonly invocationId: string;\n  readonly taskId: string;\n  readonly attempt: number;\n}\ninterface TaskOwnerFence {\n  readonly ownerId: string;\n  readonly ownerEpoch: string;\n  readonly ownerSequence: number;\n}\ninterface TaskOrigin {\n  readonly extensionChatId?: string;\n  readonly daemonSessionId?: string;\n  readonly nativeSessionId?: string;\n  readonly turnId?: string;\n}\ntype ProgressKind = 'workflow' | 'analysis' | 'design-review' | 'code-review' | 'test';\ninterface MeasuredCount {\n  readonly unit: string;\n  readonly completed: number;\n  readonly total: number | null;\n}\ninterface DelegateMeasurement<Details extends { readonly kind: ProgressKind }> {\n  readonly task: TaskRef;\n  readonly owner: TaskOwnerFence;\n  readonly kind: ProgressKind;\n  readonly measuredAt: string;\n  readonly meaningfulRevision: number;\n  readonly lastMeaningfulAt: string | null;\n  readonly phase: string;\n  readonly activeUnit: string | null;\n  readonly counts: readonly MeasuredCount[];\n  readonly milestones: readonly string[];\n  readonly controls: readonly ('cancel')[];\n  readonly details: Details;\n}\ninterface TaskProgressDelegate<Details extends { readonly kind: ProgressKind }> {\n  progress(task: TaskRef): Promise<DelegateMeasurement<Details> | null>;\n}\n```\n\n**Assumptions cited:** [[c3]] [[c4]] [[c5]] [[c7]]\n\n### 5.2 sc2: Scoped snapshots, subscriptions and observation control\n\n**Owner Story:** `s1`\n**Consumed by:** `s2`, `s3`, `s4`, `s5`, `s6`\n\n**Purpose:** The daemon authorizes every operation against server-verified caller/project/origin bindings, including logs and controls. A read yields a compact snapshot, meaningful-change indicator and revision cursor. Observer loss, executor state and session retention are independent. The shared coordinator arbitrates one optional fallback schedule per task, independent of all native subscriptions. Owner credentials, internal session identifiers and fencing fields remain server-side. A structured fallback lease governs the scheduler, without granting execution authority.\n\n**Interface sketch (type-level):**\n\n```\ntype TaskState = 'queued' | 'running' | 'waiting' | 'paused' | 'completed' | 'failed' | 'cancelled' | 'interrupted' | 'unknown';\ntype ProgressFreshness = 'live' | 'stale' | 'unavailable';\ntype DeliveredMeasurement<Details extends { readonly kind: ProgressKind }> = Omit<DelegateMeasurement<Details>, 'owner'>;\ninterface ProgressSnapshot<Details extends { readonly kind: ProgressKind }> {\n  readonly task: TaskRef;\n  readonly cursor: string;\n  readonly state: TaskState;\n  readonly freshness: ProgressFreshness;\n  readonly measurement: DeliveredMeasurement<Details> | null;\n  readonly lastOwnerActivityAt: string | null;\n  readonly workerHealth: 'alive' | 'lost' | 'unknown';\n  readonly cancellation: 'none' | 'pending';\n  readonly resultRef?: string;\n}\ninterface ObservationReply<Details extends { readonly kind: ProgressKind }> {\n  readonly snapshot: ProgressSnapshot<Details>;\n  readonly disposition: 'changed' | 'unchanged' | 'resync';\n  readonly schedule: 'native' | 'scheduled' | 'suspended' | 'stopped';\n  readonly nextPollNotBefore?: string;\n}\ninterface ObservationControl {\n  readonly task: TaskRef;\n  readonly action: 'stop-observation' | 'cancel-execution';\n  readonly requestId: string;\n}\n```\n\n**Assumptions cited:** [[c3]] [[c6]] [[c7]]\n\n### 5.3 sc3: Execution-owned activity and chat retention\n\n**Owner Story:** `s1`\n**Consumed by:** `s2`, `s3`, `s4`, `s5`\n\n**Purpose:** One current owned attempt may hold at most one active association for its originating insrc conversation. Each chat may have many associations. The coordinator renews through verified executor activity, and the actual session owner consumes the lease or a runtime renewal. View closure does not release a retained conversation. Removing a conversation releases only its association and retains project-scoped authorized task results.\n\n**Interface sketch (type-level):**\n\n```\ninterface TaskActivityLease {\n  readonly task: TaskRef;\n  readonly origin: TaskOrigin;\n  readonly fence: TaskOwnerFence;\n  readonly renewedAt: string;\n  readonly expiresAt: string;\n}\ninterface ChatTaskRetention {\n  readonly originatingChatId: string;\n  readonly retainedTasks: readonly { task: TaskRef; expiresAt: string }[];\n}\n```\n\n**Assumptions cited:** [[c3]]\n\n### 5.4 sc4: Workflow and analysis measurements\n\n**Owner Story:** `s2`\n**Consumed by:** `s5`, `s6`\n\n**Purpose:** Maps supported existing stage/delta data into task details while preserving the old frame and result channel. Use measured output production only when a producer supports it, retaining its declared unit. No text enters progress. The two delivery stories consume the mapped details.\n\n**Interface sketch (type-level):**\n\n```\ninterface WorkflowDetails {\n  readonly kind: 'workflow';\n  readonly stageId: string;\n  readonly stagePosition: MeasuredCount | null;\n  readonly production: MeasuredCount | null;\n}\ninterface AnalysisDetails {\n  readonly kind: 'analysis';\n  readonly stageId: string;\n  readonly stagePosition: MeasuredCount | null;\n  readonly production: MeasuredCount | null;\n}\n```\n\n**Assumptions cited:** [[c4]] [[c5]]\n\n### 5.5 sc5: Review measurements\n\n**Owner Story:** `s3`\n**Consumed by:** `s5`, `s6`\n\n**Purpose:** Observe canonical design and task-review progress rather than infer from output. Separate retained review coverage from fresh chunks, initial units from follow-up work, and publication from review assessment. A code-review implementation exposes task counts or other verified units that its executor can actually report.\n\n**Interface sketch (type-level):**\n\n```\ninterface DesignReviewDetails {\n  readonly kind: 'design-review';\n  readonly target: string;\n  readonly checks: MeasuredCount | null;\n  readonly freshChunks: MeasuredCount | null;\n  readonly retainedChunks: number | null;\n  readonly retries: number | null;\n}\ninterface CodeReviewDetails {\n  readonly kind: 'code-review';\n  readonly target: string;\n  readonly initial: MeasuredCount | null;\n  readonly followUp: MeasuredCount | null;\n  readonly retries: number | null;\n  readonly publication: 'pending' | 'complete' | 'failed' | 'unknown';\n}\n```\n\n**Assumptions cited:** [[c3]] [[c7]]\n\n### 5.6 sc6: Managed test measurements\n\n**Owner Story:** `s4`\n**Consumed by:** `s5`, `s6`\n\n**Purpose:** Reports disjoint latest leaf-case outcomes by stable suite/case identity, with retries and discovery counted separately. Suite count and active suite are separate measurements. Process exit, reporter completeness and executor result establish terminal truth. The report reference stays separate from the progress payload.\n\n**Interface sketch (type-level):**\n\n```\ninterface ManagedTestDetails {\n  readonly kind: 'test';\n  readonly stage: 'discovery' | 'execution' | 'finalization';\n  readonly suites: MeasuredCount | null;\n  readonly cases: MeasuredCount | null;\n  readonly passed: number | null;\n  readonly failed: number | null;\n  readonly skipped: number | null;\n  readonly cancelled: number | null;\n  readonly retries: number | null;\n  readonly elapsedMs: number;\n  readonly logRef?: string;\n}\n```\n\n**Assumptions cited:** [[c3]]\n\n## 6. Story boundaries\n\n### 6.1 Story STORY-206db3426ffd4428-s1\n\n**Owns:** `sc1`, `sc2`, `sc3`\n\nOwn daemon coordination, verified registration, cursors, normalization, scoped read/subscribe/control, durable state, owner fencing and fallback schedule arbitration. Keep storage, fencing and expiry implementation private.\n\n### 6.2 Story STORY-206db3426ffd4428-s2\n\n**Owns:** `sc4`\n**Depends on:** `sc1`, `sc2`, `sc3`\n\nOwn adapters for existing workflow and analyze producer signals and terminal/owner evidence. Existing stream shape and command semantics remain compatible.\n\n### 6.3 Story STORY-206db3426ffd4428-s3\n\n**Owns:** `sc5`\n**Depends on:** `sc1`, `sc2`, `sc3`\n\nOwn DesignReviewDelegate and CodeReviewDelegate and mappings from checkpoint progress and execution ownership. Review results, admission, retries and publication remain under the existing engines.\n\n### 6.4 Story STORY-206db3426ffd4428-s4\n\n**Owns:** `sc6`\n**Depends on:** `sc1`, `sc2`, `sc3`\n\nOwn TestDelegate and managed reporter interpretation, including suite/case identity, provisional counts and abnormal exit. Keep test orchestration and exit semantics unchanged.\n\n### 6.5 Story STORY-206db3426ffd4428-s5\n\n**Depends on:** `sc1`, `sc2`, `sc3`, `sc4`, `sc5`, `sc6`\n\nOwn typed VS Code reader and transcript row, current status projection and bindings to the session owner. Render durable snapshots by origin across turns and multiple windows without executing or polling models.\n\n### 6.6 Story STORY-206db3426ffd4428-s6\n\n**Depends on:** `sc1`, `sc2`, `sc4`, `sc5`, `sc6`\n\nOwn MCP adapter, capability qualification, explicit opt-in disclosure and connection to the coordinator's fallback lease. No vendor-specific process changes or assumptions about session identity.\n\n## 7. Non-functional targets\n\n- **Performance:** Proposed caps for qualification are one coalesced active snapshot per second per task, 8 KiB per snapshot, 32 retained meaningful milestones, 16 queued observer updates and a reserved terminal state. Enforce per-project limits of 128 tracked active observations and 1,024 retained terminal observations, plus a global disk budget of 128 MiB. Exceeding observation capacity must report degradation without refusing, cancelling or slowing work. Terminal updates bypass normal coalescing. Reserve the observation terminal slot and bounded storage on admission. Evict only older terminal entries by policy, and refuse new observation with a capacity state when no reservation is possible. Do not evict active owners to admit new observations.\n- **Security:** Authenticate observations via existing daemon caller identity and verify project, conversation/invocation and task attempt before returning any snapshot, detail or control. Opaque cursors and task IDs do not grant authorization. Persist and expose sanitized structured measurements only. Detailed logs remain authorized, bounded references. No direct database access in MCP or VS Code.\n- **Observability:** Measure emitted and coalesced progress, cursor gaps, scheduler degradation, stale source age, rejected owner fences and retention transitions separately. Qualify each producer end to end, verify zero extra model invocations for native paths, and live-qualify CLI token, rendering, background lifetime and scheduling per version/session. Never log raw prompts, output or credentials as progress.\n- **Durability:** Use daemon-owned atomic per-task snapshots on local storage, with bounded milestone records and terminal result pointers. Persist terminal state before delivery. Refresh verified owner activity every 30 seconds with a 120-second lease, qualifying the margin against the actual session owner's idle threshold. After daemon restart recover persisted observations before accepting new owner events. Hold stale owner retention at most through its bounded grace and show interrupted or unknown until authority is reverified. Terminal retention is seven days subject to bounded capacity, after which separately available executor results remain authoritative. For executors without durable result history, expiry is explicit and is never rendered as a success, cancellation or new execution.\n\n## 8. Rollout\n\n**Phase A — daemon observation foundation**\n\n**Stories:** `s1`\n\nLand shared identity, owner fences, storage, authorized subscriptions, activity leases and fallback arbitration first.\n\n**Backward compat:** Keep all existing executor paths and progress streams intact when observation is unavailable or unused.\n\n**Phase B — executor measurement adapters**\n\n**Stories:** `s2`, `s3`, `s4`\n\nConnect workflow/analyze, review and managed test measurements independently against the common contracts.\n\n**Backward compat:** Retain current progress/delta frames, review checkpoints and gate behavior, test exit codes and process ownership. A missing measurement degrades observation only.\n\n**Phase C — client delivery and qualification**\n\n**Stories:** `s5`, `s6`\n\nConnect VS Code lifecycle and native MCP adapters after the measurement shapes stabilize. Each delivery adapter qualifies independently.\n\n**Backward compat:** VS Code keeps existing chat rendering and active-list rules. A missing or expired MCP token stays silent, and fallback is opt-in with capability evidence.\n\n**Ordering rationale:** s1 owns shared contracts needed by all producers and consumers. s2–s4 own their measurement contracts and each depends only on s1. s5 and s6 consume all producer details and share no client dependency. Link the approved successor to the July scope separately from rollout.\n\n**Risky bits**\n\n| Area | Why | Mitigation |\n| :--- | :--- | :--- |\n| Owner or attempt loss | Delayed callbacks or stale associations could make an ended chat appear live or overwrite newer task state. | Persist verified snapshots, fence writes by owner epoch and attempt, bound retention leases, and test daemon restart and multiple-window races. |\n| Native client delivery and fallback drift | MCP acceptance, visible progress and scheduling are independent capabilities. | Qualify each client/version/session separately. Use one coordinator schedule with a fake-clock cadence test, and report unsupported or suspended observation visibly. |\n| Counter and result truth | Tool frames and test reporters can omit totals, duplicate events or end before a verified result. | Keep producer units explicit, count only verified supported measurements, preserve raw outcomes, and cover unknown totals, nested suites, retries, reporter failure and nonzero exit. |\n\n## 9. Alternatives considered\n\n### 9.1 a1: Executor delegates with a shared daemon coordinator — **CHOSEN**\n\nNormalize authorized executor measurements once and deliver typed snapshots through existing transports.\n\nEach executor remains authoritative for lifecycle and exposes a bounded, read-only delegate snapshot. A daemon coordinator orders and retains task observations, deduplicates delivery, and bridges execution-owner activity to scoped session retention.\n\nVS Code subscribes over the existing Unix IPC seam and projects snapshots into the originating chat. MCP maps those snapshots to request-scoped progress or a separate opted-in observation response. Existing workflow/analyze frames remain compatible.\n\n**Pros:**\n- One observation model keeps replay, loss and attempt handling consistent across VS Code and MCP.\n- Native observation requires zero model calls and separates retention renewal from delivery.\n\n**Cons:**\n- A daemon-owned snapshot store and owner epoch checks need restart and expiry qualification.\n- Each executor needs a narrowly scoped observation bridge.\n\n**Cost estimate:** L\n\n### 9.2 a2: Client-local adapters over executor-specific streams\n\nLet each client track and interpret progress directly from the source stream.\n\nEach executor exposes its own progress messages and the client adapts them to transcript or CLI updates. Existing streams remain the primary source.\n\nEach client maintains its own reconnect state and derives activity from the channels it can observe. Coordination across windows and tool lifetimes requires agreement between clients.\n\n**Pros:**\n- One active client can render existing stream events with few daemon changes.\n\n**Cons:**\n- Disconnected observers cannot establish execution ownership or keep the correct chat active independently.\n- Multiple clients can duplicate observation schedules and disagree on terminal state.\n\n**Cost estimate:** M\n\n**Rejected because:** Reuses transport but loses consistent shared ownership, replay and fallback scheduling.\n\n### 9.3 a3: Central job scheduler and progress event log\n\nMove execution and replay into a central job platform.\n\nA common scheduler would dispatch workflow, review, analysis and test jobs and record each execution event. The scheduler would own retries, task state and replay.\n\nClients would receive progress from job subscriptions. Migration would move authority away from existing workflow and review executors.\n\n**Pros:**\n- A single scheduler could provide a uniform execution identity and lifecycle for migrated jobs.\n\n**Cons:**\n- Changes current executor ownership and introduces retry and scheduling behavior outside this epic.\n- An event per output fragment would expand storage unless separately bounded.\n\n**Cost estimate:** L\n\n**Rejected because:** Centralizes execution and therefore conflicts with the approved ownership boundary.\n\n## 10. UX\n\n- [UX mock](docs/epics/show-long-running-task-progress-chat-E20261109206db342/ux-mock.html)\n\n## 11. References\n\n- **[[c1]]** `prior-artifact` `docs/epics/stream-incremental-progress-from-daemon-calling-E202607196d6cfaf9/DEF.md`\n- **[[c2]]** `prior-artifact` `docs/epics/stream-incremental-progress-from-daemon-calling-E202607196d6cfaf9/HLD.md`\n- **[[c3]]** `prior-artifact` `docs/standalone/show-background-task-progress-chat-E2026110407024f1d/SPEC.md`\n- **[[c4]]** `code` `src/daemon/__tests__/workflow-progress-map.test.ts`\n- **[[c5]]** `code` `src/daemon/__tests__/analyze-progress.test.ts`\n- **[[c6]]** `code` `src/mcp/__tests__/progress-forward.test.ts`\n- **[[c7]]** `code` `src/workflow/code-review/task-review/progress.ts`\n- **[[c8]]** `convention` `AGENTS.md`\n- **[[c9]]** `prior-artifact` `docs/epics/stream-incremental-progress-from-daemon-calling-E202607196d6cfaf9/DEF.md`\n- **[[c10]]** `prior-artifact` `docs/epics/show-long-running-task-progress-chat-E20261109206db342/DEF.md`\n- **[[c11]]** `code` `src/daemon/workflow-rpc.ts`\n- **[[c12]]** `code` `src/daemon/analyze-rpc.ts`\n- **[[c13]]** `code` `src/shared/types.ts`\n- **[[c14]]** `code` `src/mcp/progress-forward.ts`\n- **[[c15]]** `code` `src/mcp/server.ts`\n- **[[c16]]** `code` `src/workflow/review/design-review/progress.ts`\n- **[[c17]]** `code` `src/workflow/code-review/task-review/progress.ts`\n- **[[c18]]** `code` `src/daemon/steps/build-step/validation-checks.ts`\n- **[[c19]]** `code` `src/daemon/chat-sessions.ts`\n- **[[c20]]** `code` `vscode-plugin/src/chat/protocol.ts`\n- **[[c21]]** `code` `vscode-plugin/src/chat/session-file-store.ts`\n- **[[c22]]** `code` `vscode-plugin/src/chat/chat-panel.ts`\n"},"capturedAt":"2026-11-09T08:07:09.307Z"},"inventory":{"units":[{"id":"/body/summary","selector":"/body/summary","title":"summary","kind":"section"},{"id":"/body/frameworkSummary","selector":"/body/frameworkSummary","title":"frameworkSummary","kind":"section"},{"id":"/body/architectureShape","selector":"/body/ar