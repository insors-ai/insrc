contract"},{"id":"/body/alternativesConsidered/0","selector":"/body/alternativesConsidered/0","title":"a1","kind":"requirement"},{"id":"/body/alternativesConsidered/1","selector":"/body/alternativesConsidered/1","title":"a2","kind":"requirement"},{"id":"/body/alternativesConsidered/2","selector":"/body/alternativesConsidered/2","title":"a3","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/0","selector":"/body/sequenceDefinition/participants/0","title":"executor","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/1","selector":"/body/sequenceDefinition/participants/1","title":"delegate","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/2","selector":"/body/sequenceDefinition/participants/2","title":"daemon","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/3","selector":"/body/sequenceDefinition/participants/3","title":"store","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/4","selector":"/body/sequenceDefinition/participants/4","title":"session","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/5","selector":"/body/sequenceDefinition/participants/5","title":"vs","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/6","selector":"/body/sequenceDefinition/participants/6","title":"mcp","kind":"requirement"},{"id":"/body/componentDependencyDefinition/components/0","selector":"/body/componentDependencyDefinition/components/0","title":"executors","kind":"requirement"},{"id":"/body/componentDependencyDefinition/components/1","selector":"/body/componentDependencyDefinition/components/1","title":"delegates","kind":"requirement"},{"id":"/body/componentDependencyDefinition/components/2","selector":"/body/componentDependencyDefinition/components/2","title":"coordinator","kind":"requirement"},{"id":"/body/componentDependencyDefinition/components/3","selector":"/body/componentDependencyDefinition/components/3","title":"durability","kind":"requirement"},{"id":"/body/componentDependencyDefinition/components/4","selector":"/body/componentDependencyDefinition/components/4","title":"session","kind":"requirement"},{"id":"/body/componentDependencyDefinition/components/5","selector":"/body/componentDependencyDefinition/components/5","title":"vscode","kind":"requirement"},{"id":"/body/componentDependencyDefinition/components/6","selector":"/body/componentDependencyDefinition/components/6","title":"mcp","kind":"requirement"},{"id":"/citations/0","selector":"/citations/0","title":"Citation 1","kind":"citation"},{"id":"/citations/1","selector":"/citations/1","title":"Citation 2","kind":"citation"},{"id":"/citations/2","selector":"/citations/2","title":"Citation 3","kind":"citation"},{"id":"/citations/3","selector":"/citations/3","title":"Citation 4","kind":"citation"},{"id":"/citations/4","selector":"/citations/4","title":"Citation 5","kind":"citation"},{"id":"/citations/5","selector":"/citations/5","title":"Citation 6","kind":"citation"},{"id":"/citations/6","selector":"/citations/6","title":"Citation 7","kind":"citation"},{"id":"/citations/7","selector":"/citations/7","title":"Citation 8","kind":"citation"},{"id":"/citations/8","selector":"/citations/8","title":"Citation 9","kind":"citation"},{"id":"/citations/9","selector":"/citations/9","title":"Citation 10","kind":"citation"},{"id":"/citations/10","selector":"/citations/10","title":"Citation 11","kind":"citation"},{"id":"/citations/11","selector":"/citations/11","title":"Citation 12","kind":"citation"},{"id":"/citations/12","selector":"/citations/12","title":"Citation 13","kind":"citation"},{"id":"/citations/13","selector":"/citations/13","title":"Citation 14","kind":"citation"},{"id":"/citations/14","selector":"/citations/14","title":"Citation 15","kind":"citation"},{"id":"/citations/15","selector":"/citations/15","title":"Citation 16","kind":"citation"},{"id":"/citations/16","selector":"/citations/16","title":"Citation 17","kind":"citation"},{"id":"/citations/17","selector":"/citations/17","title":"Citation 18","kind":"citation"},{"id":"/citations/18","selector":"/citations/18","title":"Citation 19","kind":"citation"},{"id":"/citations/19","selector":"/citations/19","title":"Citation 20","kind":"citation"},{"id":"/citations/20","selector":"/citations/20","title":"Citation 21","kind":"citation"},{"id":"/citations/21","selector":"/citations/21","title":"Citation 22","kind":"citation"},{"id":"document:line:25","selector":"document:line:25","title":"1. Problem context","kind":"section"},{"id":"document:line:43","selector":"document:line:43","title":"4. Diagrams","kind":"section"},{"id":"document:line:293","selector":"document:line:293","title":"7. Non-functional targets","kind":"section"},{"id":"document:line:300","selector":"document:line:300","title":"8. Rollout","kind":"section"},{"id":"document:line:394","selector":"document:line:394","title":"10. UX","kind":"section"}]},"completedChunks":[{"chunkId":"architecture","status":"incomplete","summary":"The architecture and delivery sequence align with the DEF: executors retain authority, daemon-owned observation remains separate from execution, and producer adapters precede independent client delivery stories. Component source matches the canonical definition and companion files exist. No demonstrated blocking architecture defect was found, but mandatory visual verification could not be completed.","findings":[],"inspectedReferences":["/body/summary","/body/frameworkSummary","/body/architectureShape","/body/storyBoundaries","/body/rolloutOverview","/body/alternativesConsidered","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/alternativesConsidered/2","/body/chosenAlternative","/body/openQuestions","/body/componentDependencyDefinition","/body/componentDependencyDefinition/components/0","/body/componentDependencyDefinition/components/1","/body/componentDependencyDefinition/components/2","/body/componentDependencyDefinition/components/3","/body/componentDependencyDefinition