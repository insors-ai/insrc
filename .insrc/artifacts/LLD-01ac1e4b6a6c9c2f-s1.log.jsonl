117981	{"artifactId":"LLD-01ac1e4b6a6c9c2f-s1","entry":{"id":"8ff0ef7be3662bcce6071945421731cd3d3f36c782ec14f3cc21334d46c4183b","targetHeadHash":"8db23238625ca8d9024d826ab011354ce2e590b68cdc6592000fca72d1ab43ae","actor":{"id":"agent:design-review-daemon","kind":"agent","properties":{"party":"daemon"}},"timestamp":"2026-11-14T16:25:16.613Z","operation":"review","revision":{"number":1,"contentHash":"569d51596482711157f0b7c4128cba9e484dbd80e73f4a00e9e4c37bec951305"},"outcome":{"result":"block","summary":"Design review review-lld-01ac1e4b6a6c9c2f-s1 attempt 1","data":{"kind":"design-chunk-review","reviewId":"review-lld-01ac1e4b6a6c9c2f-s1","project":"/Users/subhagho/work/projects/insors/insrc","artifactId":"LLD-01ac1e4b6a6c9c2f-s1","subject":{"project":"/Users/subhagho/work/projects/insors/insrc","artifactId":"LLD-01ac1e4b6a6c9c2f-s1","kind":"LLD","canonicalPath":"/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-01ac1e4b6a6c9c2f-s1.json","documentPath":"/Users/subhagho/work/projects/insors/insrc/docs/standalone/scratchpad-document-view-read-only-cannot-E2026111401ac1e4b/S001/LLD.md","reviewer":"daemon","workflow":{"kind":"issue","rootArtifactId":"ISSUE-01ac1e4b6a6c9c2f","requiredReferences":[{"role":"originating_issue","artifactId":"ISSUE-01ac1e4b6a6c9c2f","path":"/Users/subhagho/work/projects/insors/insrc/docs/standalone/scratchpad-document-view-read-only-cannot-E2026111401ac1e4b/ISSUE.md"}],"availableReferences":[],"notApplicableRoles":["PLAN","TASKS","BUILD","CR","DEF","HLD","sibling_stories"]}},"reviewer":"daemon","applicableAttempt":1,"status":"incomplete","binding":{"sourceRevision":{"number":1,"contentHash":"569d51596482711157f0b7c4128cba9e484dbd80e73f4a00e9e4c37bec951305"},"reviewedContentIdentity":"2a7edc553266f33c4e3ba2cc29a814aec783e9ffdb44ef9311bc7bf05f6bb750","documentDigest":"2e0a1ca241dc11c7443c8fa5fa4c502022d0b414724ccf364cce561fc756709e","workflowDigest":"fc59694165110896bbd05756de3fd76e9cad3ac2da3a93d665618e661e7278c5","author":"controller"},"preservationDigest":"3cec3a2940b4695c27cd6b1d4f4a2cf8039be6a5a13107e2681d7ef01cb652e1","schemaVersion":2,"submitted":{"artifactPath":"/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-01ac1e4b6a6c9c2f-s1.json","attempt":1},"attempts":[{"number":1,"status":"incomplete","preparationKind":"planning","baseline":{"subjectFingerprints":{"canonical":"090a2d6d92803dab9c1a86799a0fd41fa253e29b162f023a43f8c33b80b746b3","document":"2e0a1ca241dc11c7443c8fa5fa4c502022d0b414724ccf364cce561fc756709e"},"contentIdentity":"2a7edc553266f33c4e3ba2cc29a814aec783e9ffdb44ef9311bc7bf05f6bb750","reviewedContent":{"canonical":"{\n  \"meta\": {\n    \"workflow\": \"design.story\",\n    \"runId\": \"wf-1794672418662-gm1x9s\",\n    \"repoPath\": \"/Users/subhagho/work/projects/insors/insrc\",\n    \"createdAt\": \"2026-11-14T16:17:36.451Z\",\n    \"epicCreatedAt\": \"2026-11-14T15:32:49.965Z\",\n    \"attribution\": {\n      \"outputs\": [\n        {\n          \"role\": \"(client)\",\n          \"tier\": \"core\",\n          \"runner\": \"cli-claude\",\n          \"model\": \"unknown\"\n        }\n      ]\n    },\n    \"elapsedMs\": 637457,\n    \"repoIndexedAt\": null,\n    \"schemaVersion\": 1,\n    \"epicHash\": \"01ac1e4b6a6c9c2f\",\n    \"epicSlug\": \"scratchpad-document-view-read-only-cannot\",\n    \"storyId\": \"s1\",\n    \"hldBaseRunId\": \"wf-1794672418662-gm1x9s\",\n    \"hldEffectiveHash\": \"e3f317296671046459538b1af52927bb87406ca27bacfb2a592158de3ea238c9\",\n    \"hldAmendmentsApplied\": [],\n    \"storyTitle\": \"Make the scratchpad document view editable in-plugin (ISSUE-01ac1e4b6a6c9c2f)\",\n    \"standalone\": true,\n    \"sizeClass\": \"bugfix\",\n    \"authoredBy\": \"controller\",\n    \"lifecycle\": {\n      \"status\": \"draft\",\n      \"revision\": {\n        \"number\": 1,\n        \"contentHash\": \"569d51596482711157f0b7c4128cba9e484dbd80e73f4a00e9e4c37bec951305\",\n        \"at\": \"2026-11-14T16:17:36.570Z\",\n        \"by\": {\n          \"id\": \"insrc:system\",\n          \"kind\": \"system\",\n          \"properties\": {}\n        }\n      },\n      \"signoffs\": []\n    },\n    \"revision\": 1\n  },\n  \"body\": {\n    \"adherence\": {\n      \"dimensions\": [\n        \"ux\",\n        \"functional-coverage\"\n      ]\n    },\n    \"alternativesConsidered\": [\n      {\n        \"id\": \"a1\",\n        \"name\": \"Editable textarea in the existing scratchpad webview + atomic updateScratch\",\n        \"oneLineSummary\": \"Make the existing 'insrc.scratchpad' document view's <pre> an editable <textarea>, add scratch-save/scratch-saved protocol messages and ScratchStore.updateScratch with temp-write + atomic publish.\",\n        \"approach\": \"Keep the existing singleton 'insrc.scratchpad' document webview; in documentBodyHtml replace the <pre id=\\\"insrc-scratchdoc\\\"> with a <textarea id=\\\"insrc-scratchdoc\\\"> (same id, CSP-safe: value set via .value, never innerHTML). Content push 'scratch-content' sets textarea.value. Bootstrap adds: input listener marking dirty + showing a save button (and panel title suffix), Ctrl/Cmd+S and the save button posting new webview->host 'scratch-save' {id, text: textarea.value}; host->webview 'scratch-saved' {id, ok, error?} clears dirty on ok / surfaces error. Host routes 'scratch-save' in scratch-host.ts to new store.updateScratch(id, text) which validates id (inside root, regular file, no symlink), writes temp file, publishes atomically over the destination. Selection-based send-to-chat keeps working over textarea selections. Minimal new surface: 1 webview->host type, 1 host->webview type, 1 store op, dirty flag in the controller.\",\n        \"pros\": [\n          \"Smallest change that fully meets the ISSUE fix intent; keeps the singleton panel, generation/epoch guards, ready-replay handshake and wrap() delivery logging untouched\",\n          \"Reuses the existing CSP shell, nonce, bootstrap pattern and send-to-chat selection code (works on textarea selections)\",\n          \"updateScratch mirrors createScratch's existing security shape (id validation, temp file, publish), so invariants are preserved by construction\",\n          \"Dirty state + save affordance are webview-local; the host only gains one intent route\"\n        ],\n        \"cons\": [\n          \"A textarea is plain-text editing, not markdown preview — but the current view is already plain text, so no regression\",\n          \"rename-based publish must handle the destination being replaced externally (covered in error paths)\"\n        ],\n        \"costEstimate\": \"S\"\n      },\n      {\n        \"id\": \"a2\",\n        \"name\": \"contentEditable div in the document view\",\n        \"oneLineSummary\": \"Same save round-trip as a1 but the editable element is a contentEditable div fed via textContent/innerText.\",\n        \"approach\": \"contentEditable div instead of textarea: documentBodyHtml emits <div id=\\\"insrc-scratchdoc\\\" contenteditable=\\\"true\\\">; 'scratch-content' sets textContent as today; save posts 'scratch-save' {id, text: div.innerText}; same protocol additions and store op as a1.\",\n        \"pros\": [\n          \"Keeps the textContent assignment path from the current bootstrap nearly unchanged\",\n          \"Selection APIs behave similarly\"\n        ],\n        \"cons\": [\n          \"contentEditable brings rich-text paste and DOM-mutation edge cases into a CSP-strict webview; innerText round-trips are less predictable than textarea.value\",\n          \"No advantage over textarea for a plain-markdown scratchpad\",\n          \"Harder to pin in source-scan tests (contenteditable attribute vs textarea value semantics)\"\n        ],\n        \"costEstimate\": \"S\",\n        \"reasonRejected\": \"contentEditable + innerText round-trips add rich-text paste and DOM-mutation edge cases into a CSP-strict webview; weaker testability in source-scan tests; same store-write need as a1 without its clean .value contract.\"\n      },\n      {\n        \"id\": \"a3\",\n        \"name\": \"Open the .md file in a native VS Code editor instead of the webview\",\n        \"oneLineSummary\": \"Replace the custom document webview with VS Code's native text editor on the scratchpad file.\",\n        \"approach\": \"Do not edit in the webview at all: 'scratch-open' opens the underlying ~/.insrc/scratches/<id>.md file in a real VS Code text editor (workspace.openTextDocument + showTextDocument) instead of the custom webview; editing/saving is native. The webview document view is kept only for send-to-chat, or dropped.\",\n        \"pros\": [\n          \"Native editing, syntax highlighting, native save — zero custom editing code\",\n          \"The external file is the source of truth anyway\"\n        ],\n        \"cons\": [\n          \"Changes the UX fundamentally — the ISSUE asks for the scratchpad (the popup's opened view) to be editable; opening an external file editor changes the panel contract, tab identity, and the create-or-reveal singleton + generation/epoch machinery becomes dead code\",\n          \"Loses the floating send-to-chat button and the ISSUE-3183af2a popup behavior tied to the webview\",\n          \"Bigger blast radius: extension.ts wiring, viewType registration, tests all change; the plugin can no longer guarantee content flows through the store\",\n          \"Conflicts with the approved fix intent (editable surface + save through the store)\"\n        ],\n        \"costEstimate\": \"M\",\n        \"reasonRejected\": \"Throws away the singleton panel machinery the earlier stories built and ISSUE-3183af2a hardened; cost M; changes UX away from the scratchpad view the ISSUE reports as read-only; contradicts the approved fix intent (editable surface + save through the store).\"\n      },\n      {\n        \"id\": \"a4\",\n        \"name\": \"Read-only webview + 'Edit' button opening the native editor\",\n        \"oneLineSummary\": \"Keep the webview as-is; add an 'Edit' icon button that opens the native editor on the file.\",\n        \"approach\": \"Keep the webview as-is; add an edit affordance that hands off to a native text editor on the .md file; the webview watches/re-reads on reveal. Save happens natively; browse refreshes on panel reveal.\",\n        \"pros\": [\n          \"Native editing without replacing the webview\",\n          \"Small webview change (one button + one intent)\"\n        ],\n        \"cons\": [\n          \"The scratchpad view itself remains read-only — does not satisfy 'the scratchpad is not editable' as reported\",\n          \"Stale-content sync issue between webview and file\"\n        ],\n        \"costEstimate\": \"M\",\n        \"reasonRejected\": \"Fails the ISSUE-01ac1e4b6a6c9c2f fix intent — the scratchpad view itself remains read-only, which is exactly the reported complaint; this is the status quo ac5 already scoped out.\"\n      }\n    ],\n    \"chosenAlternative\": \"a1\",\n    \"contractDetails\": {\n      \"api\": [\n        {\n          \"errors\": [\n            {\n              \"condition\": \"id is not a *.md filename resolving strictly inside the store root, or lstat shows not-a-regular-file / symlink\",\n              \"type\": \"ScratchRefused\"\n            },\n            {\n              \"condition\": \"the scratchpad file no longer exists at save time\",\n              \"type\": \"ScratchNotFound\"\n            },\n            {\n              \"condition\": \"write/publish failure EACCES/ENOSPC/EROFS etc.\",\n              \"type\": \"ScratchStoreError\"\n            }\n          ],\n          \"name\": \"ScratchStore.updateScratch\",\n          \"parameters\": [\n            {\n              \"name\": \"id\",\n              \"optional\": false,\n              \"purpose\": \"scratchpad id = file basename, validated exactly like readScratch/deleteScratch (inside root, regular file, symlink refused)\",\n              \"type\": \"string\"\n            },\n            {\n              \"name\": \"text\",\n              \"optional\": false,\n              \"purpose\": \"full new markdown content to persist\",\n              \"type\": \"string\"\n            }\n          ],\n          \"postconditions\": [\n            \"the destination file's content equals text\",\n            \"mtime is bumped so listScratches/browse reflect the save\",\n            \"no temp file is left behind\",\n            \"a pre-existing destination is replaced atomically (temp write + publish), never partially written\"\n          ],\n          \"preconditions\": [\n            \"store root exists (created lazily as today)\",\n            \"id passes the same validation as readScratch (resolve strictly inside root, basename *.md, lstat regular file, symlink refused)\"\n          ],\n          \"returns\": {\n            \"meaning\": \"resolves when the file has been atomically replaced with text; the ScratchEntry metadata (id/name/mtime/size) is unchanged in shape, mtime/size derived from the file\",\n            \"type\": \"Promise<void>\"\n          },\n          \"signature\": \"updateScratch(id: string, text: string): Promise<void>  // vscode-plugin/src/chat/scratch-store.ts — NEW\"\n        },\n        {\n          \"errors\": [\n            {\n              \"condition\": \"msg.id/msg.text not a string\",\n              \"type\": \"dropped + log.warn (same as other scratch intents)\"\n            }\n          ],\n          \"name\": \"scratch-save intent (WebviewToHost member)\",\n          \"parameters\": [\n            {\n              \"name\": \"id\",\n              \"optional\": false,\n              \"purpose\": \"which scratchpad to save\",\n              \"type\": \"string\"\n            },\n            {\n              \"name\": \"text\",\n              \"optional\": false,\n              \"purpose\": \"full editable content from the textarea\",\n              \"type\": \"string\"\n            }\n          ],\n          \"postconditions\": [\n            \"host routes to store.updateScratch(id, text)\",\n            \"on success: host->webview 'scratch-saved' {id, ok:true} + refreshBrowse() + chat scratch-list re-push so the menu's mtime updates\",\n            \"on failure: 'scratch-saved' {id, ok:false, error} and the dirty state stays\"\n          ],\n          \"preconditions\": [\n            \"the document webview posted it; id matches the panel's showingId at the controller level (generation/epoch guards apply)\"\n          ],\n          \"returns\": {\n            \"meaning\": \"void (async fire-and-forget from the webview, like the other scratch intents)\",\n            \"type\": \"void\"\n          },\n          \"signature\": \"{ type: 'scratch-save'; id: string; text: string }  // NEW member of WebviewToHost in vscode-plugin/src/chat/protocol.ts + WEBVIEW_TO_HOST_TYPES\"\n        },\n        {\n          \"errors\": [\n            {\n              \"condition\": \"delivered=false or rejected post from the wrapped handle\",\n              \"type\": \"logged via the existing wrap() drop logging (ISSUE-3183af2a)\"\n            }\n          ],\n          \"name\": \"scratch-saved reply (HostToWebview member)\",\n          \"parameters\": [\n            {\n              \"name\": \"id\",\n              \"optional\": false,\n              \"purpose\": \"which save this answers\",\n              \"type\": \"string\"\n            },\n            {\n              \"name\": \"ok\",\n              \"optional\": false,\n              \"purpose\": \"success flag\",\n              \"type\": \"boolean\"\n            },\n            {\n              \"name\": \"error\",\n              \"optional\": true,\n              \"purpose\": \"failure message shown in the view when ok=false\",\n              \"type\": \"string\"\n            }\n          ],\n          \"postconditions\": [\n            \"webview 'scratch-saved' handler with matching id+current generation: ok=true clears dirty (hides save button, clears title suffix), ok=false surfaces the error text in the view and keeps dirty\"\n          ],\n          \"preconditions\": [\n            \"the generation tag matches the live docGeneration (stale replies from a superseded page load are ignored, same rule as scratch-ready)\"\n          ],\n          \"returns\": {\n            \"meaning\": \"void\",\n            \"type\": \"void\"\n          },\n          \"signature\": \"{ type: 'scratch-saved'; id: string; ok: boolean; error?: string }  // NEW member of HostToWebview in vscode-plugin/src/chat/protocol.ts + HOST_TO_WEBVIEW_TYPES\"\n        },\n        {\n          \"errors\": [\n            {\n              \"condition\": \"setHtml throws or panel disposed\",\n              \"type\": \"logged via log.warn, openDocument returns the handle (existing pattern)\"\n            }\n          ],\n          \"name\": \"documentBodyHtml / documentBootstrap (reshaped)\",\n          \"parameters\": [\n            {\n              \"name\": \"gen\",\n              \"optional\": false,\n              \"purpose\": \"document generation tag embedded in the bootstrap, echoed in scratch-ready and scratch-saved\",\n              \"type\": \"number\"\n            }\n          ],\n          \"postconditions\": [\n            \"the document body contains <textarea id=\\\"insrc-scratchdoc\\\"> (editable, CSP-safe: content assigned via .value, never innerHTML) plus the existing floating send-to-chat button and a hidden save button\",\n            \"bootstrap wires: scratch-content → doc.value; input → dirty=true + show save button + set panel title suffix '•'; keydown Ctrl/Cmd+S and save-button click → post 'scratch-save' {id, text: doc.value}; message 'scratch-saved' matching gen+id → clear dirty or show error; selectionchange send-to-chat logic unchanged and working over textarea selections\"\n          ],\n          \"preconditions\": [\n            \"same CSP nonce shell (shellHtml) and ready handshake as today\"\n          ],\n          \"returns\": {\n            \"meaning\": \"static body HTML string (documentBodyHtml) / nonce'd bootstrap JS string (documentBootstrap)\",\n            \"type\": \"string\"\n          },\n          \"signature\": \"documentBodyHtml(): string; documentBootstrap(gen: number): string  // vscode-plugin/src/panels/scratch-panels.ts — RESHAPED (pre → textarea, + save wiring)\"\n        },\n        {\n          \"errors\": [\n            {\n              \"condition\": \"store update failed\",\n              \"type\": \"'scratch-saved' ok=false + log.warn + browse refresh still runs\"\n            }\n          ],\n          \"name\": \"scratch-host 'scratch-save' route\",\n          \"parameters\": [\n            {\n              \"name\": \"msg\",\n              \"optional\": false,\n              \"purpose\": \"the intent\",\n              \"type\": \"WebviewToHost\"\n            }\n          ],\n          \"postconditions\": [\n            \"await store.updateScratch(id, text); panels.refreshBrowse(); sendScratchList() so the chat menu mtime refreshes; reply 'scratch-saved' to the document panel with ok/error\"\n          ],\n          \"preconditions\": [\n            \"SCRATCH_INTENT_TYPES includes 'scratch-save'\"\n          ],\n          \"returns\": {\n            \"meaning\": \"void\",\n            \"type\": \"void\"\n          },\n          \"signature\": \"case 'scratch-save' in createScratchHost.onMessage  // vscode-plugin/src/chat/scratch-host.ts — NEW route\"\n        }\n      ],\n      \"surfaceLevel\": \"internal\"\n    },\n    \"dataModelChanges\": [\n      {\n        \"callSites\": [\n          \"vscode-plugin/src/chat/protocol.ts\",\n          \"vscode-plugin/src/chat/scratch-host.ts\",\n          \"vscode-plugin/src/panels/scratch-panels.ts\",\n          \"vscode-plugin/src/chat/__tests__/protocol.test.ts\",\n          \"vscode-plugin/src/chat/__tests__/scratch-store.test.ts\",\n          \"vscode-plugin/src/chat/__tests__/extension-chat-wiring.test.ts\"\n        ],\n        \"change\": \"field-add\",\n        \"details\": \"WebviewToHost gains { type: 'scratch-save'; id: string; text: string } and HostToWebview gains { type: 'scratch-saved'; id: string; ok: boolean; error?: string }; both added to their OWN direction's const array (WEBVIEW_TO_HOST_TYPES / HOST_TO_WEBVIEW_TYPES) with direction-isolation assertions in the protocol test. Payload field names are part of the contract; ids/texts must be strings at runtime.\",\n        \"entity\": \"WebviewToHost / HostToWebview message unions\"\n      },\n      {\n        \"callSites\": [\n          \"vscode-plugin/src/chat/scratch-store.ts\",\n          \"vscode-plugin/src/chat/__tests__/scratch-store.test.ts\",\n          \"vscode-plugin/src/chat/__tests__/fake-scratch-fs.ts\"\n        ],\n        \"change\": \"field-add\",\n        \"details\": \"ScratchStore gains updateScratch(id, text): temp file (pid+random suffix, never *.md) written with the new content, published over the destination via rename (atomic replace) after re-validating id (resolve strictly inside root, lstat regular file, symlink refused — O_NOFOLLOW discipline); temp file unlinked on failure. ScratchEntry shape unchanged.\",\n        \"entity\": \"ScratchStore interface\"\n      },\n      {\n        \"callSites\": [\n          \"vscode-plugin/src/panels/scratch-panels.ts\",\n          \"vscode-plugin/src/panels/__tests__/scratch-panel.test.ts\"\n        ],\n        \"change\": \"field-modify\",\n        \"details\": \"Document view DOM: <pre class=\\\"scratch-doc\\\"> becomes <textarea id=\\\"insrc-scratchdoc\\\" class=\\\"scratch-doc\\\">; content push sets .value; adds hidden save button, dirty tracking, Ctrl/Cmd+S, title suffix, 'scratch-saved' handling with generation guard. Generation/epoch/ready-replay machinery and wrap() delivery logging unchanged.\",\n        \"entity\": \"insrc.scratchpad document view (documentBodyHtml/documentBootstrap)\"\n      }\n    ],\n    \"errorPaths\": {\n      \"edgeCases\": [\n        {\n          \"expected\": \"Stale-generation 'scratch-saved' replies are ignored by the webview handler (same rule as scratch-ready)\",\n          \"input\": \"'scratch-saved' arriving with a gen older than the live docGeneration\"\n        },\n        {\n          \"expected\": \"Dirty remains, error shown inline, log.warn recorded, browse/list still refresh\",\n          \"input\": \"store.updateScratch rejects during save (file deleted concurrently → ScratchNotFound; EACCES/ENOSPC → ScratchStoreError)\"\n        },\n        {\n          \"expected\": \"Logged via the existing wrap() drop logging (ISSUE-3183af2a); dirty remains until a reply arrives\",\n          \"input\": \"postMessage delivery fails or the wrapped handle rejects the 'scratch-saved' reply\"\n        }\n      ],\n      \"errorCases\": [\n        {\n          \"detection\": \"At save time the id fails validation: not a *.md basename resolving strictly inside the store root, lstat shows not-a-regular-file, or the path is a symlink (O_NOFOLLOW discipline)\",\n          \"recoverable\": true,\n          \"response\": \"Reject with ScratchRefused → host replies 'scratch-saved' {ok:false, error} + log.warn\",\n          \"scenario\": \"scratch-save arrives with a tampered/outside-root/symlink id\",\n          \"userImpact\": \"The save is refused and the dirty state stays; nothing is written outside the store root\"\n        },\n        {\n          \"detection\": \"ENOENT when the destination is re-validated at save time (deleted between open and save)\",\n          \"recoverable\": true,\n          \"response\": \"Reject with ScratchNotFound → 'scratch-saved' ok:false + log.warn\",\n          \"scenario\": \"The scratchpad file no longer exists at save time\",\n          \"userImpact\": \"Error surfaces inline in the document view; dirty remains\"\n        },\n        {\n          \"detection\": \"EACCES/ENOSPC/EROFS etc. from the temp write or the publish rename; temp file unlinked, destination untouched\",\n          \"recoverable\": true,\n          \"response\": \"Reject with ScratchStoreError → 'scratch-saved' ok:false + log.warn\",\n          \"scenario\": \"The atomic write/publish fails partway\",\n          \"userImpact\": \"No partial content is ever visible on disk; the user can retry\"\n        },\n        {\n          \"detection\": \"Non-string msg.id or msg.text in the router's scratch-save case\",\n          \"recoverable\": true,\n          \"response\": \"Dropped with log.warn, no reply (same as other malformed scratch intents)\",\n          \"scenario\": \"Malformed scratch-save payload from the webview\",\n          \"userImpact\": \"Nothing happens; the drop is visible in the extension log\"\n        }\n      ],\n      \"invariantsToPreserve\": [\n        {\n          \"source\": \"c1\",\n          \"text\": \"CSP nonce shell (shellHtml) and the scratch-ready generation handshake stay exactly as today; content is assigned via .value, never innerHTML\"\n        },\n        {\n          \"source\": \"c1\",\n          \"text\": \"Singleton panel, docGeneration/epoch guards, pendingContent replay and wrap() postMessage drop logging (ISSUE-3183af2a) are untouched\"\n        },\n        {\n          \"source\": \"c2\",\n          \"text\": \"Store security invariants: id resolves strictly inside ~/.insrc/scratches root, lstat regular-file check, symlink refusal, O_NOFOLLOW fd reads, temp-write + atomic publish, no partial writes\"\n        },\n        {\n          \"source\": \"c3\",\n          \"text\": \"Selection-based send-to-chat (selectionchange latch + 65,536 UTF-8 byte capUtf8) works unchanged over textarea selections\"\n        }\n      ]\n    },\n    \"hldContextSlice\": {\n      \"adjacentBoundaries\": [],\n      \"boundary\": {\n        \"depends\": [],\n        \"internal\": \"Make the scratchpad document view editable in-plugin (ISSUE-01ac1e4b6a6c9c2f)\",\n        \"owns\": [\n          \"vscode-plugin/src/panels/scratch-panels.ts\",\n          \"vscode-plugin/src/chat/scratch-host.ts\",\n          \"vscode-plugin/src/chat/scratch-store.ts\",\n          \"vscode-plugin/src/chat/protocol.ts\",\n          \"vscode-plugin/src/extension.ts wiring\",\n          \"scratchpad tests\"\n        ],\n        \"storyId\": \"s1\"\n      },\n      \"consumedContracts\": [],\n      \"frameworkSummary\": \"Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\",\n      \"nonFunctional\": {},\n      \"ownedContracts\": [],\n      \"rolloutPhase\": \"standalone\"\n    },\n    \"interactionWithShared\": [],\n    \"migration\": {\n      \"backwardCompat\": \"Both new messages are pure additions to their direction's union, so existing webviews/hosts that never send 'scratch-save' or never receive 'scratch-saved' are unaffected (old document pages never post scratch-save; unknown-type guards already drop unknown messages with a log.warn). The ScratchStore interface gains a method — the only implementors are the nodeScratchFs-backed store and the test fake, both updated in the same change. ScratchEntry shape, the ~/.insrc/scratches/*.md file layout, and all existing intents/replies are unchanged; existing scratchpad files need no rewrite and remain editable as plain files outside the plugin (the original LLD ac5 path stays valid).\",\n      \"dataRewriteRequired\": false,\n      \"migrationSteps\": [\n        {\n          \"action\": \"Add updateScratch(id, text) to the ScratchStore interface and nodeScratchFs implementation: re-validate id exactly as readScratch/deleteScratch (resolve strictly inside the store root, basename *.md, lstat regular file, symlink refused, O_NOFOLLOW discipline), write the new content to a temp file (pid+random suffix, never *.md), publish over the destination with an atomic rename, unlink the temp on any failure; reject with ScratchRefused / ScratchNotFound / ScratchStoreError.\",\n          \"order\": 1,\n          \"rollbackable\": true\n        },\n        {\n          \"action\": \"Extend protocol.ts: add { type: 'scratch-save'; id: string; text: string } to WebviewToHost + WEBVIEW_TO_HOST_TYPES, and { type: 'scratch-saved'; id: string; ok: boolean; error?: string } to HostToWebview + HOST_TO_WEBVIEW_TYPES (each in its OWN direction only); update the direction-isolation/coverage assertions in the protocol test.\",\n          \"order\": 2,\n          \"rollbackable\": true\n        },\n        {\n          \"action\": \"Reshape the document view in scratch-panels.ts: <pre id=\\\"insrc-scratchdoc\\\"> becomes <textarea id=\\\"insrc-scratchdoc\\\" class=\\\"scratch-doc\\\">; scratch-content sets doc.value (never innerHTML, CSP-safe); add hidden icon save button (visible when dirty), input→dirty + panel title '•' suffix, keydown Ctrl/Cmd+S + button click → post 'scratch-save' {id, text: doc.value}, message 'scratch-saved' matching gen+id → clear dirty or show error; selectionchange send-to-chat logic unchanged; generation/epoch/ready-replay machinery and wrap() drop logging untouched.\",\n          \"order\": 3,\n          \"rollbackable\": true\n        },\n        {\n          \"action\": \"Add the 'scratch-save' case to createScratchHost.onMessage (and to SCRATCH_INTENT_TYPES): validate string id/text (warn+drop otherwise), await store.updateScratch, then reply 'scratch-saved' {id, ok, error?} to the document panel, run refreshBrowse() + sendScratchList() so the menu mtime refreshes; on store failure reply ok:false with log.warn, still refresh.\",\n          \"order\": 4,\n          \"rollbackable\": true\n        },\n        {\n          \"action\": \"Tests: scratch-store.test.ts (fake-scratch-fs) for updateScratch happy path/atomicity/refusals/temp cleanup/mtime; protocol direction-isolation; scratch-panel source+behavior pins (textarea, .value, save wiring, gen-guarded scratch-saved, dirty); scratch-host route tests (ok/ok=false/malformed/refresh calls); extension-chat-wiring regex pins. No data or state migration needed.\",\n          \"order\": 5,\n          \"rollbackable\": true\n        }\n      ],\n      \"stateAfter\": \"The scratchpad document view is editable in-plugin: a CSP-safe <textarea> holds the content, a save button (shown only while dirty, plus a '•' title suffix) and Ctrl/Cmd+S post a new 'scratch-save' webview->host intent; the host routes it to a new ScratchStore.updateScratch that atomically rewrites the .md file under the store's existing strict validation (inside-root, regular-file, symlink-refused, O_NOFOLLOW, temp-write + rename publication), then replies 'scratch-saved' {id, ok, error?} which clears the dirty state or surfaces the error; browse table and chat menu refresh after every save; send-to-chat selection, singleton panel, generation/epoch guards and wrap() drop logging are unchanged.\",\n      \"stateBefore\": \"Per the s1 analyze bundle: the document view (vscode-plugin/src/panels/scratch-panels.ts documentBodyHtml:146-151 / documentBootstrap:164-205) renders a read-only <pre id=\\\"insrc-scratchdoc\\\"> filled via textContent only, with send-to-chat over selectionchange; the host router (scratch-host.ts, six intents in SCRATCH_INTENT_TYPES:19-26) has no save intent; ScratchStore (scratch-store.ts) exposes list/create/read/delete only — no update op; protocol.ts unions carry no save/saved messages. The original LLD ac5 explicitly scoped in-plugin editing OUT, which is why the view is read-only today (ISSUE-01ac1e4b6a6c9c2f, approved, sized).\",\n      \"zeroDowntime\": true\n    },\n    \"openQuestions\": [],\n    \"sequenceDefinition\": {\n      \"id\": \"scratch-save-round-trip\",\n      \"messages\": [\n        {\n          \"description\": \"The document webview posts the textarea content whenever the user clicks Save or presses Ctrl/Cmd+S.\",\n          \"from\": \"doc-webview\",\n          \"kind\": \"call\",\n          \"label\": \"scratch-save {id, text}\",\n          \"to\": \"scratch-host\"\n        },\n        {\n          \"description\": \"The host route validates the fields and calls the store's new update op.\",\n          \"from\": \"scratch-host\",\n          \"kind\": \"call\",\n          \"label\": \"updateScratch(id, text)\",\n          \"to\": \"scratch-store\"\n        },\n        {\n          \"description\": \"The store re-validates the id (inside root, regular file, symlink refused), writes a temp file and atomically renames it over the destination, bumping mtime.\",\n          \"from\": \"scratch-store\",\n          \"kind\": \"return\",\n          \"label\": \"resolve / ScratchRefused|ScratchNotFound|ScratchStoreError\",\n          \"to\": \"scratch-host\"\n        },\n        {\n          \"description\": \"The host refreshes the browse table, re-pushes the chat scratch-list so the menu mtime updates, then answers the webview.\",\n          \"from\": \"scratch-host\",\n          \"kind\": \"call\",\n          \"label\": \"refreshBrowse() + sendScratchList(); scratch-saved {id, ok, error?}\",\n          \"to\": \"doc-webview\"\n        },\n        {\n          \"description\": \"The webview handler checks gen+id against the live document generation; ok=true clears dirty (hides the save button, clears the '•' title suffix), ok=false shows the error inline and keeps dirty. Stale-generation replies are ignored.\",\n          \"from\": \"doc-webview\",\n          \"kind\": \"return\",\n          \"label\": \"dirty cleared / error shown\",\n          \"note\": \"selectionchange send-to-chat over the textarea is unchanged and runs in parallel\",\n          \"to\": \"doc-webview\"\n        }\n      ],\n      \"narrative\": \"The new save interaction across the three participants (document webview, host router, store): intent, atomic validated write, saved/error reply, and the gen-guarded dirty-state update — this is the changed call flow of the story.\",\n      \"participants\": [\n        {\n          \"description\": \"The singleton 'insrc.scratchpad' document webview now hosting the editable textarea, save button and Ctrl/Cmd+S.\",\n          \"id\": \"doc-webview\",\n          \"label\": \"Scratchpad document webview\"\n        },\n        {\n          \"description\": \"createScratchHost.onMessage in vscode-plugin/src/chat/scratch-host.ts; routes scratch-save to the store and replies to the panel.\",\n          \"id\": \"scratch-host\",\n          \"label\": \"Scratch host router\"\n        },\n        {\n          \"description\": \"ScratchStore over ~/.insrc/scratches/*.md; updateScratch performs the validated atomic replace with temp-write + rename publication.\",\n          \"id\": \"scratch-store\",\n          \"label\": \"Scratch store\"\n        }\n      ]\n    },\n    \"summary\": {\n      \"audience\": \"technical\",\n      \"prose\": \"This story makes the scratchpad document view editable in-plugin. The existing 'insrc.scratchpad' webview keeps its singleton panel, CSP shell and generation/epoch guards, but its <pre> becomes a <textarea>; a save button (and Ctrl/Cmd+S) posts a new 'scratch-save' intent that the host routes to a new ScratchStore.updateScratch, which atomically rewrites the .md file with the same validation and publish safety the store already uses. A 'scratch-saved' reply drives a dirty indicator; the browse table and chat menu refresh after a save. Send-to-chat selection behavior is unchanged.\"\n    },\n    \"testStrategy\": {\n      \"acceptanceMapping\": [\n        {\n          \"criterionId\": \"ac1\",\n          \"provingTests\": [\n            \"scratch-store.test.ts (fake-scratch-fs): updateScratch happy path writes full text and replaces content; id validation refusal (outside-root, symlink, non-.md) → ScratchRefused; missing file → ScratchNotFound; write failure leaves destination unchanged and unlinks temp\",\n            \"scratch-store.test.ts: updateScratch bumps mtime so listScratches reflects the save\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac2\",\n          \"provingTests\": [\n            \"protocol.test.ts: 'scratch-save' in WEBVIEW_TO_HOST_TYPES and NOT in HOST_TO_WEBVIEW_TYPES; 'scratch-saved' in HOST_TO_WEBVIEW_TYPES and NOT in WEBVIEW_TO_HOST_TYPES; unions cover the arrays exactly (direction isolation)\",\n            \"scratch-panel.test.ts: documentBodyHtml emits <textarea id=\\\"insrc-scratchdoc\\\"> and the save button; documentBootstrap pins the scratch-save post + keydown Ctrl/Cmd+S + scratch-saved handler with gen check\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac3\",\n          \"provingTests\": [\n            \"scratch-host routing test (fake store/panels): 'scratch-save' {id,text} → store.updateScratch called with exact args → 'scratch-saved' ok:true posted to the document panel + refreshBrowse + scratch-list re-pushed; store failure → ok:false with error and log.warn; malformed (non-string id/text) dropped with warn\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac4\",\n          \"provingTests\": [\n            \"scratch-panel.test.ts behavioral: input event sets dirty (save button visible, title suffix via setTitle), 'scratch-saved' ok matching gen clears dirty, ok=false keeps dirty and shows error, stale-gen reply ignored; scratch-content sets textarea .value (not textContent/innerHTML)\",\n            \"extension-chat-wiring.test.ts regex pins: textarea element, save button, 'scratch-save'/'scratch-saved' strings present in the built sources and panel wiring\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac5\",\n          \"provingTests\": [\n            \"scratch-panel.test.ts: selectionchange latch + send-to-chat post unchanged and still present in the new bootstrap; capUtf8 behavior untouched (existing tests)\",\n            \"existing ISSUE-3183af2a tests (wrap() drop logging, reveal(true), popup icons) still pass\"\n          ]\n        }\n      ],\n      \"testFramework\": \"node:test via tsx (`tsx --test 'src/**/__tests__/*.test.ts'` in vscode-plugin/, run with the default node), with vscode-free fakes: fake-scratch-fs.ts for the store, FakePanel for panels, injected deps for the host — the established pattern in scratch-store.test.ts / scratch-panel.test.ts / extension-chat-wiring.test.ts\",\n      \"testLevels\": [\n        {\n          \"fixturesNeeded\": [\n            \"fake-scratch-fs.ts (in-memory fs double with link/writeFile/open/lstat semantics incl. EEXIST, ELOOP, ENOENT)\"\n          ],\n          \"level\": \"unit\",\n          \"purpose\": \"Prove ScratchStore.updateScratch semantics: atomic replace of content, validation errors (ScratchRefused/ScratchNotFound/ScratchStoreError), temp-file cleanup, mtime bump; and the host's scratch-save routing incl. ok/error replies and malformed-payload drops\",\n          \"subjects\": [\n            \"vscode-plugin/src/chat/__tests__/scratch-store.test.ts\",\n            \"vscode-plugin/src/chat/__tests__/fake-scratch-fs.ts\",\n            \"vscode-plugin/src/chat/__tests__/scratch-host.test.ts\"\n          ]\n        },\n        {\n          \"fixturesNeeded\": [],\n          \"level\": \"contract\",\n          \"purpose\": \"Pin the protocol contract: both new message types exist in exactly one direction each, unions/const arrays stay exhaustive, runtime string validation\",\n          \"subjects\": [\n            \"vscode-plugin/src/chat/__tests__/protocol.test.ts (direction isolation + coverage assertions)\"\n          ]\n        },\n        {\n          \"fixturesNeeded\": [\n            \"FakePanel with delivery/reject postMessage modes (existing)\"\n          ],\n          \"level\": \"integration\",\n          \"purpose\": \"Pin the document view's HTML/bootstrap source (textarea not pre, save button, scratch-save/scratch-saved wiring with generation guard, send-to-chat intact) and the extension.ts wiring of the panels factory + scratch host\",\n          \"subjects\": [\n            \"vscode-plugin/src/panels/__tests__/scratch-panel.test.ts\",\n            \"vscode-plugin/src/chat/__tests__/extension-chat-wiring.test.ts\"\n          ]\n        }\n      ]\n    },\n    \"uxDefinition\": {\n      \"body\": [\n        {\n          \"description\": \"Section header: the changed singleton scratchpad document pane (insrc.scratchpad) in its clean, dirty and save-error states.\",\n          \"size\": \"medium\",\n          \"text\": \"Scratchpad document pane (insrc.scratchpad) — editable, with save affordance\",\n          \"type\": \"TextBlock\",\n          \"weight\": \"bolder\"\n        },\n        {\n          \"description\": \"The document pane content is now an editable full-height <textarea id=\\\"insrc-scratchdoc\\\"> (was a read-only <pre> filled via textContent); content is pushed via .value only, never innerHTML, keeping the CSP nonce shell safe.\",\n          \"items\": [\n            {\n              \"columns\": [\n                {\n                  \"items\": [\n                    {\n                      \"description\": \"The editable scratchpad content as a multiline text input — the textarea replacing the read-only <pre>; unsaved edits set the dirty state.\",\n                      \"id\": \"insrc-scratchdoc\",\n                      \"isMultiline\": true,\n                      \"placeholder\": \"scratchpad markdown…\",\n                      \"type\": \"Input.Text\"\n                    }\n                  ],\n                  \"type\": \"Column\",\n                  \"width\": \"stretch\"\n                },\n                {\n                  \"items\": [\n                    {\n                      \"color\": \"accent\",\n                      \"description\": \"Icon-only Save button (title=\\\"Save\\\"), visible only while dirty; click or Ctrl/Cmd+S posts {type:\\\"scratch-save\\\", id, text: doc.value} to the host.\",\n                      \"text\": \"[💾 save]\",\n                      \"type\": \"TextBlock\"\n                    },\n                    {\n                      \"description\": \"While dirty, the panel title carries a '•' suffix so unsaved changes are visible from the tab bar.\",\n                      \"isSubtle\": true,\n                      \"text\": \"scratch.md •\",\n                      \"type\": \"TextBlock\"\n                    }\n                  ],\n                  \"type\": \"Column\",\n                  \"width\": \"auto\"\n                }\n              ],\n              \"description\": \"Clean/dirty chrome of the document pane: editable textarea, save button (shown only when dirty) and the dirty title suffix.\",\n              \"type\": \"ColumnSet\"\n            }\n          ],\n          \"type\": \"Container\"\n        },\n        {\n          \"description\": \"On save success the host replies 'scratch-saved' {id, ok:true} (after refreshBrowse + chat scratch-list re-push so the menu mtime updates) and the webview clears dirty — save button hides, '•' suffix clears. On failure it replies ok:false with error: an inline error line shows and dirty remains. A stale-generation reply is ignored.\",\n          \"items\": [\n            {\n              \"color\": \"good\",\n              \"description\": \"Save confirmed: dirty cleared (save button hidden, title suffix removed); the browse table and chat menu show the new mtime.\",\n              \"text\": \"✓ saved\",\n              \"type\": \"TextBlock\"\n            },\n            {\n              \"color\": \"attention\",\n              \"description\": \"Save failed: ok=false reply → error text shown inline, dirty state kept, retry possible via the save button.\",\n              \"text\": \"⚠ save failed: <error>\",\n              \"type\": \"TextBlock\"\n            }\n          ],\n          \"type\": \"Container\"\n        },\n        {\n          \"description\": \"Unchanged behavior preserved on the editable surface: a non-empty text selection in the textarea reveals the floating icon-only Send-to-chat button anchored at the selection; clicking posts {type:\\\"send-to-chat\\\", text} (selection captured at selectionchange, capped at 65,536 UTF-8 bytes) — the host inserts into the chat input and focuses it, never auto-sends.\",\n          \"items\": [\n            {\n              \"columns\": [\n                {\n                  \"items\": [\n                    {\n                      \"description\": \"Editable content with the selected run «verify the canary metrics» highlighted.\",\n                      \"text\": \"…deploy the release, then «verify the canary metrics» and notify…\",\n                      \"type\": \"TextBlock\",\n                      \"wrap\": true\n                    }\n                  ],\n                  \"type\": \"Column\",\n                  \"width\": \"stretch\"\n                },\n                {\n                  \"items\": [\n                    {\n                      \"color\": \"accent\",\n                      \"description\": \"Floating icon-only Send-to-chat button at the selection (title=\\\"Send to chat\\\"); hidden on collapsed/empty selection.\",\n                      \"text\": \"[↗]\",\n                      \"type\": \"TextBlock\"\n                    }\n                  ],\n                  \"type\": \"Column\",\n                  \"width\": \"auto\"\n                }\n              ],\n              \"type\": \"ColumnSet\"\n            }\n          ],\n          \"type\": \"Container\"\n        }\n      ],\n      \"narrative\": \"The changed scratchpad document view: an editable textarea filling the pane (replacing the read-only <pre>), an icon-only save button that appears only while there are unsaved edits (plus a '•' tab-title suffix), save-success and save-error states, and the preserved floating Send-to-chat button on text selection — so the editing UX and its states can be assessed.\",\n      \"type\": \"AdaptiveCard\",\n      \"version\": \"1.5\"\n    },\n    \"companions\": [\n      {\n        \"kind\": \"ux-mock\",\n        \"relPath\": \"docs/standalone/scratchpad-document-view-read-only-cannot-E2026111401ac1e4b/S001/ux-mock.html\",\n        \"title\": \"UX mock\"\n      },\n      {\n        \"kind\": \"diagram-mermaid\",\n        \"relPath\": \"docs/standalone/scratchpad-document-view-read-only-cannot-E2026111401ac1e4b/S001/sequence-diagram.html\",\n        \"title\": \"Sequence diagram\"\n      }\n    ]\n  },\n  \"citations\": [\n    {\n      \"id\": \"c1\",\n      \"kind\": \"code\",\n      \"quotedText\": \"documentBodyHtml renders <pre id=\\\"insrc-scratchdoc\\\" class=\\\"scratch-doc\\\"></pre> — the read-only surface being replaced by the textarea\",\n      \"ref\": \"vscode-plugin/src/panels/scratch-panels.ts:146-151\"\n    },\n    {\n      \"id\": \"c2\",\n      \"kind\": \"code\",\n      \"quotedText\": \"ScratchStore exposes listScratches/createScratch/readScratch/deleteScratch only; updateScratch is added with the same id validation and temp-write + publish discipline\",\n      \"ref\": \"vscode-plugin/src/chat/scratch-store.ts\"\n    },\n    {\n      \"id\": \"c3\",\n      \"kind\": \"code\",\n      \"quotedText\": \"SCRATCH_INTENT_TYPES lists the six scratch intents; the scratch-save case is added to onMessage\",\n      \"ref\": \"vscode-plugin/src/chat/scratch-host.ts\"\n    },\n    {\n      \"id\": \"c4\",\n      \"kind\": \"prior-artifact\",\n      \"quotedText\": \"ac5 scoped in-plugin editing OUT OF SCOPE (read-only document view) — the root cause of ISSUE-01ac1e4b6a6c9c2f\",\n      \"ref\": \"docs/standalone/vs-code-plugin-scratchpads-insrc-scratches-E202611134642d49a/S001/LLD.md\"\n    },\n    {\n      \"id\": \"c5\",\n      \"kind\": \"code\",\n      \"quotedText\": \"WEBVIEW_TO_HOST_TYPES / HOST_TO_WEBVIEW_TYPES const arrays — each new message goes into its own direction only\",\n      \"ref\": \"vscode-plugin/src/chat/protocol.ts:442-444\"\n    },\n    {\n      \"id\": \"c6\",\n      \"kind\": \"prior-artifact\",\n      \"quotedText\": \"ISSUE-01ac1e4b6a6c9c2f (approved, sized): fix intent = editable surface + scratch-save round-trip through an atomic store update op, dirty state, browse refresh, send-to-chat preserved\",\n      \"ref\": \"docs/standalone/scratchpad-document-view-read-only-cannot-E2026111401ac1e4b/ISSUE.md\"\n    }\n  ]\n}\n","document":"<!-- insrc:artifact LLD-01ac1e4b6a6c9c2f-s1 -->\n\n# LLD: STORY-01ac1e4b6a6c9c2f-s1 — Make the scratchpad document view editable in-plugin (ISSUE-01ac1e4b6a6c9c2f)\n\n## Summary\n\n**Epic:** `scratchpad-document-view-read-only-cannot`\n**HLD base run:** `wf-1794672418662-gm1x9s`\n**HLD effective hash:** `e3f317296671...`\n\nThis story makes the scratchpad document view editable in-plugin. The existing 'insrc.scratchpad' webview keeps its singleton panel, CSP shell and generation/epoch guards, but its <pre> becomes a <textarea>; a save button (and Ctrl/Cmd+S) posts a new 'scratch-save' intent that the host routes to a new ScratchStore.updateScratch, which atomically rewrites the .md file with the same validation and publish safety the store already uses. A 'scratch-saved' reply drives a dirty indicator; the browse table and chat menu refresh after a save. Send-to-chat selection behavior is unchanged.\n\n## Contents\n\n1. [HLD context](#1-hld-context)\n2. [Contract details](#2-contract-details)\n3. [Data model changes](#3-data-model-changes)\n4. [Diagrams](#4-diagrams)\n5. [Error paths](#5-error-paths)\n6. [Test strategy](#6-test-strategy)\n7. [Migration](#7-migration)\n8. [Alternatives considered](#8-alternatives-considered)\n9. [UX](#9-ux)\n10. [References](#10-references)\n\n## 1. HLD context\n\n**Framework:** Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\n**Rollout phase:** standalone\n\n## 2. Contract details\n\n**Surface level:** internal\n\n### 2.1 `ScratchStore.updateScratch`\n\n```typescript\nupdateScratch(id: string, text: string): Promise<void>  // vscode-plugin/src/chat/scratch-store.ts — NEW\n```\n\n**Parameters:**\n- `id: string` — scratchpad id = file basename, validated exactly like readScratch/deleteScratch (inside root, regular file, symlink refused)\n- `text: string` — full new markdown content to persist\n\n**Returns:** `Promise<void>` — resolves when the file has been atomically replaced with text; the ScratchEntry metadata (id/name/mtime/size) is unchanged in shape, mtime/size derived from the file\n\n**Errors:**\n- `ScratchRefused` when id is not a *.md filename resolving strictly inside the store root, or lstat shows not-a-regular-file / symlink\n- `ScratchNotFound` when the scratchpad file no longer exists at save time\n- `ScratchStoreError` when write/publish failure EACCES/ENOSPC/EROFS etc.\n\n**Preconditions:**\n- store root exists (created lazily as today)\n- id passes the same validation as readScratch (resolve strictly inside root, basename *.md, lstat regular file, symlink refused)\n\n**Postconditions:**\n- the destination file's content equals text\n- mtime is bumped so listScratches/browse reflect the save\n- no temp file is left behind\n- a pre-existing destination is replaced atomically (temp write + publish), never partially written\n\n### 2.2 `scratch-save intent (WebviewToHost member)`\n\n```typescript\n{ type: 'scratch-save'; id: string; text: string }  // NEW member of WebviewToHost in vscode-plugin/src/chat/protocol.ts + WEBVIEW_TO_HOST_TYPES\n```\n\n**Parameters:**\n- `id: string` — which scratchpad to save\n- `text: string` — full editable content from the textarea\n\n**Returns:** `void` — void (async fire-and-forget from the webview, like the other scratch intents)\n\n**Errors:**\n- `dropped + log.warn (same as other scratch intents)` when msg.id/msg.text not a string\n\n**Preconditions:**\n- the document webview posted it; id matches the panel's showingId at the controller level (generation/epoch guards apply)\n\n**Postconditions:**\n- host routes to store.updateScratch(id, text)\n- on success: host->webview 'scratch-saved' {id, ok:true} + refreshBrowse() + chat scratch-list re-push so the menu's mtime updates\n- on failure: 'scratch-saved' {id, ok:false, error} and the dirty state stays\n\n### 2.3 `scratch-saved reply (HostToWebview member)`\n\n```typescript\n{ type: 'scratch-saved'; id: string; ok: boolean; error?: string }  // NEW member of HostToWebview in vscode-plugin/src/chat/protocol.ts + HOST_TO_WEBVIEW_TYPES\n```\n\n**Parameters:**\n- `id: string` — which save this answers\n- `ok: boolean` — success flag\n- `error: string` _(optional)_ — failure message shown in the view when ok=false\n\n**Returns:** `void` — void\n\n**Errors:**\n- `logged via the existing wrap() drop logging (ISSUE-3183af2a)` when delivered=false or rejected post from the wrapped handle\n\n**Preconditions:**\n- the generation tag matches the live docGeneration (stale replies from a superseded page load are ignored, same rule as scratch-ready)\n\n**Postconditions:**\n- webview 'scratch-saved' handler with matching id+current generation: ok=true clears dirty (hides save button, clears title suffix), ok=false surfaces the error text in the view and keeps dirty\n\n### 2.4 `documentBodyHtml / documentBootstrap (reshaped)`\n\n```typescript\ndocumentBodyHtml(): string; documentBootstrap(gen: number): string  // vscode-plugin/src/panels/scratch-panels.ts — RESHAPED (pre → textarea, + save wiring)\n```\n\n**Parameters:**\n- `gen: number` — document generation tag embedded in the bootstrap, echoed in scratch-ready and scratch-saved\n\n**Returns:** `string` — static body HTML string (documentBodyHtml) / nonce'd bootstrap JS string (documentBootstrap)\n\n**Errors:**\n- `logged via log.warn, openDocument returns the handle (existing pattern)` when setHtml throws or panel disposed\n\n**Preconditions:**\n- same CSP nonce shell (shellHtml) and ready handshake as today\n\n**Postconditions:**\n- the document body contains <textarea id=\"insrc-scratchdoc\"> (editable, CSP-safe: content assigned via .value, never innerHTML) plus the existing floating send-to-chat button and a hidden save button\n- bootstrap wires: scratch-content → doc.value; input → dirty=true + show save button + set panel title suffix '•'; keydown Ctrl/Cmd+S and save-button click → post 'scratch-save' {id, text: doc.value}; message 'scratch-saved' matching gen+id → clear dirty or show error; selectionchange send-to-chat logic unchanged and working over textarea selections\n\n### 2.5 `scratch-host 'scratch-save' route`\n\n```typescript\ncase 'scratch-save' in createScratchHost.onMessage  // vscode-plugin/src/chat/scratch-host.ts — NEW route\n```\n\n**Parameters:**\n- `msg: WebviewToHost` — the intent\n\n**Returns:** `void` — void\n\n**Errors:**\n- `'scratch-saved' ok=false + log.warn + browse refresh still runs` when store update failed\n\n**Preconditions:**\n- SCRATCH_INTENT_TYPES includes 'scratch-save'\n\n**Postconditions:**\n- await store.updateScratch(id, text); panels.refreshBrowse(); sendScratchList() so the chat menu mtime refreshes; reply 'scratch-saved' to the document panel with ok/error\n\n## 3. Data model changes\n\n### 3.1 `WebviewToHost / HostToWebview message unions` — field-add\n\nWebviewToHost gains { type: 'scratch-save'; id: string; text: string } and HostToWebview gains { type: 'scratch-saved'; id: string; ok: boolean; error?: string }; both added to their OWN direction's const array (WEBVIEW_TO_HOST_TYPES / HOST_TO_WEBVIEW_TYPES) with direction-isolation assertions in the protocol test. Payload field names are part of the contract; ids/texts must be strings at runtime.\n\n**Call sites:**\n- `vscode-plugin/src/chat/protocol.ts`\n- `vscode-plugin/src/chat/scratch-host.ts`\n- `vscode-plugin/src/panels/scratch-panels.ts`\n- `vscode-plugin/src/chat/__tests__/protocol.test.ts`\n- `vscode-plugin/src/chat/__tests__/scratch-store.test.ts`\n- `vscode-plugin/src/chat/__tests__/extension-chat-wiring.test.ts`\n\n### 3.2 `ScratchStore interface` — field-add\n\nScratchStore gains updateScratch(id, text): temp file (pid+random suffix, never *.md) written with the new content, published over the destination via rename (atomic replace) after re-validating id (resolve strictly inside root, lstat regular file, symlink refused — O_NOFOLLOW discipline); temp file unlinked on failure. ScratchEntry shape unchanged.\n\n**Call sites:**\n- `vscode-plugin/src/chat/scratch-store.ts`\n- `vscode-plugin/src/chat/__tests__/scratch-store.test.ts`\n- `vscode-plugin/src/chat/__tests__/fake-scratch-fs.ts`\n\n### 3.3 `insrc.scratchpad document view (documentBodyHtml/documentBootstrap)` — field-modify\n\nDocument view DOM: <pre class=\"scratch-doc\"> becomes <textarea id=\"insrc-scratchdoc\" class=\"scratch-doc\">; content push sets .value; adds hidden save button, dirty tracking, Ctrl/Cmd+S, title suffix, 'scratch-saved' handling with generation guard. Generation/epoch/ready-replay machinery and wrap() delivery logging unchanged.\n\n**Call sites:**\n- `vscode-plugin/src/panels/scratch-panels.ts`\n- `vscode-plugin/src/panels/__tests__/scratch-panel.test.ts`\n\n## 4. Diagrams\n\n- [Sequence diagram](docs/standalone/scratchpad-document-view-read-only-cannot-E2026111401ac1e4b/S001/sequence-diagram.html)\n\n## 5. Error paths\n\n**Error cases**\n\n- **scratch-save arrives with a tampered/outside-root/symlink id** (recoverable)\n  - Detection: At save time the id fails validation: not a *.md basename resolving strictly inside the store root, lstat shows not-a-regular-file, or the path is a symlink (O_NOFOLLOW discipline)\n  - Response: Reject with ScratchRefused → host replies 'scratch-saved' {ok:false, error} + log.warn\n  - User impact: The save is refused and the dirty state stays; nothing is written outside the store root\n- **The scratchpad file no longer exists at save time** (recoverable)\n  - Detection: ENOENT when the destination is re-validated at save time (deleted between open and save)\n  - Response: Reject with ScratchNotFound → 'scratch-saved' ok:false + log.warn\n  - User impact: Error surfaces inline in the document view; dirty remains\n- **The atomic write/publish fails partway** (recoverable)\n  - Detection: EACCES/ENOSPC/EROFS etc. from the temp write or the publish rename; temp file unlinked, destination untouched\n  - Response: Reject with ScratchStoreError → 'scratch-saved' ok:false + log.warn\n  - User impact: No partial content is ever visible on disk; the user can retry\n- **Malformed scratch-save payload from the webview** (recoverable)\n  - Detection: Non-string msg.id or msg.text in the router's scratch-save case\n  - Response: Dropped with log.warn, no reply (same as other malformed scratch intents)\n  - User impact: Nothing happens; the drop is visible in the extension log\n\n**Edge cases**\n\n| Input | Expected |\n| :--- | :--- |\n| 'scratch-saved' arriving with a gen older than the live docGeneration | Stale-generation 'scratch-saved' replies are ignored by the webview handler (same rule as scratch-ready) |\n| store.updateScratch rejects during save (file deleted concurrently → ScratchNotFound; EACCES/ENOSPC → ScratchStoreError) | Dirty remains, error shown inline, log.warn recorded, browse/list still refresh |\n| postMessage delivery fails or the wrapped handle rejects the 'scratch-saved' reply | Logged via the existing wrap() drop logging (ISSUE-3183af2a); dirty remains until a reply arrives |\n\n**Invariants to preserve**\n\n- CSP nonce shell (shellHtml) and the scratch-ready generation handshake stay exactly as today; content is assigned via .value, never innerHTML [[c1]]\n- Singleton panel, docGeneration/epoch guards, pendingContent replay and wrap() postMessage drop logging (ISSUE-3183af2a) are untouched [[c1]]\n- Store security invariants: id resolves strictly inside ~/.insrc/scratches root, lstat regular-file check, symlink refusal, O_NOFOLLOW fd reads, temp-write + atomic publish, no partial writes [[c2]]\n- Selection-based send-to-chat (selectionchange latch + 65,536 UTF-8 byte capUtf8) works unchanged over textarea selections [[c3]]\n\n## 6. Test strategy\n\n**Test framework:** `node:test via tsx (`tsx --test 'src/**/__tests__/*.test.ts'` in vscode-plugin/, run with the default node), with vscode-free fakes: fake-scratch-fs.ts for the store, FakePanel for panels, injected deps for the host — the established pattern in scratch-store.test.ts / scratch-panel.test.ts / extension-chat-wiring.test.ts`\n\n**Test levels**\n\n- **unit** — Prove ScratchStore.updateScratch semantics: atomic replace of content, validation errors (ScratchRefused/ScratchNotFound/ScratchStoreError), temp-file cleanup, mtime bump; and the host's scratch-save routing incl. ok/error replies and malformed-payload drops\n  - Subjects: `vscode-plugin/src/chat/__tests__/scratch-store.test.ts`, `vscode-plugin/src/chat/__tests__/fake-scratch-fs.ts`, `vscode-plugin/src/chat/__tests__/scratch-host.test.ts`\n  - Fixtures: `fake-scratch-fs.ts (in-memory fs double with link/writeFile/open/lstat semantics incl. EEXIST, ELOOP, ENOENT)`\n- **contract** — Pin the protocol contract: both new message types exist in exactly one direction each, unions/const arrays stay exhaustive, runtime string validation\n  - Subjects: `vscode-plugin/src/chat/__tests__/protocol.test.ts (direction isolation + coverage assertions)`\n- **integration** — Pin the document view's HTML/bootstrap source (textarea not pre, save button, scratch-save/scratch-saved wiring with generation guard, send-to-chat intact) and the extension.ts wiring of the panels factory + scratch host\n  - Subjects: `vscode-plugin/src/panels/__tests__/scratch-panel.test.ts`, `vscode-plugin/src/chat/__tests__/extension-chat-wiring.test.ts`\n  - Fixtures: `FakePanel with delivery/reject postMessage modes (existing)`\n\n**Acceptance mapping**\n\n| Criterion | Proving tests |\n| :--- | :--- |\n| `ac1` | `scratch-store.test.ts (fake-scratch-fs): updateScratch happy path writes full text and replaces content; id validation refusal (outside-root, symlink, non-.md) → ScratchRefused; missing file → ScratchNotFound; write failure leaves destination unchanged and unlinks temp`, `scratch-store.test.ts: updateScratch bumps mtime so listScratches reflects the save` |\n| `ac2` | `protocol.test.ts: 'scratch-save' in WEBVIEW_TO_HOST_TYPES and NOT in HOST_TO_WEBVIEW_TYPES; 'scratch-saved' in HOST_TO_WEBVIEW_TYPES and NOT in WEBVIEW_TO_HOST_TYPES; unions cover the arrays exactly (direction isolation)`, `scratch-panel.test.ts: documentBodyHtml emits <textarea id=\"insrc-scratchdoc\"> and the save button; documentBootstrap pins the scratch-save post + keydown Ctrl/Cmd+S + scratch-saved handler with gen check` |\n| `ac3` | `scratch-host routing test (fake store/panels): 'scratch-save' {id,text} → store.updateScratch called with exact args → 'scratch-saved' ok:true posted to the document panel + refreshBrowse + scratch-list re-pushed; store failure → ok:false with error and log.warn; malformed (non-string id/text) dropped with warn` |\n| `ac4` | `scratch-panel.test.ts behavioral: input event sets dirty (save button visible, title suffix via setTitle), 'scratch-saved' ok matching gen clears dirty, ok=false keeps dirty and shows error, stale-gen reply ignored; scratch-content sets textarea .value (not textContent/innerHTML)`, `extension-chat-wiring.test.ts regex pins: textarea element, save button, 'scratch-save'/'scratch-saved' strings present in the built sources and panel wiring` |\n| `ac5` | `scratch-panel.test.ts: selectionchange latch + send-to-chat post unchanged and still present in the new bootstrap; capUtf8 behavior untouched (existing tests)`, `existing ISSUE-3183af2a tests (wrap() drop logging, reveal(true), popup icons) still pass` |\n\n## 7. Migration\n\n**State before:** Per the s1 analyze bundle: the document view (vscode-plugin/src/panels/scratch-panels.ts documentBodyHtml:146-151 / documentBootstrap:164-205) renders a read-only <pre id=\"insrc-scratchdoc\"> filled via textContent only, with send-to-chat over selectionchange; the host router (scratch-host.ts, six intents in SCRATCH_INTENT_TYPES:19-26) has no save intent; ScratchStore (scratch-store.ts) exposes list/create/read/delete only — no update op; protocol.ts unions carry no save/saved messages. The original LLD ac5 explicitly scoped in-plugin editing OUT, which is why the view is read-only today (ISSUE-01ac1e4b6a6c9c2f, approved, sized).\n\n**State after:** The scratchpad document view is editable in-plugin: a CSP-safe <textarea> holds the content, a save button (shown only while dirty, plus a '•' title suffix) and Ctrl/Cmd+S post a new 'scratch-save' webview->host intent; the host routes it to a new ScratchStore.updateScratch that atomically rewrites the .md file under the store's existing strict validation (inside-root, regular-file, symlink-refused, O_NOFOLLOW, temp-write + rename publication), then replies 'scratch-saved' {id, ok, error?} which clears the dirty state or surfaces the error; browse table and chat menu refresh after every save; send-to-chat selection, singleton panel, generation/epoch guards and wrap() drop logging are unchanged.\n\n**Zero downtime:** yes — **Data rewrite:** no\n\n**Steps**\n\n1. Add updateScratch(id, text) to the ScratchStore interface and nodeScratchFs implementation: re-validate id exactly as readScratch/deleteScratch (resolve strictly inside the store root, basename *.md, lstat regular file, symlink refused, O_NOFOLLOW discipline), write the new content to a temp file (pid+random suffix, never *.md), publish over the destination with an atomic rename, unlink the temp on any failure; reject with ScratchRefused / ScratchNotFound / ScratchStoreError. — ↩ rollbackable\n2. Extend protocol.ts: add { type: 'scratch-save'; id: string; text: string } to WebviewToHost + WEBVIEW_TO_HOST_TYPES, and { type: 'scratch-saved'; id: string; ok: boolean; error?: string } to HostToWebview + HOST_TO_WEBVIEW_TYPES (each in its OWN direction only); update the direction-isolation/coverage assertions in the protocol test. — ↩ rollbackable\n3. Reshape the document view in scratch-panels.ts: <pre id=\"insrc-scratchdoc\"> becomes <textarea id=\"insrc-scratchdoc\" class=\"scratch-doc\">; scratch-content sets doc.value (never innerHTML, CSP-safe); add hidden icon save button (visible when dirty), input→dirty + panel title '•' suffix, keydown Ctrl/Cmd+S + button click → post 'scratch-save' {id, text: doc.value}, message 'scratch-saved' matching gen+id → clear dirty or show error; selectionchange send-to-chat logic unchanged; generation/epoch/ready-replay machinery and wrap() drop logging untouched. — ↩ rollbackable\n4. Add the 'scratch-save' case to createScratchHost.onMessage (and to SCRATCH_INTENT_TYPES): validate string id/text (warn+drop otherwise), await store.updateScratch, then reply 'scratch-saved' {id, ok, error?} to the document panel, run refreshBrowse() + sendScratchList() so the menu mtime refreshes; on store failure reply ok:false with log.warn, still refresh. — ↩ rollbackable\n5. Tests: scratch-store.test.ts (fake-scratch-fs) for updateScratch happy path/atomicity/refusals/temp cleanup/mtime; protocol direction-isolation; scratch-panel source+behavior pins (textarea, .value, save wiring, gen-guarded scratch-saved, dirty); scratch-host route tests (ok/ok=false/malformed/refresh calls); extension-chat-wiring regex pins. No data or state migration needed. — ↩ rollbackable\n\n**Backward compat:** Both new messages are pure additions to their direction's union, so existing webviews/hosts that never send 'scratch-save' or never receive 'scratch-saved' are unaffected (old document pages never post scratch-save; unknown-type guards already drop unknown messages with a log.warn). The ScratchStore interface gains a method — the only implementors are the nodeScratchFs-backed store and the test fake, both updated in the same change. ScratchEntry shape, the ~/.insrc/scratches/*.md file layout, and all existing intents/replies are unchanged; existing scratchpad files need no rewrite and remain editable as plain files outside the plugin (the original LLD ac5 path stays valid).\n\n## 8. Alternatives considered\n\n### 8.1 a1: Editable textarea in the existing scratchpad webview + atomic updateScratch — **CHOSEN**\n\nMake the existing 'insrc.scratchpad' document view's <pre> an editable <textarea>, add scratch-save/scratch-saved protocol messages and ScratchStore.updateScratch with temp-write + atomic publish.\n\nKeep the existing singleton 'insrc.scratchpad' document webview; in documentBodyHtml replace the <pre id=\"insrc-scratchdoc\"> with a <textarea id=\"insrc-scratchdoc\"> (same id, CSP-safe: value set via .value, never innerHTML). Content push 'scratch-content' sets textarea.value. Bootstrap adds: input listener marking dirty + showing a save button (and panel title suffix), Ctrl/Cmd+S and the save button posting new webview->host 'scratch-save' {id, text: textarea.value}; host->webview 'scratch-saved' {id, ok, error?} clears dirty on ok / surfaces error. Host routes 'scratch-save' in scratch-host.ts to new store.updateScratch(id, text) which validates id (inside root, regular file, no symlink), writes temp file, publishes atomically over the destination. Selection-based send-to-chat keeps working over textarea selections. Minimal new surface: 1 webview->host type, 1 host->webview type, 1 store op, dirty flag in the controller.\n\n### 8.2 a2: contentEditable div in the document view\n\nSame save round-trip as a1 but the editable element is a contentEditable div fed via textContent/innerText.\n\ncontentEditable div instead of textarea: documentBodyHtml emits <div id=\"insrc-scratchdoc\" contenteditable=\"true\">; 'scratch-content' sets textContent as today; save posts 'scratch-save' {id, text: div.innerText}; same protocol additions and store op as a1.\n\n**Rejected because:** contentEditable + innerText round-trips add rich-text paste and DOM-mutation edge cases into a CSP-strict webview; weaker testability in source-scan tests; same store-write need as a1 without its clean .value contract.\n\n### 8.3 a3: Open the .md file in a native VS Code editor instead of the webview\n\nReplace the custom document webview with VS Code's native text editor on the scratchpad file.\n\nDo not edit in the webview at all: 'scratch-open' opens the underlying ~/.insrc/scratches/<id>.md file in a real VS Code text editor (workspace.openTextDocument + showTextDocument) instead of the custom webview; editing/saving is native. The webview document view is kept only for send-to-chat, or dropped.\n\n**Rejected because:** Throws away the singleton panel machinery the earlier stories built and ISSUE-3183af2a hardened; cost M; changes UX away from the scratchpad view the ISSUE reports as read-only; contradicts the approved fix intent (editable surface + save through the store).\n\n### 8.4 a4: Read-only webview + 'Edit' button opening the native editor\n\nKeep the webview as-is; add an 'Edit' icon button that opens the native editor on the file.\n\nKeep the webview as-is; add an edit affordance that hands off to a native text editor on the .md file; the webview watches/re-reads on reveal. Save happens natively; browse refreshes on panel reveal.\n\n**Rejected because:** Fails the ISSUE-01ac1e4b6a6c9c2f fix intent — the scratchpad view itself remains read-only, which is exactly the reported complaint; this is the status quo ac5 already scoped out.\n\n## 9. UX\n\n- [UX mock](docs/standalone/scratchpad-document-view-read-only-cannot-E2026111401ac1e4b/S001/ux-mock.html)\n\n## 10. References\n\n- **[[c1]]** `code` `vscode-plugin/src/panels/scratch-panels.ts:146-151` — \"documentBodyHtml renders <pre id=\"insrc-scratchdoc\" class=\"scratch-doc\"></pre> — the read-only surface being replaced by the textarea\"\n- **[[c2]]** `code` `vscode-plugin/src/chat/scratch-store.ts` — \"ScratchStore exposes listScratches/createScratch/readScratch/deleteScratch only; updateScratch is added with the same id validation and temp-write + publish discipline\"\n- **[[c3]]** `code` `vscode-plugin/src/chat/scratch-host.ts` — \"SCRATCH_INTENT_TYPES lists the six scratch intents; the scratch-save case is added to onMessage\"\n- **[[c4]]** `prior-artifact` `docs/standalone/vs-code-plugin-scratchpads-insrc-scratches-E202611134642d49a/S001/LLD.md` — \"ac5 scoped in-plugin editing OUT OF SCOPE (read-only document view) — the root cause of ISSUE-01ac1e4b6a6c9c2f\"\n- **[[c5]]** `code` `vscode-plugin/src/chat/protocol.ts:442-444` — \"WEBVIEW_TO_HOST_TYPES / HOST_TO_WEBVIEW_TYPES const arrays — each new message goes into its own direction only\"\n- **[[c6]]** `prior-artifact` `docs/standalone/scratchpad-document-view-read-only-cannot-E2026111401ac1e4b/ISSUE.md` — \"ISSUE-01ac1e4b6a6c9c2f (approved, sized): fix intent = editable surface + scratch-save round-trip through an atomic store update op, dirty state, browse refresh, send-to-chat preserved\"\n"},"capturedAt":"2026-11-14T16:20:00.885Z"},"inventory":{"units":[{"id":"/body/adherence","selector":"/body/adherence","title":"adherence","kind":"visual"},{"id":"/body/alternativesConsidered","selector":"/body/alternativesConsidered","title":"alternativesConsidered","kind":"section"},{"id":"/body/chosenAlternative","selector":"/body/chosenAlternative","title":"chosenAlternative","kind":"section"},{"id":"/body/contractDetails","selector":"/body/contractDetails","title":"contractDetails","kind":"section"},{"id":"/body/dataModelChanges","selector":"/body/dataModelChanges","title":"dataModelChanges","kind":"section"},{"id":"/body/errorPaths","selector":"/body/errorPaths","title":"errorPaths","kind":"section"},{"id":"/body/hldContextSlice","selector":"/body/hldContextSlice","title":"hldContextSlice","kind":"section"},{"id":"/body/interactionWithShared","selector":"/body/interactionWithShared","title":"interactionWithShared","kind":"section"},{"id":"/body/migration","selector":"/body/migration","title":"migration","kind":"section"},{"id":"/body/openQuestions","selector":"/body/openQuestions","title":"openQuestions","kind":"section"},{"id":"/body/sequenceDefinition","selector":"/body/sequenceDefinition","title":"sequenceDefinition","kind":"visual"},{"id":"/body/summary","selector":"/body/summary","title":"summary","kind":"section"},{"id":"/body/testStrategy","selector":"/body/testStrategy","title":"testStrategy","kind":"section"},{"id":"/body/uxDefinition","selector":"/body/uxDefinition","title":"uxDefinition","kind":"visual"},{"id":"/body/companions","selector":"/body/companions","title":"companions","kind":"visual"},{"id":"/body/alternativesConsidered/0","selector":"/body/alternativesConsidered/0","title":"a1","kind":"requirement"},{"id":"/body/alternativesConsidered/1","selector":"/body/alternativesConsidered/1","title":"a2","kind":"requirement"},{"id":"/body/alternativesConsidered/2","selector":"/body/alternativesConsidered/2","title":"a3","kind":"requirement"},{"id":"/body/alternativesConsidered/3","selector":"/body/alternativesConsidered/3","title":"a4","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/0","selector":"/body/sequenceDefinition/participants/0","title":"doc-webview","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/1","selector":"/body/sequenceDefinition/participants/1","title":"scratch-host","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/2","selector":"/body/sequenceDefinition/participants/2","title":"scratch-store","kind":"requirement"},{"id":"/body/uxDefinition/body/1/items/0/columns/0/items/0","selector":"/body/uxDefinition/body/1/items/0/columns/0/items/0","title":"insrc-scratchdoc","kind":"requirement"},{"id":"/citations/0","selector":"/citations/0","title":"Citation 1","kind":"citation"},{"id":"/citations/1","selector":"/citations/1","title":"Citation 2","kind":"citation"},{"id":"/citations/2","selector":"/citations/2","title":"Citation 3","kind":"citation"},{"id":"/citations/3","selector":"/citations/3","title":"Citation 4","kind":"citation"},{"id":"/citations/4","selector":"/citations/4","title":"Citation 5","kind":"citation"},{"id":"/citations/5","selector":"/citations/5","title":"Citation 6","kind":"citation"},{"id":"document:line:26","selector":"document:line:26","title":"1. HLD context","kind":"section"},{"id":"document:line:179","selector":"document:line:179","title":"4. Diagrams","kind":"section"},{"id":"document:line:294","selector":"document:line:294","title":"9. UX","kind":"section"}]},"completedChunks":[{"chunkId":"store-write","status":"changes_requested","summary":"The LLD traces the store update to the issue and specifies replacement, validation, metadata refresh, cleanup, and failure tests. However, the proposed temp-file creation does not specify exclusive/no-follow creation, so the stated filesystem safety is not established against a pre-existing temp-path symlink; the named fake also does not currently model rename or exclusive creation.","findings":[{"id":"store-temp-safety","severity":"MED","location":"/body/dataModelChanges, ScratchStore interface update (LLD.md §3.2)","message":"The update path writes to a predictable `<root>/.tmp-<pid>-<random>` path, but the contract does not require exclusive creation or no-follow behavior. The existing node adapter uses `writeFile(path, data)` without exclusive flags, which follows a pre-existing symlink; if that temp name is occupied by a symlink, the save could write outside the scratch root before publication fails or proceeds. The safety claim therefore needs an exclusive temp-file contract (and corresponding production adapter and test fake coverage).","evidenceReferences":["LLD.md §3.2 and §7 step 1: temp file is specified as pid+random suffix and written, with no exclusive/no-follow creation requirement.","vscode-plugin/src/chat/scratch-store.ts: ScratchFs.writeFile(path, data) and nodeScratchFs.writeFile delegates to writeFile(p, data) without exclusive flags.","vscode-plugin/src/chat/__tests__/fake-scratch-fs.ts: writeFile directly puts bytes at the path and models no symlink-following or exclusive-create semantics.","ISSUE.md, Fix intent: requires an atomic and safely rewritten file preserving store invariants."]}],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/body/errorPaths","/body/migration","/body/testStrategy","/Users/subhagho/work/projects/insors/insrc/docs/standalone/scratchpad-document-view-read-only-cannot-E2026111401ac1e4b/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/docs/standalone/scratchpad-document-view-read-only-cannot-E2026111401ac1e4b/ISSUE.md","vscode-plugin/src/chat/scratch-store.ts","vscode-plugin/src/chat/__tests__/fake-scratch-fs.ts","vscode-plugin/src/chat/__tests__/scratch-store.test.ts","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/review-lld-01ac1e4b6a6c9c2f-s1.json"],"limitations":[],"advice":[]},{"chunkId":"protocol-host","status":"changes_requested","summary":"The LLD aligns the save intent with the existing scratch router and specifies runtime string checks, direction-specific protocol registration, failure replies, and browse/chat-list refresh. One contract inconsistency blocks implementation: the reply is required to be generation-guarded, but neither the save intent nor the reply carries a generation, and the existing ScratchPanels API does not expose a generation-correlated reply operation.","findings":[{"id":"save-reply-generation-contract","severity":"MED","location":"/body/contractDetails, §2.3 scratch-saved reply and §2.5 scratch-save route","message":"The reply contract requires stale replies to be ignored by matching a generation tag, but the declared scratch-saved shape contains only id, ok, and optional error; the scratch-save intent likewise carries only id and text. The current controller tracks docGeneration internally and routes incoming scratch-ready messages using their gen, but ScratchPanels exposes no operation for posting a save result to the currently displayed document generation. As written, implementers cannot satisfy both the reply shape and the generation-guard requirement. Define where the generation is captured/carried and how the host targets the live panel, or revise the stale-reply guarantee and contract consistently.","evidenceReferences":["LLD.md §2.2 declares scratch-save as { type, id, text } with no generation field.","LLD.md §2.3 declares scratch-saved as { type, id, ok, error? }, then requires matching id+current generation and states the generation tag is echoed in scratch-saved.","LLD.md §2.5 routes the reply to the document panel, but the existing ScratchPanels interface has no save-reply method.","vscode-plugin/src/panels/scratch-panels.ts: openDocument captures docGeneration internally; its webview callback validates gen for scratch-ready, while ScratchPanels only exposes openDocument, refreshBrowse, closeDocumentIfShowing, invalidateId, showingId, and dispose.","vscode-plugin/src/chat/scratch-host.ts: ScratchHostDeps receives ScratchPanels and the current router handles scratch intents; it has no direct document-generation value."]}],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/body/errorPaths","/body/migration","/body/testStrategy","/Users/subhagho/work/projects/insors/insrc/docs/standalone/scratchpad-document-view-read-only-cannot-E2026111401ac1e4b/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/docs/standalone/scratchpad-document-view-read-only-cannot-E2026111401ac1e4b/ISSUE.md","vscode-plugin/src/chat/protocol.ts","vscode-plugin/src/chat/scratch-host.ts","vscode-plugin/src/panels/scratch-panels.ts","vscode-plugin/src/panels/__tests__/scratch-panel.test.ts","vscode-plugin/src/chat/__tests__/protocol.test.ts","vscode-plugin/src/chat/__tests__/extension-chat-wiring.test.ts","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/review-lld-01ac1e4b6a6c9c2f-s1.json"],"limitations":[],"advice":[]},{"chunkId":"document-editor","status":"incomplete","summary":"The LLD traces the editable view, save affordances, error feedback, and send-to-chat behavior to the originating issue, and the UX mock source describes clean, dirty, saved, and failed states. The proposed send-to-chat behavior is not compatible with the textarea selection API as currently specified, and rendered UX verification was unavailable. Prior checkpoint feedback also identifies an unresolved generation-correlation gap in the save reply contract.","findings":[{"id":"textarea-selection-api","severity":"MED","location":"/body/contractDetails §2.4 and §3.3; /body/testStrategy ac5","message":"The design changes the selected content surface from a <pre> to a <textarea> but says to keep the existing selectionchange logic unchanged. That logic reads window.getSelection().toString(); selections inside a textarea are exposed through the textarea’s selectionStart/selectionEnd and are not returned as a DOM Range selection. Consequently, the floating Send-to-chat action may no longer capture selected textarea text, contradicting the issue’s requirement to preserve selection-based sending. Specify textarea-selection handling and test the actual textarea selection path.","evidenceReferences":["LLD.md §2.4 and §3.3: the content surface becomes a textarea while selectionchange send-to-chat logic is to remain unchanged.","vscode-plugin/src/panels/scratch-panels.ts: documentBootstrap reads window.getSelection().toString() in its selectionchange handler.","vscode-plugin/src/panels/__tests__/scratch-panel.test.ts: existing selection test supplies window.getSelection() with a synthetic selection string and uses a pre stub, so it does not exercise textarea selectionStart/selectionEnd.","ISSUE.md Fix intent: explicitly requires selection-based floating Send-to-chat behavior to keep working on the editable surface."]}],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/body/errorPaths","/body/migration","/body/testStrategy","/body/uxDefinition","/body/uxDefinition/body/1/items/0/columns/0/items/0","document:line:294","/Users/subhagho/work/projects/insors/insrc/docs/standalone/scratchpad-document-view-read-only-cannot-E2026111401ac1e4b/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/docs/standalone/scratchpad-document-view-read-only-cannot-E2026111401ac1e4b/ISSUE.md","docs/standalone/scratchpad-document-view-read-only-cannot-E2026111401ac1e4b/S001/ux-mock.html (source inspected; rendered appearance not verified)","vscode-plugin/src/panels/scratch-panels.ts","vscode-plugin/src/panels/__tests__/scratch-panel.test.ts","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/review-lld-01ac1e4b6a6c9c2f-s1.json"],"limitations":["Could not inspect the UX mock’s actual rendering: the computer/browser host was unavailable. The HTML source was inspected, but it does not establish visual layout/rendering.","The checkpoint records an unresolved MED finding, save-reply-generation-contract, that the scratch-save/reply shapes omit generation correlation even though the LLD requires stale-generation replies to be ignored; this assignment did not re-review or verify a resolution to that issue."],"advice":[]},{"chunkId":"sequence-and-alternatives","status":"incomplete","summary":"The selected alternative directly addresses the issue’s in-plugin editing request and preserves the existing scratchpad view and store boundary. The sequence captures the main save round-trip, but the design’s claim that send-to-chat selection works unchanged over a textarea conflicts with the current implementation. The diagram’s rendered appearance could not be verified because the browser host was unavailable.","findings":[{"id":"sequence-textarea-selection","severity":"MED","location":"/body/alternativesConsidered/0, pros; /body/sequenceDefinition, final message note","message":"The chosen alternative claims the existing selection code works over textarea selections and the sequence says that path runs unchanged. The current document bootstrap reads window.getSelection(), but textarea selections are exposed through selectionStart/selectionEnd rather than a DOM Range selection. This makes the diagram and alternative rationale inconsistent with the implemented selection API and the issue’s preservation requirement. Specify textarea selection handling and update the sequence and tests accordingly.","evidenceReferences":["LLD.md §2.4 and §3.3 require the selectionchange logic to remain unchanged after replacing the <pre> with a <textarea>.","LLD.md §8 alternative a1 says the existing send-to-chat selection code works on textarea selections; sequenceDefinition notes it runs in parallel unchanged.","vscode-plugin/src/panels/scratch-panels.ts: documentBootstrap obtains selected text with window.getSelection().toString().","ISSUE.md fix intent requires selection-based send-to-chat to keep working on the editable surface."]}],"inspectedReferences":["/body/adherence","/body/alternativesConsidered","/body/chosenAlternative","/body/hldContextSlice","/body/interactionWithShared","/body/sequenceDefinition","/body/sequenceDefinition/participants/0","/body/sequenceDefinition/participants/1","/body/sequenceDefinition/participants/2","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/alternativesConsidered/2","/body/alternativesConsidered/3","document:line:179","/Users/subhagho/work/projects/insors/insrc/docs/standalone/scratchpad-document-view-read-only-cannot-E2026111401ac1e4b/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/docs/standalone/scratchpad-document-view-read-only-cannot-E2026111401ac1e4b/ISSUE.md","docs/standalone/scratchpad-document-view-read-only-cannot-E2026111401ac1e4b/S001/sequence-diagram.html (source inspected; rendering not verified)","vscode-plugin/src/panels/scratch-panels.ts","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/review-lld-01ac1e4b6a6c9c2f-s1.json"],"limitation