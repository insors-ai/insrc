77441	{"artifactId":"LLD-1c09e09cd985026b-s1","entry":{"id":"31156db225deec92346dfae6aa1b83227ef189a1f7d0de81bc5057cc76430fb9","targetHeadHash":"01dda002a455b10da5d55291f1992cee0047cb5a65c3ed08cec71129e3359684","actor":{"id":"agent:design-review-daemon","kind":"agent","properties":{"party":"daemon"}},"timestamp":"2026-11-11T14:45:14.685Z","operation":"review","revision":{"number":1,"contentHash":"28f4d0d62e95333260111033f36ead85cee76d6aba920d76782093f4a5c4b05d"},"outcome":{"result":"block","summary":"Design review lld-1c09e09c-s1-r1 attempt 1","data":{"kind":"design-chunk-review","reviewId":"lld-1c09e09c-s1-r1","project":"/home/subho/work/dev/insors/insrc","artifactId":"LLD-1c09e09cd985026b-s1","subject":{"project":"/home/subho/work/dev/insors/insrc","artifactId":"LLD-1c09e09cd985026b-s1","kind":"LLD","canonicalPath":"/home/subho/work/dev/insors/insrc/.insrc/artifacts/LLD-1c09e09cd985026b-s1.json","documentPath":"/home/subho/work/dev/insors/insrc/docs/standalone/plan-builder-runs-out-attempts-before-E202611111c09e09c/S001/LLD.md","reviewer":"daemon","workflow":{"kind":"issue","rootArtifactId":"ISSUE-1c09e09cd985026b","requiredReferences":[{"role":"originating_issue","artifactId":"ISSUE-1c09e09cd985026b","path":"/home/subho/work/dev/insors/insrc/docs/standalone/plan-builder-runs-out-attempts-before-E202611111c09e09c/ISSUE.md"}],"availableReferences":[],"notApplicableRoles":["PLAN","TASKS","BUILD","CR","DEF","HLD","sibling_stories"]}},"reviewer":"daemon","applicableAttempt":1,"status":"changes_requested","binding":{"sourceRevision":{"number":1,"contentHash":"28f4d0d62e95333260111033f36ead85cee76d6aba920d76782093f4a5c4b05d"},"reviewedContentIdentity":"0ced706f0982da825514eb8495bba8db81b4af0e34103bd61b585cd19a19cdf4","documentDigest":"dda490f7b26733ef69f1fb95d8402720200d022a1338950c440a13791abcb17c","workflowDigest":"8001b6d8014de9423e517f43e1d5013eabc2526e4484fb5fb85a62a9c33f3404","author":"controller"},"preservationDigest":"c7866be81873eaf8d33ef6ee2372f05424b7c2ef39c4550fabc41ad5106abeaf","schemaVersion":1,"submitted":{"artifactPath":"/home/subho/work/dev/insors/insrc/docs/standalone/plan-builder-runs-out-attempts-before-E202611111c09e09c/S001/LLD.md","attempt":1},"attempts":[{"number":1,"status":"changes_requested","preparationKind":"planning","baseline":{"subjectFingerprints":{"canonical":"77dca5e8a247cdca15862522a98b16c0060e9dd0e78c01170773713494801e97","document":"dda490f7b26733ef69f1fb95d8402720200d022a1338950c440a13791abcb17c"},"contentIdentity":"0ced706f0982da825514eb8495bba8db81b4af0e34103bd61b585cd19a19cdf4","reviewedContent":{"canonical":"{\n  \"meta\": {\n    \"workflow\": \"design.story\",\n    \"runId\": \"wf-1794407861492-hrj3mb\",\n    \"repoPath\": \"/home/subho/work/dev/insors/insrc\",\n    \"createdAt\": \"2026-11-11T14:39:52.874Z\",\n    \"epicCreatedAt\": \"2026-11-11T14:35:39.306Z\",\n    \"attribution\": {\n      \"outputs\": [\n        {\n          \"role\": \"(client)\",\n          \"tier\": \"core\",\n          \"runner\": \"cli-claude\",\n          \"model\": \"unknown\"\n        }\n      ]\n    },\n    \"elapsedMs\": 126384,\n    \"repoIndexedAt\": null,\n    \"schemaVersion\": 1,\n    \"epicHash\": \"1c09e09cd985026b\",\n    \"epicSlug\": \"plan-builder-runs-out-attempts-before\",\n    \"storyId\": \"s1\",\n    \"hldBaseRunId\": \"wf-1794407861492-hrj3mb\",\n    \"hldEffectiveHash\": \"8ba381786a7c79aaadbc4459f6f19512becabb840917f4fee36e787b6e801848\",\n    \"hldAmendmentsApplied\": [],\n    \"storyTitle\": \"Plan builder reports task-count errors early and fits the docs band (fix for ISSUE-1c09e09cd985026b)\",\n    \"standalone\": true,\n    \"authoredBy\": \"controller\",\n    \"lifecycle\": {\n      \"status\": \"draft\",\n      \"revision\": {\n        \"number\": 1,\n        \"contentHash\": \"28f4d0d62e95333260111033f36ead85cee76d6aba920d76782093f4a5c4b05d\",\n        \"at\": \"2026-11-11T14:39:54.601Z\",\n        \"by\": {\n          \"id\": \"insrc:system\",\n          \"kind\": \"system\",\n          \"properties\": {}\n        }\n      },\n      \"signoffs\": []\n    },\n    \"revision\": 1\n  },\n  \"body\": {\n    \"summary\": {\n      \"prose\": \"When a plan fails an ordering check and also has the wrong number of tasks, the plan builder now tells the model about the task-count problem in the same correction turn, instead of waiting until the ordering errors are gone. One correction pass can then fix both, so the attempts allowed are enough. The order of the invariant checks, the failure type and the stored feedback files stay as they are; the retry budget and the task-count band are not changed.\",\n      \"audience\": \"technical\"\n    },\n    \"hldContextSlice\": {\n      \"frameworkSummary\": \"Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\",\n      \"ownedContracts\": [],\n      \"consumedContracts\": [],\n      \"boundary\": {\n        \"storyId\": \"s1\",\n        \"owns\": [],\n        \"depends\": [],\n        \"internal\": \"Plan builder reports task-count errors early and fits the docs band (fix for ISSUE-1c09e09cd985026b)\"\n      },\n      \"adjacentBoundaries\": [],\n      \"rolloutPhase\": \"standalone\",\n      \"nonFunctional\": {}\n    },\n    \"contractDetails\": {\n      \"surfaceLevel\": \"internal\",\n      \"api\": [\n        {\n          \"name\": \"validatePlan\",\n          \"signature\": \"validatePlan(plan: PlanTask, catalog: readonly AnalyzeTaskTemplate[], opts?: ValidateOpts): PlanValidationFailure | null\",\n          \"parameters\": [\n            {\n              \"name\": \"plan\",\n              \"type\": \"PlanTask\",\n              \"purpose\": \"The stamped plan to check\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"catalog\",\n              \"type\": \"readonly AnalyzeTaskTemplate[]\",\n              \"purpose\": \"Templates the plan may use\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"opts\",\n              \"type\": \"ValidateOpts\",\n              \"purpose\": \"focused / isChildPlan flags\",\n              \"optional\": true\n            }\n          ],\n          \"returns\": {\n            \"type\": \"PlanValidationFailure | null\",\n            \"meaning\": \"The first failing invariant, or null. Unchanged by this Story.\"\n          },\n          \"errors\": [],\n          \"preconditions\": [\n            \"plan has passed the wire-shape check\"\n          ],\n          \"postconditions\": [\n            \"Behaviour and invariant order are unchanged\"\n          ]\n        },\n        {\n          \"name\": \"appendCorrectionTurn\",\n          \"signature\": \"appendCorrectionTurn(prior: LLMMessage[], rejected: PlanTask, failure: PlanValidationFailure, priorFailures: readonly PlanValidationFailure[], alsoFailing?: PlanValidationFailure | undefined): LLMMessage[]\",\n          \"parameters\": [\n            {\n              \"name\": \"prior\",\n              \"type\": \"LLMMessage[]\",\n              \"purpose\": \"The conversation so far\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"rejected\",\n              \"type\": \"PlanTask\",\n              \"purpose\": \"The plan just rejected\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"failure\",\n              \"type\": \"PlanValidationFailure\",\n              \"purpose\": \"The first failing invariant; stays the primary message\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"priorFailures\",\n              \"type\": \"readonly PlanValidationFailure[]\",\n              \"purpose\": \"Earlier failures, for the repetition banner\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"alsoFailing\",\n              \"type\": \"PlanValidationFailure | undefined\",\n              \"purpose\": \"A second, independent failure (the task-count band) to state in the same turn\",\n              \"optional\": true\n            }\n          ],\n          \"returns\": {\n            \"type\": \"LLMMessage[]\",\n            \"meaning\": \"The conversation with the correction turn appended; when alsoFailing is given the turn names it after the primary failure and tells the model to fix both\"\n          },\n          \"errors\": [],\n          \"preconditions\": [\n            \"alsoFailing, when given, has a different invariantId from failure\"\n          ],\n          \"postconditions\": [\n            \"Without alsoFailing the text of the turn is exactly what it is today\"\n          ]\n        },\n        {\n          \"name\": \"runPlanner\",\n          \"signature\": \"runPlanner(input: PlanBuilderInput, opts: PlanBuilderOpts): Promise<PlanTask>\",\n          \"parameters\": [\n            {\n              \"name\": \"input\",\n              \"type\": \"PlanBuilderInput\",\n              \"purpose\": \"Intent, catalog, context bundle\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"opts\",\n              \"type\": \"PlanBuilderOpts\",\n              \"purpose\": \"Run id, provider and callbacks\",\n              \"optional\": false\n            }\n          ],\n          \"returns\": {\n            \"type\": \"PlanTask\",\n            \"meaning\": \"The accepted plan. Unchanged.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"PlanBuilderExhausted\",\n              \"condition\": \"No attempt passed all invariants; unchanged\"\n            }\n          ],\n          \"preconditions\": [],\n          \"postconditions\": [\n            \"When the first failure is not INV-13 and the task count is outside the band, the correction turn also states the count failure\",\n            \"The failure recorded in failures[] and in feedback.json stays the primary (first) failure\"\n          ]\n        }\n      ]\n    },\n    \"dataModelChanges\": [\n      {\n        \"entity\": \"PlanValidationFailure\",\n        \"change\": \"invariant-change\",\n        \"details\": \"No field change. The count check is exposed as a function that returns a PlanValidationFailure for INV-13 or null, using the same band, the same focused lower bound and the same message as the check inside validatePlan, so both can never disagree. validatePlan calls it at its INV-13 position.\",\n        \"callSites\": [\n          \"src/analyze/planner/validate.ts:40\",\n          \"src/analyze/planner/validate.ts:418\",\n          \"src/analyze/planner/driver.ts:325\"\n        ]\n      }\n    ],\n    \"interactionWithShared\": [],\n    \"errorPaths\": {\n      \"errorCases\": [\n        {\n          \"scenario\": \"Plan fails an ordering invariant and also has a task count outside the band\",\n          \"detection\": \"After validatePlan returns a failure whose invariantId is not INV-13, the driver runs the count check on the same stamped plan and gets a non-null INV-13 failure\",\n          \"response\": \"The correction turn states the primary failure first and the count failure second, and asks for both to be fixed; failures[] and feedback.json record only the primary failure\",\n          \"userImpact\": \"None visible; the run needs fewer attempts\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"The plan still has the wrong count after being told about it\",\n          \"detection\": \"validatePlan reports INV-13 on a later attempt, with the same invariant id as the previous attempt's also-failing count\",\n          \"response\": \"Unchanged: it is reported as the primary failure with the existing repetition banner, and the run ends with PlanBuilderExhausted when attempts run out\",\n          \"userImpact\": \"The run fails with plan-invariant-failed as today\",\n          \"recoverable\": false\n        },\n        {\n          \"scenario\": \"The count check disagrees with the check inside validatePlan\",\n          \"detection\": \"Both come from one function, so a unit test that compares them on every band boundary would fail\",\n          \"response\": \"Build fails in tests; nothing to handle at run time\",\n          \"userImpact\": \"None\",\n          \"recoverable\": true\n        }\n      ],\n      \"edgeCases\": [\n        {\n          \"input\": \"The first failure is INV-13 itself\",\n          \"expected\": \"No also-failing section is added; the turn text is identical to today's\"\n        },\n        {\n          \"input\": \"The first failure is INV-1 (empty task list)\",\n          \"expected\": \"The count failure is also reported (0 tasks is outside every band) but the primary failure stays INV-1; the also line does not make the turn unreadable\"\n        },\n        {\n          \"input\": \"A focused plan\",\n          \"expected\": \"The count check uses the same halved lower bound as validatePlan\"\n        },\n        {\n          \"input\": \"A child plan with a smaller scope\",\n          \"expected\": \"The count check uses the plan's own scope band, as validatePlan does\"\n        },\n        {\n          \"input\": \"Count is inside the band\",\n          \"expected\": \"No also-failing section; turn text identical to today's\"\n        }\n      ],\n      \"invariantsToPreserve\": [\n        {\n          \"text\": \"validatePlan returns the first failing invariant in numeric order, and its result for any plan is unchanged\",\n          \"source\": \"c1\"\n        },\n        {\n          \"text\": \"Only the primary failure is recorded in failures[], the PlanBuilderExhausted error and the persisted feedback.json\",\n          \"source\": \"c2\"\n        },\n        {\n          \"text\": \"The retry loop's attempt limit is cfg.shaper.structuredOutputRetries and is not changed; SCOPE_BAND values are not changed\",\n          \"source\": \"c3\"\n        },\n        {\n          \"text\": \"The plan is stamped with the intent's scope before validation, so the model cannot choose its own band\",\n          \"source\": \"c2\"\n        }\n      ]\n    },\n    \"testStrategy\": {\n      \"testLevels\": [\n        {\n          \"level\": \"unit\",\n          \"purpose\": \"The count check agrees with validatePlan at every band boundary, and the correction turn states the count only when it is wrong and is not the primary failure\",\n          \"subjects\": [\n            \"task-count check against validatePlan INV-13 at lower and upper bounds for XS..XL, focused and not\",\n            \"appendCorrectionTurn with and without alsoFailing: unchanged text when absent, primary first and count second when present\",\n            \"invariant order and results of validatePlan unchanged for existing cases\"\n          ],\n          \"fixturesNeeded\": [\n            \"small PlanTask builders already used by validate.test.ts\"\n          ]\n        },\n        {\n          \"level\": \"integration\",\n          \"purpose\": \"The retry loop with a stubbed provider reaches an accepted plan within the existing attempt limit when a plan has both an ordering error and a wrong count\",\n          \"subjects\": [\n            \"runPlanner with a stub provider: attempt 1 has INV-7 and a count of 15 for XL focused; the second reply fixes both and is accepted\",\n            \"failures[] and feedback.json hold only the primary failure\",\n            \"PlanBuilderExhausted still thrown, with the primary failures, when the count is never fixed\"\n          ],\n          \"fixturesNeeded\": [\n            \"stub LLMProvider as in driver-unit.test.ts\",\n            \"registered template catalog\"\n          ]\n        },\n        {\n          \"level\": \"live\",\n          \"purpose\": \"The broad docs regression runs to a final report against the real daemon\",\n          \"subjects\": [\n            \"src/analyze/orchestrator/__tests__/docs-broad-live.test.ts with INSRC_LIVE_TESTS=1\"\n          ]\n        }\n      ],\n      \"acceptanceMapping\": [\n        {\n          \"criterionId\": \"ac1\",\n          \"provingTests\": [\n            \"src/analyze/planner/__tests__/validate.test.ts: the task-count check agrees with validatePlan at every band boundary\",\n            \"src/analyze/planner/__tests__/driver-unit.test.ts: a plan with an ordering error and a wrong count is told about both in one correction turn\",\n            \"src/analyze/planner/__tests__/driver-unit.test.ts: failures and feedback keep only the primary failure\",\n            \"src/analyze/orchestrator/__tests__/docs-broad-live.test.ts: broad docs request reaches a final report (live)\"\n          ]\n        }\n      ],\n      \"testFramework\": \"node:test via tsx (npx tsx --test), assert/strict, as in the existing planner tests\"\n    },\n    \"migration\": {\n      \"stateBefore\": \"validatePlan returns the first failing invariant in numeric order, so INV-13 (task count against SCOPE_BAND) is only reported after INV-7, INV-11 and INV-12 are cleared (src/analyze/planner/validate.ts:418). The retry loop in runPlanner appends one correction turn per failure, naming one invariant (src/analyze/planner/driver.ts:432).\",\n      \"stateAfter\": \"The first failure is still the primary message, and the same correction turn also states the task-count failure when the count is outside the band, so one reply can fix both. validatePlan, PlanValidationFailure, the stored feedback files, the attempt limit and SCOPE_BAND are unchanged.\",\n      \"migrationSteps\": [\n        {\n          \"order\": 1,\n          \"action\": \"Expose the task-count check as a function that validatePlan calls at its existing INV-13 position, with no change to its result\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 2,\n          \"action\": \"Extend the correction-turn builder to accept an optional second failure and render it after the primary failure; with none given, the text is unchanged\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 3,\n          \"action\": \"In the retry loop, when the first failure is not INV-13, run the count check on the same plan and pass a non-null result to the correction-turn builder; record only the primary failure\",\n          \"rollbackable\": true\n        }\n      ],\n      \"backwardCompat\": \"No public API, wire shape, stored file shape or config key changes. The only observable change is the extra text in the corrective user message sent to the model when a plan has an ordering error and a wrong count. Persisted feedback.json files and PlanBuilderExhausted carry the same fields as before.\",\n      \"zeroDowntime\": true,\n      \"dataRewriteRequired\": false\n    },\n    \"alternativesConsidered\": [\n      {\n        \"id\": \"a1\",\n        \"name\": \"Count check ahead of the ordering checks\",\n        \"oneLineSummary\": \"Return the task-count failure first, so a wrong count is told to the model in attempt 1.\",\n        \"approach\": \"Move the INV-13 check so validatePlan evaluates the task-count band before the ordering invariants (INV-7, INV-11, INV-12), keeping the one-failure-per-attempt contract. A plan with a wrong count and an ordering error is told about the count first; once the count is right the ordering error is reported. No new types.\",\n        \"pros\": [\n          \"Smallest change to validatePlan; keeps the single-failure contract and every existing consumer of PlanValidationFailure\",\n          \"Count errors are cheap to state and give the model the largest correction early\"\n        ],\n        \"cons\": [\n          \"Still one invariant per attempt: a plan with a wrong count and two ordering errors needs three attempts, which is the whole budget\",\n          \"Reorders the documented invariant numbering order, which tests and the design doc rely on\"\n        ],\n        \"costEstimate\": \"S\",\n        \"reasonRejected\": \"Only changes which single error comes first; a plan with a wrong count and two ordering errors still uses all three attempts, and it reorders documented invariants.\"\n      },\n      {\n        \"id\": \"a2\",\n        \"name\": \"Report the count together with the first failure\",\n        \"oneLineSummary\": \"Keep the first failure, and add the task-count problem to the same correction turn.\",\n        \"approach\": \"Keep validatePlan returning the first failure, and add a separate function that checks only the count band. The driver calls it when the first failure is not INV-13 and passes both to appendCorrectionTurn, which renders the primary failure plus a short 'also' line for the count. One correction pass can then fix both; the failure types stay as they are and the invariant order is unchanged.\",\n        \"pros\": [\n          \"Fixes the observed case: the 15-task plan would have been told about the count in attempt 1 along with INV-7\",\n          \"The invariant order, PlanValidationFailure and the persisted feedback.json shape are unchanged\",\n          \"The count check is a pure function over plan size and scope, so it is easy to test\"\n        ],\n        \"cons\": [\n          \"The correction turn has a second, secondary message, so appendCorrectionTurn and its tests change\",\n          \"Does not help when the model repeats a wrong count for reasons the message does not fix\"\n        ],\n        \"costEstimate\": \"M\"\n      },\n      {\n        \"id\": \"a3\",\n        \"name\": \"Planner-specific attempt budget\",\n        \"oneLineSummary\": \"Give the planner its own retry budget instead of the shared structuredOutputRetries.\",\n        \"approach\": \"Add a planner attempt limit separate from cfg.shaper.structuredOutputRetries (for example a named constant or a config key under the planner) and use it for the retry loop only, leaving the wire-level maxAttempts and the other callers on the shared value.\",\n        \"pros\": [\n          \"Gives a plan with several independent defects room to be fixed one per attempt\",\n          \"Does not change the classifier, aggregator or adherence budgets that share the config value\"\n        ],\n        \"cons\": [\n          \"More attempts mean more model calls on a plan that cannot be fixed, which is the cost accuracy is traded for\",\n          \"Does not by itself tell the model about the count earlier; it only gives more attempts\",\n          \"A new config key is a new public setting\"\n        ],\n        \"costEstimate\": \"S\",\n        \"reasonRejected\": \"Gives more attempts but does not address the hidden error and spends more model calls; keep as a follow-up if a real run still exhausts the budget.\"\n      },\n      {\n        \"id\": \"a4\",\n        \"name\": \"Adjust the XL band for docs plans\",\n        \"oneLineSummary\": \"Give the docs template family its own, lower task-count band.\",\n        \"approach\": \"Replace the single SCOPE_BAND lookup with one that can differ by template family, so a plan built from the docs catalog is held to a band the docs catalog can reach, while the code families keep the 40-80 band.\",\n        \"pros\": [\n          \"Removes the mismatch between a 20-task floor and a catalog of a few leaf templates\",\n          \"Leaves the code families unchanged\"\n        ],\n        \"cons\": [\n          \"Changes a design-doc policy that all families share, and what a docs plan is allowed to be\",\n          \"Lowering a floor to fit what the model produced weakens the check; it must be justified from the catalog, not the observed 15\",\n          \"Needs per-family data in the validator and the depth-policy text\"\n        ],\n        \"costEstimate\": \"M\",\n        \"reasonRejected\": \"A band change shared by every family needs its own justification from the docs catalog; revisit only if a run that was told the count still cannot reach the floor.\"\n      }\n    ],\n    \"chosenAlternative\": \"a2\",\n    \"openQuestions\": [\n      \"The Story title says 'and fits the docs band', but this LLD leaves SCOPE_BAND and the attempt budget unchanged (a3 and a4 deferred). Decide whether the band part is a follow-up issue or must be in this Story.\",\n      \"The Story has no acceptance criteria; ac1 in the test strategy stands in for the ISSUE's fix intent and should be confirmed by the reviewer.\",\n      \"invariantsToPreserve cite c1..c3 as stand-ins for the s1 bundles (validate.ts, driver.ts, run evidence), which carry no explicit ids.\",\n      \"Alternatives were ranked on rationale only, since the Story has no acceptance criteria or shared contracts to score against.\"\n    ]\n  },\n  \"citations\": [\n    {\n      \"id\": \"c1\",\n      \"kind\": \"code\",\n      \"ref\": \"src/analyze/planner/validate.ts:418\",\n      \"quotedText\": \"INV-13: scope policy adherence -- task count within the band.\"\n    },\n    {\n      \"id\": \"c2\",\n      \"kind\": \"code\",\n      \"ref\": \"src/analyze/planner/driver.ts:432\",\n      \"quotedText\": \"function appendCorrectionTurn(\"\n    },\n    {\n      \"id\": \"c3\",\n      \"kind\": \"code\",\n      \"ref\": \"src/analyze/planner/driver.ts:241\",\n      \"quotedText\": \"const maxAttempts = cfg.shaper.structuredOutputRetries;\"\n    },\n    {\n      \"id\": \"c4\",\n      \"kind\": \"step-output\",\n      \"ref\": \"~/.insrc/analyze/docs-broad-live-mwc5fz8p/plan.attempts/03.feedback.json\",\n      \"quotedText\": \"task count 15 is outside the scope band for XL (20-80 focused)\"\n    }\n  ]\n}\n","document":"<!-- insrc:artifact LLD-1c09e09cd985026b-s1 -->\n\n# LLD: STORY-1c09e09cd985026b-s1 — Plan builder reports task-count errors early and fits the docs band (fix for ISSUE-1c09e09cd985026b)\n\n## Summary\n\n**Epic:** `plan-builder-runs-out-attempts-before`\n**HLD base run:** `wf-1794407861492-hrj3mb`\n**HLD effective hash:** `8ba381786a7c...`\n\nWhen a plan fails an ordering check and also has the wrong number of tasks, the plan builder now tells the model about the task-count problem in the same correction turn, instead of waiting until the ordering errors are gone. One correction pass can then fix both, so the attempts allowed are enough. The order of the invariant checks, the failure type and the stored feedback files stay as they are; the retry budget and the task-count band are not changed.\n\n## Contents\n\n1. [HLD context](#1-hld-context)\n2. [Contract details](#2-contract-details)\n3. [Data model changes](#3-data-model-changes)\n4. [Error paths](#4-error-paths)\n5. [Test strategy](#5-test-strategy)\n6. [Migration](#6-migration)\n7. [Alternatives considered](#7-alternatives-considered)\n8. [References](#8-references)\n9. [Open questions](#9-open-questions)\n\n## 1. HLD context\n\n**Framework:** Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\n**Rollout phase:** standalone\n\n## 2. Contract details\n\n**Surface level:** internal\n\n### 2.1 `validatePlan`\n\n```typescript\nvalidatePlan(plan: PlanTask, catalog: readonly AnalyzeTaskTemplate[], opts?: ValidateOpts): PlanValidationFailure | null\n```\n\n**Parameters:**\n- `plan: PlanTask` — The stamped plan to check\n- `catalog: readonly AnalyzeTaskTemplate[]` — Templates the plan may use\n- `opts: ValidateOpts` _(optional)_ — focused / isChildPlan flags\n\n**Returns:** `PlanValidationFailure | null` — The first failing invariant, or null. Unchanged by this Story.\n\n**Preconditions:**\n- plan has passed the wire-shape check\n\n**Postconditions:**\n- Behaviour and invariant order are unchanged\n\n### 2.2 `appendCorrectionTurn`\n\n```typescript\nappendCorrectionTurn(prior: LLMMessage[], rejected: PlanTask, failure: PlanValidationFailure, priorFailures: readonly PlanValidationFailure[], alsoFailing?: PlanValidationFailure | undefined): LLMMessage[]\n```\n\n**Parameters:**\n- `prior: LLMMessage[]` — The conversation so far\n- `rejected: PlanTask` — The plan just rejected\n- `failure: PlanValidationFailure` — The first failing invariant; stays the primary message\n- `priorFailures: readonly PlanValidationFailure[]` — Earlier failures, for the repetition banner\n- `alsoFailing: PlanValidationFailure | undefined` _(optional)_ — A second, independent failure (the task-count band) to state in the same turn\n\n**Returns:** `LLMMessage[]` — The conversation with the correction turn appended; when alsoFailing is given the turn names it after the primary failure and tells the model to fix both\n\n**Preconditions:**\n- alsoFailing, when given, has a different invariantId from failure\n\n**Postconditions:**\n- Without alsoFailing the text of the turn is exactly what it is today\n\n### 2.3 `runPlanner`\n\n```typescript\nrunPlanner(input: PlanBuilderInput, opts: PlanBuilderOpts): Promise<PlanTask>\n```\n\n**Parameters:**\n- `input: PlanBuilderInput` — Intent, catalog, context bundle\n- `opts: PlanBuilderOpts` — Run id, provider and callbacks\n\n**Returns:** `PlanTask` — The accepted plan. Unchanged.\n\n**Errors:**\n- `PlanBuilderExhausted` when No attempt passed all invariants; unchanged\n\n**Postconditions:**\n- When the first failure is not INV-13 and the task count is outside the band, the correction turn also states the count failure\n- The failure recorded in failures[] and in feedback.json stays the primary (first) failure\n\n## 3. Data model changes\n\n### 3.1 `PlanValidationFailure` — invariant-change\n\nNo field change. The count check is exposed as a function that returns a PlanValidationFailure for INV-13 or null, using the same band, the same focused lower bound and the same message as the check inside validatePlan, so both can never disagree. validatePlan calls it at its INV-13 position.\n\n**Call sites:**\n- `src/analyze/planner/validate.ts:40`\n- `src/analyze/planner/validate.ts:418`\n- `src/analyze/planner/driver.ts:325`\n\n## 4. Error paths\n\n**Error cases**\n\n- **Plan fails an ordering invariant and also has a task count outside the band** (recoverable)\n  - Detection: After validatePlan returns a failure whose invariantId is not INV-13, the driver runs the count check on the same stamped plan and gets a non-null INV-13 failure\n  - Response: The correction turn states the primary failure first and the count failure second, and asks for both to be fixed; failures[] and feedback.json record only the primary failure\n  - User impact: None visible; the run needs fewer attempts\n- **The plan still has the wrong count after being told about it** (terminal)\n  - Detection: validatePlan reports INV-13 on a later attempt, with the same invariant id as the previous attempt's also-failing count\n  - Response: Unchanged: it is reported as the primary failure with the existing repetition banner, and the run ends with PlanBuilderExhausted when attempts run out\n  - User impact: The run fails with plan-invariant-failed as today\n- **The count check disagrees with the check inside validatePlan** (recoverable)\n  - Detection: Both come from one function, so a unit test that compares them on every band boundary would fail\n  - Response: Build fails in tests; nothing to handle at run time\n  - User impact: None\n\n**Edge cases**\n\n| Input | Expected |\n| :--- | :--- |\n| The first failure is INV-13 itself | No also-failing section is added; the turn text is identical to today's |\n| The first failure is INV-1 (empty task list) | The count failure is also reported (0 tasks is outside every band) but the primary failure stays INV-1; the also line does not make the turn unreadable |\n| A focused plan | The count check uses the same halved lower bound as validatePlan |\n| A child plan with a smaller scope | The count check uses the plan's own scope band, as validatePlan does |\n| Count is inside the band | No also-failing section; turn text identical to today's |\n\n**Invariants to preserve**\n\n- validatePlan returns the first failing invariant in numeric order, and its result for any plan is unchanged [[c1]]\n- Only the primary failure is recorded in failures[], the PlanBuilderExhausted error and the persisted feedback.json [[c2]]\n- The retry loop's attempt limit is cfg.shaper.structuredOutputRetries and is not changed; SCOPE_BAND values are not changed [[c3]]\n- The plan is stamped with the intent's scope before validation, so the model cannot choose its own band [[c2]]\n\n## 5. Test strategy\n\n**Test framework:** `node:test via tsx (npx tsx --test), assert/strict, as in the existing planner tests`\n\n**Test levels**\n\n- **unit** — The count check agrees with validatePlan at every band boundary, and the correction turn states the count only when it is wrong and is not the primary failure\n  - Subjects: `task-count check against validatePlan INV-13 at lower and upper bounds for XS..XL, focused and not`, `appendCorrectionTurn with and without alsoFailing: unchanged text when absent, primary first and count second when present`, `invariant order and results of validatePlan unchanged for existing cases`\n  - Fixtures: `small PlanTask builders already used by validate.test.ts`\n- **integration** — The retry loop with a stubbed provider reaches an accepted plan within the existing attempt limit when a plan has both an ordering error and a wrong count\n  - Subjects: `runPlanner with a stub provider: attempt 1 has INV-7 and a count of 15 for XL focused; the second reply fixes both and is accepted`, `failures[] and feedback.json hold only the primary failure`, `PlanBuilderExhausted still thrown, with the primary failures, when the count is never fixed`\n  - Fixtures: `stub LLMProvider as in driver-unit.test.ts`, `registered template catalog`\n- **live** — The broad docs regression runs to a final report against the real daemon\n  - Subjects: `src/analyze/orchestrator/__tests__/docs-broad-live.test.ts with INSRC_LIVE_TESTS=1`\n\n**Acceptance mapping**\n\n| Criterion | Proving tests |\n| :--- | :--- |\n| `ac1` | `src/analyze/planner/__tests__/validate.test.ts: the task-count check agrees with validatePlan at every band boundary`, `src/analyze/planner/__tests__/driver-unit.test.ts: a plan with an ordering error and a wrong count is told about both in one correction turn`, `src/analyze/planner/__tests__/driver-unit.test.ts: failures and feedback keep only the primary failure`, `src/analyze/orchestrator/__tests__/docs-broad-live.test.ts: broad docs request reaches a final report (live)` |\n\n## 6. Migration\n\n**State before:** validatePlan returns the first failing invariant in numeric order, so INV-13 (task count against SCOPE_BAND) is only reported after INV-7, INV-11 and INV-12 are cleared (src/analyze/planner/validate.ts:418). The retry loop in runPlanner appends one correction turn per failure, naming one invariant (src/analyze/planner/driver.ts:432).\n\n**State after:** The first failure is still the primary message, and the same correction turn also states the task-count failure when the count is outside the band, so one reply can fix both. validatePlan, PlanValidationFailure, the stored feedback files, the attempt limit and SCOPE_BAND are unchanged.\n\n**Zero downtime:** yes — **Data rewrite:** no\n\n**Steps**\n\n1. Expose the task-count check as a function that validatePlan calls at its existing INV-13 position, with no change to its result — ↩ rollbackable\n2. Extend the correction-turn builder to accept an optional second failure and render it after the primary failure; with none given, the text is unchanged — ↩ rollbackable\n3. In the retry loop, when the first failure is not INV-13, run the count check on the same plan and pass a non-null result to the correction-turn builder; record only the primary failure — ↩ rollbackable\n\n**Backward compat:** No public API, wire shape, stored file shape or config key changes. The only observable change is the extra text in the corrective user message sent to the model when a plan has an ordering error and a wrong count. Persisted feedback.json files and PlanBuilderExhausted carry the same fields as before.\n\n## 7. Alternatives considered\n\n### 7.1 a1: Count check ahead of the ordering checks\n\nReturn the task-count failure first, so a wrong count is told to the model in attempt 1.\n\nMove the INV-13 check so validatePlan evaluates the task-count band before the ordering invariants (INV-7, INV-11, INV-12), keeping the one-failure-per-attempt contract. A plan with a wrong count and an ordering error is told about the count first; once the count is right the ordering error is reported. No new types.\n\n**Rejected because:** Only changes which single error comes first; a plan with a wrong count and two ordering errors still uses all three attempts, and it reorders documented invariants.\n\n### 7.2 a2: Report the count together with the first failure — **CHOSEN**\n\nKeep the first failure, and add the task-count problem to the same correction turn.\n\nKeep validatePlan returning the first failure, and add a separate function that checks only the count band. The driver calls it when the first failure is not INV-13 and passes both to appendCorrectionTurn, which renders the primary failure plus a short 'also' line for the count. One correction pass can then fix both; the failure types stay as they are and the invariant order is unchanged.\n\n### 7.3 a3: Planner-specific attempt budget\n\nGive the planner its own retry budget instead of the shared structuredOutputRetries.\n\nAdd a planner attempt limit separate from cfg.shaper.structuredOutputRetries (for example a named constant or a config key under the planner) and use it for the retry loop only, leaving the wire-level maxAttempts and the other callers on the shared value.\n\n**Rejected because:** Gives more attempts but does not address the hidden error and spends more model calls; keep as a follow-up if a real run still exhausts the budget.\n\n### 7.4 a4: Adjust the XL band for docs plans\n\nGive the docs template family its own, lower task-count band.\n\nReplace the single SCOPE_BAND lookup with one that can differ by template family, so a plan built from the docs catalog is held to a band the docs catalog can reach, while the code families keep the 40-80 band.\n\n**Rejected because:** A band change shared by every family needs its own justification from the docs catalog; revisit only if a run that was told the count still cannot reach the floor.\n\n## 8. References\n\n- **[[c1]]** `code` `src/analyze/planner/validate.ts:418` — \"INV-13: scope policy adherence -- task count within the band.\"\n- **[[c2]]** `code` `src/analyze/planner/driver.ts:432` — \"function appendCorrectionTurn(\"\n- **[[c3]]** `code` `src/analyze/planner/driver.ts:241` — \"const maxAttempts = cfg.shaper.structuredOutputRetries;\"\n- **[[c4]]** `step-output` `~/.insrc/analyze/docs-broad-live-mwc5fz8p/plan.attempts/03.feedback.json` — \"task count 15 is outside the scope band for XL (20-80 focused)\"\n\n## 9. Open questions\n\n- The Story title says 'and fits the docs band', but this LLD leaves SCOPE_BAND and the attempt budget unchanged (a3 and a4 deferred). Decide whether the band part is a follow-up issue or must be in this Story.\n- The Story has no acceptance criteria; ac1 in the test strategy stands in for the ISSUE's fix intent and should be confirmed by the reviewer.\n- invariantsToPreserve cite c1..c3 as stand-ins for the s1 bundles (validate.ts, driver.ts, run evidence), which carry no explicit ids.\n- Alternatives were ranked on rationale only, since the Story has no acceptance criteria or shared contracts to score against.\n"},"capturedAt":"2026-11-11T14:40:10.696Z"},"inventory":{"units":[{"id":"/body/summary","selector":"/body/summary","title":"summary","kind":"section"},{"id":"/body/hldContextSlice","selector":"/body/hldContextSlice","title":"hldContextSlice","kind":"section"},{"id":"/body/contractDetails","selector":"/body/contractDetails","title":"contractDetails","kind":"section"},{"id":"/body/dataModelChanges","selector":"/body/dataModelChanges","title":"dataModelChanges","kind":"section"},{"id":"/body/interactionWithShared","selector":"/body/interactionWithShared","title":"interactionWithShared","kind":"section"},{"id":"/body/errorPaths","selector":"/body/errorPaths","title":"errorPaths","kind":"section"},{"id":"/body/testStrategy","selector":"/body/testStrategy","title":"testStrategy","kind":"section"},{"id":"/body/migration","selector":"/body/migration","title":"migration","kind":"section"},{"id":"/body/alternativesConsidered","selector":"/body/alternativesConsidered","title":"alternativesConsidered","kind":"section"},{"id":"/body/chosenAlternative","selector":"/body/chosenAlternative","title":"chosenAlternative","kind":"section"},{"id":"/body/openQuestions","selector":"/body/openQuestions","title":"openQuestions","kind":"section"},{"id":"/body/alternativesConsidered/0","selector":"/body/alternativesConsidered/0","title":"a1","kind":"requirement"},{"id":"/body/alternativesConsidered/1","selector":"/body/alternativesConsidered/1","title":"a2","kind":"requirement"},{"id":"/body/alternativesConsidered/2","selector":"/body/alternativesConsidered/2","title":"a3","kind":"requirement"},{"id":"/body/alternativesConsidered/3","selector":"/body/alternativesConsidered/3","title":"a4","kind":"requirement"},{"id":"/citations/0","selector":"/citations/0","title":"Citation 1","kind":"citation"},{"id":"/citations/1","selector":"/citations/1","title":"Citation 2","kind":"citation"},{"id":"/citations/2","selector":"/citations/2","title":"Citation 3","kind":"citation"},{"id":"/citations/3","selector":"/citations/3","title":"Citation 4","kind":"citation"},{"id":"document:line:25","selector":"document:line:25","title":"1. HLD context","kind":"section"}]},"completedChunks":[{"chunkId":"scope","status":"changes_requested","summary":"The chosen approach addresses delayed task-count feedback and preserves existing contracts. However, it leaves the originating issue’s docs-band and attempt-budget decision unresolved. No diagram or UX artifact is necessary for this internal correction-message change; the prose contracts adequately describe its boundaries.","findings":[{"id":"scope-001","severity":"MED","location":"/body/openQuestions/0; /body/alternativesConsidered/2; /body/alternativesConsidered/3","message":"The LLD defers part of the originating ISSUE’s fix intent without establishing that the retained policy supports a valid docs plan within three attempts. The ISSUE explicitly requires reviewing the XL band and attempt budget and setting them appropriately for the docs catalog. Instead, a3/a4 defer that assessment until another run fails, while openQuestions leaves whether it belongs in this Story undecided. The captured run proves delayed feedback and a persistent 15-task plan; it does not establish that 20 meaningful tasks are appropriate or reachable within the retained budget. The catalog supports repeated parameterized templates and child plans, so its small template count alone also cannot justify lowering the band. Resolve the scope decision and document a catalog-grounded justification for retaining or changing the band and budget, with explicit acceptance expectations. Additional model-call cost alone is insufficient grounds under the repository’s accuracy-first principle.","evidenceReferences":["docs/standalone/plan-builder-runs-out-attempts-before-E202611111c09e09c/ISSUE.md: Fix intent and Root cause",".insrc/artifacts/LLD-1c09e09cd985026b-s1.json: /body/alternativesConsidered/2/reasonRejected",".insrc/artifacts/LLD-1c09e09cd985026b-s1.json: /body/alternativesConsidered/3/reasonRejected",".insrc/artifacts/LLD-1c09e09cd985026b-s1.json: /body/openQuestions/0","src/analyze/planner/templates/docs/index.ts: docsFamilySummarise, docsDecisionTrace, docsConstraintEnumerate, docsSubrunDeepDive","/home/subho/.insrc/analyze/docs-broad-live-mwc5fz8p/plan.attempts/01.feedback.json","/home/subho/.insrc/analyze/docs-broad-live-mwc5fz8p/plan.attempts/02.feedback.json","/home/subho/.insrc/analyze/docs-broad-live-mwc5fz8p/plan.attempts/03.feedback.json","/home/subho/.insrc/analyze/docs-broad-live-mwc5fz8p/plan.attempts/03.plan.json","design/analyze-plan-builder.md: Retry loop and XL → planner-template tasks","AGENTS.md instructions supplied in conversation: Accuracy is primary; cost is the least priority"]}],"inspectedReferences":["/body/summary","/body/hldContextSlice","document:line:25","/body/alternativesConsidered","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/alternativesConsidered/2","/body/alternativesConsidered/3","/body/chosenAlternative","/body/openQuestions","/citations/3","/home/subho/work/dev/insors/insrc/docs/standalone/plan-builder-runs-out-attempts-before-E202611111c09e09c/S001/LLD.md","/home/subho/work/dev/insors/insrc/.insrc/artifacts/LLD-1c09e09cd985026b-s1.json","/home/subho/work/dev/insors/insrc/docs/standalone/plan-builder-runs-out-attempts-before-E202611111c09e09c/ISSUE.md","src/analyze/planner/templates/docs/index.ts","src/analyze/planner/validate.ts","src/analyze/planner/driver.ts","src/analyze/orchestrator/__tests__/docs-broad-live.test.ts","design/analyze-plan-builder.md","docs/plans/docs-module.md","/home/subho/.insrc/analyze/docs-broad-live-mwc5fz8p/plan.attempts/01.plan.json","/home/subho/.insrc/analyze/docs-broad-live-mwc5fz8p/plan.attempts/02.plan.json","/home/subho/.insrc/analyze/docs-broad-live-mwc5fz8p/plan.attempts/03.plan.json","/home/subho/.insrc/analyze/docs-broad-live-mwc5fz8p/plan.attempts/01.feedback.json","/home/subho/.insrc/analyze/docs-broad-live-mwc5fz8p/plan.attempts/02.feedback.json","/home/subho/.insrc/analyze/docs-broad-live-mwc5fz8p/plan.attempts/03.feedback.json"],"limitations":[],"advice":["Live regression execution was not performed during this read-only design review; the captured attempts and referenced test source were inspected."]},{"chunkId":"planner","status":"changes_requested","summary":"The extraction and integration approach preserves validator ordering, stamped scope, focused and child-plan bands, and primary-only persistence. The repetition behavior contains a contradictory requirement, and the documented runPlanner signature differs from the current API. No diagram or UX artifact is necessary for this internal message-composition change.","findings":[{"id":"planner-001","severity":"MED","location":"/body/errorPaths/errorCases/1/response","message":"The promised repetition banner cannot occur under the specified unchanged history and message behavior. If attempt 1 reports primary INV-7 plus secondary INV-13, failures[] retains only INV-7. When attempt 2 first reports primary INV-13, repetitionBannerFor compares it with INV-7 and returns no banner. This also conflicts with the requirement that turns without alsoFailing remain exactly unchanged. Resolve the contract explicitly: preserve primary-only repetition semantics and correct this error path, or design separate secondary-failure history and reconcile the unchanged-text requirement. Cover the secondary-to-primary transition in a regression test.","evidenceReferences":[".insrc/artifacts/LLD-1c09e09cd985026b-s1.json: /body/errorPaths/errorCases/1",".insrc/artifacts/LLD-1c09e09cd985026b-s1.json: /body/contractDetails/api/1/postconditions","src/analyze/planner/driver.ts:343-358 — priorFailures snapshot and primary-only history/persistence","src/analyze/planner/driver.ts:524-531 — repetition requires the immediately preceding primary invariant and target to match","src/analyze/planner/__tests__/driver-unit.test.ts:503 — different previous invariant produces no escalation banner"]},{"id":"planner-002","severity":"LOW","location":"/body/contractDetails/api/2","message":"The documented runPlanner(input, opts) signature is not the current contract. The implementation accepts one RunPlannerArgs object containing input, opts and optional provider; PlanBuilderOpts does not contain provider. Update the signature and parameter descriptions so this purportedly unchanged API does not direct builders or tests toward an incompatible invocation.","evidenceReferences":["docs/standalone/plan-builder-runs-out-attempts-before-E202611111c09e09c/S001/LLD.md: section 2.3","src/analyze/planner/driver.ts:160-183 — RunPlannerArgs and runPlanner declaration","src/analyze/planner/types.ts: PlanBuilderOpts","src/analyze/planner/__tests__/driver-unit.test.ts:346 — existing object-form invocation"]}],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/body/interactionWithShared","/body/errorPaths","/body/migration","/citations/0","/citations/1","/citations/2","/home/subho/work/dev/insors/insrc/docs/standalone/plan-builder-runs-out-attempts-before-E202611111c09e09c/S001/LLD.md","/home/subho/work/dev/insors/insrc/.insrc/artifacts/LLD-1c09e09cd985026b-s1.json","/home/subho/work/dev/insors/insrc/docs/standalone/plan-builder-runs-out-attempts-before-E202611111c09e09c/ISSUE.md","src/analyze/planner/validate.ts","src/analyze/planner/driver.ts","src/analyze/planner/cache.ts","src/analyze/planner/types.ts","src/analyze/planner/invariant-fix-hints.ts","src/analyze/planner/__tests__/driver-unit.test.ts","src/analyze/planner/__tests__/validate.test.ts","design/analyze-plan-builder.md"],"limitations":[],"advice":["The three migration steps are dependency-compatible and reversible without a data rewrite. Keep the existing wire encoding, connection guards and sequential provider invocation intact.","Citations c1–c3 resolve to the quoted current code. For stronger traceability, cite driver scope stamping and primary-feedback persistence directly rather than using the appendCorrectionTurn declaration as their supporting location.","Tests and live model calls were not executed; execution is optional for this read-only design assessment."]},{"chunkId":"verification","status":"changes_requested","summary":"The proposed boundary, correction-message, persistence and exhaustion checks are feasible. The live test can establish final-report delivery, but the deterministic regression does not cover the observed multi-error sequence or demonstrate acceptance using the docs catalog.","findings":[{"id":"verification-001","severity":"MED","location":"/body/testStrategy/testLevels/1","message":"The only successful retry scenario jumps from INV-7 plus 15 tasks directly to acceptance on reply 2. It omits the subsequent INV-11 failure that consumed another attempt in the originating ISSUE, and specifies only a registered catalog rather than a representative docs plan. Consequently, it does not establish the claimed recovery within the existing three-attempt budget for the reproduced case. Add a deterministic docs-catalog regression that exposes count feedback alongside INV-7, retains the independently failing INV-11 after the first correction, and reaches a valid in-band plan on the final allowed attempt. Assert the correction messages, attempt count and primary-only feedback across that sequence.","evidenceReferences":["docs/standalone/plan-builder-runs-out-attempts-before-E202611111c09e09c/S001/LLD.md: section 5, integration subjects and fixtures","docs/standalone/plan-builder-runs-out-attempts-before-E202611111c09e09c/ISSUE.md: Reproduction and Fix intent","/home/subho/.insrc/analyze/docs-broad-live-mwc5fz8p/plan.attempts/01.feedback.json: INV-7","/home/subho/.insrc/analyze/docs-broad-live-mwc5fz8p/plan.attempts/02.feedback.json: INV-11","/home/subho/.insrc/analyze/docs-broad-live-mwc5fz8p/plan.attempts/03.feedback.json: INV-13, 15 tasks versus focused XL minimum 20","src/analyze/planner/templates/docs/index.ts: DOCS_TEMPLATES","src/analyze/planner/driver.ts: retry loop and primary-feedback persistence"]},{"id":"verification-002","severity":"LOW","location":"/body/testStrategy/acceptanceMapping/0/criterionId","message":"The acceptance table maps every test to undefined criterion ac1; the originating ISSUE has 