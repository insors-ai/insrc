49544f0eb1","document":"fe879845422363fdf7b6f62cdb211e0f3498225cb9005fc8e2f8392f9d336f6a"},"contentIdentity":"9c43895e5de61860b76274370f84ccf659e5b7fc95198e585a131db1c0f061b0","reviewedContent":{"canonical":"{\n  \"meta\": {\n    \"workflow\": \"design.story\",\n    \"runId\": \"wf-1794217074628-a5xufy\",\n    \"repoPath\": \"/Users/subhagho/work/projects/insors/insrc\",\n    \"createdAt\": \"2026-11-09T09:40:04.644Z\",\n    \"attribution\": {\n      \"outputs\": [\n        {\n          \"role\": \"(client)\",\n          \"tier\": \"core\",\n          \"runner\": \"cli-codex\",\n          \"model\": \"unknown\"\n        }\n      ]\n    },\n    \"elapsedMs\": 129698,\n    \"repoIndexedAt\": null,\n    \"schemaVersion\": 1,\n    \"epicCreatedAt\": \"2026-11-09T06:00:04.355Z\",\n    \"epicHash\": \"206db3426ffd4428\",\n    \"epicSlug\": \"show-long-running-task-progress-chat\",\n    \"storyId\": \"s1\",\n    \"hldBaseRunId\": \"wf-1794211533808-ghbhlu\",\n    \"hldEffectiveHash\": \"48a6a5468b45d758c2f607734dcbfdf65a0d1476d8c409eeed1ac09aa037dec9\",\n    \"hldAmendmentsApplied\": [],\n    \"storyTitle\": \"Track long-running work consistently across executors\",\n    \"authoredBy\": \"controller\",\n    \"revision\": 1\n  },\n  \"body\": {\n    \"summary\": {\n      \"audience\": \"technical\",\n      \"prose\": \"The daemon foundation keeps each task tied to its verified executor and originating conversation. It stores bounded observations, exposes one authorized snapshot model, and recovers state after restart. Executor activity and optional polling run on separate schedules.\"\n    },\n    \"hldContextSlice\": {\n      \"frameworkSummary\": \"Use executor delegates with a shared daemon coordinator. Preserve legacy workflow and analyze IPC frames and existing execution authority. The coordinator feeds a typed VS Code adapter, request-scoped MCP notifications and one optional fallback observation schedule.\",\n      \"ownedContracts\": [\n        {\n          \"id\": \"sc1\",\n          \"name\": \"Task identity and delegate observation\",\n          \"purpose\": \"One verified owner binds each task attempt to one project and originating invocation. An insrc chat may own many invocations, and an invocation may launch many tasks. Each task has one current attempt, with at most one active owner epoch. External host, daemon session and extension chat identities are optional distinct bindings, never inferred from one another. Both delivery paths use this delegate snapshot. The foundation is parameterized by producer-owned detail types, so it has no type dependency on later stories.\",\n          \"interfaceSketch\": \"interface TaskRef {\\n  readonly projectId: string;\\n  readonly invocationId: string;\\n  readonly taskId: string;\\n  readonly attempt: number;\\n}\\ninterface TaskOwnerFence {\\n  readonly ownerId: string;\\n  readonly ownerEpoch: string;\\n  readonly ownerSequence: number;\\n}\\ninterface TaskOrigin {\\n  readonly extensionChatId?: string;\\n  readonly daemonSessionId?: string;\\n  readonly nativeSessionId?: string;\\n  readonly turnId?: string;\\n}\\ntype ProgressKind = 'workflow' | 'analysis' | 'design-review' | 'code-review' | 'test';\\ninterface MeasuredCount {\\n  readonly unit: string;\\n  readonly completed: number;\\n  readonly total: number | null;\\n}\\ninterface DelegateMeasurement<Details extends { readonly kind: ProgressKind }> {\\n  readonly task: TaskRef;\\n  readonly owner: TaskOwnerFence;\\n  readonly kind: ProgressKind;\\n  readonly measuredAt: string;\\n  readonly meaningfulRevision: number;\\n  readonly lastMeaningfulAt: string | null;\\n  readonly phase: string;\\n  readonly activeUnit: string | null;\\n  readonly counts: readonly MeasuredCount[];\\n  readonly milestones: readonly string[];\\n  readonly controls: readonly ('cancel')[];\\n  readonly details: Details;\\n}\\ninterface TaskProgressDelegate<Details extends { readonly kind: ProgressKind }> {\\n  progress(task: TaskRef): Promise<DelegateMeasurement<Details> | null>;\\n}\",\n          \"ownedByStory\": \"s1\",\n          \"consumedByStories\": [\n            \"s2\",\n            \"s3\",\n            \"s4\",\n            \"s5\",\n            \"s6\"\n          ],\n          \"assumptions\": [\n            \"c3\",\n            \"c4\",\n            \"c5\",\n            \"c7\"\n          ]\n        },\n        {\n          \"id\": \"sc2\",\n          \"name\": \"Scoped snapshots, subscriptions and observation control\",\n          \"purpose\": \"The daemon authorizes every operation against server-verified caller/project/origin bindings, including logs and controls. A read yields a compact snapshot, meaningful-change indicator and revision cursor. Observer loss, executor state and session retention are independent. The shared coordinator arbitrates one optional fallback schedule per task, independent of all native subscriptions. Owner credentials, internal session identifiers and fencing fields remain server-side. A structured fallback lease governs the scheduler, without granting execution authority.\",\n          \"interfaceSketch\": \"type TaskState = 'queued' | 'running' | 'waiting' | 'paused' | 'completed' | 'failed' | 'cancelled' | 'interrupted' | 'unknown';\\ntype ProgressFreshness = 'live' | 'stale' | 'unavailable';\\ntype DeliveredMeasurement<Details extends { readonly kind: ProgressKind }> = Omit<DelegateMeasurement<Details>, 'owner'>;\\ninterface ProgressSnapshot<Details extends { readonly kind: ProgressKind }> {\\n  readonly task: TaskRef;\\n  readonly cursor: string;\\n  readonly state: TaskState;\\n  readonly freshness: ProgressFreshness;\\n  readonly measurement: DeliveredMeasurement<Details> | null;\\n  readonly lastOwnerActivityAt: string | null;\\n  readonly workerHealth: 'alive' | 'lost' | 'unknown';\\n  readonly cancellation: 'none' | 'pending';\\n  readonly resultRef?: string;\\n}\\ninterface ObservationReply<Details extends { readonly kind: ProgressKind }> {\\n  readonly snapshot: ProgressSnapshot<Details>;\\n  readonly disposition: 'changed' | 'unchanged' | 'resync';\\n  readonly schedule: 'native' | 'scheduled' | 'suspended' | 'stopped';\\n  readonly nextPollNotBefore?: string;\\n}\\ninterface ObservationControl {\\n  readonly task: TaskRef;\\n  readonly action: 'stop-observation' | 'cancel-execution';\\n  readonly requestId: string;\\n}\",\n          \"ownedByStory\": \"s1\",\n          \"consumedByStories\": [\n            \"s2\",\n            \"s3\",\n            \"s4\",\n            \"s5\",\n            \"s6\"\n          ],\n          \"assumptions\": [\n            \"c3\",\n            \"c6\",\n            \"c7\"\n          ]\n        },\n        {\n          \"id\": \"sc3\",\n          \"name\": \"Execution-owned activity and chat retention\",\n          \"purpose\": \"One current owned attempt may hold at most one active association for its originating insrc conversation. Each chat may have many associations. The coordinator renews through verified executor activity, and the actual session owner consumes the lease or a runtime renewal. View closure does not release a retained conversation. Removing a conversation releases only its association and retains project-scoped authorized task results.\",\n          \"interfaceSketch\": \"interface TaskActivityLease {\\n  readonly task: TaskRef;\\n  readonly origin: TaskOrigin;\\n  readonly fence: TaskOwnerFence;\\n  readonly renewedAt: string;\\n  readonly expiresAt: string;\\n}\\ninterface ChatTaskRetention {\\n  readonly originatingChatId: string;\\n  readonly retainedTasks: readonly { task: TaskRef; expiresAt: string }[];\\n}\",\n          \"ownedByStory\": \"s1\",\n          \"consumedByStories\": [\n            \"s2\",\n            \"s3\",\n            \"s4\",\n            \"s5\"\n          ],\n          \"assumptions\": [\n            \"c3\"\n          ]\n        }\n      ],\n      \"consumedContracts\": [],\n      \"boundary\": {\n        \"storyId\": \"s1\",\n        \"owns\": [\n          \"sc1\",\n          \"sc2\",\n          \"sc3\"\n        ],\n        \"depends\": [],\n        \"internal\": \"Own daemon coordination, verified registration, cursors, normalization, scoped read/subscribe/control, durable state, owner fencing and fallback schedule arbitration. Keep storage, fencing and expiry implementation private.\"\n      },\n      \"adjacentBoundaries\": [\n        {\n          \"storyId\": \"s2\",\n          \"owns\": [\n            \"sc4\"\n          ],\n          \"depends\": [\n            \"sc1\",\n            \"sc2\",\n            \"sc3\"\n          ],\n          \"internal\": \"Own adapters for existing workflow and analyze producer signals and terminal/owner evidence. Existing stream shape and command semantics remain compatible.\"\n        },\n        {\n          \"storyId\": \"s3\",\n          \"owns\": [\n            \"sc5\"\n          ],\n          \"depends\": [\n            \"sc1\",\n            \"sc2\",\n            \"sc3\"\n          ],\n          \"internal\": \"Own DesignReviewDelegate and CodeReviewDelegate and mappings from checkpoint progress and execution ownership. Review results, admission, retries and publication remain under the existing engines.\"\n        },\n        {\n          \"storyId\": \"s4\",\n          \"owns\": [\n            \"sc6\"\n          ],\n          \"depends\": [\n            \"sc1\",\n            \"sc2\",\n            \"sc3\"\n          ],\n          \"internal\": \"Own TestDelegate and managed reporter interpretation, including suite/case identity, provisional counts and abnormal exit. Keep test orchestration and exit semantics unchanged.\"\n        },\n        {\n          \"storyId\": \"s5\",\n          \"owns\": [],\n          \"depends\": [\n            \"sc1\",\n            \"sc2\",\n            \"sc3\",\n            \"sc4\",\n            \"sc5\",\n            \"sc6\"\n          ],\n          \"internal\": \"Own typed VS Code reader and transcript row, current status projection and bindings to the session owner. Render durable snapshots by origin across turns and multiple windows without executing or polling models.\"\n        },\n        {\n          \"storyId\": \"s6\",\n          \"owns\": [],\n          \"depends\": [\n            \"sc1\",\n            \"sc2\",\n            \"sc4\",\n            \"sc5\",\n            \"sc6\"\n          ],\n          \"internal\": \"Own MCP adapter, capability qualification, explicit opt-in disclosure and connection to the coordinator's fallback lease. No vendor-specific process changes or assumptions about session identity.\"\n        }\n      ],\n      \"rolloutPhase\": \"Phase A — daemon observation foundation\",\n      \"nonFunctional\": {\n        \"performance\": \"Proposed caps for qualification are one coalesced active snapshot per second per task, 8 KiB per snapshot, 32 retained meaningful milestones, 16 queued observer updates and a reserved terminal state. Enforce per-project limits of 128 tracked active observations and 1,024 retained terminal observations, plus a global disk budget of 128 MiB. Exceeding observation capacity must report degradation without refusing, cancelling or slowing work. Terminal updates bypass normal coalescing. Reserve the observation terminal slot and bounded storage on admission. Evict only older terminal entries by policy, and refuse new observation with a capacity state when no reservation is possible. Do not evict active owners to admit new observations.\",\n        \"security\": \"Authenticate observations via existing daemon caller identity and verify project, conversation/invocation and task attempt before returning any snapshot, detail or control. Opaque cursors and task IDs do not grant authorization. Persist and expose sanitized structured measurements only. Detailed logs remain authorized, bounded references. No direct database access in MCP or VS Code.\",\n        \"observability\": \"Measure emitted and coalesced progress, cursor gaps, scheduler degradation, stale source age, rejected owner fences and retention transitions separately. Qualify each producer end to end, verify zero extra model invocations for native paths, and live-qualify CLI token, rendering, background lifetime and scheduling per version/session. Never log raw prompts, output or credentials as progress.\",\n        \"durability\": \"Use daemon-owned atomic per-task snapshots on local storage, with bounded milestone records and terminal result pointers. Persist terminal state before delivery. Refresh verified owner activity every 30 seconds with a 120-second lease, qualifying the margin against the actual session owner's idle threshold. After daemon restart recover persisted observations before accepting new owner events. Hold stale owner retention at most through its bounded grace and show interrupted or unknown until authority is reverified. Terminal retention is seven days subject to bounded capacity, after which separately available executor results remain authoritative. For executors without durable result history, expiry is explicit and is never rendered as a success, cancellation or new execution.\"\n      }\n    },\n    \"contractDetails\": {\n      \"surfaceLevel\": \"internal-shared\",\n      \"api\": [\n        {\n          \"name\": \"TaskProgressDelegate\",\n          \"signature\": \"interface TaskProgressDelegate<D extends { readonly kind: ProgressKind }> { progress(task: TaskRef): Promise<DelegateMeasurement<D> | null>; }\",\n          \"parameters\": [\n            {\n              \"name\": \"task\",\n              \"type\": \"TaskRef\",\n              \"purpose\": \"Server-issued project, invocation, task and attempt tuple.\",\n              \"optional\": false\n            }\n          ],\n          \"returns\": {\n            \"type\": \"Promise<DelegateMeasurement<D> | null>\",\n            \"meaning\": \"Bounded producer details or unavailable.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"invalid-source\",\n              \"condition\": \"Measurement fails validation or source is unreachable.\"\n            }\n          ],\n          \"preconditions\": [\n            \"Bind a delegate and runtime-only owner handle to the registered invocation before detaching.\"\n          ],\n          \"postconditions\": [\n            \"No execution, model, cancellation or lease side effects.\",\n            \"Read results are revalidated against current attempt and epoch after await.\"\n          ]\n        },\n        {\n          \"name\": \"ProgressSnapshot\",\n          \"signature\": \"type ProgressSnapshot<D extends { readonly kind: ProgressKind }> = Readonly<{ task: TaskRef; cursor: string; state: TaskState; freshness: ProgressFreshness; measurement: DeliveredMeasurement<D> | null; lastOwnerActivityAt: string | null; workerHealth: 'alive' | 'lost' | 'unknown'; cancellation: 'none' | 'pending'; resultRef?: string }>\",\n          \"parameters\": [\n            {\n              \"name\": \"task\",\n              \"type\": \"TaskRef\",\n              \"purpose\": \"Task identity looked up through the caller’s authorized binding.\",\n              \"optional\": false\n            }\n          ],\n          \"returns\": {\n            \"type\": \"ProgressSnapshot<D>\",\n            \"meaning\": \"One validated projection shared by reads and subscriptions.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"task-unavailable\",\n              \"condition\": \"Task missing, unauthorized or expired.\"\n            }\n          ],\n          \"preconditions\": [\n            \"IPC handler validates server-bound peer/session/project, capability and origin tuple. A matching request tuple alone grants nothing.\"\n          ],\n          \"postconditions\": [\n            \"Public snapshot omits internal owner, epoch, transport credentials, session IDs and raw log paths.\",\n            \"Cursor covers snapshot order while measurement revision covers progress change. Heartbeat, as-of reads and reconnect do not increment measurement revision.\"\n          ]\n        },\n        {\n          \"name\": \"ObservationReply\",\n          \"signature\": \"interface ObservationReply<D extends { readonly kind: ProgressKind }> { readonly snapshot: ProgressSnapshot<D>; readonly disposition: 'changed' | 'unchanged' | 'resync'; readonly schedule: 'native' | 'scheduled' | 'suspended' | 'stopped'; readonly nextPollNotBefore?: string; }\",\n          \"parameters\": [\n            {\n              \"name\": \"task\",\n              \"type\": \"TaskRef\",\n              \"purpose\": \"Authorized target.\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"cursor\",\n              \"type\": \"string\",\n              \"purpose\": \"Last applied scope-bound cursor.\",\n              \"optional\": true\n            },\n            {\n              \"name\": \"observer\",\n              \"type\": \"ObserverBinding\",\n              \"purpose\": \"Server-owned transport association and explicit fallback opt-in.\",\n              \"optional\": false\n            }\n          ],\n          \"returns\": {\n            \"type\": \"ObservationReply<D>\",\n            \"meaning\": \"Typed reply with compact details, change state and optional schedule hint.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"schedule-unavailable\",\n              \"condition\": \"Client has no scheduler or fallback lease is not owned.\"\n            },\n            {\n              \"type\": \"task-unavailable\",\n              \"condition\": \"Caller cannot observe the attempt.\"\n            }\n          ],\n          \"preconditions\": [\n            \"For fallback, coordinator admits one fenced lease per stable task. Subscribers without the lease can read the cached shared view but cannot claim a poll slot.\"\n          ],\n          \"postconditions\": [\n            \"Initial snapshot then one slot each 60 seconds on monotonic cadence, with no overlapping calls or catch-up bursts. Use wall time only for guidance. Transfer retains anchor, watermark and cursor. On process restart suspend fallback until fresh authorized opt-in and ownership are verified.\",\n            \"Replay serves cached last result. Unknown/foreign cursor cannot read another task; an expired authorized cursor receives resync.\"\n          ]\n        },\n        {\n          \"name\": \"ObservationControl\",\n          \"signature\": \"interface ObservationControl { readonly task: TaskRef; readonly action: 'stop-observation' | 'cancel-execution'; readonly requestId: string; }\",\n          \"parameters\": [\n            {\n              \"name\": \"request\",\n              \"type\": \"ObservationControl\",\n              \"purpose\": \"Explicit user-derived action with bounded idempotency key.\",\n              \"optional\": false\n            }\n          ],\n          \"returns\": {\n            \"type\": \"Promise<'stopped' | 'pending' | 'unsupported'>\",\n            \"meaning\": \"Observation detached, cancellation requested or unsupported.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"conflicting-request\",\n              \"condition\": \"Same scoped request ID with different action or attempt.\"\n            },\n            {\n              \"type\": \"task-unavailable\",\n              \"condition\": \"Caller lacks target or action authorization.\"\n            }\n          ],\n          \"preconditions\": [\n            \"Stop observation is scoped to the caller’s observer and releases its fallback lease. Cancel requires current attempt, supported control and executor cancellation capability.\"\n          ],\n          \"postconditions\": [\n            \"Persist cancel-pending before dispatch, key by task/attempt/requestId, and require idempotent owner request. Replays return the durable pending/outcome without a second dispatch. Restart surfaces pending for owner reconciliation and never replays it automatically.\",\n            \"Only verified termination can become cancelled. A race with normal completion keeps the executor’s verified terminal outcome.\"\n          ]\n        },\n        {\n          \"name\": \"TaskActivityLease\",\n          \"signature\": \"interface TaskActivityLease { readonly task: TaskRef; readonly origin: TaskOrigin; readonly fence: TaskOwnerFence; readonly renewedAt: string; readonly expiresAt: string; }\",\n          \"parameters\": [\n            {\n              \"name\": \"event\",\n              \"type\": \"VerifiedOwnerActivity\",\n              \"purpose\": \"Runtime-only owner handle, matching epoch and strictly advancing owner sequence.\",\n              \"optional\": false\n            }\n          ],\n          \"returns\": {\n            \"type\": \"TaskActivityLease | null\",\n            \"meaning\": \"One live association with the verified conversation, or none for an unbound task.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"stale-owner\",\n              \"condition\": \"Expired epoch, stale sequence or terminal attempt.\"\n            }\n          ],\n          \"preconditions\": [\n            \"Admission verifies originating association before detach. A replacement owner proves the executor still owns or actually resumed the execution.\"\n          ],\n          \"postconditions\": [\n            \"Runtime renewal every 30 seconds, lease expiry at 120 seconds; use monotonic time in process. No observer can grant activity or renew a lease. Release affects only this attempt.\"\n          ]\n        }\n      ]\n    },\n    \"dataModelChanges\": [\n      {\n        \"entity\": \"Task record and ownership\",\n        \"change\": \"new\",\n        \"details\": \"One registered project owns many invocation scopes. A verified invocation owns zero or more tasks. A task owns one current attempt and zero or more retained prior attempt summaries, and an attempt has at most one verified live owner epoch. The optional conversation binding belongs to one invocation and identifies one insrc conversation, which can own many invocations. Native and daemon session IDs are separately verified bindings and remain private. Reserve a fixed encoded record budget before returning observation admitted. Serialize mutations per stable task and arbitrate the reservation ledger globally, outside the per-task lock; never await delegate reads, transport sends or process cancellation under the lock. Reject unmatched duplicate registrations and make exact same-owner replays idempotent.\",\n        \"schemaDiff\": \"Versioned envelope: trusted origin, stable task key, current attempt and epoch, owner watermark, snapshot revision and meaningful revision, latest bounded snapshot, prior attempt summaries, terminal pointer and cancellation receipt.\",\n        \"callSites\": [\n          \"src/daemon/server.ts\",\n          \"src/daemon/steps/host.ts\",\n          \"src/daemon/threads/registry.ts\"\n        ]\n      },\n      {\n        \"entity\": \"Durable observation and bounded replay\",\n        \"change\": \"new\",\n        \"details\": \"Daemon-only directory under its state root, keyed by a hash of trusted project, invocation and task. Use mode 0700 on the directory and 0600 files, reject symlinks, use an exclusive temporary file on the same filesystem, flush file then rename then flush the directory before acknowledging durable transitions. Reuse the existing atomic-replacement pattern where it provides those guarantees, and add the missing flush and security steps at this boundary. Active state and milestones coalesce at one update per second per task, while owner admission, attempt rollover and terminal snapshots commit before publication. Compact snapshots to 8 KiB, cap milestones and prior summaries at 32 total, cap observer queues at 16 and reserve a terminal slot. Reserve enough disk for atomic replacement, cap 128 active and 1,024 retained terminal observations per project and 128 MiB globally. At capacity, evict eligible terminal records only and otherwise refuse observation visibly. Executor work continues. Terminal retention is seven days subject to bounded capacity. Persist neither raw reporter output nor unvalidated labels. Validate version, bounds and owner identity before adoption; quarantine corrupt records within the storage budget.\",\n        \"schemaDiff\": \"Cursor binds to task, attempt and committed observation revision. In-memory bounded feed resumes at the cursor when available; after gaps or restart use the latest snapshot and explicit resync. Durable milestones record measured changes rather than heartbeat events.\",\n        \"callSites\": [\n          \"src/workflow/storage.ts\",\n          \"src/daemon/steps/__tests__/fixtures/task-persistence.ts\"\n        ]\n      },\n      {\n        \"entity\": \"Runtime activity and fallback observer leases\",\n        \"change\": \"new\",\n        \"details\": \"An active attempt can hold at most one activity association to its originating insrc chat, and one chat can hold many associations. Only verified owner activity renews it. The current chat owner can read the scoped retention projection; the adapter and existing client status projection remain s5. Separately, a stable task has at most one fallback scheduling lease across attempts and any number of bounded native observers. Use monotonic slot and lease deadlines while alive and suspend fallback at daemon restart. Persist no scheduler credentials. On restart emit interrupted or unknown until the actual owner revalidates, mint a new owner epoch before accepting further events, and never auto-start work. Persisted terminal state remains authoritative. Conversation removal releases only that association and retains authorized project-scoped results.\",\n        \"schemaDiff\": \"Lease epoch, holder binding, monotonic schedule anchor, last slot, in-flight slot and cursor. Retention projection exposes task and expiry, not owner credentials.\",\n        \"callSites\": [\n          \"src/daemon/chat-sessions.ts\",\n          \"src/daemon/server.ts\"\n        ]\n      }\n    ],\n    \"interactionWithShared\": [\n      {\n        \"contractId\": \"sc1\",\n        \"role\": \"implements\",\n        \"howDetails\": \"Provide the common generic delegate, task identity and verified owner-fence invariants. Concrete executors and their detail schemas remain sibling-owned.\"\n      },\n      {\n        \"contractId\": \"sc2\",\n        \"role\": \"implements\",\n        \"howDetails\": \"Normalize, persist and authorize snapshots, subscription cursors, fallback schedule and explicit control. Additive IPC routing and authorization belong here; MCP/VS Code presentation belong to their own stories.\"\n      },\n      {\n        \"contractId\": \"sc3\",\n        \"role\": \"implements\",\n        \"howDetails\": \"Provide verified owner renewal and the read-only association projection. Native clients and the extension session adapter remain outside this story.\"\n      }\n    ],\n    \"errorPaths\": {\n      \"errorCases\": [\n        {\n          \"scenario\": \"Foreign or revoked observation\",\n          \"detection\": \"Trusted server binding fails project, invocation and current-attempt permission checks.\",\n          \"response\": \"Return task-unavailable with identical missing/unauthorized shape. Do not consult delegate or emit detail.\",\n          \"userImpact\": \"No cross-chat or cross-project disclosure.\",\n          \"recoverable\": false\n        },\n        {\n          \"scenario\": \"Old owner or malformed measurement\",\n          \"detection\": \"Owner handle, epoch, sequence, detail schema or serialized-size check fails, including after asynchronous refresh.\",\n          \"response\": \"Drop stale writes and preserve last verified measurement with stale or unavailable freshness if source is invalid. Never advance ownership or progress.\",\n          \"userImpact\": \"Last trusted state remains readable.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Disk commit or capacity reservation fails\",\n          \"detection\": \"Write, fsync, rename, validation or reserved-budget check fails.\",\n          \"response\": \"Do not publish an uncommitted terminal result. Mark observation degraded, preserve the old committed record, and reconcile against the same owner after recovery. Distinguish failures after rename by re-reading and verifying the durable record before retry.\",\n          \"userImpact\": \"Execution continues and can be inspected through its existing result path where available.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Daemon restarts with active records\",\n          \"detection\": \"Startup rehydrates valid envelopes with an owner epoch from a prior process.\",\n          \"response\": \"Retain the last verified measurement, mark interrupted or unknown, and fence previous callbacks. Resume observation only after owner proves survival or actual resumption. Preserve terminal state and reconcile pending cancellation without auto-dispatch.\",\n          \"userImpact\": \"A restart does not imply completion or relaunch.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Fallback transport loss or contention\",\n          \"detection\": \"Rate limit, expired lease, duplicate slot or disconnected holder.\",\n          \"response\": \"Publish suspended observation and preserve the shared cadence anchor when a supported holder recovers. Honor retry-after as degraded behavior and avoid overlapping calls or replay bursts.\",\n          \"userImpact\": \"Progress may be delayed and is visibly degraded.\",\n          \"recoverable\": true\n        }\n      ],\n      \"edgeCases\": [\n        {\n          \"input\": \"Heartbeat or repeated reads with equal measured progress\",\n          \"expected\": \"Only owner activity and freshness can change. Keep the same meaningful revision and original measurement age.\"\n        },\n        {\n          \"input\": \"Two authorized viewers, a lagged cursor, and terminal outcome during a full queue\",\n          \"expected\": \"One fallback scheduler at most. Coalesce and explicitly resync lagged observers. Terminal delivery uses reserved capacity and has one stable outcome.\"\n        },\n        {\n          \"input\": \"Older owner callback arrives after a newer attempt or task terminal\",\n          \"expected\": \"Reject by attempt and epoch, never resurrect retention or overwrite a terminal state.\"\n        },\n        {\n          \"input\": \"Stop updates races with cancel or normal completion\",\n          \"expected\": \"Detach only the observer. Explicit cancellation is pending until the verified outcome, and request replay cannot duplicate the side effect.\"\n        }\n      ],\n      \"invariantsToPreserve\": [\n        {\n          \"text\": \"Daemon owns state and scope. Keep typed Unix IPC and existing terminal execution semantics.\",\n          \"source\": \"c2\"\n        },\n        {\n          \"text\": \"Existing review trackers and session pool remain authoritative for their own evidence. Observation does not invoke models, alter workflows or imply native-session activity.\",\n          \"source\": \"c3\"\n        }\n      ]\n    },\n    \"testStrategy\": {\n      \"testFramework\": \"Node.js node:test with tsx, strict assertions, injected clocks and daemon IPC fixtures.\",\n      \"testLevels\": [\n        {\n          \"level\": \"unit\",\n          \"purpose\": \"Exercise ordering, scheduler ownership and controls with deterministic clocks.\",\n          \"subjects\": [\n            \"Fence async refresh, duplicate registration and old attempt callbacks\",\n            \"Verify monotonic 60-second fallback, transfer, suspension and unchanged suppression\",\n            \"Check stop, cancel replay and verified completion races\"\n          ],\n          \"fixturesNeeded\": [\n            \"Two fake owners and observers, clock control and delayed delegate reads.\"\n          ]\n        },\n        {\n          \"level\": \"integration\",\n          \"purpose\": \"Prove persisted terminal ordering and scope safety through normal daemon entry points.\",\n          \"subjects\": [\n            \"Recover bounded snapshots across storage failure, restart and owner revalidation\",\n            \"Reject cross-project and cross-conversation reads, controls and raw details\"\n          ],\n          \"fixturesNeeded\": [\n            \"Temporary daemon state directory, injectable write fault points, two registered fixture repos and an IPC client.\"\n          ]\n        },\n        {\n          \"level\": \"contract\",\n          \"purpose\": \"Preserve scope handoff and evidence from predecessor stories.\",\n          \"subjects\": [\n            \"Check July issue-to-story traceability without modifying tracker disposition\"\n          ],\n          \"fixturesNeeded\": [\n            \"Approved consolidated DEF and predecessor DEF with story links.\"\n          ]\n        }\n      ],\n      \"acceptanceMapping\": [\n        {\n          \"criterionId\": \"ac1\",\n          \"provingTests\": [\n            \"Fence async refresh, duplicate registration and old attempt callbacks\",\n            \"Verify monotonic 60-second fallback, transfer, suspension and unchanged suppression\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac2\",\n          \"provingTests\": [\n            \"Recover bounded snapshots across storage failure, restart and owner revalidation\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac3\",\n          \"provingTests\": [\n            \"Check stop, cancel replay and verified completion races\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac4\",\n          \"provingTests\": [\n            \"Reject cross-project and cross-conversation reads, controls and raw details\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac5\",\n          \"provingTests\": [\n            \"Check July issue-to-story traceability without modifying tracker disposition\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac6\",\n          \"provingTests\": [\n            \"Fence async refresh, duplicate registration and old attempt callbacks\",\n            \"Recover bounded snapshots across storage failure, restart and owner revalidation\"\n          ]\n        }\n      ]\n    },\n    \"migration\": {\n      \"stateBefore\": \"Existing IPC dispatch, review checkpoints and ChatSessionPool remain separate sources, as grounded in s1 context. There is no shared durable progress record.\",\n      \"stateAfter\": \"Daemon owns an additive bounded progress record and authorized observation contract. Existing executors and clients continue to work before sibling adapters are connected.\",\n      \"migrationSteps\": [\n        {\n          \"order\": 1,\n          \"action\": \"Initialize the private versioned observation namespace on first daemon start. Existing state remains untouched.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 2,\n          \"action\": \"Expose the additive foundation to registered consumers and validate recovery, lease fencing and fail-open execution using fixtures.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 3,\n          \"action\": \"On rollback remove the additive observation surface and leave its bounded records inert for a later compatible upgrade. Existing executor results and session records remain authoritative.\",\n          \"rollbackable\": true\n        }\n      ],\n      \"backwardCompat\": \"The Unix IPC protocol, current review checkpoints, executor outcomes and native session ownership are preserved. Old clients can ignore the additive surface.\",\n      \"zeroDowntime\": false,\n      \"dataRewriteRequired\": false\n    },\n    \"alternativesConsidered\": [\n      {\n        \"id\": \"a1\",\n        \"name\": \"Atomic bounded record per task\",\n        \"oneLineSummary\": \"One per-task record is the recovery authority for observation state.\",\n        \"approach\": \"Store one versioned envelope per task under the daemon state root, with a reserved bounded record budget. Serialize updates for a task, commit terminal state before publication, and rebuild in-memory cursors and expiry queues from the persisted records on startup.\",\n        \"pros\": [\n          \"No cross-file transaction is needed for an attempt transition, current snapshot and retained milestones.\",\n          \"Recovery enumerates at most the reserved capacity and needs no event replay.\"\n        ],\n        \"cons\": [\n          \"A persisted update replaces the bounded record and needs explicit write coalescing.\"\n        ],\n        \"costEstimate\": \"M\"\n      },\n      {\n        \"id\": \"a2\",\n        \"name\": \"Split snapshot and bounded milestone journal\",\n        \"oneLineSummary\": \"Maintain separate bounded checkpoint and milestone files per task.\",\n        \"approach\": \"Keep a compact current snapshot file plus a capped append journal for meaningful milestones. A shared revision lets recovery discard a journal suffix that was not committed with the snapshot.\",\n        \"pros\": [\n          \"Milestones can be appended without rewriting earlier milestone contents.\"\n        ],\n        \"cons\": [\n          \"Snapshot and journal require two-file recovery and can lose otherwise valid suffixes after a crash.\"\n        ],\n        \"costEstimate\": \"L\",\n        \"reasonRejected\": \"A split journal needs an additional recovery protocol to keep the snapshot and history consistent.\"\n      }\n    ],\n    \"chosenAlternative\": \"a1\",\n    \"openQuestions\": [],\n    \"sequenceDefinition\": {\n      \"id\": \"s1-progress-commit-recovery\",\n      \"narrative\": \"The coordinator verifies execution authority before committing a snapshot. Restart recovers the last committed state and never infers live ownership or relaunches work.\",\n      \"participants\": [\n        {\n          \"id\": \"owner\",\n          \"label\": \"Executor owner\",\n          \"description\": \"Sends verified facts and owns execution.\"\n        },\n        {\n          \"id\": \"coordinator\",\n          \"label\": \"Coordinator\",\n          \"description\": \"Verifies scope, attempts and owner epochs.\"\n        },\n        {\n          \"id\": \"disk\",\n          \"label\": \"Task record\",\n          \"description\": \"Bounded atomic observation record.\"\n        },\n        {\n          \"id\": \"reader\",\n          \"label\": \"Observer\",\n          \"description\": \"Consumes authorized snapshots.\"\n        }\n      ],\n      \"messages\": [\n        {\n          \"from\": \"owner\",\n          \"to\": \"coordinator\",\n          \"label\": \"Register before detach\",\n          \"description\": \"Bind trusted origin and reserve the bounded record.\",\n          \"kind\": \"call\"\n        },\n        {\n          \"from\": \"coordinator\",\n          \"to\": \"disk\",\n          \"label\": \"Commit attempt and fence\",\n          \"description\": \"Persist the current attempt before admitting observation.\",\n          \"kind\": \"call\"\n        },\n        {\n          \"from\": \"reader\",\n          \"to\": \"coordinator\",\n          \"label\": \"Read or subscribe with cursor\",\n          \"description\": \"Authorize caller and resolve the task binding.\",\n          \"kind\": \"call\"\n        },\n        {\n          \"from\": \"coordinator\",\n          \"to\": \"reader\",\n          \"label\": \"Return snapshot or resync\",\n          \"description\": \"Use the same sanitized snapshot model for every observer.\",\n          \"kind\": \"return\"\n        },\n        {\n          \"from\": \"owner\",\n          \"to\": \"coordinator\",\n          \"label\": \"Confirm terminal outcome\",\n          \"description\": \"Reject stale owner epochs and publish no unverified result.\",\n          \"kind\": \"call\"\n        },\n        {\n          \"from\": \"coordinator\",\n          \"to\": \"disk\",\n          \"label\": \"Commit terminal snapshot\",\n          \"description\": \"Finish the durable write before notifying readers.\",\n          \"kind\": \"call\"\n        },\n        {\n          \"from\": \"coordinator\",\n          \"to\": \"reader\",\n          \"label\": \"Deliver terminal snapshot\",\n          \"description\": \"Use reserved terminal capacity and keep execution outcome stable.\",\n          \"kind\": \"call\"\n        },\n        {\n          \"from\": \"coordinator\",\n          \"to\": \"disk\",\n          \"label\": \"Load records after restart\",\n          \"description\": \"Recover only validated committed snapshots and receipts.\",\n          \"kind\": \"call\"\n        },\n        {\n          \"from\": \"reader\",\n          \"to\": \"coordinator\",\n          \"label\": \"Reattach after restart\",\n          \"description\": \"Authorize again. Active execution stays unknown or interrupted until reverified.\",\n          \"kind\": \"call\"\n        },\n        {\n          \"from\": \"owner\",\n          \"to\": \"coordinator\",\n          \"label\": \"Revalidate a surviving attempt\",\n          \"description\": \"Mint a new epoch before further progress or retention updates.\",\n          \"kind\": \"call\"\n        }\n      ]\n    },\n    \"companions\": [\n      {\n        \"kind\": \"diagram-mermaid\",\n        \"relPath\": \"docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/sequence-diagram.html\",\n        \"title\": \"Sequence diagram\"\n      }\n    ]\n  },\n  \"citations\": [\n    {\n      \"id\": \"c1\",\n      \"kind\": \"prior-artifact\",\n      \"ref\": \"docs/epics/show-long-running-task-progress-chat-E20261109206db342/HLD.md\"\n    },\n    {\n      \"id\": \"c2\",\n      \"kind\": \"analyze-bundle\",\n      \"ref\": \"s1 structural map of IpcServer, TargetRegistry and trusted request scope\"\n    },\n    {\n      \"id\": \"c3\",\n      \"kind\": \"analyze-bundle\",\n      \"ref\": \"s1 structural map of ChatSessionPool and review checkpoint ownership\"\n    },\n    {\n      \"id\": \"c4\",\n      \"kind\": \"prior-artifact\",\n      \"ref\": \"docs/epics/show-long-running-task-progress-chat-E20261109206db342/DEF.md\"\n    },\n    {\n      \"id\": \"c5\",\n      \"kind\": \"doc\",\n      \"ref\": \"docs/epics/show-long-running-task-progress-chat-E20261109206db342/er-model.html\"\n    },\n    {\n      \"id\": \"c6\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/server.ts\"\n    },\n    {\n      \"id\": \"c7\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/threads/registry.ts\"\n    },\n    {\n      \"id\": \"c8\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/steps/host.ts\"\n    },\n    {\n      \"id\": \"c9\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/chat-sessions.ts\"\n    },\n    {\n      \"id\": \"c10\",\n      \"kind\": \"code\",\n      \"ref\": \"src/workflow/storage.ts\"\n    },\n    {\n      \"id\": \"c11\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/steps/__tests__/fixtures/task-persistence.ts\"\n    },\n    {\n      \"id\": \"c12\",\n      \"kind\": \"code\",\n      \"ref\": \"src/workflow/code-review/task-review/progress.ts\"\n    },\n    {\n      \"id\": \"c13\",\n      \"kind\": \"code\",\n      \"ref\": \"src/workflow/review/design-review/progress.ts\"\n    },\n    {\n      \"id\": \"c14\",\n      \"kind\": \"code\",\n      \"ref\": \"src/shared/types.ts\"\n    }\n  ]\n}\n","document":"<!-- insrc:artifact LLD-206db3426ffd4428-s1 -->\n\n# LLD: STORY-206db3426ffd4428-s1 — Track long-running work consistently across executors\n\n## Summary\n\n**Epic:** `show-long-running-task-progress-chat`\n**HLD base run:** `wf-1794211533808-ghbhlu`\n**HLD effective hash:** `48a6a5468b45...`\n\nThe daemon foundation keeps each task tied to its verified executor and originating conversation. It stores bounded observations, exposes one authorized snapshot model, and recovers state after restart. Executor activity and optional polling run on separate schedules.\n\n## Contents\n\n1. [HLD context](#1-hld-context)\n2. [Contract details](#2-contract-details)\n3. [Data model changes](#3-data-model-changes)\n4. [Diagrams](#4-diagrams)\n5. [Interaction with shared contracts](#5-interaction-with-shared-contracts)\n6. [Error paths](#6-error-paths)\n7. [Test strategy](#7-test-strategy)\n8. [Migration](#8-migration)\n9. [Alternatives considered](#9-alternatives-considered)\n10. [References](#10-references)\n\n## 1. HLD context\n\n> See **HLD-206db3426ffd4428** § 2. Framework summary\n\n**Rollout phase:** Phase A — daemon observation foundation\n**Owns:** `sc1` (Task identity and delegate observation), `sc2` (Scoped snapshots, subscriptions and observation control), `sc3` (Execution-owned activity and chat retention)\n\n**Adjacent scope (owned by other stories — do NOT implement here):**\n- `s2`: Own adapters for existing workflow and analyze producer signals and terminal/owner evidence. Existing stream shape and command semantics remain compatible. — owns `sc4`\n- `s3`: Own DesignReviewDelegate and CodeReviewDelegate and mappings from checkpoint progress and execution ownership. Review results, admission, retries and publication remain under the existing engines. — owns `sc5`\n- `s4`: Own TestDelegate and managed reporter interpretation, including suite/case identity, provisional counts and abnormal exit. Keep test orchestration and exit semantics unchanged. — owns `sc6`\n- `s5`: Own typed VS Code reader and transcript row, current status projection and bindings to the session owner. Render durable snapshots by origin across turns and multiple windows without executing or polling models.\n- `s6`: Own MCP adapter, capability qualification, explicit opt-in disclosure and connection to the coordinator's fallback lease. No vendor-specific process changes or assumptions about session identity.\n\n## 2. Contract details\n\n**Surface level:** internal-shared\n\n### 2.1 `TaskProgressDelegate`\n\n```typescript\ninterface TaskProgressDelegate<D extends { readonly kind: ProgressKind }> { progress(task: TaskRef): Promise<DelegateMeasurement<D> | null>; }\n```\n\n**Parameters:**\n- `task: TaskRef` — Server-issued project, invocation, task and attempt tuple.\n\n**Returns:** `Promise<DelegateMeasurement<D> | null>` — Bounded producer details or unavailable.\n\n**Errors:**\n- `invalid-source` when Measurement fails validation or source is unreachable.\n\n**Preconditions:**\n- Bind a delegate and runtime-only owner handle to the registered invocation before detaching.\n\n**Postconditions:**\n- No execution, model, cancellation or lease side effects.\n- Read results are revalidated against current attempt and epoch after await.\n\n### 2.2 `ProgressSnapshot`\n\n```typescript\ntype ProgressSnapshot<D extends { readonly kind: ProgressKind }> = Readonly<{ task: TaskRef; cursor: string; state: TaskState; freshness: ProgressFreshness; measurement: DeliveredMeasurement<D> | null; lastOwnerActivityAt: string | null; workerHealth: 'alive' | 'lost' | 'unknown'; cancellation: 'none' | 'pending'; resultRef?: string }>\n```\n\n**Parameters:**\n- `task: TaskRef` — Task identity looked up through the caller’s authorized binding.\n\n**Returns:** `ProgressSnapshot<D>` — One validated projection shared by reads and subscriptions.\n\n**Errors:**\n- `task-unavailable` when Task missing, unauthorized or expired.\n\n**Preconditions:**\n- IPC handler validates server-bound peer/session/project, capability and origin tuple. A matching request tuple alone grants nothing.\n\n**Postconditions:**\n- Public snapshot omits internal owner, epoch, transport credentials, session IDs and raw log paths.\n- Cursor covers snapshot order while measurement revision covers progress change. Heartbeat, as-of reads and reconnect do not increment measurement revision.\n\n### 2.3 `ObservationReply`\n\n```typescript\ninterface ObservationReply<D extends { readonly kind: ProgressKind }> { readonly snapshot: ProgressSnapshot<D>; readonly disposition: 'changed' | 'unchanged' | 'resync'; readonly schedule: 'native' | 'scheduled' | 'suspended' | 'stopped'; readonly nextPollNotBefore?: string; }\n```\n\n**Parameters:**\n- `task: TaskRef` — Authorized target.\n- `cursor: string` _(optional)_ — Last applied scope-bound cursor.\n- `observer: ObserverBinding` — Server-owned transport association and explicit fallback opt-in.\n\n**Returns:** `ObservationReply<D>` — Typed reply with compact details, change state and optional schedule hint.\n\n**Errors:**\n- `schedule-unavailable` when Client has no scheduler or fallback lease is not owned.\n- `task-unavailable` when Caller cannot observe the attempt.\n\n**Preconditions:**\n- For fallback, coordinator admits one fenced lease per stable task. Subscribers without the lease can read the cached shared view but cannot claim a poll slot.\n\n**Postconditions:**\n- Initial snapshot then one slot each 60 seconds on monotonic cadence, with no overlapping calls or catch-up bursts. Use wall time only for guidance. Transfer retains anchor, watermark and cursor. On process restart suspend fallback until fresh authorized opt-in and ownership are verified.\n- Replay serves cached last result. Unknown/foreign cursor cannot read another task; an expired authorized cursor receives resync.\n\n### 2.4 `ObservationControl`\n\n```typescript\ninterface ObservationControl { readonly task: TaskRef; readonly action: 'stop-observation' | 'cancel-execution'; readonly requestId: string; }\n```\n\n**Parameters:**\n- `request: ObservationControl` — Explicit user-derived action with bounded idempotency key.\n\n**Returns:** `Promise<'stopped' | 'pending' | 'unsupported'>` — Observation detached, cancellation requested or unsupported.\n\n**Errors:**\n- `conflicting-request` when Same scoped request ID with different action or attempt.\n- `task-unavailable` when Caller lacks target or action authorization.\n\n**Preconditions:**\n- Stop observation is scoped to the caller’s observer and releases its fallback lease. Cancel requires current attempt, supported control and executor cancellation capability.\n\n**Postconditions:**\n- Persist cancel-pending before dispatch, key by task/attempt/requestId, and require idempotent owner request. Replays return the durable pending/outcome without a second dispatch. Restart surfaces pending for owner reconciliation and never replays it automatically.\n- Only verified termination can become cancelled. A race with normal completion keeps the executor’s verified terminal outcome.\n\n### 2.5 `TaskActivityLease`\n\n```typescript\ninterface TaskActivityLease { readonly task: TaskRef; readonly origin: TaskOrigin; readonly fence: TaskOwnerFence; readonly renewedAt: string; readonly expiresAt: string; }\n```\n\n**Parameters:**\n- `event: VerifiedOwnerActivity` — Runtime-only owner handle, matching epoch and strictly advancing owner sequence.\n\n**Returns:** `TaskActivityLease | null` — One live association with the verified conversation, or none for an unbound task.\n\n**Errors:**\n- `stale-owner` when Expired epoch, stale sequence or terminal attempt.\n\n**Preconditions:**\n- Admission verifies originating association before detach. A replacement owner proves the executor still owns or actually resumed the execution.\n\n**Postconditions:**\n- Runtime renewal every 30 seconds, lease expiry at 120 seconds; use monotonic time in process. No observer can grant activity or renew a lease. Release affects only this attempt.\n\n## 3. Data model changes\n\n### 3.1 `Task record and ownership` — new\n\nOne registered project owns many invocation scopes. A verified invocation owns zero or more tasks. A task owns one current attempt and zero or more retained prior attempt summaries, and an attempt has at most one verified live owner epoch. The optional conversation binding belongs to one invocation and identifies one insrc conversation, which can own many invocations. Native and daemon session IDs are separately verified bindings and remain private. Reserve a fixed encoded record budget before returning observation admitted. Serialize mutations per stable task and arbitrate the reservation ledger globally, outside the per-task lock; never await delegate reads, transport sends or process cancellation under the lock. Reject unmatched duplicate registrations and make exact same-owner replays idempotent.\n\n```\nVersioned envelope: trusted origin, stable task key, current attempt and epoch, owner watermark, snapshot revision and meaningful revision, latest bounded snapshot, prior attempt summaries, terminal pointer and cancellation receipt.\n```\n\n**Call sites:**\n- `src/daemon/server.ts`\n- `src/daemon/steps/host.ts`\n- `src/daemon/threads/registry.ts`\n\n### 3.2 `Durable observation and bounded replay` — new\n\nDaemon-only directory under its state root, keyed by a hash of trusted project, invocation and task. Use mode 0700 on the directory and 0600 files, reject symlinks, use an exclusive temporary file on the same filesystem, flush file then rename then flush the directory before acknowledging durable transitions. Reuse the existing atomic-replacement pattern where it provides those guarantees, and add the missing flush and security steps at this boundary. Active state and milestones coalesce at one update per second per task, while owner admission, attempt rollover and terminal snapshots commit before publication. Compact snapshots to 8 KiB, cap milestones and prior summaries at 32 total, cap observer queues at 16 and reserve a terminal slot. Reserve enough disk for atomic replacement, cap 128 active and 1,024 retained terminal observations per project and 128 MiB globally. At capacity, evict eligible terminal records only and otherwise refuse observation visibly. Executor work continues. Terminal retention is seven days subject to bounded capacity. Persist neither raw reporter output nor unvalidated labels. Validate version, bounds and owner identity before adoption; quarantine corrupt records within the storage budget.\n\n```\nCursor binds to task, attempt and committed observation revision. In-memory bounded feed resumes at the cursor when available; after gaps or restart use the latest snapshot and explicit resync. Durable milestones record measured changes rather than heartbeat events.\n```\n\n**Call sites:**\n- `src/workflow/storage.ts`\n- `src/daemon/steps/__tests__/fixtures/task-persistence.ts`\n\n### 3.3 `Runtime activity and fallback observer leases` — new\n\nAn active attempt can hold at most one activity association to its originating insrc chat, and one chat can hold many associations. Only verified owner activity renews it. The current chat owner can read the scoped retention projection; the adapter and existing client status projection remain s5. Separately, a stable task has at most one fallback scheduling lease across attempts and any number of bounded native observers. Use monotonic slot and lease deadlines while alive and suspend fallback at daemon restart. Persist no scheduler credentials. On restart emit interrupted or unknown until the actual owner revalidates, mint a new owner epoch before accepting further events, and never auto-start work. Persisted terminal state remains authoritative. Conversation removal releases only that association and retains authorized project-scoped results.\n\n```\nLease epoch, holder binding, monotonic schedule anchor, last slot, in-flight slot and cursor. Retention projection exposes task and expiry, not owner credentials.\n```\n\n**Call sites:**\n- `src/daemon/chat-sessions.ts`\n- `src/daemon/server.ts`\n\n## 4. Diagrams\n\n- [Sequence diagram](docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/sequence-diagram.html)\n\n## 5. Interaction with shared contracts\n\n| Contract | Role | How |\n| :--- | :--- | :--- |\n| `sc1` | implements | Provide the common generic delegate, task identity and verified owner-fence invariants. Concrete executors and their detail schemas remain sibling-owned. |\n| `sc2` | implements | Normalize, persist and authorize snapshots, subscription cursors, fallback schedule and explicit control. Additive IPC routing and authorization belong here; MCP/VS Code presentation belong to their own stories. |\n| `sc3` | implements | Provide verified owner renewal and the read-only association projection. Native clients and the extension session adapter remain outside this story. |\n\n## 6. Error paths\n\n**Error cases**\n\n- **Foreign or revoked observation** (terminal)\n  - Detection: Trusted server binding fails project, invocation and current-attempt permission checks.\n  - Response: Return task-unavailable with identical missing/unauthorized shape. Do not consult delegate or emit detail.\n  - User impact: No cross-chat or cross-project disclosure.\n- **Old owner or malformed measurement** (recoverable)\n  - Detection: Owner handle, epoch, sequence, detail schema or serialized-size check fails, including after asynchronous refresh.\n  - Response: Drop stale writes and preserve last verified measurement with stale or unavailable freshness if source is invalid. Never advance ownership or progress.\n  - User impact: Last trusted state remains readable.\n- **Disk commit or capacity reservation fails** (recoverable)\n  - Detection: Write, fsync, rename, validation or reserved-budget check fails.\n  - Response: Do not publish an uncommitted terminal result. Mark observation degraded, preserve the old committed record, and reconcile against the same owner after recovery. Distinguish failures after rename by re-reading and verifying the durable record before retry.\n  - User impact: Execution continues and can be inspected through its existing result path where available.\n- **Daemon restarts with active records** (recoverable)\n  - Detection: Startup rehydrates valid envelopes with an owner epoch from a prior process.\n  - Response: Retain the last verified measurement, mark interrupted or unknown, and fence previous callbacks. Resume observation only after owner proves survival or actual resumption. Preserve terminal state and reconcile pending cancellation without auto-dispatch.\n  - User impact: A restart does not imply completion or relaunch.\n- **Fallback transport loss or contention** (recoverable)\n  - Detection: Rate limit, expired lease, duplicate slot or disconnected holder.\n  - Response: Publish suspended observation and preserve the shared cadence anchor when a supported holder recovers. Honor retry-after as degraded behavior and avoid overlapping calls or replay bursts.\n  - User impact: Progress may be delayed and is visibly degraded.\n\n**Edge cases**\n\n| Input | Expected |\n| :--- | :--- |\n| Heartbeat or repeated reads with equal measured progress | Only owner activity and freshness can change. Keep the same meaningful revision and original measurement age. |\n| Two authorized viewers, a lagged cursor, and terminal outcome during a full queue | One fallback scheduler at most. Coalesce and explicitly resync lagged observers. Terminal delivery uses reserved capacity and has one stable outcome. |\n| Older owner callback arrives after a newer attempt or task terminal | Reject by attempt and epoch, never resurrect retention or overwrite a terminal state. |\n| Stop updates races with cancel or normal completion | Detach only the observer. Explicit cancellation is pending until the verified outcome, and request replay cannot duplicate the side effect. |\n\n**Invariants to preserve**\n\n- Daemon owns state and scope. Keep typed Unix IPC and existing terminal execution semantics. [[c2]]\n- Existing review trackers and session pool remain authoritative for their own evidence. Observation does not invoke models, alter workflows or imply native-session activity. [[c3]]\n\n## 7. Test strategy\n\n**Test framework:** `Node.js node:test with tsx, strict assertions, injected clocks and daemon IPC fixtures.`\n\n**Test levels**\n\n- **unit** — Exercise ordering, scheduler ownership and controls with deterministic clocks.\n  - Subjects: `Fence async refresh, duplicate registration and old attempt callbacks`, `Verify monotonic 60-second fallback, transfer, suspension and unchanged suppression`, `Check stop, cancel replay and verified completion races`\n  - Fixtures: `Two fake owners and observers, clock control and delayed delegate reads.`\n- **integration** — Prove persisted terminal ordering and scope safety through normal daemon entry points.\n  - Subjects: `Recover bounded snapshots across storage failure, restart and owner revalidation`, `Reject cross-project and cross-conversation reads, controls and raw details`\n  - Fixtures: `Temporary daemon state directory, injectable write fault points, two registered fixture repos and an IPC client.`\n- **contract** — Preserve scope handoff and evidence from predecessor stories.\n  - Subjects: `Check July issue-to-story traceability without modifying tracker disposition`\n  - Fixtures: `Approved consolidated DEF and predecessor DEF with story links.`\n\n**Acceptance mapping**\n\n| Criterion | Proving tests |\n| :--- | :--- |\n| `ac1` | `Fence async refresh, duplicate registration and old attempt callbacks`, `Verify monotonic 60-second fallback, transfer, suspension and unchanged suppression` |\n| `ac2` | `Recover bounded snapshots across storage failure, restart and owner revalidation` |\n| `ac3` | `Check stop, cancel replay and verified completion races` |\n| `ac4` | `Reject cross-project and cross-conversation reads, controls and raw details` |\n| `ac5` | `Check July issue-to-story traceability without modifying tracker disposition` |\n| `ac6` | `Fence async refresh, duplicate registration and old attempt callbacks`, `Recover bounded snapshots across storage failure, restart and owner revalidation` |\n\n## 8. Migration\n\n**State before:** Existing IPC dispatch, review checkpoints and ChatSessionPool remain separate sources, as grounded in s1 context. There is no shared durable progress record.\n\n**State after:** Daemon owns an additive bounded progress record and authorized observation contract. Existing executors and clients continue to work before sibling adapters are connected.\n\n**Zero downtime:** no — **Data rewrite:** no\n\n**Steps**\n\n1. Initialize the private versioned observation namespace on first daemon start. Existing state remains untouched. — ↩ rollbackable\n2. Expose the additive foundation to registered consumers and validate recovery, lease fencing and fail-open execution using fixtures. — ↩ rollbackable\n3. On rollback remove the additive observation surface and leave its bounded records inert for a later compatible upgrade. Existing executor results and session records remain authoritative. — ↩ rollbackable\n\n**Backward compat:** The Unix IPC protocol, current review checkpoints, executor outcomes and native session ownership are preserved. Old clients can ignore the additive surface.\n\n## 9. Alternatives considered\n\n### 9.1 a1: Atomic bounded record per task — **CHOSEN**\n\nOne per-task record is the recovery authority for observation state.\n\nStore one versioned envelope per task under the daemon state root, with a reserved bounded record budget. Serialize updates for a task, commit terminal state before publication, and rebuild in-memory cursors and expiry queues from the persisted records on startup.\n\n### 9.2 a2: Split snapshot and bounded milestone journal\n\nMaintain separate bounded checkpoint and milestone files per task.\n\nKeep a compact current snapshot file plus a capped append journal for meaningful milestones. A shared revision lets recovery discard a journal suffix that was not committed with the snapshot.\n\n**Rejected because:** A split journal needs an additional recovery protocol to keep the snapshot and history consistent.\n\n## 10. References\n\n- **[[c1]]** `prior-artifact` `docs/epics/show-long-running-task-progress-chat-E20261109206db342/HLD.md`\n- **[[c2]]** `analyze-bundle` `s1 structural map of IpcServer, TargetRegistry and trusted request scope`\n- **[[c3]]** `analyze-bundle` `s1 structural map of ChatSessionPool and review checkpoint ownership`\n- **[[c4]]** `prior-artifact` `docs/epics/show-long-running-task-progress-chat-E20261109206db342/DEF.md`\n- **[[c5]]** `doc` `docs/epics/show-long-running-task-progress-chat-E20261109206db342/er-model.html`\n- **[[c6]]** `code` `src/daemon/server.ts`\n- **[[c7]]** `code` `src/daemon/threads/registry.ts`\n- **[[c8]]** `code` `src/daemon/steps/host.ts`\n- **[[c9]]** `code` `src/daemon/chat-sessions.ts`\n- **[[c10]]** `code` `src/workflow/storage.ts`\n- **[[c11]]** `code` `src/daemon/steps/__tests__/fixtures/task-persistence.ts`\n- **[[c12]]** `code` `src/workflow/code-review/task-review/progress.ts`\n- **[[c13]]** `code` `src/workflow/review/design-review/progress.ts`\n- **[[c14]]** `code` `src/shared/types.ts`\n"},"capturedAt":"2026-11-09T09:40:28.342Z"},"inventory":{"units":[{"id":"/body/summary","selector":"/body/summary","title":"summary","kind":"section"},{"id":"/body/hldContextSlice","selector":"/body/hldContextSlice","title":"hldContextSlice","kind":"section"},{"id":"/body/contractDetails","selector":"/body/contractDetails","title":"contractDetails","kind":"section"},{"id":"/body/dataModelChanges","selector":"/body/dataModelChanges","title":"dataModelChanges","kind":"section"},{"id":"/body/interactionWithShared","selector":"/body/interactionWithShared","title":"interactionWithShared","kind":"section"},{"id":"/body/errorPaths","selector":"/body/errorPaths","title":"errorPaths","kind":"section"},{"id":"/body/testStrategy","selector":"/body/testStrategy","title":"testStrategy","kind":"section"},{"id":"/body/migration","selector":"/body/migration","title":"migration","kind":"section"},{"id":"/body/alternativesConsidered","selector":"/body/alternativesConsidered","title":"alternativesConsidered","kind":"section"},{"id":"/body/chosenAlternative","selector":"/body/chosenAlternative","title":"chosenAlternative","kind":"section"},{"id":"/body/openQuestions","selector":"/body/openQuestions","title":"openQuestions","kind":"section"},{"id":"/body/sequenceDefinition","selector":"/body/sequenceDefinition","title":"sequenceDefinition","kind":"visual"},{"id":"/body/companions","selector":"/body/companions","title":"companions","kind":"visual"},{"id":"/body/hldContextSlice/ownedContracts/0","selector":"/body/hldContextSlice/ownedContracts/0","title":"sc1","kind":"contract"},{"id":"/body/hldContextSlice/ownedContracts/1","selector":"/body/hldContextSlice/ownedContracts/1","title":"sc2","kind":"contract"},{"id":"/body/hldContextSlice/ownedContracts/2","selector":"/body/hldContextSlice/ownedContracts/2","title":"sc3","kind":"contract"},{"id":"/body/alternativesConsidered/0","selector":"/body/alternativesConsidered/0","title":"a1","kind":"requirement"},{"id":"/body/alternativesConsidered/1","selector":"/body/alternativesConsidered/1","title":"a2","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/0","selector":"/body/sequenceDefinition/participants/0","title":"owner","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/1","selector":"/body/sequenceDefinition/participants/1","title":"coordinator","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/2","selector":"/body/sequenceDefinition/participants/2","title":"disk","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/3","selector":"/body/sequenceDefinition/participants/3","title":"reader","kind":"requirement"},{"id":"/citations/0","selector":"/citations/0","title":"Citation 1","kind":"citation"},{"id":"/citations/1","selector":"/citations/1","title":"Citation 2","kind":"citation"},{"id":"/citations/2","selector":"/citations/2","title":"Citation 3","kind":"citation"},{"id":"/citations/3","selector":"/citations/3","title":"Citation 4","kind":"citation"},{"id":"/citations/4","selector":"/citations/4","title":"Citation 5","kind":"citation"},{"id":"/citations/5","selector":"/citations/5","title":"Citation 6","kind":"citation"},{"id":"/citations/6","selector":"/citations/6","title":"Citation 7","kind":"citation"},{"id":"/citations/7","selector":"/citations/7","title":"Citation 8","kind":"citation"},{"id":"/citations/8","selector":"/citations/8","title":"Citation 9","kind":"citation"},{"id":"/citations/9","selector":"/citations/9","title":"Citation 10","kind":"citation"},{"id":"/citations/10","selector":"/citations/10","title":"Citation 11","kind":"citation"},{"id":"/citations/11","selector":"/citations/11","title":"Citation 12","kind":"citation"},{"id":"/citations/12","selector":"/citations/12","title":"Citation 13","kind":"citation"},{"id":"/citations/13","selector":"/citations/13","title":"Citation 14","kind":"citation"},{"id":"document:line:26","selector":"document:line:26","title":"1. HLD context","kind":"section"},{"id":"document:line:191","selector":"document:line:191","title":"4. Diagrams","kind":"section"},{"id":"document:line:195","selector":"document:line:195","title":"5. Interaction with shared contracts","kind":"section"}]},"completedChunks":[{"chunkId":"contracts","status":"changes_requested","summary":"The assigned scope, cardinalities, sibling responsibilities and fencing invariants align with the DEF and HLD. Two contract gaps remain: establishing trusted authorization bindings and defining the producer-to-coordinator ownership interface.","findings":[{"id":"contracts-01","severity":"MED","location":"docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/LLD.md:80","message":"Authorization assumes a server-bound peer/session/project/origin tuple without specifying how ordinary IPC callers establish it or recover it after reconnect/restart. Current TrustedRpcContext provides connection identity and optional specialized connection sessions; the normal step host accepts cwd/envRepo/client from request parameters, and TargetRegistry routes by self-reported label/pid. These do not establish conversation ownership. Define trusted binding admission, authorized reattachment, revocation and project-history access after conversation removal, including which daemon component verifies each association. Otherwise the implementation must invent the security boundary required by s1/ac4.","evidenceReferences":["docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/LLD.md:79-84","docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/LLD.md:156","docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/LLD.md:181","docs/epics/show-long-running-task-progress-chat-E20261109206db342/DEF.md:story s1/ac4","src/daemon/request-context.ts:12-24","src/daemon/server.ts:connectionContext and validClient","src/daemon/steps/host.ts:contextOf","src/daemon/threads/registry.ts:35-40"]},{"id":"contracts-02","severity":"MED","location":"docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/LLD.md:44","message":"The shared producer interface specifies only progress(task), while ownership registration is merely a precondition. No contract defines admission inputs/results, owner-handle issuance, attempt rollover/revalidation, detail-validator registration, refresh signaling, or delivery of verified lifecycle/terminal evidence. DelegateMeasurement contains no lifecycle or terminal-result fields, so its only defined method cannot supply ProgressSnapshot.state or resultRef. The cancellation executor hook is also unspecified. Define the common owner/coordinator operations and their fencing/error semantics so s2–s4 can implement adapters against s1 without independently inventing incompatible ownership and lifecycle channels.","evidenceReferences":[".insrc/artifacts/LLD-206db3426ffd4428-s1.json:/body/hldContextSlice/ownedContracts/0/interfaceSketch",".insrc/artifacts/LLD-206db3426ffd4428-s1.json:/body/contractDetails/api","docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/LLD.md:59","docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/LLD.md:68","docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/LLD.md:129","docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/LLD.md:147","docs/epics/show-long-running-task-progress-chat-E20261109206db342/HLD.md:Architecture shape","docs/epics/show-long-running-task-progress-chat-E20261109206db342/HLD.md:Story boundaries s1–s4","src/daemon/steps/host.ts:StepToolRunner and createStepCallHandler","src/daemon/review-request-owner.ts:registerLocalReviewOwner"]}],"inspectedReferences":["/body/summary","/body/hldContextSlice","/body/hldContextSlice/ownedContracts/0","/body/contractDetails","/body/dataModelChanges","/body/interactionWithShared","/body/errorPaths","/citations/0","/citations/1","/citations/3","/citations/4","/citations/5","/citations/6","/citations/7","/citations/13","document:line:26","document:line:195","/Users/subhagho/work/projects/insors/insrc/docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-206db3426ffd4428-s1.json","docs/epics/show-long-running-task-progress-chat-E20261109206db342/DEF.md","docs/epics/show-long-running-task-progress-chat-E20261109206db342/HLD.md","docs/epics/show-long-running-task-progress-chat-E20261109206db342/er-model.html:embedded relationship definition","docs/epics/show-long-running-task-progress-chat-E20261109206db342/review-evidence/er-model.png:actual rendering","docs/standalone/show-background-task-progress-chat-E2026110407024f1d/SPEC.md:R1–R17","src/daemon/server.ts","src/daemon/request-context.ts","src/daemon/threads/registry.ts","src/daemon/threads/router.ts:dispatch and send","src/daemon/steps/host.ts","src/daemon/review-request-owner.ts","src/shared/types.ts:IPC and progress contracts"],"limitations":[],"advice":["Replace citation c2's descriptive structural-map label with a retrievable bundle identifier or concrete source references."]},{"chunkId":"durability","status":"incomplete","summary":"The bounded per-task record approach supports atomic transitions, terminal publication ordering and fenced recovery. One capacity-recovery gap remains. Sequence source and generated content were inspected, but its actual rendering could not be verified.","findings":[{"id":"durability-01","severity":"MED","location":"docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/LLD.md:169","message":"Storage reclamation covers terminal records only, while restart recovery can retain unknown attempts indefinitely without a returning owner. No transition defines when those records release active reservations, which quota subsequently owns them, or when their disk reservations expire. After repeated owner losses, unrevalidated records can exhaust active capacity or the global budget permanently because terminal-only eviction cannot reclaim them. Define bounded retention and reservation release for unrevalidated attempts, preserving an explicit unknown/expired outcome and rejecting late callbacks. Include a restart-and-capacity test proving that observation admission recovers without inventing execution termination.","evidenceReferences":[".insrc/artifacts/LLD-206db3426ffd4428-s1.json:/body/dataModelChanges/1",".insrc/artifacts/LLD-206db3426ffd4428-s1.json:/body/dataModelChanges/2","docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/LLD.md:219","docs/epics/show-long-running-task-progress-chat-E20261109206db342/HLD.md:7. Non-functional targets","docs/epics/show-long-running-task-progress-chat-E20261109206db342/DEF.md:s1/ac6"]}],"inspectedReferences":["/body/dataModelChanges","/body/contractDetails","/body/errorPaths","/body/alternativesConsidered","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/chosenAlternative","/body/sequenceDefinition","/body/sequenceDefinition/participants/0","/body/sequenceDefinition/participants/1","/body/sequenceDefinition/participants/2","/body/sequenceDefinition/participants/3","/body/companions","/citations/4","/citations/9","/citations/10","document:line:191","/Users/subhagho/work/projects/insors/insrc/docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-206db3426ffd4428-s1.json","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/consolidated-chat-progress-s1-lld.json","docs/epics/show-long-running-task-progress-chat-E20261109206db342/DEF.md","docs/epics/show-long-running-task-progress-chat-E20261109206db342/HLD.md","docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/sequence-diagram.html:Mermaid source, narrative and message descriptions","docs/epics/show-long-running-task-progress-chat-E20261109206db342/er-model.html:relationship source","docs/epics/show-long-running-task-progress-chat-E20261109206db342/review-evidence/er-model.png:actual rendering","docs/epics/show-long-running-task-progress-chat-E20261109206db342/review-evidence/visual-verification.md","src/workflow/storage.ts:writeAtomic","src/daemon/steps/__tests__/fixtures/task-persistence.ts","docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/LLD.md:242"],"limitations":["Actual rendering of /body/sequenceDefinition and its /body/companions entry, docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/sequence-diagram.html, could not be inspected: the browser access host was unavailable, and no capture of this S001 companion was present. The available sequence capture documents the separate HLD companion. Source/content consistency was inspected, but visual verification remains incomplete."],"advice":["Separate terminal recovery from surviving-active-attempt recovery in the sequence narrative or diagram. Its current linear sequence delivers a terminal outcome and later revalidates a surviving attempt without identifying an alternate path or another task.","Clarify that citation c11 demonstrates temporary-session persistence exclusion, rather than crash-safe progress persistence. The proposed injected storage-failure fixtures must establish the latter independently."]},{"chunkId":"observation","status":"changes_requested","summary":"The observation, cancellation and activity invariants broadly align with the DEF and HLD. Observer isolation, durable cancel-pending ordering, verified terminal outcomes and separate activity clocks are preserved. The fallback scheduler contract remains insufficiently specified for its downstream adapter.","findings":[{"id":"observation-01","severity":"MED","location":"docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/LLD.md:86","message":"Define the coordinator's observer and fallback-lease protocol. ObservationReply is a response shape with an undefined ObserverBinding parameter; no operation specifies how a consumer attaches, claims or renews scheduler ownership, claims a cadence slot, completes an in-flight slot, or transfers ownership. The record lists lease fields, but supplies neither a bounded scheduler lease lifetime nor renewal/expiry transitions. Consequently, s6 must invent how a disconnected holder becomes replaceable and how replies from its outstanding poll are rejected after transfer—the HLD explicitly requires both fencing and preservation of cadence. Specify request/result and error shapes, server-owned binding lifecycle, bounded expiry, transfer/in-flight fencing and terminal shutdown, then cover those transitions with deterministic clock tests. Concrete MCP presentation remains s6-owned.","evidenceReferences":["docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/LLD.md:92","docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/LLD.md:104","docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/LLD.md:107","docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/LLD.md:181","docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/LLD.md:184","docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/LLD.md:223","docs/epics/show-long-running-task-progress-chat-E20261109206db342/HLD.md:41","docs/epics/show-long-running-task-progress-chat-E20261109206db342/DEF.md:k5","src/daemon/server.ts:261"]}],"inspectedReferences":["/body/hldContextSlice/ownedContracts/1","/body/hldContextSlice/ownedContracts/2","/body/contractDetails","/body/dataModelChanges","/body/interactionWithShared","/body/errorPaths","/citations/2","/citations/5","/citations/8","/citations/11","/citations/12","document:line:195","/Users/subhagho/work/projects/insors/insrc/docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-206db3426ffd4428-s1.json","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/consolidated-chat-progress-s1-lld.json","docs/epics/show-long-running-task-progress-chat-E20261109206db342/DEF.md","docs/epics/show-long-running-task-progress-chat-E20261109206db342/HLD.md","docs/standalone/show-background-task-progress-chat-E2026110407024f1d/SPEC.md:R1–R16 and acceptance requirements","docs/epics/show-long-running-task-progress-chat-E20261109206db342/er-model.html:relationship source and descriptions","docs/epics/show-long-running-task-progress-chat-E20261109206db342/review-evidence/er-model.png:actual rendering","docs/epics/show-long-running-task-progress-chat-E20261109206db342/review-evidence/visual-verification.md:matching ER source hash","src/daemon/server.ts:trusted connection context and disconnect lifecycle","src/daemon/request-context.ts","src/daemon/chat-sessions.ts","src/daemon/review-request-owner.ts","src/workflow/code-review/task-review/progress.ts","src/workflow/review/design-review/progress.ts","src/workflow/review/design-review/coordinator.ts:owner, activity and execution fencing","src/workflow/code-review/task-review/controller.ts:activity validation and exchange ordering","src/workflow/review/design-review/__tests__/checkpoint-progress.test.ts","src/workflow/code-review/task-review/__tests__/progress.test.ts"],"limitations":[],"advice":["Replace citation c3's descriptive structural-map label with a retrievable evidence reference. The cited session-pool and review-ownership claims were independently checked against current code."]},{"chunkId":"validation","status":"changes_requested","summary":"All assigned sections and citations were inspected. The additive rollout and sibling dependency ordering align with the HLD. The validation design lacks explicit coverage for activity expiry and capacity boundaries, and its predecessor traceability fixture assumes links absent from the cited documents.","findings":[{"id":"validation-01","severity":"MED","location":"docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/LLD.md:247","message":"The proposed tests do not cover the foundation's activity-association lifecycle or its capacity boundaries. No subject verifies 30-second renewal and 120-second expiry without observers, rejection of observer-driven renewal, independent associations for multiple tasks, or conversation removal releasing only its association. Likewise, 'Recover bounded snapshots' does not specify saturation assertions for active/terminal/global reservations, full observer queues with terminal delivery, or admission failure preserving execution. These are explicit s1-owned correctness requirements, rather than client qualification work. Add deterministic lifecycle and boundary tests with expected outcomes, including late activity after expiry and visible observation refusal without cancelling or blocking the executor.","evidenceReferences":[".insrc/artifacts/LLD-206db3426ffd4428-s1.json:/body/testStrategy","docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/LLD.md:2.5 TaskActivityLease","docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/LLD.md:3.2 Durable observation and bounded replay","docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/LLD.md:3.3 Runtime activity and fallback observer leases","docs/epics/show-long-running-task-progress-chat-E20261109206db342/HLD.md:7. Non-functional targets","src/daemon/chat-sessions.ts:155"]},{"id":"validation-02","severity":"MED","location":"docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/LLD.md:254","message":"The ac5 proving test assumes a 'predecessor DEF with story links', but the actual predecessor DEF identifies S001–S003 without their tracker links, and the consolidated DEF only names #42–#44 collectively. The LLD supplies neither a concrete source-to-successor mapping nor a step to create the required traceability. Consequently, checking the two declared fixtures cannot establish the required identification and preservation of all three predecessor story records. Specify the traceability deliverable and assertions using the existing S001/#42, S002/#43 and S003/#44 records, map their requirements to successor scope, and preserve tracker disposition.","evidenceReferences":[".insrc/artifacts/LLD-206db3426ffd4428-s1.json:/body/testStrategy/testLevels/2","docs/epics/show-long-running-task-progress-chat-E20261109206db342/DEF.md:STORY-206db3426ffd4428-s1/ac5","docs/epics/show-long-running-task-progress-chat-E20261109206db342/DEF.md:k9","docs/epics/stream-incremental-progress-from-daemon-calling-E202607196d6cfaf9/DEF.md:Stories","docs/epics/stream-incremental-progress-from-daemon-calling-E202607196d6cfaf9/S001/LLD.md:8","docs/epics/stream-incremental-progress-from-daemon-calling-E202607196d6cfaf9/S002/LLD.md:8","docs/epics/stream-incremental-progress-from-daemon-calling-E202607196d6cfaf9/S003/LLD.md:8"]}],"inspectedReferences":["/body/testStrategy","/body/migration","/body/openQuestions","/body/errorPaths","/citations/0","/citations/3","/citations/10","/Users/subhagho/work/projects/insors/insrc/docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-206db3426ffd4428-s1.json","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/consolidated-chat-progress-s1-lld.json","docs/epics/show-long-running-task-progress-chat-E20261109206db342/DEF.md","docs/epics/show-long-running-task-progress-chat-E20261109206db342/HLD.md","docs/epics/stream-incremental-progress-from-daemon-calling-E202607196d6cfaf9/DEF.md","docs/epics/stream-incremental-progress-from-daemon-calling-E202607196d6cfaf9/S001/LLD.md:tracker header","docs/epics/stream-incremental-progress-from-daemon-calling-E202607196d6cfaf9/S002/LLD.md:tracker header","docs/epics/stream-incremental-progress-from-daemon-calling-E202607196d6cfaf9/S003/LLD.md:tracker header","src/daemon/steps/__tests__/fixtures/task-persistence.ts","src/daemon/request-context.ts","src/daemon/server.ts:connection identity and request delivery lifecycle","src/daemon/chat-sessions.ts","src/workflow/storage.ts:writeAtomic","src/shared/types.ts:IpcStreamKind and progress contracts","docs/epics/show-long-running-task-progress-chat-E20261109206db342/review-evidence/visual-verification.md"],"limitations":[],"advice":["Expand storage-fault assertions to distinguish failures before rename from directory-flush failures, and verify that no uncommitted terminal result is delivered. Citation c11 tests temporary-session persistence exclusion; it does not already provide crash-durability evidence.","Add a compatibility fixture exercising an existing client with observation unused or unavailable, asserting unchanged frames, final results and cancellation behavior."]},{"chunkId":"consistency","status":"incomplete","summary":"All four substantive chunks completed, and their inspection declarations cover every inventory unit. The current canonical artifact and live document match the checkpoint baseline. Story ownership, cardinalities, sibling dependencies and additive rollout align with the DEF/HLD. No additional cross-chunk defect was identified beyond the recorded findings. Mandatory visual verification of the S001 sequence companion remains incomplete.","findings":[],"inspectedReferences":["/Users/subhagho/work/projects/insors/insrc/docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/consolidated-chat-progress-s1-lld.json","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-206db3426ffd4428-s1.json","docs/epics/show-long-running-task-progress-chat-E20261109206db342/DEF.md","docs/epics/show-long-running-task-progress-chat-E20261109206db342/HLD.md","docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/sequence-diagram.html:embedded sequence, narrative and message descriptions","docs/epics/show-long-running-task-progress-chat-E20261109206db342/er-model.html:relationship source","docs/epics/show-long-running-task-progress-chat-E20261109206db342/review-evidence/er-model.png:actual rendering","docs/epics/show-long-running-task-progress-chat-E20261109206db342/review-evidence/visual-verification.md","src/daemon/request-context.ts:TrustedRpcContext","src/daemon/chat-sessions.ts:session status and idle cleanup"],"limitations":["Actual rendering of docs/epics/show-long-running-task-progress-chat-E20261109206db342/S001/sequence-diagram.html remains unverified, as recorded by the durability chunk. Its source and generated content were inspected, but no S001 rendering capture is available; the existing sequence capture belongs to t