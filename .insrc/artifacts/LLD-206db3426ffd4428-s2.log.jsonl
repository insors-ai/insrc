173376	{"artifactId":"LLD-206db3426ffd4428-s2","entry":{"id":"f3cb3630efa76e92a4789091308696a589750b2a709d14d57d5de6b864b5f2ee","targetHeadHash":"0f2267085341079c27530497aebb1f7e9abe9b5635dce5e33cab1c686dbd3ab2","actor":{"id":"agent:design-review-daemon","kind":"agent","properties":{"party":"daemon"}},"timestamp":"2026-11-09T20:17:47.720Z","operation":"review","revision":{"number":1,"contentHash":"5f40f524997013fa3040331c0b28c8f8460230ea358f1717f07717590a20c93c"},"outcome":{"result":"pass","summary":"Design review task-progress-workflow-analysis-s2-lld attempt 2","data":{"kind":"design-chunk-review","schemaVersion":1,"reviewId":"task-progress-workflow-analysis-s2-lld","project":"/Users/subhagho/work/projects/insors/insrc","artifactId":"LLD-206db3426ffd4428-s2","subject":{"project":"/Users/subhagho/work/projects/insors/insrc","artifactId":"LLD-206db3426ffd4428-s2","kind":"LLD","canonicalPath":"/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-206db3426ffd4428-s2.json","documentPath":"/Users/subhagho/work/projects/insors/insrc/docs/epics/show-long-running-task-progress-chat-E20261109206db342/S002/LLD.md","reviewer":"daemon","workflow":{"kind":"epic","rootArtifactId":"DEF-206db3426ffd4428","requiredReferences":[{"role":"definition","artifactId":"DEF-206db3426ffd4428","path":"/Users/subhagho/work/projects/insors/insrc/docs/epics/show-long-running-task-progress-chat-E20261109206db342/DEF.md"},{"role":"hld","artifactId":"HLD-206db3426ffd4428","path":"/Users/subhagho/work/projects/insors/insrc/docs/epics/show-long-running-task-progress-chat-E20261109206db342/HLD.md"}],"availableReferences":[],"notApplicableRoles":["PLAN","TASKS","BUILD","CR"]}},"submitted":{"artifactPath":"/Users/subhagho/work/projects/insors/insrc/docs/epics/show-long-running-task-progress-chat-E20261109206db342/S002/LLD.md","attempt":1},"reviewer":"daemon","attempts":[{"number":1,"status":"incomplete","preparationKind":"planning","baseline":{"subjectFingerprints":{"canonical":"a44ac6360e3f2b0bc681dc8a851a19a89aaa09e8aee5c15dfcd1794530fa9823","document":"56c303ca99173dfec567dfda2da5a3facf682aa22a1c07c61a656d95914bb843"},"contentIdentity":"839d349d92ba8536000ea78f7abd3fdc7e0edb37dde48d5587758f253b90d396","reviewedContent":{"canonical":"{\n  \"meta\": {\n    \"workflow\": \"design.story\",\n    \"runId\": \"wf-1794254425999-ht2ypo\",\n    \"repoPath\": \"/Users/subhagho/work/projects/insors/insrc\",\n    \"createdAt\": \"2026-11-09T20:03:28.224Z\",\n    \"attribution\": {\n      \"outputs\": [\n        {\n          \"role\": \"(client)\",\n          \"tier\": \"core\",\n          \"runner\": \"cli-codex\",\n          \"model\": \"unknown\"\n        }\n      ]\n    },\n    \"elapsedMs\": 181867,\n    \"repoIndexedAt\": null,\n    \"schemaVersion\": 1,\n    \"epicCreatedAt\": \"2026-11-09T06:00:04.355Z\",\n    \"epicHash\": \"206db3426ffd4428\",\n    \"epicSlug\": \"show-long-running-task-progress-chat\",\n    \"storyId\": \"s2\",\n    \"hldBaseRunId\": \"wf-1794211533808-ghbhlu\",\n    \"hldEffectiveHash\": \"48a6a5468b45d758c2f607734dcbfdf65a0d1476d8c409eeed1ac09aa037dec9\",\n    \"hldAmendmentsApplied\": [],\n    \"storyTitle\": \"Preserve live progress for workflows and analysis\",\n    \"authoredBy\": \"controller\",\n    \"lifecycle\": {\n      \"status\": \"draft\",\n      \"revision\": {\n        \"number\": 1,\n        \"contentHash\": \"5f40f524997013fa3040331c0b28c8f8460230ea358f1717f07717590a20c93c\",\n        \"at\": \"2026-11-09T20:03:28.375Z\",\n        \"by\": {\n          \"id\": \"insrc:system\",\n          \"kind\": \"system\",\n          \"properties\": {}\n        }\n      },\n      \"signoffs\": []\n    },\n    \"revision\": 1\n  },\n  \"body\": {\n    \"summary\": {\n      \"audience\": \"technical\",\n      \"prose\": \"Workflow and analysis executors feed structured measurements to the daemon coordinator through run-owned delegates. Existing streams, detached workflow polls, and analysis results keep their current contracts. Progress reports a stage even when the producer cannot measure output.\"\n    },\n    \"hldContextSlice\": {\n      \"frameworkSummary\": \"Use executor delegates with a shared daemon coordinator. Preserve legacy workflow and analyze IPC frames and existing execution authority. The coordinator feeds a typed VS Code adapter, request-scoped MCP notifications and one optional fallback observation schedule.\",\n      \"ownedContracts\": [\n        {\n          \"id\": \"sc4\",\n          \"name\": \"Workflow and analysis measurements\",\n          \"purpose\": \"Maps supported existing stage/delta data into task details while preserving the old frame and result channel. Use measured output production only when a producer supports it, retaining its declared unit. No text enters progress. The two delivery stories consume the mapped details.\",\n          \"interfaceSketch\": \"interface WorkflowDetails {\\n  readonly kind: 'workflow';\\n  readonly stageId: string;\\n  readonly stagePosition: MeasuredCount | null;\\n  readonly production: MeasuredCount | null;\\n}\\ninterface AnalysisDetails {\\n  readonly kind: 'analysis';\\n  readonly stageId: string;\\n  readonly stagePosition: MeasuredCount | null;\\n  readonly production: MeasuredCount | null;\\n}\",\n          \"ownedByStory\": \"s2\",\n          \"consumedByStories\": [\n            \"s5\",\n            \"s6\"\n          ],\n          \"assumptions\": [\n            \"c4\",\n            \"c5\"\n          ]\n        }\n      ],\n      \"consumedContracts\": [\n        {\n          \"id\": \"sc1\",\n          \"name\": \"Task identity and delegate observation\",\n          \"purpose\": \"One verified owner binds each task attempt to one project and originating invocation. An insrc chat may own many invocations, and an invocation may launch many tasks. Each task has one current attempt, with at most one active owner epoch. External host, daemon session and extension chat identities are optional distinct bindings, never inferred from one another. Both delivery paths use this delegate snapshot. The foundation is parameterized by producer-owned detail types, so it has no type dependency on later stories.\",\n          \"interfaceSketch\": \"interface TaskRef {\\n  readonly projectId: string;\\n  readonly invocationId: string;\\n  readonly taskId: string;\\n  readonly attempt: number;\\n}\\ninterface TaskOwnerFence {\\n  readonly ownerId: string;\\n  readonly ownerEpoch: string;\\n  readonly ownerSequence: number;\\n}\\ninterface TaskOrigin {\\n  readonly extensionChatId?: string;\\n  readonly daemonSessionId?: string;\\n  readonly nativeSessionId?: string;\\n  readonly turnId?: string;\\n}\\ntype ProgressKind = 'workflow' | 'analysis' | 'design-review' | 'code-review' | 'test';\\ninterface MeasuredCount {\\n  readonly unit: string;\\n  readonly completed: number;\\n  readonly total: number | null;\\n}\\ninterface DelegateMeasurement<Details extends { readonly kind: ProgressKind }> {\\n  readonly task: TaskRef;\\n  readonly owner: TaskOwnerFence;\\n  readonly kind: ProgressKind;\\n  readonly measuredAt: string;\\n  readonly meaningfulRevision: number;\\n  readonly lastMeaningfulAt: string | null;\\n  readonly phase: string;\\n  readonly activeUnit: string | null;\\n  readonly counts: readonly MeasuredCount[];\\n  readonly milestones: readonly string[];\\n  readonly controls: readonly ('cancel')[];\\n  readonly details: Details;\\n}\\ninterface TaskProgressDelegate<Details extends { readonly kind: ProgressKind }> {\\n  progress(task: TaskRef): Promise<DelegateMeasurement<Details> | null>;\\n}\",\n          \"ownedByStory\": \"s1\",\n          \"consumedByStories\": [\n            \"s2\",\n            \"s3\",\n            \"s4\",\n            \"s5\",\n            \"s6\"\n          ],\n          \"assumptions\": [\n            \"c3\",\n            \"c4\",\n            \"c5\",\n            \"c7\"\n          ]\n        },\n        {\n          \"id\": \"sc2\",\n          \"name\": \"Scoped snapshots, subscriptions and observation control\",\n          \"purpose\": \"The daemon authorizes every operation against server-verified caller/project/origin bindings, including logs and controls. A read yields a compact snapshot, meaningful-change indicator and revision cursor. Observer loss, executor state and session retention are independent. The shared coordinator arbitrates one optional fallback schedule per task, independent of all native subscriptions. Owner credentials, internal session identifiers and fencing fields remain server-side. A structured fallback lease governs the scheduler, without granting execution authority.\",\n          \"interfaceSketch\": \"type TaskState = 'queued' | 'running' | 'waiting' | 'paused' | 'completed' | 'failed' | 'cancelled' | 'interrupted' | 'unknown';\\ntype ProgressFreshness = 'live' | 'stale' | 'unavailable';\\ntype DeliveredMeasurement<Details extends { readonly kind: ProgressKind }> = Omit<DelegateMeasurement<Details>, 'owner'>;\\ninterface ProgressSnapshot<Details extends { readonly kind: ProgressKind }> {\\n  readonly task: TaskRef;\\n  readonly cursor: string;\\n  readonly state: TaskState;\\n  readonly freshness: ProgressFreshness;\\n  readonly measurement: DeliveredMeasurement<Details> | null;\\n  readonly lastOwnerActivityAt: string | null;\\n  readonly workerHealth: 'alive' | 'lost' | 'unknown';\\n  readonly cancellation: 'none' | 'pending';\\n  readonly resultRef?: string;\\n}\\ninterface ObservationReply<Details extends { readonly kind: ProgressKind }> {\\n  readonly snapshot: ProgressSnapshot<Details>;\\n  readonly disposition: 'changed' | 'unchanged' | 'resync';\\n  readonly schedule: 'native' | 'scheduled' | 'suspended' | 'stopped';\\n  readonly nextPollNotBefore?: string;\\n}\\ninterface ObservationControl {\\n  readonly task: TaskRef;\\n  readonly action: 'stop-observation' | 'cancel-execution';\\n  readonly requestId: string;\\n}\",\n          \"ownedByStory\": \"s1\",\n          \"consumedByStories\": [\n            \"s2\",\n            \"s3\",\n            \"s4\",\n            \"s5\",\n            \"s6\"\n          ],\n          \"assumptions\": [\n            \"c3\",\n            \"c6\",\n            \"c7\"\n          ]\n        },\n        {\n          \"id\": \"sc3\",\n          \"name\": \"Execution-owned activity and chat retention\",\n          \"purpose\": \"One current owned attempt may hold at most one active association for its originating insrc conversation. Each chat may have many associations. The coordinator renews through verified executor activity, and the actual session owner consumes the lease or a runtime renewal. View closure does not release a retained conversation. Removing a conversation releases only its association and retains project-scoped authorized task results.\",\n          \"interfaceSketch\": \"interface TaskActivityLease {\\n  readonly task: TaskRef;\\n  readonly origin: TaskOrigin;\\n  readonly fence: TaskOwnerFence;\\n  readonly renewedAt: string;\\n  readonly expiresAt: string;\\n}\\ninterface ChatTaskRetention {\\n  readonly originatingChatId: string;\\n  readonly retainedTasks: readonly { task: TaskRef; expiresAt: string }[];\\n}\",\n          \"ownedByStory\": \"s1\",\n          \"consumedByStories\": [\n            \"s2\",\n            \"s3\",\n            \"s4\",\n            \"s5\"\n          ],\n          \"assumptions\": [\n            \"c3\"\n          ]\n        }\n      ],\n      \"boundary\": {\n        \"storyId\": \"s2\",\n        \"owns\": [\n          \"sc4\"\n        ],\n        \"depends\": [\n          \"sc1\",\n          \"sc2\",\n          \"sc3\"\n        ],\n        \"internal\": \"Own adapters for existing workflow and analyze producer signals and terminal/owner evidence. Existing stream shape and command semantics remain compatible.\"\n      },\n      \"adjacentBoundaries\": [\n        {\n          \"storyId\": \"s1\",\n          \"owns\": [\n            \"sc1\",\n            \"sc2\",\n            \"sc3\"\n          ],\n          \"depends\": [],\n          \"internal\": \"Own daemon coordination, verified registration, cursors, normalization, scoped read/subscribe/control, durable state, owner fencing and fallback schedule arbitration. Keep storage, fencing and expiry implementation private.\"\n        },\n        {\n          \"storyId\": \"s3\",\n          \"owns\": [\n            \"sc5\"\n          ],\n          \"depends\": [\n            \"sc1\",\n            \"sc2\",\n            \"sc3\"\n          ],\n          \"internal\": \"Own DesignReviewDelegate and CodeReviewDelegate and mappings from checkpoint progress and execution ownership. Review results, admission, retries and publication remain under the existing engines.\"\n        },\n        {\n          \"storyId\": \"s4\",\n          \"owns\": [\n            \"sc6\"\n          ],\n          \"depends\": [\n            \"sc1\",\n            \"sc2\",\n            \"sc3\"\n          ],\n          \"internal\": \"Own TestDelegate and managed reporter interpretation, including suite/case identity, provisional counts and abnormal exit. Keep test orchestration and exit semantics unchanged.\"\n        },\n        {\n          \"storyId\": \"s5\",\n          \"owns\": [],\n          \"depends\": [\n            \"sc1\",\n            \"sc2\",\n            \"sc3\",\n            \"sc4\",\n            \"sc5\",\n            \"sc6\"\n          ],\n          \"internal\": \"Own typed VS Code reader and transcript row, current status projection and bindings to the session owner. Render durable snapshots by origin across turns and multiple windows without executing or polling models.\"\n        },\n        {\n          \"storyId\": \"s6\",\n          \"owns\": [],\n          \"depends\": [\n            \"sc1\",\n            \"sc2\",\n            \"sc4\",\n            \"sc5\",\n            \"sc6\"\n          ],\n          \"internal\": \"Own MCP adapter, capability qualification, explicit opt-in disclosure and connection to the coordinator's fallback lease. No vendor-specific process changes or assumptions about session identity.\"\n        }\n      ],\n      \"rolloutPhase\": \"Phase B — executor measurement adapters\",\n      \"nonFunctional\": {\n        \"performance\": \"Proposed caps for qualification are one coalesced active snapshot per second per task, 8 KiB per snapshot, 32 retained meaningful milestones, 16 queued observer updates and a reserved terminal state. Enforce per-project limits of 128 tracked active observations and 1,024 retained terminal observations, plus a global disk budget of 128 MiB. Exceeding observation capacity must report degradation without refusing, cancelling or slowing work. Terminal updates bypass normal coalescing. Reserve the observation terminal slot and bounded storage on admission. Evict only older terminal entries by policy, and refuse new observation with a capacity state when no reservation is possible. Do not evict active owners to admit new observations.\",\n        \"security\": \"Authenticate observations via existing daemon caller identity and verify project, conversation/invocation and task attempt before returning any snapshot, detail or control. Opaque cursors and task IDs do not grant authorization. Persist and expose sanitized structured measurements only. Detailed logs remain authorized, bounded references. No direct database access in MCP or VS Code.\",\n        \"observability\": \"Measure emitted and coalesced progress, cursor gaps, scheduler degradation, stale source age, rejected owner fences and retention transitions separately. Qualify each producer end to end, verify zero extra model invocations for native paths, and live-qualify CLI token, rendering, background lifetime and scheduling per version/session. Never log raw prompts, output or credentials as progress.\",\n        \"durability\": \"Use daemon-owned atomic per-task snapshots on local storage, with bounded milestone records and terminal result pointers. Persist terminal state before delivery. Refresh verified owner activity every 30 seconds with a 120-second lease, qualifying the margin against the actual session owner's idle threshold. After daemon restart recover persisted observations before accepting new owner events. Hold stale owner retention at most through its bounded grace and show interrupted or unknown until authority is reverified. Terminal retention is seven days subject to bounded capacity, after which separately available executor results remain authoritative. For executors without durable result history, expiry is explicit and is never rendered as a success, cancellation or new execution.\"\n      }\n    },\n    \"contractDetails\": {\n      \"surfaceLevel\": \"internal-shared\",\n      \"api\": [\n        {\n          \"name\": \"TaskProgressDelegate\",\n          \"signature\": \"interface TaskProgressDelegate<D> { progress(task: TaskRef, signal?: AbortSignal): Promise<DelegateMeasurement<D> | null> }\",\n          \"parameters\": [\n            {\n              \"name\": \"task\",\n              \"type\": \"TaskRef\",\n              \"purpose\": \"Fence lookup to the admitted attempt.\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"signal\",\n              \"type\": \"AbortSignal\",\n              \"purpose\": \"Stop the observation read.\",\n              \"optional\": true\n            }\n          ],\n          \"returns\": {\n            \"type\": \"Promise<DelegateMeasurement<D> | null>\",\n            \"meaning\": \"Latest sanitized snapshot or null when no observation exists.\"\n          },\n          \"errors\": [],\n          \"preconditions\": [\n            \"Task was admitted through the trusted S1 producer port.\"\n          ],\n          \"postconditions\": [\n            \"The read is bounded and does not perform producer work.\"\n          ]\n        }\n      ]\n    },\n    \"dataModelChanges\": [\n      {\n        \"entity\": \"WorkflowDetails\",\n        \"change\": \"new\",\n        \"details\": \"One optional current snapshot per owned workflow attempt, pointing from the S1 task to an executor-local measurement. stageId comes from the internal phase allowlist, with a validated step or runner identifier as activeUnit. stagePosition is null because the legacy index counts events, including retries, and is not completion. production is a run-cumulative count of actual provider deltas with unit output-chunks and null total. Existing tokensTotal counts callbacks, so label tokens only when a provider explicitly supplies a verified token count. Track detached deltas without adding frames to the legacy poll.\",\n        \"callSites\": [\n          \"src/daemon/workflow-rpc.ts\",\n          \"src/daemon/workflow-run-registry.ts\"\n        ]\n      },\n      {\n        \"entity\": \"AnalysisDetails\",\n        \"change\": \"new\",\n        \"details\": \"One optional current snapshot per owned analyze attempt. Use allowlisted typed stage and task transition data, and report unknown stagePosition unless a same-plan completed count is available. Production is null on the current analysis preview route. No preview text, labels, prompts, tool messages or arbitrary payload fields cross into progress.\",\n        \"callSites\": [\n          \"src/daemon/analyze-rpc.ts\"\n        ]\n      }\n    ],\n    \"interactionWithShared\": [\n      {\n        \"contractId\": \"sc1\",\n        \"role\": \"consumes\",\n        \"howDetails\": \"Once per actual run use the trusted producer port and launch authorization, a daemon-created execution key and the admitted fence. Use main daemon as sole owner of the S1 runtime. Session workers send bounded typed measurements and lifecycle through a private hub relay keyed to the actual worker channel and run. The coordinator-side delegate reads an in-memory mirror. Never accept an origin, owner epoch or opaque handle from public params. In-process route uses the same port without a hub hop.\"\n      },\n      {\n        \"contractId\": \"sc2\",\n        \"role\": \"consumes\",\n        \"howDetails\": \"Register workflow and analysis projectors and matching closed validators in the runtime. Keep public stream, poll and status payloads unchanged. Start observation independently of legacy delivery. Observation admission, writer failures and slow consumers never block the legacy terminal path. Owner-side result settlement is the terminal evidence. Supply a safe result handle only where an existing authorized result lookup exists.\"\n      },\n      {\n        \"contractId\": \"sc3\",\n        \"role\": \"consumes\",\n        \"howDetails\": \"Check live execution via the real run owner and its worker channel even when the producer is quiet. Use server-verified origin bindings only. Loss of observer does not renew or end ownership. End the observed attempt exactly once at owner settlement or classify verified owner loss as interrupted, preserving the S1 lease policy.\"\n      },\n      {\n        \"contractId\": \"sc4\",\n        \"role\": \"implements\",\n        \"howDetails\": \"Separate workflow/analysis detail discriminants use the same stage, optional measured position and optional declared-unit production fields. The daemon observes workflow.run and detached workflow.run.start, and analyze.run.start. Controller step calls and nested grounding are not independently registered as complete daemon-owned runs.\"\n      }\n    ],\n    \"errorPaths\": {\n      \"errorCases\": [\n        {\n          \"scenario\": \"Progress admission or persistence fails.\",\n          \"detection\": \"Producer port rejects or throws, relay closes, or reservation is refused.\",\n          \"response\": \"Disable or degrade that run's progress observation; isolate the rejection from execution and preserve the existing result path. Retry only an exact terminal write under the same fence as S1 permits.\",\n          \"userImpact\": \"Legacy operation continues. No fabricated successful progress is published.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Worker owner exits or a stale worker sends an update.\",\n          \"detection\": \"Worker channel closure or mismatch with the bound worker, run, attempt or strictly ordered sequence.\",\n          \"response\": \"Reject stale frames. Use verified worker loss for interruption when no prior terminal evidence exists; keep a previously persisted terminal state.\",\n          \"userImpact\": \"An interrupted owner is distinguishable from a quiet stage.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Untrusted or missing origin.\",\n          \"detection\": \"Trusted project resolution or S1 origin binding validation fails.\",\n          \"response\": \"Do not mint a conversation grant. Never infer a chat from a client-supplied ID, run ID, socket or session label. Continue legacy execution.\",\n          \"userImpact\": \"Run remains usable via its existing path.\",\n          \"recoverable\": false\n        }\n      ],\n      \"edgeCases\": [\n        {\n          \"input\": \"Quiet stage or provider without count evidence.\",\n          \"expected\": \"Keep stage stable; production is null until evidence exists. Verified owner liveness is separate from meaningful progress.\"\n        },\n        {\n          \"input\": \"Cancellation request races with successful settlement.\",\n          \"expected\": \"Pending cancellation is not terminal. Workflow detached uses its existing final status; analysis uses the typed aborted result; a verified successful completion remains successful.\"\n        },\n        {\n          \"input\": \"Legacy streaming client disconnects or detached poll stops.\",\n          \"expected\": \"Preserve existing stream-abort semantics and detached-run lifetime. Only owner evidence determines progress terminal state.\"\n        },\n        {\n          \"input\": \"An analysis preview token or a workflow retry carries arbitrary text.\",\n          \"expected\": \"Legacy handling stays byte-compatible. No text is copied into the new measurement.\"\n        },\n        {\n          \"input\": \"Legacy execution settles before asynchronous progress admission completes.\",\n          \"expected\": \"Hold one terminal slot per local owner; if admission completes, submit terminal evidence without replaying late active updates; release state after bounded settlement.\"\n        }\n      ],\n      \"invariantsToPreserve\": [\n        {\n          \"text\": \"Preserve workflow driver, streaming and detached workflow results, progress frames and abort authority.\",\n          \"source\": \"c1\"\n        },\n        {\n          \"text\": \"Preserve analysis stage filtering and the separate analyze.result/done terminal pair.\",\n          \"source\": \"c1\"\n        }\n      ]\n    },\n    \"testStrategy\": {\n      \"testFramework\": \"Node.js node:test through tsx\",\n      \"testLevels\": [\n        {\n          \"level\": \"unit\",\n          \"purpose\": \"Verify typed mapping, privacy and monotonic event behavior.\",\n          \"subjects\": [\n            \"Workflow phases, retries and known versus absent production units\",\n            \"Analysis stages, tasks and ignored previews\",\n            \"Owner settlement and quiet liveness\"\n          ],\n          \"fixturesNeeded\": [\n            \"Chunk-only streaming provider and non-streaming provider fixtures\",\n            \"Analysis events carrying sentinel secrets\"\n          ]\n        },\n        {\n          \"level\": \"integration\",\n          \"purpose\": \"Exercise routed and in-process execution with real S1 coordinator and a verified test origin.\",\n          \"subjects\": [\n            \"workflow.run\",\n            \"workflow.run.start/poll/abort\",\n            \"analyze.run.start/status\",\n            \"Worker exit, rebinding and terminal write failure\"\n          ],\n          \"fixturesNeeded\": [\n            \"Fake provider with controlled stage transitions\",\n            \"Real worker channel and temporary progress store\"\n          ]\n        },\n        {\n          \"level\": \"contract\",\n          \"purpose\": \"Confirm legacy compatibility independent of observation state.\",\n          \"subjects\": [\n            \"Exact frame sequences and payloads\",\n            \"Cancellation and detached lifetime\",\n            \"Denial for wrong project or origin and stale worker\",\n            \"No extra provider invocations, bounded relay and final cleanup\"\n          ]\n        }\n      ],\n      \"acceptanceMapping\": [\n        {\n          \"criterionId\": \"ac1\",\n          \"provingTests\": [\n            \"Both real daemon entry paths expose normalized stage updates via S1, even during quiet stages and concurrent runs.\",\n            \"Workflow chunks keep their actual unit and analysis previews leave production unknown.\",\n            \"Worker relay rejects wrong owner and old sequence.\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac2\",\n          \"provingTests\": [\n            \"Legacy clients receive identical workflow stream, detached poll and analysis terminal frames with progress disabled, active, refused and failing.\",\n            \"Existing abort and socket disconnect paths keep their outcomes, detached workflow survives observer loss, and settled runs stop owner updates.\",\n            \"Terminal snapshot persists exactly once before S1 observer delivery without delaying legacy result.\"\n          ]\n        }\n      ]\n    },\n    \"migration\": {\n      \"stateBefore\": \"The S2 context bundle locates separate legacy workflow stage/delta, detached poll, and analysis stage/result routes. S1 has a daemon-owned progress runtime but has no workflow or analysis projector.\",\n      \"stateAfter\": \"New verified workflow and analysis executions can produce typed progress through the existing coordinator without altering any legacy operation contract.\",\n      \"migrationSteps\": [\n        {\n          \"order\": 1,\n          \"action\": \"Add the two closed detail validators and initialize the two producer ports on the existing runtime.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 2,\n          \"action\": \"Attach owner delegates at the existing workflow and analysis launch sites, with the private main-thread relay for routed execution.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 3,\n          \"action\": \"Qualify real routing and compatibility with registered test origins before delivery stories consume the contract.\",\n          \"rollbackable\": true\n        }\n      ],\n      \"backwardCompat\": \"Existing RPC request and result fields, stream order, detached poll cursor, abort and restart behavior remain compatible. Existing progress records require no rewrite.\",\n      \"zeroDowntime\": false,\n      \"dataRewriteRequired\": false\n    },\n    \"alternativesConsidered\": [\n      {\n        \"id\": \"a1\",\n        \"name\": \"Executor-owned delegates over existing callbacks\",\n        \"oneLineSummary\": \"Map producer events at each supported run owner.\",\n        \"approach\": \"Use one workflow and one analysis delegate with run-local state fed by typed producer callbacks and settled by the executor that owns the result. The S1 coordinator remains the only progress authority.\",\n        \"pros\": [\n          \"Preserves legacy delivery and existing cancellation authority.\",\n          \"Retains access to trusted terminal and owner evidence.\"\n        ],\n        \"cons\": [\n          \"Each supported owner entry point must wire its lifecycle explicitly.\"\n        ],\n        \"costEstimate\": \"S\"\n      },\n      {\n        \"id\": \"a2\",\n        \"name\": \"Shared internal producer event envelope\",\n        \"oneLineSummary\": \"Normalize run events into a single internal envelope before delegation.\",\n        \"approach\": \"Introduce a typed daemon-private event envelope for workflow and analysis producers, preserving the existing adapters for legacy output and using the same coordinator producer port.\",\n        \"pros\": [\n          \"Centralizes event classification and contract validation.\"\n        ],\n        \"cons\": [\n          \"Adds a transport and translation layer for two producers and widens legacy-path changes.\"\n        ],\n        \"costEstimate\": \"M\",\n        \"reasonRejected\": \"Can meet the same contracts but requires a parallel internal envelope.\"\n      }\n    ],\n    \"chosenAlternative\": \"a1\",\n    \"openQuestions\": [],\n    \"sequenceDefinition\": {\n      \"id\": \"workflow-analysis-progress\",\n      \"narrative\": \"An executor sends measurements and terminal evidence to the coordinator without making the legacy result path wait on progress. The worker relay applies only in routed execution. A run without an authorized observation continues through the legacy path.\",\n      \"participants\": [\n        {\n          \"id\": \"caller\",\n          \"label\": \"Legacy caller\",\n          \"description\": \"Receives existing stream or poll results.\"\n        },\n        {\n          \"id\": \"exec\",\n          \"label\": \"Run owner\",\n          \"description\": \"Owns workflow or analysis execution and the legacy result.\"\n        },\n        {\n          \"id\": \"relay\",\n          \"label\": \"Worker relay\",\n          \"description\": \"Connects the worker-owned execution to the main daemon using a private bounded channel.\"\n        },\n        {\n          \"id\": \"coord\",\n          \"label\": \"Coordinator\",\n          \"description\": \"Owns admission, fencing and persistence.\"\n        },\n        {\n          \"id\": \"observer\",\n          \"label\": \"Bound observer\",\n          \"description\": \"Uses the S1 observation capability.\"\n        }\n      ],\n      \"messages\": [\n        {\n          \"from\": \"caller\",\n          \"to\": \"exec\",\n          \"label\": \"Start run\",\n          \"description\": \"Existing validation, inputs and cancellation semantics.\"\n        },\n        {\n          \"from\": \"exec\",\n          \"to\": \"relay\",\n          \"label\": \"Offer observation\",\n          \"description\": \"Daemon-generated execution key and server-verified launch context. No observer is required to execute.\"\n        },\n        {\n          \"from\": \"relay\",\n          \"to\": \"coord\",\n          \"label\": \"Admit producer\",\n          \"description\": \"Bind one worker and one run to the S1 owner fence. Skip observation when authorization or admission fails.\"\n        },\n        {\n          \"from\": \"exec\",\n          \"to\": \"caller\",\n          \"label\": \"Send existing stage frame\",\n          \"description\": \"Detached workflow retains its poll frame shape.\"\n        },\n        {\n          \"from\": \"exec\",\n          \"to\": \"relay\",\n          \"label\": \"Send structured measurement\",\n          \"description\": \"Coalesce and forward allowlisted data only.\"\n        },\n        {\n          \"from\": \"relay\",\n          \"to\": \"coord\",\n          \"label\": \"Signal latest sample\",\n          \"description\": \"The coordinator reads the delegate and verifies the fence.\"\n        },\n        {\n          \"from\": \"coord\",\n          \"to\": \"observer\",\n          \"label\": \"Publish snapshot\",\n          \"description\": \"Only a bound observer receives the snapshot.\"\n        },\n        {\n          \"from\": \"exec\",\n          \"to\": \"caller\",\n          \"label\": \"Deliver legacy outcome\",\n          \"description\": \"Independent of whether observation can persist.\"\n        },\n        {\n          \"from\": \"exec\",\n          \"to\": \"relay\",\n          \"label\": \"Send terminal evidence\",\n          \"description\": \"Use actual owner settlement, never an abort receipt or preview.\"\n        },\n        {\n          \"from\": \"relay\",\n          \"to\": \"coord\",\n          \"label\": \"Record terminal\",\n          \"description\": \"Bypass active coalescing and fence late updates.\"\n        },\n        {\n          \"from\": \"coord\",\n          \"to\": \"observer\",\n          \"label\": \"Publish terminal snapshot\",\n          \"description\": \"Only after persistence succeeds.\"\n        }\n      ]\n    },\n    \"companions\": [\n      {\n        \"kind\": \"diagram-mermaid\",\n        \"relPath\": \"docs/epics/show-long-running-task-progress-chat-E20261109206db342/S002/sequence-diagram.html\",\n        \"title\": \"Sequence diagram\"\n      }\n    ]\n  },\n  \"citations\": [\n    {\n      \"id\": \"c1\",\n      \"kind\": \"analyze-bundle\",\n      \"ref\": \"s1\",\n      \"quotedText\": \"Workflow has streaming and detached owners. Analysis maps stage transitions independently of its terminal result.\"\n    },\n    {\n      \"id\": \"c2\",\n      \"kind\": \"prior-artifact\",\n      \"ref\": \"docs/epics/show-long-running-task-progress-chat-E20261109206db342/HLD.md\"\n    },\n    {\n      \"id\": \"c3\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/workflow-rpc.ts\"\n    },\n    {\n      \"id\": \"c4\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/workflow-run-registry.ts\"\n    },\n    {\n      \"id\": \"c5\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/analyze-rpc.ts\"\n    },\n    {\n      \"id\": \"c6\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/task-progress/coordinator.ts\"\n    },\n    {\n      \"id\": \"c7\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/task-progress/access.ts\"\n    },\n    {\n      \"id\": \"c8\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/index.ts\"\n    },\n    {\n      \"id\": \"c9\",\n      \"kind\": \"code\",\n      \"ref\": \"src/shared/task-progress.ts\"\n    },\n    {\n      \"id\": \"c10\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/threads/method-class.ts\"\n    },\n    {\n      \"id\": \"c11\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/__tests__/workflow-progress-map.test.ts\"\n    },\n    {\n      \"id\": \"c12\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/__tests__/analyze-progress.test.ts\"\n    }\n  ]\n}\n","document":"<!-- insrc:artifact LLD-206db3426ffd4428-s2 -->\n\n# LLD: STORY-206db3426ffd4428-s2 — Preserve live progress for workflows and analysis\n\n## Summary\n\n**Epic:** `show-long-running-task-progress-chat`\n**HLD base run:** `wf-1794211533808-ghbhlu`\n**HLD effective hash:** `48a6a5468b45...`\n\nWorkflow and analysis executors feed structured measurements to the daemon coordinator through run-owned delegates. Existing streams, detached workflow polls, and analysis results keep their current contracts. Progress reports a stage even when the producer cannot measure output.\n\n## Contents\n\n1. [HLD context](#1-hld-context)\n2. [Contract details](#2-contract-details)\n3. [Data model changes](#3-data-model-changes)\n4. [Diagrams](#4-diagrams)\n5. [Interaction with shared contracts](#5-interaction-with-shared-contracts)\n6. [Error paths](#6-error-paths)\n7. [Test strategy](#7-test-strategy)\n8. [Migration](#8-migration)\n9. [Alternatives considered](#9-alternatives-considered)\n10. [References](#10-references)\n\n## 1. HLD context\n\n> See **HLD-206db3426ffd4428** § 2. Framework summary\n\n**Rollout phase:** Phase B — executor measurement adapters\n**Owns:** `sc4` (Workflow and analysis measurements)\n**Consumes:** `sc1` (Task identity and delegate observation), `sc2` (Scoped snapshots, subscriptions and observation control), `sc3` (Execution-owned activity and chat retention)\n\n**Adjacent scope (owned by other stories — do NOT implement here):**\n- `s1`: Own daemon coordination, verified registration, cursors, normalization, scoped read/subscribe/control, durable state, owner fencing and fallback schedule arbitration. Keep storage, fencing and expiry implementation private. — owns `sc1`, `sc2`, `sc3`\n- `s3`: Own DesignReviewDelegate and CodeReviewDelegate and mappings from checkpoint progress and execution ownership. Review results, admission, retries and publication remain under the existing engines. — owns `sc5`\n- `s4`: Own TestDelegate and managed reporter interpretation, including suite/case identity, provisional counts and abnormal exit. Keep test orchestration and exit semantics unchanged. — owns `sc6`\n- `s5`: Own typed VS Code reader and transcript row, current status projection and bindings to the session owner. Render durable snapshots by origin across turns and multiple windows without executing or polling models.\n- `s6`: Own MCP adapter, capability qualification, explicit opt-in disclosure and connection to the coordinator's fallback lease. No vendor-specific process changes or assumptions about session identity.\n\n## 2. Contract details\n\n**Surface level:** internal-shared\n\n### 2.1 `TaskProgressDelegate`\n\n```typescript\ninterface TaskProgressDelegate<D> { progress(task: TaskRef, signal?: AbortSignal): Promise<DelegateMeasurement<D> | null> }\n```\n\n**Parameters:**\n- `task: TaskRef` — Fence lookup to the admitted attempt.\n- `signal: AbortSignal` _(optional)_ — Stop the observation read.\n\n**Returns:** `Promise<DelegateMeasurement<D> | null>` — Latest sanitized snapshot or null when no observation exists.\n\n**Preconditions:**\n- Task was admitted through the trusted S1 producer port.\n\n**Postconditions:**\n- The read is bounded and does not perform producer work.\n\n## 3. Data model changes\n\n### 3.1 `WorkflowDetails` — new\n\nOne optional current snapshot per owned workflow attempt, pointing from the S1 task to an executor-local measurement. stageId comes from the internal phase allowlist, with a validated step or runner identifier as activeUnit. stagePosition is null because the legacy index counts events, including retries, and is not completion. production is a run-cumulative count of actual provider deltas with unit output-chunks and null total. Existing tokensTotal counts callbacks, so label tokens only when a provider explicitly supplies a verified token count. Track detached deltas without adding frames to the legacy poll.\n\n**Call sites:**\n- `src/daemon/workflow-rpc.ts`\n- `src/daemon/workflow-run-registry.ts`\n\n### 3.2 `AnalysisDetails` — new\n\nOne optional current snapshot per owned analyze attempt. Use allowlisted typed stage and task transition data, and report unknown stagePosition unless a same-plan completed count is available. Production is null on the current analysis preview route. No preview text, labels, prompts, tool messages or arbitrary payload fields cross into progress.\n\n**Call sites:**\n- `src/daemon/analyze-rpc.ts`\n\n## 4. Diagrams\n\n- [Sequence diagram](docs/epics/show-long-running-task-progress-chat-E20261109206db342/S002/sequence-diagram.html)\n\n## 5. Interaction with shared contracts\n\n| Contract | Role | How |\n| :--- | :--- | :--- |\n| `sc1` | consumes | Once per actual run use the trusted producer port and launch authorization, a daemon-created execution key and the admitted fence. Use main daemon as sole owner of the S1 runtime. Session workers send bounded typed measurements and lifecycle through a private hub relay keyed to the actual worker channel and run. The coordinator-side delegate reads an in-memory mirror. Never accept an origin, owner epoch or opaque handle from public params. In-process route uses the same port without a hub hop. |\n| `sc2` | consumes | Register workflow and analysis projectors and matching closed validators in the runtime. Keep public stream, poll and status payloads unchanged. Start observation independently of legacy delivery. Observation admission, writer failures and slow consumers never block the legacy terminal path. Owner-side result settlement is the terminal evidence. Supply a safe result handle only where an existing authorized result lookup exists. |\n| `sc3` | consumes | Check live execution via the real run owner and its worker channel even when the producer is quiet. Use server-verified origin bindings only. Loss of observer does not renew or end ownership. End the observed attempt exactly once at owner settlement or classify verified owner loss as interrupted, preserving the S1 lease policy. |\n| `sc4` | implements | Separate workflow/analysis detail discriminants use the same stage, optional measured position and optional declared-unit production fields. The daemon observes workflow.run and detached workflow.run.start, and analyze.run.start. Controller step calls and nested grounding are not independently registered as complete daemon-owned runs. |\n\n## 6. Error paths\n\n**Error cases**\n\n- **Progress admission or persistence fails.** (recoverable)\n  - Detection: Producer port rejects or throws, relay closes, or reservation is refused.\n  - Response: Disable or degrade that run's progress observation; isolate the rejection from execution and preserve the existing result path. Retry only an exact terminal write under the same fence as S1 permits.\n  - User impact: Legacy operation continues. No fabricated successful progress is published.\n- **Worker owner exits or a stale worker sends an update.** (recoverable)\n  - Detection: Worker channel closure or mismatch with the bound worker, run, attempt or strictly ordered sequence.\n  - Response: Reject stale frames. Use verified worker loss for interruption when no prior terminal evidence exists; keep a previously persisted terminal state.\n  - User impact: An interrupted owner is distinguishable from a quiet stage.\n- **Untrusted or missing origin.** (terminal)\n  - Detection: Trusted project resolution or S1 origin binding validation fails.\n  - Response: Do not mint a conversation grant. Never infer a chat from a client-supplied ID, run ID, socket or session label. Continue legacy execution.\n  - User impact: Run remains usable via its existing path.\n\n**Edge cases**\n\n| Input | Expected |\n| :--- | :--- |\n| Quiet stage or provider without count evidence. | Keep stage stable; production is null until evidence exists. Verified owner liveness is separate from meaningful progress. |\n| Cancellation request races with successful settlement. | Pending cancellation is not terminal. Workflow detached uses its existing final status; analysis uses the typed aborted result; a verified successful completion remains successful. |\n| Legacy streaming client disconnects or detached poll stops. | Preserve existing stream-abort semantics and detached-run lifetime. Only owner evidence determines progress terminal state. |\n| An analysis preview token or a workflow retry carries arbitrary text. | Legacy handling stays byte-compatible. No text is copied into the new measurement. |\n| Legacy execution settles before asynchronous progress admission completes. | Hold one terminal slot per local owner; if admission completes, submit terminal evidence without replaying late active updates; release state after bounded settlement. |\n\n**Invariants to preserve**\n\n- Preserve workflow driver, streaming and detached workflow results, progress frames and abort authority. [[c1]]\n- Preserve analysis stage filtering and the separate analyze.result/done terminal pair. [[c1]]\n\n## 7. Test strategy\n\n**Test framework:** `Node.js node:test through tsx`\n\n**Test levels**\n\n- **unit** — Verify typed mapping, privacy and monotonic event behavior.\n  - Subjects: `Workflow phases, retries and known versus absent production units`, `Analysis stages, tasks and ignored previews`, `Owner settlement and quiet liveness`\n  - Fixtures: `Chunk-only streaming provider and non-streaming provider fixtures`, `Analysis events carrying sentinel secrets`\n- **integration** — Exercise routed and in-process execution with real S1 coordinator and a verified test origin.\n  - Subjects: `workflow.run`, `workflow.run.start/poll/abort`, `analyze.run.start/status`, `Worker exit, rebinding and terminal write failure`\n  - Fixtures: `Fake provider with controlled stage transitions`, `Real worker channel and temporary progress store`\n- **contract** — Confirm legacy compatibility independent of observation state.\n  - Subjects: `Exact frame sequences and payloads`, `Cancellation and detached lifetime`, `Denial for wrong project or origin and stale worker`, `No extra provider invocations, bounded relay and final cleanup`\n\n**Acceptance mapping**\n\n| Criterion | Proving tests |\n| :--- | :--- |\n| `ac1` | `Both real daemon entry paths expose normalized stage updates via S1, even during quiet stages and concurrent runs.`, `Workflow chunks keep their actual unit and analysis previews leave production unknown.`, `Worker relay rejects wrong owner and old sequence.` |\n| `ac2` | `Legacy clients receive identical workflow stream, detached poll and analysis terminal frames with progress disabled, active, refused and failing.`, `Existing abort and socket disconnect paths keep their outcomes, detached workflow survives observer loss, and settled runs stop owner updates.`, `Terminal snapshot persists exactly once before S1 observer delivery without delaying legacy result.` |\n\n## 8. Migration\n\n**State before:** The S2 context bundle locates separate legacy workflow stage/delta, detached poll, and analysis stage/result routes. S1 has a daemon-owned progress runtime but has no workflow or analysis projector.\n\n**State after:** New verified workflow and analysis executions can produce typed progress through the existing coordinator without altering any legacy operation contract.\n\n**Zero downtime:** no — **Data rewrite:** no\n\n**Steps**\n\n1. Add the two closed detail validators and initialize the two producer ports on the existing runtime. — ↩ rollbackable\n2. Attach owner delegates at the existing workflow and analysis launch sites, with the private main-thread relay for routed execution. — ↩ rollbackable\n3. Qualify real routing and compatibility with registered test origins before delivery stories consume the contract. — ↩ rollbackable\n\n**Backward compat:** Existing RPC request and result fields, stream order, detached poll cursor, abort and restart behavior remain compatible. Existing progress records require no rewrite.\n\n## 9. Alternatives considered\n\n### 9.1 a1: Executor-owned delegates over existing callbacks — **CHOSEN**\n\nMap producer events at each supported run owner.\n\nUse one workflow and one analysis delegate with run-local state fed by typed producer callbacks and settled by the executor that owns the result. The S1 coordinator remains the only progress authority.\n\n### 9.2 a2: Shared internal producer event envelope\n\nNormalize run events into a single internal envelope before delegation.\n\nIntroduce a typed daemon-private event envelope for workflow and analysis producers, preserving the existing adapters for legacy output and using the same coordinator producer port.\n\n**Rejected because:** Can meet the same contracts but requires a parallel internal envelope.\n\n## 10. References\n\n- **[[c1]]** `analyze-bundle` `s1` — \"Workflow has streaming and detached owners. Analysis maps stage transitions independently of its terminal result.\"\n- **[[c2]]** `prior-artifact` `docs/epics/show-long-running-task-progress-chat-E20261109206db342/HLD.md`\n- **[[c3]]** `code` `src/daemon/workflow-rpc.ts`\n- **[[c4]]** `code` `src/daemon/workflow-run-registry.ts`\n- **[[c5]]** `code` `src/daemon/analyze-rpc.ts`\n- **[[c6]]** `code` `src/daemon/task-progress/coordinator.ts`\n- **[[c7]]** `code` `src/daemon/task-progress/access.ts`\n- **[[c8]]** `code` `src/daemon/index.ts`\n- **[[c9]]** `code` `src/shared/task-progress.ts`\n- **[[c10]]** `code` `src/daemon/threads/method-class.ts`\n- **[[c11]]** `code` `src/daemon/__tests__/workflow-progress-map.test.ts`\n- **[[c12]]** `code` `src/daemon/__tests__/analyze-progress.test.ts`\n"},"capturedAt":"2026-11-09T20:03:57.376Z"},"inventory":{"units":[{"id":"/body/summary","selector":"/body/summary","title":"summary","kind":"section"},{"id":"/body/hldContextSlice","selector":"/body/hldContextSlice","title":"hldContextSlice","kind":"section"},{"id":"/body/contractDetails","selector":"/body/contractDetails","title":"contractDetails","kind":"section"},{"id":"/body/dataModelChanges","selector":"/body/dataModelChanges","title":"dataModelChanges","kind":"section"},{"id":"/body/interactionWithShared","selector":"/body/interactionWithShared","title":"interactionWithShared","kind":"section"},{"id":"/body/errorPaths","selector":"/body/errorPaths","title":"errorPaths","kind":"section"},{"id":"/body/testStrategy","selector":"/body/testStrategy","title":"testStrategy","kind":"section"},{"id":"/body/migration","selector":"/body/migration","title":"migration","kind":"section"},{"id":"/body/alternativesConsidered","selector":"/body/alternativesConsidered","title":"alternativesConsidered","kind":"section"},{"id":"/body/chosenAlternative","selector":"/body/chosenAlternative","title":"chosenAlternative","kind":"section"},{"id":"/body/openQuestions","selector":"/body/openQuestions","title":"openQuestions","kind":"section"},{"id":"/body/sequenceDefinition","selector":"/body/sequenceDefinition","title":"sequenceDefinition","kind":"visual"},{"id":"/body/companions","selector":"/body/companions","title":"companions","kind":"visual"},{"id":"/body/hldContextSlice/ownedContracts/0","selector":"/body/hldContextSlice/ownedContracts/0","title":"sc4","kind":"contract"},{"id":"/body/hldContextSlice/consumedContracts/0","selector":"/body/hldContextSlice/consumedContracts/0","title":"sc1","kind":"contract"},{"id":"/body/hldContextSlice/consumedContracts/1","selector":"/body/hldContextSlice/consumedContracts/1","title":"sc2","kind":"contract"},{"id":"/body/hldContextSlice/consumedContracts/2","selector":"/body/hldContextSlice/consumedContracts/