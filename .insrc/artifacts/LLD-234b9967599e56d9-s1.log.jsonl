68634	{"artifactId":"LLD-234b9967599e56d9-s1","entry":{"id":"ba4045a16b1771aac1e19e15d3d413f8ee061ffff73964a81fc67b37a29ee24e","targetHeadHash":"4c9be3dc3fce89b46b88eeff4197997fb1c51076e2523d96fd25f4da8622f42f","actor":{"id":"agent:design-review-daemon","kind":"agent","properties":{"party":"daemon"}},"timestamp":"2026-11-14T15:59:20.880Z","operation":"review","revision":{"number":1,"contentHash":"d1c5e8f233980f97d6e835b86cd2ac00117cb2eb452c56a36ff97b3d0ec6008b"},"outcome":{"result":"block","summary":"Design review v2-dev-install-234b9967 attempt 1","data":{"kind":"design-chunk-review","reviewId":"v2-dev-install-234b9967","project":"/Users/subhagho/work/projects/insors/insrc","artifactId":"LLD-234b9967599e56d9-s1","subject":{"project":"/Users/subhagho/work/projects/insors/insrc","artifactId":"LLD-234b9967599e56d9-s1","kind":"LLD","canonicalPath":"/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-234b9967599e56d9-s1.json","documentPath":"/Users/subhagho/work/projects/insors/insrc/docs/standalone/install-signed-v2-daemon-development-bundles-E20261114234b9967/S001/LLD.md","reviewer":"daemon","workflow":{"kind":"standalone","rootArtifactId":"LLD-234b9967599e56d9-s1","requiredReferences":[],"availableReferences":[],"notApplicableRoles":["PLAN","TASKS","BUILD","CR","DEF","HLD","sibling_stories"]}},"reviewer":"daemon","applicableAttempt":1,"status":"incomplete","binding":{"sourceRevision":{"number":1,"contentHash":"d1c5e8f233980f97d6e835b86cd2ac00117cb2eb452c56a36ff97b3d0ec6008b"},"reviewedContentIdentity":"b03b3c791a3c9348ebfd8f118242f2d0caa77e659829283edd0f82abd3f42a22","documentDigest":"7761a97b21b103892962aa1fb475a3863690444973686b6f28af802c832b4b34","workflowDigest":"66647241350bc603aa6f77ff87e6317dc1b162a5a9f6767cd14a3a488dc8db06","author":"controller"},"preservationDigest":"a687de54988a0b5abc3d6711fe52ac59eb8a2353898ee0550825278b893f1709","schemaVersion":2,"submitted":{"artifactPath":"/Users/subhagho/work/projects/insors/insrc/docs/standalone/install-signed-v2-daemon-development-bundles-E20261114234b9967/S001/LLD.md","attempt":1},"attempts":[{"number":1,"status":"incomplete","preparationKind":"planning","baseline":{"subjectFingerprints":{"canonical":"ea9b97265343040c18fc57000721d680411f00da3cfe3e6808b222e7c2cd89ca","document":"7761a97b21b103892962aa1fb475a3863690444973686b6f28af802c832b4b34"},"contentIdentity":"b03b3c791a3c9348ebfd8f118242f2d0caa77e659829283edd0f82abd3f42a22","reviewedContent":{"canonical":"{\n  \"meta\": {\n    \"workflow\": \"design.story\",\n    \"runId\": \"wf-1794671662903-6oo25p\",\n    \"repoPath\": \"/Users/subhagho/work/projects/insors/insrc\",\n    \"createdAt\": \"2026-11-14T15:54:38.285Z\",\n    \"epicCreatedAt\": \"2026-11-14T15:54:38.285Z\",\n    \"attribution\": {\n      \"outputs\": [\n        {\n          \"role\": \"(client)\",\n          \"tier\": \"core\",\n          \"runner\": \"cli-codex\",\n          \"model\": \"unknown\"\n        }\n      ]\n    },\n    \"elapsedMs\": 15100,\n    \"repoIndexedAt\": null,\n    \"schemaVersion\": 1,\n    \"epicHash\": \"234b9967599e56d9\",\n    \"epicSlug\": \"install-signed-v2-daemon-development-bundles\",\n    \"storyId\": \"s1\",\n    \"hldBaseRunId\": \"wf-1794671662903-6oo25p\",\n    \"hldEffectiveHash\": \"234b9967599e56d9370a1f1682114b80ecde978c436abc9815c08ea02bda511f\",\n    \"hldAmendmentsApplied\": [],\n    \"storyTitle\": \"Install signed v2 daemon development bundles\",\n    \"standalone\": true,\n    \"sizeClass\": \"feature\",\n    \"triageRationale\": \"One deployable development lane, reusing bundle staging and managed installation, with a distinct trust domain and local build and installer entry points. Changes cross signing, package verification, and persistent lifecycle but no new production release system.\",\n    \"authoredBy\": \"controller\",\n    \"lifecycle\": {\n      \"status\": \"draft\",\n      \"revision\": {\n        \"number\": 1,\n        \"contentHash\": \"d1c5e8f233980f97d6e835b86cd2ac00117cb2eb452c56a36ff97b3d0ec6008b\",\n        \"at\": \"2026-11-14T15:54:38.408Z\",\n        \"by\": {\n          \"id\": \"insrc:system\",\n          \"kind\": \"system\",\n          \"properties\": {}\n        }\n      },\n      \"signoffs\": []\n    },\n    \"revision\": 1\n  },\n  \"body\": {\n    \"summary\": {\n      \"audience\": \"technical\",\n      \"prose\": \"An opt-in signed v2 bundle is built and installed on Apple Silicon without any main release or GitHub Actions dependency. Keep production signing and promotion main-only.\"\n    },\n    \"hldContextSlice\": {\n      \"frameworkSummary\": \"Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\",\n      \"ownedContracts\": [],\n      \"consumedContracts\": [],\n      \"boundary\": {\n        \"storyId\": \"s1\",\n        \"owns\": [],\n        \"depends\": [],\n        \"internal\": \"Install signed v2 daemon development bundles\"\n      },\n      \"adjacentBoundaries\": [],\n      \"rolloutPhase\": \"standalone\",\n      \"nonFunctional\": {}\n    },\n    \"contractDetails\": {\n      \"api\": [\n        {\n          \"name\": \"Build v2 development bundle\",\n          \"signature\": \"exact v2 commit + dev version + sequence → archive and signed dev manifest\",\n          \"parameters\": [],\n          \"returns\": {\n            \"type\": \"result\",\n            \"meaning\": \"Verified development bundle or a refusal\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"DevelopmentBundleRefused\",\n              \"condition\": \"Origin, trust, target, isolation or compatibility check failed\"\n            }\n          ],\n          \"preconditions\": [\n            \"Fetch v2 from the configured upstream and verify an exact commit reachable from that fetched branch; build in a clean detached worktree using the pinned runtime; run relevant checks locally.\",\n            \"Use a project-owned distinct development key offline or on an approved build host, separate from the release and qualification keys. No GitHub Release or workflow dispatch is needed.\"\n          ],\n          \"postconditions\": [\n            \"Record v2 origin and commit, dev version, monotonic sequence, archive size/hash, measured runtime fingerprint, and any exact qualified predecessor in signed manifest. Keep version/channel and signature namespace distinct. Hand off the archive, manifest, detached signature and independently authenticated dev bootstrap through an internal channel.\"\n          ]\n        },\n        {\n          \"name\": \"Install or update v2 development bundle\",\n          \"signature\": \"authenticated dev bootstrap + signed v2 manifest + archive → managed dev daemon\",\n          \"parameters\": [],\n          \"returns\": {\n            \"type\": \"result\",\n            \"meaning\": \"Verified development bundle or a refusal\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"DevelopmentBundleRefused\",\n              \"condition\": \"Origin, trust, target, isolation or compatibility check failed\"\n            }\n          ],\n          \"preconditions\": [\n            \"Use a dedicated macOS account or VM with independent home, state, LaunchAgent and sockets. A marker alone is insufficient: fail before writing to an existing non-development installation; require explicit dev bootstrap entrypoint.\",\n            \"Pin the dev public key through the trusted bootstrap. Reject cross-domain signatures, wrong origin/target, digest mismatch and replay before executing any bundle code. Restore only exact transaction predecessor, offline, from same domain.\"\n          ],\n          \"postconditions\": [\n            \"Fresh install takes no predecessor. Upgrade accepts only a signed compatible dev predecessor pinned to the installed manifest; preserve state and verify readiness or restore it. Scope existing CLI/MCP registration to the dev environment.\",\n            \"Main release and qualification reject development provenance and signatures at all gates; no production key on development hosts.\"\n          ]\n        }\n      ],\n      \"surfaceLevel\": \"public\"\n    },\n    \"dataModelChanges\": [\n      {\n        \"entity\": \"Development bundle identity\",\n        \"change\": \"new\",\n        \"details\": \"Separate development trust root, manifest namespace, v2 origin, sequence floor and installed proof; identity may use upstream repository and exact commit without invented Actions IDs. Preserve production manifest/evidence schemas and forbid dev predecessor on a production chain.\",\n        \"callSites\": [\n          \"scripts/install-daemon-bundle.mjs\",\n          \"scripts/package-daemon-bootstrap.mjs\",\n          \"scripts/daemon-bundle-metadata.mjs\"\n        ]\n      }\n    ],\n    \"interactionWithShared\": [],\n    \"errorPaths\": {\n      \"errorCases\": [\n        {\n          \"scenario\": \"Development archive is substituted or submitted to a main signing gate\",\n          \"detection\": \"Check independently authenticated signer, domain, origin and archive digest.\",\n          \"response\": \"Refuse before executing code or signing.\",\n          \"userImpact\": \"Obtain original matching package.\",\n          \"recoverable\": true\n        }\n      ],\n      \"edgeCases\": [\n        {\n          \"input\": \"Existing qualification or production state in same home\",\n          \"expected\": \"Fail closed before state or LaunchAgent mutation.\"\n        },\n        {\n          \"input\": \"Offline rollback after interrupted dev update\",\n          \"expected\": \"Reconcile exact pinned prior dev release and retain sequence floor.\"\n        }\n      ],\n      \"invariantsToPreserve\": []\n    },\n    \"testStrategy\": {\n      \"testLevels\": [\n        {\n          \"level\": \"contract\",\n          \"purpose\": \"Prove development/production separation locally\",\n          \"subjects\": [\n            \"Build provenance and exact archive/runtime verification\",\n            \"Dev signature accepted only in dev; release signature accepted only in correct lane\",\n            \"Existing non-dev state untouched\"\n          ]\n        },\n        {\n          \"level\": \"live\",\n          \"purpose\": \"Verify actual bundle in disposable Apple Silicon environment\",\n          \"subjects\": [\n            \"Fresh install, MCP/CLI connection, restart, newer dev update and forced rollback offline\"\n          ]\n        }\n      ],\n      \"acceptanceMapping\": [\n        {\n          \"criterionId\": \"ac1\",\n          \"provingTests\": [\n            \"Build and sign from exact fetched v2 in clean detached tree with no main dependency\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac2\",\n          \"provingTests\": [\n            \"Local dev fresh install/update/restart/rollback; cross-domain and replay refusal\"\n          ]\n        }\n      ],\n      \"testFramework\": \"All tests local on Apple Silicon or fixtures; no hosted tests.\"\n    },\n    \"migration\": {\n      \"stateBefore\": \"v2 source install exists and development build artifacts are unsigned.\",\n      \"stateAfter\": \"Opt-in signed development bundles install and upgrade in a dedicated environment.\",\n      \"migrationSteps\": [\n        {\n          \"order\": 1,\n          \"action\": \"Distribute authenticated dev bootstrap and install into a clean isolated macOS account or VM; preserve any existing daemon installation.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 2,\n          \"action\": \"Qualify consecutive dev bundles and test offline rollback before internal use. Existing source installs may continue independently.\",\n          \"rollbackable\": true\n        }\n      ],\n      \"backwardCompat\": \"No production state migration or changes to the default source installer. Migration of an existing source install into the dev bundle lane is deferred.\",\n      \"zeroDowntime\": false,\n      \"dataRewriteRequired\": false\n    },\n    \"alternativesConsidered\": [\n      {\n        \"id\": \"a1\",\n        \"name\": \"Independent development bundle\",\n        \"oneLineSummary\": \"Build and sign v2 locally with development trust.\",\n        \"approach\": \"Use the exact v2 commit on Apple Silicon to build the same package locally, then distribute and install it under a separate development trust domain.\",\n        \"pros\": [\n          \"No main dependency\",\n          \"Tests and initial builds stay local\"\n        ],\n        \"cons\": [\n          \"Requires a development key and isolated environment\"\n        ],\n        \"costEstimate\": \"M\"\n      },\n      {\n        \"id\": \"a2\",\n        \"name\": \"Source install\",\n        \"oneLineSummary\": \"Clone v2 and compile on each Mac.\",\n        \"approach\": \"Keep --branch v2 as a source workflow with per-host package installation and compilation.\",\n        \"pros\": [\n          \"Existing entry point\"\n        ],\n        \"cons\": [\n          \"Does not deploy tested prebuilt bytes\"\n        ],\n        \"costEstimate\": \"S\",\n        \"reasonRejected\": \"Does not deploy a prebuilt candidate.\"\n      }\n    ],\n    \"chosenAlternative\": \"a1\",\n    \"openQuestions\": [],\n    \"sequenceDefinition\": {\n      \"narrative\": \"Development build, signing, and installation are independent of main and keep a separate trust and state boundary.\",\n      \"participants\": [\n        {\n          \"id\": \"builder\",\n          \"label\": \"Local Apple Silicon builder\",\n          \"description\": \"Builds an exact upstream v2 commit\"\n        },\n        {\n          \"id\": \"signer\",\n          \"label\": \"Development signer\",\n          \"description\": \"Authenticates archive and runtime inventory with a separate development key\"\n        },\n        {\n          \"id\": \"operator\",\n          \"label\": \"Development installer\",\n          \"description\": \"Verifies a known bootstrap and signed archive\"\n        },\n        {\n          \"id\": \"managed\",\n          \"label\": \"Development daemon lifecycle\",\n          \"description\": \"Activates exact runtime or restores the pinned predecessor\"\n        }\n      ],\n      \"messages\": [\n        {\n          \"from\": \"builder\",\n          \"to\": \"signer\",\n          \"label\": \"Provide exact candidate and measured bytes\",\n          \"description\": \"Only development origin is eligible\"\n        },\n        {\n          \"from\": \"signer\",\n          \"to\": \"operator\",\n          \"label\": \"Hand off signed development package\",\n          \"description\": \"Package and trust bootstrap travel as separate authenticated inputs\"\n        },\n        {\n          \"from\": \"operator\",\n          \"to\": \"managed\",\n          \"label\": \"Stage and activate in isolated account\",\n          \"description\": \"No production state or production keys are needed\"\n        },\n        {\n          \"from\": \"managed\",\n          \"to\": \"operator\",\n          \"label\": \"Report readiness or roll back\",\n          \"description\": \"Recovery retains sequence floor and exact predecessor\"\n        }\n      ]\n    },\n    \"companions\": [\n      {\n        \"kind\": \"diagram-mermaid\",\n        \"relPath\": \"docs/standalone/install-signed-v2-daemon-development-bundles-E20261114234b9967/S001/sequence-diagram.html\",\n        \"title\": \"Sequence diagram\"\n      }\n    ]\n  },\n  \"citations\": [\n    {\n      \"id\": \"c1\",\n      \"kind\": \"code\",\n      \"ref\": \"scripts/install-daemon-bundle.mjs\"\n    },\n    {\n      \"id\": \"c2\",\n      \"kind\": \"code\",\n      \"ref\": \"scripts/package-daemon-bootstrap.mjs\"\n    },\n    {\n      \"id\": \"c3\",\n      \"kind\": \"code\",\n      \"ref\": \"scripts/daemon-bundle-metadata.mjs\"\n    },\n    {\n      \"id\": \"c4\",\n      \"kind\": \"code\",\n      \"ref\": \"scripts/stage-daemon-bundle.mjs\"\n    },\n    {\n      \"id\": \"c5\",\n      \"kind\": \"code\",\n      \"ref\": \"scripts/package-daemon-candidate.mjs\"\n    },\n    {\n      \"id\": \"c6\",\n      \"kind\": \"code\",\n      \"ref\": \"scripts/insrc-daemon-install.sh\"\n    }\n  ]\n}\n","document":"<!-- insrc:artifact LLD-234b9967599e56d9-s1 -->\n\n# LLD: STORY-234b9967599e56d9-s1 — Install signed v2 daemon development bundles\n\n## Summary\n\n**Epic:** `install-signed-v2-daemon-development-bundles`\n**HLD base run:** `wf-1794671662903-6oo25p`\n**HLD effective hash:** `234b9967599e...`\n\nAn opt-in signed v2 bundle is built and installed on Apple Silicon without any main release or GitHub Actions dependency. Keep production signing and promotion main-only.\n\n## Contents\n\n1. [HLD context](#1-hld-context)\n2. [Contract details](#2-contract-details)\n3. [Data model changes](#3-data-model-changes)\n4. [Diagrams](#4-diagrams)\n5. [Error paths](#5-error-paths)\n6. [Test strategy](#6-test-strategy)\n7. [Migration](#7-migration)\n8. [Alternatives considered](#8-alternatives-considered)\n9. [References](#9-references)\n\n## 1. HLD context\n\n**Framework:** Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\n**Rollout phase:** standalone\n\n## 2. Contract details\n\n**Surface level:** public\n\n### 2.1 `Build v2 development bundle`\n\n```typescript\nexact v2 commit + dev version + sequence → archive and signed dev manifest\n```\n\n**Returns:** `result` — Verified development bundle or a refusal\n\n**Errors:**\n- `DevelopmentBundleRefused` when Origin, trust, target, isolation or compatibility check failed\n\n**Preconditions:**\n- Fetch v2 from the configured upstream and verify an exact commit reachable from that fetched branch; build in a clean detached worktree using the pinned runtime; run relevant checks locally.\n- Use a project-owned distinct development key offline or on an approved build host, separate from the release and qualification keys. No GitHub Release or workflow dispatch is needed.\n\n**Postconditions:**\n- Record v2 origin and commit, dev version, monotonic sequence, archive size/hash, measured runtime fingerprint, and any exact qualified predecessor in signed manifest. Keep version/channel and signature namespace distinct. Hand off the archive, manifest, detached signature and independently authenticated dev bootstrap through an internal channel.\n\n### 2.2 `Install or update v2 development bundle`\n\n```typescript\nauthenticated dev bootstrap + signed v2 manifest + archive → managed dev daemon\n```\n\n**Returns:** `result` — Verified development bundle or a refusal\n\n**Errors:**\n- `DevelopmentBundleRefused` when Origin, trust, target, isolation or compatibility check failed\n\n**Preconditions:**\n- Use a dedicated macOS account or VM with independent home, state, LaunchAgent and sockets. A marker alone is insufficient: fail before writing to an existing non-development installation; require explicit dev bootstrap entrypoint.\n- Pin the dev public key through the trusted bootstrap. Reject cross-domain signatures, wrong origin/target, digest mismatch and replay before executing any bundle code. Restore only exact transaction predecessor, offline, from same domain.\n\n**Postconditions:**\n- Fresh install takes no predecessor. Upgrade accepts only a signed compatible dev predecessor pinned to the installed manifest; preserve state and verify readiness or restore it. Scope existing CLI/MCP registration to the dev environment.\n- Main release and qualification reject development provenance and signatures at all gates; no production key on development hosts.\n\n## 3. Data model changes\n\n### 3.1 `Development bundle identity` — new\n\nSeparate development trust root, manifest namespace, v2 origin, sequence floor and installed proof; identity may use upstream repository and exact commit without invented Actions IDs. Preserve production manifest/evidence schemas and forbid dev predecessor on a production chain.\n\n**Call sites:**\n- `scripts/install-daemon-bundle.mjs`\n- `scripts/package-daemon-bootstrap.mjs`\n- `scripts/daemon-bundle-metadata.mjs`\n\n## 4. Diagrams\n\n- [Sequence diagram](docs/standalone/install-signed-v2-daemon-development-bundles-E20261114234b9967/S001/sequence-diagram.html)\n\n## 5. Error paths\n\n**Error cases**\n\n- **Development archive is substituted or submitted to a main signing gate** (recoverable)\n  - Detection: Check independently authenticated signer, domain, origin and archive digest.\n  - Response: Refuse before executing code or signing.\n  - User impact: Obtain original matching package.\n\n**Edge cases**\n\n| Input | Expected |\n| :--- | :--- |\n| Existing qualification or production state in same home | Fail closed before state or LaunchAgent mutation. |\n| Offline rollback after interrupted dev update | Reconcile exact pinned prior dev release and retain sequence floor. |\n\n## 6. Test strategy\n\n**Test framework:** `All tests local on Apple Silicon or fixtures; no hosted tests.`\n\n**Test levels**\n\n- **contract** — Prove development/production separation locally\n  - Subjects: `Build provenance and exact archive/runtime verification`, `Dev signature accepted only in dev; release signature accepted only in correct lane`, `Existing non-dev state untouched`\n- **live** — Verify actual bundle in disposable Apple Silicon environment\n  - Subjects: `Fresh install, MCP/CLI connection, restart, newer dev update and forced rollback offline`\n\n**Acceptance mapping**\n\n| Criterion | Proving tests |\n| :--- | :--- |\n| `ac1` | `Build and sign from exact fetched v2 in clean detached tree with no main dependency` |\n| `ac2` | `Local dev fresh install/update/restart/rollback; cross-domain and replay refusal` |\n\n## 7. Migration\n\n**State before:** v2 source install exists and development build artifacts are unsigned.\n\n**State after:** Opt-in signed development bundles install and upgrade in a dedicated environment.\n\n**Zero downtime:** no — **Data rewrite:** no\n\n**Steps**\n\n1. Distribute authenticated dev bootstrap and install into a clean isolated macOS account or VM; preserve any existing daemon installation. — ↩ rollbackable\n2. Qualify consecutive dev bundles and test offline rollback before internal use. Existing source installs may continue independently. — ↩ rollbackable\n\n**Backward compat:** No production state migration or changes to the default source installer. Migration of an existing source install into the dev bundle lane is deferred.\n\n## 8. Alternatives considered\n\n### 8.1 a1: Independent development bundle — **CHOSEN**\n\nBuild and sign v2 locally with development trust.\n\nUse the exact v2 commit on Apple Silicon to build the same package locally, then distribute and install it under a separate development trust domain.\n\n### 8.2 a2: Source install\n\nClone v2 and compile on each Mac.\n\nKeep --branch v2 as a source workflow with per-host package installation and compilation.\n\n**Rejected because:** Does not deploy a prebuilt candidate.\n\n## 9. References\n\n- **[[c1]]** `code` `scripts/install-daemon-bundle.mjs`\n- **[[c2]]** `code` `scripts/package-daemon-bootstrap.mjs`\n- **[[c3]]** `code` `scripts/daemon-bundle-metadata.mjs`\n- **[[c4]]** `code` `scripts/stage-daemon-bundle.mjs`\n- **[[c5]]** `code` `scripts/package-daemon-candidate.mjs`\n- **[[c6]]** `code` `scripts/insrc-daemon-install.sh`\n"},"capturedAt":"2026-11-14T15:54:50.015Z"},"inventory":{"units":[{"id":"/body/summary","selector":"/body/summary","title":"summary","kind":"section"},{"id":"/body/hldContextSlice","selector":"/body/hldContextSlice","title":"hldContextSlice","kind":"section"},{"id":"/body/contractDetails","selector":"/body/contractDetails","title":"contractDetails","kind":"section"},{"id":"/body/dataModelChanges","selector":"/body/dataModelChanges","title":"dataModelChanges","kind":"section"},{"id":"/body/interactionWithShared","selector":"/body/interactionWithShared","title":"interactionWithShared","kind":"section"},{"id":"/body/errorPaths","selector":"/body/errorPaths","title":"errorPaths","kind":"section"},{"id":"/body/testStrategy","selector":"/body/testStrategy","title":"testStrategy","kind":"section"},{"id":"/body/migration","selector":"/body/migration","title":"migration","kind":"section"},{"id":"/body/alternativesConsidered","selector":"/body/alternativesConsidered","title":"alternativesConsidered","kind":"section"},{"id":"/body/chosenAlternative","selector":"/body/chosenAlternative","title":"chosenAlternative","kind":"section"},{"id":"/body/openQuestions","selector":"/body/openQuestions","title":"openQuestions","kind":"section"},{"id":"/body/sequenceDefinition","selector":"/body/sequenceDefinition","title":"sequenceDefinition","kind":"visual"},{"id":"/body/companions","selector":"/body/companions","title":"companions","kind":"visual"},{"id":"/body/alternativesConsidered/0","selector":"/body/alternativesConsidered/0","title":"a1","kind":"requirement"},{"id":"/body/alternativesConsidered/1","selector":"/body/alternativesConsidered/1","title":"a2","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/0","selector":"/body/sequenceDefinition/participants/0","title":"builder","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/1","selector":"/body/sequenceDefinition/participants/1","title":"signer","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/2","selector":"/body/sequenceDefinition/participants/2","title":"operator","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/3","selector":"/body/sequenceDefinition/participants/3","title":"managed","kind":"requirement"},{"id":"/citations/0","selector":"/citations/0","title":"Citation 1","kind":"citation"},{"id":"/citations/1","selector":"/citations/1","title":"Citation 2","kind":"citation"},{"id":"/citations/2","selector":"/citations/2","title":"Citation 3","kind":"citation"},{"id":"/citations/3","selector":"/citations/3","title":"Citation 4","kind":"citation"},{"id":"/citations/4","selector":"/citations/4","title":"Citation 5","kind":"citation"},{"id":"/citations/5","selector":"/citations/5","title":"Citation 6","kind":"citation"},{"id":"document:line:25","selector":"document:line:25","title":"1. HLD context","kind":"section"},{"id":"document:line:82","selector":"document:line:82","title":"4. Diagrams","kind":"section"}]},"completedChunks":[{"chunkId":"build-provenance","status":"changes_requested","summary":"Reviewed the assigned build, provenance, development identity, alternatives, and citation units. The design establishes useful trust separation goals, but its development bundle contract is not yet traceable to a concrete manifest/bootstrap format, and the cited implementation currently supports only Actions-origin candidates and production/qualification bootstrap keys.","findings":[{"id":"BP-1","severity":"MED","location":"LLD §2.1 and §3.1 — Build v2 development bundle; Development bundle identity","message":"The development manifest and bootstrap contract is underspecified for implementation. It requires a separate development trust root and manifest namespace while preserving production schemas, but does not define the development manifest fields, signing domain, key-pinning representation, or how the installer selects and validates this identity. The cited metadata parser accepts only the production manifest shape and has only qualification/production signing namespaces; the cited bootstrap packager emits only production and qualification trust keys. Specify the development format and bootstrap contents, or explicitly define a compatible extension path, so independent implementations can produce and verify the same package.","evidenceReferences":["LLD §2.1–2.2 and §3.1","scripts/daemon-bundle-metadata.mjs: namespaces and readBundleManifest() require fixed v1 fields and qualification/production domains","scripts/package-daemon-bootstrap.mjs: bootstrap packaging loops only over production and qualification keys"]},{"id":"BP-2","severity":"MED","location":"LLD §2.1 — Build v2 development bundle; §8.1 — chosen alternative","message":"The chosen local build path does not explain how the exact fetched upstream commit and origin become authenticated provenance in the produced candidate. The cited candidate builder checks that its checkout HEAD matches the supplied commit, but records origin only when running under GitHub Actions; its Actions origin validator requires the commit to equal GITHUB_SHA on main or v2. The design instead requires a local exact-source build without a GitHub Actions dependency. Define the local origin verification and signed provenance inputs, including how the configured upstream and fetched branch are bound to the commit.","evidenceReferences":["LLD §2.1 preconditions/postconditions and §8.1","scripts/package-daemon-candidate.mjs: main() checks HEAD against commit; writeCandidateMetadata() calls dispatchOrigin() only when GITHUB_ACTIONS is true","scripts/package-daemon-candidate.mjs: dispatchOrigin() accepts only refs/heads/main or refs/heads/v2 with matching GITHUB_SHA"]}],"inspectedReferences":["/body/summary","/body/contractDetails","/body/dataModelChanges","/body/alternativesConsidered","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/chosenAlternative","/citations/1","/citations/2","/citations/4","document:line:25","/Users/subhagho/work/projects/insors/insrc/docs/standalone/install-signed-v2-daemon-development-bundles-E20261114234b9967/S001/LLD.md"],"limitations":[],"advice":[]},{"chunkId":"install-lifecycle","status":"changes_requested","summary":"The LLD states important authentication, isolation, compatibility, and rollback requirements, but the cited installer path does not implement a development trust domain or a separate development lifecycle. As written, the installation contract cannot be met by extending only the current documented entry points.","findings":[{"id":"IL-1","severity":"HIGH","location":"LLD §2.2, “Install or update v2 development bundle”; §3.1, “Development bundle identity”; §7 Migration","message":"The required development install domain and isolation boundary are not supported by the cited installer/bootstrap design. The LLD requires a separately pinned development key, cross-domain rejection, an explicit development bootstrap, and dedicated home, state, LaunchAgent, and socket locations. However, the bundle installer and verifier accept only `production` or `qualification`, the bootstrap packages only those two trust keys, and the installer uses fixed paths under `~/.insrc` and `~/.insrc-daemon-pilot-releases`. No development entry point or configurable independent lifecycle roots are identified. Consequently a development package cannot be installed through the cited path, and using it as written cannot satisfy the no-mutation guarantee for an existing non-development installation. Specify the development bootstrap/domain and how the isolated lifecycle roots are selected and enforced before mutation.","evidenceReferences":["LLD §2.2 preconditions/postconditions and §7 migration","scripts/install-daemon-bundle.mjs: `main()` restricts domain to `qualification`/`production` and fixes release/state/trust roots under `homedir()`","scripts/verify-daemon-bundle.mjs: `main()` accepts only `production`/`qualification`; trust key is loaded from `./trust/${domain}.pem`","scripts/package-daemon-bootstrap.mjs: key packaging loops only over production and qualification","scripts/daemon-bundle-metadata.mjs: `namespaces` contains only qualification and production"]}],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/body/errorPaths","/body/migration","/citations/0","/citations/1","/citations/3","/citations/5","/Users/subhagho/work/projects/insors/insrc/docs/standalone/install-signed-v2-daemon-development-bundles-E20261114234b9967/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/v2-dev-install-234b9967.json"],"limitations":[],"advice":[]},{"chunkId":"tests-and-acceptance","status":"changes_requested","summary":"The test strategy covers the main build and lifecycle scenarios, but its acceptance mapping does not make the required assertions traceable to concrete tests. In particular, it does not explicitly prove preservation of non-development state or identify the required trust-domain rejection cases as separate assertions.","findings":[{"id":"test-mapping-coverage","severity":"MED","location":"/body/testStrategy — Test levels and Acceptance mapping","message":"The acceptance mapping reduces the requirements to two broad test descriptions without defining the assertions that prove them. `ac2` mentions cross-domain and replay refusal, but does not explicitly map tests to wrong origin/target, digest mismatch, refusal before mutation, preservation of existing non-development state, readiness/state preservation after update, or exact-predecessor offline rollback. The contract subject “Existing non-dev state untouched” is not tied to an acceptance criterion or a concrete assertion. This leaves important security and lifecycle acceptance claims difficult to verify consistently.","evidenceReferences":["LLD.md §2.2: requires rejection of wrong origin/target, digest mismatch, replay before execution, and preservation/readiness or restoration on upgrade.","LLD.md §5: requires failure before mutation for existing qualification/production state and exact pinned predecessor reconciliation during offline rollback.","LLD.md §6: contract and live subjects and the `ac1`/`ac2` mapping do not enumerate those proofs."]}],"inspectedReferences":["/body/testStrategy","/Users/subhagho/work/projects/insors/insrc/docs/standalone/install-signed-v2-daemon-development-bundles-E20261114234b9967/S001/LLD.md","LLD.md §2.1–2.2, §5–6","scripts/package-daemon-candidate.mjs","scripts/__tests__/stage-daemon-bundle.test.ts","scripts/__tests__/daemon-release-artifact.test.ts","scripts/__tests__/daemon-release-policy.test.ts"],"limitations":[],"advice":["Map each acceptance criterion to named contract/live tests and state the expected assertions, including failed input, refusal timing, and unchanged state where applicable.","The local fixture approach is plausible for deterministic provenance and trust-boundary checks; specify the disposable Apple Silicon setup and cleanup/reset assumptions for lifecycle tests so fresh install, restart, update, and offline rollback can be repeated safely."]},{"chunkId":"sequence-artifact","status":"incomplete","summary":"The sequence definition and companion source communicate the broad build-to-install handoff, but omit security-critical ordering and recovery detail: the installer appears to stage and activate without an explicit verification gate, and readiness failure/rollback is not represented. The linked HTML source was inspected, but its rendered diagram could not be visually verified because browser access was unavailable.","findings":[{"id":"SEQ-1","severity":"MED","location":"LLD §4, sequence diagram; /body/sequenceDefinition/messages[2–3]","message":"The sequence jumps from “Stage and activate in isolated account” to “Report readiness or roll back,” without showing the required verification and refusal gates before bundle execution or activation. The LLD requires authenticating the bootstrap, validating the signed manifest, origin, target, digest, and replay status before executing bundle code; it also requires readiness verification before retaining an upgrade or restoring the exact pinned predecessor. The sequence should distinguish verification from activation and make the failed-readiness rollback path explicit, so it does not imply unverified input can be activated.","evidenceReferences":["LLD §2.2 preconditions/postconditions: authenticate bootstrap and reject cross-domain signatures, wrong origin/target, digest mismatch, and replay before executing code; verify readiness or restore predecessor.","sequence-diagram.html Mermaid source: `operator->>managed: Stage and activate in isolated account`; `managed->>operator: Report readiness or roll back`."]}],"inspectedReferences":["/body/sequenceDefinition","/body/sequenceDefinition/participants/0","/body/sequenceDefinition/participants/1","/body/sequenceDefinition/participants/2","/body/sequenceDefinition/participants/3","/body/companions","document:line:82","/Users/subhagho/work/projects/insors/insrc/docs/standalone/install-signed-v2-daemon-development-bundles-E20261114234b9967/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/docs/standalone/install-signed-v2-daemon-development-bundles-E20261114234b9967/S001/sequence-diagram.html","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-234b9967599e56d9-s1.json","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/v2-dev-install-234b9967.json","LLD §2.2 preconditions and postconditions","sequence-diagram.html Mermaid source: participants and messages"],"limitations":["Could not inspect the rendered diagram: the computer-use browser inventory reported that the browser access host was unavailable, and no local browser renderer was available. The companion HTML source and embedded Mermaid definition were inspected; visual rendering is unverified."],"advice":[]},{"chunkId":"citations-and-scope","status":"changes_requested","summary":"The LLD states important trust and isolation constraints, but its scope and refusal/recovery sections do not fully translate them into actionable boundaries and outcomes. All six cited scripts were inspected; several cited paths are described only by name and do not define the new development-specific contracts.","findings":[{"id":"scope-error-contracts","severity":"MED","location":"/body/hldContextSlice, /body/interactionWithShared, /body/errorPaths","message":"The standalone boundary declares no owned or consumed contracts, no adjacent boundaries, and no shared interactions, while the design changes the bootstrap trust roots, bundle metadata namespace, installer entry point, and managed state/lifecycle. The sole error case covers substitution or submission to a main signing gate; it does not define refusal and recovery outcomes for wrong origin/target, digest or replay failures, bootstrap trust failure, conflicting installed state, or interrupted update reconciliation. Although some checks appear in the contract preconditions, the error-path section does not specify which state is left untouched, whether retry is safe, or how the exact predecessor and sequence floor are recovered. Clarify ownership and affected shared boundaries, then define those failure outcomes so implementation and acceptance can be traced consistently.","evidenceReferences":["LLD §2.2: authenticated bootstrap, cross-domain/origin/target/digest/replay rejection, same-domain exact-predecessor recovery and sequence-floor requirements.","LLD §3.1 and `interactionWithShared`: new trust root, manifest namespace, sequence floor and installed proof are proposed, while ownership and shared interactions remain empty.","LLD §5 and `/body/errorPaths`: one substitution/main-signing error case and two terse edge-case expectations; no outcomes for bootstrap failure, wrong origin/target, digest/replay refusal, or interrupted recovery.","scripts/install-daemon-bundle.mjs: installer accepts only qualification/production and performs lifecycle work under fixed `~/.insrc` and `~/.insrc-daemon-pilot-releases` roots.","scripts/package-daemon-bootstrap.mjs and scripts/daemon-bundle-metadata.mjs: bootstrap keys and signature namespaces currently cover only production and qualification."]}],"inspectedReferences":["/body/hldContextSlice","/body/interactionWithShared","/body/errorPaths","/body/openQuestions","/citations/0","/citations/1","/citations/2","/citations/3","/citations/4","/citations/5","/Users/subhagho/work/projects/insors/insrc/docs/standalone/install-signed-v2-daemon-development-bundles-E20261114234b9967/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/v2-dev-install-234b9967.json","scripts/install-daemon-bundle.mjs","scripts/package-daemon-bootstrap.mjs","scripts/daemon-bundle-metadata.mjs","scripts/stage-daemon-bundle.mjs","scripts/package-daemon-candidate.mjs","scripts/insrc-daemon-install.sh"],"limitations":[],"advice":["Add a concise scope/non-goals statement identifying the development bootstrap, trust metadata, and isolated lifecycle as owned surfaces, plus any existing contracts that must remain unchanged.","Expand the error table to cover each refusal gate and interrupted-update recovery, including required no-mutation guarantees, resulting state, and safe retry or rollback behavior."]},{"chunkId":"consistency","status":"incomplete","summary":"The completed chunks cover the LLD’s build provenance, install lifecycle, tests, sequence artifact, scope, errors, and citations. Their findings align across sections: the proposed development trust/install path lacks a defined format and isolated installer path; acceptance tests do not trace all required refusal and recovery guarantees; and the sequence omits explicit verification gates. I found no additional cross-section contradiction that warrants a separate finding. The diagram’s actual rendering remains unverified, so the review is incomplete.","findings":[],"inspectedReferences":["/Users/subhagho/work/projects/insors/insrc/docs/standalone/install-signed-v2-daemon-development-bundles-E20261114234b9967/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/v2-dev-install-234b9967.json","checkpoint completed feedback: build-provenance (BP-1, BP-2), install-lifecycle (IL-1), tests-and-acceptance (test-mapping-coverage), sequence-artifact (SEQ-1), citations-and-scope (scope-error-contracts)"],"limitations":["The sequence diagram’s rendered appearance was not verified; the sequence-artifact chunk reports that browser access was unavailable and no local browser renderer was available. Its source was inspected there, but visual rendering remains a required unverified check."],"advice":["Resolve the existing findings BP-1, BP-2, IL-1, test-mapping-coverage, SEQ-1, and scope-error-contracts together: define the development trust/bootstrap and isolated lifecycle contract, trace each security and recovery criterion to explicit assertions, and align the sequence with those gates. Avoid duplicating these issues under new finding IDs."]}],"progress":{"status":"incomplete","phase":"complete","completedChunks":6,"totalChunks":6,"lastMeaningfulActivityAt":null,"activeToolCount":0,"requiresUserInput":false,"checkpointPath":"/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/v2-dev-install-234b9967.json","sequence":0,"reviewElapsedMs":0,"unitElapsedMs":null,"observedAt":"2026-11-14T15:59:20.840Z","freshness":"stored"},"startedAt":"2026-11-14T15:54:49.968Z","reviewer":"daemon","model":"gpt-6-luna","unit":{"unitId":"consistency","phase":"chunk_review","executionId":"1163952b-0eb5-421a-aa1e-712ff6650113","dispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[]},"plan":{"chunks":[{"id":"build-provenance","title":"Build provenance, signing, and development bundle identity","selectors":["/body/summary","/body/contractDetails","/body/dataModelChanges","/body/alternativesConsidered","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/chosenAlternative","/citations/1","/citations/2","/citations/4","document:line:25"],"concerns":["Assess the build contract against its provenance, exact-source, runtime, archive, key-separation, and manifest requirements.","Assess the development identity fields and compatibility with preserved production manifest and evidence schemas.","Assess both alternatives and the chosen alternative against the stated requirements and rationale.","Trace build and metadata claims to the cited implementation."],"dependsOn":[],"purpose":"substantive"},{"id":"install-lifecycle","title":"Bootstrap trust, installation isolation, and managed lifecycle","selectors":["/body/contractDetails","/body/dataModelChanges","/body/errorPaths","/body/migration","/citations/0","/citations/1","/citations/3","/citations/5"],"concerns":["Assess bootstrap authentication, domain and target checks, replay protection, and refusal before execution or mutation.","Assess isolation boundaries, fresh install, upgrade compatibility, readiness, state preservation, and exact offline rollback.","Trace installer and lifecycle requirements to the cited scripts; assess migration and backward compatibility."],"dependsOn":["build-provenance"],"purpose":"substantive"},{"id":"tests-and-acceptance","title":"Test strategy and acceptance traceability","selectors":["/body/testStrategy"],"concerns":["Assess that contract and live tests prove each acceptance criterion, including provenance, trust-domain rejection, non-development-state preservation, install, restart, update, and offline rollback.","Assess feasibility and coverage of local fixtures and disposable Apple Silicon environments."],"dependsOn":["build-provenance","install-lifecycle"],"purpose":"substantive"},{"id":"sequence-artifact","title":"Build-to-install sequence and companion diagram","selectors":["/body/sequenceDefinition","/body/sequenceDefinition/participants/0","/body/sequenceDefinition/participants/1","/body/sequenceDefinition/participants/2","/body/sequenceDefinition/participants/3","/body/companions","document:line:82"],"concerns":["Assess participant responsibilities and message ordering against build, signing, handoff, verification, activation, readiness, and rollback contracts.","Inspect the linked diagram source and actual rendering where available; check consistency with the sequence definition and LLD."],"dependsOn":["build-provenance","install-lifecycle"],"purpose":"substantive"},{"id":"citations-and-scope","title":"Scope, error paths, references, and unresolved decisions","selectors":["/body/hldContextSlice","/body/interactionWithShared","/body/errorPaths","/body/openQuestions","/citations/0","/citations/1","/citations/2","/citations/3","/citations/4","/citations/5"],"concerns":["Assess standalone scope, boundaries, non-goals, and any interaction with existing shared contracts.","Assess refusal and recovery behavior for substitution, main signing gates, conflicting installed state, and interrupted offline updates.","Check all cited implementation references and whether the document identifies unresolved decisions needed to implement the contracts."],"dependsOn":[],"purpose":"substantive"},{"id":"consistency","title":"Cross-section and upstream consistency","selectors":[],"concerns":["Check complete requirement coverage, contract and error-path consistency, test traceability, dependency feasibility, and alignment among the LLD, cited code, and diagram.","Confirm every inventory unit was substantively assessed and check for contradictions or omissions across chunks."],"dependsOn":["build-provenance","install-lifecycle","tests-and-acceptance","sequence-artifact","citations-and-scope"],"purpose":"consistency"}],"coverageExplanation":"Substantive chunks group the build and trust model, install lifecycle, test proof, sequence artifact, and scope/error/reference checks by implementation responsibility. The alternatives section and both alternatives have explicit substantive coverage in build-provenance. Repeated inventory units are mapped to every relevant chunk. The final consistency chunk depends on all substantive chunks and checks cross-section alignment.","finalConsistencyChunkId":"consistency","coverage":[{"unitId":"/body/summary","chunkIds":["build-provenance"]},{"unitId":"/body/hldContextSlice","chunkIds":["citations-and-scope"]},{"unitId":"/body/contractDetails","chunkIds":["build-pr