155366	{"artifactId":"LLD-4642d49ab0593787-s1","entry":{"id":"7e651f7481c543d64bd776774e0041f05264a59011aa2c995a95a2fecd0c5a27","targetHeadHash":"78bf0a506d55df6e2f3c28043759d8ed846213d91fd87d1d221324d1b815befa","actor":{"id":"agent:design-review-daemon","kind":"agent","properties":{"party":"daemon"}},"timestamp":"2026-11-13T06:47:49.130Z","operation":"review","revision":{"number":1,"contentHash":"c9de5ad6e9fb7e60f3e9dc8cbbb895313733a3ec40e9b9c77e9faa8ce7cb4958"},"outcome":{"result":"block","summary":"Design review lld-4642d49ab0593787-s1-r1 attempt 1","data":{"kind":"design-chunk-review","reviewId":"lld-4642d49ab0593787-s1-r1","project":"/Users/subhagho/work/projects/insors/insrc","artifactId":"LLD-4642d49ab0593787-s1","subject":{"project":"/Users/subhagho/work/projects/insors/insrc","artifactId":"LLD-4642d49ab0593787-s1","kind":"LLD","canonicalPath":"/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-4642d49ab0593787-s1.json","documentPath":"/Users/subhagho/work/projects/insors/insrc/docs/standalone/vs-code-plugin-scratchpads-insrc-scratches-E202611134642d49a/S001/LLD.md","reviewer":"daemon","workflow":{"kind":"standalone","rootArtifactId":"LLD-4642d49ab0593787-s1","requiredReferences":[],"availableReferences":[],"notApplicableRoles":["PLAN","TASKS","BUILD","CR","DEF","HLD","sibling_stories"]}},"reviewer":"daemon","applicableAttempt":1,"status":"incomplete","binding":{"sourceRevision":{"number":1,"contentHash":"c9de5ad6e9fb7e60f3e9dc8cbbb895313733a3ec40e9b9c77e9faa8ce7cb4958"},"reviewedContentIdentity":"b3b74853d34c7d31d200101539028fa0d9c18fbd00bf150d1336dcf72c124347","documentDigest":"18c12372bd10d961ef5d5c3f03c5d9d4654e25fe459c76255fbef6f046fb939e","workflowDigest":"993a8d4f1dc6f856b6ab4a9b77bba5b0fe1b8e3ba81973cdf39d33ff97093210","author":"controller"},"preservationDigest":"99f869ccdcd0c3cb02938d9bcd1c435a149c3900d40da8714b06c51c2cdfed8b","schemaVersion":1,"submitted":{"artifactPath":"/Users/subhagho/work/projects/insors/insrc/docs/standalone/vs-code-plugin-scratchpads-insrc-scratches-E202611134642d49a/S001/LLD.md","attempt":1},"attempts":[{"number":1,"status":"incomplete","preparationKind":"planning","baseline":{"subjectFingerprints":{"canonical":"eff07fc60138151531a8a0031e1a7fc506c48f91961553ab976837b3e504eb0e","document":"18c12372bd10d961ef5d5c3f03c5d9d4654e25fe459c76255fbef6f046fb939e"},"contentIdentity":"b3b74853d34c7d31d200101539028fa0d9c18fbd00bf150d1336dcf72c124347","reviewedContent":{"canonical":"{\n  \"meta\": {\n    \"workflow\": \"design.story\",\n    \"runId\": \"wf-1794551362794-fdm5ky\",\n    \"repoPath\": \"/Users/subhagho/work/projects/insors/insrc\",\n    \"createdAt\": \"2026-11-13T06:38:38.894Z\",\n    \"epicCreatedAt\": \"2026-11-13T06:38:38.894Z\",\n    \"attribution\": {\n      \"outputs\": [\n        {\n          \"role\": \"(client)\",\n          \"tier\": \"core\",\n          \"runner\": \"cli-claude\",\n          \"model\": \"unknown\"\n        }\n      ]\n    },\n    \"elapsedMs\": 555617,\n    \"repoIndexedAt\": null,\n    \"schemaVersion\": 1,\n    \"epicHash\": \"4642d49ab0593787\",\n    \"epicSlug\": \"vs-code-plugin-scratchpads-insrc-scratches\",\n    \"storyId\": \"s1\",\n    \"hldBaseRunId\": \"wf-1794551362794-fdm5ky\",\n    \"hldEffectiveHash\": \"4642d49ab05937875f19515259d7eb6462b9450c4f63748f90ab18e833fe595e\",\n    \"hldAmendmentsApplied\": [],\n    \"storyTitle\": \"VS Code plugin scratchpads: ~/.insrc/scratches store, chat-input scratchpad button with recent/new/browse-all menu, tabular browse webview, Send-to-chat on text selection\",\n    \"standalone\": true,\n    \"sizeClass\": \"small\",\n    \"triageRationale\": \"Triage classified this as a feature (one cohesive story) reusing the chat webview attach-button/popup/PanelFactory/PATHS.insrc-store patterns; new surface is the ~/.insrc/scratches dir, new protocol message types, and a new scratchpad module + panels. Routed to standalone design.story (LLD) -> plan -> build.\",\n    \"authoredBy\": \"controller\",\n    \"lifecycle\": {\n      \"status\": \"draft\",\n      \"revision\": {\n        \"number\": 1,\n        \"contentHash\": \"c9de5ad6e9fb7e60f3e9dc8cbbb895313733a3ec40e9b9c77e9faa8ce7cb4958\",\n        \"at\": \"2026-11-13T06:38:39.561Z\",\n        \"by\": {\n          \"id\": \"insrc:system\",\n          \"kind\": \"system\",\n          \"properties\": {}\n        }\n      },\n      \"signoffs\": []\n    },\n    \"revision\": 1\n  },\n  \"body\": {\n    \"alternativesConsidered\": [\n      {\n        \"id\": \"a1\",\n        \"name\": \"Chat-webview menu + dedicated scratchpad webview panels (all-in-plugin, plain files)\",\n        \"oneLineSummary\": \"Smallest fully-meeting shape: reuse the chat popup for the menu, new webview viewTypes for browse-all and the scratchpad document with floating Send-to-chat; storage via a new vscode-free scratch-store over ~/.insrc/scratches.\",\n        \"approach\": \"One new vscode-free module `vscode-plugin/src/chat/scratch-store.ts` (ScratchFs + node impl; list/create/read/delete over `~/.insrc/scratches/*.md` named `<yyyymmdd-hhmmss>-<slug>.md`), wired in extension.ts next to the attachment store as `join(PATHS.insrc, 'scratches')`. Chat webview: sibling `.attachbtn`-class icon button `#insrc-scratch` next to `#insrc-attach` opening the existing `.popup`/`.item` menu with recent items (top 5 by mtime), New, and Browse-all rows; new message types in protocol.ts. Browse-all = new webview panel viewType `insrc.scratchpads` via the injected PanelFactory with a name/date/icon-only open-delete table. Opening a scratchpad = document viewType `insrc.scratchpad` with a floating Send-to-chat button on selection posting `send-to-chat`; host pushes `insert-into-input`; the chat webview inserts the text and focuses the input.\",\n        \"pros\": [\n          \"Matches existing patterns exactly (attach button family, histmenu popup, PanelFactory, PATHS.insrc stores, protocol lists) — least new surface, fully testable with fake-dom + fake fs.\",\n          \"No daemon IPC, plain files only — exactly the requested scope.\",\n          \"Icon-only buttons with title tooltips come free from the `.attachbtn`/`.popup .item` CSS family.\"\n        ],\n        \"cons\": [\n          \"One new host→webview input-insertion message is needed (none exists).\",\n          \"The selection-handler script lives in the scratchpad document view, not the chat panel.\"\n        ],\n        \"costEstimate\": \"M\"\n      },\n      {\n        \"id\": \"a2\",\n        \"name\": \"Native QuickPick + text-document editor with command-based send-to-chat\",\n        \"oneLineSummary\": \"Host-side QuickPick menu and a real text editor for scratchpads; selection send-to-chat via command rather than a floating webview button.\",\n        \"approach\": \"VS Code native `window.showQuickPick` for the menu (host-side), `window.createWebviewPanel` for the browse-all table, `vscode.window.showTextDocument` for opening a scratchpad (a real editor), Send-to-chat as a registered command on a status-bar affordance.\",\n        \"pros\": [\n          \"QuickPick is native, zero webview code for the menu.\",\n          \"A real text document gives syntax highlighting for free.\"\n        ],\n        \"cons\": [\n          \"Native QuickPick moves the menu out of the in-panel dropdown next to the attach button.\",\n          \"A real text document cannot show a floating button on text selection — the user explicitly wants selection → floating button, which forces a webview document view anyway.\",\n          \"More host-side VS Code API surface, less reuse of the proven in-webview patterns.\"\n        ],\n        \"costEstimate\": \"M\",\n        \"reasonRejected\": \"Rank 3: a native QuickPick moves the menu out of the requested in-panel location next to attach, and a real text document cannot show the required floating Send-to-chat button on selection — the defining interaction is violated.\"\n      },\n      {\n        \"id\": \"a3\",\n        \"name\": \"Sidebar tree view for browse-all + webview reader\",\n        \"oneLineSummary\": \"Register a scratchpads TreeDataProvider in a sidebar; chat button opens recent/new; tree provides browse-all and open/delete.\",\n        \"approach\": \"Scratchpads as a sidebar tree view (`TreeDataProvider` over ~/.insrc/scratches); chat button only for new/recent; browse-all = the tree itself; open renders in a webview reader pane.\",\n        \"pros\": [\n          \"Native VS Code navigation for the file list.\",\n          \"Delete/open are one-click in the tree.\"\n        ],\n        \"cons\": [\n          \"Adds a sidebar contribution point (package.json views + tree provider) — more surface than asked; the user asked for a button next to attach + a tabular editor pane.\",\n          \"Tree views don't natively offer per-row icon-only open/delete buttons with hover text in the requested tabular layout.\"\n        ],\n        \"costEstimate\": \"L\",\n        \"reasonRejected\": \"Rank 4: a sidebar TreeDataProvider is not the requested editor-pane tabular view with per-row icon-only open/delete buttons, and adds an unrequested package.json views contribution (L cost).\"\n      },\n      {\n        \"id\": \"a4\",\n        \"name\": \"Single-webview overlay for browse + view\",\n        \"oneLineSummary\": \"Menu in chat webview; browse-all and scratchpad viewing as overlays within the same chat webview.\",\n        \"approach\": \"Chat-webview popup for the menu, but browse-all and single-scratchpad viewing rendered as overlay panes inside the SAME chat webview (no separate panel), with the Send-to-chat floating button inside that overlay.\",\n        \"pros\": [\n          \"One webview to maintain.\",\n          \"Send-to-chat insertion is same-document.\"\n        ],\n        \"cons\": [\n          \"Overlays complicate the chat panel's state machine/viewGeneration logic; a separate panel matches the existing PanelFactory.\",\n          \"Selection handling inside the chat transcript collides with the existing selection-decision/edit-mode feature.\"\n        ],\n        \"costEstimate\": \"M\",\n        \"reasonRejected\": \"Rank 2: an overlay inside the chat webview is not an editor-pane panel, and selection handling there collides with the existing in-chat selection-decision/edit-mode feature.\"\n      }\n    ],\n    \"chosenAlternative\": \"a1\",\n    \"componentDependencyDefinition\": {\n      \"components\": [\n        {\n          \"description\": \"New vscode-free, deps-injected store (ScratchFs interface + node impl) managing plain .md files under ~/.insrc/scratches: list/create/read/delete, id validation, temp+rename writes. Mirrors attachment-store.ts.\",\n          \"id\": \"scratch-store\",\n          \"path\": \"vscode-plugin/src/chat/scratch-store.ts\"\n        },\n        {\n          \"description\": \"Webview-to-host and host-to-webview message unions plus the HOST_TO_WEBVIEW_TYPES / WEBVIEW_TO_HOST_TYPES const arrays (exhaustiveness asserted in protocol.test.ts). Gains the eight scratchpad message types.\",\n          \"id\": \"protocol\",\n          \"path\": \"vscode-plugin/src/chat/protocol.ts\"\n        },\n        {\n          \"description\": \"Inline-HTML chat webview: gains the #insrc-scratch .attachbtn sibling button next to #insrc-attach, the #insrc-scratchmenu .popup.chatmenu, bootstrap listeners, host-side switch cases, and the insert-into-input handler on #insrc-prompt.\",\n          \"id\": \"chat-panel\",\n          \"path\": \"vscode-plugin/src/chat/chat-panel.ts\"\n        },\n        {\n          \"description\": \"Extension activation: constructs createScratchStore with root join(PATHS.insrc, 'scratches') next to the attachment store (~:635), registers the scratch message handlers, and injects the panels factory (:447) used for the two new viewTypes.\",\n          \"id\": \"extension\",\n          \"path\": \"vscode-plugin/src/extension.ts\"\n        },\n        {\n          \"description\": \"VS-Code-free core creating webview panels with the shared CSP+nonce shell and create-or-reveal single-instance lifecycle; backs the insrc.scratchpads (tabular browse) and insrc.scratchpad (document + floating Send-to-chat) viewTypes.\",\n          \"id\": \"panels\",\n          \"path\": \"vscode-plugin/src/panels/webview-host.ts\"\n        },\n        {\n          \"description\": \"Shared path constant: PATHS.insrc = join(homedir(), '.insrc'); the scratches root derives from it, never a hard-coded path.\",\n          \"id\": \"paths\",\n          \"path\": \"src/shared/paths.ts\"\n        }\n      ],\n      \"dependencies\": [\n        {\n          \"from\": \"extension\",\n          \"label\": \"constructs and wires\",\n          \"to\": \"scratch-store\"\n        },\n        {\n          \"from\": \"extension\",\n          \"label\": \"registers host handlers for\",\n          \"to\": \"protocol\"\n        },\n        {\n          \"from\": \"extension\",\n          \"label\": \"passes panels factory + store into\",\n          \"to\": \"chat-panel\"\n        },\n        {\n          \"from\": \"extension\",\n          \"label\": \"creates scratch view panels through\",\n          \"to\": \"panels\"\n        },\n        {\n          \"from\": \"chat-panel\",\n          \"label\": \"sends/receives typed messages via\",\n          \"to\": \"protocol\"\n        },\n        {\n          \"from\": \"extension\",\n          \"label\": \"derives scratches root from\",\n          \"to\": \"paths\"\n        }\n      ],\n      \"id\": \"scratchpads-components\",\n      \"narrative\": \"Shows the module boundary of the scratchpad feature: one new vscode-free store module, additive protocol messages, chat-webview DOM/bootstrap, extension wiring, and the shared panel factory — with zero daemon/DB modules in the dependency set, matching the no-daemon-IPC constraint.\"\n    },\n    \"contractDetails\": {\n      \"api\": [\n        {\n          \"errors\": [\n            {\n              \"condition\": \"root path is not a directory or mkdir fails (EACCES/ENOSPC)\",\n              \"type\": \"ScratchStoreError\"\n            },\n            {\n              \"condition\": \"id fails the ^[A-Za-z0-9._-]+$ validation\",\n              \"type\": \"ScratchRefused\"\n            }\n          ],\n          \"name\": \"createScratchStore\",\n          \"parameters\": [\n            {\n              \"name\": \"deps\",\n              \"optional\": false,\n              \"purpose\": \"Deps-injected root + fs + clock, mirroring createAttachmentStore at vscode-plugin/src/extension.ts:635 (root = join(PATHS.insrc, 'scratches'), PATHS.insrc = join(homedir(), '.insrc') per src/shared/paths.ts:4-8)\",\n              \"type\": \"{ root: string; fs: ScratchFs; now?: () => Date; logger?: Logger }\"\n            }\n          ],\n          \"postconditions\": [\n            \"Store is ready; the scratches root exists or is created lazily on first write\",\n            \"No daemon IPC is involved — pure filesystem\"\n          ],\n          \"preconditions\": [\n            \"deps.root is an absolute path under ~/.insrc\"\n          ],\n          \"returns\": {\n            \"meaning\": \"Store handle exposing list/create/read/delete; vscode-free so fake-dom/fake-fs tests can drive it\",\n            \"type\": \"ScratchStore\"\n          },\n          \"signature\": \"function createScratchStore(deps: ScratchStoreDeps): ScratchStore\"\n        },\n        {\n          \"errors\": [\n            {\n              \"condition\": \"readdir ENOENT (no scratches dir yet)\",\n              \"type\": \"returns [] (empty list, not an error)\"\n            },\n            {\n              \"condition\": \"readdir EACCES/other\",\n              \"type\": \"ScratchStoreError\"\n            }\n          ],\n          \"name\": \"listScratches\",\n          \"parameters\": [\n            {\n              \"name\": \"limit?\",\n              \"optional\": true,\n              \"purpose\": \"Cap the returned list (menu shows top 5 recent by mtime; browse-all passes no limit)\",\n              \"type\": \"number | undefined\"\n            }\n          ],\n          \"postconditions\": [\n            \"Entries are sorted by mtime descending (most recent first)\",\n            \"Each entry carries id, name, mtime and size; ids are the file basenames\"\n          ],\n          \"preconditions\": [\n            \"Store created via createScratchStore\"\n          ],\n          \"returns\": {\n            \"meaning\": \"Metadata for every ~/.insrc/scratches/*.md file\",\n            \"type\": \"ScratchEntry[]\"\n          },\n          \"signature\": \"function listScratches(limit?: number): Promise<ScratchEntry[]>\"\n        },\n        {\n          \"errors\": [\n            {\n              \"condition\": \"slug collision after the -2/-3 suffix ladder\",\n              \"type\": \"ScratchStoreError\"\n            },\n            {\n              \"condition\": \"write EACCES/ENOSPC\",\n              \"type\": \"ScratchStoreError\"\n            }\n          ],\n          \"name\": \"createScratch\",\n          \"parameters\": [\n            {\n              \"name\": \"title\",\n              \"optional\": false,\n              \"purpose\": \"Human title for the new scratchpad; slugified into the file name\",\n              \"type\": \"string\"\n            },\n            {\n              \"name\": \"body?\",\n              \"optional\": true,\n              \"purpose\": \"Initial content; omitted = a short starter line inviting notes\",\n              \"type\": \"string | undefined\"\n            }\n          ],\n          \"postconditions\": [\n            \"A new file <yyyymmdd-hhmmss>-<slug>.md exists under the root (collision suffixes -2, -3, ...)\",\n            \"Write is temp-file + rename so no partial file is ever visible\",\n            \"The new entry appears at the head of listScratches\"\n          ],\n          \"preconditions\": [\n            \"title is a non-empty string\"\n          ],\n          \"returns\": {\n            \"meaning\": \"The created entry's metadata\",\n            \"type\": \"Promise<ScratchEntry>\"\n          },\n          \"signature\": \"function createScratch(title: string, body?: string): Promise<ScratchEntry>\"\n        },\n        {\n          \"errors\": [\n            {\n              \"condition\": \"id fails ^[A-Za-z0-9._-]+$ validation\",\n              \"type\": \"ScratchRefused\"\n            },\n            {\n              \"condition\": \"read ENOENT (already deleted)\",\n              \"type\": \"ScratchNotFound\"\n            }\n          ],\n          \"name\": \"readScratch\",\n          \"parameters\": [\n            {\n              \"name\": \"id\",\n              \"optional\": false,\n              \"purpose\": \"File basename of the scratchpad to open in the document view\",\n              \"type\": \"string\"\n            }\n          ],\n          \"postconditions\": [\n            \"The full markdown content is returned for rendering\",\n            \"Content is rendered via textContent/escapeHtml only — CSP invariant kept\"\n          ],\n          \"preconditions\": [\n            \"Store created; id matches the validation regex before any fs call\"\n          ],\n          \"returns\": {\n            \"meaning\": \"Full text content plus entry metadata\",\n            \"type\": \"Promise<{ entry: ScratchEntry; content: string }>\"\n          },\n          \"signature\": \"function readScratch(id: string): Promise<{ entry: ScratchEntry; content: string }>\"\n        },\n        {\n          \"errors\": [\n            {\n              \"condition\": \"id fails ^[A-Za-z0-9._-]+$ validation\",\n              \"type\": \"ScratchRefused\"\n            },\n            {\n              \"condition\": \"rm ENOENT\",\n              \"type\": \"treated as success (delete is idempotent)\"\n            }\n          ],\n          \"name\": \"deleteScratch\",\n          \"parameters\": [\n            {\n              \"name\": \"id\",\n              \"optional\": false,\n              \"purpose\": \"File basename to delete from the browse table row or the document view\",\n              \"type\": \"string\"\n            }\n          ],\n          \"postconditions\": [\n            \"The file is gone (or was already gone) and drops out of listScratches\",\n            \"Deleting the currently open document closes that panel\"\n          ],\n          \"preconditions\": [\n            \"Store created; id matches the validation regex before any fs call\"\n          ],\n          \"returns\": {\n            \"meaning\": \"Void\",\n            \"type\": \"Promise<void>\"\n          },\n          \"signature\": \"function deleteScratch(id: string): Promise<void>\"\n        },\n        {\n          \"errors\": [\n            {\n              \"condition\": \"unknown payload.type in the host switch\",\n              \"type\": \"ignored (never throws — postMessage failures are swallowed per extension.ts:465-468 pattern)\"\n            }\n          ],\n          \"name\": \"chat host message handlers (switch on payload.type, chat-panel.ts:3566 pattern)\",\n          \"parameters\": [\n            {\n              \"name\": \"msg\",\n              \"optional\": false,\n              \"purpose\": \"Webview→host messages 'scratch-open-menu' | 'scratch-new' | 'scratch-open' {id} | 'scratch-delete' {id} | 'scratch-browse' | 'send-to-chat' {text}; host→webview 'scratch-list' {entries} | 'insert-into-input' {text} — all added to the protocol.ts unions (:346) and both const lists HOST_TO_WEBVIEW_TYPES (:378) / WEBVIEW_TO_HOST_TYPES (:403), exhaustiveness asserted in protocol.test.ts\",\n              \"type\": \"WebviewToHostMessage | HostToWebviewMessage\"\n            }\n          ],\n          \"postconditions\": [\n            \"'scratch-open-menu' replies with 'scratch-list' of the top 5\",\n            \"'scratch-new' creates a scratchpad and replies with 'scratch-list' + opens the document view\",\n            \"'scratch-open' opens/creates-or-reveals the insrc.scratchpad document panel\",\n            \"'scratch-delete' deletes then refreshes any open browse table\",\n            \"'scratch-browse' opens/creates-or-reveals the insrc.scratchpads table panel\",\n            \"'send-to-chat' pushes 'insert-into-input' {text} to the chat webview; text capped at 64 KiB with '…' truncation\"\n          ],\n          \"preconditions\": [\n            \"Chat panel is alive; scratch store is wired in extension.ts next to :635\"\n          ],\n          \"returns\": {\n            \"meaning\": \"Side effects on panels + webviews; no return value\",\n            \"type\": \"void\"\n          },\n          \"signature\": \"handleChatMessage(msg: WebviewToHostMessage): Promise<void>\"\n        },\n        {\n          \"errors\": [\n            {\n              \"condition\": \"panel creation failure\",\n              \"type\": \"never throws; logged via panelLog\"\n            }\n          ],\n          \"name\": \"webview panels via the injected PanelFactory (extension.ts:447)\",\n          \"parameters\": [\n            {\n              \"name\": \"viewType\",\n              \"optional\": false,\n              \"purpose\": \"insrc.scratchpads = browse-all tabular view (columns Name, Modified; icon-only Open/Delete buttons with title tooltips + data-id); insrc.scratchpad = single-document view with a selectionchange listener\",\n              \"type\": \"'insrc.scratchpads' | 'insrc.scratchpad'\"\n            },\n            {\n              \"name\": \"title\",\n              \"optional\": false,\n              \"purpose\": \"Panel title (scratchpad name for the document view)\",\n              \"type\": \"string\"\n            }\n          ],\n          \"postconditions\": [\n            \"Panels use the shared CSP+nonce shell from createWebviewPanelHost (panels/webview-host.ts:162) and the single-instance create-or-reveal lifecycle\",\n            \"Browse table rows post 'scratch-open' {id} / 'scratch-delete' {id}\",\n            \"Document view posts 'send-to-chat' {text} from its floating button on non-empty selection\"\n          ],\n          \"preconditions\": [\n            \"panels factory injected at extension.ts:447 (vscode.window.createWebviewPanel(viewType, title, ViewColumn.Active, { enableScripts: true }))\"\n          ],\n          \"returns\": {\n            \"meaning\": \"A webview panel handle\",\n            \"type\": \"WebviewPanel\"\n          },\n          \"signature\": \"panels.create(viewType: ScratchViewType, title: string): WebviewPanel\"\n        },\n        {\n          \"errors\": [\n            {\n              \"condition\": \"selection empty or collapsed\",\n              \"type\": \"floating button stays hidden\"\n            }\n          ],\n          \"name\": \"floating Send-to-chat button (document view bootstrap)\",\n          \"parameters\": [\n            {\n              \"name\": \"sel\",\n              \"optional\": false,\n              \"purpose\": \"window.getSelection() on selectionchange inside the insrc.scratchpad document view; button is icon-only with title=\\\"Send to chat\\\"\",\n              \"type\": \"Selection\"\n            }\n          ],\n          \"postconditions\": [\n            \"A floating button appears near the selection and posts { type: 'send-to-chat', text } to the host\",\n            \"Host pushes 'insert-into-input' to the chat webview, which inserts the text at the cursor (or appends) of #insrc-prompt (chat-panel.ts:2783) and focuses it — NEVER auto-sends a turn\"\n          ],\n          \"preconditions\": [\n            \"Document view is open and has focus\"\n          ],\n          \"returns\": {\n            \"meaning\": \"UI side effect only\",\n            \"type\": \"void\"\n          },\n          \"signature\": \"onSelectionChange(sel: Selection