277874	{"artifactId":"LLD-46667edffe5cc451-s1","entry":{"id":"8c42fd91905fc0704a246c85f534543eb8a96a0b6b7d8fc63f93296a1bb65fc3","targetHeadHash":"d46f45daa499d1aa21838124f6ecf9be9558a2bac69b6355f5bebbc4bdf55f6b","actor":{"id":"agent:design-review-daemon","kind":"agent","properties":{"party":"daemon"}},"timestamp":"2026-11-08T17:38:03.521Z","operation":"review","revision":{"number":3,"contentHash":"fd5c54dd4fb14ae4469f0dc97fa3416444c611f0f63681781cdd1c63148860de"},"outcome":{"result":"pass","summary":"Design review dependabot-46667edf-design attempt 3","data":{"kind":"design-chunk-review","schemaVersion":1,"reviewId":"dependabot-46667edf-design","project":"/Users/subhagho/work/projects/insors/insrc","artifactId":"LLD-46667edffe5cc451-s1","subject":{"project":"/Users/subhagho/work/projects/insors/insrc","artifactId":"LLD-46667edffe5cc451-s1","kind":"LLD","canonicalPath":"/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-46667edffe5cc451-s1.json","documentPath":"/Users/subhagho/work/projects/insors/insrc/docs/standalone/remediate-critical-high-moderate-dependabot-alerts-E2026110846667edf/S001/LLD.md","reviewer":"daemon","workflow":{"kind":"issue","rootArtifactId":"ISSUE-46667edffe5cc451","requiredReferences":[{"role":"originating_issue","artifactId":"ISSUE-46667edffe5cc451","path":"/Users/subhagho/work/projects/insors/insrc/docs/standalone/remediate-critical-high-moderate-dependabot-alerts-E2026110846667edf/ISSUE.md"}],"availableReferences":[],"notApplicableRoles":["PLAN","TASKS","BUILD","CR","DEF","HLD","sibling_stories"]}},"submitted":{"artifactPath":"/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-46667edffe5cc451-s1.json","attempt":1},"reviewer":"daemon","attempts":[{"number":1,"status":"incomplete","preparationKind":"planning","baseline":{"subjectFingerprints":{"canonical":"d8c0ae6cc5540e6658cc22cce6252e1f28709817e72096035f9e6fbfcc9780f2","document":"26ed0de8a4b41dbd56de73156f9d1eff1538164af2c3f96439431a4c15d972cd"},"contentIdentity":"30cc5f6b3fd95c0afaa21bb09c552470403df91e0bef2a1040e96c3e3ee72075","reviewedContent":{"canonical":"{\n  \"meta\": {\n    \"workflow\": \"design.story\",\n    \"runId\": \"wf-1794156884933-wt7mt7\",\n    \"repoPath\": \"/Users/subhagho/work/projects/insors/insrc\",\n    \"createdAt\": \"2026-11-08T16:55:04.802Z\",\n    \"epicCreatedAt\": \"2026-11-08T16:46:43.683Z\",\n    \"attribution\": {\n      \"outputs\": [\n        {\n          \"role\": \"(client)\",\n          \"tier\": \"core\",\n          \"runner\": \"cli-codex\",\n          \"model\": \"unknown\"\n        }\n      ]\n    },\n    \"elapsedMs\": 19340,\n    \"repoIndexedAt\": null,\n    \"schemaVersion\": 1,\n    \"epicHash\": \"46667edffe5cc451\",\n    \"epicSlug\": \"remediate-critical-high-moderate-dependabot-alerts\",\n    \"storyId\": \"s1\",\n    \"hldBaseRunId\": \"wf-1794156884933-wt7mt7\",\n    \"hldEffectiveHash\": \"448b283207fa0ce5b9f0f5582b6f720df6f76bf30978ed4002114563528724e8\",\n    \"hldAmendmentsApplied\": [],\n    \"storyTitle\": \"Remediate critical, high, and moderate Dependabot alerts\",\n    \"standalone\": true,\n    \"sizeClass\": \"bugfix\",\n    \"authoredBy\": \"controller\",\n    \"revision\": 1\n  },\n  \"body\": {\n    \"summary\": {\n      \"audience\": \"technical\",\n      \"prose\": \"Patch the daemon and standalone project-memory dependency graphs. The daemon owns its local embedding runtime, while standalone memory uses LanceDB for storage with caller-supplied embeddings. Preserve current protocols and stored data, and verify the packed package from a clean consumer before release.\"\n    },\n    \"hldContextSlice\": {\n      \"frameworkSummary\": \"Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\",\n      \"ownedContracts\": [],\n      \"consumedContracts\": [],\n      \"boundary\": {\n        \"storyId\": \"s1\",\n        \"owns\": [],\n        \"depends\": [],\n        \"internal\": \"Remediate critical, high, and moderate Dependabot alerts\"\n      },\n      \"adjacentBoundaries\": [],\n      \"rolloutPhase\": \"standalone\",\n      \"nonFunctional\": {}\n    },\n    \"contractDetails\": {\n      \"surfaceLevel\": \"internal\",\n      \"api\": []\n    },\n    \"dataModelChanges\": [],\n    \"interactionWithShared\": [],\n    \"errorPaths\": {\n      \"errorCases\": [\n        {\n          \"scenario\": \"A root or packed consumer still resolves an affected dependency copy\",\n          \"detection\": \"Enumerate every lockfile package path and match every in-scope advisory range. Install the produced tarball into a clean consumer with default optional dependencies and no consumer overrides.\",\n          \"response\": \"Fail the applicable release gate and correct resolution. If the published upstream graph cannot be secured, qualify a narrowly scoped package change separately before releasing standalone memory.\",\n          \"userImpact\": \"The affected release stays pending while independently validated daemon batches can be assessed.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Native dependency fails to load or an existing memory store fails to reopen\",\n          \"detection\": \"Run real binding, embedding, and store reopen checks in clean Node 22.22.1 macOS and Linux installs.\",\n          \"response\": \"Block release for the affected package and retain the existing store data. Diagnose ABI, package selection, or API mismatch before rerunning.\",\n          \"userImpact\": \"Users avoid an installer or store compatibility regression.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Dependabot continues to report the ZIP symlink advisory after the patched package is deployed\",\n          \"detection\": \"Run a destination-symlink regression and compare the lockfile to the advisory range and refreshed GitHub alert.\",\n          \"response\": \"Record the runtime result and tracker status separately. Treat an actual outside write as a blocker and escalate any advisory metadata mismatch.\",\n          \"userImpact\": \"Completion evidence shows which result is verified.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"A live test service is unavailable\",\n          \"detection\": \"Record the failing reachability or credential preflight and the exact affected checks.\",\n          \"response\": \"Run available fixture and unit checks. Keep live coverage explicitly pending with instructions for an environment that provides the service.\",\n          \"userImpact\": \"Release evidence distinguishes completed coverage from pending service validation.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Producer resolves patched Sharp but an installed package reintroduces the old optional branch\",\n          \"detection\": \"Compare the packed artifact and a clean consumer lockfile. A disposable Node 22 probe resolved sharp 0.35.5 at the producer and 0.33.5 from the packed shrinkwrap in the consumer.\",\n          \"response\": \"Require the standalone package dependency artifact to carry the narrowed upstream graph. Verify its upstream version, checksum and license, absence of unused embedding branches, availability of all declared native targets, and default installation without host overrides.\",\n          \"userImpact\": \"Standalone users receive a safe default install without editing the host manifest.\",\n          \"recoverable\": true\n        }\n      ],\n      \"edgeCases\": [\n        {\n          \"input\": \"Valid CSV through an existing file connection after manifest cleanup\",\n          \"expected\": \"DuckDB preview and query remain functional.\"\n        },\n        {\n          \"input\": \"Nested but valid YAML merge and multiple documents\",\n          \"expected\": \"Existing project config and infrastructure discovery still parse supported documents.\"\n        },\n        {\n          \"input\": \"Historical lockfile still names an old Sharp version\",\n          \"expected\": \"The historical content and original test provenance remain intact. Any tracker disposition is scoped to those four paths.\"\n        }\n      ],\n      \"invariantsToPreserve\": [\n        {\n          \"text\": \"Keep MCP stdio and current tool request and response schemas.\",\n          \"source\": \"c1\"\n        },\n        {\n          \"text\": \"Keep the package API, existing LanceDB data, and local-only embedding behavior.\",\n          \"source\": \"c2\"\n        },\n        {\n          \"text\": \"Keep saved driver settings and existing CSV file behavior.\",\n          \"source\": \"c3\"\n        },\n        {\n          \"text\": \"Standalone storage owns one LanceDB SDK dependency. The SDK selects one installed native binding for the host and memory receives vectors from its caller. The daemon owns its separate Transformers dependency. A standalone SDK distribution may narrow optional install edges while retaining the SDK version, platform bindings, and Arrow and store compatibility.\",\n          \"source\": \"c2\"\n        }\n      ]\n    },\n    \"testStrategy\": {\n      \"testLevels\": [\n        {\n          \"level\": \"contract\",\n          \"purpose\": \"Compare every package instance to the open advisory ranges in the root and fresh packed consumer lockfiles.\",\n          \"subjects\": [\n            \"Daemon dependency closure\",\n            \"Standalone memory consumer package graph\",\n            \"Recorded historical alerts\"\n          ]\n        },\n        {\n          \"level\": \"unit\",\n          \"purpose\": \"Exercise existing affected behavior and add narrow regressions for security-sensitive gaps.\",\n          \"subjects\": [\n            \"MCP tool schema conversion\",\n            \"YAML merges and multi-document parsing\",\n            \"DuckDB CSV input\",\n            \"SMTP envelope and attachments\",\n            \"ZIP destination symlink rejection\"\n          ]\n        },\n        {\n          \"level\": \"integration\",\n          \"purpose\": \"Verify protocol, TLS, and package compatibility using real transports and clean installs.\",\n          \"subjects\": [\n            \"MCP stdio list and call\",\n            \"HTTP redirects and aborts, WebSocket handshake, Ollama streaming\",\n            \"SMTP STARTTLS delivery\",\n            \"Cassandra, etcd, MySQL, and SQL Server connection and read paths\"\n          ]\n        },\n        {\n          \"level\": \"smoke\",\n          \"purpose\": \"Verify installed platform bindings and preserve existing store compatibility.\",\n          \"subjects\": [\n            \"macOS and Linux Node 22.22.1 native install\",\n            \"ONNX embedding initialization\",\n            \"Clean packed consumer memory create and reopen of pre-upgrade store\"\n          ]\n        }\n      ],\n      \"acceptanceMapping\": [\n        {\n          \"criterionId\": \"ac1\",\n          \"provingTests\": [\n            \"Root closure advisory comparison with every resolved copy; MCP stdio and HTTP regression tests\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac2\",\n          \"provingTests\": [\n            \"SMTP delivery and driver connection smoke; ZIP symlink regression\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac3\",\n          \"provingTests\": [\n            \"Packed consumer resolution with normal optional dependencies, ONNX embedding and store reopen on Node 22.22.1 macOS and Linux\",\n            \"Compare packed dependency contents, SDK provenance and licenses, and platform optional dependency selections. Resolve without daemon root or host overrides.\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac4\",\n          \"provingTests\": [\n            \"Archive integrity comparison, GitHub alert reconciliation, and full repository sweep after targeted batches\",\n            \"Verify the eight low alerts are outside the acceptance gate and leave archived evidence byte-identical.\"\n          ]\n        }\n      ],\n      \"testFramework\": \"Node test runner with tsx, existing npm build and project-memory qualification workflow. Use disposable services or existing fixtures and record live-service availability.\"\n    },\n    \"migration\": {\n      \"stateBefore\": \"The existing stdio server, network clients, and memory store adapters described in s1 use the locked runtime dependency versions. A default standalone project-memory installation resolves its own LanceDB dependency closure.\",\n      \"stateAfter\": \"The daemon and standalone consumer package graphs pass the same advisory-range checks and existing stores reopen using their current schemas.\",\n      \"migrationSteps\": [\n        {\n          \"order\": 1,\n          \"action\": \"Qualify dependency changes in clean staging installations with the repository's Node baseline.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 2,\n          \"action\": \"Deploy the validated daemon build during a normal restart. Retain the previous binary and configuration for rollback.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 3,\n          \"action\": \"Release the standalone package only after clean consumer and store-reopen qualification.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 4,\n          \"action\": \"Check tracker state after the default branch is updated and record any evidence-only alert or metadata discrepancy.\",\n          \"rollbackable\": true\n        }\n      ],\n      \"backwardCompat\": \"Keep MCP tool schemas, daemon IPC, project-memory exports, on-disk LanceDB and queue formats, and saved connection settings compatible. Roll back by reinstalling the previous package or daemon build and reopening the same store.\",\n      \"zeroDowntime\": false,\n      \"dataRewriteRequired\": false\n    },\n    \"alternativesConsidered\": [\n      {\n        \"id\": \"a1\",\n        \"name\": \"Scoped updates with a verified standalone package\",\n        \"oneLineSummary\": \"Refresh compatible versions and scope exceptions to their parent packages, with a separate packed consumer gate.\",\n        \"approach\": \"Use reviewed manifest ranges and parent-scoped transitive constraints. Keep the two native install boundaries separate. Prefer an upstream LanceDB package without the affected optional branch for standalone memory. With no suitable upstream release, use a pinned, narrowly derived LanceDB SDK distribution for memory that excludes its unused optional Transformers and OpenAI providers, retains the SDK JavaScript and platform bindings, and is delivered as a reproducible dependency of the packed consumer artifact. Keep the daemon's separate local Transformers runtime and patch its Sharp dependency.\",\n        \"pros\": [\n          \"Preserves existing workflows and narrows regression scope.\",\n          \"Separates deployed risk from historical evidence.\"\n        ],\n        \"cons\": [\n          \"Consumer packaging must prove that the fixed dependency graph survives installation.\",\n          \"A few parent constraints need targeted exceptions.\"\n        ],\n        \"costEstimate\": \"M\"\n      },\n      {\n        \"id\": \"a2\",\n        \"name\": \"Replace affected upstream dependency chains\",\n        \"oneLineSummary\": \"Replace or fork packages whose current dependency graph cannot resolve securely by normal version selection.\",\n        \"approach\": \"Replace broad dependency families or maintain a fork that changes runtime behavior, while keeping the external daemon and memory contracts equivalent.\",\n        \"pros\": [\n          \"Can remove a problematic transitive chain from consumer installations.\",\n          \"Avoids carrying range overrides for dependencies that cannot accept them.\"\n        ],\n        \"cons\": [\n          \"Increases supply-chain maintenance and compatibility qualification.\",\n          \"Driver and native library replacements expand the regression surface.\"\n        ],\n        \"costEstimate\": \"L\",\n        \"reasonRejected\": \"A broad fork or replacement can satisfy consumer resolution, but changes to the runtime SDK or provider behaviors would increase compatibility and maintenance costs beyond what this issue needs.\"\n      },\n      {\n        \"id\": \"a3\",\n        \"name\": \"Upgrade full dependency families\",\n        \"oneLineSummary\": \"Use the latest major releases across affected families.\",\n        \"approach\": \"Adopt the current supported upstream lines and migrate each affected integration wherever its public API changed.\",\n        \"pros\": [\n          \"Moves more dependencies back onto current upstream lines.\"\n        ],\n        \"cons\": [\n          \"Introduces unrelated behavioral changes.\",\n          \"The latest LanceDB still resolves the older optional Transformers branch.\"\n        ],\n        \"costEstimate\": \"L\",\n        \"reasonRejected\": \"Adds unrelated integration churn and the newer LanceDB release still selects the affected optional Transformers branch.\"\n      }\n    ],\n    \"chosenAlternative\": \"a1\",\n    \"openQuestions\": []\n  },\n  \"citations\": [\n    {\n      \"id\": \"c1\",\n      \"kind\": \"code\",\n      \"ref\": \"src/mcp/server.ts:1264\"\n    },\n    {\n      \"id\": \"c2\",\n      \"kind\": \"code\",\n      \"ref\": \"packages/project-memory/src/store/lance-store.ts:184\"\n    },\n    {\n      \"id\": \"c3\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/db/file-execution.ts:45\"\n    },\n    {\n      \"id\": \"c4\",\n      \"kind\": \"prior-artifact\",\n      \"ref\": \"ISSUE-46667edffe5cc451\"\n    },\n    {\n      \"id\": \"c5\",\n      \"kind\": \"doc\",\n      \"ref\": \"package-lock.json\"\n    },\n    {\n      \"id\": \"c6\",\n      \"kind\": \"code\",\n      \"ref\": \"packages/project-memory/src/__tests__/packed.test.ts\"\n    },\n    {\n      \"id\": \"c7\",\n      \"kind\": \"code\",\n      \"ref\": \"src/agent/providers/onnx-embedder.ts:95\"\n    },\n    {\n      \"id\": \"c8\",\n      \"kind\": \"doc\",\n      \"ref\": \"https://docs.npmjs.com/cli/v10/configuring-npm/package-json/#overrides\"\n    },\n    {\n      \"id\": \"c9\",\n      \"kind\": \"doc\",\n      \"ref\": \"https://github.com/advisories/GHSA-vwc7-r8mq-g2x9\"\n    },\n    {\n      \"id\": \"c10\",\n      \"kind\": \"doc\",\n      \"ref\": \"https://github.com/cthackers/adm-zip/releases/tag/v0.6.1\"\n    },\n    {\n      \"id\": \"c11\",\n      \"kind\": \"doc\",\n      \"ref\": \"https://github.com/insors-ai/insrc/security/dependabot\"\n    }\n  ]\n}\n","document":"<!-- insrc:artifact LLD-46667edffe5cc451-s1 -->\n\n# LLD: STORY-46667edffe5cc451-s1 — Remediate critical, high, and moderate Dependabot alerts\n\n## Summary\n\n**Epic:** `remediate-critical-high-moderate-dependabot-alerts`\n**HLD base run:** `wf-1794156884933-wt7mt7`\n**HLD effective hash:** `448b283207fa...`\n\nPatch the daemon and standalone project-memory dependency graphs. The daemon owns its local embedding runtime, while standalone memory uses LanceDB for storage with caller-supplied embeddings. Preserve current protocols and stored data, and verify the packed package from a clean consumer before release.\n\n## Contents\n\n1. [HLD context](#1-hld-context)\n2. [Contract details](#2-contract-details)\n3. [Error paths](#3-error-paths)\n4. [Test strategy](#4-test-strategy)\n5. [Migration](#5-migration)\n6. [Alternatives considered](#6-alternatives-considered)\n7. [References](#7-references)\n\n## 1. HLD context\n\n**Framework:** Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\n**Rollout phase:** standalone\n\n## 2. Contract details\n\n**Surface level:** internal\n\n## 3. Error paths\n\n**Error cases**\n\n- **A root or packed consumer still resolves an affected dependency copy** (recoverable)\n  - Detection: Enumerate every lockfile package path and match every in-scope advisory range. Install the produced tarball into a clean consumer with default optional dependencies and no consumer overrides.\n  - Response: Fail the applicable release gate and correct resolution. If the published upstream graph cannot be secured, qualify a narrowly scoped package change separately before releasing standalone memory.\n  - User impact: The affected release stays pending while independently validated daemon batches can be assessed.\n- **Native dependency fails to load or an existing memory store fails to reopen** (recoverable)\n  - Detection: Run real binding, embedding, and store reopen checks in clean Node 22.22.1 macOS and Linux installs.\n  - Response: Block release for the affected package and retain the existing store data. Diagnose ABI, package selection, or API mismatch before rerunning.\n  - User impact: Users avoid an installer or store compatibility regression.\n- **Dependabot continues to report the ZIP symlink advisory after the patched package is deployed** (recoverable)\n  - Detection: Run a destination-symlink regression and compare the lockfile to the advisory range and refreshed GitHub alert.\n  - Response: Record the runtime result and tracker status separately. Treat an actual outside write as a blocker and escalate any advisory metadata mismatch.\n  - User impact: Completion evidence shows which result is verified.\n- **A live test service is unavailable** (recoverable)\n  - Detection: Record the failing reachability or credential preflight and the exact affected checks.\n  - Response: Run available fixture and unit checks. Keep live coverage explicitly pending with instructions for an environment that provides the service.\n  - User impact: Release evidence distinguishes completed coverage from pending service validation.\n- **Producer resolves patched Sharp but an installed package reintroduces the old optional branch** (recoverable)\n  - Detection: Compare the packed artifact and a clean consumer lockfile. A disposable Node 22 probe resolved sharp 0.35.5 at the producer and 0.33.5 from the packed shrinkwrap in the consumer.\n  - Response: Require the standalone package dependency artifact to carry the narrowed upstream graph. Verify its upstream version, checksum and license, absence of unused embedding branches, availability of all declared native targets, and default installation without host overrides.\n  - User impact: Standalone users receive a safe default install without editing the host manifest.\n\n**Edge cases**\n\n| Input | Expected |\n| :--- | :--- |\n| Valid CSV through an existing file connection after manifest cleanup | DuckDB preview and query remain functional. |\n| Nested but valid YAML merge and multiple documents | Existing project config and infrastructure discovery still parse supported documents. |\n| Historical lockfile still names an old Sharp version | The historical content and original test provenance remain intact. Any tracker disposition is scoped to those four paths. |\n\n**Invariants to preserve**\n\n- Keep MCP stdio and current tool request and response schemas. [[c1]]\n- Keep the package API, existing LanceDB data, and local-only embedding behavior. [[c2]]\n- Keep saved driver settings and existing CSV file behavior. [[c3]]\n- Standalone storage owns one LanceDB SDK dependency. The SDK selects one installed native binding for the host and memory receives vectors from its caller. The daemon owns its separate Transformers dependency. A standalone SDK distribution may narrow optional install edges while retaining the SDK version, platform bindings, and Arrow and store compatibility. [[c2]]\n\n## 4. Test strategy\n\n**Test framework:** `Node test runner with tsx, existing npm build and project-memory qualification workflow. Use disposable services or existing fixtures and record live-service availability.`\n\n**Test levels**\n\n- **contract** — Compare every package instance to the open advisory ranges in the root and fresh packed consumer lockfiles.\n  - Subjects: `Daemon dependency closure`, `Standalone memory consumer package graph`, `Recorded historical alerts`\n- **unit** — Exercise existing affected behavior and add narrow regressions for security-sensitive gaps.\n  - Subjects: `MCP tool schema conversion`, `YAML merges and multi-document parsing`, `DuckDB CSV input`, `SMTP envelope and attachments`, `ZIP destination symlink rejection`\n- **integration** — Verify protocol, TLS, and package compatibility using real transports and clean installs.\n  - Subjects: `MCP stdio list and call`, `HTTP redirects and aborts, WebSocket handshake, Ollama streaming`, `SMTP STARTTLS delivery`, `Cassandra, etcd, MySQL, and SQL Server connection and read paths`\n- **smoke** — Verify installed platform bindings and preserve existing store compatibility.\n  - Subjects: `macOS and Linux Node 22.22.1 native install`, `ONNX embedding initialization`, `Clean packed consumer memory create and reopen of pre-upgrade store`\n\n**Acceptance mapping**\n\n| Criterion | Proving tests |\n| :--- | :--- |\n| `ac1` | `Root closure advisory comparison with every resolved copy; MCP stdio and HTTP regression tests` |\n| `ac2` | `SMTP delivery and driver connection smoke; ZIP symlink regression` |\n| `ac3` | `Packed consumer resolution with normal optional dependencies, ONNX embedding and store reopen on Node 22.22.1 macOS and Linux`, `Compare packed dependency contents, SDK provenance and licenses, and platform optional dependency selections. Resolve without daemon root or host overrides.` |\n| `ac4` | `Archive integrity comparison, GitHub alert reconciliation, and full repository sweep after targeted batches`, `Verify the eight low alerts are outside the acceptance gate and leave archived evidence byte-identical.` |\n\n## 5. Migration\n\n**State before:** The existing stdio server, network clients, and memory store adapters described in s1 use the locked runtime dependency versions. A default standalone project-memory installation resolves its own LanceDB dependency closure.\n\n**State after:** The daemon and standalone consumer package graphs pass the same advisory-range checks and existing stores reopen using their current schemas.\n\n**Zero downtime:** no — **Data rewrite:** no\n\n**Steps**\n\n1. Qualify dependency changes in clean staging installations with the repository's Node baseline. — ↩ rollbackable\n2. Deploy the validated daemon build during a normal restart. Retain the previous binary and configuration for rollback. — ↩ rollbackable\n3. Release the standalone package only after clean consumer and store-reopen qualification. — ↩ rollbackable\n4. Check tracker state after the default branch is updated and record any evidence-only alert or metadata discrepancy. — ↩ rollbackable\n\n**Backward compat:** Keep MCP tool schemas, daemon IPC, project-memory exports, on-disk LanceDB and queue formats, and saved connection settings compatible. Roll back by reinstalling the previous package or daemon build and reopening the same store.\n\n## 6. Alternatives considered\n\n### 6.1 a1: Scoped updates with a verified standalone package — **CHOSEN**\n\nRefresh compatible versions and scope exceptions to their parent packages, with a separate packed consumer gate.\n\nUse reviewed manifest ranges and parent-scoped transitive constraints. Keep the two native install boundaries separate. Prefer an upstream LanceDB package without the affected optional branch for standalone memory. With no suitable upstream release, use a pinned, narrowly derived LanceDB SDK distribution for memory that excludes its unused optional Transformers and OpenAI providers, retains the SDK JavaScript and platform bindings, and is delivered as a reproducible dependency of the packed consumer artifact. Keep the daemon's separate local Transformers runtime and patch its Sharp dependency.\n\n### 6.2 a2: Replace affected upstream dependency chains\n\nReplace or fork packages whose current dependency graph cannot resolve securely by normal version selection.\n\nReplace broad dependency families or maintain a fork that changes runtime behavior, while keeping the external daemon and memory contracts equivalent.\n\n**Rejected because:** A broad fork or replacement can satisfy consumer resolution, but changes to the runtime SDK or provider behaviors would increase compatibility and maintenance costs beyond what this issue needs.\n\n### 6.3 a3: Upgrade full dependency families\n\nUse the latest major releases across affected families.\n\nAdopt the current supported upstream lines and migrate each affected integration wherever its public API changed.\n\n**Rejected because:** Adds unrelated integration churn and the newer LanceDB release still selects the affected optional Transformers branch.\n\n## 7. References\n\n- **[[c1]]** `code` `src/mcp/server.ts:1264`\n- **[[c2]]** `code` `packages/project-memory/src/store/lance-store.ts:184`\n- **[[c3]]** `code` `src/daemon/db/file-execution.ts:45`\n- **[[c4]]** `prior-artifact` `ISSUE-46667edffe5cc451`\n- **[[c5]]** `doc` `package-lock.json`\n- **[[c6]]** `code` `packages/project-memory/src/__tests__/packed.test.ts`\n- **[[c7]]** `code` `src/agent/providers/onnx-embedder.ts:95`\n- **[[c8]]** `doc` `https://docs.npmjs.com/cli/v10/configuring-npm/package-json/#overrides`\n- **[[c9]]** `doc` `https://github.com/advisories/GHSA-vwc7-r8mq-g2x9`\n- **[[c10]]** `doc` `https://github.com/cthackers/adm-zip/releases/tag/v0.6.1`\n- **[[c11]]** `doc` `https://github.com/insors-ai/insrc/security/dependabot`\n"},"capturedAt":"2026-11-08T16:56:07.174Z"},"inventory":{"units":[{"id":"/body/summary","selector":"/body/summary","title":"summary","kind":"section"},{"id":"/body/hldContextSlice","selector":"/body/hldContextSlice","title":"hldContextSlice","kind":"section"},{"id":"/body/contractDetails","selector":"/body/contractDetails","title":"contractDetails","kind":"section"},{"id":"/body/dataModelChanges","selector":"/body/dataModelChanges","title":"dataModelChanges","kind":"section"},{"id":"/body/interactionWithShared","selector":"/body/interactionWithShared","title":"interactionWithShared","kind":"section"},{"id":"/body/errorPaths","selector":"/body/errorPaths","title":"errorPaths","kind":"section"},{"id":"/body/testStrategy","selector":"/body/testStrategy","title":"testStrategy","kind":"section"},{"id":"/body/migration","selector":"/body/migration","title":"migration","kind":"section"},{"id":"/body/alternativesConsidered","selector":"/body/alternativesConsidered","title":"alternativesConsidered","kind":"section"},{"id":"/body/chosenAlternative","selector":"/body/chosenAlternative","title":"chosenAlternative","kind":"section"},{"id":"/body/openQuestions","selector":"/body/openQuestions","title":"openQuestions","kind":"section"},{"id":"/body/alternativesConsidered/0","selector":"/body/alternativesConsidered/0","title":"a1","kind":"requirement"},{"id":"/body/alternativesConsidered/1","selector":"/body/alternativesConsidered/1","title":"a2","kind":"requirement"},{"id":"/body/alternativesConsidered/2","selector":"/body/alternativesConsidered/2","title":"a3","kind":"requirement"},{"id":"/citations/0","selector":"/citations/0","title":"Citation 1","kind":"citation"},{"id":"/citations/1","selector":"/citations/1","title":"Citation 2","kind":"citation"},{"id":"/citations/2","selector":"/citations/2","title":"Citation 3","kind":"citation"},{"id":"/citations/3","selector":"/citations/3","title":"Citation 4","kind":"citation"},{"id":"/citations/4","selector":"/citations/4","title":"Citation 5","kind":"citation"},{"id":"/citations/5","selector":"/citations/5","title":"Citation 6","kind":"citation"},{"id":"/citations/6","selector":"/citations/6","title":"Citation 7","kind":"citation"},{"id":"/citations/7","selector":"/citations/7","title":"Citation 8","kind":"citation"},{"id":"/citations/8","selector":"/citations/8","title":"Citation 9","kind":"citation"},{"id":"/citations/9","selector":"/citations/9","title":"Citation 10","kind":"citation"},{"id":"/citations/10","selector":"/citations/10","title":"Citation 11","kind":"citation"},{"id":"document:line:23","selector":"document:line:23","title":"1. HLD context","kind":"section"}]},"completedChunks":[{"chunkId":"daemon","status":"changes_requested","summary":"The design preserves the intended transport contracts and identifies relevant regression gates, but omits concrete daemon dependency selections and the originating issue’s unused-dependency removal work.","findings":[{"id":"daemon-001","severity":"MED","location":"/body/alternativesConsidered/0/approach; LLD.md:119","message":"The chosen approach promises reviewed manifest ranges and parent-scoped constraints without specifying any daemon target versions, override entries, or advisory-to-package-path mapping. The cited lockfile contains the issue’s critical chain (@modelcontextprotocol/sdk 1.29.0 → express 5.2.1 → proxy-addr 2.0.7), but the design never states how that chain will change. Consequently, compatibility, complete advisory remediation, and npm override validity cannot be assessed before implementation. Add a concrete dependency decision table and proposed root-scoped override structure, including affected parent paths and compatibility rationale; record unresolved selections as open questions rather than leaving that list empty.","evidenceReferences":["docs/standalone/remediate-critical-high-moderate-dependabot-alerts-E2026110846667edf/S001/LLD.md:115",".insrc/artifacts/LLD-46667edffe5cc451-s1.json#/body/openQuestions","docs/standalone/remediate-critical-high-moderate-dependabot-alerts-E2026110846667edf/ISSUE.md — Root cause and Fix intent","package-lock.json:2843","package-lock.json:5502","package-lock.json:8194","[npm override semantics](https://docs.npmjs.com/cli/v10/configuring-npm/package-json/#overrides)"]},{"id":"daemon-002","severity":"MED","location":"/body/summary; /body/alternativesConsidered/0; /body/testStrategy","message":"The originating ISSUE explicitly includes removing unused dependencies after confirming callers in batch one. The LLD specifies neither removal candidates nor a caller-verification procedure or acceptance check for that work. Its CSV edge case mentions manifest cleanup, but never identifies the cleanup being authorized. For example, csv-parse remains a direct dependency while the inspected CSV execution path uses DuckDB read_csv_auto. Define the candidate inventory, require static and dynamic caller checks before removal, and map the resulting removals to regression coverage so this required scope cannot silently disappear.","evidenceReferences":["docs/standalone/remediate-critical-high-moderate-dependabot-alerts-E2026110846667edf/ISSUE.md — Fix intent, batch (1)","docs/standalone/remediate-critical-high-moderate-dependabot-alerts-E2026110846667edf/S001/LLD.md:61","docs/standalone/remediate-critical-high-moderate-dependabot-alerts-E2026110846667edf/S001/LLD.md:78","docs/standalone/remediate-critical-high-moderate-dependabot-alerts-E2026110846667edf/S001/LLD.md:119","package.json:52","src/daemon/db/file-execution.ts:45"]}],"inspectedReferences":["/body/summary","/body/hldContextSlice","document:line:23","/body/contractDetails","/body/interactionWithShared","/body/alternativesConsidered","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/alternativesConsidered/2","/body/chosenAlternative","/body/openQuestions","/body/errorPaths","/body/testStrategy","/citations/0","/citations/3","/citations/4","/citations/7","/Users/subhagho/work/projects/insors/insrc/docs/standalone/remediate-critical-high-moderate-dependabot-alerts-E2026110846667edf/S001/LLD.md",".insrc/artifacts/LLD-46667edffe5cc451-s1.json",".insrc/artifacts/ISSUE-46667edffe5cc451.json","docs/standalone/remediate-critical-high-moderate-dependabot-alerts-E2026110846667edf/ISSUE.md","package.json","package-lock.json — MCP SDK, Express, proxy-addr, undici, ws, Ollama, Zod, js-yaml and csv-parse entries","src/mcp/server.ts:1264","src/mcp/__tests__/mcp-process-e2e.test.ts","src/mcp/__tests__/schema-registry.test.ts","src/daemon/tools/builtins/http/index.ts — request redirects, cancellation, WebSocket lifecycle","src/agent/providers/ollama.ts:293","src/agent/providers/__tests__/ollama-private-transport.test.ts","src/daemon/db/file-execution.ts:45","https://docs.npmjs.com/cli/v10/configuring-npm/package-json/#overrides"],"limitations":[],"advice":["Name the existing MCP process and schema-registry suites in the transport qualification instructions: they already exercise real stdio-to-daemon forwarding and schema conversion.","No daemon interaction change or authored diagram is supplied. Existing transport code and the stated preservation contracts are sufficient for this responsibility; no diagram rendering was claimed or runtime qualification executed."]},{"chunkId":"drivers","status":"changes_requested","summary":"The design covers the intended integrations and separates ZIP runtime protection from tracker metadata, but batch-two dependency decisions and the security regression oracle need concrete specification.","findings":[{"id":"drivers-001","severity":"MED","location":"/body/contractDetails; /body/testStrategy","message":"Batch two names SMTP and four database integrations but supplies no dependency selections or compatibility decisions; contractDetails.api is empty. This leaves material choices unresolved: Cassandra 4.9.0 requires adm-zip ~0.5.10, while the cited extraction fix is in 0.6.1, outside that range. SQL Server actually uses tedious and tarn, and etcd carries gRPC dependencies. Specify the affected parent paths, proposed versions or scoped constraints, compatibility rationale, and corresponding transport/read checks. Include checks using existing saved connection configurations rather than only newly constructed SDK clients. Without these decisions, the second batch cannot be assessed as an implementable remediation preserving existing settings.","evidenceReferences":["docs/standalone/remediate-critical-high-moderate-dependabot-alerts-E2026110846667edf/ISSUE.md — Fix intent, batch (2)",".insrc/artifacts/LLD-46667edffe5cc451-s1.json#/body/contractDetails","docs/standalone/remediate-critical-high-moderate-dependabot-alerts-E2026110846667edf/S001/LLD.md:69","package-lock.json:4445","package-lock.json:5419","src/daemon/db/drivers/mssql.ts:7","src/daemon/db/drivers/cassandra.ts — registered factory","src/daemon/db/drivers/etcd.ts — registered factory","src/daemon/db/config.ts — loadConnections","[adm-zip 0.6.1 release](https://github.com/cthackers/adm-zip/releases/tag/v0.6.1)"]},{"id":"drivers-002","severity":"MED","location":"/body/errorPaths/errorCases/2; /body/testStrategy/testLevels/1","message":"The ZIP gate only names destination-symlink rejection, without specifying the exploit preconditions or an oracle distinguishing the fix from ordinary overwrite refusal. The advisory requires overwrite to be enabled; the currently installed vulnerable package defaults overwrite to false and can reject an existing target without exercising symlink protection. Specify overwrite=true, a benign archive entry targeting a pre-existing destination symlink to an outside sentinel, and assertions that outside content and permissions remain unchanged. Cover the affected synchronous, asynchronous and single-entry extraction APIs, or explicitly justify narrower coverage. Demonstrate that the fixture detects the vulnerable baseline before relying on it as the release gate.","evidenceReferences":["docs/standalone/remediate-critical-high-moderate-dependabot-alerts-E2026110846667edf/S001/LLD.md:44","docs/standalone/remediate-critical-high-moderate-dependabot-alerts-E2026110846667edf/S001/LLD.md:81","node_modules/adm-zip/adm-zip.js:671","node_modules/adm-zip/adm-zip.js:751","[Destination-symlink advisory](https://github.com/advisories/GHSA-vwc7-r8mq-g2x9)","[Release documenting extraction protection](https://github.com/cthackers/adm-zip/releases/tag/v0.6.1)"]}],"inspectedReferences":["/body/contractDetails","/body/errorPaths","/body/testStrategy","/body/migration","/citations/2","/citations/8","/citations/9","/Users/subhagho/work/projects/insors/insrc/docs/standalone/remediate-critical-high-moderate-dependabot-alerts-E2026110846667edf/S001/LLD.md",".insrc/artifacts/LLD-46667edffe5cc451-s1.json",".insrc/tmp/design-review/dependabot-46667edf-design.json","docs/standalone/remediate-critical-high-moderate-dependabot-alerts-E2026110846667edf/ISSUE.md","package.json","package-lock.json — SMTP, Cassandra, etcd, MySQL, tedious, tarn and adm-zip entries","src/daemon/tools/builtins/notify/index.ts:390","src/daemon/db/drivers/cassandra.ts","src/daemon/db/drivers/etcd.ts","src/daemon/db/drivers/mysql.ts — URL parsing and registered factories","src/daemon/db/drivers/mssql.ts — connection configuration, pool and factory","src/daemon/db/config.ts","src/daemon/db/file-execution.ts:45","src/daemon/db/__tests__/file-execution.test.ts","src/daemon/db/__tests__/mysql-integration.test.ts","src/daemon/db/__tests__/other-kv-probes.test.ts","src/daemon/db/__tests__/remaining-sql-probes.test.ts","src/indexer/target-resolution/config-sources.ts — Compose and Kubernetes parsers","src/analyze/runtimes/infra/inventory-kubernetes.ts — multi-document parsing and failures","src/analyze/runtimes/infra/inventory-ci.ts — YAML caller","src/analyze/runtimes/infra/inventory-docker.ts — YAML caller","src/analyze/runtimes/infra/inventory-helm.ts — YAML callers","src/analyze/explore/manifests-locate.ts — YAML caller","src/analyze/explore/__tests__/manifests-locate.test.ts — YAML cases","node_modules/adm-zip/adm-zip.js — extraction defaults","node_modules/cassandra-driver/lib/datastax/cloud/index.js — ZIP dependency usage","https://github.com/advisories/GHSA-vwc7-r8mq-g2x9","https://github.com/cthackers/adm-zip/releases/tag/v0.6.1"],"limitations":[],"advice":["Name the existing MySQL integration and Cassandra/etcd Docker probe suites in qualification instructions. The SQL Server probe suite mocks the SDK boundary, so it does not establish wire or TLS compatibility.","Clarify whether pending live checks block the affected batch or may be satisfied by specified fixtures. The ISSUE permits recording unavailable coverage, but the migration section does not define that release decision.","Scope multi-document YAML expectations to loadAll callers; Compose, CI and Helm use single-document load. Keep their existing parse-failure behavior explicit.","Citation c3 supports DuckDB CSV execution, while saved connection settings are supported by db/config.ts and the individual driver factories; add those references.","No interaction or UX changes require a new diagram for this responsibility. No visual verification or runtime qualification was claimed."]},{"chunkId":"native","status":"incomplete","summary":"The design correctly separates daemon embeddings from standalone caller-supplied vectors and requires independent consumer qualification. Two material gaps remain: concrete delivery of the narrowed SDK distribution and qualification of the promised rollback. The cited GitHub dashboard could not be inspected.","findings":[{"id":"native-001","severity":"MED","location":"/body/alternativesConsidered/0/approach; /body/errorPaths/errorCases/4; LLD.md:119","message":"The selected remediation requires a reproducible narrowed LanceDB distribution, but does not define its upstream version and integrity source, derivation procedure, resulting package identity, delivery location, or dependency specification consumed by project-memory. These are central implementation decisions: the current package pins the ordinary 0.40.0 SDK, whose optional dependencies reinstall Transformers 3.0.2 and Sharp 0.33.5. Requiring checksum, license and native-target verification does not specify what artifact is being verified or how an independent installer obtains it. Define the immutable input, permitted manifest-only transformation, retained licensing/native dependencies, output identity and consumer delivery mechanism; identify associated manifest and packed-test changes. Record unresolved decisions in openQuestions instead of declaring none.","evidenceReferences":["docs/standalone/remediate-critical-high-moderate-dependabot-alerts-E2026110846667edf/S001/LLD.md:119",".insrc/artifacts/LLD-46667edffe5cc451-s1.json#/body/openQuestions","packages/project-memory/package.json — dependencies and files","package-lock.json — node_modules/@lancedb/lancedb and its nested Transformers/Sharp entries","node_modules/@lancedb/lancedb/package.json — optionalDependencies, native targets and license","packages/project-memory/src/__tests__/packed.test.ts:100","[npm package resolution rules](https://docs.npmjs.com/cli/v10/configuring-npm/package-json/#overrides)"]},{"id":"native-002","severity":"MED","location":"/body/migration/backwardCompat; /body/testStrategy; LLD.md:111","message":"Migration promises that reinstalling the previous package or daemon can reopen the same store, but qualification only names forward reopening of a pre-upgrade store. It does not require reopening with the previous release after the upgraded release has written data, nor provide a preserved-store recovery procedure if that reverse check fails. The cited packed tests create and reopen stores using the same installed artifact, so they do not establish either cross-release direction. Define the baseline artifact and populated fixture, assert preserved records/vectors and queue/receipt state after upgrade, and qualify old-version reopening after representative upgraded writes. Alternatively, constrain the rollback promise and specify a verified backup/restore procedure before deployment.","evidenceReferences":["docs/standalone/remediate-critical-high-moderate-dependabot-alerts-E2026110846667edf/S001/LLD.md:85","docs/standalone/remediate-critical-high-moderate-dependabot-alerts-E2026110846667edf/S001/LLD.md:111","packages/project-memory/src/__tests__/packed.test.ts:129","packages/project-memory/src/__tests__/packed.test.ts:141","packages/project-memory/src/__tests__/fixtures/packed-store-consumer.mjs","packages/project-memory/src/store/lance-store.ts:184","packages/project-memory/src/store/format.ts — persistent format and embedding-profile validation"]}],"inspectedReferences":["/body/summary","/body/contractDetails","/body/dataModelChanges","/body/interactionWithShared","/body/errorPaths","/body/testStrategy","/body/migration","/body/alternativesConsidered","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/alternativesConsidered/2","/body/chosenAlternative","/body/openQuestions","/citations/1","/citations/3","/citations/4","/citations/5","/citations/6","/citations/7","/citations/10","/Users/subhagho/work/projects/insors/insrc/docs/standalone/remediate-critical-high-moderate-dependabot-alerts-E2026110846667edf/S001/LLD.md",".insrc/artifacts/LLD-46667edffe5cc451-s1.json",".insrc/artifacts/ISSUE-46667edffe5cc451.json","docs/standalone/remediate-critical-high-moderate-dependabot-alerts-E2026110846667edf/ISSUE.md",".insrc/tmp/design-review/dependabot-46667edf-design.json — completed daemon and drivers feedback","package.json","package-lock.json — native SDK, Transformers, ONNX and Sharp dependency entries",".npmrc","packages/project-memory/package.json","packages/project-memory/src/types.ts — caller-owned ModelPort","packages/project-memory/src/model-dispatcher.ts — host embedding delegation","packages/project-memory/src/store/lance-store.ts — SDK loading, schema validation and store reopening","packages/project-memory/src/store/format.ts","packages/project-memory/src/__tests__/packed.test.ts","packages/project-memory/src/__tests__/fixtures/packed-store-consumer.mjs","packages/project-memory/src/__tests__/fixtures/node22.ts","src/agent/providers/onnx-embedder.ts",".github/workflows/project-memory.yml","node_modules/@lancedb/lancedb/package.json","node_modules/@lancedb/lancedb/dist/index.js","node_modules/@lancedb/lancedb/dist/native.js — platform selection and binding version checks","node_modules/@lancedb/lancedb/dist/embedding/index.js","node_modules/@lancedb/lancedb/dist/embedding/openai.js","node_modules/@lancedb/lancedb/dist/embedding/transformers.js","docs/epics/share-project-memory-across-agents-applications-E2026110117123b6d/S003/evidence/t3-linux/project-memory-linux-node22-24a61e760b4e8e10787e91e658db362e1d6ab254/package-lock.json","docs/epics/share-project-memory-across-agents-applications-E2026110117123b6d/S003/evidence/t10-linux/project-memory-linux-node22-a4e040809abeaff4d966e79d6d1e4a639103654f/package-lock.json","docs/epics/share-project-memory-across-agents-applications-E2026110117123b6d/S003/evidence/t13-prewire-linux/project-memory-linux-node22-700c7f1e923a50717bbbf806105dc2b3d1bba98d/package-lock.json","docs/epics/share-project-memory-across-agents-applications-E2026110117123b6d/S003/evidence/t17-linux/project-memory-linux-node22-0990b423e1036ec1d2bf1783f20f40b62de77da3/package-lock.json","https://docs.npmjs.com/cli/v10/configuring-npm/package-json/#overrides"],"limitations":["/citations/10: The reference was assessed, but its GitHub Dependabot dashboard contents could not be verified. Browser retrieval failed and the read-only GitHub API attempt could not connect. The claimed alert inventory, eight low-alert exclusions and current tracker states therefore remain unverified against GitHub; originating ISSUE counts were treated as captured requirements."],"advice":["Make the native qualification matrix explicit by architecture and Linux libc. The existing workflow covers Linux, while the SDK declares macOS arm64 and several Linux targets; macOS coverage needs a separately identified execution environment.","Name the four archived lockfiles in reconciliation evidence and record their alert disposition separately. All four inspected files currently have SHA256 36845dda31bd234c0d174614c4995db2a199aae291e327f265a4093a9ee796cd and resolve Sharp 0.33.5.","The prose adequately explains caller-to-storage and SDK-to-binding ownership; a separate diagram is optional. No diagram definitions or rendered companions were supplied, and no visual verification is claimed.","Native installations, ONNX execution and cross-version store tests were not run during this read-only design review; they remain implementation release gates."]},{"chunkId":"consistency","status":"incomplete","summary":"The live LLD and canonical artifact agree and match the checkpoint baseline. The design preserves the main compatibility and qualification intentions, but does not explicitly retain the required three reviewable batches. Completed substantive feedback was inspected without duplicating its findings. GitHub alert inventory verification remains unavailable.","findings":[{"id":"consistency-001","severity":"MED","location":"LLD.md:72-109; /body/testStrategy/acceptanceMapping; /body/migration","message":"The originating ISSUE requires three reviewable batches with targeted tests per batch and a full sweep afterward. The LLD lists tests by level and describes deployment steps, but never defines the three batch boundaries, their ordering, or their individual qualification checkpoints. Its ac1–ac4 labels also have no defined criteria in either the LLD or originating ISSUE. Consequently, the document does not establish how the required independently reviewable batches will be delivered and accepted. Explicitly map the three ISSUE batches to their scope and targeted qualification evidence, define the acceptance labels, and retain the final combined sweep. This is a design traceability requirement, not a request for future PLAN or TASKS artifacts.","evidenceReferences":["docs/standalone/remediate-critical-high-moderate-dependabot-alerts-E2026110846667edf/ISSUE.md — Fix intent",".insrc/artifacts/ISSUE-46667edffe5cc451.json#/body/fixIntent","docs/standalone/remediate-critical-high-moderate-dependabot-alerts-E2026110846667edf/S001/LLD.md:76","docs/standalone/remediate-critical-high-moderate-dependabot-alerts-E2026110846667edf/S001/LLD.md:87","docs/standalone/remediate-critical-high-moderate-dependabot-alerts-E2026110846667edf/S001/LLD.md:104"]}],"inspectedReferences":["/Users/subhagho/work/projects/insors/insrc/docs/standalone/remediate-critical-high-moderate-dependabot-alerts-E2026110846667edf/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/dependabot-46667edf-design.json","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-46667edffe5cc451-s1.json","/Users/subhagho/work/projects/insors/insrc/docs/standalone/remediate-critical-high-moderate-dependabot-alerts-E2026110846667edf/ISSUE.md",".insrc/artifacts/ISSUE-46667edffe5cc451.json","Checkpoint completedChunks: daemon, drivers, native — all accepted completed feedback","Checkpoint baseline.reviewedContent — canonical and live document both match current files","packages/project-memory/package.json",".github/workflows/project-memory.yml","src/mcp/server.ts:1264","packages/project-memory/src/store/lance-store.ts:184","src/daemon/db/file-execution.ts:45","packages/project-memory/src/__tests__/packed.test.ts:100","src/agent/providers/onnx-embedder.ts:95","https://docs.npmjs.com/cli/v10/configuring-npm/package-json/#overrides","https://github.com/advisories/GHSA-vwc7-r8mq-g2x9","https://github.com/cthackers/adm-zip/releases/tag/v0.6.1"],"limitations":["LLD citation c11, https://github.com/insors-ai/insrc/security/dependabot, could not be retrieved: browser retrieval returned a cache-miss failure. The captured 122-alert inventory, eight low-alert exclusions, and current GitHub states could not be independently verified. This also preserves the unresolved verification limit reported by the native chunk."],"advice":["Retain daemon-001, daemon-002, drivers-001, drivers-002, native-001 and native-002 as the existing findings concerning dependency decisions, unused-dependency scope, ZIP regression validity, narrowed SDK delivery and rollback qualification; they are not repeated here.","Clarify the release treatment of unavailable live checks, as noted in drivers feedback: identify acceptable fixture evidence and which checks remain pending for the affected batch.","The ownership prose sufficiently distinguishes standalone caller-supplied vectors, the SDK-selected native binding and daemon-owned embeddings. No authored diagram or rendered companion is supplied; a separate diagram is optional, and no visual verification is claimed.","Native installs, service tests and store compatibility execution remain implementation qualification gates; they were not run during this read-only design review.","The distinction between ZIP runtime protection and advisory metadata is supported by the [advisory](https://github.com/advisories/GHSA-vwc7-r8mq-g2x9) and [0.6.1 release notes](https://github.com/cthackers/adm-zip/releases/tag/v0.6.1)."]}],"progress":{"status":"incomplete","phase":"complete","completedChunks":4,"totalChunks":4,"lastMeaningfulActivityAt":null,"activeToolCount":0,"requiresUserInput":false,"checkpointPath":"/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/dependabot-46667edf-design.json","sequence":0,"reviewElapsedMs":0,"unitElapsedMs":null,"observedAt":"2026-11-08T17:03:49.531Z","freshness":"stored"},"startedAt":"2026-11-08T16:56:07.187Z","reviewer":"daemon","model":"gpt-6.1-sol","unit":{"unitId":"consistency","phase":"chunk_review","executionId":"4a151c8c-dba6-44e9-8640-e79c9cbb3964","dispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[]},"plan":{"chunks":[{"id":"daemon","title":"Daemon transport and compatible dependency remediation","selectors":["/body/summary","/body/hldContextSlice","document:line:23",