50818	{"artifactId":"LLD-4adebe9eb17a3ef2-s1","entry":{"id":"a926253a071e519d6d14e6d88d5d72a721bc362bfa061c2d314c71a8dfe49da9","targetHeadHash":"6c366a8d4913b113a1bd2ad954bf3be1aa27b0f80a7034932538ea83f065b477","actor":{"id":"agent:design-review-daemon","kind":"agent","properties":{"party":"daemon"}},"timestamp":"2026-11-14T13:12:24.721Z","operation":"review","revision":{"number":1,"contentHash":"1492abcce9ac62d1242877be2c0f1fd9bdb8788486efa34ffc5da31a572676c4"},"outcome":{"result":"block","summary":"Design review daemon-lanes-4adebe9e attempt 1","data":{"kind":"design-chunk-review","reviewId":"daemon-lanes-4adebe9e","project":"/Users/subhagho/work/projects/insors/insrc","artifactId":"LLD-4adebe9eb17a3ef2-s1","subject":{"project":"/Users/subhagho/work/projects/insors/insrc","artifactId":"LLD-4adebe9eb17a3ef2-s1","kind":"LLD","canonicalPath":"/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-4adebe9eb17a3ef2-s1.json","documentPath":"/Users/subhagho/work/projects/insors/insrc/docs/standalone/separate-daemon-development-release-build-lanes-E202611144adebe9e/S001/LLD.md","reviewer":"daemon","workflow":{"kind":"standalone","rootArtifactId":"LLD-4adebe9eb17a3ef2-s1","requiredReferences":[],"availableReferences":[],"notApplicableRoles":["PLAN","TASKS","BUILD","CR","DEF","HLD","sibling_stories"]}},"reviewer":"daemon","applicableAttempt":1,"status":"incomplete","binding":{"sourceRevision":{"number":1,"contentHash":"1492abcce9ac62d1242877be2c0f1fd9bdb8788486efa34ffc5da31a572676c4"},"reviewedContentIdentity":"cbdd48f4186a5de3d22bdc36b64d2417aa73bd334f41a153b28b3d4af0405124","documentDigest":"3f590f7dd4e1a5c266cc805306bc04e27d0a30fbe872ccdefacd1d6c0930d93f","workflowDigest":"3ee348b73b77c2d7240616b397bc1e603fe40c8f209e0baa1209759d735ef7c2","author":"controller"},"preservationDigest":"be7300fe536a86fb07a17c337e25c758d30313fe430fff1b8f9b719312d826fd","schemaVersion":2,"submitted":{"artifactPath":"/Users/subhagho/work/projects/insors/insrc/docs/standalone/separate-daemon-development-release-build-lanes-E202611144adebe9e/S001/LLD.md","attempt":1},"attempts":[{"number":1,"status":"incomplete","preparationKind":"planning","baseline":{"subjectFingerprints":{"canonical":"6b1d43d75573d2750abe77c148d1d6f6b4422dfdc7687d326e66f62dc72c326f","document":"3f590f7dd4e1a5c266cc805306bc04e27d0a30fbe872ccdefacd1d6c0930d93f"},"contentIdentity":"cbdd48f4186a5de3d22bdc36b64d2417aa73bd334f41a153b28b3d4af0405124","reviewedContent":{"canonical":"{\n  \"meta\": {\n    \"workflow\": \"design.story\",\n    \"runId\": \"wf-1794661682291-1mqq9e\",\n    \"repoPath\": \"/Users/subhagho/work/projects/insors/insrc\",\n    \"createdAt\": \"2026-11-14T13:09:02.500Z\",\n    \"epicCreatedAt\": \"2026-11-14T13:09:02.500Z\",\n    \"attribution\": {\n      \"outputs\": [\n        {\n          \"role\": \"(client)\",\n          \"tier\": \"core\",\n          \"runner\": \"cli-codex\",\n          \"model\": \"unknown\"\n        }\n      ]\n    },\n    \"elapsedMs\": 59983,\n    \"repoIndexedAt\": null,\n    \"schemaVersion\": 1,\n    \"epicHash\": \"4adebe9eb17a3ef2\",\n    \"epicSlug\": \"separate-daemon-development-release-build-lanes\",\n    \"storyId\": \"s1\",\n    \"hldBaseRunId\": \"wf-1794661682291-1mqq9e\",\n    \"hldEffectiveHash\": \"4adebe9eb17a3ef2d4489d8dddb5b01439e67e1d7487ef95f627a3bc119f7390\",\n    \"hldAmendmentsApplied\": [],\n    \"storyTitle\": \"Separate daemon development and release build lanes\",\n    \"standalone\": true,\n    \"sizeClass\": \"feature\",\n    \"triageRationale\": \"One cohesive deployment contract across existing candidate, qualification and promotion jobs. Requires a reviewed branch/provenance contract and local positive/negative tests.\",\n    \"authoredBy\": \"controller\",\n    \"lifecycle\": {\n      \"status\": \"draft\",\n      \"revision\": {\n        \"number\": 1,\n        \"contentHash\": \"1492abcce9ac62d1242877be2c0f1fd9bdb8788486efa34ffc5da31a572676c4\",\n        \"at\": \"2026-11-14T13:09:02.582Z\",\n        \"by\": {\n          \"id\": \"insrc:system\",\n          \"kind\": \"system\",\n          \"properties\": {}\n        }\n      },\n      \"signoffs\": []\n    },\n    \"revision\": 1\n  },\n  \"body\": {\n    \"summary\": {\n      \"audience\": \"technical\",\n      \"prose\": \"Use v2 for unpublished development builds and protected main for production release candidates. Tests still run locally, and only the archive built and qualified from main can be published.\"\n    },\n    \"hldContextSlice\": {\n      \"frameworkSummary\": \"Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\",\n      \"ownedContracts\": [],\n      \"consumedContracts\": [],\n      \"boundary\": {\n        \"storyId\": \"s1\",\n        \"owns\": [],\n        \"depends\": [],\n        \"internal\": \"Separate daemon development and release build lanes\"\n      },\n      \"adjacentBoundaries\": [],\n      \"rolloutPhase\": \"standalone\",\n      \"nonFunctional\": {}\n    },\n    \"contractDetails\": {\n      \"api\": [\n        {\n          \"name\": \"Build candidate\",\n          \"signature\": \"branch ref + exact commit SHA + version → lane, run, artifact and SHA-256\",\n          \"parameters\": [],\n          \"returns\": {\n            \"type\": \"result\",\n            \"meaning\": \"Verified lane and exact candidate identity or refusal.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"ReleaseGate\",\n              \"condition\": \"Branch, provenance, or protection does not match the lane.\"\n            }\n          ],\n          \"preconditions\": [\n            \"Derive lane from actual dispatch ref; admit only main and v2. Require GitHub branch protection on main. The v2 build job has read-only permissions and no signing or release environment.\",\n            \"For both lanes dispatch SHA must equal requested SHA; reject all other refs.\"\n          ],\n          \"postconditions\": [\n            \"Upload unpublished artifact with lane-distinct name and branch/lane in candidate metadata. Run no Actions tests.\"\n          ]\n        },\n        {\n          \"name\": \"Qualify candidates\",\n          \"signature\": \"candidate run + artifact + exact commit → signed qualification manifest or local development checks\",\n          \"parameters\": [],\n          \"returns\": {\n            \"type\": \"result\",\n            \"meaning\": \"Verified lane and exact candidate identity or refusal.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"ReleaseGate\",\n              \"condition\": \"Branch, provenance, or protection does not match the lane.\"\n            }\n          ],\n          \"preconditions\": [\n            \"Run the release qualification-signing workflow from protected main and accept only successful candidate runs originating at main. Verify branch and commit on run and artifact metadata, repository/workflow identity, lane and digest.\",\n            \"Use v2 candidates for local packaging and smoke checks only; never give a v2 job production or qualification signing credentials.\"\n          ],\n          \"postconditions\": [\n            \"Sign main manifest with the isolated qualification key; exercise the exact archive on a disposable Apple Silicon host and bind evidence to the main commit, run, artifact, manifest and archive hashes.\"\n          ]\n        },\n        {\n          \"name\": \"Publish main release\",\n          \"signature\": \"approved evidence commit + archive SHA-256 → immutable-identity prerelease\",\n          \"parameters\": [],\n          \"returns\": {\n            \"type\": \"result\",\n            \"meaning\": \"Verified lane and exact candidate identity or refusal.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"ReleaseGate\",\n              \"condition\": \"Branch, provenance, or protection does not match the lane.\"\n            }\n          ],\n          \"preconditions\": [\n            \"Promotion executes only on protected main and behind the production environment approval. Independently require the exact candidate origin branch to be main even when run IDs and digests are valid; validate the approved evidence and qualification signature.\",\n            \"Do not reuse a v2 archive after merging its source to main. A main candidate must be built and locally qualified separately.\"\n          ],\n          \"postconditions\": [\n            \"Sign and publish the exact main archive that passed local tests. Never rebuild at promotion or publish development artifacts.\"\n          ]\n        }\n      ],\n      \"surfaceLevel\": \"internal-shared\"\n    },\n    \"dataModelChanges\": [\n      {\n        \"entity\": \"Candidate provenance\",\n        \"change\": \"field-add\",\n        \"details\": \"Build metadata records origin branch and lane. GitHub's repository, workflow run and artifact metadata are authoritative for origin; archive metadata is cross-checked, never used alone to decide eligibility. Promotion and qualification signing are fixed to main rather than taking an expected branch from workflow inputs.\",\n        \"callSites\": [\n          \"scripts/daemon-release-artifact.sh\",\n          \".github/workflows/daemon-candidate.yml\",\n          \".github/workflows/daemon-promotion.yml\",\n          \".github/workflows/daemon-qualification-sign.yml\"\n        ]\n      }\n    ],\n    \"interactionWithShared\": [],\n    \"errorPaths\": {\n      \"errorCases\": [\n        {\n          \"scenario\": \"A v2 artifact is submitted to main qualification or production promotion\",\n          \"detection\": \"Exact GitHub run/artifact provenance differs from fixed expected main ref.\",\n          \"response\": \"Reject before signing or publishing.\",\n          \"userImpact\": \"Build and qualify a new main candidate.\",\n          \"recoverable\": true\n        }\n      ],\n      \"edgeCases\": [\n        {\n          \"input\": \"Byte-identical archive from v2 and main\",\n          \"expected\": \"Only main-origin run and artifact qualify for production.\"\n        },\n        {\n          \"input\": \"Manual workflow missing on default branch\",\n          \"expected\": \"Add the workflow definitions through a narrow reviewed main change; keep main candidate build disabled until packaging code is present in its selected main revision.\"\n        }\n      ],\n      \"invariantsToPreserve\": []\n    },\n    \"testStrategy\": {\n      \"testLevels\": [\n        {\n          \"level\": \"contract\",\n          \"purpose\": \"Exercise branch routing and cross-lane failures locally\",\n          \"subjects\": [\n            \"Workflow policy fixtures for protected main, v2 and other refs\",\n            \"Mock GitHub run and artifact provenance for main, v2 and mismatched SHA or branch\",\n            \"No Actions test commands or v2 signing/publication credentials\"\n          ]\n        }\n      ],\n      \"acceptanceMapping\": [\n        {\n          \"criterionId\": \"ac1\",\n          \"provingTests\": [\n            \"Both allowed refs build only, other refs rejected; main must be protected\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac2\",\n          \"provingTests\": [\n            \"Main exact identity accepted; v2 rejected by both signing and publication even at matching SHA or digest\"\n          ]\n        }\n      ],\n      \"testFramework\": \"Local Node tests with fixture workflow parsing and mocked GitHub API responses.\"\n    },\n    \"migration\": {\n      \"stateBefore\": \"All candidate and signing workflows currently require v2.\",\n      \"stateAfter\": \"v2 builds unpublished dev candidates; protected main builds, signs and promotes its own candidates.\",\n      \"migrationSteps\": [\n        {\n          \"order\": 1,\n          \"action\": \"Land the manual workflow definitions on main via a narrow reviewed change so GitHub can dispatch v2, without merging the full v2 implementation.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 2,\n          \"action\": \"Run unsigned v2 development builds. Enable main release builds only once main contains the installer and packaging code and required protections/environments.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 3,\n          \"action\": \"Build and qualify a fresh main candidate locally; do not promote historic v2 pilot artifacts.\",\n          \"rollbackable\": true\n        }\n      ],\n      \"backwardCompat\": \"Clone-based installer remains default; permit no prior v2 release-control evidence for production.\",\n      \"zeroDowntime\": true,\n      \"dataRewriteRequired\": false\n    },\n    \"alternativesConsidered\": [\n      {\n        \"id\": \"a1\",\n        \"name\": \"Separate lanes\",\n        \"oneLineSummary\": \"Build from both refs and release only main.\",\n        \"approach\": \"Classify by the actual dispatch branch and enforce main provenance independently at production signing.\",\n        \"pros\": [\n          \"Hard separation and exact-archive qualification\"\n        ],\n        \"cons\": [\n          \"A merge to main requires a new qualification\"\n        ],\n        \"costEstimate\": \"M\"\n      },\n      {\n        \"id\": \"a2\",\n        \"name\": \"Promote v2 candidates\",\n        \"oneLineSummary\": \"Publish an existing development candidate.\",\n        \"approach\": \"Approve a v2 artifact and publish without a main build.\",\n        \"pros\": [\n          \"Reuses the development candidate\"\n        ],\n        \"cons\": [\n          \"Violates the requested release origin\"\n        ],\n        \"costEstimate\": \"S\",\n        \"reasonRejected\": \"Production artifact would originate at v2.\"\n      }\n    ],\n    \"chosenAlternative\": \"a1\",\n    \"openQuestions\": []\n  },\n  \"citations\": [\n    {\n      \"id\": \"c1\",\n      \"kind\": \"code\",\n      \"ref\": \".github/workflows/daemon-candidate.yml\"\n    },\n    {\n      \"id\": \"c2\",\n      \"kind\": \"code\",\n      \"ref\": \".github/workflows/daemon-qualification-sign.yml\"\n    },\n    {\n      \"id\": \"c3\",\n      \"kind\": \"code\",\n      \"ref\": \".github/workflows/daemon-promotion.yml\"\n    },\n    {\n      \"id\": \"c4\",\n      \"kind\": \"code\",\n      \"ref\": \"scripts/daemon-release-artifact.sh\"\n    },\n    {\n      \"id\": \"c5\",\n      \"kind\": \"code\",\n      \"ref\": \"scripts/__tests__/promote-daemon-candidate.test.ts\"\n    }\n  ]\n}\n","document":"<!-- insrc:artifact LLD-4adebe9eb17a3ef2-s1 -->\n\n# LLD: STORY-4adebe9eb17a3ef2-s1 — Separate daemon development and release build lanes\n\n## Summary\n\n**Epic:** `separate-daemon-development-release-build-lanes`\n**HLD base run:** `wf-1794661682291-1mqq9e`\n**HLD effective hash:** `4adebe9eb17a...`\n\nUse v2 for unpublished development builds and protected main for production release candidates. Tests still run locally, and only the archive built and qualified from main can be published.\n\n## Contents\n\n1. [HLD context](#1-hld-context)\n2. [Contract details](#2-contract-details)\n3. [Data model changes](#3-data-model-changes)\n4. [Error paths](#4-error-paths)\n5. [Test strategy](#5-test-strategy)\n6. [Migration](#6-migration)\n7. [Alternatives considered](#7-alternatives-considered)\n8. [References](#8-references)\n\n## 1. HLD context\n\n**Framework:** Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\n**Rollout phase:** standalone\n\n## 2. Contract details\n\n**Surface level:** internal-shared\n\n### 2.1 `Build candidate`\n\n```typescript\nbranch ref + exact commit SHA + version → lane, run, artifact and SHA-256\n```\n\n**Returns:** `result` — Verified lane and exact candidate identity or refusal.\n\n**Errors:**\n- `ReleaseGate` when Branch, provenance, or protection does not match the lane.\n\n**Preconditions:**\n- Derive lane from actual dispatch ref; admit only main and v2. Require GitHub branch protection on main. The v2 build job has read-only permissions and no signing or release environment.\n- For both lanes dispatch SHA must equal requested SHA; reject all other refs.\n\n**Postconditions:**\n- Upload unpublished artifact with lane-distinct name and branch/lane in candidate metadata. Run no Actions tests.\n\n### 2.2 `Qualify candidates`\n\n```typescript\ncandidate run + artifact + exact commit → signed qualification manifest or local development checks\n```\n\n**Returns:** `result` — Verified lane and exact candidate identity or refusal.\n\n**Errors:**\n- `ReleaseGate` when Branch, provenance, or protection does not match the lane.\n\n**Preconditions:**\n- Run the release qualification-signing workflow from protected main and accept only successful candidate runs originating at main. Verify branch and commit on run and artifact metadata, repository/workflow identity, lane and digest.\n- Use v2 candidates for local packaging and smoke checks only; never give a v2 job production or qualification signing credentials.\n\n**Postconditions:**\n- Sign main manifest with the isolated qualification key; exercise the exact archive on a disposable Apple Silicon host and bind evidence to the main commit, run, artifact, manifest and archive hashes.\n\n### 2.3 `Publish main release`\n\n```typescript\napproved evidence commit + archive SHA-256 → immutable-identity prerelease\n```\n\n**Returns:** `result` — Verified lane and exact candidate identity or refusal.\n\n**Errors:**\n- `ReleaseGate` when Branch, provenance, or protection does not match the lane.\n\n**Preconditions:**\n- Promotion executes only on protected main and behind the production environment approval. Independently require the exact candidate origin branch to be main even when run IDs and digests are valid; validate the approved evidence and qualification signature.\n- Do not reuse a v2 archive after merging its source to main. A main candidate must be built and locally qualified separately.\n\n**Postconditions:**\n- Sign and publish the exact main archive that passed local tests. Never rebuild at promotion or publish development artifacts.\n\n## 3. Data model changes\n\n### 3.1 `Candidate provenance` — field-add\n\nBuild metadata records origin branch and lane. GitHub's repository, workflow run and artifact metadata are authoritative for origin; archive metadata is cross-checked, never used alone to decide eligibility. Promotion and qualification signing are fixed to main rather than taking an expected branch from workflow inputs.\n\n**Call sites:**\n- `scripts/daemon-release-artifact.sh`\n- `.github/workflows/daemon-candidate.yml`\n- `.github/workflows/daemon-promotion.yml`\n- `.github/workflows/daemon-qualification-sign.yml`\n\n## 4. Error paths\n\n**Error cases**\n\n- **A v2 artifact is submitted to main qualification or production promotion** (recoverable)\n  - Detection: Exact GitHub run/artifact provenance differs from fixed expected main ref.\n  - Response: Reject before signing or publishing.\n  - User impact: Build and qualify a new main candidate.\n\n**Edge cases**\n\n| Input | Expected |\n| :--- | :--- |\n| Byte-identical archive from v2 and main | Only main-origin run and artifact qualify for production. |\n| Manual workflow missing on default branch | Add the workflow definitions through a narrow reviewed main change; keep main candidate build disabled until packaging code is present in its selected main revision. |\n\n## 5. Test strategy\n\n**Test framework:** `Local Node tests with fixture workflow parsing and mocked GitHub API responses.`\n\n**Test levels**\n\n- **contract** — Exercise branch routing and cross-lane failures locally\n  - Subjects: `Workflow policy fixtures for protected main, v2 and other refs`, `Mock GitHub run and artifact provenance for main, v2 and mismatched SHA or branch`, `No Actions test commands or v2 signing/publication credentials`\n\n**Acceptance mapping**\n\n| Criterion | Proving tests |\n| :--- | :--- |\n| `ac1` | `Both allowed refs build only, other refs rejected; main must be protected` |\n| `ac2` | `Main exact identity accepted; v2 rejected by both signing and publication even at matching SHA or digest` |\n\n## 6. Migration\n\n**State before:** All candidate and signing workflows currently require v2.\n\n**State after:** v2 builds unpublished dev candidates; protected main builds, signs and promotes its own candidates.\n\n**Zero downtime:** yes — **Data rewrite:** no\n\n**Steps**\n\n1. Land the manual workflow definitions on main via a narrow reviewed change so GitHub can dispatch v2, without merging the full v2 implementation. — ↩ rollbackable\n2. Run unsigned v2 development builds. Enable main release builds only once main contains the installer and packaging code and required protections/environments. — ↩ rollbackable\n3. Build and qualify a fresh main candidate locally; do not promote historic v2 pilot artifacts. — ↩ rollbackable\n\n**Backward compat:** Clone-based installer remains default; permit no prior v2 release-control evidence for production.\n\n## 7. Alternatives considered\n\n### 7.1 a1: Separate lanes — **CHOSEN**\n\nBuild from both refs and release only main.\n\nClassify by the actual dispatch branch and enforce main provenance independently at production signing.\n\n### 7.2 a2: Promote v2 candidates\n\nPublish an existing development candidate.\n\nApprove a v2 artifact and publish without a main build.\n\n**Rejected because:** Production artifact would originate at v2.\n\n## 8. References\n\n- **[[c1]]** `code` `.github/workflows/daemon-candidate.yml`\n- **[[c2]]** `code` `.github/workflows/daemon-qualification-sign.yml`\n- **[[c3]]** `code` `.github/workflows/daemon-promotion.yml`\n- **[[c4]]** `code` `scripts/daemon-release-artifact.sh`\n- **[[c5]]** `code` `scripts/__tests__/promote-daemon-candidate.test.ts`\n"},"capturedAt":"2026-11-14T13:09:09.024Z"},"inventory":{"units":[{"id":"/body/summary","selector":"/body/summary","title":"summary","kind":"section"},{"id":"/body/hldContextSlice","selector":"/body/hldContextSlice","title":"hldContextSlice","kind":"section"},{"id":"/body/contractDetails","selector":"/body/contractDetails","title":"contractDetails","kind":"section"},{"id":"/body/dataModelChanges","selector":"/body/dataModelChanges","title":"dataModelChanges","kind":"section"},{"id":"/body/interactionWithShared","selector":"/body/interactionWithShared","title":"interactionWithShared","kind":"section"},{"id":"/body/errorPaths","selector":"/body/errorPaths","title":"errorPaths","kind":"section"},{"id":"/body/testStrategy","selector":"/body/testStrategy","title":"testStrategy","kind":"section"},{"id":"/body/migration","selector":"/body/migration","title":"migration","kind":"section"},{"id":"/body/alternativesConsidered","selector":"/body/alternativesConsidered","title":"alternativesConsidered","kind":"section"},{"id":"/body/chosenAlternative","selector":"/body/chosenAlternative","title":"chosenAlternative","kind":"section"},{"id":"/body/openQuestions","selector":"/body/openQuestions","title":"openQuestions","kind":"section"},{"id":"/body/alternativesConsidered/0","selector":"/body/alternativesConsidered/0","title":"a1","kind":"requirement"},{"id":"/body/alternativesConsidered/1","selector":"/body/alternativesConsidered/1","title":"a2","kind":"requirement"},{"id":"/citations/0","selector":"/citations/0","title":"Citation 1","kind":"citation"},{"id":"/citations/1","selector":"/citations/1","title":"Citation 2","kind":"citation"},{"id":"/citations/2","selector":"/citations/2","title":"Citation 3","kind":"citation"},{"id":"/citations/3","selector":"/citations/3","title":"Citation 4","kind":"citation"},{"id":"/citations/4","selector":"/citations/4","title":"Citation 5","kind":"citation"},{"id":"document:line:24","selector":"document:line:24","title":"1. HLD context","kind":"section"}]},"completedChunks":[{"chunkId":"lane-contracts","status":"changes_requested","summary":"The LLD establishes the intended main/v2 split and exact-SHA checks, but leaves the qualification-signing and local qualification sequence unclear. The signing contract does not specify how local qualification evidence is available to the signer before the manifest is signed, even though that signature is part of the later publication gate.","findings":[{"id":"qualification-signing-order","severity":"MED","location":"LLD §2.2, `Qualify candidates` preconditions and postconditions","message":"The workflow is required to sign the qualification manifest from protected main, while local qualification is also required to exercise the exact archive and bind evidence to that manifest. The contract does not say whether local checks happen before signing or how their evidence reaches the signing workflow. This leaves the build → qualify → sign → publish sequence under-specified: publication cannot establish that the qualification signature covers an archive that passed the required local checks.","evidenceReferences":["LLD §2.2: precondition runs the release qualification-signing workflow; postcondition signs the main manifest and exercises the exact archive, binding evidence to the manifest.","LLD §2.3: publication validates approved evidence and the qualification signature.",".github/workflows/daemon-qualification-sign.yml:26–49 accepts run, artifact, commit, sequence, and compatibility inputs, then signs and uploads the manifest; no local qualification evidence input is specified."]}],"inspectedReferences":["/body/summary","/body/contractDetails","/Users/subhagho/work/projects/insors/insrc/docs/standalone/separate-daemon-development-release-build-lanes-E202611144adebe9e/S001/LLD.md",".github/workflows/daemon-candidate.yml",".github/workflows/daemon-qualification-sign.yml",".github/workflows/daemon-promotion.yml","scripts/daemon-release-artifact.sh","scripts/promote-daemon-candidate.mjs","scripts/package-daemon-candidate.mjs","scripts/daemon-bundle-metadata.mjs","scripts/__tests__/promote-daemon-candidate.test.ts",".insrc/artifacts/LLD-4adebe9eb17a3ef2-s1.json"],"limitations":[],"advice":["Specify the ordering and evidence handoff for local qualification and signing, including which exact hashes and test evidence the signer and publisher verify."]},{"chunkId":"provenance-and-failures","status":"passed","summary":"The provenance model makes GitHub run and artifact records authoritative, cross-checks archive metadata, and fixes qualification and promotion eligibility to main. The v2 rejection paths and selected lane model align with the stated goal of unpublished development builds and main-origin production releases. No material defect was found in the assigned sections.","findings":[],"inspectedReferences":["/body/dataModelChanges","/body/errorPaths","/body/alternativesConsidered","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/chosenAlternative","/Users/subhagho/work/projects/insors/insrc/docs/standalone/separate-daemon-development-release-build-lanes-E202611144adebe9e/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/daemon-lanes-4adebe9e.json",".github/workflows/daemon-candidate.yml",".github/workflows/daemon-qualification-sign.yml",".github/workflows/daemon-promotion.yml","scripts/daemon-release-artifact.sh","scripts/package-daemon-candidate.mjs","scripts/promote-daemon-candidate.mjs","scripts/__tests__/promote-daemon-candidate.test.ts",".insrc/artifacts/LLD-4adebe9eb17a3ef2-s1.json"],"limitations":[],"advice":["Consider recording a single explicit provenance tuple for comparisons across the GitHub run, artifact record, and candidate metadata, including repository, workflow identity, branch, commit, run ID, and artifact ID.","The rejected alternative captures promoting v2 candidates. If main-only development builds were considered, briefly explain why the v2 development lane is needed."]},{"chunkId":"verification-and-rollout","status":"changes_requested","summary":"The LLD is explicitly standalone, so the absence of upstream DEF/HLD references is supported by the captured artifact. Its migration describes a plausible rollout order, but the test strategy claims lane-routing and provenance coverage that the cited local tests do not provide; the main/v2 acceptance criteria therefore lack executable proofs in the current suite.","findings":[{"id":"lane-tests-not-demonstrated","severity":"MED","location":"LLD §5, Test strategy and Acceptance mapping","message":"The strategy maps ac1 and ac2 to tests of branch admission, main protection, exact identity, and v2 rejection at signing and publication, but the cited promotion test does not exercise those cases. It creates local manifest/artifact fixtures and checks approval, digest, and evidence checksums; its workflow assertions cover promotion approval and no rebuild. The current candidate and qualification-sign workflows are v2-only, so this suite also does not verify the specified two-lane policy. As written, the acceptance mapping overstates available executable coverage for the core lane contract.","evidenceReferences":["LLD §5: ac1 maps to allowed-ref routing and main protection; ac2 maps to main identity acceptance and v2 rejection at signing and publication.","scripts/__tests__/promote-daemon-candidate.test.ts: promotion fixture tests approval, archive digest, and evidence checksums; workflow test checks promotion approval/no rebuild.",".github/workflows/daemon-candidate.yml: build job is gated to refs/heads/v2.",".github/workflows/daemon-qualification-sign.yml: signing job is gated to refs/heads/v2."]}],"inspectedReferences":["/body/testStrategy","/body/migration","/body/hldContextSlice","/body/openQuestions","document:line:24","/Users/subhagho/work/projects/insors/insrc/docs/standalone/separate-daemon-development-re