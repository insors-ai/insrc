s/5","selector":"/citations/5","title":"Citation 6","kind":"citation"},{"id":"/citations/6","selector":"/citations/6","title":"Citation 7","kind":"citation"},{"id":"/citations/7","selector":"/citations/7","title":"Citation 8","kind":"citation"},{"id":"/citations/8","selector":"/citations/8","title":"Citation 9","kind":"citation"},{"id":"/citations/9","selector":"/citations/9","title":"Citation 10","kind":"citation"},{"id":"/citations/10","selector":"/citations/10","title":"Citation 11","kind":"citation"},{"id":"/citations/11","selector":"/citations/11","title":"Citation 12","kind":"citation"},{"id":"/citations/12","selector":"/citations/12","title":"Citation 13","kind":"citation"},{"id":"/citations/13","selector":"/citations/13","title":"Citation 14","kind":"citation"},{"id":"/citations/14","selector":"/citations/14","title":"Citation 15","kind":"citation"},{"id":"/citations/15","selector":"/citations/15","title":"Citation 16","kind":"citation"},{"id":"/citations/16","selector":"/citations/16","title":"Citation 17","kind":"citation"},{"id":"/citations/17","selector":"/citations/17","title":"Citation 18","kind":"citation"},{"id":"/citations/18","selector":"/citations/18","title":"Citation 19","kind":"citation"},{"id":"/citations/19","selector":"/citations/19","title":"Citation 20","kind":"citation"},{"id":"/citations/20","selector":"/citations/20","title":"Citation 21","kind":"citation"},{"id":"/citations/21","selector":"/citations/21","title":"Citation 22","kind":"citation"},{"id":"/citations/22","selector":"/citations/22","title":"Citation 23","kind":"citation"},{"id":"document:line:25","selector":"document:line:25","title":"1. HLD context","kind":"section"},{"id":"document:line:161","selector":"document:line:161","title":"4. Diagrams","kind":"section"}]},"completedChunks":[{"chunkId":"scope","status":"passed","summary":"All assigned selectors were inspected. The scope and chosen portable-verification alternative align with the originating ISSUE: fresh installation, supported ordinary updates, legacy and recovery jobs, direct installs, broker denial, rollback preservation and Linux compatibility. Revised native verification, persistent rollback preload protection and acknowledgement-before-preparation remain consistent with that scope. The cited BUILD supports the need for portable verification without establishing production qualification. No blocking scope defect was demonstrated.","findings":[],"inspectedReferences":["/body/hldContextSlice","/body/summary","/body/alternativesConsidered","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/alternativesConsidered/2","/body/chosenAlternative","/body/openQuestions","/citations/13","/citations/16","document:line:25","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md",".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md","docs/standalone/restore-reliable-daemon-restart-macos-E202611103992d2e1/ISSUE.md",".insrc/artifacts/BUILD-5d5478c61a25ac8f-s1.json","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/BUILD.md","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:49","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:54","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:57","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:80","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:125","scripts/insrc-daemon-install.sh:188","scripts/insrc-daemon-install.sh:455","src/daemon/managed-release-staging.ts:181","src/daemon/managed-update-preparation.ts:34","src/daemon/managed-update-preparation.ts:73","src/daemon/managed-update-launch.ts:22","src/daemon/managed-update-launch.ts:73","src/daemon/legacy-launch-job.ts:35","src/daemon/legacy-launch-job.ts:76","src/daemon/legacy-launch-job.ts:193","src/daemon/admin-handlers.ts:100","src/daemon/threads/admin-worker.ts",".npmrc",".insrc/tmp/design-review/macos-portable-qualification-5d5478c6.json"],"limitations":[],"advice":["Mention the initial arm64 macOS 27.0 predecessor profile in the product summary to make the supported installation boundary immediately visible.","Label the rendered Epic and HLD metadata as framework bookkeeping so it agrees more clearly with the explicit standalone, issue-originated context."]},{"chunkId":"qualification","status":"passed","summary":"Inspected every assigned selector against the originating ISSUE, build configuration, staging and recovery code, accepted feedback, and actual unequal-path native builds. The revised representation accounts for the observed string-table, __LINKEDIT and signature-boundary variance while preserving runtime relationships and raw rollback identity. Trust admission, offline recovery, publication dependencies and planned negative coverage are consistent. No blocking design defect was demonstrated.","findings":[],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/body/errorPaths","/body/testStrategy","/body/migration","/citations/9","/citations/14","/citations/15","/citations/18","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/macos-portable-qualification-5d5478c6.json","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md","src/daemon/release-compatibility.ts","src/daemon/managed-release-staging.ts","src/daemon/managed-update-preparation.ts",".npmrc","package.json","scripts/insrc-daemon-install.sh","build-process-broker.mjs","build-shutdown-watchdog.mjs","copy-assets.mjs","src/shared/installation-mutation-gate.ts: UpdatePredecessor, journal and decoding validation","src/daemon/managed-update-recovery.ts: release pins and rollback verification","src/daemon/legacy-launch-job.ts","src/daemon/__tests__/managed-release-staging.test.ts","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/TESTS.md","ab6a96296ea6f2bde948636424218c0a23136c74:src/daemon/admin-handlers.ts","ab6a96296ea6f2bde948636424218c0a23136c74:src/daemon/threads/admin-worker.ts","ab6a96296ea6f2bde948636424218c0a23136c74:src/daemon/index.ts:500-590","/private/tmp/insrc-native-study-otoxp86z/first.log","/private/tmp/insrc-native-study-otoxp86z/second-longer-path.log","/private/tmp/insrc-native-study-otoxp86z/first/node_modules/fs-ext/build/Release/fs_ext.node","/private/tmp/insrc-native-study-otoxp86z/second-longer-path/node_modules/fs-ext/build/Release/fs_ext.node","Native sample inspection: original CodeDirectory page hashes verified for both files; tokenized symbol records and preserved binary prefix matched across unequal checkout-root lengths."],"limitations":[],"advice":["Freeze signer/verifier schemas, framing bytes and canonical representation rules with shared test vectors. Include legitimate suffix sharing and debug-root lengths that cross signature-page or segment-alignment boundaries.","Keep existing synthetic test results distinct from future production qualification. This review inspected existing binaries and performed in-memory comparisons; it did not execute product builds, migration tests or release activation."]},{"chunkId":"lifecycle","status":"changes_requested","summary":"All assigned selectors were inspected. The revised preload contract covers both legacy update-handler factories and worker replacements, and acknowledgement ordering aligns with the installed helper handshake. One lifecycle admission gap remains: the restored predecessor still accepts public shutdown requests outside the mutation gate.","findings":[{"id":"lifecycle-public-shutdown-admission-a3","severity":"MED","location":"/body/contractDetails/api/1/postconditions; /body/errorPaths; /body/testStrategy","message":"The rollback preload explicitly retains the original handler table except daemon.update, leaving daemon.shutdown outside InstallationMutationGate. In the pinned predecessor, that handler directly invokes shutdown in both main-thread and admin-worker routing; an existing JetBrains Stop action calls this RPC directly, bypassing the canonical dispatcher. Consequently, a concurrent shutdown can stop the restored predecessor while rollback settlement still owns the reservation, or during preparation for a later managed retry. This defeats the stated lifecycle fence and can invalidate the running state verified for rollback publication. Specify admission for public shutdown while a reservation is active, distinguishing the authorized migration controller's drain from competing clients. Extend the real-predecessor tests to send shutdown before rollback publication and during later preparation, including threaded routing and worker replacement.","evidenceReferences":["docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:80-84 — fenced restoration and original-table preservation except daemon.update","git:ab6a96296ea6f2bde948636424218c0a23136c74:src/daemon/admin-handlers.ts:93-97 — daemon.shutdown invokes the supplied shutdown callback","git:ab6a96296ea6f2bde948636424218c0a23136c74:src/daemon/threads/admin-worker.ts:40-41 — worker shutdown forwards to the main-thread shutdown service","jetbrains-plugin/src/main/kotlin/ai/insors/insrc/jetbrains/daemon/DaemonGateway.kt:1373 — shutdown calls METHOD_SHUTDOWN directly","src/daemon/managed-daemon-lifecycle.ts:publicShutdown — managed public shutdown requires parent admission before local drain","/body/testStrategy/testLevels/7 — proposed restored-predecessor concurrency coverage exercises daemon.update but does not specify shutdown admission"]}],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/body/interactionWithShared","/body/errorPaths","/body/testStrategy","/body/migration","/citations/1","/citations/2","/citations/3","/citations/4","/citations/5","/citations/6","/citations/10","/citations/11","/citations/19","/citations/20","/citations/21","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md",".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json",".insrc/tmp/design-review/macos-portable-qualification-5d5478c6.json — prior lifecycle finding and current qualification feedback","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md","src/shared/managed-daemon-installation.ts","src/shared/installation-mutation-gate.ts","src/shared/daemon-run-files.ts","src/daemon/managed-update-recovery.ts","src/daemon/managed-update-transaction.ts","src/daemon/managed-update-preparation.ts","src/daemon/managed-update-launch.ts","src/daemon/managed-update-handoff.ts","src/bin/insrc-daemon-control.ts","src/bin/insrc-daemon-update.ts","src/daemon/legacy-launch-job.ts","src/daemon/legacy-daemon-cutover.ts","src/daemon/legacy-cutover-admission.ts","src/daemon/legacy-run-guard.ts","src/daemon/fresh-managed-activation.ts","src/daemon/index.ts — startup, routing, worker creation and shutdown","src/daemon/admin-handlers.ts","src/daemon/threads/admin-worker.ts","src/daemon/threads/workers.ts","src/daemon/threads/supervisor.ts","src/daemon/managed-daemon-lifecycle.ts","src/cli/services/daemon.ts — direct legacy shutdown and managed stop routing","jetbrains-plugin/src/main/kotlin/ai/insors/insrc/jetbrains/daemon/DaemonGateway.kt — direct shutdown IPC","src/daemon/__tests__/legacy-cutover-admission.test.ts","src/daemon/__tests__/legacy-daemon-cutover.test.ts","src/daemon/__tests__/legacy-run-guard.test.ts","src/daemon/__tests__/managed-update-transaction.test.ts — publication recovery and legacy rollback fixtures","src/daemon/__tests__/managed-update-handoff.test.ts","src/daemon/__tests__/fresh-managed-activation.test.ts — activation intent and interruption coverage","src/daemon/__tests__/managed-update-ipc.test.ts — test inventory","git:ab6a96296ea6f2bde948636424218c0a23136c74:src/daemon/admin-handlers.ts","git:ab6a96296ea6f2bde948636424218c0a23136c74:src/daemon/update-runner.ts","git:ab6a96296ea6f2bde948636424218c0a23136c74:src/daemon/handler-runtime.ts — sharedAdminHandlers import and table construction","git:ab6a96296ea6f2bde948636424218c0a23136c74:src/daemon/index.ts — lazy main handler construction and queued admin routing","git:ab6a96296ea6f2bde948636424218c0a23136c74:src/daemon/threads/admin-worker.ts","git:ab6a96296ea6f2bde948636424218c0a23136c74:src/daemon/threads/workers.ts — default execArgv inheritance","git:ab6a96296ea6f2bde948636424218c0a23136c74:src/daemon/threads/supervisor.ts — replacement uses the same worker creation path","https://nodejs.org/download/release/v22.23.2/docs/api/module.html","https://nodejs.org/download/release/v22.23.2/docs/api/cli.html"],"limitations":[],"advice":["Make the preload receipt format explicit: bind the restoration generation, process incarnation, worker identity, configuration digest and preload digest, and reject stale receipts.","The pinned Node runtime supports synchronous hooks and preload inheritance through default worker execArgv. Preserve these assumptions in profile qualification tests. See [Node module hooks](https://nodejs.org/download/release/v22.23.2/docs/api/module.html#synchronous-hooks-accepted-by-moduleregisterhooks).","Runtime migration and launchd tests were not executed during this read-only design assessment. Existing synthetic rollback fixtures do not establish the proposed real-predecessor preload behavior."]},{"chunkId":"entrypoints","status":"passed","summary":"Inspected every assigned selector and the relevant instal