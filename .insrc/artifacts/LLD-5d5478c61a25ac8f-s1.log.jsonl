888232	{"artifactId":"LLD-5d5478c61a25ac8f-s1","entry":{"id":"398b9fbd1a7913e2e8962f24614367040177497ecda7f5d17373ae1ca97beaf8","targetHeadHash":"2ea93a6abd6c6d44de83ff4296ad435b59063d97e780c5fe4a3a0cf0a278aa33","actor":{"id":"agent:design-review-daemon","kind":"agent","properties":{"party":"daemon"}},"timestamp":"2026-11-13T05:29:52.035Z","operation":"review","revision":{"number":7,"contentHash":"2e674841f6fba154f895c9beaeeba5b6408d6e3966dec4a3696780f13c5307e7"},"outcome":{"result":"block","summary":"Design review macos-portable-qualification-5d5478c6 attempt 5","data":{"kind":"design-chunk-review","reviewId":"macos-portable-qualification-5d5478c6","project":"/Users/subhagho/work/projects/insors/insrc","artifactId":"LLD-5d5478c61a25ac8f-s1","subject":{"project":"/Users/subhagho/work/projects/insors/insrc","artifactId":"LLD-5d5478c61a25ac8f-s1","kind":"LLD","canonicalPath":"/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json","documentPath":"/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md","reviewer":"daemon","workflow":{"kind":"issue","rootArtifactId":"ISSUE-5d5478c61a25ac8f","requiredReferences":[{"role":"originating_issue","artifactId":"ISSUE-5d5478c61a25ac8f","path":"/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md"}],"availableReferences":[],"notApplicableRoles":["PLAN","TASKS","BUILD","CR","DEF","HLD","sibling_stories"]}},"reviewer":"daemon","applicableAttempt":5,"status":"incomplete","binding":{"sourceRevision":{"number":7,"contentHash":"2e674841f6fba154f895c9beaeeba5b6408d6e3966dec4a3696780f13c5307e7"},"reviewedContentIdentity":"cd387d86a1a489c104c3bd97ee6aa438a53b11699e218907468906690084e63d","documentDigest":"68a80d1a51a60a77f2658646b07f25ba4bb8f9c358ab0ede09e99515a2388298","workflowDigest":"205362792ee2c850ee5e8c3ed5938d86633a344ce17336ab5b03b2d734785a13","author":"controller"},"preservationDigest":"a59e6890d22ed9cbd28b5db2c1684eed9cbf76b867d6824ebc6bd4f413454c58","schemaVersion":1,"submitted":{"artifactPath":"/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md","attempt":1},"attempts":[{"number":1,"status":"incomplete","preparationKind":"planning","baseline":{"subjectFingerprints":{"canonical":"bb503ff2d689bddb50abc4dc28c251aedbb117608850b792d94b4ce7d5100ad4","document":"1c7ef9590d986eb3c854d8146377394b8425d6b7e9c55572d620cb2e0f4564f0"},"contentIdentity":"f7abd2f2be6bedd6765d93a1168c16646720944e1c75e1f3f22411a5b15e7974","reviewedContent":{"canonical":"{\n  \"meta\": {\n    \"workflow\": \"design.story\",\n    \"runId\": \"wf-1794511821464-9fcj7r\",\n    \"repoPath\": \"/Users/subhagho/work/projects/insors/insrc\",\n    \"createdAt\": \"2026-11-12T19:34:18.353Z\",\n    \"epicCreatedAt\": \"2026-11-11T16:00:50.440Z\",\n    \"attribution\": {\n      \"outputs\": [\n        {\n          \"role\": \"(client)\",\n          \"tier\": \"core\",\n          \"runner\": \"cli-codex\",\n          \"model\": \"unknown\"\n        }\n      ]\n    },\n    \"elapsedMs\": 236597,\n    \"repoIndexedAt\": null,\n    \"schemaVersion\": 1,\n    \"epicHash\": \"5d5478c61a25ac8f\",\n    \"epicSlug\": \"enable-managed-daemon-lifecycle-macos-install\",\n    \"storyId\": \"s1\",\n    \"hldBaseRunId\": \"wf-1794511821464-9fcj7r\",\n    \"hldEffectiveHash\": \"4d05d5213995802ad688ffa39adb4599d5999d6181c44071eca69793f37177bd\",\n    \"hldAmendmentsApplied\": [],\n    \"storyTitle\": \"Enable managed daemon lifecycle on macOS install and upgrade\",\n    \"standalone\": true,\n    \"authoredBy\": \"controller\",\n    \"lifecycle\": {\n      \"status\": \"draft\",\n      \"revision\": {\n        \"number\": 3,\n        \"contentHash\": \"dba6413aecdfebe5ed4c0b2b66a3680af7d68d728bdd6cf98c2a794d3d32772d\",\n        \"at\": \"2026-11-12T19:34:18.481Z\",\n        \"by\": {\n          \"id\": \"insrc:system\",\n          \"kind\": \"system\",\n          \"properties\": {}\n        }\n      },\n      \"signoffs\": []\n    },\n    \"envelope\": {\n      \"attachments\": []\n    },\n    \"revision\": 3\n  },\n  \"body\": {\n    \"hldContextSlice\": {\n      \"frameworkSummary\": \"Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\",\n      \"ownedContracts\": [],\n      \"consumedContracts\": [],\n      \"boundary\": {\n        \"storyId\": \"s1\",\n        \"owns\": [],\n        \"depends\": [],\n        \"internal\": \"Enable managed daemon lifecycle on macOS install and upgrade\"\n      },\n      \"adjacentBoundaries\": [],\n      \"rolloutPhase\": \"standalone\",\n      \"nonFunctional\": {}\n    },\n    \"summary\": {\n      \"audience\": \"product\",\n      \"prose\": \"The normal macOS installer provisions a per-user supervisor and automatically migrates supported locally built installs. Before cutover the updater verifies the incumbent against release-authorized build evidence and pins its original bytes for rollback. Existing configuration, stores and running state survive a verified rollback.\"\n    },\n    \"contractDetails\": {\n      \"surfaceLevel\": \"internal-shared\",\n      \"api\": [\n        {\n          \"name\": \"stageManagedRelease\",\n          \"signature\": \"stageManagedRelease(options: StageOptions): Promise<{ readonly candidate: StagedReleasePin; readonly prior?: StagedReleasePin; readonly compatibility?: QualifiedReleasePair }>\",\n          \"parameters\": [\n            {\n              \"name\": \"options\",\n              \"type\": \"StageOptions\",\n              \"purpose\": \"Carries the configured source, exact release pair, authorized build evidence and optional incumbent.\",\n              \"optional\": false\n            }\n          ],\n          \"returns\": {\n            \"type\": \"Promise<{ readonly candidate: StagedReleasePin; readonly prior?: StagedReleasePin; readonly compatibility?: QualifiedReleasePair }>\",\n            \"meaning\": \"Verified candidate and optional byte-exact original rollback pin.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"Error\",\n              \"condition\": \"Missing or invalid signed evidence, unsupported build profile, unaccounted executable differences, ambiguous inventory or unstable pin.\"\n            }\n          ],\n          \"preconditions\": [\n            \"Verify the configured origin, candidate commit, authorized release signature and storage format pair before trusting any candidate-supplied build instruction. Use a trust key shipped with a trusted installer/controller distribution, with scoped key rotation and revocation, independent of the fetched note. A source URL override alone grants no signing authority.\"\n          ],\n          \"postconditions\": [\n            \"The release profile binds predecessor and candidate commits, source and branch, target OS/architecture/ABI, supported toolchain inputs, full runtime inventory, verifier version, expected reference measurements and release test evidence. Measure file paths, modes, links, and raw bytes using owned stable handles. Verify before launcher exchange or shutdown.\",\n            \"Use exact hashes by default. The release-authorized verifier may account only for explicitly qualified differences with independently reproducible proof. For native files cover every code, loadable data, loader command, link/binding, and entitlement value. Compare security-relevant contents exactly, or against independently reconstructed expected bytes for a signed, precisely specified recipe. Omit only parsed, proven non-semantic metadata with bounded ranges and no overlap. Reject malformed layouts, unknown fields, unclassified bytes or unsupported variants. Never apply arbitrary masks, ignore whole native files, or infer build provenance from local measurements or Git cleanliness alone.\",\n            \"After qualification retain a byte-exact digest for all installed runtime files, including fields the verifier classified as non-semantic. Recheck the original pin before and after the launcher fence and before rollback. Candidates also have independent runtime verification before execution.\"\n          ]\n        },\n        {\n          \"name\": \"completeLegacyMigration\",\n          \"signature\": \"completeLegacyMigration(gate: InstallationMutationGate, update: UpdateReservation, pins: ManagedUpdatePins): Promise<DaemonUpdateOutcome>\",\n          \"parameters\": [\n            {\n              \"name\": \"gate\",\n              \"type\": \"InstallationMutationGate\",\n              \"purpose\": \"Owns the cutover and recovery reservation.\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"update\",\n              \"type\": \"UpdateReservation\",\n              \"purpose\": \"Identifies verified predecessor, release, fence and desired state.\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"pins\",\n              \"type\": \"ManagedUpdatePins\",\n              \"purpose\": \"Carries the qualified prior and candidate releases.\",\n              \"optional\": false\n            }\n          ],\n          \"returns\": {\n            \"type\": \"Promise<DaemonUpdateOutcome>\",\n            \"meaning\": \"Verified committed cutover, verified rollback, or fenced recovery.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"SupervisorLifecycleError\",\n              \"condition\": \"A release, launch route, exact exit, or recovery state cannot be verified.\"\n            }\n          ],\n          \"preconditions\": [\n            \"Use the migration-capable installer or updater to prepare the release before invoking any shutdown path. Freeze the canonical legacy launch and checkout paths and verify old mutating helpers are absent before cutover. Verify the pinned predecessor and public socket before sending shutdown.\"\n          ],\n          \"postconditions\": [\n            \"Use the journaled predecessor variant for exit, launchd job removal when applicable, and rollback. Publish a provisional selector before bootstrap. Mark terminal success only after exact candidate registration and verified idle or ready state. Retain a fenced reservation after uncertain outcome publication until recovery has read the matching durable outcome.\"\n          ]\n        }\n      ]\n    },\n    \"dataModelChanges\": [\n      {\n        \"entity\": \"InstallationMutationGate activation reservation\",\n        \"change\": \"field-add\",\n        \"details\": \"Persist one activation reservation per state root with exact owner, candidate and explicit start intent. Journal descriptor, provisional selector, exact registration, child admission, readiness and terminal outcome with identities. Previous journals remain decodable. Activation cleanup reverses only receipted owned mutations.\",\n        \"callSites\": [\n          \"src/shared/installation-mutation-gate.ts\",\n          \"src/shared/managed-daemon-installation.ts\",\n          \"src/bin/insrc-daemon-control.ts\"\n        ]\n      },\n      {\n        \"entity\": \"UpdatePredecessor\",\n        \"change\": \"invariant-change\",\n        \"details\": \"Persist a tagged managed, legacy-job, legacy-direct, or legacy-stopped predecessor. All variants bind canonical state root, prior release/runtime and candidate pin, selector baseline or absence, and prior running state. Managed carries supervisor generation. Legacy-job carries descriptor path/hash, verified label, UID, launchd domain, program argv, working directory and RunAtLoad policy. Running legacy-job and legacy-direct carry exact process incarnation, authenticated socket peer and pinned PID/socket identities. Legacy-direct also carries rollback argv, cwd and a release-qualified environment recipe reconstructed from the supported launcher, without persisting credentials. Legacy-stopped carries proof of no live process and either a pinned idle job or verified absence. Decode historical predecessor.legacy as legacy-job and older enabled prior without legacy as managed. Reject unknown or contradictory variants. Persist each observed exit, its drain classification, and ownership-fence evidence before candidate bootstrap.\",\n        \"callSites\": [\n          \"src/shared/installation-mutation-gate.ts\",\n          \"src/daemon/managed-update-recovery.ts\",\n          \"src/daemon/legacy-launch-job.ts\",\n          \"src/daemon/legacy-daemon-cutover.ts\"\n        ]\n      },\n      {\n        \"entity\": \"Release qualification profile and exact rollback pin\",\n        \"change\": \"invariant-change\",\n        \"details\": \"The release authority owns a signed, versioned profile for one configured source, ordered commit pair and tested build profile. A release pair can have multiple profiles. Exactly one applicable profile must verify a particular installation. An update reservation owns one verified profile receipt and one exact incumbent pin and binds both to its candidate, selector and state root. The profile verifies a complete measured inventory and accounts for variability. The local pin freezes raw bytes for rollback, and the receipt is reusable during recovery without remote network access. Historical journals retain their original verification rules. Versioned notes that lack the required portable proof cannot qualify a source-built variant.\",\n        \"callSites\": [\n          \"src/daemon/managed-release-staging.ts\",\n          \"src/daemon/managed-update-preparation.ts\",\n          \"src/daemon/release-compatibility.ts\",\n          \"src/daemon/managed-update-recovery.ts\"\n        ]\n      }\n    ],\n    \"interactionWithShared\": [],\n    \"errorPaths\": {\n      \"errorCases\": [\n        {\n          \"scenario\": \"An older launcher or updater can still mutate the legacy install\",\n          \"detection\": \"Resolve the canonical checkout and every supported launch route. Atomically exchange the canonical checkout entry with a gate-aware dispatcher on the same filesystem while the old daemon is still running. Preserve the displaced checkout separately. Before stopping, verify the dispatcher and archived checkout identities, an absent or owned legacy update marker, and absence of known old shell, detached helper and installer processes bound to the retired root, using verified argv and cwd. Repeat admission after the swap. An unrecognized launch path, unresolved process identity, live old mutator, or exchange failure makes exclusivity unproven.\",\n          \"response\": \"The dispatcher rejects concurrent mutation while cutover owns the reservation. Qualify only predecessors that acquire the shared run-file guard before opening data and whose shipped old commands use the canonical absolute entry. Keep that guard through owned cleanup and transfer it to candidate startup before the legacy route can reacquire it. Refuse when another legacy route cannot be fenced. Preserve or restore the old service before releasing a failed admission.\",\n          \"userImpact\": \"The supported update retries safely after a concurrent operation ends.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Predecessor job or runtime does not match the qualified route\",\n          \"detection\": \"Match the verified launchd registration against its owned descriptor bytes and approved exact argv. Match direct socket peer and executable against the qualified launch recipe. Accept the documented recovery LaunchAgent only with its pinned tsx loader arguments, canonical entry, matching working directory, bounded owned descriptor and passive restart policy.\",\n          \"response\": \"Reject foreign jobs, unknown loaders or args, conflicting restart policy and unverifiable direct rollback settings before disruption. Recheck the descriptor, PID incarnation and run-file identities immediately before each action.\",\n          \"userImpact\": \"The updater reports the unsupported predecessor while preserving the current service.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Exit is unconfirmed or graceful drain cannot be classified\",\n          \"detection\": \"Observe the exact predecessor exit independently of the broker and bind any qualified terminal evidence to the authenticated shutdown request and process incarnation. An RPC acknowledgement, socket close, PID disappearance, or generic log entry alone does not prove a graceful drain.\",\n          \"response\": \"Withhold candidate admission until exact exit is proved. Journal the exit plus graceful, broker-denied, or unknown. Use graceful only for a qualified positive completion signal, broker-denied only for correlated watchdog evidence, and unknown otherwise. Both broker-denied and unknown require a release pair explicitly qualified for crash-consistent reopening. Report the observed classification in the update detail.\",\n          \"userImpact\": \"The user can distinguish a verified shutdown from an exit whose drain could not be confirmed.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Candidate bootstrap or readiness fails before a durable outcome\",\n          \"detection\": \"Registration, startup generation, owned run files, or candidate idle/readiness cannot be verified.\",\n          \"response\": \"Reconcile the candidate under the reservation, restore the prior selector or absence and the canonical launcher, then restore and verify the exact previous job or direct launch only if it was running. Retain a fence when restoration is unverified.\",\n          \"userImpact\": \"Verified rollback restores the previous service state and reports the failed update.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Outcome publication throws or its acknowledgement is lost\",\n          \"detection\": \"Publication fails, or retry sees an active reservation without a verified terminal reply.\",\n          \"response\": \"Keep the reservation. Re-read the exact matching durable outcome through existing recovery. A durable success verifies or completes activation without rollback. A durable rollback verifies the old state. Only a proven uncommitted transaction can unwind. Unknown ownership remains fenced.\",\n          \"userImpact\": \"The updater reports an unconfirmed result until recovery determines the terminal state.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Release qualification is missing, ambiguous, stale, revoked or invalid\",\n          \"detection\": \"Reject absent note, invalid signature or key, unsupported profile or verifier version, source or commit mismatch, conflicting profiles and any unaccounted runtime difference.\",\n          \"response\": \"Report the failed verification before any incumbent shutdown, fence or selector mutation. Discard only owned preparation artifacts and preserve the incumbent.\",\n          \"userImpact\": \"The daemon remains available with an update diagnostic and can retry after a qualified release is published.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Installed runtime changes after independent verification\",\n          \"detection\": \"Recheck the original raw digest and exact file identities while holding update admission at the designated cutover and rollback boundaries.\",\n          \"response\": \"Stop cutover before touching the incumbent when possible. After mutation use the existing exact rollback or fenced recovery. Refuse to execute any changed rollback copy.\",\n          \"userImpact\": \"The update fails with a verification diagnostic.\",\n          \"recoverable\": true\n        }\n      ],\n      \"edgeCases\": [\n        {\n          \"input\": \"Fresh --no-start\",\n          \"expected\": \"Register the supervisor, enable the selector and verify idle with no daemon child. Subsequent normal start uses the same supervisor.\"\n        },\n        {\n          \"input\": \"Already-managed update when the daemon is stopped\",\n          \"expected\": \"The external controller prepares and commits the update using supervisor status; no daemon RPC is required. Keep the candidate idle.\"\n        },\n        {\n          \"input\": \"Legacy daemon remains running while the candidate is staged\",\n          \"expected\": \"Build outside the live root, preserve the running predecessor and only then acquire a cutover reservation. Failed fetch, build, or qualification leaves the running install unchanged.\"\n        },\n        {\n          \"input\": \"An unchanged older shell or IDE freshness client invokes legacy restart or daemon.update\",\n          \"expected\": \"An old client cannot acquire new preflight behavior before executing its existing shutdown sequence. The first upgrade is delivered by the current standard installer or the ordinary update action in updated IDE clients. The installer may be rerun on an existing installation without launchctl or file edits. Never present an old acknowledgement as migration success.\"\n        },\n        {\n          \"input\": \"Two qualified installs share a commit but have different build paths or raw native artifact bytes\",\n          \"expected\": \"Each matches independent expected execution-bearing bytes under the same tested profile and retains its own raw exact pin.\"\n        }\n      ],\n      \"invariantsToPreserve\": [\n        {\n          \"text\": \"One state root has at most one daemon process admitted to use its stores.\",\n          \"source\": \"c2\"\n        },\n        {\n          \"text\": \"Committed success is never rolled back because the publication reply was lost.\",\n          \"source\": \"c4\"\n        },\n        {\n          \"text\": \"Linux keeps its current lifecycle and update behavior.\",\n          \"source\": \"c1\"\n        }\n      ]\n    },\n    \"testStrategy\": {\n      \"testLevels\": [\n        {\n          \"level\": \"unit\",\n          \"purpose\": \"Verify admission, qualification, journal compatibility and outcome recovery.\",\n          \"subjects\": [\n            \"Predecessor variants and backward decoding\",\n            \"Explicit fresh activation start intent and owned partial publication\",\n            \"Release provenance, changed bytes and absent legacy declaration\",\n            \"Graceful, broker-denied and unknown drain evidence\",\n            \"Uncertain publication with durable success versus no outcome\"\n          ]\n        },\n        {\n          \"level\": \"integration\",\n          \"purpose\": \"Drive supported entry points and competing legacy operations through the real controller boundaries.\",\n          \"subjects\": [\n            \"Installer and updated CLI, VS Code and JetBrains route matrix\",\n            \"Running managed update IPC and stopped local managed update\",\n            \"Old shell/helper concurrent with canonical launcher exchange and old child attempting to open stores\",\n            \"Startup guard transfer, candidate bootstrap failure, rollback and repeated recovery\",\n            \"Linux normal install, update and restart unchanged\"\n          ]\n        },\n        {\n          \"level\": \"smoke\",\n          \"purpose\": \"Verify actual launchd and daemon state on macOS.\",\n          \"subjects\": [\n            \"Fresh install and verified ordinary restart\",\n            \"Fresh --no-start and later supervisor start\",\n            \"First supported update of a qualified prior build with broker denial\",\n            \"Direct install and passive recovery job with exact loader argv\",\n            \"Verified stopped and running rollback with configuration and store integrity\"\n          ],\n          \"fixturesNeeded\": [\n            \"Disposable macOS state roots and isolated launchd labels\",\n            \"Pinned released predecessors, including the regression and clean-drain cases\"\n          ]\n        },\n        {\n          \"level\": \"contract\",\n          \"purpose\": \"Verify release signatures, independent expected inventory, applicability, exact runtime coverage, and report provenance.\",\n          \"subjects\": [\n            \"Independent same-commit macOS build equivalence and tamper rejection\",\n            \"Changed native code, loadable data, bindings, signature policy, injected modules, symlinks and unidentified variance fail closed\",\n            \"Missing or stale release evidence prevents promotion and leaves the incumbent running\"\n          ]\n        },\n        {\n          \"level\": \"smoke\",\n          \"purpose\": \"Require real product builds before promoting a source-built profile.\",\n          \"subjects\": [\n            \"Release publication validates real running and stopped upgrades for every enabled profile\",\n            \"Real product passive and recovery job loader arguments, verified broker refusal, data-preserving rollback and subsequent managed update\"\n          ],\n          \"fixturesNeeded\": [\n            \"Two independent production installer builds of the same supported predecessor in different homes with observed native variance\",\n            \"Real predecessor and candidate installs using disposable homes and distinct launchd jobs\",\n            \"Qualification from an isolated release authority, plus immutable test receipts bound to promoted release metadata\"\n          ]\n        }\n      ],\n      \"acceptanceMapping\": [\n        {\n          \"criterionId\": \"ac1\",\n          \"provingTests\": [\n            \"Fresh install and verified ordinary restart\",\n            \"Fresh --no-start and later supervisor start\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac2\",\n          \"provingTests\": [\n            \"Installer and updated CLI, VS Code and JetBrains route matrix\",\n            \"First supported update of a qualified prior build with broker denial\",\n            \"Direct install and passive recovery job with exact loader argv\",\n            \"Old shell/helper concurrent with canonical launcher exchange and old child attempting to open stores\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac3\",\n          \"provingTests\": [\n            \"Running managed update IPC and stopped local managed update\",\n            \"Verified stopped and running rollback with configuration and store integrity\",\n            \"Uncertain publication with durable success versus no outcome\",\n            \"Linux normal install, update and restart unchanged\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac4\",\n          \"provingTests\": [\n            \"Independent same-commit macOS build equivalence and tamper rejection\",\n            \"Release publication validates real running and stopped upgrades for every enabled profile\"\n          ]\n        }\n      ],\n      \"testFramework\": \"Node.js test runner via tsx, installed shell integration fixtures, and real macOS launchd smoke tests in disposable state roots.\"\n    },\n    \"migration\": {\n      \"stateBefore\": \"The s1 discovery bundle identified whole-tree prior fingerprint qualification before managed migration. Two builds of the same legacy commit produced different native executable bytes. The configured origin was missing the qualification ref.\",\n      \"stateAfter\": \"Current install and update entry points share a migration-capable controller and immutable releases. A supported first upgrade retains the previous release and establishes one verified per-user supervisor. User data remains in the existing state root.\",\n      \"migrationSteps\": [\n        {\n          \"order\": 1,\n          \"action\": \"The release maintainer runs the real matrix on independent predecessor builds, signs profile and result digests, and publishes the note to the configured release origin. A promotion check fetches the published note as a normal updater, checks trust and exact branch head, and blocks release promotion unless all supported profiles pass. Unsupported profiles remain unadvertised. Test-only origins and signer keys cannot qualify a production release.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 2,\n          \"action\": \"Use the current standard installer for both fresh installs and first upgrades. Updated VS Code and JetBrains lifecycle Update on unmanaged Darwin dispatch the packaged migration-capable installer in existing-install mode with the configured branch and root. Updated freshness clients route unmanaged Darwin to that same action before sending any daemon.update RPC. A migration-capable shell or TUI starts the same external preflight on ordinary Update. For already-installed binaries that cannot obtain new code before shutdown, the supported first-upgrade action is the current standard installer, including the normal Install action in an updated IDE. No manual service administration is part of that path.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 3,\n          \"action\": \"Verify the signed release evidence and stage the candidate in a separate owned root. Verify the real incumbent against the supported profile, pin raw incumbent and candidate bytes, and check launchd admission. A failed verification leaves the existing daemon alone. Fresh install enters the activation reservation with explicit start intent.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 4,\n          \"action\": \"For legacy cutover, reserve and atomically replace the canonical installed checkout entry with a gate-aware dispatcher while preserving its original directory identity. Recover either side of the exchange by journaled inode evidence. Recheck for in-flight old helpers, update markers, unsupported launch routes, and mismatched job registrations. The dispatcher has no old executable or mutable checkout target. Refuse when the old launcher or writer cannot be excluded. Keep the prior checkout pinned until rollback is no longer needed.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 5,\n          \"action\": \"Authenticate the running predecessor over the pinned socket and observe exact exit. While the canonical launcher remains fenced, acquire the legacy-compatible run-file guard before cleanup, reconcile only the recorded publications, and retain the guard until a verified supervisor has adopted it for startup. Transfer owner evidence under the same directory identity with no unguarded interval. Remove a verified passive old job after its child exits. Apply the stored outcome policy for graceful, broker-denied, or unknown exit.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 6,\n          \"action\": \"Journal the provisional selector and register the supervisor. Start a child for a normal fresh install or previously running update. Verify idle for --no-start or previously stopped update. Publish the matching durable terminal record before release. An already-managed shell/TUI update uses the external transaction even when stopped, and the running managed RPC uses the detached helper and acknowledgement handshake.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 7,\n          \"action\": \"Recover from interrupted activation or cutover using the matching durable outcome. Restore an uncommitted predecessor by reversing owned mutations, restoring the canonical legacy entry and revalidating the predecessor's exact original launch route. Retain a fence on uncertainty. Do not roll back a verified durable success.\",\n          \"rollbackable\": true\n        }\n      ],\n      \"backwardCompat\": \"Preserve the CLI flags, configured source, IDE IPC result shapes, supported user settings, Linux behavior and historical journal decoding. Existing binaries that stop before they can fetch the migration use the current normal installer for the first upgrade. The canonical installed launcher remains a compatible entry point after migration.\",\n      \"zeroDowntime\": false,\n      \"dataRewriteRequired\": false\n    },\n    \"alternativesConsidered\": [\n      {\n        \"id\": \"a1\",\n        \"name\": \"Release-signed build verification profiles\",\n        \"oneLineSummary\": \"Use independent release evidence for portable equivalence and an exact local pin for rollback.\",\n        \"approach\": \"Publish a signed profile per tested predecessor and platform. Verify its complete runtime inventory against an independently built reference using exact hashes by default and bounded deterministic transformations only for verified build variance. Bind the original measured bytes to the cutover journal.\",\n        \"pros\": [\n          \"Supports independently built installations inside a tested profile.\",\n          \"Rejects unexplained executable changes before shutdown.\"\n        ],\n        \"cons\": [\n          \"Requires maintaining release fixtures and qualifying each native transformation.\"\n        ],\n        \"costEstimate\": \"L\"\n      },\n      {\n        \"id\": \"a2\",\n        \"name\": \"Exact release fingerprints only\",\n        \"oneLineSummary\": \"Accept an inventory of byte-identical prior builds.\",\n        \"approach\": \"Publish one exact fingerprint for each independently archived prior package and continue requiring an exact installed match.\",\n        \"pros\": [\n          \"Simple executable verification.\",\n          \"Retains the existing staging pin format.\"\n        ],\n        \"cons\": [\n          \"The same commit produced different native bytes on the two observed installs.\",\n          \"Uncatalogued local builds cannot migrate automatically.\"\n        ],\n        \"costEstimate\": \"S\",\n        \"reasonRejected\": \"An exact reference fingerprint rejects separately built valid native binaries.\"\n      },\n      {\n        \"id\": \"a3\",\n        \"name\": \"Rebuild a rollback release from the old commit\",\n        \"oneLineSummary\": \"Use an independently verified replacement rollback build.\",\n        \"approach\": \"Fetch and rebuild the predecessor in a separate directory using pinned release inputs, then use that result as the rollback executable.\",\n        \"pros\": [\n          \"Supports a clean executable artifact without a per-install binary catalogue.\"\n        ],\n        \"cons\": [\n          \"Does not establish the original incumbent executable's provenance.\",\n          \"Replaces the exact prior executable and introduces a new rollback compatibility surface.\"\n        ],\n        \"costEstimate\": \"L\",\n        \"reasonRejected\": \"A replacement rollback build leaves original executable provenance unverified and changes rollback identity.\"\n      }\n    ],\n    \"chosenAlternative\": \"a1\",\n    \"openQuestions\": [],\n    \"sequenceDefinition\": {\n      \"id\": \"macos-install-cutover\",\n      \"narrative\": \"Release authority publishes evidence before the updater runs. The controller verifies the installed release and records the exact rollback pin before it fences the launcher or asks the incumbent to exit. The existing journal settles running, idle and rollback outcomes.\",\n      \"participants\": [\n        {\n          \"id\": \"release\",\n          \"label\": \"Release authority\",\n          \"description\": \"Publishes signed and tested qualification for the exact ordered release pair.\"\n        },\n        {\n          \"id\": \"entry\",\n          \"label\": \"Installer / update\",\n          \"description\": \"Stages a release through a supported entry point.\"\n        },\n        {\n          \"id\": \"control\",\n          \"label\": \"Controller\",\n          \"description\": \"Owns the journal and cutover fence.\"\n        },\n        {\n          \"id\": \"old\",\n          \"label\": \"Legacy service\",\n          \"description\": \"Pinned predecessor process and job, if present.\"\n        },\n        {\n          \"id\": \"new\",\n          \"label\": \"Supervisor\",\n          \"description\": \"Owns the candidate daemon or verifies idle.\"\n        },\n        {\n          \"id\": \"child\",\n          \"label\": \"Daemon\",\n          \"description\": \"Candidate serving only after admission.\"\n        }\n      ],\n      \"messages\": [\n        {\n          \"from\": \"release\",\n          \"to\": \"entry\",\n          \"label\": \"Publish signed qualification\",\n          \"description\": \"Publish only after real independent builds and the product migration matrix pass.\"\n        },\n        {\n          \"from\": \"entry\",\n          \"to\": \"control\",\n          \"label\": \"Stage release and verify prior\",\n          \"description\": \"Verify signed evidence, inventory and runtime files while the incumbent is available.\"\n        },\n        {\n          \"from\": \"control\",\n          \"to\": \"control\",\n          \"label\": \"Retain raw rollback pin\",\n          \"description\": \"Record the local digest of all original bytes and bind it to the verified profile.\"\n        },\n        {\n          \"from\": \"control\",\n          \"to\": \"control\",\n          \"label\": \"Reserve and fence\",\n          \"description\": \"Journal the entry switch and exclude older writers.\"\n        },\n        {\n          \"from\": \"control\",\n          \"to\": \"old\",\n          \"label\": \"If running: request exit\",\n          \"description\": \"Authenticate the socket and observe exact exit.\"\n        },\n        {\n          \"from\": \"old\",\n          \"to\": \"control\",\n          \"label\": \"Verified exit\",\n          \"description\": \"Keep the launcher fenced and reconcile owned publications.\"\n        },\n        {\n          \"from\": \"control\",\n          \"to\": \"new\",\n          \"label\": \"Publish selector, register job\",\n          \"description\": \"Verify the exact supervisor and admit the requested state.\"\n        },\n        {\n          \"from\": \"new\",\n          \"to\": \"child\",\n          \"label\": \"Running route: start\",\n          \"description\": \"Start one child if requested or previously running.\"\n        },\n        {\n          \"from\": \"child\",\n          \"to\": \"new\",\n          \"label\": \"Running route: readiness\",\n          \"description\": \"Verify authenticated child and publication identities.\"\n        },\n        {\n          \"from\": \"new\",\n          \"to\": \"control\",\n          \"label\": \"Stopped route: verify idle\",\n          \"description\": \"No child is admitted and no daemon readiness is expected.\"\n        },\n        {\n          \"from\": \"control\",\n          \"to\": \"entry\",\n          \"label\": \"Success: commit result\",\n          \"description\": \"Persist verified running or stopped state.\"\n        },\n        {\n          \"from\": \"control\",\n          \"to\": \"new\",\n          \"label\": \"Before commit: reconcile candidate\",\n          \"description\": \"On verified uncommitted failure, stop the exact candidate and remove its owned job.\"\n        },\n        {\n          \"from\": \"control\",\n          \"to\": \"old\",\n          \"label\": \"Rollback: restore prior state\",\n          \"description\": \"Restore the selector or absence, launcher and prior service state.\"\n        },\n        {\n          \"from\": \"control\",\n          \"to\": \"entry\",\n          \"label\": \"Report rollback or keep fence\",\n          \"description\": \"Report restored state only when verified. Retain the fence on ambiguous ownership or terminal publication.\"\n        }\n      ]\n    },\n    \"companions\": [\n      {\n        \"kind\": \"diagram-mermaid\",\n        \"relPath\": \"docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html\",\n        \"title\": \"Sequence diagram\"\n      }\n    ]\n  },\n  \"citations\": [\n    {\n      \"id\": \"c1\",\n      \"kind\": \"code\",\n      \"ref\": \"scripts/insrc-daemon-install.sh\"\n    },\n    {\n      \"id\": \"c2\",\n      \"kind\": \"code\",\n      \"ref\": \"src/shared/managed-daemon-installation.ts\"\n    },\n    {\n      \"id\": \"c3\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/managed-update-recovery.ts\"\n    },\n    {\n      \"id\": \"c4\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/managed-update-transaction.ts\"\n    },\n    {\n      \"id\": \"c5\",\n      \"kind\": \"code\",\n      \"ref\": \"src/bin/insrc-daemon-control.ts\"\n    },\n    {\n      \"id\": \"c6\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/legacy-launch-job.ts\"\n    },\n    {\n      \"id\": \"c7\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/legacy-daemon-cutover.ts\"\n    },\n    {\n      \"id\": \"c8\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/update-runner.ts\"\n    },\n    {\n      \"id\": \"c9\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/admin-handlers.ts\"\n    },\n    {\n      \"id\": \"c10\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/release-compatibility.ts\"\n    },\n    {\n      \"id\": \"c11\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/index.ts\"\n    },\n    {\n      \"id\": \"c12\",\n      \"kind\": \"code\",\n      \"ref\": \"src/shared/daemon-run-files.ts\"\n    },\n    {\n      \"id\": \"c13\",\n      \"kind\": \"code\",\n      \"ref\": \"scripts/daemon-ctl.sh\"\n    },\n    {\n      \"id\": \"c14\",\n      \"kind\": \"prior-artifact\",\n      \"ref\": \"ISSUE-5d5478c61a25ac8f\"\n    },\n    {\n      \"id\": \"c20\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/managed-release-staging.ts\"\n    },\n    {\n      \"id\": \"c21\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/managed-update-preparation.ts\"\n    },\n    {\n      \"id\": \"c22\",\n      \"kind\": \"prior-artifact\",\n      \"ref\": \"BUILD-5d5478c61a25ac8f-s1\"\n    }\n  ]\n}\n","document":"<!-- insrc:artifact LLD-5d5478c61a25ac8f-s1 -->\n\n# LLD: STORY-5d5478c61a25ac8f-s1 — Enable managed daemon lifecycle on macOS install and upgrade\n\n## Summary\n\n**Epic:** `enable-managed-daemon-lifecycle-macos-install`\n**HLD base run:** `wf-1794511821464-9fcj7r`\n**HLD effective hash:** `4d05d5213995...`\n\nThe normal macOS installer provisions a per-user supervisor and automatically migrates supported locally built installs. Before cutover the updater verifies the incumbent against release-authorized build evidence and pins its original bytes for rollback. Existing configuration, stores and running state survive a verified rollback.\n\n## Contents\n\n1. [HLD context](#1-hld-context)\n2. [Contract details](#2-contract-details)\n3. [Data model changes](#3-data-model-changes)\n4. [Diagrams](#4-diagrams)\n5. [Error paths](#5-error-paths)\n6. [Test strategy](#6-test-strategy)\n7. [Migration](#7-migration)\n8. [Alternatives considered](#8-alternatives-considered)\n9. [References](#9-references)\n\n## 1. HLD context\n\n**Framework:** Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\n**Rollout phase:** standalone\n\n## 2. Contract details\n\n**Surface level:** internal-shared\n\n### 2.1 `stageManagedRelease`\n\n```typescript\nstageManagedRelease(options: StageOptions): Promise<{ readonly candidate: StagedReleasePin; readonly prior?: StagedReleasePin; readonly compatibility?: QualifiedReleasePair }>\n```\n\n**Parameters:**\n- `options: StageOptions` — Carries the configured source, exact release pair, authorized build evidence and optional incumbent.\n\n**Returns:** `Promise<{ readonly candidate: StagedReleasePin; readonly prior?: StagedReleasePin; readonly compatibility?: QualifiedReleasePair }>` — Verified candidate and optional byte-exact original rollback pin.\n\n**Errors:**\n- `Error` when Missing or invalid signed evidence, unsupported build profile, unaccounted executable differences, ambiguous inventory or unstable pin.\n\n**Preconditions:**\n- Verify the configured origin, candidate commit, authorized release signature and storage format pair before trusting any candidate-supplied build instruction. Use a trust key shipped with a trusted installer/controller distribution, with scoped key rotation and revocation, independent of the fetched note. A source URL override alone grants no signing authority.\n\n**Postconditions:**\n- The release profile binds predecessor and candidate commits, source and branch, target OS/architecture/ABI, supported toolchain inputs, full runtime inventory, verifier version, expected reference measurements and release test evidence. Measure file paths, modes, links, and raw bytes using owned stable handles. Verify before launcher exchange or shutdown.\n- Use exact hashes by default. The release-authorized verifier may account only for explicitly qualified differences with independently reproducible proof. For native files cover every code, loadable data, loader command, link/binding, and entitlement value. Compare security-relevant contents exactly, or against independently reconstructed expected bytes for a signed, precisely specified recipe. Omit only parsed, proven non-semantic metadata with bounded ranges and no overlap. Reject malformed layouts, unknown fields, unclassified bytes or unsupported variants. Never apply arbitrary masks, ignore whole native files, or infer build provenance from local measurements or Git cleanliness alone.\n- After qualification retain a byte-exact digest for all installed runtime files, including fields the verifier classified as non-semantic. Recheck the original pin before and after the launcher fence and before rollback. Candidates also have independent runtime verification before execution.\n\n### 2.2 `completeLegacyMigration`\n\n```typescript\ncompleteLegacyMigration(gate: InstallationMutationGate, update: UpdateReservation, pins: ManagedUpdatePins): Promise<DaemonUpdateOutcome>\n```\n\n**Parameters:**\n- `gate: InstallationMutationGate` — Owns the cutover and recovery reservation.\n- `update: UpdateReservation` — Identifies verified predecessor, release, fence and desired state.\n- `pins: ManagedUpdatePins` — Carries the qualified prior and candidate releases.\n\n**Returns:** `Promise<DaemonUpdateOutcome>` — Verified committed cutover, verified rollback, or fenced recovery.\n\n**Errors:**\n- `SupervisorLifecycleError` when A release, launch route, exact exit, or recovery state cannot be verified.\n\n**Preconditions:**\n- Use the migration-capable installer or updater to prepare the release before invoking any shutdown path. Freeze the canonical legacy launch and checkout paths and verify old mutating helpers are absent before cutover. Verify the pinned predecessor and public socket before sending shutdown.\n\n**Postconditions:**\n- Use the journaled predecessor variant for exit, launchd job removal when applicable, and rollback. Publish a provisional selector before bootstrap. Mark terminal success only after exact candidate registration and verified idle or ready state. Retain a fenced reservation after uncertain outcome publication until recovery has read the matching durable outcome.\n\n## 3. Data model changes\n\n### 3.1 `InstallationMutationGate activation reservation` — field-add\n\nPersist one activation reservation per state root with exact owner, candidate and explicit start intent. Journal descriptor, provisional selector, exact registration, child admission, readiness and terminal outcome with identities. Previous journals remain decodable. Activation cleanup reverses only receipted owned mutations.\n\n**Call sites:**\n- `src/shared/installation-mutation-gate.ts`\n- `src/shared/managed-daemon-installation.ts`\n- `src/bin/insrc-daemon-control.ts`\n\n### 3.2 `UpdatePredecessor` — invariant-change\n\nPersist a tagged managed, legacy-job, legacy-direct, or legacy-stopped predecessor. All variants bind canonical state root, prior release/runtime and candidate pin, selector baseline or absence, and prior running state. Managed carries supervisor generation. Legacy-job carries descriptor path/hash, verified label, UID, launchd domain, program argv, working directory and RunAtLoad policy. Running legacy-job and legacy-direct carry exact process incarnation, authenticated socket peer and pinned PID/socket identities. Legacy-direct also carries rollback argv, cwd and a release-qualified environment recipe reconstructed from the supported launcher, without persisting credentials. Legacy-stopped carries proof of no live process and either a pinned idle job or verified absence. Decode historical predecessor.legacy as legacy-job and older enabled prior without legacy as managed. Reject unknown or contradictory variants. Persist each observed exit, its drain classification, and ownership-fence evidence before candidate bootstrap.\n\n**Call sites:**\n- `src/shared/installation-mutation-gate.ts`\n- `src/daemon/managed-update-recovery.ts`\n- `src/daemon/legacy-launch-job.ts`\n- `src/daemon/legacy-daemon-cutover.ts`\n\n### 3.3 `Release qualification profile and exact rollback pin` — invariant-change\n\nThe release authority owns a signed, versioned profile for one configured source, ordered commit pair and tested build profile. A release pair can have multiple profiles. Exactly one applicable profile must verify a particular installation. An update reservation owns one verified profile receipt and one exact incumbent pin and binds both to its candidate, selector and state root. The profile verifies a complete measured inventory and accounts for variability. The local pin freezes raw bytes for rollback, and the receipt is reusable during recovery without remote network access. Historical journals retain their original verification rules. Versioned notes that lack the required portable proof cannot qualify a source-built variant.\n\n**Call sites:**\n- `src/daemon/managed-release-staging.ts`\n- `src/daemon/managed-update-preparation.ts`\n- `src/daemon/release-compatibility.ts`\n- `src/daemon/managed-update-recovery.ts`\n\n## 4. Diagrams\n\n- [Sequence diagram](docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html)\n\n## 5. Error paths\n\n**Error cases**\n\n- **An older launcher or updater can still mutate the legacy install** (recoverable)\n  - Detection: Resolve the canonical checkout and every supported launch route. Atomically exchange the canonical checkout entry with a gate-aware dispatcher on the same filesystem while the old daemon is still running. Preserve the displaced checkout separately. Before stopping, verify the dispatcher and archived checkout identities, an absent or owned legacy update marker, and absence of known old shell, detached helper and installer processes bound to the retired root, using verified argv and cwd. Repeat admission after the swap. An unrecognized launch path, unresolved process identity, live old mutator, or exchange failure makes exclusivity unproven.\n  - Response: The dispatcher rejects concurrent mutation while cutover owns the reservation. Qualify only predecessors that acquire the shared run-file guard before opening data and whose shipped old commands use the canonical absolute entry. Keep that guard through owned cleanup and transfer it to candidate startup before the legacy route can reacquire it. Refuse when another legacy route cannot be fenced. Preserve or restore the old service before releasing a failed admission.\n  - User impact: The supported update retries safely after a concurrent operation ends.\n- **Predecessor job or runtime does not match the qualified route** (recoverable)\n  - Detection: Match the verified launchd registration against its owned descriptor bytes and approved exact argv. Match direct socket peer and executable against the qualified launch recipe. Accept the documented recovery LaunchAgent only with its pinned tsx loader arguments, canonical entry, matching working directory, bounded owned descriptor and passive restart policy.\n  - Response: Reject foreign jobs, unknown loaders or args, conflicting restart policy and unverifiable direct rollback settings before disruption. Recheck the descriptor, PID incarnation and run-file identities immediately before each action.\n  - User impact: The updater reports the unsupported predecessor while preserving the current service.\n- **Exit is unconfirmed or graceful drain cannot be classified** (recoverable)\n  - Detection: Observe the exact predecessor exit independently of the broker and bind any qualified terminal evidence to the authenticated shutdown request and process incarnation. An RPC acknowledgement, socket close, PID disappearance, or generic log entry alone does not prove a graceful drain.\n  - Response: Withhold candidate admission until exact exit is proved. Journal the exit plus graceful, broker-denied, or unknown. Use graceful only for a qualified positive completion signal, broker-denied only for correlated watchdog evidence, and unknown otherwise. Both broker-denied and unknown require a release pair explicitly qualified for crash-consistent reopening. Report the observed classification in the update detail.\n  - User impact: The user can distinguish a verified shutdown from an exit whose drain could not be confirmed.\n- **Candidate bootstrap or readiness fails before a durable outcome** (recoverable)\n  - Detection: Registration, startup generation, owned run files, or candidate idle/readiness cannot be verified.\n  - Response: Reconcile the candidate under the reservation, restore the prior selector or absence and the canonical launcher, then restore and verify the exact previous job or direct launch only if it was running. Retain a fence when restoration is unverified.\n  - User impact: Verified rollback restores the previous service state and reports the failed update.\n- **Outcome publication throws or its acknowledgement is lost** (recoverable)\n  - Detection: Publication fails, or retry sees an active reservation without a verified terminal reply.\n  - Response: Keep the reservation. Re-read the exact matching durable outcome through existing recovery. A durable success verifies or completes activation without rollback. A durable rollback verifies the old state. Only a proven uncommitted transaction can unwind. Unknown ownership remains fenced.\n  - User impact: The updater reports an unconfirmed result until recovery determines the terminal state.\n- **Release qualification is missing, ambiguous, stale, revoked or invalid** (recoverable)\n  - Detection: Reject absent note, invalid signature or key, unsupported profile or verifier version, source or commit mismatch, conflicting profiles and any unaccounted runtime difference.\n  - Response: Report the failed verification before any incumbent shutdown, fence or selector mutation. Discard only owned preparation artifacts and preserve the incumbent.\n  - User impact: The daemon remains available with an update diagnostic and can retry after a qualified release is published.\n- **Installed runtime changes after independent verification** (recoverable)\n  - Detection: Recheck the original raw digest and exact file identities while holding update admission at the designated cutover and rollback boundaries.\n  - Response: Stop cutover before touching the incumbent when possible. After mutation use the existing exact rollback or fenced recovery. Refuse to execute any changed rollback copy.\n  - User impact: The update fails with a verification diagnostic.\n\n**Edge cases**\n\n| Input | Expected |\n| :--- | :--- |\n| Fresh --no-start | Register the supervisor, enable the selector and verify idle with no daemon child. Subsequent normal start uses the same supervisor. |\n| Already-managed update when the daemon is stopped | The external controller prepares and commits the update using supervisor status; no daemon RPC is required. Keep the candidate idle. |\n| Legacy daemon remains running while the candidate is staged | Build outside the live root, preserve the running predecessor and only then acquire a cutover reservation. Failed fetch, build, or qualification leaves the running install unchanged. |\n| An unchanged older shell or IDE freshness client invokes legacy restart or daemon.update | An old client cannot acquire new preflight behavior before executing its existing shutdown sequence. The first upgrade is delivered by the current standard installer or the ordinary update action in updated IDE clients. The installer may be rerun on an existing installation without launchctl or file edits. Never present an old acknowledgement as migration success. |\n| Two qualified installs share a commit but have different build paths or raw native artifact bytes | Each matches independent expected execution-bearing bytes under the same tested profile and retains its own raw exact pin. |\n\n**Invariants to preserve**\n\n- One state root has at most one daemon process admitted to use its stores. [[c2]]\n- Committed success is never rolled back because the publication reply was lost. [[c4]]\n- Linux keeps its current lifecycle and update behavior. [[c1]]\n\n## 6. Test strategy\n\n**Test framework:** `Node.js test runner via tsx, installed shell integration fixtures, and real macOS launchd smoke tests in disposable state roots.`\n\n**Test levels**\n\n- **unit** — Verify admission, qualification, journal compatibility and outcome recovery.\n  - Subjects: `Predecessor variants and backward decoding`, `Explicit fresh activation start intent and owned partial publication`, `Release provenance, changed bytes and absent legacy declaration`, `Graceful, broker-denied and unknown drain evidence`, `Uncertain publication with durable success versus no outcome`\n- **integration** — Drive supported entry points and competing legacy operations through the real controller boundaries.\n  - Subjects: `Installer and updated CLI, VS Code and JetBrains route matrix`, `Running managed update IPC and stopped local managed update`, `Old shell/helper concurrent with canonical launcher exchange and old child attempting to open stores`, `Startup guard transfer, candidate bootstrap failure, rollback and repeated recovery`, `Linux normal install, update and restart unchanged`\n- **smoke** — Verify actual launchd and daemon state on macOS.\n  - Subjects: `Fresh install and verified ordinary restart`, `Fresh --no-start and later supervisor start`, `First supported update of a qualified prior build with broker denial`, `Direct install and passive recovery job with exact loader argv`, `Verified stopped and running rollback with configuration and store integrity`\n  - Fixtures: `Disposable macOS state roots and isolated launchd labels`, `Pinned released predecessors, including the regression and clean-drain cases`\n- **contract** — Verify release signatures, independent expected inventory, applicability, exact runtime coverage, and report provenance.\n  - Subjects: `Independent same-commit macOS build equivalence and tamper rejection`, `Changed native code, loadable data, bindings, signature policy, injected modules, symlinks and unidentified variance fail closed`, `Missing or stale release evidence prevents promotion and leaves the incumbent running`\n- **smoke** — Require real product builds before promoting a source-built profile.\n  - Subjects: `Release publication validates real running and stopped upgrades for every enabled profile`, `Real product passive and recovery job loader arguments, verified broker refusal, data-preserving rollback and subsequent managed update`\n  - Fixtures: `Two independent production installer builds of the same supported predecessor in different homes with observed native variance`, `Real predecessor and candidate installs using disposable homes and distinct launchd jobs`, `Qualification from an isolated release authority, plus immutable test receipts bound to promoted release metadata`\n\n**Acceptance mapping**\n\n| Criterion | Proving tests |\n| :--- | :--- |\n| `ac1` | `Fresh install and verified ordinary restart`, `Fresh --no-start and later supervisor start` |\n| `ac2` | `Installer and updated CLI, VS Code and JetBrains route matrix`, `First supported update of a qualified prior build with broker denial`, `Direct install and passive recovery job with exact loader argv`, `Old shell/helper concurrent with canonical launcher exchange and old child attempting to open stores` |\n| `ac3` | `Running managed update IPC and stopped local managed update`, `Verified stopped and running rollback with configuration and store integrity`, `Uncertain publication with durable success versus no outcome`, `Linux normal install, update and restart unchanged` |\n| `ac4` | `Independent same-commit macOS build equivalence and tamper rejection`, `Release publication validates real running and stopped upgrades for every enabled profile` |\n\n## 7. Migration\n\n**State before:** The s1 discovery bundle identified whole-tree prior fingerprint qualification before managed migration. Two builds of the same legacy commit produced different native executable bytes. The configured origin was missing the qualification ref.\n\n**State after:** Current install and update entry points share a migration-capable controller and immutable releases. A supported first upgrade retains the previous release and establishes one verified per-user supervisor. User data remains in the existing state root.\n\n**Zero downtime:** no — **Data rewrite:** no\n\n**Steps**\n\n1. The release maintainer runs the real matrix on independent predecessor builds, signs profile and result digests, and publishes the note to the configured release origin. A promotion check fetches the published note as a normal updater, checks trust and exact branch head, and blocks release promotion unless all supported profiles pass. Unsupported profiles remain unadvertised. Test-only origins and signer keys cannot qualify a production release. — ↩ rollbackable\n2. Use the current standard installer for both fresh installs and first upgrades. Updated VS Code and JetBrains lifecycle Update on unmanaged Darwin dispatch the packaged migration-capable installer in existing-install mode with the configured branch and root. Updated freshness clients route unmanaged Darwin to that same action before sending any daemon.update RPC. A migration-capable shell or TUI starts the same external preflight on ordinary Update. For already-installed binaries that cannot obtain new code before shutdown, the supported first-upgrade action is the current standard installer, including the normal Install action in an updated IDE. No manual service administration is part of that path. — ↩ rollbackable\n3. Verify the signed release evidence and stage the candidate in a separate owned root. Verify the real incumbent against the supported profile, pin raw incumbent and candidate bytes, and check launchd admission. A failed verification leaves the existing daemon alone. Fresh install enters the activation reservation with explicit start intent. — ↩ rollbackable\n4. For legacy cutover, reserve and atomically replace the canonical installed checkout entry with a gate-aware dispatcher while preserving its original directory identity. Recover either side of the exchange by journaled inode evidence. Recheck for in-flight old helpers, update markers, unsupported launch routes, and mismatched job registrations. The dispatcher has no old executable or mutable checkout target. Refuse when the old launcher or writer cannot be excluded. Keep the prior checkout pinned until rollback is no longer needed. — ↩ rollbackable\n5. Authenticate the running predecessor over the pinned socket and observe exact exit. While the canonical launcher remains fenced, acquire the legacy-compatible run-file guard before cleanup, reconcile only the recorded publications, and retain the guard until a verified supervisor has adopted it for startup. Transfer owner evidence under the same directory identity with no unguarded interval. Remove a verified passive old job after its child exits. Apply the stored outcome policy for graceful, broker-denied, or unknown exit. — ↩ rollbackable\n6. Journal the provisional selector and register the supervisor. Start a child for a normal fresh install or previously running update. Verify idle for --no-start or previously stopped update. Publish the matching durable terminal record before release. An already-managed shell/TUI update uses the external transaction even when stopped, and the running managed RPC uses the detached helper and acknowledgement handshake. — ↩ rollbackable\n7. Recover from interrupted activation or cutover using the matching durable outcome. Restore an uncommitted predecessor by reversing owned mutations, restoring the canonical legacy entry and revalidating the predecessor's exact original launch route. Retain a fence on uncertainty. Do not roll back a verified durable success. — ↩ rollbackable\n\n**Backward compat:** Preserve the CLI flags, configured source, IDE IPC result shapes, supported user settings, Linux behavior and historical journal decoding. Existing binaries that stop before they can fetch the migration use the current normal installer for the first upgrade. The canonical installed launcher remains a compatible entry point after migration.\n\n## 8. Alternatives considered\n\n### 8.1 a1: Release-signed build verification profiles — **CHOSEN**\n\nUse independent release evidence for portable equivalence and an exact local pin for rollback.\n\nPublish a signed profile per tested predecessor and platform. Verify its complete runtime inventory against an independently built reference using exact hashes by default and bounded deterministic transformations only for verified build variance. Bind the original measured bytes to the cutover journal.\n\n### 8.2 a2: Exact release fingerprints only\n\nAccept an inventory of byte-identical prior builds.\n\nPublish one exact fingerprint for each independently archived prior package and continue requiring an exact installed match.\n\n**Rejected because:** An exact reference fingerprint rejects separately built valid native binaries.\n\n### 8.3 a3: Rebuild a rollback release from the old commit\n\nUse an independently verified replacement rollback build.\n\nFetch and rebuild the predecessor in a separate directory using pinned release inputs, then use that result as the rollback executable.\n\n**Rejected because:** A replacement rollback build leaves original executable provenance unverified and changes rollback identity.\n\n## 9. References\n\n- **[[c1]]** `code` `scripts/insrc-daemon-install.sh`\n- **[[c2]]** `code` `src/shared/managed-daemon-installation.ts`\n- **[[c3]]** `code` `src/daemon/managed-update-recovery.ts`\n- **[[c4]]** `code` `src/daemon/managed-update-transaction.ts`\n- **[[c5]]** `code` `src/bin/insrc-daemon-control.ts`\n- **[[c6]]** `code` `src/daemon/legacy-launch-job.ts`\n- **[[c7]]** `code` `src/daemon/legacy-daemon-cutover.ts`\n- **[[c8]]** `code` `src/daemon/update-runner.ts`\n- **[[c9]]** `code` `src/daemon/admin-handlers.ts`\n- **[[c10]]** `code` `src/daemon/release-compatibility.ts`\n- **[[c11]]** `code` `src/daemon/index.ts`\n- **[[c12]]** `code` `src/shared/daemon-run-files.ts`\n- **[[c13]]** `code` `scripts/daemon-ctl.sh`\n- **[[c14]]** `prior-artifact` `ISSUE-5d5478c61a25ac8f`\n- **[[c20]]** `code` `src/daemon/managed-release-staging.ts`\n- **[[c21]]** `code` `src/daemon/managed-update-preparation.ts`\n- **[[c22]]** `prior-artifact` `BUILD-5d5478c61a25ac8f-s1`\n"},"capturedAt":"2026-11-12T19:34:28.614Z"},"inventory":{"units":[{"id":"/body/hldContextSlice","selector":"/body/hldContextSlice","title":"hldContextSlice","kind":"section"},{"id":"/body/summary","selector":"/body/summary","title":"summary","kind":"section"},{"id":"/body/contractDetails","selector":"/body/contractDetails","title":"contractDetails","kind":"section"},{"id":"/body/dataModelChanges","selector":"/body/dataModelChanges","title":"dataModelChanges","kind":"section"},{"id":"/body/interactionWithShared","selector":"/body/interactionWithShared","title":"interactionWithShared","kind":"section"},{"id":"/body/errorPaths","selector":"/body/errorPaths","title":"errorPaths","kind":"section"},{"id":"/body/testStrategy","selector":"/body/testStrategy","title":"testStrategy","kind":"section"},{"id":"/body/migration","selector":"/body/migration","title":"migration","kind":"section"},{"id":"/body/alternativesConsidered","selector":"/body/alternativesConsidered","title":"alternativesConsidered","kind":"section"},{"id":"/body/chosenAlternative","selector":"/body/chosenAlternative","title":"chosenAlternative","kind":"section"},{"id":"/body/openQuestions","selector":"/body/openQuestions","title":"openQuestions","kind":"section"},{"id":"/body/sequenceDefinition","selector":"/body/sequenceDefinition","title":"sequenceDefinition","kind":"visual"},{"id":"/body/companions","selector":"/body/companions","title":"companions","kind":"visual"},{"id":"/body/alternativesConsidered/0","selector":"/body/alternativesConsidered/0","title":"a1","kind":"requirement"},{"id":"/body/alternativesConsidered/1","selector":"/body/alternativesConsidered/1","title":"a2","kind":"requirement"},{"id":"/body/alternativesConsidered/2","selector":"/body/alternativesConsidered/2","title":"a3","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/0","selector":"/body/sequenceDefinition/participants/0","title":"release","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/1","selector":"/body/sequenceDefinition/participants/1","title":"entry","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/2","selector":"/body/sequenceDefinition/participants/2","title":"control","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/3","selector":"/body/sequenceDefinition/participants/3","title":"old","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/4","selector":"/body/sequenceDefinition/participants/4","title":"new","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/5","selector":"/body/sequenceDefinition/participants/5","title":"child","kind":"requirement"},{"id":"/citations/0","selector":"/citations/0","title":"Citation 1","kind":"citation"},{"id":"/citations/1","selector":"/citations/1","title":"Citation 2","kind":"citation"},{"id":"/citations/2","selector":"/citations/2","title":"Citation 3","kind":"citation"},{"id":"/citations/3","selector":"/citations/3","title":"Citation 4","kind":"citation"},{"id":"/citations/4","selector":"/citations/4","title":"Citation 5","kind":"citation"},{"id":"/citations/5","selector":"/citations/5","title":"Citation 6","kind":"citation"},{"id":"/citations/6","selector":"/citations/6","title":"Citation 7","kind":"citation"},{"id":"/citations/7","selector":"/citations/7","title":"Citation 8","kind":"citation"},{"id":"/citations/8","selector":"/citations/8","title":"Citation 9","kind":"citation"},{"id":"/citations/9","selector":"/citations/9","title":"Citation 10","kind":"citation"},{"id":"/citations/10","selector":"/citations/10","title":"Citation 11","kind":"citation"},{"id":"/citations/11","selector":"/citations/11","title":"Citation 12","kind":"citation"},{"id":"/citations/12","selector":"/citations/12","title":"Citation 13","kind":"citation"},{"id":"/citations/13","selector":"/citations/13","title":"Citation 14","kind":"citation"},{"id":"/citations/14","selector":"/citations/14","title":"Citation 15","kind":"citation"},{"id":"/citations/15","selector":"/citations/15","title":"Citation 16","kind":"citation"},{"id":"/citations/16","selector":"/citations/16","title":"Citation 17","kind":"citation"},{"id":"document:line:25","selector":"document:line:25","title":"1. HLD context","kind":"section"},{"id":"document:line:109","selector":"document:line:109","title":"4. Diagrams","kind":"section"}]},"completedChunks":[{"chunkId":"scope","status":"passed","summary":"The assigned scope and design choices align with the originating ISSUE. Fresh installation, supported updates, legacy and recovery jobs, direct installs, broker denial, rollback preservation and Linux compatibility are traced into the design and test strategy. The cited BUILD supports the motivation for portable qualification without establishing completed production qualification. No blocking defect was demonstrated in this chunk.","findings":[],"inspectedReferences":["/body/hldContextSlice","/body/summary","/body/alternativesConsidered","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/alternativesConsidered/2","/body/chosenAlternative","/body/openQuestions","/citations/13","/citations/16","document:line:25","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md",".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md:5-15",".insrc/artifacts/ISSUE-5d5478c61a25ac8f.json",".insrc/artifacts/ISSUE-3992d2e1e26124dc.json",".insrc/artifacts/BUILD-5d5478c61a25ac8f-s1.json:body.summary","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/TESTS.md:174-232","src/daemon/managed-release-staging.ts:99-153","scripts/insrc-daemon-install.sh:164-225",".insrc/tmp/design-review/macos-portable-qualification-5d5478c6.json"],"limitations":[],"advice":["The rendered summary still displays Epic and HLD metadata despite the explicit standalone context. Labeling these as framework bookkeeping would make the ISSUE ancestry clearer."]},{"chunkId":"qualification","status":"changes_requested","summary":"All assigned sections and citations were inspected against the originating ISSUE and current implementation. The design establishes appropriate qualification and rollback invariants, but leaves the native equivalence mechanism and trust lifecycle insufficiently specified for implementation.","findings":[{"id":"qualification-native-verifier","severity":"MED","location":"/body/contractDetails/api/0/postconditions","message":"The central portable-build mechanism remains a requirement rather than a concrete design. The LLD requires independently reconstructed native bytes and permits only proven non-semantic differences, but supplies no supported initial toolchain profile, verifier operations, reconstruction algorithm, or inventory rules that can accept the observed independently built native variants. The cited implementation only compares whole-tree fingerprints; it has no native equivalence mechanism to inherit. Its build also inherits compiler/environment inputs, while .npmrc permits both prebuilt and source-built dependencies. Specify the initial supported build inputs, complete runtime inventory, allowed native transformations and independent reference-generation procedure, together with positive variance and negative modification cases. Otherwise implementations can satisfy fail-closed rejection while still rejecting the ordinary source-built installs this change is intended to migrate.","evidenceReferences":["docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:52-54","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:175-179","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:192","src/daemon/managed-release-staging.ts:fingerprint, stageManagedRelease","build-process-broker.mjs:16-19",".npmrc","src/daemon/__tests__/managed-release-staging.test.ts:fixture"]},{"id":"qualification-trust-lifecycle","severity":"MED","location":"/body/contractDetails/api/0/preconditions; /body/dataModelChanges/2; /body/errorPaths/errorCases/5","message":"The trust lifecycle does not define how an updater determines that signed evidence is stale or revoked, or how that decision interacts with offline recovery. Shipping a trust key and requiring scoped rotation/revocation does not specify a trusted key-set format, revocation source, freshness or replay rule, or whether an already admitted transaction retains its authorization after key rotation or revocation. The current note reader checks source and commit only, and the durable compatibility receipt contains release-format declarations rather than a trust snapshot. Define the authenticated trust-state distribution, freshness policy, and durable receipt fields and recovery rules, including expiry or revocation between preparation, cutover and offline rollback. Add tests for those boundaries. Without this contract, implementations can either accept replayed authorization or strand an interrupted update by requiring unavailable remote evidence.","evidenceReferences":["docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:49","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:101","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:137-140","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:200","src/daemon/managed-update-preparation.ts:originQualification","src/daemon/managed-update-handoff.ts:97-108","src/daemon/release-compatibility.ts:qualifiedPairFromReservation"]}],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/body/errorPaths","/body/testStrategy","/body/migration","/citations/9","/citations/14","/citations/15","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md",".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json",".insrc/tmp/design-review/macos-portable-qualification-5d5478c6.json","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md","src/daemon/managed-release-staging.ts","src/daemon/managed-update-preparation.ts","src/daemon/release-compatibility.ts","src/daemon/managed-update-handoff.ts:1-175","src/daemon/managed-update-recovery.ts:1-215","src/shared/installation-mutation-gate.ts:1-125","src/daemon/__tests__/managed-release-staging.test.ts:1-120","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/TESTS.md:155-232","build-process-broker.mjs",".npmrc","package.json","copy-assets.mjs"],"limitations":[],"advice":["The proposed real-production-build promotion matrix appropriately exceeds the existing synthetic staging fixtures. Preserve that distinction when reporting qualification results; existing fixture passes do not establish native portability."]},{"chunkId":"lifecycle","status":"changes_requested","summary":"The assigned lifecycle sections cover activation, predecessor identification, drain classification, guard transfer and durable recovery. Rollback ordering reopens legacy mutation before the transaction has verified restoration and published its terminal outcome.","findings":[{"id":"lifecycle-rollback-launcher-fence","severity":"MED","location":"/body/errorPaths/errorCases/3/response; /body/migration/steps/6","message":"Rollback restores the canonical legacy launcher before restoring and verifying the previous service and publishing the durable rollback outcome. This re-enables precisely the old commands that the design says cannot honor the new reservation. A concurrent old restart, updater or installer can therefore enter during rollback, disrupt the restored service or mutate the pinned checkout; an interruption after launcher restoration also leaves an active reservation without its launcher fence. The cited recovery implementation follows this ordering: it settles the guard, restores the launcher, then restores the service, with outcome publication afterward. Keep legacy mutation fenced through verified restoration and durable outcome publication, defining a restricted rollback launch route or equivalent mechanism that can start the predecessor without reopening ordinary old commands. Add concurrent-operation and interruption tests at this boundary.","evidenceReferences":["docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:118","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:131","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:206","src/daemon/managed-update-recovery.ts:Rollback.run, rollback-legacy-service","src/daemon/legacy-cutover-admission.ts:restoreLegacyLauncher","src/daemon/managed-update-transaction.ts:settleManagedUpdate","src/daemon/update-runner.ts:resolveDaemonCtl, isUpdateInProgress"]}],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/body/interactionWithShared","/body/errorPaths","/body/testStrategy","/body/migration","/citations/1","/citations/2","/citations/3","/citations/4","/citations/5","/citations/6","/citations/10","/citations/11","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md",".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json",".insrc/tmp/design-review/macos-portable-qualification-5d5478c6.json","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md","src/shared/managed-daemon-installation.ts","src/shared/installation-mutation-gate.ts","src/shared/daemon-run-files.ts","src/daemon/managed-update-recovery.ts","src/daemon/managed-update-transaction.ts","src/bin/insrc-daemon-control.ts","src/daemon/legacy-launch-job.ts","src/daemon/legacy-daemon-cutover.ts","src/daemon/legacy-cutover-admission.ts","src/daemon/legacy-run-guard.ts","src/daemon/legacy-drain-evidence.ts","src/daemon/fresh-managed-activation.ts","src/daemon/managed-update-handoff.ts","src/daemon/managed-daemon-probation.ts","src/daemon/index.ts:startup and shutdown lifecycle","src/daemon/shutdown.ts","src/daemon/update-runner.ts:legacy helper launch and update marker","src/daemon/__tests__/managed-update-handoff.test.ts","src/daemon/__tests__/fresh-managed-activation.test.ts:activation recovery scenarios","src/daemon/__tests__/managed-update-transaction.test.ts:test inventory","src/daemon/__tests__/legacy-cutover-admission.test.ts:test inventory","src/daemon/__tests__/legacy-run-guard.test.ts:test inventory"],"limitations":[],"advice":[]},{"chunkId":"entrypoints","status":"changes_requested","summary":"The assigned sections cover installer/client routing, explicit start intent, older-client limitations, Linux preservation and release promotion tests. The first-upgrade bootstrap path leaves a gap in the required verification-before-execution trust boundary.","findings":[{"id":"entrypoints-bootstrap-before-verification","severity":"MED","location":"/body/migration/migrationSteps/1; /body/migration/migrationSteps/2","message":"The design routes first upgrades through the current standard installer but does not replace its unverified bridge bootstrap. That installer clones the configured branch, runs its npm installation/build instructions, and executes its newly built controller before prepareLegacyUpgrade fetches qualification evidence. Consequently, an unsigned or unauthorized configured source can execute code before stageManagedRelease enforces the stated rule that a source override grants no signing authority. Building outside the incumbent root does not constrain that code's access to the incumbent or user data. Specify a trusted bootstrap controller/verifier distributed with the installer or clients, and authenticate the exact bridge source before executing its build instructions or controller. Add an entrypoint test proving invalid or missing authorization prevents bridge execution.","evidenceReferences":["docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:201","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:202","LLD /body/contractDetails/api/0/preconditions/0","scripts/insrc-daemon-install.sh:217","scripts/insrc-daemon-install.sh:218","scripts/insrc-daemon-install.sh:223","src/daemon/managed-update-preparation.ts:prepareLegacyUpgrade, stageRelease, originQualification","src/daemon/__tests__/macos-upgrade-routing.test.ts:requireBridge"]}],"inspectedReferences":["/body/summary","/body/interactionWithShared","/body/errorPaths","/body/testStrategy","/body/migration","/citations/0","/citations/7","/citations/8","/citations/12","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md",".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json",".insrc/tmp/design-review/macos-portable-qualification-5d5478c6.json","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/TESTS.md","scripts/insrc-daemon-install.sh","scripts/daemon-ctl.sh","src/daemon/admin-handlers.ts","src/daemon/update-runner.ts","src/daemon/managed-update-preparation.ts","src/daemon/index.ts:managed update dispatch","src/bin/insrc-daemon-control.ts:activation, migration, dispatch and update entrypoints","src/shared/update-source.ts","src/cli/services/maintenance.ts:update","src/cli/services/daemon.ts:lifecycle call sites","vscode-plugin/src/daemon/controller.ts","vscode-plugin/src/daemon/commands.ts","vscode-plugin/src/extension.ts:freshness wiring","vscode-plugin/src/freshness/daemon-freshness.ts:performUpdate and confirmUpdate","jetbrains-plugin/src/main/kotlin/ai/insors/insrc/jetbrains/lifecycle/DaemonLifecycleService.kt:DefaultDaemonScriptLocator","jetbrains-plugin/src/main/kotlin/ai/insors/insrc/jetbrains/lifecycle/ScriptDaemonProvisioner.kt","jetbrains-plugin/src/main/kotlin/ai/insors/insrc/jetbrains/lifecycle/DaemonLifecycleCommandRunner.kt","jetbrains-plugin/src/main/kotlin/ai/insors/insrc/jetbrains/freshness/InstalledCommitFreshnessConsumer.kt:production wiring","jetbrains-plugin/src/main/kotlin/ai/insors/insrc/jetbrains/freshness/DaemonFreshnessFlow.kt:performUpdate","src/daemon/__tests__/macos-upgrade-routing.test.ts","src/daemon/__tests__/managed-release-staging.test.ts:fixture and scenario inventory","src/daemon/__tests__/linux-installed-lifecycle.test.ts","src/daemon/__tests__/fixtures/linux-installed-lifecycle.sh"],"limitations":[],"advice":["Specify how installer/controller outcome details reach IDE users while preserving existing result shapes. Current lifecycle adapters reduce nonzero exits to generic errors, obscuring verified rollback versus fenced uncertainty.","Keep synthetic routing/staging fixture results distinct from the newly required production-build promotion evidence. Test execution was not needed for this read-only design assessment."]},{"chunkId":"visuals","status":"incomplete","summary":"Inspected the complete sequence, all six participant descriptions, companion HTML and document reference against the lifecycle requirements. The generated source preserves the authored content. Actual rendering could not be verified. Relationship ownership is adequately described in prose; no additional ERD or UX mock is necessary.","findings":[{"id":"visuals-relative-companion-link","severity":"LOW","location":"docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:111","message":"The sequence link repeats the repository-relative directory inside a document