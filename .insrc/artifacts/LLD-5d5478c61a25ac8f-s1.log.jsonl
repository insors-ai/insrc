uthor":"controller"},"preservationDigest":"c59c151cbbc4e70423103678b384c6460852e3874284976c68b469b40517960c","schemaVersion":1,"submitted":{"artifactPath":"/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md","attempt":1},"attempts":[{"number":1,"status":"incomplete","preparationKind":"planning","baseline":{"subjectFingerprints":{"canonical":"ea74f0a8a614b285d1f31639102a482f44b2a710ba3f8ab744e72c6cb4565543","document":"0da7a172c708654992cf04fb5556786527bb3e188ec3cc1c197aa9bd6242965e"},"contentIdentity":"84b35629e7b712583748489d95b40e3d49d267770e5380579dedf1b3f21faa94","reviewedContent":{"canonical":"{\n  \"meta\": {\n    \"workflow\": \"design.story\",\n    \"runId\": \"wf-1794413184997-au8a2s\",\n    \"repoPath\": \"/Users/subhagho/work/projects/insors/insrc\",\n    \"createdAt\": \"2026-11-11T16:09:35.631Z\",\n    \"epicCreatedAt\": \"2026-11-11T16:00:50.440Z\",\n    \"attribution\": {\n      \"outputs\": [\n        {\n          \"role\": \"(client)\",\n          \"tier\": \"core\",\n          \"runner\": \"cli-codex\",\n          \"model\": \"unknown\"\n        }\n      ]\n    },\n    \"elapsedMs\": 190090,\n    \"repoIndexedAt\": null,\n    \"schemaVersion\": 1,\n    \"epicHash\": \"5d5478c61a25ac8f\",\n    \"epicSlug\": \"enable-managed-daemon-lifecycle-macos-install\",\n    \"storyId\": \"s1\",\n    \"hldBaseRunId\": \"wf-1794413184997-au8a2s\",\n    \"hldEffectiveHash\": \"777a81c01593254ca65864d942cd51e05e47d8d36e2368c8285aaea562726c37\",\n    \"hldAmendmentsApplied\": [],\n    \"storyTitle\": \"Design the approved macOS installer and automatic existing-install migration fix from ISSUE-5d5478c61a25ac8f\",\n    \"standalone\": true,\n    \"sizeClass\": \"bugfix\",\n    \"authoredBy\": \"controller\",\n    \"lifecycle\": {\n      \"status\": \"draft\",\n      \"revision\": {\n        \"number\": 1,\n        \"contentHash\": \"b35c09ff49e63cc9b019e030957777ab15029de593bdc5505c1f5580dce3a4e7\",\n        \"at\": \"2026-11-11T16:09:35.938Z\",\n        \"by\": {\n          \"id\": \"insrc:system\",\n          \"kind\": \"system\",\n          \"properties\": {}\n        }\n      },\n      \"signoffs\": []\n    },\n    \"revision\": 1\n  },\n  \"body\": {\n    \"summary\": {\n      \"audience\": \"technical\",\n      \"prose\": \"The macOS installer initializes a managed launchd installation. A normal update stages a compatible release while the existing daemon is still running, then migrates ownership under a recoverable transaction. A previously stopped daemon stays stopped unless the user requested start.\"\n    },\n    \"hldContextSlice\": {\n      \"frameworkSummary\": \"Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\",\n      \"ownedContracts\": [],\n      \"consumedContracts\": [],\n      \"boundary\": {\n        \"storyId\": \"s1\",\n        \"owns\": [],\n        \"depends\": [],\n        \"internal\": \"Design the approved macOS installer and automatic existing-install migration fix from ISSUE-5d5478c61a25ac8f\"\n      },\n      \"adjacentBoundaries\": [],\n      \"rolloutPhase\": \"standalone\",\n      \"nonFunctional\": {}\n    },\n    \"contractDetails\": {\n      \"surfaceLevel\": \"internal-shared\",\n      \"api\": [\n        {\n          \"name\": \"stageManagedInstallation\",\n          \"signature\": \"stageManagedInstallation(installation: ManagedInstallation, revalidate: () => Promise<void>, legacyCutover?: boolean): Promise<void>\",\n          \"parameters\": [\n            {\n              \"name\": \"installation\",\n              \"type\": \"ManagedInstallation\",\n              \"purpose\": \"Pins the per-user root, immutable release, runtime and enabled state.\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"revalidate\",\n              \"type\": \"() => Promise<void>\",\n              \"purpose\": \"Rechecks ownership before mutation.\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"legacyCutover\",\n              \"type\": \"boolean\",\n              \"purpose\": \"Selects staging for a verified predecessor.\",\n              \"optional\": true\n            }\n          ],\n          \"returns\": {\n            \"type\": \"Promise<void>\",\n            \"meaning\": \"The staged descriptor and selector are owned by the installation.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"ownership-conflict\",\n              \"condition\": \"Conflicting install, job, run files, or mutation.\"\n            }\n          ],\n          \"preconditions\": [\n            \"Fresh install enters via the normal installer after building and verifying a pinned release in a separate root. Confirm a usable same-user GUI launch domain and quiescent state.\"\n          ],\n          \"postconditions\": [\n            \"Under one reservation publish owned enabled state, register and verify the per-user supervisor, and start a verified child only if requested. Honor --no-start. Recover or unwind interrupted activation before another start.\"\n          ]\n        },\n        {\n          \"name\": \"completeLegacyMigration\",\n          \"signature\": \"completeLegacyMigration(gate: InstallationMutationGate, update: UpdateReservation, pins: ManagedUpdatePins): Promise<DaemonUpdateOutcome>\",\n          \"parameters\": [\n            {\n              \"name\": \"gate\",\n              \"type\": \"InstallationMutationGate\",\n              \"purpose\": \"Serializes launchd, selector and child lifecycle mutations.\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"update\",\n              \"type\": \"UpdateReservation\",\n              \"purpose\": \"Carries the verified predecessor and desired running state.\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"pins\",\n              \"type\": \"ManagedUpdatePins\",\n              \"purpose\": \"Carries compatible prior and candidate release identities.\",\n              \"optional\": false\n            }\n          ],\n          \"returns\": {\n            \"type\": \"Promise<DaemonUpdateOutcome>\",\n            \"meaning\": \"Committed cutover, verified rollback, or recoverable ownership conflict.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"ownership-conflict\",\n              \"condition\": \"A trusted predecessor, exact exit, or rollback cannot be verified.\"\n            }\n          ],\n          \"preconditions\": [\n            \"The migration-capable installer or updater runs before any legacy stop or shutdown RPC. Stage and qualify the candidate separately and verify the predecessor from daemon status, exact owned run files and peer incarnation, or an exact passive same-user LaunchAgent. Keep rollback executable and metadata available.\"\n          ],\n          \"postconditions\": [\n            \"Request cooperative exit over the authenticated legacy socket with an independent Darwin exit observer. A watchdog refusal counts as an exit only if that exact incarnation exited. Reconcile only pinned files. Remove a verified passive job only after exit; publish the candidate only after readiness. Restore the prior running or stopped state on verified rollback.\"\n          ]\n        }\n      ]\n    },\n    \"dataModelChanges\": [\n      {\n        \"entity\": \"ManagedInstallation and UpdatePredecessor\",\n        \"change\": \"invariant-change\",\n        \"details\": \"One state root owns one enabled selector and at most one supervisor job. The job owns at most one daemon child. During migration the reservation owns one candidate pin and one predecessor pin, with a launch-job descriptor only for a LaunchAgent predecessor. A direct predecessor records verified runtime, entry, owned run-file identities, and a rollback launch description; stopped installations record absence. Prior and candidate binaries stay separately recoverable. Persist a discriminated predecessor record with backward-compatible decoding of existing managed and legacy-job journals.\",\n        \"callSites\": [\n          \"src/shared/managed-daemon-installation.ts\",\n          \"src/bin/insrc-daemon-control.ts\",\n          \"src/daemon/managed-update-recovery.ts\"\n        ]\n      }\n    ],\n    \"interactionWithShared\": [],\n    \"errorPaths\": {\n      \"errorCases\": [\n        {\n          \"scenario\": \"Predecessor identity is ambiguous or changes\",\n          \"detection\": \"Compare canonical root, runtime and entry, socket peer incarnation, pinned run-file identities, and exact launchd registration when present. Revalidate under the reservation before mutation.\",\n          \"response\": \"Refuse cutover and leave the existing service and files intact. Surface the reason through the ordinary update result.\",\n          \"userImpact\": \"Existing service remains available when it has not been stopped.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Legacy daemon fails to exit\",\n          \"detection\": \"The exit observer times out or sees a replacement rather than verified exit of the pinned incarnation.\",\n          \"response\": \"Do not start a candidate. Preserve live or foreign publications. Reconcile only if ownership and exit can later be established.\",\n          \"userImpact\": \"Update reports an actionable failure.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Candidate registration, readiness, or publication fails\",\n          \"detection\": \"Exact job or supervisor identity does not match, child never reaches authenticated readiness, or outcome persistence fails.\",\n          \"response\": \"Use journaled recovery to stop only the candidate generation, remove its exact job, restore the old selector and release, and restore prior running state. Keep the reservation fenced if rollback cannot be verified.\",\n          \"userImpact\": \"A verified rollback reports failure and restores prior service.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Legacy updater starts shutdown before staging the migration release\",\n          \"detection\": \"The caller or installed release lacks the migration-capable preflight route.\",\n          \"response\": \"Ship the migration preflight in the normal installer and updated clients. Test the exact older shipped entry points and provide the supported upgrade entry point when an old caller cannot carry migration. Never report migration success from the legacy acknowledgement.\",\n          \"userImpact\": \"The user can use the ordinary supported install or update operation without launchd administration.\",\n          \"recoverable\": true\n        }\n      ],\n      \"edgeCases\": [\n        {\n          \"input\": \"Fresh installation with --no-start\",\n          \"expected\": \"Install the managed lifecycle with no daemon child. The first ordinary start uses the supervisor.\"\n        },\n        {\n          \"input\": \"Existing installation was stopped or is already managed\",\n          \"expected\": \"Preserve stopped state unless start was requested. Already managed updates use the normal managed transaction.\"\n        },\n        {\n          \"input\": \"Legacy shutdown exits early after broker denial\",\n          \"expected\": \"Require independent exact exit and reconcile only pinned run files before admitting a successor. Record the early exit distinctly from a successful drain.\"\n        },\n        {\n          \"input\": \"Concurrent installer, update, restart or retry\",\n          \"expected\": \"Single reservation owns cutover. A duplicate or interrupted operation reconciles its existing transaction before a new one starts.\"\n        }\n      ],\n      \"invariantsToPreserve\": [\n        {\n          \"text\": \"Only one verified daemon owns the state root, PID file and socket.\",\n          \"source\": \"c2\"\n        },\n        {\n          \"text\": \"Rollback preserves user settings, repositories, release and prior running state.\",\n          \"source\": \"c3\"\n        },\n        {\n          \"text\": \"Linux retains its existing lifecycle.\",\n          \"source\": \"c1\"\n        }\n      ]\n    },\n    \"testStrategy\": {\n      \"testLevels\": [\n        {\n          \"level\": \"unit\",\n          \"purpose\": \"Check predecessor admission, persisted pins and recovery decisions.\",\n          \"subjects\": [\n            \"Fresh, managed, stopped legacy, direct legacy and passive LaunchAgent classifications\",\n            \"Refusal for foreign job, mismatched socket, changed descriptor and concurrent owners\",\n            \"Compatibility and backward decoding of existing journals\"\n          ]\n        },\n        {\n          \"level\": \"integration\",\n          \"purpose\": \"Exercise user entry points and verified cutover with isolated roots.\",\n          \"subjects\": [\n            \"Installer startup and --no-start\",\n            \"Release staging before legacy shutdown\",\n            \"Update from shipped broker-dependent predecessor through the normal supported entry point\",\n            \"Interrupted bootstrap, candidate failure, exact exit, rollback and retry\",\n            \"Linux installer and lifecycle regression\"\n          ]\n        },\n        {\n          \"level\": \"smoke\",\n          \"purpose\": \"Verify actual launchd registrations and processes in the macOS GUI domain.\",\n          \"subjects\": [\n            \"Fresh installer followed by ordinary restart and verified PID change\",\n            \"Existing direct and LaunchAgent installs with the broker returning errno 1\",\n            \"Recovery LaunchAgent descriptor and runtime flags\",\n            \"Restored running or stopped state and unchanged settings and data after failure\"\n          ],\n          \"fixturesNeeded\": [\n            \"Disposable macOS home with unique labels and isolated state\",\n            \"Pinned legacy and candidate builds\"\n          ]\n        }\n      ],\n      \"acceptanceMapping\": [\n        {\n          \"criterionId\": \"ac1\",\n          \"provingTests\": [\n            \"Fresh installer followed by ordinary restart and verified PID change\",\n            \"Installer startup and --no-start\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac2\",\n          \"provingTests\": [\n            \"Update from shipped broker-dependent predecessor through the normal supported entry point\",\n            \"Existing direct and LaunchAgent installs with the broker returning errno 1\",\n            \"Recovery LaunchAgent descriptor and runtime flags\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac3\",\n          \"provingTests\": [\n            \"Interrupted bootstrap, candidate failure, exact exit, rollback and retry\",\n            \"Restored running or stopped state and unchanged settings and data after failure\",\n            \"Linux installer and lifecycle regression\"\n          ]\n        }\n      ],\n      \"testFramework\": \"Node.js test runner through tsx, shell installer integration fixtures, and real macOS launchd smoke tests in a disposable user state root.\"\n    },\n    \"migration\": {\n      \"stateBefore\": \"The standard installer starts directly via daemon-ctl. The selector-gated supervisor and explicit LaunchAgent migration controller exist. See the installer and migration discovery bundle in s1.\",\n      \"stateAfter\": \"Ordinary install and supported update commands establish a verified managed installation and use the per-user supervisor for future lifecycle calls.\",\n      \"migrationSteps\": [\n        {\n          \"order\": 1,\n          \"action\": \"Stage a compatible candidate and capture the canonical predecessor release and ownership before changing any live job or installation selector.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 2,\n          \"action\": \"Acquire the installation reservation and verify the supported predecessor shape. Record running state and exact job, runtime, and publication identities.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 3,\n          \"action\": \"For a running predecessor, request cooperative shutdown and verify exact exit. If an owned passive LaunchAgent exists, remove only its pinned registration after exit. Reconcile only owned files.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 4,\n          \"action\": \"Register the candidate supervisor and start one candidate only when the operation requests it or the predecessor was running. Verify service readiness, then publish the terminal outcome and release the reservation.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 5,\n          \"action\": \"On failure, resume the journal to restore the prior release, launch job and running or stopped state. Report any unresolved ownership with the installation fenced.\",\n          \"rollbackable\": true\n        }\n      ],\n      \"backwardCompat\": \"Keep existing installer switches, lifecycle command and IPC payload shapes. Keep Linux behavior. For the first upgrade, use a migration-capable normal installer or updated client before invoking older restart or shutdown behavior. A legacy binary that cannot stage the migration cannot promise automatic cutover. Decode existing managed and legacy-job journals.\",\n      \"zeroDowntime\": false,\n      \"dataRewriteRequired\": false\n    },\n    \"alternativesConsidered\": [\n      {\n        \"id\": \"a1\",\n        \"name\": \"Integrate with existing lifecycle transactions\",\n        \"oneLineSummary\": \"Install or migrate through the existing entry points and shared state.\",\n        \"approach\": \"Fresh installation establishes the managed selector through an owned transaction. Existing updates resolve and pin the predecessor before using the shared update reservation and rollback.\",\n        \"pros\": [\n          \"Single controller for launchd state and ownership.\",\n          \"Users keep their existing install and update commands.\"\n        ],\n        \"cons\": [\n          \"Requires a safe predecessor-specific exit path and compatibility checks.\"\n        ],\n        \"costEstimate\": \"M\"\n      },\n      {\n        \"id\": \"a2\",\n        \"name\": \"Migrate at the next start\",\n        \"oneLineSummary\": \"Defer cutover until an ordinary start observes a stopped installation.\",\n        \"approach\": \"An update stages the release and start performs cutover after verifying that the legacy daemon has exited and no legacy job can relaunch it.\",\n        \"pros\": [\n          \"Simpler cutover for stopped systems.\"\n        ],\n        \"cons\": [\n          \"A healthy live installation whose broker cannot stop it may never reach the required state through normal commands.\"\n        ],\n        \"costEstimate\": \"M\",\n        \"reasonRejected\": \"Works for quiescent installs but fails the live automatic migration goal.\"\n      }\n    ],\n    \"chosenAlternative\": \"a1\",\n    \"openQuestions\": [],\n    \"sequenceDefinition\": {\n      \"id\": \"macos-install-cutover\",\n      \"narrative\": \"The sequence shows when the candidate is staged, when a verified predecessor may exit, and where readiness or rollback settles the operation.\",\n      \"participants\": [\n        {\n          \"id\": \"user\",\n          \"label\": \"Installer or updater\",\n          \"description\": \"User-facing install and update entry point.\"\n        },\n        {\n          \"id\": \"controller\",\n          \"label\": \"Lifecycle controller\",\n          \"description\": \"Pins releases and owns the mutation reservation.\"\n        },\n        {\n          \"id\": \"legacy\",\n          \"label\": \"Legacy daemon and launchd job\",\n          \"description\": \"Existing release and exact job when present.\"\n        },\n        {\n          \"id\": \"supervisor\",\n          \"label\": \"Managed supervisor\",\n          \"description\": \"Registers and owns the candidate child.\"\n        },\n        {\n          \"id\": \"daemon\",\n          \"label\": \"Candidate daemon\",\n          \"description\": \"Publishes authenticated readiness and serves the state root.\"\n        }\n      ],\n      \"messages\": [\n        {\n          \"from\": \"user\",\n          \"to\": \"controller\",\n          \"label\": \"Stage and qualify candidate\",\n          \"description\": \"Keep the prior release available for rollback.\"\n        },\n        {\n          \"from\": \"controller\",\n          \"to\": \"controller\",\n          \"label\": \"Reserve and pin installation\",\n          \"description\": \"Verify state root and record predecessor ownership and prior running state.\"\n        },\n        {\n          \"from\": \"controller\",\n          \"to\": \"legacy\",\n          \"label\": \"Drain existing daemon if running\",\n          \"description\": \"Authenticate the legacy socket and observe the pinned incarnation exit independently of the broker.\"\n        },\n        {\n          \"from\": \"legacy\",\n          \"to\": \"controller\",\n          \"label\": \"Verify exit and registration\",\n          \"description\": \"Reconcile owned publications and remove the pinned passive LaunchAgent after verified exit.\"\n        },\n        {\n          \"from\": \"controller\",\n          \"to\": \"supervisor\",\n          \"label\": \"Register and verify managed job\",\n          \"description\": \"Bind the job to the candidate and the installation state root.\"\n        },\n        {\n          \"from\": \"supervisor\",\n          \"to\": \"daemon\",\n          \"label\": \"Start if requested or previously running\",\n          \"description\": \"An idle install remains stopped.\"\n        },\n        {\n          \"from\": \"daemon\",\n          \"to\": \"supervisor\",\n          \"label\": \"Report authenticated readiness\",\n          \"description\": \"Confirm the child identity and its run files.\"\n        },\n        {\n          \"from\": \"supervisor\",\n          \"to\": \"controller\",\n          \"label\": \"Report verified state\",\n          \"description\": \"Commit the verified outcome, or unwind the candidate and restore the prior state on failure.\"\n        },\n        {\n          \"from\": \"controller\",\n          \"to\": \"user\",\n          \"label\": \"Return durable install or update result\",\n          \"description\": \"Report success only after verified readiness or verified stopped state.\"\n        }\n      ]\n    },\n    \"companions\": [\n      {\n        \"kind\": \"diagram-mermaid\",\n        \"relPath\": \"docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html\",\n        \"title\": \"Sequence diagram\"\n      }\n    ]\n  },\n  \"citations\": [\n    {\n      \"id\": \"c1\",\n      \"kind\": \"code\",\n      \"ref\": \"scripts/insrc-daemon-install.sh\"\n    },\n    {\n      \"id\": \"c2\",\n      \"kind\": \"code\",\n      \"ref\": \"src/shared/managed-daemon-installation.ts\"\n    },\n    {\n      \"id\": \"c3\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/managed-update-recovery.ts\"\n    },\n    {\n      \"id\": \"c4\",\n      \"kind\": \"code\",\n      \"ref\": \"src/bin/insrc-daemon-control.ts\"\n    },\n    {\n      \"id\": \"c5\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/legacy-launch-job.ts\"\n    },\n    {\n      \"id\": \"c6\",\n      \"kind\": \"code\",\n      \"ref\": \"scripts/daemon-ctl.sh\"\n    },\n    {\n      \"id\": \"c7\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/update-runner.ts\"\n    },\n    {\n      \"id\": \"c8\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/legacy-daemon-cutover.ts\"\n    },\n    {\n      \"id\": \"c9\",\n      \"kind\": \"prior-artifact\",\n      \"ref\": \"ISSUE-5d5478c61a25ac8f\"\n    }\n  ]\n}\n","document":"<!-- insrc:artifact LLD-5d5478c61a25ac8f-s1 -->\n\n# LLD: STORY-5d5478c61a25ac8f-s1 — Design the approved macOS installer and automatic existing-install migration fix from ISSUE-5d5478c61a25ac8f\n\n## Summary\n\n**Epic:** `enable-managed-daemon-lifecycle-macos-install`\n**HLD base run:** `wf-1794413184997-au8a2s`\n**HLD effective hash:** `777a81c01593...`\n\nThe macOS installer initializes a managed launchd installation. A normal update stages a compatible release while the existing daemon is still running, then migrates ownership under a recoverable transaction. A previously stopped daemon stays stopped unless the user requested start.\n\n## Contents\n\n1. [HLD context](#1-hld-context)\n2. [Contract details](#2-contract-details)\n3. [Data model changes](#3-data-model-changes)\n4. [Diagrams](#4-diagrams)\n5. [Error paths](#5-error-paths)\n6. [Test strategy](#6-test-strategy)\n7. [Migration](#7-migration)\n8. [Alternatives considered](#8-alternatives-considered)\n9. [References](#9-references)\n\n## 1. HLD context\n\n**Framework:** Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\n**Rollout phase:** standalone\n\n## 2. Contract details\n\n**Surface level:** internal-shared\n\n### 2.1 `stageManagedInstallation`\n\n```typescript\nstageManagedInstallation(installation: ManagedInstallation, revalidate: () => Promise<void>, legacyCutover?: boolean): Promise<void>\n```\n\n**Parameters:**\n- `installation: ManagedInstallation` — Pins the per-user root, immutable release, runtime and enabled state.\n- `revalidate: () => Promise<void>` — Rechecks ownership before mutation.\n- `legacyCutover: boolean` _(optional)_ — Selects staging for a verified predecessor.\n\n**Returns:** `Promise<void>` — The staged descriptor and selector are owned by the installation.\n\n**Errors:**\n- `ownership-conflict` when Conflicting install, job, run files, or mutation.\n\n**Preconditions:**\n- Fresh install enters via the normal installer after building and verifying a pinned release in a separate root. Confirm a usable same-user GUI launch domain and quiescent state.\n\n**Postconditions:**\n- Under one reservation publish owned enabled state, register and verify the per-user supervisor, and start a verified child only if requested. Honor --no-start. Recover or unwind interrupted activation before another start.\n\n### 2.2 `completeLegacyMigration`\n\n```typescript\ncompleteLegacyMigration(gate: InstallationMutationGate, update: UpdateReservation, pins: ManagedUpdatePins): Promise<DaemonUpdateOutcome>\n```\n\n**Parameters:**\n- `gate: InstallationMutationGate` — Serializes launchd, selector and child lifecycle mutations.\n- `update: UpdateReservation` — Carries the verified predecessor and desired running state.\n- `pins: ManagedUpdatePins` — Carries compatible prior and candidate release identities.\n\n**Returns:** `Promise<DaemonUpdateOutcome>` — Committed cutover, verified rollback, or recoverable ownership conflict.\n\n**Errors:**\n- `ownership-conflict` when A trusted predecessor, exact exit, or rollback cannot be verified.\n\n**Preconditions:**\n- The migration-capable installer or updater runs before any legacy stop or shutdown RPC. Stage and qualify the candidate separately and verify the predecessor from daemon status, exact owned run files and peer incarnation, or an exact passive same-user LaunchAgent. Keep rollback executable and metadata available.\n\n**Postconditions:**\n- Request cooperative exit over the authenticated legacy socket with an independent Darwin exit observer. A watchdog refusal counts as an exit only if that exact incarnation exited. Reconcile only pinned files. Remove a verified passive job only after exit; publish the candidate only after readiness. Restore the prior running or stopped state on verified rollback.\n\n## 3. Data model changes\n\n### 3.1 `ManagedInstallation and UpdatePredecessor` — invariant-change\n\nOne state root owns one enabled selector and at most one supervisor job. The job owns at most one daemon child. During migration the reservation owns one candidate pin and one predecessor pin, with a launch-job descriptor only for a LaunchAgent predecessor. A direct predecessor records verified runtime, entry, owned run-file identities, and a rollback launch description; stopped installations record absence. Prior and candidate binaries stay separately recoverable. Persist a discriminated predecessor record with backward-compatible decoding of existing managed and legacy-job journals.\n\n**Call sites:**\n- `src/shared/managed-daemon-installation.ts`\n- `src/bin/insrc-daemon-control.ts`\n- `src/daemon/managed-update-recovery.ts`\n\n## 4. Diagrams\n\n- [Sequence diagram](docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html)\n\n## 5. Error paths\n\n**Error cases**\n\n- **Predecessor identity is ambiguous or changes** (recoverable)\n  - Detection: Compare canonical root, runtime and entry, socket peer incarnation, pinned run-file identities, and exact launchd registration when present. Revalidate under the reservation before mutation.\n  - Response: Refuse cutover and leave the existing service and files intact. Surface the reason through the ordinary update result.\n  - User impact: Existing service remains available when it has not been stopped.\n- **Legacy daemon fails to exit** (recoverable)\n  - Detection: The exit observer times out or sees a replacement rather than verified exit of the pinned incarnation.\n  - Response: Do not start a candidate. Preserve live or foreign publications. Reconcile only if ownership and exit can later be established.\n  - User impact: Update reports an actionable failure.\n- **Candidate registration, readiness, or publication fails** (recoverable)\n  - Detection: Exact job or supervisor identity does not match, child never reaches authenticated readiness, or outcome persistence fails.\n  - Response: Use journaled recovery to stop only the candidate generation, remove its exact job, restore the old selector and release, and restore prior running state. Keep the reservation fenced if rollback cannot be verified.\n  - User impact: A verified rollback reports failure and restores prior service.\n- **Legacy updater starts shutdown before staging the migration release** (recoverable)\n  - Detection: The caller or installed release lacks the migration-capable preflight route.\n  - Response: Ship the migration preflight in the normal installer and updated clients. Test the exact older shipped entry points and provide the supported upgrade entry point when an old caller cannot carry migration. Never report migration success from the legacy acknowledgement.\n  - User impact: The user can use the ordinary supported install or update operation without launchd administration.\n\n**Edge cases**\n\n| Input | Expected |\n| :--- | :--- |\n| Fresh installation with --no-start | Install the managed lifecycle with no daemon child. The first ordinary start uses the supervisor. |\n| Existing installation was stopped or is already managed | Preserve stopped state unless start was requested. Already managed updates use the normal managed transaction. |\n| Legacy shutdown exits early after broker denial | Require independent exact exit and reconcile only pinned run files before admitting a successor. Record the early exit distinctly from a successful drain. |\n| Concurrent installer, update, restart or retry | Single reservation owns cutover. A duplicate or interrupted operation reconciles its existing transaction before a new one starts. |\n\n**Invariants to preserve**\n\n- Only one verified daemon owns the state root, PID file and socket. [[c2]]\n- Rollback preserves user settings, repositories, release and prior running state. [[c3]]\n- Linux retains its existing lifecycle. [[c1]]\n\n## 6. Test strategy\n\n**Test framework:** `Node.js test runner through tsx, shell installer integration fixtures, and real macOS launchd smoke tests in a disposable user state root.`\n\n**Test levels**\n\n- **unit** — Check predecessor admission, persisted pins and recovery decisions.\n  - Subjects: `Fresh, managed, stopped legacy, direct legacy and passive LaunchAgent classifications`, `Refusal for foreign job, mismatched socket, changed descriptor and concurrent owners`, `Compatibility and backward decoding of existing journals`\n- **integration** — Exercise user entry points and verified cutover with isolated roots.\n  - Subjects: `Installer startup and --no-start`, `Release staging before legacy shutdown`, `Update from shipped broker-dependent predecessor through the normal supported entry point`, `Interrupted bootstrap, candidate failure, exact exit, rollback and retry`, `Linux installer and lifecycle regression`\n- **smoke** — Verify actual launchd registrations and processes in the macOS GUI domain.\n  - Subjects: `Fresh installer followed by ordinary restart and verified PID change`, `Existing direct and LaunchAgent installs with the broker returning errno 1`, `Recovery LaunchAgent descriptor and runtime flags`, `Restored running or stopped state and unchanged settings and data after failure`\n  - Fixtures: `Disposable macOS home with unique labels and isolated state`, `Pinned legacy and candidate builds`\n\n**Acceptance mapping**\n\n| Criterion | Proving tests |\n| :--- | :--- |\n| `ac1` | `Fresh installer followed by ordinary restart and verified PID change`, `Installer startup and --no-start` |\n| `ac2` | `Update from shipped broker-dependent predecessor through the normal supported entry point`, `Existing direct and LaunchAgent installs with the broker returning errno 1`, `Recovery LaunchAgent descriptor and runtime flags` |\n| `ac3` | `Interrupted bootstrap, candidate failure, exact exit, rollback and retry`, `Restored running or stopped state and unchanged settings and data after failure`, `Linux installer and lifecycle regression` |\n\n## 7. Migration\n\n**State before:** The standard installer starts directly via daemon-ctl. The selector-gated supervisor and explicit LaunchAgent migration controller exist. See the installer and migration discovery bundle in s1.\n\n**State after:** Ordinary install and supported update commands establish a verified managed installation and use the per-user supervisor for future lifecycle calls.\n\n**Zero downtime:** no — **Data rewrite:** no\n\n**Steps**\n\n1. Stage a compatible candidate and capture the canonical predecessor release and ownership before changing any live job or installation selector. — ↩ rollbackable\n2. Acquire the installation reservation and verify the supported predecessor shape. Record running state and exact job, runtime, and publication identities. — ↩ rollbackable\n3. For a running predecessor, request cooperative shutdown and verify exact exit. If an owned passive LaunchAgent exists, remove only its pinned registration after exit. Reconcile only owned files. — ↩ rollbackable\n4. Register the candidate supervisor and start one candidate only when the operation requests it or the predecessor was running. Verify service readiness, then publish the terminal outcome and release the reservation. — ↩ rollbackable\n5. On failure, resume the journal to restore the prior release, launch job and running or stopped state. Report any unresolved ownership with the installation fenced. — ↩ rollbackable\n\n**Backward compat:** Keep existing installer switches, lifecycle command and IPC payload shapes. Keep Linux behavior. For the first upgrade, use a migration-capable normal installer or updated client before invoking older restart or shutdown behavior. A legacy binary that cannot stage the migration cannot promise automatic cutover. Decode existing managed and legacy-job journals.\n\n## 8. Alternatives considered\n\n### 8.1 a1: Integrate with existing lifecycle transactions — **CHOSEN**\n\nInstall or migrate through the existing entry points and shared state.\n\nFresh installation establishes the managed selector through an owned transaction. Existing updates resolve and pin the predecessor before using the shared update reservation and rollback.\n\n### 8.2 a2: Migrate at the next start\n\nDefer cutover until an ordinary start observes a stopped installation.\n\nAn update stages the release and start performs cutover after verifying that the legacy daemon has exited and no legacy job can relaunch it.\n\n**Rejected because:** Works for quiescent installs but fails the live automatic migration goal.\n\n## 9. References\n\n- **[[c1]]** `code` `scripts/insrc-daemon-install.sh`\n- **[[c2]]** `code` `src/shared/managed-daemon-installation.ts`\n- **[[c3]]** `code` `src/daemon/managed-update-recovery.ts`\n- **[[c4]]** `code` `src/bin/insrc-daemon-control.ts`\n- **[[c5]]** `code` `src/daemon/legacy-launch-job.ts`\n- **[[c6]]** `code` `scripts/daemon-ctl.sh`\n- **[[c7]]** `code` `src/daemon/update-runner.ts`\n- **[[c8]]** `code` `src/daemon/legacy-daemon-cutover.ts`\n- **[[c9]]** `prior-artifact` `ISSUE-5d5478c61a25ac8f`\n"},"capturedAt":"2026-11-11T16:09:47.895Z"},"inventory":{"units":[{"id":"/body/summary","selector":"/body/summary","title":"summary","kind":"section"},{"id":"/body/hldContextSlice","selector":"/body/hldContextSlice","title":"hldContextSlice","kind":"section"},{"id":"/body/contractDetails","selector":"/body/contractDetails","title":"contractDetails","kind":"section"},{"id":"/body/dataModelChanges","selector":"/body/dataModelChanges","title":"dataModelChanges","kind":"section"},{"id":"/body/interactionWithShared","selector":"/body/interactionWithShared","title":"interactionWithShared","kind":"section"},{"id":"/body/errorPaths","selector":"/body/errorPaths","title":"errorPaths","kind":"section"},{"id":"/body/testStrategy","selector":"/body/testStrategy","title":"testStrategy","kind":"section"},{"id":"/body/migration","selector":"/body/migration","title":"migration","kind":"section"},{"id":"/body/alternativesConsidered","selector":"/body/alternativesConsidered","title":"alternativesConsidered","kind":"section"},{"id":"/body/chosenAlternative","selector":"/body/chosenAlternative","title":"chosenAlternative","kind":"section"},{"id":"/body/openQuestions","selector":"/body/openQuestions","title":"openQuestions","kind":"section"},{"id":"/body/sequenceDefinition","selector":"/body/sequenceDefinition","title":"sequenceDefinition","kind":"visual"},{"id":"/body/companions","selector":"/body/companions","title":"companions","kind":"visual"},{"id":"/body/alternativesConsidered/0","selector":"/body/alternativesConsidered/0","title":"a1","kind":"requirement"},{"id":"/body/alternativesConsidered/1","selector":"/body/alternativesConsidered/1","title":"a2","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/0","selector":"/body/sequenceDefinition/participants/0","title":"user","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/1","selector":"/body/sequenceDefinition/participants/1","title":"controller","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/2","selector":"/body/sequenceDefinition/participants/2","title":"legacy","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/3","selector":"/body/sequenceDefinition/participants/3","title":"supervisor","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/4","selector":"/body/sequenceDefinition/participants/4","title":"daemon","kind":"requirement"},{"id":"/citations/0","selector":"/citations/0","title":"Citation 1","kind":"citation"},{"id":"/citations/1","selector":"/citations/1","title":"Citation 2","kind":"citation"},{"id":"/citations/2","selector":"/citations/2","title":"Citation 3","kind":"citation"},{"id":"/citations/3","selector":"/citations/3","title":"Citation 4","kind":"citation"},{"id":"/citations/4","selector":"/citations/4","title":"Citation 5","kind":"citation"},{"id":"/citations/5","selector":"/citations/5","title":"Citation 6","kind":"citation"},{"id":"/citations/6","selector":"/citations/6","title":"Citation 7","kind":"citation"},{"id":"/citations/7","selector":"/citations/7","title":"Citation 8","kind":"citation"},{"id":"/citations/8","selector":"/citations/8","title":"Citation 9","kind":"citation"},{"id":"document:line:25","selector":"document:line:25","title":"1. HLD context","kind":"section"},{"id":"document:line:89","selector":"document:line:89","title":"4. Diagrams","kind":"section"}]},"completedChunks":[{"chunkId":"install","status":"changes_requested","summary":"The design follows the originating ISSUE's intent, but does not define executable entry-point routing, release provisioning, or fresh activation contracts sufficiently to resolve the demonstrated installer and updater gaps.","findings":[{"id":"install-01","severity":"HIGH","location":"LLD.md:109-112,167; /body/errorPaths","message":"The first-upgrade route remains unspecified. Requiring a migration-capable installer or updated client before shutdown does not identify how ordinary supported update commands obtain and invoke that code. The installed shell restart stops before fetching, and daemon.update schedules shutdown immediately after launching its installed helper. Current IDE lifecycle commands invoke the installed shell, while freshness flows use daemon.update. Define the supported command/client matrix, how each obtains the migration controller before shutdown, and the precise fallback for older callers. Otherwise the existing installation in the ISSUE can still enter the broker-dependent shutdown path before migration is available.","evidenceReferences":["docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md: Fix intent","scripts/daemon-ctl.sh:315-335","src/daemon/update-runner.ts:164-175,279-283","src/daemon/admin-handlers.ts:108-118","vscode-plugin/src/daemon/controller.ts:108-118","jetbrains-plugin/src/main/kotlin/ai/insors/insrc/jetbrains/lifecycle/DaemonLifecycleCommandRunner.kt:38-50","jetbrains-plugin/src/main/kotlin/ai/insors/insrc/jetbrains/daemon/DaemonGateway.kt:1393"]},{"id":"install-02","severity":"MED","location":"LLD.md:51,73,161; /body/contractDetails","message":"Immutable release staging and compatibility qualification are stated as preconditions without a provisioning contract. The installer currently fast-forwards and rebuilds the existing checkout in place. The migration controller instead requires separate prior/candidate roots, a candidate descriptor, and an explicit qualified release pair; the design does not assign production of those inputs, define their trusted source, or explain how a legacy release without a declaration is identified and qualified. Specify release layout, predecessor preservation before checkout/dependency mutation, qualification provenance, and refusal behavior. Without this, normal installation cannot satisfy the migration preconditions or guarantee an executable rollback release.","evidenceReferences":["scripts/insrc-daemon-install.sh:164-224","src/bin/insrc-daemon-control.ts:64-76","src/shared/managed-daemon-installation.ts:102-109","src/daemon/managed-update-launch.ts:109-123","src/daemon/release-compatibility.ts:49-59","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md: Root cause"]},{"id":"install-03","severity":"MED","location":"LLD.md:34-54; /body/contractDetails/api/0","message":"The fresh activation contract cannot express its promised behavior. Its unchanged signature receives installation metadata, revalidation, and a legacy flag, but no requested-start state or activation reservation/journal. ManagedInstallation.enabled selects managed routing; it cannot also distinguish normal install from --no-start, since both must enable managed lifecycle. The existing function rejects enabled installations and only writes two exclusive-create files. Define the activation owner, explicit start intent, durable activation steps, and recovery from partial selector creation or bootstrap before claiming registration, conditional child startup, and interrupted activation as postconditions.","evidenceReferences":["src/shared/managed-daemon-installation.ts:22-30,284-300","src/bin/insrc-daemon-control.ts:41-54","src/cli/services/managed-daemon-control.ts:158-168,263-278","scripts/insrc-daemon-install.sh:391-399","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:118"]},{"id":"install-04","severity":"MED","location":"LLD.md:119,167; /body/errorPaths/edgeCases","message":"The assertion that already managed updates use the normal managed transaction omits an existing blocking integration boundary. Shell update sends daemon.update, but the admin handler explicitly rejects that operation for managed daemons. A stopped managed installation also cannot service that RPC. Define how running and stopped managed update entry points invoke candidate preparation and the managed transaction, including the admin-handler change and regression coverage. Otherwise enabling management makes the ordinary update command unavailable.","evidenceReferences":["src/bin/insrc-daemon-control.ts:126-128","scripts/daemon-ctl.sh:325-328","src/daemon/admin-handlers.ts:108-111","src/daemon/managed-update-launch.ts:127-136","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:135-149"]}],"inspectedReferences":["/body/summary","/body/hldContextSlice","document:line:25","/body/contractDetails","/body/interactionWithShared","/body/alternativesConsidered","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/chosenAlternative","/body/openQuestions","/body/errorPaths","/body/testStrategy","/citations/0","/citations/3","/citations/5","/citations/6","/citations/8","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md",".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json",".insrc/artifacts/ISSUE-5d5478c61a25ac8f.json",".insrc/artifacts/ISSUE-3992d2e1e26124dc.json","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md","scripts/insrc-daemon-install.sh","scripts/daemon-ctl.sh","src/bin/insrc-daemon-control.ts","src/shared/managed-daemon-installation.ts","src/daemon/update-runner.ts","src/daemon/admin-handlers.ts:95-119","src/daemon/managed-update-launch.ts:109-165","src/daemon/release-compatibility.ts","src/daemon/managed-update-recovery.ts:274-336","src/cli/services/managed-daemon-control.ts:158-188,263-278","vscode-plugin/src/daemon/controller.ts","jetbrains-plugin/src/main/kotlin/ai/insors/insrc/jetbrains/lifecycle/DaemonLifecycleCommandRunner.kt:38-83","src/daemon/__tests__/managed-update-transaction.test.ts:353-497","src/daemon/__tests__/managed-daemon-lifecycle.test.ts: test inventory","src/daemon/__tests__/update-handlers.test.ts: test inventory","src/config/__tests__/installer-defs.test.ts: test inventory"],"limitations":[],"advice":["The proposed unit, integration, and real macOS smoke levels are appropriate. Make the entry-point tests name the exact shipped predecessor/client combinations and include a second update after successful managed activation.","The acceptance mapping uses ac1–ac3 identifiers absent from the originating ISSUE. Label the corresponding fix-intent requirements explicitly so the mapping remains understandable."]},{"chunkId":"cutover","status":"changes_requested","summary":"The migration intent matches the ISSUE, but the LLD leaves predecessor-specific recovery contracts incomplete, does not fence legacy callers, and contradicts the existing durable commit rule.","findings":[{"id":"cutover-01","severity":"MED","location":"LLD.md:56-81; /body/contractDetails/api/1; /body/dataModelChanges","message":"The proposed discriminated predecessor record is described without defining its variants, persisted fields, decoding rules, or dispatch into migration and rollback. This is a material integration gap: completeLegacyMigration currently requires a saved LaunchAgent, recovery treats every predecessor without legacy metadata as managed, and journal validation requires such a prior pin to be enabled. A direct or stopped unmanaged predecessor therefore cannot enter the promised transaction safely. Define the variant contracts and backward decoding, including exact incarnation/publication evidence, direct-launch argv/environment/working directory, selector absence or baseline, and restoration verification. Also specify how recovery-job runtime flags are admitted: current legacy verification accepts only runtime plus entry, so additional Node flags are rejected despite the stated recovery-job coverage.","evidenceReferences":["docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md:15","src/shared/installation-mutation-gate.ts: UpdatePredecessor and validPredecessor","src/daemon/managed-update-recovery.ts:137-218,274-302","src/bin/insrc-daemon-control.ts:57-93","src/daemon/legacy-daemon-cutover.ts:15-19,59-63","src/daemon/legacy-launch-job.ts: verifyLegacyService","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:143"]},{"id":"cutover-02","severity":"HIGH","location":"LLD.md:121,161-165; /body/errorPaths/edgeCases; /body/migration","message":"A single installation reservation does not serialize legacy callers that never consult it. The design promises automatic live migration and concurrency safety but omits how older launchers, updaters and automatic starts are excluded during cutover. An already-running legacy shell/helper can rebuild the prior checkout or launch a daemon after predecessor exit while this transaction assumes exclusive ownership. The upstream lifecycle design explicitly requires legacy tooling that cannot honor the gate to be disabled for a quiescent cutover. Define an enforceable admission/exclusion boundary for supported live predecessors, including in-flight older callers, and refuse migration when that boundary cannot be established. Revalidation of the new journal alone cannot provide this guarantee.","evidenceReferences":["docs/standalone/restore-reliable-daemon-restart-macos-E202611103992d2e1/S001/LLD.md: migration step 1","scripts/daemon-ctl.sh: prepare_daemon, start_prepared_daemon, cmd_restart and cmd_update","src/daemon/update-runner.ts: launchUpdate and runDetachedUpdate","src/shared/installation-mutation-gate.ts: reserve and admit","src/daemon/legacy-daemon-cutover.ts:77-92"]},{"id":"cutover-03","severity":"MED","location":"LLD.md:105-108,165-166; /body/errorPaths/errorCases/2; /body/migration","message":"Outcome-persistence failure is grouped with candidate registration/readiness failures and instructs recovery to stop the candidate and restore the predecessor. That is unsafe when publication throws after a durable success record was written. The existing transaction deliberately preserves the reservation on publication errors and classifies the durable outcome before selecting rollback or activation; committed success must never trigger implicit rollback. Define this distinction explicitly. Also distinguish provisional selector publication before supervisor bootstrap from terminal publication after readiness, since the current candidate handoff requires the former.","evidenceReferences":["src/daemon/managed-update-transaction.ts: finish, settleManagedUpdate and recoverManagedTransaction","src/shared/installation-mutation-gate.ts: classifyMutationRecovery and publishOutcome","src/daemon/managed-update-handoff.ts: stageManagedCandidate","src/daemon/__tests__/managed-update-transaction.test.ts:46-76","docs/standalone/restore-reliable-daemon-restart-macos-E202611103992d2e1/S001/LLD.md: migration steps 3-4"]},{"id":"cutover-04","severity":"MED","location":"LLD.md:75,120; /body/contractDetails/api/1; /body/errorPaths/edgeCases","message":"The LLD requires watchdog-denied early exit to be recorded distinctly from a successful drain, but supplies no evidence or result contract that can make that distinction. The cited cutover routine sends shutdown without reading its response and returns only the process incarnation after a boolean exact-exit observation. Its journal receipt records only exited plus that incarnation. Both clean drain and watchdog-arm failure therefore produce the same migration evidence. Specify a trustworthy classification source, persistence and user-visible result, with an explicit unknown classification when drain completion cannot be established. Add paired clean-drain and broker-denied predecessor tests; the existing synthetic exit fixture proves identity and cleanup only.","evidenceReferences":["src/daemon/legacy-daemon-cutover.ts:29-31,79-93","src/shared/darwin-lifecycle.ts: DarwinExitObservation and observeDarwinExit","src/daemon/managed-update-recovery.ts:287-295","src/daemon/shutdown.ts: failClosed and begin","src/daemon/__tests__/legacy-daemon-cutover.test.ts:13-57","docs/standalone/restore-reliable-daemon-restart-macos-E202611103992d2e1/S001/LLD.md: legacy or temporary recovery instance edge case"]}],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/body/interactionWithShared","/body/errorPaths","/body/migration","/body/testStrategy","/citations/1","/citations/2","/citations/3","/citations/4","/citations/6","/citations/7","/citations/8","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md",".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json",".insrc/tmp/design-review/macos-installer-migration-5d5478c6.json","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md",".insrc/artifacts/ISSUE-3992d2e1e26124dc.json: reproduction, rootCause and fixIntent","docs/standalone/restore-reliable-daemon-restart-macos-E202611103992d2e1/S001/LLD.md: contracts, data model, error paths, tests and migration","src/shared/managed-daemon-installation.ts","src/shared/installation-mutation-gate.ts","src/shared/darwin-lifecycle.ts","src/bin/insrc-daemon-control.ts","src/daemon/legacy-launch-job.ts","src/daemon/legacy-daemon-cutover.ts","src/daemon/managed-update-recovery.ts","src/daemon/managed-update-handoff.ts","src/daemon/managed-update-transaction.ts","src/daemon/update-runner.ts","scripts/daemon-ctl.sh:210-345","src/daemon/shutdown.ts:155-210","src/daemon/__tests__/legacy-daemon-cutover.test.ts","src/daemon/__tests__/managed-update-transaction.test.ts:350-497","src/daemon/__tests__/managed-update-transaction.test.ts: test inventory and publication-failure test","src/shared/__tests__/installation-mutation-gate.test.ts: test inventory","src/shared/__tests__/darwin-lifecycle.test.ts: test inventory"],"limitations":[],"advice":["Expand the proposed interruption tests into a predecessor-by-boundary matrix: before and after shutdown, exact-exit receipt, job removal, provisional selector writes, candidate registration, child readiness, terminal publication and reservation release. Include changed publications, timeouts, legacy callers racing cutover, and backward journal decoding.","Keep stopped-state validation explicit: successful migration should verify an authenticated idle supervisor and absent daemon publications without requiring daemon readiness."]},{"chunkId":"visuals","status":"incomplete","summary":"All assigned source units and the generated companion were inspected. The sequence omits substantive stopped-state and rollback paths. Actual rendering could not be verified because the browser host was unavailable.","findings":[{"id":"visuals-01","severity":"MED","location":"/body/sequenceDefinition/messages/5–8; sequence-diagram.html","message":"The generated sequence proceeds from conditional child startup to unconditional daemon readiness, so it does not represent successful --no-start or previously stopped completion. Rollback exists only in a message description that the generated diagram omits; no failure/restoration path is visible. Add explicit running/stopped and failure branches showing verified stopped completion, candidate cleanup, predecessor restoration, and fenced recovery when restoration cannot be verified. These are substantive lifecycle outcomes promised by the ISSUE and LLD.","evidenceReferences":[".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json: /body/sequenceDefinition/messages","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html: embedded sequenceDiagram","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:54,105–108,118–119,164–165","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md: Fix intent","src/daemon/managed-update-recovery.ts: requireReady","src/daemon/managed-update-transaction.ts: settleManagedUpdate"]},{"id":"visuals-02","severity":"LOW","location":"LLD.md:91","message":"The companion hyperlink repeats the repository-relative document directory. Resolved relative to LLD.md, its target does not exist, although the canonical companion path does exist. Use a document-relative sequence-diagram.html link or an explicitly supported repository-root link.","evidenceReferences":["docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:91",".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json: /body/companions/0/relPath"]}],"inspectedReferences":["/body/sequenceDefinition","/body/sequenceDefinition/participants/0","/body/sequenceDefinition/participants/1","/body/sequenceDefinition/participants/2","/body/sequenceDefinition/participants/3","/body/sequenceDefinition/participants/4","/body/companions","document:line:89","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md",".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html","src/bin/insrc-daemon-control.ts","src/cli/services/managed-daemon-control.ts: openManagedSupervisorLink","src/daemon/managed-update-recovery.ts: completeLegacyMigration, requireReady, Rollback","src/daemon/managed-update-transaction.ts"],"limitations":["Actual rendering of docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html was not verified: the browser tool reported that its access host was unavailable. Embedded Mermaid source was inspected, but visual layout, clipping, and runtime rendering remain unverified."],"advice":["Clarify actor responsibilities in the sequence: exact-exit verification and passive-job removal are controller operations, whereas the current legacy-to-controller message labels them as a predecessor response. Separating launchd from the legacy daemon would make registration and removal ownership clearer.","A corrected sequence plus the existing ownership/cardinality prose should suffice; no additional ERD or UX artifact is necessary for this assignment."]},{"chunkId":"consistency","status":"incomplete","summary":"Whole-artifact consistency checks found no additional defects beyond the accepted install, cutover, and visuals findings. The LLD covers the originating ISSUE's intended scope, but the recorded contract and integration gaps remain unresolved. Live and canonical documents match the review baseline. Mandatory visual verification remains incomplete.","findings":[],"inspectedReferences":["/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/macos-installer-migration-5d5478c6.json",".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json",".insrc/artifacts/ISSUE-5d5478c61a25ac8f.json",".insrc/artifacts/ISSUE-3992d2e1e26124dc.json","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html: embedded Mermaid and viewer source","docs/standalone/restore-reliable-daemon-restart-macos-E202611103992d2e1/S001/LLD.md: ownership, admission, compatibility, recovery, tests and migration contracts","src/bin/insrc-daemon-control.ts","src/shared/managed-daemon-installation.ts: installation types and input contracts","src/daemon/managed-update-transaction.ts","src/daemon/managed-update-recovery.ts:274-345","src/daemon/update-runner.ts:145-190","src/daemon/admin-handlers.ts:100-122","scripts/insrc-daemon-install.sh:145-230","scripts/insrc-daemon-install.sh:350-415"],"limitations":["Mandatory actual rendering verification of docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html remains outstanding. The completed visuals feedback records an unavailable browser access host; this consistency check inspected generated source and its agreement with the canonical definition, but did not establish runtime rendering, layout or clipping."],"advice":["Retain install-01 through install-04: together they cover first-upgrade delivery, immutable release provisioning, fresh activation intent and recovery, and running/stopped managed update routing. These are dependencies of the ordinary install/update promise, rather than separate optional enhancements.","Retain cutover-01 through cutover-04: predecessor variants and recovery-job flags, exclusion of legacy writers, durable commit classification, and trustworthy drain-versus-early-exit evidence must agree across the controller, journal, recovery implementation and tests.","Retain visuals-01 and visuals-02. Align the sequence's stopped completion and rollback branches with the eventual contracts, and correct its document-relative link.","Give ac1–ac3 explicit originating-ISSUE requirement labels. The ISSUE has no such identifiers; its fix intent nevertheless supplies the requirements for fresh start/restart, automatic supported migration, recovery jobs, direct installs, broker-denied exit, rollback preservation and Linux behavior.","Implementation tests and real macOS lifecycle smoke execution were not run during this read-only design review; their execution belongs to subsequent implementation qualification."]}],"progress":{"status":"incomplete","phase":"complete","completedChunks":4,"totalChunks":4,"lastMeaningfulActivityAt":null,"activeToolCount":0,"requiresUserInput":false,"checkpointPath":"/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/macos-installer-migration-5d5478c6.json","sequence":0,"reviewElapsedMs":0,"unitElapsedMs":null,"observedAt":"2026-11-11T16:17:16.156Z","freshness":"stored"},"startedAt":"2026-11-11T16:09:47.897Z","reviewer":"daemon","model":"gpt-6.1-sol","unit":{"unitId":"consistency","phase":"chunk_review","executionId":"134af56d-02a3-4c10-bf8b-1bf476482494","dispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[]},"plan":{"chunks":[{"id":"install","title":"Installer activation and supported update entry points","selectors":["/body/summary","/body/hldContextSlice","document:line:25","/body/contractDetails","/body/interactionWithShared","/body/alternativesConsidered","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/chosenAlternative","/body/openQuestions","/body/errorPaths","/body/testStrategy","/citations/0","/citations/3","/citations/5","/citations/6","/citations/8"],"concerns":["Trace fresh installation and automatic existing-install migration to the originating ISSUE reproduction, root cause and fix intent; use issue ancestry rather than inferred HLD ancestry.","Inspect installer, lifecycle controller, shell routing and update-runner evidence for concrete migration-capable entry points, candidate staging before legacy shutdown, compatibility qualification and immutable release availability.","Assess stageManagedInstallation inputs, activation ownership, launchd registration, GUI-domain preconditions, requested-start semantics, --no-start, interrupted activation and user-visible failures.","Check preserved installer switches, lifecycle commands and IPC payloads, current IDE client integration where necessary, Linux behavior and explicit scope boundaries.","Assess relevant unit, integration and macOS smoke coverage, acceptance traceability, alternatives and unresolved decisions."],"dependsOn":[],"purpose":"substantive"},{"id":"cutover","title":"Predecessor ownership, migration transaction and rollback","selectors":["/body/contractDetails","/body/dataModelChanges","/body/interactionWithShared","/body/errorPaths","/body/migration","/body/testStrategy","/citations/1","/citations/2","/citations/3","/citations/4","/citations/6","/citations/7","/citations/8"],"concerns":["Inspect completeLegacyMigration and shared installation, update, legacy-job and cutover code for implementable ownership contracts and transaction boundaries.","Assess predecessor discrimination for managed, direct, passive LaunchAgent, temporary recovery-job and stopped installations; verify runtime, entry, socket peer incarnation, run-file identities and rollback launch metadata.","Check state-root, selector, supervisor, child and reservation ownership/cardinality, durable pins, journal compatibility and recovery fencing.","Trace exact Darwin exit observation through broker denial, early shutdown, timeout and replacement races; assess when pinned jobs and publications may safely be removed.","Assess candidate registration, readiness, publication, durable outcome ordering, interruption recovery and rollback preserving prior release, running state, settings and repository data.","Check concurrency, retries, failure reporting and test coverage for each supported predecessor and transaction failure boundary."],"dependsOn":["install"],"purpose":"substantive"},{"id":"visuals","title":"Lifecycle sequence definitions and generated companion","selectors":["/body/sequenceDefinition","/body/sequenceDefinition/participants/0","/body/sequenceDefinition/participants/1","/body/sequenceDefinition/participants/2","/body/sequenceDefinition/participants/3","/body/sequenceDefinition/participants/4","/body/companions","document:line:89"],"concerns":["Read the authored sequence, participant descriptions and linked generated HTML; inspect actual rendering where available and explicitly report unavailable mandatory visual verification as a limitation.","Check participant responsibilities and message direction against actual installer, controller, launchd, supervisor and daemon ownership.","Assess whether the sequence adequately represents staging, reservation, predecessor exit, registration, conditional start, readiness, stopped-state completion and rollback.","Verify companion paths, generated content and agreement with the source definition and substantive lifecycle contracts; assess whether further relationship or interaction artifacts are necessary."],"dependsOn":["install","cutover"],"purpose":"substantive"},{"id":"consistency","title":"Whole-artifact requirements and shared-contract consistency","selectors":[],"concerns":["Reconcile all substantive assessments against the actual originating ISSUE, including fresh start/restart, automatic supported updates, recovery jobs, direct installs, broker-denied exit, rollback preservation and Linux behavior.","Check missing requirements, contradictions, shared signatures and state contracts, dependency/order feasibility, acceptance mappings, citations and canonical/live/generated-document agreement.","Ensure limitations distinguish missing mandatory inspection from optional execution, findings identify demonstrated defects with evidence, and final status follows the required precedence."],"dependsOn":["install","cutover","visuals"],"purpose":"consistency"}],"coverageExplanation":"All 31 inventory units map to substantive chunks. Shared contracts, error paths and tests are assigned to both entry-point activation and migration recovery so each responsibility retains its interfaces, logic, failures and validation. Visual units receive separate source and rendering inspection after their lifecycle dependencies. The final consistency chunk depends on every substantive chunk and does not substitute for unit coverage.","finalConsistencyChunkId":"consistency","coverage":[{"unitId":"/body/summary","chunkIds":["install"]},{"unitId":"/body/hldContextSlice","chunkIds":["install"]},{"unitId":"/body/contractDetails","chunkIds":["install","cutover"]},{"unitId":"/body/dataModelChanges","chunkIds":["cutover"]},{"unitId":"/body/interactionWithShared","chunkIds":["install","cutover"]},{"unitId":"/body/errorPaths","chunkIds":["install","cutover"]},{"unitId":"/body/testStrategy","chunkIds":["install","cutover"]},{"unitId":"/body/migration","chunkIds":["cutover"]},{"unitId":"/body/alternativesConsidered","chunkIds":["install"]},{"unitId":"/body/chosenAlternative","chunkIds":["install"]},{"unitId":"/body/openQuestions","chunkIds":["install"]},{"unitId":"/body/sequenceDefinition","chunkIds":["visuals"]},{"unitId":"/body/companions","chunkIds":["visuals"]},{"unitId":"/body/alternativesConsidered/0","chunkIds":["install"]},{"unitId":"/body/alternativesConsidered/1","chunkIds":["install"]},{"unitId":"/body/sequenceDefinition/participants/0","chunkIds":["visuals"]},{"unitId":"/body/sequenceDefinition/participants/1","chunkIds":["visuals"]},{"unitId":"/body/sequenceDefinition/participants/2","chunkIds":["visuals"]},{"unitId":"/body/sequenceDefinition/participants/3","chunkIds":["visuals"]},{"unitId":"/body/sequenceDefinition/participants/4","chunkIds":["visuals"]},{"unitId":"/citations/0","chunkIds":["install"]},{"unitId":"/citations/1","chunkIds":["cutover"]},{"unitId":"/citations/2","chunkIds":["cutover"]},{"unitId":"/citations/3","chunkIds":["install","cutover"]},{"unitId":"/citations/4","chunkIds":["cutover"]},{"unitId":"/citations/5","chunkIds":["install"]},{"unitId":"/citations/6","chunkIds":["install","cutover"]},{"unitId":"/citations/7","chunkIds":["cutover"]},{"unitId":"/citations/8","chunkIds":["install","cutover"]},{"unitId":"document:line:25","chunkIds":["install"]},{"unitId":"document:line:89","chunkIds":["visuals"]}]},"unitSummaries":[{"unitId":"planning","phase":"planning","automaticDispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[],"actionIds":[]},{"unitId":"install","phase":"chunk_review","automaticDispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[],"actionIds":[]},{"unitId":"cutover","phase":"chunk_review","automaticDispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[],"actionIds":[]},{"unitId":"visuals","phase":"chunk_review","automaticDispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[],"actionIds":[]},{"unitId":"consistency","phase":"chunk_review","automaticDispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[],"actionIds":[]}],"report":{"reviewId":"macos-installer-migration-5d5478c6","attempt":1,"artifactId":"LLD-5d5478c61a25ac8f-s1","status":"incomplete","counts":{"HIGH":2,"MED":7,"LOW":1},"chunks":[{"chunkId":"install","status":"changes_requested","summary":"The design follows the originating ISSUE's intent, but does not define executable entry-point routing, release provisioning, or fresh activation contracts sufficiently to resolve the demonstrated installer and updater gaps.","findings":[{"id":"install-01","severity":"HIGH","location":"LLD.md:109-112,167; /body/errorPaths","message":"The first-upgrade route remains unspecified. Requiring a migration-capable installer or updated client before shutdown does not identify how ordinary supported update commands obtain and invoke that code. The installed shell restart stops before fetching, and daemon.update schedules shutdown immediately after launching its installed helper. Current IDE lifecycle commands invoke the installed shell, while freshness flows use daemon.update. Define the supported command/client matrix, how each obtains the migration controller before shutdown, and the precise fallback for older callers. Otherwise the existing installation in the ISSUE can still enter the broker-dependent shutdown path before migration is available.","evidenceReferences":["docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md: Fix intent","scripts/daemon-ctl.sh:315-335","src/daemon/update-runner.ts:164-175,279-283","src/daemon/admin-handlers.ts:108-118","vscode-plugin/src/daemon/controller.ts:108-118","jetbrains-plugin/src/main/kotlin/ai/insors/insrc/jetbrains/lifecycle/DaemonLifecycleCommandRunner.kt:38-50","jetbrains-plugin/src/main/kotlin/ai/insors/insrc/jetbrains/daemon/DaemonGateway.kt:1393"]},{"id":"install-02","severity":"MED","location":"LLD.md:51,73,161; /body/contractDetails","message":"Immutable release staging and compatibility qualification are stated as preconditions without a provisioning contract. The installer currently fast-forwards and rebuilds the existing checkout in place. The migration controller instead requires separate prior/candidate roots, a candidate descriptor, and an explicit qualified release pair; the design does not assign production of those inputs, define their trusted source, or explain how a legacy release without a declaration is identified and qualified. Specify release layout, predecessor preservation before checkout/dependency mutation, qualification provenance, and refusal behavior. Without this, normal installation cannot satisfy the migration preconditions or guarantee an executable rollback release.","evidenceReferences":["scripts/insrc-daemon-install.sh:164-224","src/bin/insrc-daemon-control.ts:64-76","src/shared/managed-daemon-installation.ts:102-109","src/daemon/managed-update-launch.ts:109-123","src/daemon/release-compatibility.ts:49-59","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md: Root cause"]},{"id":"install-03","severity":"MED","location":"LLD.md:34-54; /body/contractDetails/api/0","message":"The fresh activation contract cannot express its promised behavior. Its unchanged signature receives installation metadata, revalidation, and a legacy flag, but no requested-start state or activation reservation/journal. ManagedInstallation.enabled selects managed routing; it cannot also distinguish normal install from --no-start, since both must enable managed lifecycle. The existing function rejects enabled installations and only writes two exclusive-create files. Define the activation owner, explicit start intent, durable activation steps, and recovery from partial selector creation or bootstrap before claiming registration, conditional child startup, and interrupted activation as postconditions.","evidenceReferences":["src/shared/managed-daemon-installation.ts:22-30,284-300","src/bin/insrc-daemon-control.ts:41-54","src/cli/services/managed-daemon-control.ts:158-168,263-278","scripts/insrc-daemon-install.sh:391-399","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:118"]},{"id":"install-04","severity":"MED","location":"LLD.md:119,167; /body/errorPaths/edgeCases","message":"The assertion that already managed updates use the normal managed transaction omits an existing blocking integration boundary. Shell update sends daemon.update, but the admin handler explicitly rejects that operation for managed daemons. A stopped managed installation also cannot service that RPC. Define how running and stopped managed update entry points invoke candidate preparation and the managed transaction, including the admin-handler change and regression coverage. Otherwise enabling management makes the ordinary update command unavailable.","evidenceReferences":["src/bin/insrc-daemon-control.ts:126-128","scripts/daemon-ctl.sh:325-328","src/daemon/admin-handlers.ts:108-111","src/daemon/managed-update-launch.ts:127-136","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:135-149"]}],"inspectedReferences":["/body/summary","/body/hldContextSlice","document:line:25","/body/contractDetails","/body/interactionWithShared","/body/alternativesConsidered","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/chosenAlternative","/body/openQuestions","/body/errorPaths","/body/testStrategy","/citations/0","/citations/3","/citations/5","/citations/6","/citations/8","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md",".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json",".insrc/artifacts/ISSUE-5d5478c61a25ac8f.json",".insrc/artifacts/ISSUE-3992d2e1e26124dc.json","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md","scripts/insrc-daemon-install.sh","scripts/daemon-ctl.sh","src/bin/insrc-daemon-control.ts","src/shared/managed-daemon-installation.ts","src/daemon/update-runner.ts","src/daemon/admin-handlers.ts:95-119","src/daemon/managed-update-launch.ts:109-165","src/daemon/release-compatibility.ts","src/daemon/managed-update-recovery.ts:274-336","src/cli/services/managed-daemon-control.ts:158-188,263-278","vscode-plugin/src/daemon/controller.ts","jetbrains-plugin/src/main/kotlin/ai/insors/insrc/jetbrains/lifecycle/DaemonLifecycleCommandRunner.kt:38-83","src/daemon/__tests__/managed-update-transaction.test.ts:353-497","src/daemon/__tests__/managed-daemon-lifecycle.test.ts: test inventory","src/daemon/__tests__/update-handlers.test.ts: test inventory","src/config/__tests__/installer-defs.test.ts: test inventory"],"limitations":[],"advice":["The proposed unit, integration, and real macOS smoke levels are appropriate. Make the entry-point tests name the exact shipped predecessor/client combinations and include a second update after successful managed activation.","The acceptance mapping uses ac1–ac3 identifiers absent from the originating ISSUE. Label the corresponding fix-intent requirements explicitly so the mapping remains understandable."]},{"chunkId":"cutover","status":"changes_requested","summary":"The migration intent matches the ISSUE, but the LLD leaves predecessor-specific recovery contracts incomplete, does not fence legacy callers, and contradicts the existing durable commit rule.","findings":[{"id":"cutover-01","severity":"MED","location":"LLD.md:56-81; /body/contractDetails/api/1; /body/dataModelChanges","message":"The proposed discriminated predecessor record is described without defining its variants, persisted fields, decoding rules, or dispatch into migration and rollback. This is a material integration gap: completeLegacyMigration currently requires a saved LaunchAgent, recovery treats every predecessor without legacy metadata as managed, and journal validation requires such a prior pin to be enabled. A direct or stopped unmanaged predecessor therefore cannot enter the promised transaction safely. Define the variant contracts and backward decoding, including exact incarnation/publication evidence, direct-launch argv/environment/working directory, selector absence or baseline, and restoration verification. Also specify how recovery-job runtime flags are admitted: current legacy verification accepts only runtime plus entry, so additional Node flags are rejected despite the stated recovery-job coverage.","evidenceReferences":["docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md:15","src/shared/installation-mutation-gate.ts: UpdatePredecessor and validPredecessor","src/daemon/managed-update-recovery.ts:137-218,274-302","src/bin/insrc-daemon-control.ts:57-93","src/daemon/legacy-daemon-cutover.ts:15-19,59-63","src/daemon/legacy-launch-job.ts: verifyLegacyService","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:143"]},{"id":"cutover-02","severity":"HIGH","location":"LLD.md:121,161-165; /body/errorPaths/edgeCases; /body/migration","message":"A single installation reservation does not serialize legacy callers that never consult it. The design promises automatic live migration and concurrency safety but omits how older launchers, updaters and automatic starts are excluded during cutover. An already-running legacy shell/helper can rebuild the prior checkout or launch a daemon after predecessor exit while this transaction assumes exclusive ownership. The upstream lifecycle design explicitly requires legacy tooling that cannot honor the gate to be disabled for a quiescent cutover. Define an enforceable admission/exclusion boundary for supported live predecessors, including in-flight older callers, and refuse migration when that boundary cannot be established. Revalidation of the new journal alone cannot provide this guarantee.","evidenceReferences":["docs/standalone/restore-reliable-daemon-restart-macos-E202611103992d2e1/S001/LLD.md: migration step 1","scripts/daemon-ctl.sh: prepare_daemon, start_prepared_daemon, cmd_restart and cmd_update","src/daemon/update-runner.ts: launchUpdate and runDetachedUpdate","src/shared/installation-mutation-gate.ts: reserve and admit","src/daemon/legacy-daemon-cutover.ts:77-92"]},{"id":"cutover-03","severity":"MED","location":"LLD.md:105-108,165-166; /body/errorPaths/errorCases/2; /body/migration","message":"Outcome-persistence failure is grouped with candidate registration/readiness failures and instructs recovery to stop the candidate and restore the predecessor. That is unsafe when publication throws after a durable success record was written. The existing transaction deliberately preserves the reservation on publication errors and classifies the durable outcome before selecting rollback or activation; committed success must never trigger implicit rollback. Define this distinction explicitly. Also distinguish provisional selector publication before supervisor bootstrap from terminal publication after readiness, since the current candidate handoff requires the former.","evidenceReferences":["src/daemon/managed-update-transaction.ts: finish, settleManagedUpdate and recoverManagedTransaction","src/shared/installation-mutation-gate.ts: classifyMutationRecovery and publishOutcome","src/daemon/managed-update-handoff.ts: stageManagedCandidate","src/daemon/__tests__/managed-update-transaction.test.ts:46-76","docs/standalone/restore-reliable-daemon-restart-macos-E202611103992d2e1/S001/LLD.md: migration steps 3-4"]},{"id":"cutover-04","severity":"MED","location":"LLD.md:75,120; /body/contractDetails/api/1; /body/errorPaths/edgeCases","message":"The LLD requires watchdog-denied early exit to be recorded distinctly from a successful drain, but supplies no evidence or result contract that can make that distinction. The cited cutover routine sends shutdown without reading its response and returns only the process incarnation after a boolean exact-exit observation. Its journal receipt records only exited plus that incarnation. Both clean drain and watchdog-arm failure therefore produce the same migration evidence. Specify a trustworthy classification source, persistence and user-visible result, with an explicit unknown classification when drain completion cannot be established. Add paired clean-drain and broker-denied predecessor tests; the existing synthetic exit fixture proves identity and cleanup only.","evidenceReferences":["src/daemon/legacy-daemon-cutover.ts:29-31,79-93","src/shared/darwin-lifecycle.ts: DarwinExitObservation and observeDarwinExit","src/daemon/managed-update-recovery.ts:287-295","src/daemon/shutdown.ts: failClosed and begin","src/daemon/__tests__/legacy-daemon-cutover.test.ts:13-57","docs/standalone/restore-reliable-daemon-restart-macos-E202611103992d2e1/S001/LLD.md: legacy or temporary recovery instance edge case"]}],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/body/interactionWithShared","/body/errorPaths","/body/migration","/body/testStrategy","/citations/1","/citations/2","/citations/3","/citations/4","/citations/6","/citations/7","/citations/8","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md",".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json",".insrc/tmp/design-review/macos-installer-migration-5d5478c6.json","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md",".insrc/artifacts/ISSUE-3992d2e1e26124dc.json: reproduction, rootCause and fixIntent","docs/standalone/restore-reliable-daemon-restart-macos-E202611103992d2e1/S001/LLD.md: contracts, data model, error paths, tests and migration","src/shared/managed-daemon-installation.ts","src/shared/installation-mutation-gate.ts","src/shared/darwin-lifecycle.ts","src/bin/insrc-daemon-control.ts","src/daemon/legacy-launch-job.ts","src/daemon/legacy-daemon-cutover.ts","src/daemon/managed-update-recovery.ts","src/daemon/managed-update-handoff.ts","src/daemon/managed-update-transaction.ts","src/daemon/update-runner.ts","scripts/daemon-ctl.sh:210-345","src/daemon/shutdown.ts:155-210","src/daemon/__tests__/legacy-daemon-cutover.test.ts","src/daemon/__tests__/managed-update-transaction.test.ts:350-497","src/daemon/__tests__/managed-update-transaction.test.ts: test inventory and publication-failure test","src/shared/__tests__/installation-mutation-gate.test.ts: test inventory","src/shared/__tests__/darwin-lifecycle.test.ts: test inventory"],"limitations":[],"advice":["Expand the proposed interruption tests into a predecessor-by-boundary matrix: before and after shutdown, exact-exit receipt, job removal, provisional selector writes, candidate registration, child readiness, terminal publication and reservation release. Include changed publications, timeouts, legacy callers racing cutover, and backward journal decoding.","Keep stopped-state validation explicit: successful migration should verify an authenticated idle supervisor and absent daemon publications without requiring daemon readiness."]},{"chunkId":"visuals","status":"incomplete","summary":"All assigned source units and the generated companion were inspected. The sequence omits substantive stopped-state and rollback paths. Actual rendering could not be verified because the browser host was unavailable.","findings":[{"id":"visuals-01","severity":"MED","location":"/body/sequenceDefinition/messages/5–8; sequence-diagram.html","message":"The generated sequence proceeds from conditional child startup to unconditional daemon readiness, so it does not represent successful --no-start or previously stopped completion. Rollback exists only in a message description that the generated diagram omits; no failure/restoration path is visible. Add explicit running/stopped and failure branches showing verified stopped completion, candidate cleanup, predecessor restoration, and fenced recovery when restoration cannot be verified. These are substantive lifecycle outcomes promised by the ISSUE and LLD.","evidenceReferences":[".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json: /body/sequenceDefinition/messages","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html: embedded sequenceDiagram","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:54,105–108,118–119,164–165","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md: Fix intent","src/daemon/managed-update-recovery.ts: requireReady","src/daemon/managed-update-transaction.ts: settleManagedUpdate"]},{"id":"visuals-02","severity":"LOW","location":"LLD.md:91","message":"The companion hyperlink repeats the repository-relative document directory. Resolved relative to LLD.md, its target does not exist, although the canonical companion path does exist. Use a document-relative sequence-diagram.html link or an explicitly supported repository-root link.","evidenceReferences":["docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:91",".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json: /body/companions/0/relPath"]}],"inspectedReferences":["/body/sequenceDefinition","/body/sequenceDefinition/participants/0","/body/sequenceDefinition/participants/1","/body/sequenceDefinition/participants/2","/body/sequenceDefinition/participants/3","/body/sequenceDefinition/participants/4","/body/companions","document:line:89","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md",".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html","src/bin/insrc-daemon-control.ts","src/cli/services/managed-daemon-control.ts: openManagedSupervisorLink","src/daemon/managed-update-recovery.ts: completeLegacyMigration, requireReady, Rollback","src/daemon/managed-update-transaction.ts"],"limitations":["Actual rendering of docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html was not verified: the browser tool reported that its access host was unavailable. Embedded Mermaid source was inspected, but visual layout, clipping, and runtime rendering remain unverified."],"advice":["Clarify actor responsibilities in the sequence: exact-exit verification and passive-job removal are controller operations, whereas the current legacy-to-controller message labels them as a predecessor response. Separating launchd from the legacy daemon would make registration and removal ownership clearer.","A corrected sequence plus the existing ownership/cardinality prose should suffice; no additional ERD or UX artifact is necessary for this assignment."]},{"chunkId":"consistency","status":"incomplete","summary":"Whole-artifact consistency checks found no additional defects beyond the accepted install, cutover, and visuals findings. The LLD covers the originating ISSUE's intended scope, but the recorded contract and integration gaps remain unresolved. Live and canonical documents match the review baseline. Mandatory visual verification remains incomplete.","findings":[],"inspectedReferences":["/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/macos-installer-migration-5d5478c6.json",".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json",".insrc/artifacts/ISSUE-5d5478c61a25ac8f.json",".insrc/artifacts/ISSUE-3992d2e1e26124dc.json","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html: embedded Mermaid and viewer source","docs/standalone/restore-reliable-daemon-restart-macos-E202611103992d2e1/S001/LLD.md: ownership, admission, compatibility, recovery, tests and migration contracts","src/bin/insrc-daemon-control.ts","src/shared/managed-daemon-installation.ts: installation types and input contracts","src/daemon/managed-update-transaction.ts","src/daemon/managed-update-recovery.ts:274-345","src/daemon/update-runner.ts:145-190","src/daemon/admin-handlers.ts:100-122","scripts/insrc-daemon-install.sh:145-230","scripts/insrc-daemon-install.sh:350-415"],"limitations":["Mandatory actual rendering verification of docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html remains outstanding. The completed visuals feedback records an unavailable browser access host; this consistency check inspected generated source and its agreement with the canonical definition, but did not establish runtime rendering, layout or clipping."],"advice":["Retain install-01 through install-04: together they cover first-upgrade delivery, immutable release provisioning, fresh activation intent and recovery, and running/stopped managed update routing. These are dependencies of the ordinary install/update promise, rather than separate optional enhancements.","Retain cutover-01 through cutover-04: predecessor variants and recovery-job flags, exclusion of legacy writers, durable commit classification, and trustworthy drain-versus-early-exit evidence must agree across the controller, journal, recovery implementation and tests.","Retain visuals-01 and visuals-02. Align the sequence's stopped completion and rollback branches with the eventual contracts, and correct its document-relative link.","Give ac1–ac3 explicit originating-ISSUE requirement labels. The ISSUE has no such identifiers; its fix intent nevertheless supplies the requirements for fresh start/restart, automatic supported migration, recovery jobs, direct installs, broker-denied exit, rollback preservation and Linux behavior.","Implementation tests and real macOS lifecycle smoke execution were not run during this read-only design review; their execution belongs to subsequent implementation qualification."]}],"limitations":["Actual rendering of docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html was not verified: the browser tool reported that its access host was unavailable. Embedded Mermaid source was inspected, but visual layout, clipping, and runtime rendering remain unverified.","Mandatory actual rendering verification of docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html remains outstanding. The completed visuals feedback records an unavailable browser access host; this consistency check inspected generated source and its agreement with the canonical definition, but did not establish runtime rendering, layout or clipping."],"reviewer":"daemon","reviewedContentIdentity":"84b35629e7b712583748489d95b40e3d49d267770e5380579dedf1b3f21faa94"},"finishedAt":"2026-11-11T16:17:16.156Z"},{"number":2,"status":"incomplete","preparationKind":"impact","baseline":{"subjectFingerprints":{"canonical":"3b4c5bcd961a44f408eeb9632efea643dba977dc85f14b8750d2e35e738c053d","document":"056177a045eccae9de26c2e49c802e87ccb9d48491cdeac0ac35ecab875175de"},"contentIdentity":"0836a5530af73b66da092db6ccd4ea4df8e636f409ff0a491cc94947f9eb8904","reviewedContent":{"canonical":"{\n  \"meta\": {\n    \"workflow\": \"design.story\",\n    \"runId\": \"wf-1794414767042-nsonkp\",\n    \"repoPath\": \"/Users/subhagho/work/projects/insors/insrc\",\n    \"createdAt\": \"2026-11-11T16:36:11.393Z\",\n    \"epicCreatedAt\": \"2026-11-11T16:00:50.440Z\",\n    \"attribution\": {\n      \"outputs\": [\n        {\n          \"role\": \"(client)\",\n          \"tier\": \"core\",\n          \"runner\": \"cli-codex\",\n          \"model\": \"unknown\"\n        }\n      ]\n    },\n    \"elapsedMs\": 203464,\n    \"repoIndexedAt\": null,\n    \"schemaVersion\": 1,\n    \"epicHash\": \"5d5478c61a25ac8f\",\n    \"epicSlug\": \"enable-managed-daemon-lifecycle-macos-install\",\n    \"storyId\": \"s1\",\n    \"hldBaseRunId\": \"wf-1794414767042-nsonkp\",\n    \"hldEffectiveHash\": \"72b5eb5ef17cbb9823d7868cf0edd7d2bdf6fe4687172a74f0414d28ce6fa2dc\",\n    \"hldAmendmentsApplied\": [],\n    \"storyTitle\": \"Design the approved macOS installer and automatic existing-install migration fix from ISSUE-5d5478c61a25ac8f\",\n    \"standalone\": true,\n    \"sizeClass\": \"bugfix\",\n    \"authoredBy\": \"controller\",\n    \"lifecycle\": {\n      \"status\": \"draft\",\n      \"revision\": {\n        \"number\": 2,\n        \"contentHash\": \"abc5eb009b462bf0a67fbb2f09474ce6399e2cb73d9ada068adfb266a7f8b943\",\n        \"at\": \"2026-11-11T16:36:11.729Z\",\n        \"by\": {\n          \"id\": \"insrc:system\",\n          \"kind\": \"system\",\n          \"properties\": {}\n        }\n      },\n      \"signoffs\": []\n    },\n    \"envelope\": {\n      \"attachments\": []\n    },\n    \"revision\": 2\n  },\n  \"body\": {\n    \"summary\": {\n      \"audience\": \"technical\",\n      \"prose\": \"The normal macOS installer provisions a per-user supervisor. The first upgrade stages and qualifies a separate release, then switches the supported legacy entry points to a guarded launcher before touching the running daemon. Existing configuration, data, and running state are preserved through verified rollback.\"\n    },\n    \"hldContextSlice\": {\n      \"frameworkSummary\": \"Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\",\n      \"ownedContracts\": [],\n      \"consumedContracts\": [],\n      \"boundary\": {\n        \"storyId\": \"s1\",\n        \"owns\": [],\n        \"depends\": [],\n        \"internal\": \"Design the approved macOS installer and automatic existing-install migration fix from ISSUE-5d5478c61a25ac8f\"\n      },\n      \"adjacentBoundaries\": [],\n      \"rolloutPhase\": \"standalone\",\n      \"nonFunctional\": {}\n    },\n    \"contractDetails\": {\n      \"surfaceLevel\": \"internal-shared\",\n      \"api\": [\n        {\n          \"name\": \"stageManagedInstallation\",\n          \"signature\": \"stageManagedInstallation(installation: ManagedInstallation, revalidate: () => Promise<void>, legacyCutover?: boolean): Promise<void>\",\n          \"parameters\": [\n            {\n              \"name\": \"installation\",\n              \"type\": \"ManagedInstallation\",\n              \"purpose\": \"Identifies the owned state root, release, runtime and selector.\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"revalidate\",\n              \"type\": \"() => Promise<void>\",\n              \"purpose\": \"Verifies transaction ownership before a write.\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"legacyCutover\",\n              \"type\": \"boolean\",\n              \"purpose\": \"Selects staging for a verified predecessor.\",\n              \"optional\": true\n            }\n          ],\n          \"returns\": {\n            \"type\": \"Promise<void>\",\n            \"meaning\": \"Writes the staged disabled selector and its descriptor only.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"SupervisorLifecycleError\",\n              \"condition\": \"Selector, descriptor, or state root conflicts with the reservation.\"\n            }\n          ],\n          \"preconditions\": [\n            \"The installer controller owns an activation reservation with the explicit start intent and candidate pin. It has verified the canonical root, GUI launchd domain and quiescent fresh state.\"\n          ],\n          \"postconditions\": [\n            \"The installer controller journals descriptor and provisional-selector publication, exact job registration and idle handshake, and optional child readiness. Enable the selector under the reservation before controller admission. Release the reservation only after a verified idle or running result is durable. --no-start leaves an enabled selector and an idle supervisor. Recovery replays an exact matching partial pair or removes only artifacts created by the activation and restores prior absence.\"\n          ]\n        },\n        {\n          \"name\": \"completeLegacyMigration\",\n          \"signature\": \"completeLegacyMigration(gate: InstallationMutationGate, update: UpdateReservation, pins: ManagedUpdatePins): Promise<DaemonUpdateOutcome>\",\n          \"parameters\": [\n            {\n              \"name\": \"gate\",\n              \"type\": \"InstallationMutationGate\",\n              \"purpose\": \"Owns the cutover and recovery reservation.\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"update\",\n              \"type\": \"UpdateReservation\",\n              \"purpose\": \"Identifies verified predecessor, release, fence and desired state.\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"pins\",\n              \"type\": \"ManagedUpdatePins\",\n              \"purpose\": \"Carries the qualified prior and candidate releases.\",\n              \"optional\": false\n            }\n          ],\n          \"returns\": {\n            \"type\": \"Promise<DaemonUpdateOutcome>\",\n            \"meaning\": \"Verified committed cutover, verified rollback, or fenced recovery.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"SupervisorLifecycleError\",\n              \"condition\": \"A release, launch route, exact exit, or recovery state cannot be verified.\"\n            }\n          ],\n          \"preconditions\": [\n            \"Use the migration-capable installer or updater to prepare the release before invoking any shutdown path. Freeze the canonical legacy launch and checkout paths and verify old mutating helpers are absent before cutover. Verify the pinned predecessor and public socket before sending shutdown.\"\n          ],\n          \"postconditions\": [\n            \"Use the journaled predecessor variant for exit, launchd job removal when applicable, and rollback. Publish a provisional selector before bootstrap. Mark terminal success only after exact candidate registration and verified idle or ready state. Retain a fenced reservation after uncertain outcome publication until recovery has read the matching durable outcome.\"\n          ]\n        },\n        {\n          \"name\": \"launchManagedUpdate\",\n          \"signature\": \"launchManagedUpdate(entry: string, args: readonly string[], awaitReply: () => Promise<boolean>): Promise<{ launched: true; updateId: string }>\",\n          \"parameters\": [\n            {\n              \"name\": \"entry\",\n              \"type\": \"string\",\n              \"purpose\": \"Pins the detached controller executable.\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"args\",\n              \"type\": \"readonly string[]\",\n              \"purpose\": \"Carries the owned release and operation inputs.\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"awaitReply\",\n              \"type\": \"() => Promise<boolean>\",\n              \"purpose\": \"Confirms that the update acknowledgement was written.\",\n              \"optional\": false\n            }\n          ],\n          \"returns\": {\n            \"type\": \"Promise<{ launched: true; updateId: string }>\",\n            \"meaning\": \"Returns the admitted update identity while the helper owns completion.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"SupervisorLifecycleError\",\n              \"condition\": \"An update is already active or the helper cannot qualify the candidate.\"\n            }\n          ],\n          \"preconditions\": [\n            \"The running managed daemon routes daemon.update to the transactional helper after candidate preparation and retains its response-written handshake. Shell and TUI update have a local controller route for a stopped installation.\"\n          ],\n          \"postconditions\": [\n            \"Managed updates use the same release preparation and transaction for running and stopped cases. A stopped install stays stopped. Preserve existing IPC result shapes and omit the legacy self-shutdown timer for managed requests.\"\n          ]\n        }\n      ]\n    },\n    \"dataModelChanges\": [\n      {\n        \"entity\": \"InstallationMutationGate activation reservation\",\n        \"change\": \"field-add\",\n        \"details\": \"Persist one activation reservation per state root with exact owner, candidate and explicit start intent. Journal descriptor, provisional selector, exact registration, child admission, readiness and terminal outcome with identities. Previous journals remain decodable. Activation cleanup reverses only receipted owned mutations.\",\n        \"callSites\": [\n          \"src/shared/installation-mutation-gate.ts\",\n          \"src/shared/managed-daemon-installation.ts\",\n          \"src/bin/insrc-daemon-control.ts\"\n        ]\n      },\n      {\n        \"entity\": \"UpdatePredecessor\",\n        \"change\": \"invariant-change\",\n        \"details\": \"Persist a tagged managed, legacy-job, legacy-direct, or legacy-stopped predecessor. All variants bind canonical state root, prior release/runtime and candidate pin, selector baseline or absence, and prior running state. Managed carries supervisor generation. Legacy-job carries descriptor path/hash, verified label, UID, launchd domain, program argv, working directory and RunAtLoad policy. Running legacy-job and legacy-direct carry exact process incarnation, authenticated socket peer and pinned PID/socket identities. Legacy-direct also carries rollback argv, cwd and a release-qualified environment recipe reconstructed from the supported launcher, without persisting credentials. Legacy-stopped carries proof of no live process and either a pinned idle job or verified absence. Decode historical predecessor.legacy as legacy-job and older enabled prior without legacy as managed. Reject unknown or contradictory variants. Persist each observed exit, its drain classification, and ownership-fence evidence before candidate bootstrap.\",\n        \"callSites\": [\n          \"src/shared/installation-mutation-gate.ts\",\n          \"src/daemon/managed-update-recovery.ts\",\n          \"src/daemon/legacy-launch-job.ts\",\n          \"src/daemon/legacy-daemon-cutover.ts\"\n        ]\n      },\n      {\n        \"entity\": \"Release qualification and launcher fence\",\n        \"change\": \"invariant-change\",\n        \"details\": \"One stable launcher location dispatches to one immutable selected release. The updater builds and verifies candidate and rollback copies under owner-private commit-addressed release roots. Preserve the prior executable, native dependencies, runtime path, configuration references and release identity before mutating the old checkout. Release metadata tied to the trusted configured origin and tested release pair supplies writable-format declarations and the exact legacy commit allowlist, including known predecessors that lack a declaration. Local observations establish identity, not qualification. Unqualified or modified prior releases are refused before mutation. Keep immutable pins and journaled launcher exchanges until settlement.\",\n        \"callSites\": [\n          \"scripts/insrc-daemon-install.sh\",\n          \"src/shared/managed-daemon-installation.ts\",\n          \"src/daemon/release-compatibility.ts\",\n          \"src/daemon/managed-update-launch.ts\"\n        ]\n      }\n    ],\n    \"interactionWithShared\": [],\n    \"errorPaths\": {\n      \"errorCases\": [\n        {\n          \"scenario\": \"An older launcher or updater can still mutate the legacy install\",\n          \"detection\": \"Resolve the canonical checkout and every supported launch route. Atomically exchange the canonical checkout entry with a gate-aware dispatcher on the same filesystem while the old daemon is still running. Preserve the displaced checkout separately. Before stopping, verify the dispatcher and archived checkout identities, an absent or owned legacy update marker, and absence of known old shell, detached helper and installer processes bound to the retired root, using verified argv and cwd. Repeat admission after the swap. An unrecognized launch path, unresolved process identity, live old mutator, or exchange failure makes exclusivity unproven.\",\n          \"response\": \"The dispatcher rejects concurrent mutation while cutover owns the reservation. Qualify only predecessors that acquire the shared run-file guard before opening data and whose shipped old commands use the canonical absolute entry. Keep that guard through owned cleanup and transfer it to candidate startup before the legacy route can reacquire it. Refuse when another legacy route cannot be fenced. Preserve or restore the old service before releasing a failed admission.\",\n          \"userImpact\": \"The supported update retries safely after a concurrent operation ends.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Predecessor job or runtime does not match the qualified route\",\n          \"detection\": \"Match the verified launchd registration against its owned descriptor bytes and approved exact argv. Match direct socket peer and executable against the qualified launch recipe. Accept the documented recovery LaunchAgent only with its pinned tsx loader arguments, canonical entry, matching working directory, bounded owned descriptor and passive restart policy.\",\n          \"response\": \"Reject foreign jobs, unknown loaders or args, conflicting restart policy and unverifiable direct rollback settings before disruption. Recheck the descriptor, PID incarnation and run-file identities immediately before each action.\",\n          \"userImpact\": \"The updater reports the unsupported predecessor while preserving the current service.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Exit is unconfirmed or graceful drain cannot be classified\",\n          \"detection\": \"Observe the exact predecessor exit independently of the broker and bind any qualified terminal evidence to the authenticated shutdown request and process incarnation. An RPC acknowledgement, socket close, PID disappearance, or generic log entry alone does not prove a graceful drain.\",\n          \"response\": \"Withhold candidate admission until exact exit is proved. Journal the exit plus graceful, broker-denied, or unknown. Use graceful only for a qualified positive completion signal, broker-denied only for correlated watchdog evidence, and unknown otherwise. Both broker-denied and unknown require a release pair explicitly qualified for crash-consistent reopening. Report the observed classification in the update detail.\",\n          \"userImpact\": \"The user can distinguish a verified shutdown from an exit whose drain could not be confirmed.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Candidate bootstrap or readiness fails before a durable outcome\",\n          \"detection\": \"Registration, startup generation, owned run files, or candidate idle/readiness cannot be verified.\",\n          \"response\": \"Reconcile the candidate under the reservation, restore the prior selector or absence and the canonical launcher, then restore and verify the exact previous job or direct launch only if it was running. Retain a fence when restoration is unverified.\",\n          \"userImpact\": \"Verified rollback restores the previous service state and reports the failed update.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Outcome publication throws or its acknowledgement is lost\",\n          \"detection\": \"Publication fails, or retry sees an active reservation without a verified terminal reply.\",\n          \"response\": \"Keep the reservation. Re-read the exact matching durable outcome through existing recovery. A durable success verifies or completes activation without rollback. A durable rollback verifies the old state. Only a proven uncommitted transaction can unwind. Unknown ownership remains fenced.\",\n          \"userImpact\": \"The updater reports an unconfirmed result until recovery determines the terminal state.\",\n          \"recoverable\": true\n        }\n      ],\n      \"edgeCases\": [\n        {\n          \"input\": \"Fresh --no-start\",\n          \"expected\": \"Register the supervisor, enable the selector and verify idle with no daemon child. Subsequent normal start uses the same supervisor.\"\n        },\n        {\n          \"input\": \"Already-managed update when the daemon is stopped\",\n          \"expected\": \"The external controller prepares and commits the update using supervisor status; no daemon RPC is required. Keep the candidate idle.\"\n        },\n        {\n          \"input\": \"Legacy daemon remains running while the candidate is staged\",\n          \"expected\": \"Build outside the live root, preserve the running predecessor and only then acquire a cutover reservation. Failed fetch, build, or qualification leaves the running install unchanged.\"\n        },\n        {\n          \"input\": \"An unchanged older shell or IDE freshness client invokes legacy restart or daemon.update\",\n          \"expected\": \"An old client cannot acquire new preflight behavior before executing its existing shutdown sequence. The first upgrade is delivered by the current standard installer or the ordinary update action in updated IDE clients. The installer may be rerun on an existing installation without launchctl or file edits. Never present an old acknowledgement as migration success.\"\n        }\n      ],\n      \"invariantsToPreserve\": [\n        {\n          \"text\": \"One state root has at most one daemon process admitted to use its stores.\",\n          \"source\": \"c2\"\n        },\n        {\n          \"text\": \"Committed success is never rolled back because the publication reply was lost.\",\n          \"source\": \"c4\"\n        },\n        {\n          \"text\": \"Linux keeps its current lifecycle and update behavior.\",\n          \"source\": \"c1\"\n        }\n      ]\n    },\n    \"testStrategy\": {\n      \"testLevels\": [\n        {\n          \"level\": \"unit\",\n          \"purpose\": \"Verify admission, qualification, journal compatibility and outcome recovery.\",\n          \"subjects\": [\n            \"Predecessor variants and backward decoding\",\n            \"Explicit fresh activation start intent and owned partial publication\",\n            \"Release provenance, changed bytes and absent legacy declaration\",\n            \"Graceful, broker-denied and unknown drain evidence\",\n            \"Uncertain publication with durable success versus no outcome\"\n          ]\n        },\n        {\n          \"level\": \"integration\",\n          \"purpose\": \"Drive supported entry points and competing legacy operations through the real controller boundaries.\",\n          \"subjects\": [\n            \"Installer and updated CLI, VS Code and JetBrains route matrix\",\n            \"Running managed update IPC and stopped local managed update\",\n            \"Old shell/helper concurrent with canonical launcher exchange and old child attempting to open stores\",\n            \"Startup guard transfer, candidate bootstrap failure, rollback and repeated recovery\",\n            \"Linux normal install, update and restart unchanged\"\n          ]\n        },\n        {\n          \"level\": \"smoke\",\n          \"purpose\": \"Verify actual launchd and daemon state on macOS.\",\n          \"subjects\": [\n            \"Fresh install and verified ordinary restart\",\n            \"Fresh --no-start and later supervisor start\",\n            \"First supported update of a qualified prior build with broker denial\",\n            \"Direct install and passive recovery job with exact loader argv\",\n            \"Verified stopped and running rollback with configuration and store integrity\"\n          ],\n          \"fixturesNeeded\": [\n            \"Disposable macOS state roots and isolated launchd labels\",\n            \"Pinned released predecessors, including the regression and clean-drain cases\"\n          ]\n        }\n      ],\n      \"acceptanceMapping\": [\n        {\n          \"criterionId\": \"ac1\",\n          \"provingTests\": [\n            \"Fresh install and verified ordinary restart\",\n            \"Fresh --no-start and later supervisor start\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac2\",\n          \"provingTests\": [\n            \"Installer and updated CLI, VS Code and JetBrains route matrix\",\n            \"First supported update of a qualified prior build with broker denial\",\n            \"Direct install and passive recovery job with exact loader argv\",\n            \"Old shell/helper concurrent with canonical launcher exchange and old child attempting to open stores\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac3\",\n          \"provingTests\": [\n            \"Running managed update IPC and stopped local managed update\",\n            \"Verified stopped and running rollback with configuration and store integrity\",\n            \"Uncertain publication with durable success versus no outcome\",\n            \"Linux normal install, update and restart unchanged\"\n          ]\n        }\n      ],\n      \"testFramework\": \"Node.js test runner via tsx, installed shell integration fixtures, and real macOS launchd smoke tests in disposable state roots.\"\n    },\n    \"migration\": {\n      \"stateBefore\": \"The installed shell restarts by stopping before preparing a new release, and daemon.update launches its helper and schedules shutdown. The normal installer mutates the checkout in place. The supervisor and transactional update exist but ordinary fresh install and managed update do not provision their inputs. See the s1 discovery bundle.\",\n      \"stateAfter\": \"Current install and update entry points share a migration-capable controller and immutable releases. A supported first upgrade retains the previous release and establishes one verified per-user supervisor. User data remains in the existing state root.\",\n      \"migrationSteps\": [\n        {\n          \"order\": 1,\n          \"action\": \"Use the current standard installer for both fresh installs and first upgrades. Updated VS Code and JetBrains lifecycle Update on unmanaged Darwin dispatch the packaged migration-capable installer in existing-install mode with the configured branch and root. Updated freshness clients route unmanaged Darwin to that same action before sending any daemon.update RPC. A migration-capable shell or TUI starts the same external preflight on ordinary Update. For already-installed binaries that cannot obtain new code before shutdown, the supported first-upgrade action is the current standard installer, including the normal Install action in an updated IDE. No manual service administration is part of that path.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 2,\n          \"action\": \"Fetch the configured origin into a separate staging root, build the candidate, and validate release metadata and runtime. Pin the exact predecessor commit, compatibility record and rollback artifacts before changing any installed pathname. Use the trusted release allowlist for old builds missing an on-disk declaration. Confirm launchd and supported predecessor route. Fresh install enters the activation reservation with explicit start intent.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 3,\n          \"action\": \"For legacy cutover, reserve and atomically replace the canonical installed checkout entry with a gate-aware dispatcher while preserving its original directory identity. Recover either side of the exchange by journaled inode evidence. Recheck for in-flight old helpers, update markers, unsupported launch routes, and mismatched job registrations. The dispatcher has no old executable or mutable checkout target. Refuse when the old launcher or writer cannot be excluded. Keep the prior checkout pinned until rollback is no longer needed.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 4,\n          \"action\": \"Authenticate the running predecessor over the pinned socket and observe exact exit. While the canonical launcher remains fenced, acquire the legacy-compatible run-file guard before cleanup, reconcile only the recorded publications, and retain the guard until a verified supervisor has adopted it for startup. Transfer owner evidence under the same directory identity with no unguarded interval. Remove a verified passive old job after its child exits. Apply the stored outcome policy for graceful, broker-denied, or unknown exit.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 5,\n          \"action\": \"Journal the provisional selector and register the supervisor. Start a child for a normal fresh install or previously running update. Verify idle for --no-start or previously stopped update. Publish the matching durable terminal record before release. An already-managed shell/TUI update uses the external transaction even when stopped, and the running managed RPC uses the detached helper and acknowledgement handshake.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 6,\n          \"action\": \"Recover from interrupted activation or cutover using the matching durable outcome. Restore an uncommitted predecessor by reversing owned mutations, restoring the canonical legacy entry and revalidating the predecessor's exact original launch route. Retain a fence on uncertainty. Do not roll back a verified durable success.\",\n          \"rollbackable\": true\n        }\n      ],\n      \"backwardCompat\": \"Preserve the CLI flags, configured source, IDE IPC result shapes, supported user settings, Linux behavior and historical journal decoding. Existing binaries that stop before they can fetch the migration use the current normal installer for the first upgrade. The canonical installed launcher remains a compatible entry point after migration.\",\n      \"zeroDowntime\": false,\n      \"dataRewriteRequired\": false\n    },\n    \"alternativesConsidered\": [\n      {\n        \"id\": \"a1\",\n        \"name\": \"Stage a bridge before cutover\",\n        \"oneLineSummary\": \"A common updater prepares releases and fences the old entry point before changing ownership.\",\n        \"approach\": \"Reuse the supervisor and outcome transactions with explicit install, stopped legacy, live legacy, and already-managed admissions. Ship the bridge through the normal installer and updated clients.\",\n        \"pros\": [\n          \"Retains the old executable for rollback.\",\n          \"Provides a single place to enforce preflight across current entry points.\"\n        ],\n        \"cons\": [\n          \"Requires a qualified predecessor and a provable cutover fence.\"\n        ],\n        \"costEstimate\": \"M\"\n      },\n      {\n        \"id\": \"a2\",\n        \"name\": \"Migrate at a later start\",\n        \"oneLineSummary\": \"Apply the new supervisor only after the daemon has stopped.\",\n        \"approach\": \"Defer all lifecycle changes to a later start after a verified legacy stop.\",\n        \"pros\": [\n          \"Simplifies handling a stopped installation.\"\n        ],\n        \"cons\": [\n          \"Leaves broker-denied live installations unable to complete ordinary update.\"\n        ],\n        \"costEstimate\": \"M\",\n        \"reasonRejected\": \"Requires a stopped predecessor and can strand an affected user.\"\n      }\n    ],\n    \"chosenAlternative\": \"a1\",\n    \"openQuestions\": [],\n    \"sequenceDefinition\": {\n      \"id\": \"macos-install-cutover\",\n      \"narrative\": \"The success routes cover running and stopped installs. The final messages show the alternative uncommitted failure route and the fence retained when recovery remains uncertain.\",\n      \"participants\": [\n        {\n          \"id\": \"entry\",\n          \"label\": \"Installer / update\",\n          \"description\": \"Stages a release through a supported entry point.\"\n        },\n        {\n          \"id\": \"control\",\n          \"label\": \"Controller\",\n          \"description\": \"Owns the journal and cutover fence.\"\n        },\n        {\n          \"id\": \"old\",\n          \"label\": \"Legacy service\",\n          \"description\": \"Pinned predecessor process and job, if present.\"\n        },\n        {\n          \"id\": \"new\",\n          \"label\": \"Supervisor\",\n          \"description\": \"Owns the candidate daemon or verifies idle.\"\n        },\n        {\n          \"id\": \"child\",\n          \"label\": \"Daemon\",\n          \"description\": \"Candidate serving only after admission.\"\n        }\n      ],\n      \"messages\": [\n        {\n          \"from\": \"entry\",\n          \"to\": \"control\",\n          \"label\": \"Stage and qualify\",\n          \"description\": \"Pin both releases before shutting down the predecessor.\"\n        },\n        {\n          \"from\": \"control\",\n          \"to\": \"control\",\n          \"label\": \"Reserve and fence\",\n          \"description\": \"Journal the entry switch and exclude older writers.\"\n        },\n        {\n          \"from\": \"control\",\n          \"to\": \"old\",\n          \"label\": \"If running: request exit\",\n          \"description\": \"Authenticate the socket and observe exact exit.\"\n        },\n        {\n          \"from\": \"old\",\n          \"to\": \"control\",\n          \"label\": \"Verified exit\",\n          \"description\": \"Keep the launcher fenced and reconcile owned publications.\"\n        },\n        {\n          \"from\": \"control\",\n          \"to\": \"new\",\n          \"label\": \"Publish selector, register job\",\n          \"description\": \"Verify the exact supervisor and admit the requested state.\"\n        },\n        {\n          \"from\": \"new\",\n          \"to\": \"child\",\n          \"label\": \"Running route: start\",\n          \"description\": \"Start one child if requested or previously running.\"\n        },\n        {\n          \"from\": \"child\",\n          \"to\": \"new\",\n          \"label\": \"Running route: readiness\",\n          \"description\": \"Verify authenticated child and publication identities.\"\n        },\n        {\n          \"from\": \"new\",\n          \"to\": \"control\",\n          \"label\": \"Stopped route: verify idle\",\n          \"description\": \"No child is admitted and no daemon readiness is expected.\"\n        },\n        {\n          \"from\": \"control\",\n          \"to\": \"entry\",\n          \"label\": \"Success: commit result\",\n          \"description\": \"Persist verified running or stopped state.\"\n        },\n        {\n          \"from\": \"control\",\n          \"to\": \"new\",\n          \"label\": \"Before commit: reconcile candidate\",\n          \"description\": \"On verified uncommitted failure, stop the exact candidate and remove its owned job.\"\n        },\n        {\n          \"from\": \"control\",\n          \"to\": \"old\",\n          \"label\": \"Rollback: restore prior state\",\n          \"description\": \"Restore the selector or absence, launcher and prior service state.\"\n        },\n        {\n          \"from\": \"control\",\n          \"to\": \"entry\",\n          \"label\": \"Report rollback or keep fence\",\n          \"description\": \"Report restored state only when verified. Retain the fence on ambiguous ownership or terminal publication.\"\n        }\n      ]\n    },\n    \"companions\": [\n      {\n        \"kind\": \"diagram-mermaid\",\n        \"relPath\": \"docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html\",\n        \"title\": \"Sequence diagram\"\n      }\n    ]\n  },\n  \"citations\": [\n    {\n      \"id\": \"c1\",\n      \"kind\": \"code\",\n      \"ref\": \"scripts/insrc-daemon-install.sh\"\n    },\n    {\n      \"id\": \"c2\",\n      \"kind\": \"code\",\n      \"ref\": \"src/shared/managed-daemon-installation.ts\"\n    },\n    {\n      \"id\": \"c3\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/managed-update-recovery.ts\"\n    },\n    {\n      \"id\": \"c4\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/managed-update-transaction.ts\"\n    },\n    {\n      \"id\": \"c5\",\n      \"kind\": \"code\",\n      \"ref\": \"src/bin/insrc-daemon-control.ts\"\n    },\n    {\n      \"id\": \"c6\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/legacy-launch-job.ts\"\n    },\n    {\n      \"id\": \"c7\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/legacy-daemon-cutover.ts\"\n    },\n    {\n      \"id\": \"c8\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/update-runner.ts\"\n    },\n    {\n      \"id\": \"c9\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/admin-handlers.ts\"\n    },\n    {\n      \"id\": \"c10\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/release-compatibility.ts\"\n    },\n    {\n      \"id\": \"c11\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/index.ts\"\n    },\n    {\n      \"id\": \"c12\",\n      \"kind\": \"code\",\n      \"ref\": \"src/shared/daemon-run-files.ts\"\n    },\n    {\n      \"id\": \"c13\",\n      \"kind\": \"code\",\n      \"ref\": \"scripts/daemon-ctl.sh\"\n    },\n    {\n      \"id\": \"c14\",\n      \"kind\": \"prior-artifact\",\n      \"ref\": \"ISSUE-5d5478c61a25ac8f\"\n    }\n  ]\n}\n","document":"<!-- insrc:artifact LLD-5d5478c61a25ac8f-s1 -->\n\n# LLD: STORY-5d5478c61a25ac8f-s1 — Design the approved macOS installer and automatic existing-install migration fix from ISSUE-5d5478c61a25ac8f\n\n## Summary\n\n**Epic:** `enable-managed-daemon-lifecycle-macos-install`\n**HLD base run:** `wf-1794414767042-nsonkp`\n**HLD effective hash:** `72b5eb5ef17c...`\n\nThe normal macOS installer provisions a per-user supervisor. The first upgrade stages and qualifies a separate release, then switches the supported legacy entry points to a guarded launcher before touching the running daemon. Existing configuration, data, and running state are preserved through verified rollback.\n\n## Contents\n\n1. [HLD context](#1-hld-context)\n2. [Contract details](#2-contract-details)\n3. [Data model changes](#3-data-model-changes)\n4. [Diagrams](#4-diagrams)\n5. [Error paths](#5-error-paths)\n6. [Test strategy](#6-test-strategy)\n7. [Migration](#7-migration)\n8. [Alternatives considered](#8-alternatives-considered)\n9. [References](#9-references)\n\n## 1. HLD context\n\n**Framework:** Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\n**Rollout phase:** standalone\n\n## 2. Contract details\n\n**Surface level:** internal-shared\n\n### 2.1 `stageManagedInstallation`\n\n```typescript\nstageManagedInstallation(installation: ManagedInstallation, revalidate: () => Promise<void>, legacyCutover?: boolean): Promise<void>\n```\n\n**Parameters:**\n- `installation: ManagedInstallation` — Identifies the owned state root, release, runtime and selector.\n- `revalidate: () => Promise<void>` — Verifies transaction ownership before a write.\n- `legacyCutover: boolean` _(optional)_ — Selects staging for a verified predecessor.\n\n**Returns:** `Promise<void>` — Writes the staged disabled selector and its descriptor only.\n\n**Errors:**\n- `SupervisorLifecycleError` when Selector, descriptor, or state root conflicts with the reservation.\n\n**Preconditions:**\n- The installer controller owns an activation reservation with the explicit start intent and candidate pin. It has verified the canonical root, GUI launchd domain and quiescent fresh state.\n\n**Postconditions:**\n- The installer controller journals descriptor and provisional-selector publication, exact job registration and idle handshake, and optional child readiness. Enable the selector under the reservation before controller admission. Release the reservation only after a verified idle or running result is durable. --no-start leaves an enabled selector and an idle supervisor. Recovery replays an exact matching partial pair or removes only artifacts created by the activation and restores prior absence.\n\n### 2.2 `completeLegacyMigration`\n\n```typescript\ncompleteLegacyMigration(gate: InstallationMutationGate, update: UpdateReservation, pins: ManagedUpdatePins): Promise<DaemonUpdateOutcome>\n```\n\n**Parameters:**\n- `gate: InstallationMutationGate` — Owns the cutover and recovery reservation.\n- `update: UpdateReservation` — Identifies verified predecessor, release, fence and desired state.\n- `pins: ManagedUpdatePins` — Carries the qualified prior and candidate releases.\n\n**Returns:** `Promise<DaemonUpdateOutcome>` — Verified committed cutover, verified rollback, or fenced recovery.\n\n**Errors:**\n- `SupervisorLifecycleError` when A release, launch route, exact exit, or recovery state cannot be verified.\n\n**Preconditions:**\n- Use the migration-capable installer or updater to prepare the release before invoking any shutdown path. Freeze the canonical legacy launch and checkout paths and verify old mutating helpers are absent before cutover. Verify the pinned predecessor and public socket before sending shutdown.\n\n**Postconditions:**\n- Use the journaled predecessor variant for exit, launchd job removal when applicable, and rollback. Publish a provisional selector before bootstrap. Mark terminal success only after exact candidate registration and verified idle or ready state. Retain a fenced reservation after uncertain outcome publication until recovery has read the matching durable outcome.\n\n### 2.3 `launchManagedUpdate`\n\n```typescript\nlaunchManagedUpdate(entry: string, args: readonly string[], awaitReply: () => Promise<boolean>): Promise<{ launched: true; updateId: string }>\n```\n\n**Parameters:**\n- `entry: string` — Pins the detached controller executable.\n- `args: readonly string[]` — Carries the owned release and operation inputs.\n- `awaitReply: () => Promise<boolean>` — Confirms that the update acknowledgement was written.\n\n**Returns:** `Promise<{ launched: true; updateId: string }>` — Returns the admitted update identity while the helper owns completion.\n\n**Errors:**\n- `SupervisorLifecycleError` when An update is already active or the helper cannot qualify the candidate.\n\n**Preconditions:**\n- The running managed daemon routes daemon.update to the transactional helper after candidate preparation and retains its response-written handshake. Shell and TUI update have a local controller route for a stopped installation.\n\n**Postconditions:**\n- Managed updates use the same release preparation and transaction for running and stopped cases. A stopped install stays stopped. Preserve existing IPC result shapes and omit the legacy self-shutdown timer for managed requests.\n\n## 3. Data model changes\n\n### 3.1 `InstallationMutationGate activation reservation` — field-add\n\nPersist one activation reservation per state root with exact owner, candidate and explicit start intent. Journal descriptor, provisional selector, exact registration, child admission, readiness and terminal outcome with identities. Previous journals remain decodable. Activation cleanup reverses only receipted owned mutations.\n\n**Call sites:**\n- `src/shared/installation-mutation-gate.ts`\n- `src/shared/managed-daemon-installation.ts`\n- `src/bin/insrc-daemon-control.ts`\n\n### 3.2 `UpdatePredecessor` — invariant-change\n\nPersist a tagged managed, legacy-job, legacy-direct, or legacy-stopped predecessor. All variants bind canonical state root, prior release/runtime and candidate pin, selector baseline or absence, and prior running state. Managed carries supervisor generation. Legacy-job carries descriptor path/hash, verified label, UID, launchd domain, program argv, working directory and RunAtLoad policy. Running legacy-job and legacy-direct carry exact process incarnation, authenticated socket peer and pinned PID/socket identities. Legacy-direct also carries rollback argv, cwd and a release-qualified environment recipe reconstructed from the supported launcher, without persisting credentials. Legacy-stopped carries proof of no live process and either a pinned idle job or verified absence. Decode historical predecessor.legacy as legacy-job and older enabled prior without legacy as managed. Reject unknown or contradictory variants. Persist each observed exit, its drain classification, and ownership-fence evidence before candidate bootstrap.\n\n**Call sites:**\n- `src/shared/installation-mutation-gate.ts`\n- `src/daemon/managed-update-recovery.ts`\n- `src/daemon/legacy-launch-job.ts`\n- `src/daemon/legacy-daemon-cutover.ts`\n\n### 3.3 `Release qualification and launcher fence` — invariant-change\n\nOne stable launcher location dispatches to one immutable selected release. The updater builds and verifies candidate and rollback copies under owner-private commit-addressed release roots. Preserve the prior executable, native dependencies, runtime path, configuration references and release identity before mutating the old checkout. Release metadata tied to the trusted configured origin and tested release pair supplies writable-format declarations and the exact legacy commit allowlist, including known predecessors that lack a declaration. Local observations establish identity, not qualification. Unqualified or modified prior releases are refused before mutation. Keep immutable pins and journaled launcher exchanges until settlement.\n\n**Call sites:**\n- `scripts/insrc-daemon-install.sh`\n- `src/shared/managed-daemon-installation.ts`\n- `src/daemon/release-compatibility.ts`\n- `src/daemon/managed-update-launch.ts`\n\n## 4. Diagrams\n\n- [Sequence diagram](docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html)\n\n## 5. Error paths\n\n**Error cases**\n\n- **An older launcher or updater can still mutate the legacy install** (recoverable)\n  - Detection: Resolve the canonical checkout and every supported launch route. Atomically exchange the canonical checkout entry with a gate-aware dispatcher on the same filesystem while the old daemon is still running. Preserve the displaced checkout separately. Before stopping, verify the dispatcher and archived checkout identities, an absent or owned legacy update marker, and absence of known old shell, detached helper and installer processes bound to the retired root, using verified argv and cwd. Repeat admission after the swap. An unrecognized launch path, unresolved process identity, live old mutator, or exchange failure makes exclusivity unproven.\n  - Response: The dispatcher rejects concurrent mutation while cutover owns the reservation. Qualify only predecessors that acquire the shared run-file guard before opening data and whose shipped old commands use the canonical absolute entry. Keep that guard through owned cleanup and transfer it to candidate startup before the legacy route can reacquire it. Refuse when another legacy route cannot be fenced. Preserve or restore the old service before releasing a failed admission.\n  - User impact: The supported update retries safely after a concurrent operation ends.\n- **Predecessor job or runtime does not match the qualified route** (recoverable)\n  - Detection: Match the verified launchd registration against its owned descriptor bytes and approved exact argv. Match direct socket peer and executable against the qualified launch recipe. Accept the documented recovery LaunchAgent only with its pinned tsx loader arguments, canonical entry, matching working directory, bounded owned descriptor and passive restart policy.\n  - Response: Reject foreign jobs, unknown loaders or args, conflicting restart policy and unverifiable direct rollback settings before disruption. Recheck the descriptor, PID incarnation and run-file identities immediately before each action.\n  - User impact: The updater reports the unsupported predecessor while preserving the current service.\n- **Exit is unconfirmed or graceful drain cannot be classified** (recoverable)\n  - Detection: Observe the exact predecessor exit independently of the broker and bind any qualified terminal evidence to the authenticated shutdown request and process incarnation. An RPC acknowledgement, socket close, PID disappearance, or generic log entry alone does not prove a graceful drain.\n  - Response: Withhold candidate admission until exact exit is proved. Journal the exit plus graceful, broker-denied, or unknown. Use graceful only for a qualified positive completion signal, broker-denied only for correlated watchdog evidence, and unknown otherwise. Both broker-denied and unknown require a release pair explicitly qualified for crash-consistent reopening. Report the observed classification in the update detail.\n  - User impact: The user can distinguish a verified shutdown from an exit whose drain could not be confirmed.\n- **Candidate bootstrap or readiness fails before a durable outcome** (recoverable)\n  - Detection: Registration, startup generation, owned run files, or candidate idle/readiness cannot be verified.\n  - Response: Reconcile the candidate under the reservation, restore the prior selector or absence and the canonical launcher, then restore and verify the exact previous job or direct launch only if it was running. Retain a fence when restoration is unverified.\n  - User impact: Verified rollback restores the previous service state and reports the failed update.\n- **Outcome publication throws or its acknowledgement is lost** (recoverable)\n  - Detection: Publication fails, or retry sees an active reservation without a verified terminal reply.\n  - Response: Keep the reservation. Re-read the exact matching durable outcome through existing recovery. A durable success verifies or completes activation without rollback. A durable rollback verifies the old state. Only a proven uncommitted transaction can unwind. Unknown ownership remains fenced.\n  - User impact: The updater reports an unconfirmed result until recovery determines the terminal state.\n\n**Edge cases**\n\n| Input | Expected |\n| :--- | :--- |\n| Fresh --no-start | Register the supervisor, enable the selector and verify idle with no daemon child. Subsequent normal start uses the same supervisor. |\n| Already-managed update when the daemon is stopped | The external controller prepares and commits the update using supervisor status; no daemon RPC is required. Keep the candidate idle. |\n| Legacy daemon remains running while the candidate is staged | Build outside the live root, preserve the running predecessor and only then acquire a cutover reservation. Failed fetch, build, or qualification leaves the running install unchanged. |\n| An unchanged older shell or IDE freshness client invokes legacy restart or daemon.update | An old client cannot acquire new preflight behavior before executing its existing shutdown sequence. The first upgrade is delivered by the current standard installer or the ordinary update action in updated IDE clients. The installer may be rerun on an existing installation without launchctl or file edits. Never present an old acknowledgement as migration success. |\n\n**Invariants to preserve**\n\n- One state root has at most one daemon process admitted to use its stores. [[c2]]\n- Committed success is never rolled back because the publication reply was lost. [[c4]]\n- Linux keeps its current lifecycle and update behavior. [[c1]]\n\n## 6. Test strategy\n\n**Test framework:** `Node.js test runner via tsx, installed shell integration fixtures, and real macOS launchd smoke tests in disposable state roots.`\n\n**Test levels**\n\n- **unit** — Verify admission, qualification, journal compatibility and outcome recovery.\n  - Subjects: `Predecessor variants and backward decoding`, `Explicit fresh activation start intent and owned partial publication`, `Release provenance, changed bytes and absent legacy declaration`, `Graceful, broker-denied and unknown drain evidence`, `Uncertain publication with durable success versus no outcome`\n- **integration** — Drive supported entry points and competing legacy operations through the real controller boundaries.\n  - Subjects: `Installer and updated CLI, VS Code and JetBrains route matrix`, `Running managed update IPC and stopped local managed update`, `Old shell/helper concurrent with canonical launcher exchange and old child attempting to open stores`, `Startup guard transfer, candidate bootstrap failure, rollback and repeated recovery`, `Linux normal install, update and restart unchanged`\n- **smoke** — Verify actual launchd and daemon state on macOS.\n  - Subjects: `Fresh install and verified ordinary restart`, `Fresh --no-start and later supervisor start`, `First supported update of a qualified prior build with broker denial`, `Direct install and passive recovery job with exact loader argv`, `Verified stopped and running rollback with configuration and store integrity`\n  - Fixtures: `Disposable macOS state roots and isolated launchd labels`, `Pinned released predecessors, including the regression and clean-drain cases`\n\n**Acceptance mapping**\n\n| Criterion | Proving tests |\n| :--- | :--- |\n| `ac1` | `Fresh install and verified ordinary restart`, `Fresh --no-start and later supervisor start` |\n| `ac2` | `Installer and updated CLI, VS Code and JetBrains route matrix`, `First supported update of a qualified prior build with broker denial`, `Direct install and passive recovery job with exact loader argv`, `Old shell/helper concurrent with canonical launcher exchange and old child attempting to open stores` |\n| `ac3` | `Running managed update IPC and stopped local managed update`, `Verified stopped and running rollback with configuration and store integrity`, `Uncertain publication with durable success versus no outcome`, `Linux normal install, update and restart unchanged` |\n\n## 7. Migration\n\n**State before:** The installed shell restarts by stopping before preparing a new release, and daemon.update launches its helper and schedules shutdown. The normal installer mutates the checkout in place. The supervisor and transactional update exist but ordinary fresh install and managed update do not provision their inputs. See the s1 discovery bundle.\n\n**State after:** Current install and update entry points share a migration-capable controller and immutable releases. A supported first upgrade retains the previous release and establishes one verified per-user supervisor. User data remains in the existing state root.\n\n**Zero downtime:** no — **Data rewrite:** no\n\n**Steps**\n\n1. Use the current standard installer for both fresh installs and first upgrades. Updated VS Code and JetBrains lifecycle Update on unmanaged Darwin dispatch the packaged migration-capable installer in existing-install mode with the configured branch and root. Updated freshness clients route unmanaged Darwin to that same action before sending any daemon.update RPC. A migration-capable shell or TUI starts the same external preflight on ordinary Update. For already-installed binaries that cannot obtain new code before shutdown, the supported first-upgrade action is the current standard installer, including the normal Install action in an updated IDE. No manual service administration is part of that path. — ↩ rollbackable\n2. Fetch the configured origin into a separate staging root, build the candidate, and validate release metadata and runtime. Pin the exact predecessor commit, compatibility record and rollback artifacts before changing any installed pathname. Use the trusted release allowlist for old builds missing an on-disk declaration. Confirm launchd and supported predecessor route. Fresh install enters the activation reservation with explicit start intent. — ↩ rollbackable\n3. For legacy cutover, reserve and atomically replace the canonical installed checkout entry with a gate-aware dispatcher while preserving its original directory identity. Recover either side of the exchange by journaled inode evidence. Recheck for in-flight old helpers, update markers, unsupported launch routes, and mismatched job registrations. The dispatcher has no old executable or mutable checkout target. Refuse when the old launcher or writer cannot be excluded. Keep the prior checkout pinned until rollback is no longer needed. — ↩ rollbackable\n4. Authenticate the running predecessor over the pinned socket and observe exact exit. While the canonical launcher remains fenced, acquire the legacy-compatible run-file guard before cleanup, reconcile only the recorded publications, and retain the guard until a verified supervisor has adopted it for startup. Transfer owner evidence under the same directory identity with no unguarded interval. Remove a verified passive old job after its child exits. Apply the stored outcome policy for graceful, broker-denied, or unknown exit. — ↩ rollbackable\n5. Journal the provisional selector and register the supervisor. Start a child for a normal fresh install or previously running update. Verify idle for --no-start or previously stopped update. Publish the matching durable terminal record before release. An already-managed shell/TUI update uses the external transaction even when stopped, and the running managed RPC uses the detached helper and acknowledgement handshake. — ↩ rollbackable\n6. Recover from interrupted activation or cutover using the matching durable outcome. Restore an uncommitted predecessor by reversing owned mutations, restoring the canonical legacy entry and revalidating the predecessor's exact original launch route. Retain a fence on uncertainty. Do not roll back a verified durable success. — ↩ rollbackable\n\n**Backward compat:** Preserve the CLI flags, configured source, IDE IPC result shapes, supported user settings, Linux behavior and historical journal decoding. Existing binaries that stop before they can fetch the migration use the current normal installer for the first upgrade. The canonical installed launcher remains a compatible entry point after migration.\n\n## 8. Alternatives considered\n\n### 8.1 a1: Stage a bridge before cutover — **CHOSEN**\n\nA common updater prepares releases and fences the old entry point before changing ownership.\n\nReuse the supervisor and outcome transactions with explicit install, stopped legacy, live legacy, and already-managed admissions. Ship the bridge through the normal installer and updated clients.\n\n### 8.2 a2: Migrate at a later start\n\nApply the new supervisor only after the daemon has stopped.\n\nDefer all lifecycle changes to a later start after a verified legacy stop.\n\n**Rejected because:** Requires a stopped predecessor and can strand an affected user.\n\n## 9. References\n\n- **[[c1]]** `code` `scripts/insrc-daemon-install.sh`\n- **[[c2]]** `code` `src/shared/managed-daemon-installation.ts`\n- **[[c3]]** `code` `src/daemon/managed-update-recovery.ts`\n- **[[c4]]** `code` `src/daemon/managed-update-transaction.ts`\n- **[[c5]]** `code` `src/bin/insrc-daemon-control.ts`\n- **[[c6]]** `code` `src/daemon/legacy-launch-job.ts`\n- **[[c7]]** `code` `src/daemon/legacy-daemon-cutover.ts`\n- **[[c8]]** `code` `src/daemon/update-runner.ts`\n- **[[c9]]** `code` `src/daemon/admin-handlers.ts`\n- **[[c10]]** `code` `src/daemon/release-compatibility.ts`\n- **[[c11]]** `code` `src/daemon/index.ts`\n- **[[c12]]** `code` `src/shared/daemon-run-files.ts`\n- **[[c13]]** `code` `scripts/daemon-ctl.sh`\n- **[[c14]]** `prior-artifact` `ISSUE-5d5478c61a25ac8f`\n"},"capturedAt":"2026-11-11T16:36:16.984Z"},"inventory":{"units":[{"id":"/body/summary","selector":"/body/summary","title":"summary","kind":"section"},{"id":"/body/hldContextSlice","selector":"/body/hldContextSlice","title":"hldContextSlice","kind":"section"},{"id":"/body/contractDetails","selector":"/body/contractDetails","title":"contractDetails","kind":"section"},{"id":"/body/dataModelChanges","selector":"/body/dataModelChanges","title":"dataModelChanges","kind":"section"},{"id":"/body/interactionWithShared","selector":"/body/interactionWithShared","title":"interactionWithShared","kind":"section"},{"id":"/body/errorPaths","selector":"/body/errorPaths","title":"errorPaths","kind":"section"},{"id":"/body/testStrategy","selector":"/body/testStrategy","title":"testStrategy","kind":"section"},{"id":"/body/migration","selector":"/body/migration","title":"migration","kind":"section"},{"id":"/body/alternativesConsidered","selector":"/body/alternativesConsidered","title":"alternativesConsidered","kind":"section"},{"id":"/body/chosenAlternative","selector":"/body/chosenAlternative","title":"chosenAlternative","kind":"section"},{"id":"/body/openQuestions","selector":"/body/openQuestions","title":"openQuestions","kind":"section"},{"id":"/body/sequenceDefinition","selector":"/body/sequenceDefinition","title":"sequenceDefinition","kind":"visual"},{"id":"/body/companions","selector":"/body/companions","title":"companions","kind":"visual"},{"id":"/body/alternativesConsidered/0","selector":"/body/alternativesConsidered/0","title":"a1","kind":"requirement"},{"id":"/body/alternativesConsidered/1","selector":"/body/alternativesConsidered/1","title":"a2","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/0","selector":"/body/sequenceDefinition/participants/0","title":"entry","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/1","selector":"/body/sequenceDefinition/participants/1","title":"control","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/2","selector":"/body/sequenceDefinition/participants/2","title":"old","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/3","selector":"/body/sequenceDefinition/participants/3","title":"new","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/4","selector":"/body/sequenceDefinition/participants/4","title":"child","kind":"requirement"},{"id":"/citations/0","selector":"/citations/0","title":"Citation 1","kind":"citation"},{"id":"/citations/1","selector":"/citations/1","title":"Citation 2","kind":"citation"},{"id":"/citations/2","selector":"/citations/2","title":"Citation 3","kind":"citation"},{"id":"/citations/3","selector":"/citations/3","title":"Citation 4","kind":"citation"},{"id":"/citations/4","selector":"/citations/4","title":"Citation 5","kind":"citation"},{"id":"/citations/5","selector":"/citations/5","title":"Citation 6","kind":"citation"},{"id":"/citations/6","selector":"/citations/6","title":"Citation 7","kind":"citation"},{"id":"/citations/7","selector":"/citations/7","title":"Citation 8","kind":"citation"},{"id":"/citations/8","selector":"/citations/8","title":"Citation 9","kind":"citation"},{"id":"/citations/9","selector":"/citations/9","title":"Citation 10","kind":"citation"},{"id":"/citations/10","selector":"/citations/10","title":"Citation 11","kind":"citation"},{"id":"/citations/11","selector":"/citations/11","title":"Citation 12","kind":"citation"},{"id":"/citations/12","selector":"/citations/12","title":"Citation 13","kind":"citation"},{"id":"/citations/13","selector":"/citations/13","title":"Citation 14","kind":"citation"},{"id":"document:line:25","selector":"document:line:25","title":"1. HLD context","kind":"section"},{"id":"document:line:131","selector":"document:line:131","title":"4. Diagrams","kind":"section"}]},"completedChunks":[{"chunkId":"install","status":"incomplete","summary":"The revision addresses the substance of install-01 through install-04: supported first-upgrade routes, immutable release provisioning, controller-owned activation, and running/stopped managed updates are now described. One managed-update acknowledgement ordering defect remains. Diagram source was inspected, but rendering verification was unavailable.","findings":[{"id":"install-05","severity":"MED","location":"LLD.md:78-98; /body/contractDetails/api/2","message":"The running managed update prepares the candidate before launching the transactional helper and returning its acknowledgement. Candidate preparation includes fetching, dependency installation and building, which can exceed the existing client’s 20-second reply deadline. That deadline destroys the socket, causing the response-written handshake to fail and preventing the helper from proceeding. Moving preparation into the helper before its reservation acknowledgement also conflicts with the existing 15-second launch timeout. Define a bounded launch acknowledgement followed by detached preparation before any shutdown, or explicitly revise the client/helper timing contract. Add coverage where preparation exceeds both current deadlines; otherwise ordinary managed updates can repeatedly cancel on slow builds.","evidenceReferences":["docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:95","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:208","src/shared/ipc-client.ts:77-100,244","src/daemon/managed-update-launch.ts:20,40-55,78-88","src/daemon/server.ts:395-418","vscode-plugin/src/freshness/daemon-freshness.ts:202-217"]}],"inspectedReferences":["/body/summary","/body/hldContextSlice","document:line:25","/body/contractDetails","/body/interactionWithShared","/body/alternativesConsidered","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/chosenAlternative","/body/openQuestions","/body/errorPaths","/body/testStrategy","/body/migration","/citations/0","/citations/1","/citations/4","/citations/7","/citations/8","/citations/9","/citations/12","/citations/13","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md",".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json",".insrc/artifacts/ISSUE-5d5478c61a25ac8f.json",".insrc/tmp/design-review/macos-installer-migration-5d5478c6.json: prior install-01 through install-04 feedback","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html: Mermaid source and rendering shell","scripts/insrc-daemon-install.sh","scripts/daemon-ctl.sh","src/shared/managed-daemon-installation.ts","src/shared/update-source.ts","src/shared/ipc-client.ts:65-105,244-245","src/bin/insrc-daemon-control.ts","src/daemon/managed-update-launch.ts","src/daemon/release-compatibility.ts","src/daemon/managed-update-recovery.ts:264-350","src/daemon/admin-handlers.ts:97-122","src/daemon/update-runner.ts:135-200","src/daemon/server.ts:380-445","src/cli/services/maintenance.ts:108-263,373-420","vscode-plugin/src/daemon/controller.ts","vscode-plugin/src/freshness/daemon-freshness.ts:175-245","jetbrains-plugin/src/main/kotlin/ai/insors/insrc/jetbrains/lifecycle/DaemonLifecycleCommandRunner.kt","jetbrains-plugin/src/main/kotlin/ai/insors/insrc/jetbrains/daemon/DaemonGateway.kt:1389-1410"],"limitations":["Could not visually verify docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html: opening the artifact returned 'The browser access host is unavailable'. Its Mermaid source was inspected, but no actual rendering was verified."],"advice":["Make the configured-source route tests assert custom repository URL, branch and installation root preservation across installer, shell, TUI and both IDE entry points."]},{"chunkId":"cutover","status":"changes_requested","summary":"The revised design addresses predecessor variants, release qualification, drain uncertainty and durable-success recovery. Two material gaps remain: the controller-to-supervisor guard handoff lacks an implementable recovery contract, and rollback does not preserve a previously registered but stopped legacy job.","findings":[{"id":"cutover-r2-01","severity":"MED","location":"/body/migration/steps/3; LLD.md:210; /body/errorPaths/errorCases/0","message":"The uninterrupted guard handoff is stated as an invariant but has no adoption interface or durable transition contract. Existing quiescence checks reject any run-file guard, SupervisorRunFiles.prepare creates a new guard and rejects an existing one, and child borrowing requires the owner record to name its supervisor. Keeping the controller's guard therefore prevents the existing handoff/start path; releasing it permits the excluded legacy startup race. Define authenticated adoption, owner-record and local-handle invalidation, journaled transfer evidence, and recovery when either process dies before or after adoption. Include settlement for a stopped update, where no child startup occurs, and guard disposition before legacy rollback. Test failures on both sides of each transfer boundary.","evidenceReferences":["docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:140-141","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:209-212","src/shared/daemon-run-files.ts:65-112","src/shared/managed-daemon-installation.ts:requireQuiescentInstallation","src/daemon/supervisor-run-files.ts:49-110","src/bin/insrc-daemon-supervisor.ts:allowInitialStart","src/daemon/managed-update-handoff.ts:effects.inspectStores and stageManagedCandidate"]},{"id":"cutover-r2-02","severity":"MED","location":"/body/errorPaths/errorCases/3/response; LLD.md:153; /body/dataModelChanges/1","message":"Rollback restores the previous job or direct launch only if it was running, although legacy-stopped explicitly permits a pinned idle job. After that job is removed for migration, this rule leaves a previously registered stopped installation without its job. Restoring registration must be separate from deciding whether to launch a child. Also retain or replace the existing refusal of a stopped job with RunAtLoad=true: bootstrapping its exact descriptor starts a daemon and violates stopped-state preservation. Specify these branches and cover rollback after job removal for stopped predecessors with both descriptor policies.","evidenceReferences":["docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:113","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:151-154","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md:Fix intent","src/bin/insrc-daemon-control.ts:migrate stopped-install RunAtLoad refusal","src/daemon/legacy-launch-job.ts:141-175","src/daemon/managed-update-recovery.ts:completeLegacyMigration"]}],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/body/interactionWithShared","/body/errorPaths","/body/migration","/body/testStrategy","/citations/1","/citations/2","/citations/3","/citations/4","/citations/5","/citations/6","/citations/7","/citations/8","/citations/9","/citations/10","/citations/11","/citations/12","/citations/13","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md",".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json",".insrc/tmp/design-review/macos-installer-migration-5d5478c6.json: prior cutover-01 through cutover-04 and current chunk inventory","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md","docs/standalone/restore-reliable-daemon-restart-macos-E202611103992d2e1/S001/LLD.md",".insrc/artifacts/ISSUE-3992d2e1e26124dc.json","src/shared/installation-mutation-gate.ts","src/shared/managed-daemon-installation.ts","src/shared/daemon-run-files.ts","src/daemon/managed-update-recovery.ts","src/daemon/managed-update-transaction.ts","src/daemon/managed-update-handoff.ts","src/daemon/legacy-launch-job.ts","src/daemon/legacy-daemon-cutover.ts","src/daemon/release-compatibility.ts","src/bin/insrc-daemon-control.ts","src/bin/insrc-daemon-supervisor.ts","src/daemon/supervisor-run-files.ts","src/daemon/managed-daemon-lifecycle.ts","src/daemon/run-file-ownership.ts","src/daemon/index.ts: startup, store opening and readiness","src/daemon/server.ts: guarded close","src/daemon/update-runner.ts: legacy update launch","src/daemon/admin-handlers.ts: shutdown and update routing","src/daemon/shutdown.ts","scripts/daemon-ctl.sh","src/daemon/__tests__/legacy-daemon-cutover.test.ts"],"limitations":[],"advice":["Expand the proposed recovery tests into a predecessor-by-failure-boundary matrix, including interrupted checkout exchange, guard adoption, candidate registration, provisional selection and terminal publication.","Document the concrete supported direct-launch environment recipe and accepted recovery-job loader argv alongside the qualification metadata so admission fixtures can verify exact values."]},{"chunkId":"visuals","status":"incomplete","summary":"Inspected every assigned selector, all five participant descriptions, the generated companion, issue requirements and relevant lifecycle code. The revised sequence adds outcome labels but still presents mutually exclusive routes sequentially. The companion hyperlink remains broken. Actual rendering could not be verified.","findings":[{"id":"visuals-03","severity":"MED","location":"/body/sequenceDefinition/messages/2–11; sequence-diagram.html embedded sequenceDiagram","message":"The revised labels partially address visuals-01, but the generated Mermaid still contains one linear sequence with no conditional or alternative structure. It shows running startup/readiness followed by stopped-state idle verification, then committed success followed by candidate reconciliation and rollback. It also leaves verified predecessor exit unconditional after a conditional exit request. These mutually exclusive routes contradict the lifecycle contract, particularly the prohibition on rolling back durable success. Represent conditional predecessor exit, running versus stopped completion, and uncommitted failure versus committed success as explicit alternatives in the generated visual; distinguish uncertain publication recovery before deciding whether rollback is permitted.","evidenceReferences":[".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json: /body/sequenceDefinition/messages/2–11","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html: embedded sequenceDiagram contains all twelve arrows without opt/alt/else blocks","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:151–157,164–165,210–212","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md: Fix intent","src/daemon/managed-update-recovery.ts:96–108 requireReady","src/daemon/managed-update-transaction.ts: finish, settleManagedUpdate, recoverManagedTransaction"]},{"id":"visuals-04","severity":"LOW","location":"docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:133","message":"The hyperlink still repeats the repository-relative document directory. Resolving it relative to LLD.md produces a nonexistent nested path, although the canonical companion exists. This leaves visuals-02 unresolved. Use sequence-diagram.html as the document-relative target or a supported repository-root link.","evidenceReferences":["docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:133",".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json: /body/companions/0/relPath","Filesystem verification: canonical companion exists; document-relative resolution of the current hyperlink does not"]}],"inspectedReferences":["/body/sequenceDefinition","/body/sequenceDefinition/participants/0","/body/sequenceDefinition/participants/1","/body/sequenceDefinition/participants/2","/body/sequenceDefinition/participants/3","/body/sequenceDefinition/participants/4","/body/companions","document:line:131","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md",".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json",".insrc/tmp/design-review/macos-installer-migration-5d5478c6.json","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html","src/daemon/managed-update-recovery.ts: requireReady, completeLegacyMigration, Rollback candidate reconciliation","src/daemon/managed-update-transaction.ts","src/daemon/legacy-daemon-cutover.ts","src/shared/managed-daemon-installation.ts: registerManagedJob, removeManagedJob"],"limitations":["Actual rendering of docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html remains unverified: opening the companion through the browser tool returned 'The browser access host is unavailable'. Source and generated Mermaid were inspected, but layout, clipping and successful runtime rendering were not verified."],"advice":["The participant descriptions distinguish controller, predecessor, supervisor and child responsibilities, but descriptions are omitted from the generated Mermaid. Consider separating launchd from the predecessor and supervisor, showing registration/removal against launchd and exact-exit observation as a controller operation. Currently 'Verified exit' appears as a predecessor response, and 'register job' targets the supervisor itself.","The generated participant and message labels agree with the authored source, and the canonical companion path is correct. A corrected sequence together with the existing ownership/cardinality prose is sufficient; no additional ERD or UX artifact is necessary for these interaction changes."]},{"chunkId":"consistency","status":"incomplete","summary":"Reconciled all three accepted fresh substantive reviews against the originating ISSUE and current canonical/live documents. All assigned substantive selectors have coverage declarations. Remaining concerns are already recorded in install-05, cutover-r2-01, cutover-r2-02, visuals-03 and visuals-04; no additional finding is duplicated here. Mandatory rendering verification remains outstanding, preventing a complete assessment.","findings":[],"inspectedReferences":["/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/macos-installer-migration-5d5478c6.json",".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json",".insrc/artifacts/ISSUE-5d5478c61a25ac8f.json","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html: embedded Mermaid and companion metadata","docs/standalone/restore-reliable-daemon-restart-macos-E202611103992d2e1/S001/LLD.md: sections 3.3, 3.4 and 7","src/shared/installation-mutation-gate.ts: UpdatePredecessor, validPredecessor and recovery classification","src/shared/daemon-run-files.ts","src/shared/managed-daemon-installation.ts: stageManagedInstallation","src/shared/ipc-client.ts: RPC deadlines and update client","src/daemon/managed-update-launch.ts","src/daemon/managed-update-recovery.ts: completeLegacyMigration and recoverInstalledManagedUpdate","src/daemon/managed-update-transaction.ts","src/daemon/release-compatibility.ts","src/daemon/supervisor-run-files.ts","src/daemon/legacy-launch-job.ts","src/daemon/legacy-daemon-cutover.ts","src/daemon/admin-handlers.ts: update routing","src/daemon/server.ts: update response-written handshake","src/daemon/shutdown.ts: watchdog failure and drain completion","src/bin/insrc-daemon-control.ts: staging and legacy migration"],"limitations":["Mandatory actual rendering verification of docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html remains outstanding. Accepted attempt-2 install and visuals feedback records an unavailable browser access host. This consistency inspection verified embedded source and canonical agreement, but did not establish runtime rendering, layout or clipping. Those fresh chunks remain incomplete; their earlier findings are carried rather than declared resolved."],"advice":["Address the existing fresh findings without duplicating them: install-05 concerns preparation versus acknowledgement deadlines; cutover-r2-01 concerns recoverable guard adoption; cutover-r2-02 concerns restoring stopped-job registration; visuals-03 and visuals-04 concern alternative branches and the broken companion link.","The captured attempt-2 canonical body and live document match current files. Generated participant/message labels match the authored sequence, all fourteen citation targets exist, and companion metadata identifies the existing file. Source agreement does not establish visual correctness.","The ISSUE's fresh activation, supported first upgrade, direct/recovery-job migration, broker-denied exit, data preservation and Linux requirements are represented in the revised prose and proposed test subjects. Remaining end-to-end feasibility concerns are captured by the accepted fresh findings. The chosen bridge alternative and empty open-question list introduce no additional independent contradiction.","Label ac1–ac3 with the corresponding ISSUE fix-intent requirements, and expand interruption qualification into predecessor-by-boundary cases covering checkout exchange, guard transfer, job removal, candidate admission and terminal publication. Executing implementation tests is outside this design assessment."],"findingDecisions":[{"source":{"attempt":1,"chunkId":"install","findingId":"install-01"},"rationale":"The revision now names updated IDE, shell/TUI and standard-installer first-upgrade routes, including older-caller fallback. However, accepted fresh install inspection is incomplete, so this origin remains carried pending inspection without mandatory gaps.","evidenceReferences":["LLD.md:167,207–214",".insrc/tmp/design-review/macos-installer-migration-5d5478c6.json: attempt 2 completedChunks/install, status and limitations"],"action":"carry"},{"source":{"attempt":1,"chunkId":"install","findingId":"install-02"},"rationale":"Immutable release roots, predecessor preservation, trusted qualification and missing-declaration allowlists are now described. Formal resolution remains withheld because the accepted fresh install chunk has a mandatory verification gap.","evidenceReferences":["LLD.md:121–129,208",".insrc/tmp/design-review/macos-installer-migration-5d5478c6.json: attempt 2 completedChunks/install"],"action":"carry"},{"source":{"attempt":1,"chunkId":"install","findingId":"install-03"},"rationale":"The revised contract separates staging-only behavior from controller-owned activation and records explicit start intent and partial-publication recovery. The accepted fresh install assessment remains incomplete, so this origin is not closed.","evidenceReferences":["LLD.md:34–54,102–109,164",".insrc/tmp/design-review/macos-installer-migration-5d5478c6.json: attempt 2 completedChunks/install"],"action":"carry"},{"source":{"attempt":1,"chunkId":"install","findingId":"install-04"},"rationale":"Running managed RPC and stopped external-controller routes are now specified, but the accepted fresh install review is incomplete and identifies a remaining acknowledgement-ordering defect in install-05. Preserve this origin rather than claim completed resolution.","evidenceReferences":["LLD.md:78–98,165,211",".insrc/tmp/design-review/macos-installer-migration-5d5478c6.json: attempt 2 completedChunks/install/findings/install-05 and limitations","src/daemon/managed-update-launch.ts: launchManagedUpdate and waitForReservation","src/shared/ipc-client.ts: createDaemonClient.update"],"action":"carry"},{"source":{"attempt":1,"chunkId":"cutover","findingId":"cutover-01"},"rationale":"Fresh cutover inspection has no mandatory gaps. The revised model defines all four predecessor variants, required identity and rollback evidence, selector absence/baseline, historical decoding and rejection rules. Recovery-job loader admission is explicitly constrained. The separately identified stopped-job restoration defect remains in cutover-r2-02.","evidenceReferences":["LLD.md:111–119,143–145",".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json: /body/dataModelChanges/1",".insrc/tmp/design-review/macos-installer-migration-5d5478c6.json: attempt 2 completedChunks/cutover","src/shared/installation-mutation-gate.ts: UpdatePredecessor and validPredecessor","src/daemon/legacy-launch-job.ts: verifyLegacyService"],"action":"resolved","reviewedInChunkIds":["cutover"]},{"source":{"attempt":1,"chunkId":"cutover","findingId":"cutover-02"},"rationale":"Canonical launcher exchange and old-helper exclusion materially improve admission, but uninterrupted exclusion still depends on an undefined controller-to-supervisor guard adoption. Fresh cutover-r2-01 demonstrates that the existing acquisition and borrowing contracts cannot perform the promised handoff. Preserve the original exclusion concern.","evidenceReferences":["LLD.md:139–141,209–210",".insrc/tmp/design-review/macos-installer-migration-5d5478c6.json: attempt 2 completedChunks/cutover/findings/cutover-r2-01","src/shared/daemon-run-files.ts: acquireRunFileGuard and borrowRunFileGuard","src/daemon/supervisor-run-files.ts: acquire and prepare","docs/standalone/restore-reliable-daemon-restart-macos-E202611103992d2e1/S001/LLD.md: migration step 1"],"action":"carry"},{"source":{"attempt":1,"chunkId":"cutover","findingId":"cutover-03"},"rationale":"Fresh cutover inspection has no mandatory gaps. The revision separates precommit candidate failures from uncertain outcome publication, requires rereading the matching durable result, forbids rollback of committed success and distinguishes provisional selection from terminal publication. This matches the existing transaction contract.","evidenceReferences":["LLD.md:75–76,151–157,211–212","src/daemon/managed-update-transaction.ts: finish and recoverManagedTransaction","src/daemon/managed-update-recovery.ts: recoverInstalledManagedUpdate",".insrc/tmp/design-review/macos-installer-migration-5d5478c6.json: attempt 2 completedChunks/cutover"],"action":"resolved","reviewedInChunkIds":["cutover"]},{"source":{"attempt":1,"chunkId":"cutover","findingId":"cutover-04"},"rationale":"Fresh cutover inspection has no mandatory gaps. The revision now persists graceful, broker-denied or unknown classification, requires correlated positive evidence for the first two, treats unavailable proof as unknown, requires crash-consistent release qualification for nongraceful reopening and reports classification to the user. Proposed qualification includes clean-drain and regression predecessors.","evidenceReferences":["LLD.md:113,147–150,182–187","src/daemon/legacy-daemon-cutover.ts: drainLegacyDaemonForCutover","src/daemon/shutdown.ts: failClosed and drain completion",".insrc/tmp/design-review/macos-installer-migration-5d5478c6.json: attempt 2 completedChunks/cutover"],"action":"resolved","reviewedInChunkIds":["cutover"]},{"source":{"attempt":1,"chunkId":"visuals","findingId":"visuals-01"},"rationale":"The revised generated sequence still expresses mutually exclusive running, stopped, success and rollback routes as one linear sequence. Accepted visuals-03 confirms the continuing concern, and actual rendering remains unverified. Carry this origin.","evidenceReferences":[".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json: /body/sequenceDefinition/messages","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html: embedded sequenceDiagram",".insrc/tmp/design-review/macos-installer-migration-