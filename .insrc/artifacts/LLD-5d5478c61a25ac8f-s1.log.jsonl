ncy"}],"coverageExplanation":"Every inventory unit maps to at least one substantive chunk. Shared contract, model, error, test and migration sections deliberately overlap so each implementation responsibility retains its interfaces, logic, failure handling and verification. Each assigned section must be inspected in full. Chunks proceed from issue scope through release qualification, lifecycle mechanics, entry-point integration and visual verification, followed by one consistency chunk depending on every substantive chunk.","finalConsistencyChunkId":"consistency","coverage":[{"unitId":"/body/hldContextSlice","chunkIds":["scope"]},{"unitId":"/body/summary","chunkIds":["scope","entrypoints"]},{"unitId":"/body/contractDetails","chunkIds":["qualification","lifecycle"]},{"unitId":"/body/dataModelChanges","chunkIds":["qualification","lifecycle"]},{"unitId":"/body/interactionWithShared","chunkIds":["lifecycle","entrypoints"]},{"unitId":"/body/errorPaths","chunkIds":["qualification","lifecycle","entrypoints"]},{"unitId":"/body/testStrategy","chunkIds":["qualification","lifecycle","entrypoints"]},{"unitId":"/body/migration","chunkIds":["qualification","lifecycle","entrypoints"]},{"unitId":"/body/alternativesConsidered","chunkIds":["scope"]},{"unitId":"/body/chosenAlternative","chunkIds":["scope"]},{"unitId":"/body/openQuestions","chunkIds":["scope"]},{"unitId":"/body/sequenceDefinition","chunkIds":["visuals"]},{"unitId":"/body/companions","chunkIds":["visuals"]},{"unitId":"/body/alternativesConsidered/0","chunkIds":["scope"]},{"unitId":"/body/alternativesConsidered/1","chunkIds":["scope"]},{"unitId":"/body/alternativesConsidered/2","chunkIds":["scope"]},{"unitId":"/body/sequenceDefinition/participants/0","chunkIds":["visuals"]},{"unitId":"/body/sequenceDefinition/participants/1","chunkIds":["visuals"]},{"unitId":"/body/sequenceDefinition/participants/2","chunkIds":["visuals"]},{"unitId":"/body/sequenceDefinition/participants/3","chunkIds":["visuals"]},{"unitId":"/body/sequen