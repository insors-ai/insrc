13","author":"controller"},"preservationDigest":"5b0ff17658414086e3c2bac82486929828c2ba57beca0b9f1845fa4453872c06","schemaVersion":1,"submitted":{"artifactPath":"/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md","attempt":1},"attempts":[{"number":1,"status":"incomplete","preparationKind":"planning","baseline":{"subjectFingerprints":{"canonical":"bb503ff2d689bddb50abc4dc28c251aedbb117608850b792d94b4ce7d5100ad4","document":"1c7ef9590d986eb3c854d8146377394b8425d6b7e9c55572d620cb2e0f4564f0"},"contentIdentity":"f7abd2f2be6bedd6765d93a1168c16646720944e1c75e1f3f22411a5b15e7974","reviewedContent":{"canonical":"{\n  \"meta\": {\n    \"workflow\": \"design.story\",\n    \"runId\": \"wf-1794511821464-9fcj7r\",\n    \"repoPath\": \"/Users/subhagho/work/projects/insors/insrc\",\n    \"createdAt\": \"2026-11-12T19:34:18.353Z\",\n    \"epicCreatedAt\": \"2026-11-11T16:00:50.440Z\",\n    \"attribution\": {\n      \"outputs\": [\n        {\n          \"role\": \"(client)\",\n          \"tier\": \"core\",\n          \"runner\": \"cli-codex\",\n          \"model\": \"unknown\"\n        }\n      ]\n    },\n    \"elapsedMs\": 236597,\n    \"repoIndexedAt\": null,\n    \"schemaVersion\": 1,\n    \"epicHash\": \"5d5478c61a25ac8f\",\n    \"epicSlug\": \"enable-managed-daemon-lifecycle-macos-install\",\n    \"storyId\": \"s1\",\n    \"hldBaseRunId\": \"wf-1794511821464-9fcj7r\",\n    \"hldEffectiveHash\": \"4d05d5213995802ad688ffa39adb4599d5999d6181c44071eca69793f37177bd\",\n    \"hldAmendmentsApplied\": [],\n    \"storyTitle\": \"Enable managed daemon lifecycle on macOS install and upgrade\",\n    \"standalone\": true,\n    \"authoredBy\": \"controller\",\n    \"lifecycle\": {\n      \"status\": \"draft\",\n      \"revision\": {\n        \"number\": 3,\n        \"contentHash\": \"dba6413aecdfebe5ed4c0b2b66a3680af7d68d728bdd6cf98c2a794d3d32772d\",\n        \"at\": \"2026-11-12T19:34:18.481Z\",\n        \"by\": {\n          \"id\": \"insrc:system\",\n          \"kind\": \"system\",\n          \"properties\": {}\n        }\n      },\n      \"signoffs\": []\n    },\n    \"envelope\": {\n      \"attachments\": []\n    },\n    \"revision\": 3\n  },\n  \"body\": {\n    \"hldContextSlice\": {\n      \"frameworkSummary\": \"Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\",\n      \"ownedContracts\": [],\n      \"consumedContracts\": [],\n      \"boundary\": {\n        \"storyId\": \"s1\",\n        \"owns\": [],\n        \"depends\": [],\n        \"internal\": \"Enable managed daemon lifecycle on macOS install and upgrade\"\n      },\n      \"adjacentBoundaries\": [],\n      \"rolloutPhase\": \"standalone\",\n      \"nonFunctional\": {}\n    },\n    \"summary\": {\n      \"audience\": \"product\",\n      \"prose\": \"The normal macOS installer provisions a per-user supervisor and automatically migrates supported locally built installs. Before cutover the updater verifies the incumbent against release-authorized build evidence and pins its original bytes for rollback. Existing configuration, stores and running state survive a verified rollback.\"\n    },\n    \"contractDetails\": {\n      \"surfaceLevel\": \"internal-shared\",\n      \"api\": [\n        {\n          \"name\": \"stageManagedRelease\",\n          \"signature\": \"stageManagedRelease(options: StageOptions): Promise<{ readonly candidate: StagedReleasePin; readonly prior?: StagedReleasePin; readonly compatibility?: QualifiedReleasePair }>\",\n          \"parameters\": [\n            {\n              \"name\": \"options\",\n              \"type\": \"StageOptions\",\n              \"purpose\": \"Carries the configured source, exact release pair, authorized build evidence and optional incumbent.\",\n              \"optional\": false\n            }\n          ],\n          \"returns\": {\n            \"type\": \"Promise<{ readonly candidate: StagedReleasePin; readonly prior?: StagedReleasePin; readonly compatibility?: QualifiedReleasePair }>\",\n            \"meaning\": \"Verified candidate and optional byte-exact original rollback pin.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"Error\",\n              \"condition\": \"Missing or invalid signed evidence, unsupported build profile, unaccounted executable differences, ambiguous inventory or unstable pin.\"\n            }\n          ],\n          \"preconditions\": [\n            \"Verify the configured origin, candidate commit, authorized release signature and storage format pair before trusting any candidate-supplied build instruction. Use a trust key shipped with a trusted installer/controller distribution, with scoped key rotation and revocation, independent of the fetched note. A source URL override alone grants no signing authority.\"\n          ],\n          \"postconditions\": [\n            \"The release profile binds predecessor and candidate commits, source and branch, target OS/architecture/ABI, supported toolchain inputs, full runtime inventory, verifier version, expected reference measurements and release test evidence. Measure file paths, modes, links, and raw bytes using owned stable handles. Verify before launcher exchange or shutdown.\",\n            \"Use exact hashes by default. The release-authorized verifier may account only for explicitly qualified differences with independently reproducible proof. For native files cover every code, loadable data, loader command, link/binding, and entitlement value. Compare security-relevant contents exactly, or against independently reconstructed expected bytes for a signed, precisely specified recipe. Omit only parsed, proven non-semantic metadata with bounded ranges and no overlap. Reject malformed layouts, unknown fields, unclassified bytes or unsupported variants. Never apply arbitrary masks, ignore whole native files, or infer build provenance from local measurements or Git cleanliness alone.\",\n            \"After qualification retain a byte-exact digest for all installed runtime files, including fields the verifier classified as non-semantic. Recheck the original pin before and after the launcher fence and before rollback. Candidates also have independent runtime verification before execution.\"\n          ]\n        },\n        {\n          \"name\": \"completeLegacyMigration\",\n          \"signature\": \"completeLegacyMigration(gate: InstallationMutationGate, update: UpdateReservation, pins: ManagedUpdatePins): Promise<DaemonUpdateOutcome>\",\n          \"parameters\": [\n            {\n              \"name\": \"gate\",\n              \"type\": \"InstallationMutationGate\",\n              \"purpose\": \"Owns the cutover and recovery reservation.\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"update\",\n              \"type\": \"UpdateReservation\",\n              \"purpose\": \"Identifies verified predecessor, release, fence and desired state.\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"pins\",\n              \"type\": \"ManagedUpdatePins\",\n              \"purpose\": \"Carries the qualified prior and candidate releases.\",\n              \"optional\": false\n            }\n          ],\n          \"returns\": {\n            \"type\": \"Promise<DaemonUpdateOutcome>\",\n            \"meaning\": \"Verified committed cutover, verified rollback, or fenced recovery.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"SupervisorLifecycleError\",\n              \"condition\": \"A release, launch route, exact exit, or recovery state cannot be verified.\"\n            }\n          ],\n          \"preconditions\": [\n            \"Use the migration-capable installer or updater to prepare the release before invoking any shutdown path. Freeze the canonical legacy launch and checkout paths and verify old mutating helpers are absent before cutover. Verify the pinned predecessor and public socket before sending shutdown.\"\n          ],\n          \"postconditions\": [\n            \"Use the journaled predecessor variant for exit, launchd job removal when applicable, and rollback. Publish a provisional selector before bootstrap. Mark terminal success only after exact candidate registration and verified idle or ready state. Retain a fenced reservation after uncertain outcome publication until recovery has read the matching durable outcome.\"\n          ]\n        }\n      ]\n    },\n    \"dataModelChanges\": [\n      {\n        \"entity\": \"InstallationMutationGate activation reservation\",\n        \"change\": \"field-add\",\n        \"details\": \"Persist one activation reservation per state root with exact owner, candidate and explicit start intent. Journal descriptor, provisional selector, exact registration, child admission, readiness and terminal outcome with identities. Previous journals remain decodable. Activation cleanup reverses only receipted owned mutations.\",\n        \"callSites\": [\n          \"src/shared/installation-mutation-gate.ts\",\n          \"src/shared/managed-daemon-installation.ts\",\n          \"src/bin/insrc-daemon-control.ts\"\n        ]\n      },\n      {\n        \"entity\": \"UpdatePredecessor\",\n        \"change\": \"invariant-change\",\n        \"details\": \"Persist a tagged managed, legacy-job, legacy-direct, or legacy-stopped predecessor. All variants bind canonical state root, prior release/runtime and candidate pin, selector baseline or absence, and prior running state. Managed carries supervisor generation. Legacy-job carries descriptor path/hash, verified label, UID, launchd domain, program argv, working directory and RunAtLoad policy. Running legacy-job and legacy-direct carry exact process incarnation, authenticated socket peer and pinned PID/socket identities. Legacy-direct also carries rollback argv, cwd and a release-qualified environment recipe reconstructed from the supported launcher, without persisting credentials. Legacy-stopped carries proof of no live process and either a pinned idle job or verified absence. Decode historical predecessor.legacy as legacy-job and older enabled prior without legacy as managed. Reject unknown or contradictory variants. Persist each observed exit, its drain classification, and ownership-fence evidence before candidate bootstrap.\",\n        \"callSites\": [\n          \"src/shared/installation-mutation-gate.ts\",\n          \"src/daemon/managed-update-recovery.ts\",\n          \"src/daemon/legacy-launch-job.ts\",\n          \"src/daemon/legacy-daemon-cutover.ts\"\n        ]\n      },\n      {\n        \"entity\": \"Release qualification profile and exact rollback pin\",\n        \"change\": \"invariant-change\",\n        \"details\": \"The release authority owns a signed, versioned profile for one configured source, ordered commit pair and tested build profile. A release pair can have multiple profiles. Exactly one applicable profile must verify a particular installation. An update reservation owns one verified profile receipt and one exact incumbent pin and binds both to its candidate, selector and state root. The profile verifies a complete measured inventory and accounts for variability. The local pin freezes raw bytes for rollback, and the receipt is reusable during recovery without remote network access. Historical journals retain their original verification rules. Versioned notes that lack the required portable proof cannot qualify a source-built variant.\",\n        \"callSites\": [\n          \"src/daemon/managed-release-staging.ts\",\n          \"src/daemon/managed-update-preparation.ts\",\n          \"src/daemon/release-compatibility.ts\",\n          \"src/daemon/managed-update-recovery.ts\"\n        ]\n      }\n    ],\n    \"interactionWithShared\": [],\n    \"errorPaths\": {\n      \"errorCases\": [\n        {\n          \"scenario\": \"An older launcher or updater can still mutate the legacy install\",\n          \"detection\": \"Resolve the canonical checkout and every supported launch route. Atomically exchange the canonical checkout entry with a gate-aware dispatcher on the same filesystem while the old daemon is still running. Preserve the displaced checkout separately. Before stopping, verify the dispatcher and archived checkout identities, an absent or owned legacy update marker, and absence of known old shell, detached helper and installer processes bound to the retired root, using verified argv and cwd. Repeat admission after the swap. An unrecognized launch path, unresolved process identity, live old mutator, or exchange failure makes exclusivity unproven.\",\n          \"response\": \"The dispatcher rejects concurrent mutation while cutover owns the reservation. Qualify only predecessors that acquire the shared run-file guard before opening data and whose shipped old commands use the canonical absolute entry. Keep that guard through owned cleanup and transfer it to candidate startup before the legacy route can reacquire it. Refuse when another legacy route cannot be fenced. Preserve or restore the old service before releasing a failed admission.\",\n          \"userImpact\": \"The supported update retries safely after a concurrent operation ends.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Predecessor job or runtime does not match the qualified route\",\n          \"detection\": \"Match the verified launchd registration against its owned descriptor bytes and approved exact argv. Match direct socket peer and executable against the qualified launch recipe. Accept the documented recovery LaunchAgent only with its pinned tsx loader arguments, canonical entry, matching working directory, bounded owned descriptor and passive restart policy.\",\n          \"response\": \"Reject foreign jobs, unknown loaders or args, conflicting restart policy and unverifiable direct rollback settings before disruption. Recheck the descriptor, PID incarnation and run-file identities immediately before each action.\",\n          \"userImpact\": \"The updater reports the unsupported predecessor while preserving the current service.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Exit is unconfirmed or graceful drain cannot be classified\",\n          \"detection\": \"Observe the exact predecessor exit independently of the broker and bind any qualified terminal evidence to the authenticated shutdown request and process incarnation. An RPC acknowledgement, socket close, PID disappearance, or generic log entry alone does not prove a graceful drain.\",\n          \"response\": \"Withhold candidate admission until exact exit is proved. Journal the exit plus graceful, broker-denied, or unknown. Use graceful only for a qualified positive completion signal, broker-denied only for correlated watchdog evidence, and unknown otherwise. Both broker-denied and unknown require a release pair explicitly qualified for crash-consistent reopening. Report the observed classification in the update detail.\",\n          \"userImpact\": \"The user can distinguish a verified shutdown from an exit whose drain could not be confirmed.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Candidate bootstrap or readiness fails before a durable outcome\",\n          \"detection\": \"Registration, startup generation, owned run files, or candidate idle/readiness cannot be verified.\",\n          \"response\": \"Reconcile the candidate under the reservation, restore the prior selector or absence and the canonical launcher, then restore and verify the exact previous job or direct launch only if it was running. Retain a fence when restoration is unverified.\",\n          \"userImpact\": \"Verified rollback restores the previous service state and reports the failed update.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Outcome publication throws or its acknowledgement is lost\",\n          \"detection\": \"Publication fails, or retry sees an active reservation without a verified terminal reply.\",\n          \"response\": \"Keep the reservation. Re-read the exact matching durable outcome through existing recovery. A durable success verifies or completes activation without rollback. A durable rollback verifies the old state. Only a proven uncommitted transaction can unwind. Unknown ownership remains fenced.\",\n          \"userImpact\": \"The updater reports an unconfirmed result until recovery determines the terminal state.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Release qualification is missing, ambiguous, stale, revoked or invalid\",\n          \"detection\": \"Reject absent note, invalid signature or key, unsupported profile or verifier version, source or commit mismatch, conflicting profiles and any unaccounted runtime difference.\",\n          \"response\": \"Report the failed verification before any incumbent shutdown, fence or selector mutation. Discard only owned preparation artifacts and preserve the incumbent.\",\n          \"userImpact\": \"The daemon remains available with an update diagnostic and can retry after a qualified release is published.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Installed runtime changes after independent verification\",\n          \"detection\": \"Recheck the original raw digest and exact file identities while holding update admission at the designated cutover and rollback boundaries.\",\n          \"response\": \"Stop cutover before touching the incumbent when possible. After mutation use the existing exact rollback or fenced recovery. Refuse to execute any changed rollback copy.\",\n          \"userImpact\": \"The update fails with a verification diagnostic.\",\n          \"recoverable\": true\n        }\n      ],\n      \"edgeCases\": [\n        {\n          \"input\": \"Fresh --no-start\",\n          \"expected\": \"Register the supervisor, enable the selector and verify idle with no daemon child. Subsequent normal start uses the same supervisor.\"\n        },\n        {\n          \"input\": \"Already-managed update when the daemon is stopped\",\n          \"expected\": \"The external controller prepares and commits the update using supervisor status; no daemon RPC is required. Keep the candidate idle.\"\n        },\n        {\n          \"input\": \"Legacy daemon remains running while the candidate is staged\",\n          \"expected\": \"Build outside the live root, preserve the running predecessor and only then acquire a cutover reservation. Failed fetch, build, or qualification leaves the running install unchanged.\"\n        },\n        {\n          \"input\": \"An unchanged older shell or IDE freshness client invokes legacy restart or daemon.update\",\n          \"expected\": \"An old client cannot acquire new preflight behavior before executing its existing shutdown sequence. The first upgrade is delivered by the current standard installer or the ordinary update action in updated IDE clients. The installer may be rerun on an existing installation without launchctl or file edits. Never present an old acknowledgement as migration success.\"\n        },\n        {\n          \"input\": \"Two qualified installs share a commit but have different build paths or raw native artifact bytes\",\n          \"expected\": \"Each matches independent expected execution-bearing bytes under the same tested profile and retains its own raw exact pin.\"\n        }\n      ],\n      \"invariantsToPreserve\": [\n        {\n          \"text\": \"One state root has at most one daemon process admitted to use its stores.\",\n          \"source\": \"c2\"\n        },\n        {\n          \"text\": \"Committed success is never rolled back because the publication reply was lost.\",\n          \"source\": \"c4\"\n        },\n        {\n          \"text\": \"Linux keeps its current lifecycle and update behavior.\",\n          \"source\": \"c1\"\n        }\n      ]\n    },\n    \"testStrategy\": {\n      \"testLevels\": [\n        {\n          \"level\": \"unit\",\n          \"purpose\": \"Verify admission, qualification, journal compatibility and outcome recovery.\",\n          \"subjects\": [\n            \"Predecessor variants and backward decoding\",\n            \"Explicit fresh activation start intent and owned partial publication\",\n            \"Release provenance, changed bytes and absent legacy declaration\",\n            \"Graceful, broker-denied and unknown drain evidence\",\n            \"Uncertain publication with durable success versus no outcome\"\n          ]\n        },\n        {\n          \"level\": \"integration\",\n          \"purpose\": \"Drive supported entry points and competing legacy operations through the real controller boundaries.\",\n          \"subjects\": [\n            \"Installer and updated CLI, VS Code and JetBrains route matrix\",\n            \"Running managed update IPC and stopped local managed update\",\n            \"Old shell/helper concurrent with canonical launcher exchange and old child attempting to open stores\",\n            \"Startup guard transfer, candidate bootstrap failure, rollback and repeated recovery\",\n            \"Linux normal install, update and restart unchanged\"\n          ]\n        },\n        {\n          \"level\": \"smoke\",\n          \"purpose\": \"Verify actual launchd and daemon state on macOS.\",\n          \"subjects\": [\n            \"Fresh install and verified ordinary restart\",\n            \"Fresh --no-start and later supervisor start\",\n            \"First supported update of a qualified prior build with broker denial\",\n            \"Direct install and passive recovery job with exact loader argv\",\n            \"Verified stopped and running rollback with configuration and store integrity\"\n          ],\n          \"fixturesNeeded\": [\n            \"Disposable macOS state roots and isolated launchd labels\",\n            \"Pinned released predecessors, including the regression and clean-drain cases\"\n          ]\n        },\n        {\n          \"level\": \"contract\",\n          \"purpose\": \"Verify release signatures, independent expected inventory, applicability, exact runtime coverage, and report provenance.\",\n          \"subjects\": [\n            \"Independent same-commit macOS build equivalence and tamper rejection\",\n            \"Changed native code, loadable data, bindings, signature policy, injected modules, symlinks and unidentified variance fail closed\",\n            \"Missing or stale release evidence prevents promotion and leaves the incumbent running\"\n          ]\n        },\n        {\n          \"level\": \"smoke\",\n          \"purpose\": \"Require real product builds before promoting a source-built profile.\",\n          \"subjects\": [\n            \"Release publication validates real running and stopped upgrades for every enabled profile\",\n            \"Real product passive and recovery job loader arguments, verified broker refusal, data-preserving rollback and subsequent managed update\"\n          ],\n          \"fixturesNeeded\": [\n            \"Two independent production installer builds of the same supported predecessor in different homes with observed native variance\",\n            \"Real predecessor and candidate installs using disposable homes and distinct launchd jobs\",\n            \"Qualification from an isolated release authority, plus immutable test receipts bound to promoted release metadata\"\n          ]\n        }\n      ],\n      \"acceptanceMapping\": [\n        {\n          \"criterionId\": \"ac1\",\n          \"provingTests\": [\n            \"Fresh install and verified ordinary restart\",\n            \"Fresh --no-start and later supervisor start\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac2\",\n          \"provingTests\": [\n            \"Installer and updated CLI, VS Code and JetBrains route matrix\",\n            \"First supported update of a qualified prior build with broker denial\",\n            \"Direct install and passive recovery job with exact loader argv\",\n            \"Old shell/helper concurrent with canonical launcher exchange and old child attempting to open stores\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac3\",\n          \"provingTests\": [\n            \"Running managed update IPC and stopped local managed update\",\n            \"Verified stopped and running rollback with configuration and store integrity\",\n            \"Uncertain publication with durable success versus no outcome\",\n            \"Linux normal install, update and restart unchanged\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac4\",\n          \"provingTests\": [\n            \"Independent same-commit macOS build equivalence and tamper rejection\",\n            \"Release publication validates real running and stopped upgrades for every enabled profile\"\n          ]\n        }\n      ],\n      \"testFramework\": \"Node.js test runner via tsx, installed shell integration fixtures, and real macOS launchd smoke tests in disposable state roots.\"\n    },\n    \"migration\": {\n      \"stateBefore\": \"The s1 discovery bundle identified whole-tree prior fingerprint qualification before managed migration. Two builds of the same legacy commit produced different native executable bytes. The configured origin was missing the qualification ref.\",\n      \"stateAfter\": \"Current install and update entry points share a migration-capable controller and immutable releases. A supported first upgrade retains the previous release and establishes one verified per-user supervisor. User data remains in the existing state root.\",\n      \"migrationSteps\": [\n        {\n          \"order\": 1,\n          \"action\": \"The release maintainer runs the real matrix on independent predecessor builds, signs profile and result digests, and publishes the note to the configured release origin. A promotion check fetches the published note as a normal updater, checks trust and exact branch head, and blocks release promotion unless all supported profiles pass. Unsupported profiles remain unadvertised. Test-only origins and signer keys cannot qualify a production release.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 2,\n          \"action\": \"Use the current standard installer for both fresh installs and first upgrades. Updated VS Code and JetBrains lifecycle Update on unmanaged Darwin dispatch the packaged migration-capable installer in existing-install mode with the configured branch and root. Updated freshness clients route unmanaged Darwin to that same action before sending any daemon.update RPC. A migration-capable shell or TUI starts the same external preflight on ordinary Update. For already-installed binaries that cannot obtain new code before shutdown, the supported first-upgrade action is the current standard installer, including the normal Install action in an updated IDE. No manual service administration is part of that path.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 3,\n          \"action\": \"Verify the signed release evidence and stage the candidate in a separate owned root. Verify the real incumbent against the supported profile, pin raw incumbent and candidate bytes, and check launchd admission. A failed verification leaves the existing daemon alone. Fresh install enters the activation reservation with explicit start intent.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 4,\n          \"action\": \"For legacy cutover, reserve and atomically replace the canonical installed checkout entry with a gate-aware dispatcher while preserving its original directory identity. Recover either side of the exchange by journaled inode evidence. Recheck for in-flight old helpers, update markers, unsupported launch routes, and mismatched job registrations. The dispatcher has no old executable or mutable checkout target. Refuse when the old launcher or writer cannot be excluded. Keep the prior checkout pinned until rollback is no longer needed.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 5,\n          \"action\": \"Authenticate the running predecessor over the pinned socket and observe exact exit. While the canonical launcher remains fenced, acquire the legacy-compatible run-file guard before cleanup, reconcile only the recorded publications, and retain the guard until a verified supervisor has adopted it for startup. Transfer owner evidence under the same directory identity with no unguarded interval. Remove a verified passive old job after its child exits. Apply the stored outcome policy for graceful, broker-denied, or unknown exit.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 6,\n          \"action\": \"Journal the provisional selector and register the supervisor. Start a child for a normal fresh install or previously running update. Verify idle for --no-start or previously stopped update. Publish the matching durable terminal record before release. An already-managed shell/TUI update uses the external transaction even when stopped, and the running managed RPC uses the detached helper and acknowledgement handshake.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 7,\n          \"action\": \"Recover from interrupted activation or cutover using the matching durable outcome. Restore an uncommitted predecessor by reversing owned mutations, restoring the canonical legacy entry and revalidating the predecessor's exact original launch route. Retain a fence on uncertainty. Do not roll back a verified durable success.\",\n          \"rollbackable\": true\n        }\n      ],\n      \"backwardCompat\": \"Preserve the CLI flags, configured source, IDE IPC result shapes, supported user settings, Linux behavior and historical journal decoding. Existing binaries that stop before they can fetch the migration use the current normal installer for the first upgrade. The canonical installed launcher remains a compatible entry point after migration.\",\n      \"zeroDowntime\": false,\n      \"dataRewriteRequired\": false\n    },\n    \"alternativesConsidered\": [\n      {\n        \"id\": \"a1\",\n        \"name\": \"Release-signed build verification profiles\",\n        \"oneLineSummary\": \"Use independent release evidence for portable equivalence and an exact local pin for rollback.\",\n        \"approach\": \"Publish a signed profile per tested predecessor and platform. Verify its complete runtime inventory against an independently built reference using exact hashes by default and bounded deterministic transformations only for verified build variance. Bind the original measured bytes to the cutover journal.\",\n        \"pros\": [\n          \"Supports independently built installations inside a tested profile.\",\n          \"Rejects unexplained executable changes before shutdown.\"\n        ],\n        \"cons\": [\n          \"Requires maintaining release fixtures and qualifying each native transformation.\"\n        ],\n        \"costEstimate\": \"L\"\n      },\n      {\n        \"id\": \"a2\",\n        \"name\": \"Exact release fingerprints only\",\n        \"oneLineSummary\": \"Accept an inventory of byte-identical prior builds.\",\n        \"approach\": \"Publish one exact fingerprint for each independently archived prior package and continue requiring an exact installed match.\",\n        \"pros\": [\n          \"Simple executable verification.\",\n          \"Retains the existing staging pin format.\"\n        ],\n        \"cons\": [\n          \"The same commit produced different native bytes on the two observed installs.\",\n          \"Uncatalogued local builds cannot migrate automatically.\"\n        ],\n        \"costEstimate\": \"S\",\n        \"reasonRejected\": \"An exact reference fingerprint rejects separately built valid native binaries.\"\n      },\n      {\n        \"id\": \"a3\",\n        \"name\": \"Rebuild a rollback release from the old commit\",\n        \"oneLineSummary\": \"Use an independently verified replacement rollback build.\",\n        \"approach\": \"Fetch and rebuild the predecessor in a separate directory using pinned release inputs, then use that result as the rollback executable.\",\n        \"pros\": [\n          \"Supports a clean executable artifact without a per-install binary catalogue.\"\n        ],\n        \"cons\": [\n          \"Does not establish the original incumbent executable's provenance.\",\n          \"Replaces the exact prior executable and introduces a new rollback compatibility surface.\"\n        ],\n        \"costEstimate\": \"L\",\n        \"reasonRejected\": \"A replacement rollback build leaves original executable provenance unverified and changes rollback identity.\"\n      }\n    ],\n    \"chosenAlternative\": \"a1\",\n    \"openQuestions\": [],\n    \"sequenceDefinition\": {\n      \"id\": \"macos-install-cutover\",\n      \"narrative\": \"Release authority publishes evidence before the updater runs. The controller verifies the installed release and records the exact rollback pin before it fences the launcher or asks the incumbent to exit. The existing journal settles running, idle and rollback outcomes.\",\n      \"participants\": [\n        {\n          \"id\": \"release\",\n          \"label\": \"Release authority\",\n          \"description\": \"Publishes signed and tested qualification for the exact ordered release pair.\"\n        },\n        {\n          \"id\": \"entry\",\n          \"label\": \"Installer / update\",\n          \"description\": \"Stages a release through a supported entry point.\"\n        },\n        {\n          \"id\": \"control\",\n          \"label\": \"Controller\",\n          \"description\": \"Owns the journal and cutover fence.\"\n        },\n        {\n          \"id\": \"old\",\n          \"label\": \"Legacy service\",\n          \"description\": \"Pinned predecessor process and job, if present.\"\n        },\n        {\n          \"id\": \"new\",\n          \"label\": \"Supervisor\",\n          \"description\": \"Owns the candidate daemon or verifies idle.\"\n        },\n        {\n          \"id\": \"child\",\n          \"label\": \"Daemon\",\n          \"description\": \"Candidate serving only after admission.\"\n        }\n      ],\n      \"messages\": [\n        {\n          \"from\": \"release\",\n          \"to\": \"entry\",\n          \"label\": \"Publish signed qualification\",\n          \"description\": \"Publish only after real independent builds and the product migration matrix pass.\"\n        },\n        {\n          \"from\": \"entry\",\n          \"to\": \"control\",\n          \"label\": \"Stage release and verify prior\",\n          \"description\": \"Verify signed evidence, inventory and runtime files while the incumbent is available.\"\n        },\n        {\n          \"from\": \"control\",\n          \"to\": \"control\",\n          \"label\": \"Retain raw rollback pin\",\n          \"description\": \"Record the local digest of all original bytes and bind it to the verified profile.\"\n        },\n        {\n          \"from\": \"control\",\n          \"to\": \"control\",\n          \"label\": \"Reserve and fence\",\n          \"description\": \"Journal the entry switch and exclude older writers.\"\n        },\n        {\n          \"from\": \"control\",\n          \"to\": \"old\",\n          \"label\": \"If running: request exit\",\n          \"description\": \"Authenticate the socket and observe exact exit.\"\n        },\n        {\n          \"from\": \"old\",\n          \"to\": \"control\",\n          \"label\": \"Verified exit\",\n          \"description\": \"Keep the launcher fenced and reconcile owned publications.\"\n        },\n        {\n          \"from\": \"control\",\n          \"to\": \"new\",\n          \"label\": \"Publish selector, register job\",\n          \"description\": \"Verify the exact supervisor and admit the requested state.\"\n        },\n        {\n          \"from\": \"new\",\n          \"to\": \"child\",\n          \"label\": \"Running route: start\",\n          \"description\": \"Start one child if requested or previously running.\"\n        },\n        {\n          \"from\": \"child\",\n          \"to\": \"new\",\n          \"label\": \"Running route: readiness\",\n          \"description\": \"Verify authenticated child and publication identities.\"\n        },\n        {\n          \"from\": \"new\",\n          \"to\": \"control\",\n          \"label\": \"Stopped route: verify idle\",\n          \"description\": \"No child is admitted and no daemon readiness is expected.\"\n        },\n        {\n          \"from\": \"control\",\n          \"to\": \"entry\",\n          \"label\": \"Success: commit result\",\n          \"description\": \"Persist verified running or stopped state.\"\n        },\n        {\n          \"from\": \"control\",\n          \"to\": \"new\",\n          \"label\": \"Before commit: reconcile candidate\",\n          \"description\": \"On verified uncommitted failure, stop the exact candidate and remove its owned job.\"\n        },\n        {\n          \"from\": \"control\",\n          \"to\": \"old\",\n          \"label\": \"Rollback: restore prior state\",\n          \"description\": \"Restore the selector or absence, launcher and prior service state.\"\n        },\n        {\n          \"from\": \"control\",\n          \"to\": \"entry\",\n          \"label\": \"Report rollback or keep fence\",\n          \"description\": \"Report restored state only when verified. Retain the fence on ambiguous ownership or terminal publication.\"\n        }\n      ]\n    },\n    \"companions\": [\n      {\n        \"kind\": \"diagram-mermaid\",\n        \"relPath\": \"docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html\",\n        \"title\": \"Sequence diagram\"\n      }\n    ]\n  },\n  \"citations\": [\n    {\n      \"id\": \"c1\",\n      \"kind\": \"code\",\n      \"ref\": \"scripts/insrc-daemon-install.sh\"\n    },\n    {\n      \"id\": \"c2\",\n      \"kind\": \"code\",\n      \"ref\": \"src/shared/managed-daemon-installation.ts\"\n    },\n    {\n      \"id\": \"c3\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/managed-update-recovery.ts\"\n    },\n    {\n      \"id\": \"c4\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/managed-update-transaction.ts\"\n    },\n    {\n      \"id\": \"c5\",\n      \"kind\": \"code\",\n      \"ref\": \"src/bin/insrc-daemon-control.ts\"\n    },\n    {\n      \"id\": \"c6\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/legacy-launch-job.ts\"\n    },\n    {\n      \"id\": \"c7\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/legacy-daemon-cutover.ts\"\n    },\n    {\n      \"id\": \"c8\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/update-runner.ts\"\n    },\n    {\n      \"id\": \"c9\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/admin-handlers.ts\"\n    },\n    {\n      \"id\": \"c10\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/release-compatibility.ts\"\n    },\n    {\n      \"id\": \"c11\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/index.ts\"\n    },\n    {\n      \"id\": \"c12\",\n      \"kind\": \"code\",\n      \"ref\": \"src/shared/daemon-run-files.ts\"\n    },\n    {\n      \"id\": \"c13\",\n      \"kind\": \"code\",\n      \"ref\": \"scripts/daemon-ctl.sh\"\n    },\n    {\n      \"id\": \"c14\",\n      \"kind\": \"prior-artifact\",\n      \"ref\": \"ISSUE-5d5478c61a25ac8f\"\n    },\n    {\n      \"id\": \"c20\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/managed-release-staging.ts\"\n    },\n    {\n      \"id\": \"c21\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/managed-update-preparation.ts\"\n    },\n    {\n      \"id\": \"c22\",\n      \"kind\": \"prior-artifact\",\n      \"ref\": \"BUILD-5d5478c61a25ac8f-s1\"\n    }\n  ]\n}\n","document":"<!-- insrc:artifact LLD-5d5478c61a25ac8f-s1 -->\n\n# LLD: STORY-5d5478c61a25ac8f-s1 — Enable managed daemon lifecycle on macOS install and upgrade\n\n## Summary\n\n**Epic:** `enable-managed-daemon-lifecycle-macos-install`\n**HLD base run:** `wf-1794511821464-9fcj7r`\n**HLD effective hash:** `4d05d5213995...`\n\nThe normal macOS installer provisions a per-user supervisor and automatically migrates supported locally built installs. Before cutover the updater verifies the incumbent against release-authorized build evidence and pins its original bytes for rollback. Existing configuration, stores and running state survive a verified rollback.\n\n## Contents\n\n1. [HLD context](#1-hld-context)\n2. [Contract details](#2-contract-details)\n3. [Data model changes](#3-data-model-changes)\n4. [Diagrams](#4-diagrams)\n5. [Error paths](#5-error-paths)\n6. [Test strategy](#6-test-strategy)\n7. [Migration](#7-migration)\n8. [Alternatives considered](#8-alternatives-considered)\n9. [References](#9-references)\n\n## 1. HLD context\n\n**Framework:** Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\n**Rollout phase:** standalone\n\n## 2. Contract details\n\n**Surface level:** internal-shared\n\n### 2.1 `stageManagedRelease`\n\n```typescript\nstageManagedRelease(options: StageOptions): Promise<{ readonly candidate: StagedReleasePin; readonly prior?: StagedReleasePin; readonly compatibility?: QualifiedReleasePair }>\n```\n\n**Parameters:**\n- `options: StageOptions` — Carries the configured source, exact release pair, authorized build evidence and optional incumbent.\n\n**Returns:** `Promise<{ readonly candidate: StagedReleasePin; readonly prior?: StagedReleasePin; readonly compatibility?: QualifiedReleasePair }>` — Verified candidate and optional byte-exact original rollback pin.\n\n**Errors:**\n- `Error` when Missing or invalid signed evidence, unsupported build profile, unaccounted executable differences, ambiguous inventory or unstable pin.\n\n**Preconditions:**\n- Verify the configured origin, candidate commit, authorized release signature and storage format pair before trusting any candidate-supplied build instruction. Use a trust key shipped with a trusted installer/controller distribution, with scoped key rotation and revocation, independent of the fetched note. A source URL override alone grants no signing authority.\n\n**Postconditions:**\n- The release profile binds predecessor and candidate commits, source and branch, target OS/architecture/ABI, supported toolchain inputs, full runtime inventory, verifier version, expected reference measurements and release test evidence. Measure file paths, modes, links, and raw bytes using owned stable handles. Verify before launcher exchange or shutdown.\n- Use exact hashes by default. The release-authorized verifier may account only for explicitly qualified differences with independently reproducible proof. For native files cover every code, loadable data, loader command, link/binding, and entitlement value. Compare security-relevant contents exactly, or against independently reconstructed expected bytes for a signed, precisely specified recipe. Omit only parsed, proven non-semantic metadata with bounded ranges and no overlap. Reject malformed layouts, unknown fields, unclassified bytes or unsupported variants. Never apply arbitrary masks, ignore whole native files, or infer build provenance from local measurements or Git cleanliness alone.\n- After qualification retain a byte-exact digest for all installed runtime files, including fields the verifier classified as non-semantic. Recheck the original pin before and after the launcher fence and before rollback. Candidates also have independent runtime verification before execution.\n\n### 2.2 `completeLegacyMigration`\n\n```typescript\ncompleteLegacyMigration(gate: InstallationMutationGate, update: UpdateReservation, pins: ManagedUpdatePins): Promise<DaemonUpdateOutcome>\n```\n\n**Parameters:**\n- `gate: InstallationMutationGate` — Owns the cutover and recovery reservation.\n- `update: UpdateReservation` — Identifies verified predecessor, release, fence and desired state.\n- `pins: ManagedUpdatePins` — Carries the qualified prior and candidate releases.\n\n**Returns:** `Promise<DaemonUpdateOutcome>` — Verified committed cutover, verified rollback, or fenced recovery.\n\n**Errors:**\n- `SupervisorLifecycleError` when A release, launch route, exact exit, or recovery state cannot be verified.\n\n**Preconditions:**\n- Use the migration-capable installer or updater to prepare the release before invoking any shutdown path. Freeze the canonical legacy launch and checkout paths and verify old mutating helpers are absent before cutover. Verify the pinned predecessor and public socket before sending shutdown.\n\n**Postconditions:**\n- Use the journaled predecessor variant for exit, launchd job removal when applicable, and rollback. Publish a provisional selector before bootstrap. Mark terminal success only after exact candidate registration and verified idle or ready state. Retain a fenced reservation after uncertain outcome publication until recovery has read the matching durable outcome.\n\n## 3. Data model changes\n\n### 3.1 `InstallationMutationGate activation reservation` — field-add\n\nPersist one activation reservation per state root with exact owner, candidate and explicit start intent. Journal descriptor, provisional selector, exact registration, child admission, readiness and terminal outcome with identities. Previous journals remain decodable. Activation cleanup reverses only receipted owned mutations.\n\n**Call sites:**\n- `src/shared/installation-mutation-gate.ts`\n- `src/shared/managed-daemon-installation.ts`\n- `src/bin/insrc-daemon-control.ts`\n\n### 3.2 `UpdatePredecessor` — invariant-change\n\nPersist a tagged managed, legacy-job, legacy-direct, or legacy-stopped predecessor. All variants bind canonical state root, prior release/runtime and candidate pin, selector baseline or absence, and prior running state. Managed carries supervisor generation. Legacy-job carries descriptor path/hash, verified label, UID, launchd domain, program argv, working directory and RunAtLoad policy. Running legacy-job and legacy-direct carry exact process incarnation, authenticated socket peer and pinned PID/socket identities. Legacy-direct also carries rollback argv, cwd and a release-qualified environment recipe reconstructed from the supported launcher, without persisting credentials. Legacy-stopped carries proof of no live process and either a pinned idle job or verified absence. Decode historical predecessor.legacy as legacy-job and older enabled prior without legacy as managed. Reject unknown or contradictory variants. Persist each observed exit, its drain classification, and ownership-fence evidence before candidate bootstrap.\n\n**Call sites:**\n- `src/shared/installation-mutation-gate.ts`\n- `src/daemon/managed-update-recovery.ts`\n- `src/daemon/legacy-launch-job.ts`\n- `src/daemon/legacy-daemon-cutover.ts`\n\n### 3.3 `Release qualification profile and exact rollback pin` — invariant-change\n\nThe release authority owns a signed, versioned profile for one configured source, ordered commit pair and tested build profile. A release pair can have multiple profiles. Exactly one applicable profile must verify a particular installation. An update reservation owns one verified profile receipt and one exact incumbent pin and binds both to its candidate, selector and state root. The profile verifies a complete measured inventory and accounts for variability. The local pin freezes raw bytes for rollback, and the receipt is reusable during recovery without remote network access. Historical journals retain their original verification rules. Versioned notes that lack the required portable proof cannot qualify a source-built variant.\n\n**Call sites:**\n- `src/daemon/managed-release-staging.ts`\n- `src/daemon/managed-update-preparation.ts`\n- `src/daemon/release-compatibility.ts`\n- `src/daemon/managed-update-recovery.ts`\n\n## 4. Diagrams\n\n- [Sequence diagram](docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html)\n\n## 5. Error paths\n\n**Error cases**\n\n- **An older launcher or updater can still mutate the legacy install** (recoverable)\n  - Detection: Resolve the canonical checkout and every supported launch route. Atomically exchange the canonical checkout entry with a gate-aware dispatcher on the same filesystem while the old daemon is still running. Preserve the displaced checkout separately. Before stopping, verify the dispatcher and archived checkout identities, an absent or owned legacy update marker, and absence of known old shell, detached helper and installer processes bound to the retired root, using verified argv and cwd. Repeat admission after the swap. An unrecognized launch path, unresolved process identity, live old mutator, or exchange failure makes exclusivity unproven.\n  - Response: The dispatcher rejects concurrent mutation while cutover owns the reservation. Qualify only predecessors that acquire the shared run-file guard before opening data and whose shipped old commands use the canonical absolute entry. Keep that guard through owned cleanup and transfer it to candidate startup before the legacy route can reacquire it. Refuse when another legacy route cannot be fenced. Preserve or restore the old service before releasing a failed admission.\n  - User impact: The supported update retries safely after a concurrent operation ends.\n- **Predecessor job or runtime does not match the qualified route** (recoverable)\n  - Detection: Match the verified launchd registration against its owned descriptor bytes and approved exact argv. Match direct socket peer and executable against the qualified launch recipe. Accept the documented recovery LaunchAgent only with its pinned tsx loader arguments, canonical entry, matching working directory, bounded owned descriptor and passive restart policy.\n  - Response: Reject foreign jobs, unknown loaders or args, conflicting restart policy and unverifiable direct rollback settings before disruption. Recheck the descriptor, PID incarnation and run-file identities immediately before each action.\n  - User impact: The updater reports the unsupported predecessor while preserving the current service.\n- **Exit is unconfirmed or graceful drain cannot be classified** (recoverable)\n  - Detection: Observe the exact predecessor exit independently of the broker and bind any qualified terminal evidence to the authenticated shutdown request and process incarnation. An RPC acknowledgement, socket close, PID disappearance, or generic log entry alone does not prove a graceful drain.\n  - Response: Withhold candidate admission until exact exit is proved. Journal the exit plus graceful, broker-denied, or unknown. Use graceful only for a qualified positive completion signal, broker-denied only for correlated watchdog evidence, and unknown otherwise. Both broker-denied and unknown require a release pair explicitly qualified for crash-consistent reopening. Report the observed classification in the update detail.\n  - User impact: The user can distinguish a verified shutdown from an exit whose drain could not be confirmed.\n- **Candidate bootstrap or readiness fails before a durable outcome** (recoverable)\n  - Detection: Registration, startup generation, owned run files, or candidate idle/readiness cannot be verified.\n  - Response: Reconcile the candidate under the reservation, restore the prior selector or absence and the canonical launcher, then restore and verify the exact previous job or direct launch only if it was running. Retain a fence when restoration is unverified.\n  - User impact: Verified rollback restores the previous service state and reports the failed update.\n- **Outcome publication throws or its acknowledgement is lost** (recoverable)\n  - Detection: Publication fails, or retry sees an active reservation without a verified terminal reply.\n  - Response: Keep the reservation. Re-read the exact matching durable outcome through existing recovery. A durable success verifies or completes activation without rollback. A durable rollback verifies the old state. Only a proven uncommitted transaction can unwind. Unknown ownership remains fenced.\n  - User impact: The updater reports an unconfirmed result until recovery determines the terminal state.\n- **Release qualification is missing, ambiguous, stale, revoked or invalid** (recoverable)\n  - Detection: Reject absent note, invalid signature or key, unsupported profile or verifier version, source or commit mismatch, conflicting profiles and any unaccounted runtime difference.\n  - Response: Report the failed verification before any incumbent shutdown, fence or selector mutation. Discard only owned preparation artifacts and preserve the incumbent.\n  - User impact: The daemon remains available with an update diagnostic and can retry after a qualified release is published.\n- **Installed runtime changes after independent verification** (recoverable)\n  - Detection: Recheck the original raw digest and exact file identities while holding update admission at the designated cutover and rollback boundaries.\n  - Response: Stop cutover before touching the incumbent when possible. After mutation use the existing exact rollback or fenced recovery. Refuse to execute any changed rollback copy.\n  - User impact: The update fails with a verification diagnostic.\n\n**Edge cases**\n\n| Input | Expected |\n| :--- | :--- |\n| Fresh --no-start | Register the supervisor, enable the selector and verify idle with no daemon child. Subsequent normal start uses the same supervisor. |\n| Already-managed update when the daemon is stopped | The external controller prepares and commits the update using supervisor status; no daemon RPC is required. Keep the candidate idle. |\n| Legacy daemon remains running while the candidate is staged | Build outside the live root, preserve the running predecessor and only then acquire a cutover reservation. Failed fetch, build, or qualification leaves the running install unchanged. |\n| An unchanged older shell or IDE freshness client invokes legacy restart or daemon.update | An old client cannot acquire new preflight behavior before executing its existing shutdown sequence. The first upgrade is delivered by the current standard installer or the ordinary update action in updated IDE clients. The installer may be rerun on an existing installation without launchctl or file edits. Never present an old acknowledgement as migration success. |\n| Two qualified installs share a commit but have different build paths or raw native artifact bytes | Each matches independent expected execution-bearing bytes under the same tested profile and retains its own raw exact pin. |\n\n**Invariants to preserve**\n\n- One state root has at most one daemon process admitted to use its stores. [[c2]]\n- Committed success is never rolled back because the publication reply was lost. [[c4]]\n- Linux keeps its current lifecycle and update behavior. [[c1]]\n\n## 6. Test strategy\n\n**Test framework:** `Node.js test runner via tsx, installed shell integration fixtures, and real macOS launchd smoke tests in disposable state roots.`\n\n**Test levels**\n\n- **unit** — Verify admission, qualification, journal compatibility and outcome recovery.\n  - Subjects: `Predecessor variants and backward decoding`, `Explicit fresh activation start intent and owned partial publication`, `Release provenance, changed bytes and absent legacy declaration`, `Graceful, broker-denied and unknown drain evidence`, `Uncertain publication with durable success versus no outcome`\n- **integration** — Drive supported entry points and competing legacy operations through the real controller boundaries.\n  - Subjects: `Installer and updated CLI, VS Code and JetBrains route matrix`, `Running managed update IPC and stopped local managed update`, `Old shell/helper concurrent with canonical launcher exchange and old child attempting to open stores`, `Startup guard transfer, candidate bootstrap failure, rollback and repeated recovery`, `Linux normal install, update and restart unchanged`\n- **smoke** — Verify actual launchd and daemon state on macOS.\n  - Subjects: `Fresh install and verified ordinary restart`, `Fresh --no-start and later supervisor start`, `First supported update of a qualified prior build with broker denial`, `Direct install and passive recovery job with exact loader argv`, `Verified stopped and running rollback with configuration and store integrity`\n  - Fixtures: `Disposable macOS state roots and isolated launchd labels`, `Pinned released predecessors, including the regression and clean-drain cases`\n- **contract** — Verify release signatures, independent expected inventory, applicability, exact runtime coverage, and report provenance.\n  - Subjects: `Independent same-commit macOS build equivalence and tamper rejection`, `Changed native code, loadable data, bindings, signature policy, injected modules, symlinks and unidentified variance fail closed`, `Missing or stale release evidence prevents promotion and leaves the incumbent running`\n- **smoke** — Require real product builds before promoting a source-built profile.\n  - Subjects: `Release publication validates real running and stopped upgrades for every enabled profile`, `Real product passive and recovery job loader arguments, verified broker refusal, data-preserving rollback and subsequent managed update`\n  - Fixtures: `Two independent production installer builds of the same supported predecessor in different homes with observed native variance`, `Real predecessor and candidate installs using disposable homes and distinct launchd jobs`, `Qualification from an isolated release authority, plus immutable test receipts bound to promoted release metadata`\n\n**Acceptance mapping**\n\n| Criterion | Proving tests |\n| :--- | :--- |\n| `ac1` | `Fresh install and verified ordinary restart`, `Fresh --no-start and later supervisor start` |\n| `ac2` | `Installer and updated CLI, VS Code and JetBrains route matrix`, `First supported update of a qualified prior build with broker denial`, `Direct install and passive recovery job with exact loader argv`, `Old shell/helper concurrent with canonical launcher exchange and old child attempting to open stores` |\n| `ac3` | `Running managed update IPC and stopped local managed update`, `Verified stopped and running rollback with configuration and store integrity`, `Uncertain publication with durable success versus no outcome`, `Linux normal install, update and restart unchanged` |\n| `ac4` | `Independent same-commit macOS build equivalence and tamper rejection`, `Release publication validates real running and stopped upgrades for every enabled profile` |\n\n## 7. Migration\n\n**State before:** The s1 discovery bundle identified whole-tree prior fingerprint qualification before managed migration. Two builds of the same legacy commit produced different native executable bytes. The configured origin was missing the qualification ref.\n\n**State after:** Current install and update entry points share a migration-capable controller and immutable releases. A supported first upgrade retains the previous release and establishes one verified per-user supervisor. User data remains in the existing state root.\n\n**Zero downtime:** no — **Data rewrite:** no\n\n**Steps**\n\n1. The release maintainer runs the real matrix on independent predecessor builds, signs profile and result digests, and publishes the note to the configured release origin. A promotion check fetches the published note as a normal updater, checks trust and exact branch head, and blocks release promotion unless all supported profiles pass. Unsupported profiles remain unadvertised. Test-only origins and signer keys cannot qualify a production release. — ↩ rollbackable\n2. Use the current standard installer for both fresh installs and first upgrades. Updated VS Code and JetBrains lifecycle Update on unmanaged Darwin dispatch the packaged migration-capable installer in existing-install mode with the configured branch and root. Updated freshness clients route unmanaged Darwin to that same action before sending any daemon.update RPC. A migration-capable shell or TUI starts the same external preflight on ordinary Update. For already-installed binaries that cannot obtain new code before shutdown, the supported first-upgrade action is the current standard installer, including the normal Install action in an updated IDE. No manual service administration is part of that path. — ↩ rollbackable\n3. Verify the signed release evidence and stage the candidate in a separate owned root. Verify the real incumbent against the supported profile, pin raw incumbent and candidate bytes, and check launchd admission. A failed verification leaves the existing daemon alone. Fresh install enters the activation reservation with explicit start intent. — ↩ rollbackable\n4. For legacy cutover, reserve and atomically replace the canonical installed checkout entry with a gate-aware dispatcher while preserving its original directory identity. Recover either side of the exchange by journaled inode evidence. Recheck for in-flight old helpers, update markers, unsupported launch routes, and mismatched job registrations. The dispatcher has no old executable or mutable checkout target. Refuse when the old launcher or writer cannot be excluded. Keep the prior checkout pinned until rollback is no longer needed. — ↩ rollbackable\n5. Authenticate the running predecessor over the pinned socket and observe exact exit. While the canonical launcher remains fenced, acquire the legacy-compatible run-file guard before cleanup, reconcile only the recorded publications, and retain the guard until a verified supervisor has adopted it for startup. Transfer owner evidence under the same directory identity with no unguarded interval. Remove a verified passive old job after its child exits. Apply the stored outcome policy for graceful, broker-denied, or unknown exit. — ↩ rollbackable\n6. Journal the provisional selector and register the supervisor. Start a child for a normal fresh install or previously running update. Verify idle for --no-start or previously stopped update. Publish the matching durable terminal record before release. An already-managed shell/TUI update uses the external transaction even when stopped, and the running managed RPC uses the detached helper and acknowledgement handshake. — ↩ rollbackable\n7. Recover from interrupted activation or cutover using the matching durable outcome. Restore an uncommitted predecessor by reversing owned mutations, restoring the canonical legacy entry and revalidating the predecessor's exact original launch route. Retain a fence on uncertainty. Do not roll back a verified durable success. — ↩ rollbackable\n\n**Backward compat:** Preserve the CLI flags, configured source, IDE IPC result shapes, supported user settings, Linux behavior and historical journal decoding. Existing binaries that stop before they can fetch the migration use the current normal installer for the first upgrade. The canonical installed launcher remains a compatible entry point after migration.\n\n## 8. Alternatives considered\n\n### 8.1 a1: Release-signed build verification profiles — **CHOSEN**\n\nUse independent release evidence for portable equivalence and an exact local pin for rollback.\n\nPublish a signed profile per tested predecessor and platform. Verify its complete runtime inventory against an independently built reference using exact hashes by default and bounded deterministic transformations only for verified build variance. Bind the original measured bytes to the cutover journal.\n\n### 8.2 a2: Exact release fingerprints only\n\nAccept an inventory of byte-identical prior builds.\n\nPublish one exact fingerprint for each independently archived prior package and continue requiring an exact installed match.\n\n**Rejected because:** An exact reference fingerprint rejects separately built valid native binaries.\n\n### 8.3 a3: Rebuild a rollback release from the old commit\n\nUse an independently verified replacement rollback build.\n\nFetch and rebuild the predecessor in a separate directory using pinned release inputs, then use that result as the rollback executable.\n\n**Rejected because:** A replacement rollback build leaves original executable provenance unverified and changes rollback identity.\n\n## 9. References\n\n- **[[c1]]** `code` `scripts/insrc-daemon-install.sh`\n- **[[c2]]** `code` `src/shared/managed-daemon-installation.ts`\n- **[[c3]]** `code` `src/daemon/managed-update-recovery.ts`\n- **[[c4]]** `code` `src/daemon/managed-update-transaction.ts`\n- **[[c5]]** `code` `src/bin/insrc-daemon-control.ts`\n- **[[c6]]** `code` `src/daemon/legacy-launch-job.ts`\n- **[[c7]]** `code` `src/daemon/legacy-daemon-cutover.ts`\n- **[[c8]]** `code` `src/daemon/update-runner.ts`\n- **[[c9]]** `code` `src/daemon/admin-handlers.ts`\n- **[[c10]]** `code` `src/daemon/release-compatibility.ts`\n- **[[c11]]** `code` `src/daemon/index.ts`\n- **[[c12]]** `code` `src/shared/daemon-run-files.ts`\n- **[[c13]]** `code` `scripts/daemon-ctl.sh`\n- **[[c14]]** `prior-artifact` `ISSUE-5d5478c61a25ac8f`\n- **[[c20]]** `code` `src/daemon/managed-release-staging.ts`\n- **[[c21]]** `code` `src/daemon/managed-update-preparation.ts`\n- **[[c22]]** `prior-artifact` `BUILD-5d5478c61a25ac8f-s1`\n"},"capturedAt":"2026-11-12T19:34:28.614Z"},"inventory":{"units":[{"id":"/body/hldContextSlice","selector":"/body/hldContextSlice","title":"hldContextSlice","kind":"section"},{"id":"/body/summary","selector":"/body/summary","title":"summary","kind":"section"},{"id":"/body/contractDetails","selector":"/body/contractDetails","title":"contractDetails","kind":"section"},{"id":"/body/dataModelChanges","selector":"/body/dataModelChanges","title":"dataModelChanges","kind":"section"},{"id":"/body/interactionWithShared","selector":"/body/interactionWithShared","title":"interactionWithShared","kind":"section"},{"id":"/body/errorPaths","selector":"/body/errorPaths","title":"errorPaths","kind":"section"},{"id":"/body/testStrategy","selector":"/body/testStrategy","title":"testStrategy","kind":"section"},{"id":"/body/migration","selector":"/body/migration","title":"migration","kind":"section"},{"id":"/body/alternativesConsidered","selector":"/body/alternativesConsidered","title":"alternativesConsidered","kind":"section"},{"id":"/body/chosenAlternative","selector":"/body/chosenAlternative","title":"chosenAlternative","kind":"section"},{"id":"/body/openQuestions","selector":"/body/openQuestions","title":"openQuestions","kind":"section"},{"id":"/body/sequenceDefinition","selector":"/body/sequenceDefinition","title":"sequenceDefinition","kind":"visual"},{"id":"/body/companions","selector":"/body/companions","title":"companions","kind":"visual"},{"id":"/body/alternativesConsidered/0","selector":"/body/alternativesConsidered/0","title":"a1","kind":"requirement"},{"id":"/body/alternativesConsidered/1","selector":"/body/alternativesConsidered/1","title":"a2","kind":"requirement"},{"id":"/body/alternativesConsidered/2","selector":"/body/alternativesConsidered/2","title":"a3","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/0","selector":"/body/sequenceDefinition/participants/0","title":"release","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/1","selector":"/body/sequenceDefinition/participants/1","title":"entry","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/2","selector":"/body/sequenceDefinition/participants/2","title":"control","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/3","selector":"/body/sequenceDefinition/participants/3","title":"old","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/4","selector":"/body/sequenceDefinition/participants/4","title":"new","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/5","selector":"/body/sequenceDefinition/participants/5","title":"child","kind":"requirement"},{"id":"/citations/0","selector":"/citations/0","title":"Citation 1","kind":"citation"},{"id":"/citations/1","selector":"/citations/1","title":"Citation 2","kind":"citation"},{"id":"/citations/2","selector":"/citations/2","title":"Citation 3","kind":"citation"},{"id":"/citations/3","selector":"/citations/3","title":"Citation 4","kind":"citation"},{"id":"/citations/4","selector":"/citations/4","title":"Citation 5","kind":"citation"},{"id":"/citations/5","selector":"/citations/5","title":"Citation 6","kind":"citation"},{"id":"/citations/6","selector":"/citations/6","title":"Citation 7","kind":"citation"},{"id":"/citations/7","selector":"/citations/7","title":"Citation 8","kind":"citation"},{"id":"/citations/8","selector":"/citations/8","title":"Citation 9","kind":"citation"},{"id":"/citations/9","selector":"/citations/9","title":"Citation 10","kind":"citation"},{"id":"/citations/10","selector":"/citations/10","title":"Citation 11","kind":"citation"},{"id":"/citations/11","selector":"/citations/11","title":"Citation 12","kind":"citation"},{"id":"/citations/12","selector":"/citations/12","title":"Citation 13","kind":"citation"},{"id":"/citations/13","selector":"/citations/13","title":"Citation 14","kind":"citation"},{"id":"/citations/14","selector":"/citations/14","title":"Citation 15","kind":"citation"},{"id":"/citations/15","selector":"/citations/15","title":"Citation 16","kind":"citation"},{"id":"/citations/16","selector":"/citations/16","title":"Citation 17","kind":"citation"},{"id":"document:line:25","selector":"document:line:25","title":"1. HLD context","kind":"section"},{"id":"document:line:109","selector":"document:line:109","title":"4. Diagrams","kind":"section"}]},"completedChunks":[{"chunkId":"scope","status":"passed","summary":"The assigned scope and design choices align with the originating ISSUE. Fresh installation, supported updates, legacy and recovery jobs, direct installs, broker denial, rollback preservation and Linux compatibility are traced into the design and test strategy. The cited BUILD supports the motivation for portable qualification without establishing completed production qualification. No blocking defect was demonstrated in this chunk.","findings":[],"inspectedReferences":["/body/hldContextSlice","/body/summary","/body/alternativesConsidered","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/alternativesConsidered/2","/body/chosenAlternative","/body/openQuestions","/citations/13","/citations/16","document:line:25","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md",".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md:5-15",".insrc/artifacts/ISSUE-5d5478c61a25ac8f.json",".insrc/artifacts/ISSUE-3992d2e1e26124dc.json",".insrc/artifacts/BUILD-5d5478c61a25ac8f-s1.json:body.summary","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/TESTS.md:174-232","src/daemon/managed-release-staging.ts:99-153","scripts/insrc-daemon-install.sh:164-225",".insrc/tmp/design-review/macos-portable-qualification-5d5478c6.json"],"limitations":[],"advice":["The rendered summary still displays Epic and HLD metadata despite the explicit standalone context. Labeling these as framework bookkeeping would make the ISSUE ancestry clearer."]},{"chunkId":"qualification","status":"changes_requested","summary":"All assigned sections and citations were inspected against the originating ISSUE and current implementation. The design establishes appropriate qualification and rollback invariants, but leaves the native equivalence mechanism and trust lifecycle insufficiently specified for implementation.","findings":[{"id":"qualification-native-verifier","severity":"MED","location":"/body/contractDetails/api/0/postconditions","message":"The central portable-build mechanism remains a requirement rather than a concrete design. The LLD requires independently reconstructed native bytes and permits only proven non-semantic differences, but supplies no supported initial toolchain profile, verifier operations, reconstruction algorithm, or inventory rules that can accept the observed independently built native variants. The cited implementation only compares whole-tree fingerprints; it has no native equivalence mechanism to inherit. Its build also inherits compiler/environment inputs, while .npmrc permits both prebuilt and source-built dependencies. Specify the initial supported build inputs, complete runtime inventory, allowed native transformations and independent reference-generation procedure, together with positive variance and negative modification cases. Otherwise implementations can satisfy fail-closed rejection while still rejecting the ordinary source-built installs this change is intended to migrate.","evidenceReferences":["docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:52-54","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:175-179","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:192","src/daemon/managed-release-staging.ts:fingerprint, stageManagedRelease","build-process-broker.mjs:16-19",".npmrc","src/daemon/__tests__/managed-release-staging.test.ts:fixture"]},{"id":"qualification-trust-lifecycle","severity":"MED","location":"/body/contractDetails/api/0/preconditions; /body/dataModelChanges/2; /body/errorPaths/errorCases/5","message":"The trust lifecycle does not define how an updater determines that signed evidence is stale or revoked, or how that decision interacts with offline recovery. Shipping a trust key and requiring scoped rotation/revocation does not specify a trusted key-set format, revocation source, freshness or replay rule, or whether an already admitted transaction retains its authorization after key rotation or revocation. The current note reader checks source and commit only, and the durable compatibility receipt contains release-format declarations rather than a trust snapshot. Define the authenticated trust-state distribution, freshness policy, and durable receipt fields and recovery rules, including expiry or revocation between preparation, cutover and offline rollback. Add tests for those boundaries. Without this contract, implementations can either accept replayed authorization or strand an interrupted update by requiring unavailable remote evidence.","evidenceReferences":["docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:49","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:101","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:137-140","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:200","src/daemon/managed-update-preparation.ts:originQualification","src/daemon/managed-update-handoff.ts:97-108","src/daemon/release-compatibility.ts:qualifiedPairFromReservation"]}],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/body/errorPaths","/body/testStrategy","/body/migration","/citations/9","/citations/14","/citations/15","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md",".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json",".insrc/tmp/design-review/macos-portable-qualification-5d5478c6.json","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md","src/daemon/managed-release-staging.ts","src/daemon/managed-update-preparation.ts","src/daemon/release-compatibility.ts","src/daemon/managed-update-handoff.ts:1-175","src/daemon/managed-update-recovery.ts:1-215","src/shared/installation-mutation-gate.ts:1-125","src/daemon/__tests__/managed-release-staging.test.ts:1-120","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/TESTS.md:155-232","build-process-broker.mjs",".npmrc","package.json","copy-assets.mjs"],"limitations":[],"advice":["The proposed real-production-build promotion matrix appropriately exceeds the existing synthetic staging fixtures. Preserve that distinction when reporting qualification results; existing fixture passes do not establish native portability."]},{"chunkId":"lifecycle","status":"changes_requested","summary":"The assigned lifecycle sections cover activation, predecessor identification, drain classification, guard transfer and durable recovery. Rollback ordering reopens legacy mutation before the transaction has verified restoration and published its terminal outcome.","findings":[{"id":"lifecycle-rollback-launcher-fence","severity":"MED","location":"/body/errorPaths/errorCases/3/response; /body/migration/steps/6","message":"Rollback restores the canonical legacy launcher before restoring and verifying the previous service and publishing the durable rollback outcome. This re-enables precisely the old commands that the design says cannot honor the new reservation. A concurrent old restart, updater or installer can therefore enter during rollback, disrupt the restored service or mutate the pinned checkout; an interruption after launcher restoration also leaves an active reservation without its launcher fence. The cited recovery implementation follows this ordering: it settles the guard, restores the launcher, then restores the service, with outcome publication afterward. Keep legacy mutation fenced through verified restoration and durable outcome publication, defining a restricted rollback launch route or equivalent mechanism that can start the predecessor without reopening ordinary old commands. Add concurrent-operation and interruption tests at this boundary.","evidenceReferences":["docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:118","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:131","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:206","src/daemon/managed-update-recovery.ts:Rollback.run, rollback-legacy-service","src/daemon/legacy-cutover-admission.ts:restoreLegacyLauncher","src/daemon/managed-update-transaction.ts:settleManagedUpdate","src/daemon/update-runner.ts:resolveDaemonCtl, isUpdateInProgress"]}],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/body/interactionWithShared","/body/errorPaths","/body/testStrategy","/body/migration","/citations/1","/citations/2","/citations/3","/citations/4","/citations/5","/citations/6","/citations/10","/citations/11","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md",".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json",".insrc/tmp/design-review/macos-portable-qualification-5d5478c6.json","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md","src/shared/managed-daemon-installation.ts","src/shared/installation-mutation-gate.ts","src/shared/daemon-run-files.ts","src/daemon/managed-update-recovery.ts","src/daemon/managed-update-transaction.ts","src/bin/insrc-daemon-control.ts","src/daemon/legacy-launch-job.ts","src/daemon/legacy-daemon-cutover.ts","src/daemon/legacy-cutover-admission.ts","src/daemon/legacy-run-guard.ts","src/daemon/legacy-drain-evidence.ts","src/daemon/fresh-managed-activation.ts","src/daemon/managed-update-handoff.ts","src/daemon/managed-daemon-probation.ts","src/daemon/index.ts:startup and shutdown lifecycle","src/daemon/shutdown.ts","src/daemon/update-runner.ts:legacy helper launch and update marker","src/daemon/__tests__/managed-update-handoff.test.ts","src/daemon/__tests__/fresh-managed-activation.test.ts:activation recovery scenarios","src/daemon/__tests__/managed-update-transaction.test.ts:test inventory","src/daemon/__tests__/legacy-cutover-admission.test.ts:test inventory","src/daemon/__tests__/legacy-run-guard.test.ts:test inventory"],"limitations":[],"advice":[]},{"chunkId":"entrypoints","status":"changes_requested","summary":"The assigned sections cover installer/client routing, explicit start intent, older-client limitations, Linux preservation and release promotion tests. The first-upgrade bootstrap path leaves a gap in the required verification-before-execution trust boundary.","findings":[{"id":"entrypoints-bootstrap-before-verification","severity":"MED","location":"/body/migration/migrationSteps/1; /body/migration/migrationSteps/2","message":"The design routes first upgrades through the current standard installer but does not replace its unverified bridge bootstrap. That installer clones the configured branch, runs its npm installation/build instructions, and executes its newly built controller before prepareLegacyUpgrade fetches qualification evidence. Consequently, an unsigned or unauthorized configured source can execute code before stageManagedRelease enforces the stated rule that a source override grants no signing authority. Building outside the incumbent root does not constrain that code's access to the incumbent or user data. Specify a trusted bootstrap controller/verifier distributed with the installer or clients, and authenticate the exact bridge source before executing its build instructions or controller. Add an entrypoint test proving invalid or missing authorization prevents bridge execution.","evidenceReferences":["docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:201","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:202","LLD /body/contractDetails/api/0/preconditions/0","scripts/insrc-daemon-install.sh:217","scripts/insrc-daemon-install.sh:218","scripts/insrc-daemon-install.sh:223","src/daemon/managed-update-preparation.ts:prepareLegacyUpgrade, stageRelease, originQualification","src/daemon/__tests__/macos-upgrade-routing.test.ts:requireBridge"]}],"inspectedReferences":["/body/summary","/body/interactionWithShared","/body/errorPaths","/body/testStrategy","/body/migration","/citations/0","/citations/7","/citations/8","/citations/12","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md",".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json",".insrc/tmp/design-review/macos-portable-qualification-5d5478c6.json","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/TESTS.md","scripts/insrc-daemon-install.sh","scripts/daemon-ctl.sh","src/daemon/admin-handlers.ts","src/daemon/update-runner.ts","src/daemon/managed-update-preparation.ts","src/daemon/index.ts:managed update dispatch","src/bin/insrc-daemon-control.ts:activation, migration, dispatch and update entrypoints","src/shared/update-source.ts","src/cli/services/maintenance.ts:update","src/cli/services/daemon.ts:lifecycle call sites","vscode-plugin/src/daemon/controller.ts","vscode-plugin/src/daemon/commands.ts","vscode-plugin/src/extension.ts:freshness wiring","vscode-plugin/src/freshness/daemon-freshness.ts:performUpdate and confirmUpdate","jetbrains-plugin/src/main/kotlin/ai/insors/insrc/jetbrains/lifecycle/DaemonLifecycleService.kt:DefaultDaemonScriptLocator","jetbrains-plugin/src/main/kotlin/ai/insors/insrc/jetbrains/lifecycle/ScriptDaemonProvisioner.kt","jetbrains-plugin/src/main/kotlin/ai/insors/insrc/jetbrains/lifecycle/DaemonLifecycleCommandRunner.kt","jetbrains-plugin/src/main/kotlin/ai/insors/insrc/jetbrains/freshness/InstalledCommitFreshnessConsumer.kt:production wiring","jetbrains-plugin/src/main/kotlin/ai/insors/insrc/jetbrains/freshness/DaemonFreshnessFlow.kt:performUpdate","src/daemon/__tests__/macos-upgrade-routing.test.ts","src/daemon/__tests__/managed-release-staging.test.ts:fixture and scenario inventory","src/daemon/__tests__/linux-installed-lifecycle.test.ts","src/daemon/__tests__/fixtures/linux-installed-lifecycle.sh"],"limitations":[],"advice":["Specify how installer/controller outcome details reach IDE users while preserving existing result shapes. Current lifecycle adapters reduce nonzero exits to generic errors, obscuring verified rollback versus fenced uncertainty.","Keep synthetic routing/staging fixture results distinct from the newly required production-build promotion evidence. Test execution was not needed for this read-only design assessment."]},{"chunkId":"visuals","status":"incomplete","summary":"Inspected the complete sequence, all six participant descriptions, companion HTML and document reference against the lifecycle requirements. The generated source preserves the authored content. Actual rendering could not be verified. Relationship ownership is adequately described in prose; no additional ERD or UX mock is necessary.","findings":[{"id":"visuals-relative-companion-link","severity":"LOW","location":"docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:111","message":"The sequence link repeats the repository-relative directory inside a document already located in that directory. Standard Markdown resolution therefore points to a nonexistent nested path. Use sequence-diagram.html relative to LLD.md so readers can open the existing companion.","evidenceReferences":["docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:111","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html","Filesystem check: document-relative target absent; repository-relative companion present."]}],"inspectedReferences":["/body/sequenceDefinition","/body/sequenceDefinition/participants/0","/body/sequenceDefinition/participants/1","/body/sequenceDefinition/participants/2","/body/sequenceDefinition/participants/3","/body/sequenceDefinition/participants/4","/body/sequenceDefinition/participants/5","/body/companions","document:line:109","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/macos-portable-qualification-5d5478c6.json"],"limitations":["Mandatory visual verification of /Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html could not be completed: the browser tool reported that its access host is unavailable. HTML, Mermaid source and participant/message descriptions were inspected, but rendered legibility, clipping and layout remain unverified."],"advice":["Represent running versus stopped and success versus uncommitted failure as explicit alternative branches when the sequence format supports them. Current labels and descriptions convey the conditions, but the generated Mermaid places success before rollback in one numbered sequence; branch grouping would clarify the commit boundary and fenced uncertainty."]},{"chunkId":"consistency","status":"incomplete","summary":"Reconciled all five completed chunks against the current LLD and originating ISSUE. Every inventory selector has recorded inspection coverage, and current document and canonical fingerprints match the reviewed baseline. No additional cross-section defect was demonstrated. Existing MED findings remain applicable; mandatory rendered-diagram verification remains incomplete.","findings":[],"inspectedReferences":["/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/macos-portable-qualification-5d5478c6.json","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json","Checkpoint attempt 1: inventory and accepted completed feedback for scope, qualification, lifecycle, entrypoints and visuals","LLD.md:49-54, 81-107, 117-160, 168-208","Canonical LLD: /body/sequenceDefinition, /body/companions","scripts/insrc-daemon-install.sh:164-223","src/daemon/managed-update-recovery.ts:168-241","src/daemon/managed-update-transaction.ts:18-45"],"limitations":["Mandatory rendering verification remains outstanding for /Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html. The accepted visuals feedback records an unavailable browser access host; source inspection does not establish rendered legibility, clipping or layout."],"advice":["Retain qualification-native-verifier and qualification-trust-lifecycle: they jointly govern whether ordinary independently built predecessors can qualify and whether their authorization remains usable during offline recovery.","Retain entrypoints-bootstrap-before-verification: the installer bridge must obey the same verification-before-execution contract as release staging.","Retain lifecycle-rollback-launcher-fence across recovery prose, implementation contracts, tests and sequence descriptions; restoration must preserve exclusivity through verified restoration and durable outcome publication.","Retain visuals-relative-companion-link and the existing optional diagram branch-grouping advice. No additional ERD or UX artifact requirement was demonstrated.","Keep synthetic fixture results distinct from the proposed real macOS production-build qualification evidence."]}],"progress":{"status":"incomplete","phase":"complete","completedChunks":6,"totalChunks":6,"lastMeaningfulActivityAt":null,"activeToolCount":0,"requiresUserInput":false,"checkpointPath":"/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/macos-portable-qualification-5d5478c6.json","sequence":0,"reviewElapsedMs":0,"unitElapsedMs":null,"observedAt":"2026-11-12T19:44:06.060Z","freshness":"stored"},"startedAt":"2026-11-12T19:34:28.615Z","reviewer":"daemon","model":"gpt-6.1-sol","unit":{"unitId":"consistency","phase":"chunk_review","executionId":"02d8152d-943d-49a6-86d4-63d60a64a4aa","dispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[]},"plan":{"chunks":[{"id":"scope","title":"Issue traceability, supported scope and design choices","selectors":["/body/hldContextSlice","/body/summary","/body/alternativesConsidered","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/alternativesConsidered/2","/body/chosenAlternative","/body/openQuestions","/citations/13","/citations/16","document:line:25"],"concerns":["Read the originating ISSUE reproduction, root cause and fix intent; trace fresh installation, ordinary supported update, legacy job, recovery job, direct installation, broker denial, rollback preservation and Linux compatibility into the LLD.","Assess scope, non-goals, standalone ancestry, unresolved decisions and the rationale for release qualification versus exact fingerprints or rebuilt rollback releases.","Verify cited ISSUE and BUILD evidence where used without treating BUILD as mandatory upstream ancestry or requiring future workflow artifacts."],"dependsOn":[],"purpose":"substantive"},{"id":"qualification","title":"Release verification, portable build evidence and rollback pins","selectors":["/body/contractDetails","/body/dataModelChanges","/body/errorPaths","/body/testStrategy","/body/migration","/citations/9","/citations/14","/citations/15"],"concerns":["Inspect every assigned section, concentrating on stageManagedRelease, signed profile ownership and applicability, trust distribution and revocation, complete runtime inventory, independent reference measurements and exact rollback identity.","Check concrete feasibility of native build variance verification, supported toolchains, candidate verification, stable file ownership, tamper detection and offline recovery receipts against cited staging, preparation and compatibility code.","Assess qualification failure handling, historical compatibility, release publication order and test evidence for independent production builds, native variance and rejected modifications; retain the interfaces and tests with the verification logic."],"dependsOn":["scope"],"purpose":"substantive"},{"id":"lifecycle","title":"Activation, predecessor fencing, cutover and durable recovery","selectors":["/body/contractDetails","/body/dataModelChanges","/body/interactionWithShared","/body/errorPaths","/body/testStrategy","/body/migration","/citations/1","/citations/2","/citations/3","/citations/4","/citations/5","/citations/6","/citations/10","/citations/11"],"concerns":["Inspect every assigned section and cited lifecycle source, including completeLegacyMigration, activation reservations, predecessor variants, historical decoding and shared installation contracts.","Verify state-root ownership and cardinality, canonical checkout exchange, exclusion of old mutators, process and socket authentication, exact exit observation, drain classification and uninterrupted run-file guard transfer.","Trace fresh running and idle activation, managed running and stopped updates, legacy job/direct/stopped migration, partial publication cleanup, rollback launch reconstruction and durable outcome recovery.","Assess errors and tests alongside each transition, including broker-denied or unknown drain, candidate bootstrap failure, interruption, lost publication acknowledgement and fenced uncertainty."],"dependsOn":["qualification"],"purpose":"substantive"},{"id":"entrypoints","title":"Installer and client integration, rollout and acceptance coverage","selectors":["/body/summary","/body/interactionWithShared","/body/errorPaths","/body/testStrategy","/body/migration","/citations/0","/citations/7","/citations/8","/citations/12"],"concerns":["Inspect every assigned section and cited installer, shell, update runner and admin-handler source; follow necessary current CLI, VS Code and JetBrains call sites.","Check that supported ordinary installation and update actions reach preflight before shutdown, including updated freshness clients and the stated limitation of already-installed older binaries.","Verify configured source, branch, root, CLI flags and IPC result compatibility, explicit start intent, Linux preservation and practical release-to-migration dependency order.","Check acceptance mapping against the originating ISSUE and actual named scenarios, fixtures and release promotion obligations; assess whether user-facing outcomes distinguish verified success, rollback and uncertainty."],"dependsOn":["lifecycle"],"purpose":"substantive"},{"id":"visuals","title":"Sequence definition and generated diagram verification","selectors":["/body/sequenceDefinition","/body/sequenceDefinition/participants/0","/body/sequenceDefinition/participants/1","/body/sequenceDefinition/participants/2","/body/sequenceDefinition/participants/3","/body/sequenceDefinition/participants/4","/body/sequenceDefinition/participants/5","/body/companions","document:line:109"],"concerns":["Inspect the complete authored sequence, all participant descriptions, generated companion HTML and linked diagram reference.","Inspect actual rendering where available, checking legibility, participant identity, conditional running and stopped paths, ordering, commit boundary, rollback and uncertainty against the reviewed lifecycle.","Assess whether additional relationship or UX artifacts are necessary for this change; do not require diagrams solely by artifact size or claim visual verification from source alone.","Record unavailable mandatory rendering or linked-artifact inspection as a limitation rather than an artifact defect."],"dependsOn":["qualification","lifecycle","entrypoints"],"purpose":"substantive"},{"id":"consistency","title":"Whole-artifact consistency and upstream alignment","selectors":[],"concerns":["Reconcile all substantive assessments against the actual originating ISSUE, checking missing requirements, acceptance inconsistencies, unsupported scope changes and cross-chunk contradictions.","Check shared release, journal, pin, selector, process ownership and IPC contracts across qualification, activation, entry points, recovery, tests and rendered sequence.","Confirm every inventory selector was inspected or explicitly limited, citations support their claims, and applicable repository conventions are respected without inventing Epic or HLD ancestry.","Consolidate demonstrated findings, optional advice and mandatory verification limitations; apply the required status precedence."],"dependsOn":["scope","qualification","lifecycle","entrypoints","visuals"],"purpose":"consistency"}],"coverageExplanation":"Every inventory unit maps to at least one substantive chunk. Shared contract, model, error, test and migration sections deliberately overlap so each implementation responsibility retains its interfaces, logic, failure handling and verification. Each assigned section must be inspected in full. Chunks proceed from issue scope through release qualification, lifecycle mechanics, entry-point integration and visual verification, followed by one consistency chunk depending on every substantive chunk.","finalConsistencyChunkId":"consistency","coverage":[{"unitId":"/body/hldContextSlice","chunkIds":["scope"]},{"unitId":"/body/summary","chunkIds":["scope","entrypoints"]},{"unitId":"/body/contractDetails","chunkIds":["qualification","lifecycle"]},{"unitId":"/body/dataModelChanges","chunkIds":["qualification","lifecycle"]},{"unitId":"/body/interactionWithShared","chunkIds":["lifecycle","entrypoints"]},{"unitId":"/body/errorPaths","chunkIds":["qualification","lifecycle","entrypoints"]},{"unitId":"/body/testStrategy","chunkIds":["qualification","lifecycle","entrypoints"]},{"unitId":"/body/migration","chunkIds":["qualification","lifecycle","entrypoints"]},{"unitId":"/body/alternativesConsidered","chunkIds":["scope"]},{"unitId":"/body/chosenAlternative","chunkIds":["scope"]},{"unitId":"/body/openQuestions","chunkIds":["scope"]},{"unitId":"/body/sequenceDefinition","chunkIds":["visuals"]},{"unitId":"/body/companions","chunkIds":["visuals"]},{"unitId":"/body/alternativesConsidered/0","chunkIds":["scope"]},{"unitId":"/body/alternativesConsidered/1","chunkIds":["scope"]},{"unitId":"/body/alternativesConsidered/2","chunkIds":["scope"]},{"unitId":"/body/sequenceDefinition/participants/0","chunkIds":["visuals"]},{"unitId":"/body/sequenceDefinition/participants/1","chunkIds":["visuals"]},{"unitId":"/body/sequenceDefinition/participants/2","chunkIds":["visuals"]},{"unitId":"/body/sequenceDefinition/participants/3","chunkIds":["visuals"]},{"unitId":"/body/sequenceDefinition/participants/4","chunkIds":["visuals"]},{"unitId":"/body/sequenceDefinition/participants/5","chunkIds":["visuals"]},{"unitId":"/citations/0","chunkIds":["entrypoints"]},{"unitId":"/citations/1","chunkIds":["lifecycle"]},{"unitId":"/citations/2","chunkIds":["lifecycle"]},{"unitId":"/citations/3","chunkIds":["lifecycle"]},{"unitId":"/citations/4","chunkIds":["lifecycle"]},{"unitId":"/citations/5","chunkIds":["lifecycle"]},{"unitId":"/citations/6","chunkIds":["lifecycle"]},{"unitId":"/citations/7","chunkIds":["entrypoints"]},{"unitId":"/citations/8","chunkIds":["entrypoints"]},{"unitId":"/citations/9","chunkIds":["qualification"]},{"unitId":"/citations/10","chunkIds":["lifecycle"]},{"unitId":"/citations/11","chunkIds":["lifecycle"]},{"unitId":"/citations/12","chunkIds":["entrypoints"]},{"unitId":"/citations/13","chunkIds":["scope"]},{"unitId":"/citations/14","chunkIds":["qualification"]},{"unitId":"/citations/15","chunkIds":["qualification"]},{"unitId":"/citations/16","chunkIds":["scope"]},{"unitId":"document:line:25","chunkIds":["scope"]},{"unitId":"document:line:109","chunkIds":["visuals"]}]},"unitSummaries":[{"unitId":"planning","phase":"planning","automaticDispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[],"actionIds":[]},{"unitId":"scope","phase":"chunk_review","automaticDispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[],"actionIds":[]},{"unitId":"qualification","phase":"chunk_review","automaticDispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[],"actionIds":[]},{"unitId":"lifecycle","phase":"chunk_review","automaticDispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[],"actionIds":[]},{"unitId":"entrypoints","phase":"chunk_review","automaticDispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[],"actionIds":[]},{"unitId":"visuals","phase":"chunk_review","automaticDispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[],"actionIds":[]},{"unitId":"consistency","phase":"chunk_review","automaticDispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[],"actionIds":[]}],"report":{"reviewId":"macos-portable-qualification-5d5478c6","attempt":1,"artifactId":"LLD-5d5478c61a25ac8f-s1","status":"incomplete","counts":{"HIGH":0,"MED":4,"LOW":1},"chunks":[{"chunkId":"scope","status":"passed","summary":"The assigned scope and design choices align with the originating ISSUE. Fresh installation, supported updates, legacy and recovery jobs, direct installs, broker denial, rollback preservation and Linux compatibility are traced into the design and test strategy. The cited BUILD supports the motivation for portable qualification without establishing completed production qualification. No blocking defect was demonstrated in this chunk.","findings":[],"inspectedReferences":["/body/hldContextSlice","/body/summary","/body/alternativesConsidered","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/alternativesConsidered/2","/body/chosenAlternative","/body/openQuestions","/citations/13","/citations/16","document:line:25","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md",".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md:5-15",".insrc/artifacts/ISSUE-5d5478c61a25ac8f.json",".insrc/artifacts/ISSUE-3992d2e1e26124dc.json",".insrc/artifacts/BUILD-5d5478c61a25ac8f-s1.json:body.summary","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/TESTS.md:174-232","src/daemon/managed-release-staging.ts:99-153","scripts/insrc-daemon-install.sh:164-225",".insrc/tmp/design-review/macos-portable-qualification-5d5478c6.json"],"limitations":[],"advice":["The rendered summary still displays Epic and HLD metadata despite the explicit standalone context. Labeling these as framework bookkeeping would make the ISSUE ancestry clearer."]},{"chunkId":"qualification","status":"changes_requested","summary":"All assigned sections and citations were inspected against the originating ISSUE and current implementation. The design establishes appropriate qualification and rollback invariants, but leaves the native equivalence mechanism and trust lifecycle insufficiently specified for implementation.","findings":[{"id":"qualification-native-verifier","severity":"MED","location":"/body/contractDetails/api/0/postconditions","message":"The central portable-build mechanism remains a requirement rather than a concrete design. The LLD requires independently reconstructed native bytes and permits only proven non-semantic differences, but supplies no supported initial toolchain profile, verifier operations, reconstruction algorithm, or inventory rules that can accept the observed independently built native variants. The cited implementation only compares whole-tree fingerprints; it has no native equivalence mechanism to inherit. Its build also inherits compiler/environment inputs, while .npmrc permits both prebuilt and source-built dependencies. Specify the initial supported build inputs, complete runtime inventory, allowed native transformations and independent reference-generation procedure, together with positive variance and negative modification cases. Otherwise implementations can satisfy fail-closed rejection while still rejecting the ordinary source-built installs this change is intended to migrate.","evidenceReferences":["docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:52-54","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:175-179","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:192","src/daemon/managed-release-staging.ts:fingerprint, stageManagedRelease","build-process-broker.mjs:16-19",".npmrc","src/daemon/__tests__/managed-release-staging.test.ts:fixture"]},{"id":"qualification-trust-lifecycle","severity":"MED","location":"/body/contractDetails/api/0/preconditions; /body/dataModelChanges/2; /body/errorPaths/errorCases/5","message":"The trust lifecycle does not define how an updater determines that signed evidence is stale or revoked, or how that decision interacts with offline recovery. Shipping a trust key and requiring scoped rotation/revocation does not specify a trusted key-set format, revocation source, freshness or replay rule, or whether an already admitted transaction retains its authorization after key rotation or revocation. The current note reader checks source and commit only, and the durable compatibility receipt contains release-format declarations rather than a trust snapshot. Define the authenticated trust-state distribution, freshness policy, and durable receipt fields and recovery rules, including expiry or revocation between preparation, cutover and offline rollback. Add tests for those boundaries. Without this contract, implementations can either accept replayed authorization or strand an interrupted update by requiring unavailable remote evidence.","evidenceReferences":["docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:49","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:101","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:137-140","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:200","src/daemon/managed-update-preparation.ts:originQualification","src/daemon/managed-update-handoff.ts:97-108","src/daemon/release-compatibility.ts:qualifiedPairFromReservation"]}],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/body/errorPaths","/body/testStrategy","/body/migration","/citations/9","/citations/14","/citations/15","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md",".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json",".insrc/tmp/design-review/macos-portable-qualification-5d5478c6.json","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md","src/daemon/managed-release-staging.ts","src/daemon/managed-update-preparation.ts","src/daemon/release-compatibility.ts","src/daemon/managed-update-handoff.ts:1-175","src/daemon/managed-update-recovery.ts:1-215","src/shared/installation-mutation-gate.ts:1-125","src/daemon/__tests__/managed-release-staging.test.ts:1-120","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/TESTS.md:155-232","build-process-broker.mjs",".npmrc","package.json","copy-assets.mjs"],"limitations":[],"advice":["The proposed real-production-build promotion matrix appropriately exceeds the existing synthetic staging fixtures. Preserve that distinction when reporting qualification results; existing fixture passes do not establish native portability."]},{"chunkId":"lifecycle","status":"changes_requested","summary":"The assigned lifecycle sections cover activation, predecessor identification, drain classification, guard transfer and durable recovery. Rollback ordering reopens legacy mutation before the transaction has verified restoration and published its terminal outcome.","findings":[{"id":"lifecycle-rollback-launcher-fence","severity":"MED","location":"/body/errorPaths/errorCases/3/response; /body/migration/steps/6","message":"Rollback restores the canonical legacy launcher before restoring and verifying the previous service and publishing the durable rollback outcome. This re-enables precisely the old commands that the design says cannot honor the new reservation. A concurrent old restart, updater or installer can therefore enter during rollback, disrupt the restored service or mutate the pinned checkout; an interruption after launcher restoration also leaves an active reservation without its launcher fence. The cited recovery implementation follows this ordering: it settles the guard, restores the launcher, then restores the service, with outcome publication afterward. Keep legacy mutation fenced through verified restoration and durable outcome publication, defining a restricted rollback launch route or equivalent mechanism that can start the predecessor without reopening ordinary old commands. Add concurrent-operation and interruption tests at this boundary.","evidenceReferences":["docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:118","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:131","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:206","src/daemon/managed-update-recovery.ts:Rollback.run, rollback-legacy-service","src/daemon/legacy-cutover-admission.ts:restoreLegacyLauncher","src/daemon/managed-update-transaction.ts:settleManagedUpdate","src/daemon/update-runner.ts:resolveDaemonCtl, isUpdateInProgress"]}],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/body/interactionWithShared","/body/errorPaths","/body/testStrategy","/body/migration","/citations/1","/citations/2","/citations/3","/citations/4","/citations/5","/citations/6","/citations/10","/citations/11","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md",".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json",".insrc/tmp/design-review/macos-portable-qualification-5d5478c6.json","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md","src/shared/managed-daemon-installation.ts","src/shared/installation-mutation-gate.ts","src/shared/daemon-run-files.ts","src/daemon/managed-update-recovery.ts","src/daemon/managed-update-transaction.ts","src/bin/insrc-daemon-control.ts","src/daemon/legacy-launch-job.ts","src/daemon/legacy-daemon-cutover.ts","src/daemon/legacy-cutover-admission.ts","src/daemon/legacy-run-guard.ts","src/daemon/legacy-drain-evidence.ts","src/daemon/fresh-managed-activation.ts","src/daemon/managed-update-handoff.ts","src/daemon/managed-daemon-probation.ts","src/daemon/index.ts:startup and shutdown lifecycle","src/daemon/shutdown.ts","src/daemon/update-runner.ts:legacy helper launch and update marker","src/daemon/__tests__/managed-update-handoff.test.ts","src/daemon/__tests__/fresh-managed-activation.test.ts:activation recovery scenarios","src/daemon/__tests__/managed-update-transaction.test.ts:test inventory","src/daemon/__tests__/legacy-cutover-admission.test.ts:test inventory","src/daemon/__tests__/legacy-run-guard.test.ts:test inventory"],"limitations":[],"advice":[]},{"chunkId":"entrypoints","status":"changes_requested","summary":"The assigned sections cover installer/client routing, explicit start intent, older-client limitations, Linux preservation and release promotion tests. The first-upgrade bootstrap path leaves a gap in the required verification-before-execution trust boundary.","findings":[{"id":"entrypoints-bootstrap-before-verification","severity":"MED","location":"/body/migration/migrationSteps/1; /body/migration/migrationSteps/2","message":"The design routes first upgrades through the current standard installer but does not replace its unverified bridge bootstrap. That installer clones the configured branch, runs its npm installation/build instructions, and executes its newly built controller before prepareLegacyUpgrade fetches qualification evidence. Consequently, an unsigned or unauthorized configured source can execute code before stageManagedRelease enforces the stated rule that a source override grants no signing authority. Building outside the incumbent root does not constrain that code's access to the incumbent or user data. Specify a trusted bootstrap controller/verifier distributed with the installer or clients, and authenticate the exact bridge source before executing its build instructions or controller. Add an entrypoint test proving invalid or missing authorization prevents bridge execution.","evidenceReferences":["docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:201","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:202","LLD /body/contractDetails/api/0/preconditions/0","scripts/insrc-daemon-install.sh:217","scripts/insrc-daemon-install.sh:218","scripts/insrc-daemon-install.sh:223","src/daemon/managed-update-preparation.ts:prepareLegacyUpgrade, stageRelease, originQualification","src/daemon/__tests__/macos-upgrade-routing.test.ts:requireBridge"]}],"inspectedReferences":["/body/summary","/body/interactionWithShared","/body/errorPaths","/body/testStrategy","/body/migration","/citations/0","/citations/7","/citations/8","/citations/12","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md",".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json",".insrc/tmp/design-review/macos-portable-qualification-5d5478c6.json","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/TESTS.md","scripts/insrc-daemon-install.sh","scripts/daemon-ctl.sh","src/daemon/admin-handlers.ts","src/daemon/update-runner.ts","src/daemon/managed-update-preparation.ts","src/daemon/index.ts:managed update dispatch","src/bin/insrc-daemon-control.ts:activation, migration, dispatch and update entrypoints","src/shared/update-source.ts","src/cli/services/maintenance.ts:update","src/cli/services/daemon.ts:lifecycle call sites","vscode-plugin/src/daemon/controller.ts","vscode-plugin/src/daemon/commands.ts","vscode-plugin/src/extension.ts:freshness wiring","vscode-plugin/src/freshness/daemon-freshness.ts:performUpdate and confirmUpdate","jetbrains-plugin/src/main/kotlin/ai/insors/insrc/jetbrains/lifecycle/DaemonLifecycleService.kt:DefaultDaemonScriptLocator","jetbrains-plugin/src/main/kotlin/ai/insors/insrc/jetbrains/lifecycle/ScriptDaemonProvisioner.kt","jetbrains-plugin/src/main/kotlin/ai/insors/insrc/jetbrains/lifecycle/DaemonLifecycleCommandRunner.kt","jetbrains-plugin/src/main/kotlin/ai/insors/insrc/jetbrains/freshness/InstalledCommitFreshnessConsumer.kt:production wiring","jetbrains-plugin/src/main/kotlin/ai/insors/insrc/jetbrains/freshness/DaemonFreshnessFlow.kt:performUpdate","src/daemon/__tests__/macos-upgrade-routing.test.ts","src/daemon/__tests__/managed-release-staging.test.ts:fixture and scenario inventory","src/daemon/__tests__/linux-installed-lifecycle.test.ts","src/daemon/__tests__/fixtures/linux-installed-lifecycle.sh"],"limitations":[],"advice":["Specify how installer/controller outcome details reach IDE users while preserving existing result shapes. Current lifecycle adapters reduce nonzero exits to generic errors, obscuring verified rollback versus fenced uncertainty.","Keep synthetic routing/staging fixture results distinct from the newly required production-build promotion evidence. Test execution was not needed for this read-only design assessment."]},{"chunkId":"visuals","status":"incomplete","summary":"Inspected the complete sequence, all six participant descriptions, companion HTML and document reference against the lifecycle requirements. The generated source preserves the authored content. Actual rendering could not be verified. Relationship ownership is adequately described in prose; no additional ERD or UX mock is necessary.","findings":[{"id":"visuals-relative-companion-link","severity":"LOW","location":"docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:111","message":"The sequence link repeats the repository-relative directory inside a document already located in that directory. Standard Markdown resolution therefore points to a nonexistent nested path. Use sequence-diagram.html relative to LLD.md so readers can open the existing companion.","evidenceReferences":["docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:111","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html","Filesystem check: document-relative target absent; repository-relative companion present."]}],"inspectedReferences":["/body/sequenceDefinition","/body/sequenceDefinition/participants/0","/body/sequenceDefinition/participants/1","/body/sequenceDefinition/participants/2","/body/sequenceDefinition/participants/3","/body/sequenceDefinition/participants/4","/body/sequenceDefinition/participants/5","/body/companions","document:line:109","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/macos-portable-qualification-5d5478c6.json"],"limitations":["Mandatory visual verification of /Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html could not be completed: the browser tool reported that its access host is unavailable. HTML, Mermaid source and participant/message descriptions were inspected, but rendered legibility, clipping and layout remain unverified."],"advice":["Represent running versus stopped and success versus uncommitted failure as explicit alternative branches when the sequence format supports them. Current labels and descriptions convey the conditions, but the generated Mermaid places success before rollback in one numbered sequence; branch grouping would clarify the commit boundary and fenced uncertainty."]},{"chunkId":"consistency","status":"incomplete","summary":"Reconciled all five completed chunks against the current LLD and originating ISSUE. Every inventory selector has recorded inspection coverage, and current document and canonical fingerprints match the reviewed baseline. No additional cross-section defect was demonstrated. Existing MED findings remain applicable; mandatory rendered-diagram verification remains incomplete.","findings":[],"inspectedReferences":["/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/macos-portable-qualification-5d5478c6.json","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json","Checkpoint attempt 1: inventory and accepted completed feedback for scope, qualification, lifecycle, entrypoints and visuals","LLD.md:49-54, 81-107, 117-160, 168-208","Canonical LLD: /body/sequenceDefinition, /body/companions","scripts/insrc-daemon-install.sh:164-223","src/daemon/managed-update-recovery.ts:168-241","src/daemon/managed-update-transaction.ts:18-45"],"limitations":["Mandatory rendering verification remains outstanding for /Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html. The accepted visuals feedback records an unavailable browser access host; source inspection does not establish rendered legibility, clipping or layout."],"advice":["Retain qualification-native-verifier and qualification-trust-lifecycle: they jointly govern whether ordinary independently built predecessors can qualify and whether their authorization remains usable during offline recovery.","Retain entrypoints-bootstrap-before-verification: the installer bridge must obey the same verification-before-execution contract as release staging.","Retain lifecycle-rollback-launcher-fence across recovery prose, implementation contracts, tests and sequence descriptions; restoration must preserve exclusivity through verified restoration and durable outcome publication.","Retain visuals-relative-companion-link and the existing optional diagram branch-grouping advice. No additional ERD or UX artifact requirement was demonstrated.","Keep synthetic fixture results distinct from the proposed real macOS production-build qualification evidence."]}],"limitations":["Mandatory visual verification of /Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html could not be completed: the browser tool reported that its access host is unavailable. HTML, Mermaid source and participant/message descriptions were inspected, but rendered legibility, clipping and layout remain unverified.","Mandatory rendering verification remains outstanding for /Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html. The accepted visuals feedback records an unavailable browser access host; source inspection does not establish rendered legibility, clipping or layout."],"reviewer":"daemon","reviewedContentIdentity":"f7abd2f2be6bedd6765d93a1168c16646720944e1c75e1f3f22411a5b15e7974"},"finishedAt":"2026-11-12T19:44:06.060Z"},{"number":2,"status":"incomplete","preparationKind":"impact","baseline":{"subjectFingerprints":{"canonical":"edace99ebdf7847377bbe5c4d972917fa1f519f691ef3acc57b1dae9e7a9367c","document":"683045771401b9fb162c91fe1f8ae3f934717449773587837e1a55cf5e4fa866"},"contentIdentity":"ca1d273f2fd9c97d6f7fd825e196116601d2b63db4329132713d6ffd3a426b98","reviewedContent":{"canonical":"{\n  \"meta\": {\n    \"workflow\": \"design.story\",\n    \"runId\": \"wf-1794512795801-4ze5js\",\n    \"repoPath\": \"/Users/subhagho/work/projects/insors/insrc\",\n    \"createdAt\": \"2026-11-12T19:46:37.155Z\",\n    \"epicCreatedAt\": \"2026-11-11T16:00:50.440Z\",\n    \"attribution\": {\n      \"outputs\": [\n        {\n          \"role\": \"(client)\",\n          \"tier\": \"core\",\n          \"runner\": \"cli-codex\",\n          \"model\": \"unknown\"\n        }\n      ]\n    },\n    \"elapsedMs\": 1064,\n    \"repoIndexedAt\": null,\n    \"schemaVersion\": 1,\n    \"epicHash\": \"5d5478c61a25ac8f\",\n    \"epicSlug\": \"enable-managed-daemon-lifecycle-macos-install\",\n    \"storyId\": \"s1\",\n    \"hldBaseRunId\": \"wf-1794512795801-4ze5js\",\n    \"hldEffectiveHash\": \"4ce5917d447b339193312ec905234ddbd7e4810747690e61414678dc942ad7c6\",\n    \"hldAmendmentsApplied\": [],\n    \"storyTitle\": \"Enable managed daemon lifecycle on macOS install and upgrade\",\n    \"standalone\": true,\n    \"authoredBy\": \"controller\",\n    \"lifecycle\": {\n      \"status\": \"draft\",\n      \"revision\": {\n        \"number\": 4,\n        \"contentHash\": \"2eafabd4bde74ec900b66d6a0f68c85fe18fb7f21ba83ca3dbce61d890a9d21e\",\n        \"at\": \"2026-11-12T19:46:37.268Z\",\n        \"by\": {\n          \"id\": \"insrc:system\",\n          \"kind\": \"system\",\n          \"properties\": {}\n        }\n      },\n      \"signoffs\": []\n    },\n    \"envelope\": {\n      \"attachments\": []\n    },\n    \"revision\": 4\n  },\n  \"body\": {\n    \"hldContextSlice\": {\n      \"frameworkSummary\": \"Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\",\n      \"ownedContracts\": [],\n      \"consumedContracts\": [],\n      \"boundary\": {\n        \"storyId\": \"s1\",\n        \"owns\": [],\n        \"depends\": [],\n        \"internal\": \"Enable managed daemon lifecycle on macOS install and upgrade\"\n      },\n      \"adjacentBoundaries\": [],\n      \"rolloutPhase\": \"standalone\",\n      \"nonFunctional\": {}\n    },\n    \"summary\": {\n      \"audience\": \"product\",\n      \"prose\": \"The normal macOS installer provisions a per-user supervisor and automatically migrates supported locally built installs. Before cutover the updater verifies the incumbent against release-authorized build evidence and pins its original bytes for rollback. Existing configuration, stores and running state survive a verified rollback.\"\n    },\n    \"contractDetails\": {\n      \"surfaceLevel\": \"internal-shared\",\n      \"api\": [\n        {\n          \"name\": \"stageManagedRelease\",\n          \"signature\": \"stageManagedRelease(options: StageOptions): Promise<{ readonly candidate: StagedReleasePin; readonly prior?: StagedReleasePin; readonly compatibility?: QualifiedReleasePair }>\",\n          \"parameters\": [\n            {\n              \"name\": \"options\",\n              \"type\": \"StageOptions\",\n              \"purpose\": \"Carries the configured source, exact release pair, authorized build evidence and optional incumbent.\",\n              \"optional\": false\n            }\n          ],\n          \"returns\": {\n            \"type\": \"Promise<{ readonly candidate: StagedReleasePin; readonly prior?: StagedReleasePin; readonly compatibility?: QualifiedReleasePair }>\",\n            \"meaning\": \"Verified candidate and optional byte-exact original rollback pin.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"Error\",\n              \"condition\": \"Missing or invalid signed evidence, unsupported build profile, unaccounted executable differences, ambiguous inventory or unstable pin.\"\n            }\n          ],\n          \"preconditions\": [\n            \"The official installer script and IDE-bundled copies carry the same dependency-free Node verifier and pinned offline release root. An installed managed controller can reuse its verified copy. Fetch into a fresh owner-private bare Git directory with external hooks, checkout filters and config injection disabled. Before checkout, npm scripts, build, or launch of a downloaded bridge, the trusted verifier validates the signed source/branch/full commit and expected Git tree, approved build inputs and release policy. A configured URL override changes routing only. Never obtain the first verifier or root from the fetched branch.\",\n            \"Use separately root-signed UTF-8 trust data, and per-channel Ed25519 qualification keys authorized by that data. Verify signatures over exact length-framed UTF-8 payload bytes with distinct trust and qualification domain tags. Enforce strict versioned schemas and limits and reject duplicate keys. Trust data records monotonic epoch, permitted source and branch per key, key ID and public key, validity window and revocations. The root is pinned in the official distribution. Root rotation requires an updated trusted distribution. Production verifier trust excludes fixture keys.\"\n          ],\n          \"postconditions\": [\n            \"Refresh root-signed trust data from the configured release channel during preparation and within five minutes before the first cutover mutation. Trust data is valid for at most 24 hours. Validate the UTC window, key status and epoch against an owner-private durable floor advanced atomically under admission. If the same epoch arrives with different bytes, the local clock has rolled behind the stored valid-time floor, or signed trust data is unavailable, refuse admission. Qualification carries key ID, release source, exact current branch head and Git tree, ordered release pair, validity window, supported profile and immutable release-test receipt digests. A revoked key, expired qualification, stale trust epoch or changed candidate prevents cutover.\",\n            \"Initial profile targets the measured arm64 macOS 27.0 installation class and predecessor ab6a96296ea6f2bde948636424218c0a23136c74. Reference inputs pin Node 22.23.2 with ABI 127, npm 10.9.8, node-gyp 11.5.0, Node 22.22.1 headers, Apple Clang 21.0.0 build 2100.3.34.2, Command Line Tools 27.0.0.0.1788430756, SDK 27.0, Python 3.12.6, -std=c++17 and exact Git tree and lockfile. Release authority records digests for tools, SDK/headers, dependencies, prebuilds and environment allowlist. It produces references from two clean installer builds at separate real paths, with pinned inputs and controlled network dependency retrieval. Each supported optional dependency layout is inventoried and qualifies separately. No profile ships before the real product matrix confirms these inputs and the target incumbent.\",\n            \"Inventory exact relative paths, type, permitted modes, symlink targets, and digests for the Node runtime, the executable closure in out and node_modules, project-memory dist, scripts used by the daemon or supported entry points, and build/package configuration used by those entry points. Walk by stable owned file handles without following unapproved links. Reject extra or missing execution-bearing files, escaped links or ambiguous optional package layouts. Default to raw SHA-256. A signed profile may explicitly enumerate inert build leftovers with their expected formats and paths. Generated Makefile, gyp and dependency records, intermediate Mach-O object/static library files and npm bookkeeping are eligible only if a verified runtime or rollback path never reads or executes them. Validate their types and allowlisted formats and retain every byte in the raw pin. Optional JavaScript or WASM packages are executable and use a separately qualified exact inventory.\",\n            \"Native equivalence is limited initially to the signed exact paths of the fs-ext, tree-sitter, tree-sitter-sql and tree-sitter-kotlin thin arm64 bundles observed in the native study. Strictly parse and bound the complete Mach-O, validate all commands and ranges without overlaps and reject unsupported variants. Compare all code, mapped data, padding, loader commands and binding, rebase, export, relocations and indirect-symbol tables exactly except validated representations of known metadata. Compare symbol indices, types, sections, flags, values and decoded names, with only N_SO source roots and N_OSO object roots and timestamps mapped to fixed tokens for expected debug-only records. Confirm no runtime table references these records. Verify that every other string and byte is accounted for, with validated offsets, size and alignment of __LINKEDIT tables and signature. Accept only the observed linker-signed ad hoc CodeDirectory form after verifying all page hashes, expected identity, flags and absence of extra slots or entitlements. Its generated page hashes and LC_UUID are the only remaining variable values. Digest the resulting versioned representation against the signed reference. Reject any unexpected executable, section, metadata, entitlement, symbol or unclassified byte change.\",\n            \"After independent verification capture and retain a byte-exact digest of every installed runtime and allowed inert file, including portable verifier metadata. Journal the raw incumbent and candidate pins and the signed evidence digest with the exact update before fencing. Recheck raw bytes and identities on both sides of the fence and before rollback. Build the authenticated candidate with the qualified inputs, and verify its signed inventory before executing its installed controller or daemon.\"\n          ]\n        },\n        {\n          \"name\": \"completeLegacyMigration\",\n          \"signature\": \"completeLegacyMigration(gate: InstallationMutationGate, update: UpdateReservation, pins: ManagedUpdatePins): Promise<DaemonUpdateOutcome>\",\n          \"parameters\": [\n            {\n              \"name\": \"gate\",\n              \"type\": \"InstallationMutationGate\",\n              \"purpose\": \"Owns the cutover and recovery reservation.\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"update\",\n              \"type\": \"UpdateReservation\",\n              \"purpose\": \"Identifies verified predecessor, release, fence and desired state.\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"pins\",\n              \"type\": \"ManagedUpdatePins\",\n              \"purpose\": \"Carries the qualified prior and candidate releases.\",\n              \"optional\": false\n            }\n          ],\n          \"returns\": {\n            \"type\": \"Promise<DaemonUpdateOutcome>\",\n            \"meaning\": \"Verified committed cutover, verified rollback, or fenced recovery.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"SupervisorLifecycleError\",\n              \"condition\": \"A release, launch route, exact exit, or recovery state cannot be verified.\"\n            }\n          ],\n          \"preconditions\": [\n            \"Use the migration-capable installer or updater to prepare the release before invoking any shutdown path. Freeze the canonical legacy launch and checkout paths and verify old mutating helpers are absent before cutover. Verify the pinned predecessor and public socket before sending shutdown.\"\n          ],\n          \"postconditions\": [\n            \"Preserve the original raw pin, job policy and stopped or running intent. Keep the canonical dispatcher fenced during candidate cleanup, selector reconciliation, predecessor launch and readiness verification, and until the rollback outcome and receipt are durable.\",\n            \"For a prior running install, the reservation owner alone may use the private, byte-pinned archived checkout. Reconstruct direct argv and cwd or a private launchd descriptor, mapping only pre-recorded checkout-contained executable/script/cwd paths from the captured inode to its archived location. Preserve UID, domain, label, argument order, runtime, state-root environment and RunAtLoad/KeepAlive policy. Verify the actual registered job and socket peer before recording readiness. A previously stopped job stays passive. Refuse ambiguous mapping and retain the fence.\",\n            \"Publish the terminal rollback outcome and verified legacy route together before enabling normal access. Keep a guarded canonical dispatcher after rollback. It can select the archived release only for the verified terminal receipt, route restart and update through the same gate, and support a later managed retry without releasing the old mutating scripts. Keep the archived location stable for the live job. Journal dispatch publication separately so interrupted settlement can reconcile without another spawn. Verify exact child or idle state and preserve a committed candidate without rollback.\"\n          ]\n        },\n        {\n          \"name\": \"stageManagedInstallation\",\n          \"signature\": \"stageManagedInstallation(installation: ManagedInstallation, revalidate: () => Promise<void>, legacyCutover?: boolean): Promise<void>\",\n          \"parameters\": [\n            {\n              \"name\": \"installation\",\n              \"type\": \"ManagedInstallation\",\n              \"purpose\": \"Identifies the owned state root, release, runtime and selector.\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"revalidate\",\n              \"type\": \"() => Promise<void>\",\n              \"purpose\": \"Verifies transaction ownership before a write.\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"legacyCutover\",\n              \"type\": \"boolean\",\n              \"purpose\": \"Selects staging for a verified predecessor.\",\n              \"optional\": true\n            }\n          ],\n          \"returns\": {\n            \"type\": \"Promise<void>\",\n            \"meaning\": \"Writes the staged disabled selector and its descriptor only.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"SupervisorLifecycleError\",\n              \"condition\": \"Selector, descriptor, or state root conflicts with the reservation.\"\n            }\n          ],\n          \"preconditions\": [\n            \"The installer controller owns an activation reservation with the explicit start intent and candidate pin. It has verified the canonical root, GUI launchd domain and quiescent fresh state.\"\n          ],\n          \"postconditions\": [\n            \"The installer controller journals descriptor and provisional-selector publication, exact job registration and idle handshake, and optional child readiness. Enable the selector under the reservation before controller admission. Release the reservation only after a verified idle or running result is durable. --no-start leaves an enabled selector and an idle supervisor. Recovery replays an exact matching partial pair or removes only artifacts created by the activation and restores prior absence.\"\n          ]\n        },\n        {\n          \"name\": \"launchManagedUpdate\",\n          \"signature\": \"launchManagedUpdate(entry: string, args: readonly string[], awaitReply: () => Promise<boolean>): Promise<{ launched: true; updateId: string }>\",\n          \"parameters\": [\n            {\n              \"name\": \"entry\",\n              \"type\": \"string\",\n              \"purpose\": \"Pins the detached controller executable.\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"args\",\n              \"type\": \"readonly string[]\",\n              \"purpose\": \"Carries the owned release and operation inputs.\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"awaitReply\",\n              \"type\": \"() => Promise<boolean>\",\n              \"purpose\": \"Confirms that the update acknowledgement was written.\",\n              \"optional\": false\n            }\n          ],\n          \"returns\": {\n            \"type\": \"Promise<{ launched: true; updateId: string }>\",\n            \"meaning\": \"Returns the admitted update identity while the helper owns completion.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"SupervisorLifecycleError\",\n              \"condition\": \"An update is already active or the helper cannot qualify the candidate.\"\n            }\n          ],\n          \"preconditions\": [\n            \"The running managed daemon routes daemon.update to the transactional helper after candidate preparation and retains its response-written handshake. Shell and TUI update have a local controller route for a stopped installation.\"\n          ],\n          \"postconditions\": [\n            \"Managed updates use the same release preparation and transaction for running and stopped cases. A stopped install stays stopped. Preserve existing IPC result shapes and omit the legacy self-shutdown timer for managed requests.\"\n          ]\n        }\n      ]\n    },\n    \"dataModelChanges\": [\n      {\n        \"entity\": \"InstallationMutationGate activation reservation\",\n        \"change\": \"field-add\",\n        \"details\": \"Persist one activation reservation per state root with exact owner, candidate and explicit start intent. Journal descriptor, provisional selector, exact registration, child admission, readiness and terminal outcome with identities. Previous journals remain decodable. Activation cleanup reverses only receipted owned mutations.\",\n        \"callSites\": [\n          \"src/shared/installation-mutation-gate.ts\",\n          \"src/shared/managed-daemon-installation.ts\",\n          \"src/bin/insrc-daemon-control.ts\"\n        ]\n      },\n      {\n        \"entity\": \"UpdatePredecessor\",\n        \"change\": \"invariant-change\",\n        \"details\": \"Persist a tagged managed, legacy-job, legacy-direct, or legacy-stopped predecessor. All variants bind canonical state root, prior release/runtime and candidate pin, selector baseline or absence, and prior running state. Managed carries supervisor generation. Legacy-job carries descriptor path/hash, verified label, UID, launchd domain, program argv, working directory and RunAtLoad policy. Running legacy-job and legacy-direct carry exact process incarnation, authenticated socket peer and pinned PID/socket identities. Legacy-direct also carries rollback argv, cwd and a release-qualified environment recipe reconstructed from the supported launcher, without persisting credentials. Legacy-stopped carries proof of no live process and either a pinned idle job or verified absence. Decode historical predecessor.legacy as legacy-job and older enabled prior without legacy as managed. Reject unknown or contradictory variants. Persist each observed exit, its drain classification, and ownership-fence evidence before candidate bootstrap. A rollback route maps only verified original checkout-relative argv/cwd paths into the archived directory. It binds a single archived release and recorded job or direct launch to the update and keeps the canonical launcher fenced until terminal evidence.\",\n        \"callSites\": [\n          \"src/shared/installation-mutation-gate.ts\",\n          \"src/daemon/managed-update-recovery.ts\",\n          \"src/daemon/legacy-launch-job.ts\",\n          \"src/daemon/legacy-daemon-cutover.ts\"\n        ]\n      },\n      {\n        \"entity\": \"Release qualification profile and exact rollback pin\",\n        \"change\": \"invariant-change\",\n        \"details\": \"The release authority owns a signed, versioned profile for one configured source, ordered commit pair and tested build profile. A release pair can have multiple profiles. Exactly one applicable profile must verify a particular installation. An update reservation owns one verified profile receipt and one exact incumbent pin and binds both to its candidate, selector and state root. The profile verifies a complete measured inventory and accounts for variability. The local pin freezes raw bytes for rollback, and the receipt is reusable during recovery without remote network access. Historical journals retain their original verification rules. Versioned notes that lack the required portable proof cannot qualify a source-built variant. Record one immutable admission receipt per update with signing key, trust epoch and payload digest, verification time, qualification and reference digests, commit/tree pair, source, release profile, raw pins and exact update ID. Before a recorded fence, expiry, refresh failure or revocation forces refusal. After the fence, the recorded decision applies only to that transaction while its owner settles it within its admitted authorization window. If recovery begins without a durable success, it can verify and roll back offline using the receipt and raw pin. It needs fresh authorization to newly activate a candidate. If revocation is known before a new candidate activation, roll back. Durable success is reconciled offline and is never reinterpreted as uncommitted.\",\n        \"callSites\": [\n          \"src/daemon/managed-release-staging.ts\",\n          \"src/daemon/managed-update-preparation.ts\",\n          \"src/daemon/release-compatibility.ts\",\n          \"src/daemon/managed-update-recovery.ts\"\n        ]\n      }\n    ],\n    \"interactionWithShared\": [],\n    \"errorPaths\": {\n      \"errorCases\": [\n        {\n          \"scenario\": \"An older launcher or updater can still mutate the legacy install\",\n          \"detection\": \"Resolve the canonical checkout and every supported launch route. Atomically exchange the canonical checkout entry with a gate-aware dispatcher on the same filesystem while the old daemon is still running. Preserve the displaced checkout separately. Before stopping, verify the dispatcher and archived checkout identities, an absent or owned legacy update marker, and absence of known old shell, detached helper and installer processes bound to the retired root, using verified argv and cwd. Repeat admission after the swap. An unrecognized launch path, unresolved process identity, live old mutator, or exchange failure makes exclusivity unproven.\",\n          \"response\": \"The dispatcher rejects concurrent mutation while cutover owns the reservation. Qualify only predecessors that acquire the shared run-file guard before opening data and whose shipped old commands use the canonical absolute entry. Keep that guard through owned cleanup and transfer it to candidate startup before the legacy route can reacquire it. Refuse when another legacy route cannot be fenced. Preserve or restore the old service before releasing a failed admission.\",\n          \"userImpact\": \"The supported update retries safely after a concurrent operation ends.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Predecessor job or runtime does not match the qualified route\",\n          \"detection\": \"Match the verified launchd registration against its owned descriptor bytes and approved exact argv. Match direct socket peer and executable against the qualified launch recipe. Accept the documented recovery LaunchAgent only with its pinned tsx loader arguments, canonical entry, matching working directory, bounded owned descriptor and passive restart policy.\",\n          \"response\": \"Reject foreign jobs, unknown loaders or args, conflicting restart policy and unverifiable direct rollback settings before disruption. Recheck the descriptor, PID incarnation and run-file identities immediately before each action.\",\n          \"userImpact\": \"The updater reports the unsupported predecessor while preserving the current service.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Exit is unconfirmed or graceful drain cannot be classified\",\n          \"detection\": \"Observe the exact predecessor exit independently of the broker and bind any qualified terminal evidence to the authenticated shutdown request and process incarnation. An RPC acknowledgement, socket close, PID disappearance, or generic log entry alone does not prove a graceful drain.\",\n          \"response\": \"Withhold candidate admission until exact exit is proved. Journal the exit plus graceful, broker-denied, or unknown. Use graceful only for a qualified positive completion signal, broker-denied only for correlated watchdog evidence, and unknown otherwise. Both broker-denied and unknown require a release pair explicitly qualified for crash-consistent reopening. Report the observed classification in the update detail.\",\n          \"userImpact\": \"The user can distinguish a verified shutdown from an exit whose drain could not be confirmed.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Candidate bootstrap or readiness fails before a durable outcome\",\n          \"detection\": \"Registration, startup generation, owned run files, or candidate idle/readiness cannot be verified.\",\n          \"response\": \"Reconcile the candidate under the reservation, Keep the canonical dispatcher fenced while restoring the predecessor via the archived route. Publish verified rollback before enabling guarded ordinary commands. Retain a fence when restoration is unverified.\",\n          \"userImpact\": \"Verified rollback restores the previous service state and reports the failed update.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Outcome publication throws or its acknowledgement is lost\",\n          \"detection\": \"Publication fails, or retry sees an active reservation without a verified terminal reply.\",\n          \"response\": \"Keep the reservation. Re-read the exact matching durable outcome through existing recovery. A durable success verifies or completes activation without rollback. A durable rollback verifies the old state. Only a proven uncommitted transaction can unwind. Unknown ownership remains fenced.\",\n          \"userImpact\": \"The updater reports an unconfirmed result until recovery determines the terminal state.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Release qualification is missing, ambiguous, stale, revoked or invalid\",\n          \"detection\": \"Reject absent note, invalid signature or key, unsupported profile or verifier version, source or commit mismatch, conflicting profiles and any unaccounted runtime difference.\",\n          \"response\": \"Report the failed verification before any incumbent shutdown, fence or selector mutation. Discard only owned preparation artifacts and preserve the incumbent.\",\n          \"userImpact\": \"The daemon remains available with an update diagnostic and can retry after a qualified release is published.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Installed runtime changes after independent verification\",\n          \"detection\": \"Recheck the original raw digest and exact file identities while holding update admission at the designated cutover and rollback boundaries.\",\n          \"response\": \"Stop cutover before touching the incumbent when possible. After mutation use the existing exact rollback or fenced recovery. Refuse to execute any changed rollback copy.\",\n          \"userImpact\": \"The update fails with a verification diagnostic.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Legacy mutation competes with rollback or cutover authorization expires\",\n          \"detection\": \"Read the admitted trust receipt and launcher fence identities. Detect a concurrent old command through the guarded canonical route or a fresh candidate admission after expiry or revocation.\",\n          \"response\": \"Reject the old command. Use only the private archive route for rollback, verify the prior state, publish terminal evidence, then permit guarded dispatch. If admission is no longer valid, recover offline by rollback unless the candidate already has a verified durable success.\",\n          \"userImpact\": \"The previous verified service is restored or the installation remains fenced for recovery.\",\n          \"recoverable\": true\n        }\n      ],\n      \"edgeCases\": [\n        {\n          \"input\": \"Fresh --no-start\",\n          \"expected\": \"Register the supervisor, enable the selector and verify idle with no daemon child. Subsequent normal start uses the same supervisor.\"\n        },\n        {\n          \"input\": \"Already-managed update when the daemon is stopped\",\n          \"expected\": \"The external controller prepares and commits the update using supervisor status; no daemon RPC is required. Keep the candidate idle.\"\n        },\n        {\n          \"input\": \"Legacy daemon remains running while the candidate is staged\",\n          \"expected\": \"Build outside the live root, preserve the running predecessor and only then acquire a cutover reservation. Failed fetch, build, or qualification leaves the running install unchanged.\"\n        },\n        {\n          \"input\": \"An unchanged older shell or IDE freshness client invokes legacy restart or daemon.update\",\n          \"expected\": \"An old client cannot acquire new preflight behavior before executing its existing shutdown sequence. The first upgrade is delivered by the current standard installer or the ordinary update action in updated IDE clients. The installer may be rerun on an existing installation without launchctl or file edits. Never present an old acknowledgement as migration success.\"\n        },\n        {\n          \"input\": \"Two qualified installs share a commit but have different build paths or raw native artifact bytes\",\n          \"expected\": \"Each matches independent expected execution-bearing bytes under the same tested profile and retains its own raw exact pin.\"\n        }\n      ],\n      \"invariantsToPreserve\": [\n        {\n          \"text\": \"One state root has at most one daemon process admitted to use its stores.\",\n          \"source\": \"c2\"\n        },\n        {\n          \"text\": \"Committed success is never rolled back because the publication reply was lost.\",\n          \"source\": \"c4\"\n        },\n        {\n          \"text\": \"Linux keeps its current lifecycle and update behavior.\",\n          \"source\": \"c1\"\n        }\n      ]\n    },\n    \"testStrategy\": {\n      \"testLevels\": [\n        {\n          \"level\": \"unit\",\n          \"purpose\": \"Verify admission, qualification, journal compatibility and outcome recovery.\",\n          \"subjects\": [\n            \"Predecessor variants and backward decoding\",\n            \"Explicit fresh activation start intent and owned partial publication\",\n            \"Release provenance, changed bytes and absent legacy declaration\",\n            \"Graceful, broker-denied and unknown drain evidence\",\n            \"Uncertain publication with durable success versus no outcome\"\n          ]\n        },\n        {\n          \"level\": \"integration\",\n          \"purpose\": \"Drive supported entry points and competing legacy operations through the real controller boundaries.\",\n          \"subjects\": [\n            \"Installer and updated CLI, VS Code and JetBrains route matrix\",\n            \"Running managed update IPC and stopped local managed update\",\n            \"Old shell/helper concurrent with canonical launcher exchange and old child attempting to open stores\",\n            \"Startup guard transfer, candidate bootstrap failure, rollback and repeated recovery\",\n            \"Linux normal install, update and restart unchanged\"\n          ]\n        },\n        {\n          \"level\": \"smoke\",\n          \"purpose\": \"Verify actual launchd and daemon state on macOS.\",\n          \"subjects\": [\n            \"Fresh install and verified ordinary restart\",\n            \"Fresh --no-start and later supervisor start\",\n            \"First supported update of a qualified prior build with broker denial\",\n            \"Direct install and passive recovery job with exact loader argv\",\n            \"Verified stopped and running rollback with configuration and store integrity\"\n          ],\n          \"fixturesNeeded\": [\n            \"Disposable macOS state roots and isolated launchd labels\",\n            \"Pinned released predecessors, including the regression and clean-drain cases\"\n          ]\n        },\n        {\n          \"level\": \"contract\",\n          \"purpose\": \"Verify release signatures, independent expected inventory, applicability, exact runtime coverage, and report provenance.\",\n          \"subjects\": [\n            \"Independent same-commit macOS build equivalence and tamper rejection\",\n            \"Changed native code, loadable data, bindings, signature policy, injected modules, symlinks and unidentified variance fail closed\",\n            \"Missing or stale release evidence prevents promotion and leaves the incumbent running\"\n          ]\n        },\n        {\n          \"level\": \"smoke\",\n          \"purpose\": \"Require real product builds before promoting a source-built profile.\",\n          \"subjects\": [\n            \"Release publication validates real running and stopped upgrades for every enabled profile\",\n            \"Real product passive and recovery job loader arguments, verified broker refusal, data-preserving rollback and subsequent managed update\"\n          ],\n          \"fixturesNeeded\": [\n            \"Two independent production installer builds of the same supported predecessor in different homes with observed native variance\",\n            \"Real predecessor and candidate installs using disposable homes and distinct launchd jobs\",\n            \"Qualification from an isolated release authority, plus immutable test receipts bound to promoted release metadata\"\n          ]\n        },\n        {\n          \"level\": \"integration\",\n          \"purpose\": \"Prove trust ordering and rollback fences at the real controller boundaries.\",\n          \"subjects\": [\n            \"Trust rotation, expiry, replay and offline rollback at the fence boundary\",\n            \"Invalid or missing authorization prevents bootstrap checkout execution, npm scripts and bridge invocation\",\n            \"A competing legacy command and interruption during rollback cannot reopen the launcher before durable outcome\"\n          ],\n          \"fixturesNeeded\": [\n            \"A trusted installer and distinct trusted/unauthorized signed Git origins with executable marker probes\",\n            \"A real archived legacy daemon, fresh and expired signed trust epochs, and controller crash points before outcome and before guarded dispatch\"\n          ]\n        }\n      ],\n      \"acceptanceMapping\": [\n        {\n          \"criterionId\": \"ac1\",\n          \"provingTests\": [\n            \"Fresh install and verified ordinary restart\",\n            \"Fresh --no-start and later supervisor start\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac2\",\n          \"provingTests\": [\n            \"Installer and updated CLI, VS Code and JetBrains route matrix\",\n            \"First supported update of a qualified prior build with broker denial\",\n            \"Direct install and passive recovery job with exact loader argv\",\n            \"Old shell/helper concurrent with canonical launcher exchange and old child attempting to open stores\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac3\",\n          \"provingTests\": [\n            \"Running managed update IPC and stopped local managed update\",\n            \"Verified stopped and running rollback with configuration and store integrity\",\n            \"Uncertain publication with durable success versus no outcome\",\n            \"Linux normal install, update and restart unchanged\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac4\",\n          \"provingTests\": [\n            \"Independent same-commit macOS build equivalence and tamper rejection\",\n            \"Release publication validates real running and stopped upgrades for every enabled profile\",\n            \"Trust rotation, expiry, replay and offline rollback at the fence boundary\",\n            \"Invalid or missing authorization prevents bootstrap checkout execution, npm scripts and bridge invocation\",\n            \"A competing legacy command and interruption during rollback cannot reopen the launcher before durable outcome\"\n          ]\n        }\n      ],\n      \"testFramework\": \"Node.js test runner via tsx, installed shell integration fixtures, and real macOS launchd smoke tests in disposable state roots.\"\n    },\n    \"migration\": {\n      \"stateBefore\": \"The s1 discovery bundle identified whole-tree prior fingerprint qualification before managed migration. Two builds of the same legacy commit produced different native executable bytes. The configured origin was missing the qualification ref.\",\n      \"stateAfter\": \"Current install and update entry points share a migration-capable controller and immutable releases. A supported first upgrade retains the previous release and establishes one verified per-user supervisor. User data remains in the existing state root.\",\n      \"migrationSteps\": [\n        {\n          \"order\": 1,\n          \"action\": \"The release maintainer builds independent references, signs profile and product test receipt digests, and uploads qualification for the exact target commit. A promotion gate verifies the note and reference receipts against the intended head before advancing the channel ref. Publish the note before the branch moves, or publish both atomically. Re-fetch both from the ordinary updater endpoint and confirm the signed head and trust epoch agree. Unsupported profiles remain unavailable. Fixture keys never authorize production.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 2,\n          \"action\": \"Use the current standard installer for both fresh installs and first upgrades. Updated VS Code and JetBrains lifecycle Update on unmanaged Darwin dispatch the packaged migration-capable installer in existing-install mode with the configured branch and root. Updated freshness clients route unmanaged Darwin to that same action before sending any daemon.update RPC. A migration-capable shell or TUI starts the same external preflight on ordinary Update. For already-installed binaries that cannot obtain new code before shutdown, the supported first-upgrade action is the current standard installer, including the normal Install action in an updated IDE. No manual service administration is part of that path. The distributed first-stage verifier authenticates the exact bridge commit, tree and build inputs before checkout or running any candidate-controlled instructions. Updated IDEs ship the same first-stage verifier.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 3,\n          \"action\": \"Verify the signed release evidence and stage the candidate in a separate owned root. Verify the real incumbent against the supported profile, pin raw incumbent and candidate bytes, and check launchd admission. A failed verification leaves the existing daemon alone. Fresh install enters the activation reservation with explicit start intent. Refresh trust at admission and persist the profile receipt before the first mutation. Offline recovery can use that admitted evidence for verified rollback.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 4,\n          \"action\": \"For legacy cutover, reserve and atomically replace the canonical installed checkout entry with a gate-aware dispatcher while preserving its original directory identity. Recover either side of the exchange by journaled inode evidence. Recheck for in-flight old helpers, update markers, unsupported launch routes, and mismatched job registrations. The dispatcher has no old executable or mutable checkout target. Refuse when the old launcher or writer cannot be excluded. Keep the prior checkout pinned until rollback is no longer needed.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 5,\n          \"action\": \"Authenticate the running predecessor over the pinned socket and observe exact exit. While the canonical launcher remains fenced, acquire the legacy-compatible run-file guard before cleanup, reconcile only the recorded publications, and retain the guard until a verified supervisor has adopted it for startup. Transfer owner evidence under the same directory identity with no unguarded interval. Remove a verified passive old job after its child exits. Apply the stored outcome policy for graceful, broker-denied, or unknown exit.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 6,\n          \"action\": \"Journal the provisional selector and register the supervisor. Start a child for a normal fresh install or previously running update. Verify idle for --no-start or previously stopped update. Publish the matching durable terminal record before release. An already-managed shell/TUI update uses the external transaction even when stopped, and the running managed RPC uses the detached helper and acknowledgement handshake.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 7,\n          \"action\": \"Recover interrupted activation or cutover using the matching durable outcome. Keep the canonical dispatcher fenced. Reconcile the selector and restore the previous service only through the verified private archive route, then verify exact running or stopped state. Publish the terminal rollback receipt and outcome before the dispatcher resumes guarded legacy commands. Recover an interruption after publication without relaunching the old service. Keep the archived path stable for loaded jobs and later managed retries. Uncertain ownership retains the fence. A durable success is reconciled without rollback.\",\n          \"rollbackable\": true\n        }\n      ],\n      \"backwardCompat\": \"Preserve the CLI flags, configured source, IDE IPC result shapes, supported user settings, Linux behavior and historical journal decoding. Existing binaries that stop before they can fetch the migration use the current normal installer for the first upgrade. The canonical installed launcher remains a compatible entry point after migration.\",\n      \"zeroDowntime\": false,\n      \"dataRewriteRequired\": false\n    },\n    \"alternativesConsidered\": [\n      {\n        \"id\": \"a1\",\n        \"name\": \"Release-signed build verification profiles\",\n        \"oneLineSummary\": \"Use independent release evidence for portable equivalence and an exact local pin for rollback.\",\n        \"approach\": \"Publish a signed profile per tested predecessor and platform. Verify its complete runtime inventory against an independently built reference using exact hashes by default and bounded deterministic transformations only for verified build variance. Bind the original measured bytes to the cutover journal.\",\n        \"pros\": [\n          \"Supports independently built installations inside a tested profile.\",\n          \"Rejects unexplained executable changes before shutdown.\"\n        ],\n        \"cons\": [\n          \"Requires maintaining release fixtures and qualifying each native transformation.\"\n        ],\n        \"costEstimate\": \"L\"\n      },\n      {\n        \"id\": \"a2\",\n        \"name\": \"Exact release fingerprints only\",\n        \"oneLineSummary\": \"Accept an inventory of byte-identical prior builds.\",\n        \"approach\": \"Publish one exact fingerprint for each independently archived prior package and continue requiring an exact installed match.\",\n        \"pros\": [\n          \"Simple executable verification.\",\n          \"Retains the existing staging pin format.\"\n        ],\n        \"cons\": [\n          \"The same commit produced different native bytes on the two observed installs.\",\n          \"Uncatalogued local builds cannot migrate automatically.\"\n        ],\n        \"costEstimate\": \"S\",\n        \"reasonRejected\": \"An exact reference fingerprint rejects separately built valid native binaries.\"\n      },\n      {\n        \"id\": \"a3\",\n        \"name\": \"Rebuild a rollback release from the old commit\",\n        \"oneLineSummary\": \"Use an independently verified replacement rollback build.\",\n        \"approach\": \"Fetch and rebuild the predecessor in a separate directory using pinned release inputs, then use that result as the rollback executable.\",\n        \"pros\": [\n          \"Supports a clean executable artifact without a per-install binary catalogue.\"\n        ],\n        \"cons\": [\n          \"Does not establish the original incumbent executable's provenance.\",\n          \"Replaces the exact prior executable and introduces a new rollback compatibility surface.\"\n        ],\n        \"costEstimate\": \"L\",\n        \"reasonRejected\": \"A replacement rollback build leaves original executable provenance unverified and changes rollback identity.\"\n      }\n    ],\n    \"chosenAlternative\": \"a1\",\n    \"openQuestions\": [],\n    \"sequenceDefinition\": {\n      \"id\": \"macos-install-cutover\",\n      \"narrative\": \"Release authority publishes evidence before the updater runs. The controller verifies the installed release and records the exact rollback pin before it fences the launcher or asks the incumbent to exit. The existing journal settles running, idle and rollback outcomes.\",\n      \"participants\": [\n        {\n          \"id\": \"release\",\n          \"label\": \"Release authority\",\n          \"description\": \"Publishes signed and tested qualification for the exact ordered release pair.\"\n        },\n        {\n          \"id\": \"entry\",\n          \"label\": \"Installer / update\",\n          \"description\": \"Stages a release through a supported entry point.\"\n        },\n        {\n          \"id\": \"control\",\n          \"label\": \"Controller\",\n          \"description\": \"Owns the journal and cutover fence.\"\n        },\n        {\n          \"id\": \"old\",\n          \"label\": \"Legacy service\",\n          \"description\": \"Pinned predecessor process and job, if present.\"\n        },\n        {\n          \"id\": \"new\",\n          \"label\": \"Supervisor\",\n          \"description\": \"Owns the candidate daemon or verifies idle.\"\n        },\n        {\n          \"id\": \"child\",\n          \"label\": \"Daemon\",\n          \"description\": \"Candidate serving only after admission.\"\n        }\n      ],\n      \"messages\": [\n        {\n          \"from\": \"release\",\n          \"to\": \"entry\",\n          \"label\": \"Publish signed qualification\",\n          \"description\": \"Publish only after real independent builds and the product migration matrix pass.\"\n        },\n        {\n          \"from\": \"entry\",\n          \"to\": \"release\",\n          \"label\": \"Verify source before executing bridge\",\n          \"description\": \"The bundled verifier checks trust, the exact signed Git head and its inputs before checkout or npm scripts.\"\n        },\n        {\n          \"from\": \"entry\",\n          \"to\": \"control\",\n          \"label\": \"Stage release and verify prior\",\n          \"description\": \"Verify signed evidence, inventory and runtime files while the incumbent is available.\"\n        },\n        {\n          \"from\": \"control\",\n          \"to\": \"control\",\n          \"label\": \"Retain raw rollback pin\",\n          \"description\": \"Record the local digest of all original bytes and bind it to the verified profile.\"\n        },\n        {\n          \"from\": \"control\",\n          \"to\": \"control\",\n          \"label\": \"Reserve and fence\",\n          \"description\": \"Journal the entry switch and exclude older writers.\"\n        },\n        {\n          \"from\": \"control\",\n          \"to\": \"old\",\n          \"label\": \"If running: request exit\",\n          \"description\": \"Authenticate the socket and observe exact exit.\"\n        },\n        {\n          \"from\": \"old\",\n          \"to\": \"control\",\n          \"label\": \"Verified exit\",\n          \"description\": \"Keep the launcher fenced and reconcile owned publications.\"\n        },\n        {\n          \"from\": \"control\",\n          \"to\": \"new\",\n          \"label\": \"Publish selector, register job\",\n          \"description\": \"Verify the exact supervisor and admit the requested state.\"\n        },\n        {\n          \"from\": \"new\",\n          \"to\": \"child\",\n          \"label\": \"Running route: start\",\n          \"description\": \"Start one child if requested or previously running.\"\n        },\n        {\n          \"from\": \"child\",\n          \"to\": \"new\",\n          \"label\": \"Running route: readiness\",\n          \"description\": \"Verify authenticated child and publication identities.\"\n        },\n        {\n          \"from\": \"new\",\n          \"to\": \"control\",\n          \"label\": \"Stopped route: verify idle\",\n          \"description\": \"No child is admitted and no daemon readiness is expected.\"\n        },\n        {\n          \"from\": \"control\",\n          \"to\": \"entry\",\n          \"label\": \"Success: commit result\",\n          \"description\": \"Persist verified running or stopped state.\"\n        },\n        {\n          \"from\": \"control\",\n          \"to\": \"new\",\n          \"label\": \"Before commit: reconcile candidate\",\n          \"description\": \"On verified uncommitted failure, stop the exact candidate and remove its owned job.\"\n        },\n        {\n          \"from\": \"control\",\n          \"to\": \"old\",\n          \"label\": \"Rollback: restore via archive\",\n          \"description\": \"Keep the launcher fenced and use the authorized archived path to restore the pinned prior job or direct process.\"\n        },\n        {\n          \"from\": \"control\",\n          \"to\": \"entry\",\n          \"label\": \"Publish rollback before opening dispatch\",\n          \"description\": \"Verify prior state and publish terminal rollback before enabling guarded legacy commands. Keep the fence on uncertainty.\"\n        }\n      ]\n    },\n    \"companions\": [\n      {\n        \"kind\": \"diagram-mermaid\",\n        \"relPath\": \"docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html\",\n        \"title\": \"Sequence diagram\"\n      }\n    ]\n  },\n  \"citations\": [\n    {\n      \"id\": \"c1\",\n      \"kind\": \"code\",\n      \"ref\": \"scripts/insrc-daemon-install.sh\"\n    },\n    {\n      \"id\": \"c2\",\n      \"kind\": \"code\",\n      \"ref\": \"src/shared/managed-daemon-installation.ts\"\n    },\n    {\n      \"id\": \"c3\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/managed-update-recovery.ts\"\n    },\n    {\n      \"id\": \"c4\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/managed-update-transaction.ts\"\n    },\n    {\n      \"id\": \"c5\",\n      \"kind\": \"code\",\n      \"ref\": \"src/bin/insrc-daemon-control.ts\"\n    },\n    {\n      \"id\": \"c6\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/legacy-launch-job.ts\"\n    },\n    {\n      \"id\": \"c7\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/legacy-daemon-cutover.ts\"\n    },\n    {\n      \"id\": \"c8\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/update-runner.ts\"\n    },\n    {\n      \"id\": \"c9\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/admin-handlers.ts\"\n    },\n    {\n      \"id\": \"c10\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/release-compatibility.ts\"\n    },\n    {\n      \"id\": \"c11\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/index.ts\"\n    },\n    {\n      \"id\": \"c12\",\n      \"kind\": \"code\",\n      \"ref\": \"src/shared/daemon-run-files.ts\"\n    },\n    {\n      \"id\": \"c13\",\n      \"kind\": \"code\",\n      \"ref\": \"scripts/daemon-ctl.sh\"\n    },\n    {\n      \"id\": \"c14\",\n      \"kind\": \"prior-artifact\",\n      \"ref\": \"ISSUE-5d5478c61a25ac8f\"\n    },\n    {\n      \"id\": \"c20\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/managed-release-staging.ts\"\n    },\n    {\n      \"id\": \"c21\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/managed-update-preparation.ts\"\n    },\n    {\n      \"id\": \"c22\",\n      \"kind\": \"prior-artifact\",\n      \"ref\": \"BUILD-5d5478c61a25ac8f-s1\"\n    },\n    {\n      \"id\": \"c23\",\n      \"kind\": \"code\",\n      \"ref\": \"scripts/insrc-daemon-install.sh\"\n    },\n    {\n      \"id\": \"c24\",\n      \"kind\": \"code\",\n      \"ref\": \".npmrc\"\n    },\n    {\n      \"id\": \"c25\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/legacy-launch-job.ts\"\n    }\n  ]\n}\n","document":"<!-- insrc:artifact LLD-5d5478c61a25ac8f-s1 -->\n\n# LLD: STORY-5d5478c61a25ac8f-s1 — Enable managed daemon lifecycle on macOS install and upgrade\n\n## Summary\n\n**Epic:** `enable-managed-daemon-lifecycle-macos-install`\n**HLD base run:** `wf-1794512795801-4ze5js`\n**HLD effective hash:** `4ce5917d447b...`\n\nThe normal macOS installer provisions a per-user supervisor and automatically migrates supported locally built installs. Before cutover the updater verifies the incumbent against release-authorized build evidence and pins its original bytes for rollback. Existing configuration, stores and running state survive a verified rollback.\n\n## Contents\n\n1. [HLD context](#1-hld-context)\n2. [Contract details](#2-contract-details)\n3. [Data model changes](#3-data-model-changes)\n4. [Diagrams](#4-diagrams)\n5. [Error paths](#5-error-paths)\n6. [Test strategy](#6-test-strategy)\n7. [Migration](#7-migration)\n8. [Alternatives considered](#8-alternatives-considered)\n9. [References](#9-references)\n\n## 1. HLD context\n\n**Framework:** Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\n**Rollout phase:** standalone\n\n## 2. Contract details\n\n**Surface level:** internal-shared\n\n### 2.1 `stageManagedRelease`\n\n```typescript\nstageManagedRelease(options: StageOptions): Promise<{ readonly candidate: StagedReleasePin; readonly prior?: StagedReleasePin; readonly compatibility?: QualifiedReleasePair }>\n```\n\n**Parameters:**\n- `options: StageOptions` — Carries the configured source, exact release pair, authorized build evidence and optional incumbent.\n\n**Returns:** `Promise<{ readonly candidate: StagedReleasePin; readonly prior?: StagedReleasePin; readonly compatibility?: QualifiedReleasePair }>` — Verified candidate and optional byte-exact original rollback pin.\n\n**Errors:**\n- `Error` when Missing or invalid signed evidence, unsupported build profile, unaccounted executable differences, ambiguous inventory or unstable pin.\n\n**Preconditions:**\n- The official installer script and IDE-bundled copies carry the same dependency-free Node verifier and pinned offline release root. An installed managed controller can reuse its verified copy. Fetch into a fresh owner-private bare Git directory with external hooks, checkout filters and config injection disabled. Before checkout, npm scripts, build, or launch of a downloaded bridge, the trusted verifier validates the signed source/branch/full commit and expected Git tree, approved build inputs and release policy. A configured URL override changes routing only. Never obtain the first verifier or root from the fetched branch.\n- Use separately root-signed UTF-8 trust data, and per-channel Ed25519 qualification keys authorized by that data. Verify signatures over exact length-framed UTF-8 payload bytes with distinct trust and qualification domain tags. Enforce strict versioned schemas and limits and reject duplicate keys. Trust data records monotonic epoch, permitted source and branch per key, key ID and public key, validity window and revocations. The root is pinned in the official distribution. Root rotation requires an updated trusted distribution. Production verifier trust excludes fixture keys.\n\n**Postconditions:**\n- Refresh root-signed trust data from the configured release channel during preparation and within five minutes before the first cutover mutation. Trust data is valid for at most 24 hours. Validate the UTC window, key status and epoch against an owner-private durable floor advanced atomically under admission. If the same epoch arrives with different bytes, the local clock has rolled behind the stored valid-time floor, or signed trust data is unavailable, refuse admission. Qualification carries key ID, release source, exact current branch head and Git tree, ordered release pair, validity window, supported profile and immutable release-test receipt digests. A revoked key, expired qualification, stale trust epoch or changed candidate prevents cutover.\n- Initial profile targets the measured arm64 macOS 27.0 installation class and predecessor ab6a96296ea6f2bde948636424218c0a23136c74. Reference inputs pin Node 22.23.2 with ABI 127, npm 10.9.8, node-gyp 11.5.0, Node 22.22.1 headers, Apple Clang 21.0.0 build 2100.3.34.2, Command Line Tools 27.0.0.0.1788430756, SDK 27.0, Python 3.12.6, -std=c++17 and exact Git tree and lockfile. Release authority records digests for tools, SDK/headers, dependencies, prebuilds and environment allowlist. It produces references from two clean installer builds at separate real paths, with pinned inputs and controlled network dependency retrieval. Each supported optional dependency layout is inventoried and qualifies separately. No profile ships before the real product matrix confirms these inputs and the target incumbent.\n- Inventory exact relative paths, type, permitted modes, symlink targets, and digests for the Node runtime, the executable closure in out and node_modules, project-memory dist, scripts used by the daemon or supported entry points, and build/package configuration used by those entry points. Walk by stable owned file handles without following unapproved links. Reject extra or missing execution-bearing files, escaped links or ambiguous optional package layouts. Default to raw SHA-256. A signed profile may explicitly enumerate inert build leftovers with their expected formats and paths. Generated Makefile, gyp and dependency records, intermediate Mach-O object/static library files and npm bookkeeping are eligible only if a verified runtime or rollback path never reads or executes them. Validate their types and allowlisted formats and retain every byte in the raw pin. Optional JavaScript or WASM packages are executable and use a separately qualified exact inventory.\n- Native equivalence is limited initially to the signed exact paths of the fs-ext, tree-sitter, tree-sitter-sql and tree-sitter-kotlin thin arm64 bundles observed in the native study. Strictly parse and bound the complete Mach-O, validate all commands and ranges without overlaps and reject unsupported variants. Compare all code, mapped data, padding, loader commands and binding, rebase, export, relocations and indirect-symbol tables exactly except validated representations of known metadata. Compare symbol indices, types, sections, flags, values and decoded names, with only N_SO source roots and N_OSO object roots and timestamps mapped to fixed tokens for expected debug-only records. Confirm no runtime table references these records. Verify that every other string and byte is accounted for, with validated offsets, size and alignment of __LINKEDIT tables and signature. Accept only the observed linker-signed ad hoc CodeDirectory form after verifying all page hashes, expected identity, flags and absence of extra slots or entitlements. Its generated page hashes and LC_UUID are the only remaining variable values. Digest the resulting versioned representation against the signed reference. Reject any unexpected executable, section, metadata, entitlement, symbol or unclassified byte change.\n- After independent verification capture and retain a byte-exact digest of every installed runtime and allowed inert file, including portable verifier metadata. Journal the raw incumbent and candidate pins and the signed evidence digest with the exact update before fencing. Recheck raw bytes and identities on both sides of the fence and before rollback. Build the authenticated candidate with the qualified inputs, and verify its signed inventory before executing its installed controller or daemon.\n\n### 2.2 `completeLegacyMigration`\n\n```typescript\ncompleteLegacyMigration(gate: InstallationMutationGate, update: UpdateReservation, pins: ManagedUpdatePins): Promise<DaemonUpdateOutcome>\n```\n\n**Parameters:**\n- `gate: InstallationMutationGate` — Owns the cutover and recovery reservation.\n- `update: UpdateReservation` — Identifies verified predecessor, release, fence and desired state.\n- `pins: ManagedUpdatePins` — Carries the qualified prior and candidate releases.\n\n**Returns:** `Promise<DaemonUpdateOutcome>` — Verified committed cutover, verified rollback, or fenced recovery.\n\n**Errors:**\n- `SupervisorLifecycleError` when A release, launch route, exact exit, or recovery state cannot be verified.\n\n**Preconditions:**\n- Use the migration-capable installer or updater to prepare the release before invoking any shutdown path. Freeze the canonical legacy launch and checkout paths and verify old mutating helpers are absent before cutover. Verify the pinned predecessor and public socket before sending shutdown.\n\n**Postconditions:**\n- Preserve the original raw pin, job policy and stopped or running intent. Keep the canonical dispatcher fenced during candidate cleanup, selector reconciliation, predecessor launch and readiness verification, and until the rollback outcome and receipt are durable.\n- For a prior running install, the reservation owner alone may use the private, byte-pinned archived checkout. Reconstruct direct argv and cwd or a private launchd descriptor, mapping only pre-recorded checkout-contained executable/script/cwd paths from the captured inode to its archived location. Preserve UID, domain, label, argument order, runtime, state-root environment and RunAtLoad/KeepAlive policy. Verify the actual registered job and socket peer before recording readiness. A previously stopped job stays passive. Refuse ambiguous mapping and retain the fence.\n- Publish the terminal rollback outcome and verified legacy route together before enabling normal access. Keep a guarded canonical dispatcher after rollback. It can select the archived release only for the verified terminal receipt, route restart and update through the same gate, and support a later managed retry without releasing the old mutating scripts. Keep the archived location stable for the live job. Journal dispatch publication separately so interrupted settlement can reconcile without another spawn. Verify exact child or idle state and preserve a committed candidate without rollback.\n\n### 2.3 `stageManagedInstallation`\n\n```typescript\nstageManagedInstallation(installation: ManagedInstallation, revalidate: () => Promise<void>, legacyCutover?: boolean): Promise<void>\n```\n\n**Parameters:**\n- `installation: ManagedInstallation` — Identifies the owned state root, release, runtime and selector.\n- `revalidate: () => Promise<void>` — Verifies transaction ownership before a write.\n- `legacyCutover: boolean` _(optional)_ — Selects staging for a verified predecessor.\n\n**Returns:** `Promise<void>` — Writes the staged disabled selector and its descriptor only.\n\n**Errors:**\n- `SupervisorLifecycleError` when Selector, descriptor, or state root conflicts with the reservation.\n\n**Preconditions:**\n- The installer controller owns an activation reservation with the explicit start intent and candidate pin. It has verified the canonical root, GUI launchd domain and quiescent fresh state.\n\n**Postconditions:**\n- The installer controller journals descriptor and provisional-selector publication, exact job registration and idle handshake, and optional child readiness. Enable the selector under the reservation before controller admission. Release the reservation only after a verified idle or running result is durable. --no-start leaves an enabled selector and an idle supervisor. Recovery replays an exact matching partial pair or removes only artifacts created by the activation and restores prior absence.\n\n### 2.4 `launchManagedUpdate`\n\n```typescript\nlaunchManagedUpdate(entry: string, args: readonly string[], awaitReply: () => Promise<boolean>): Promise<{ launched: true; updateId: string }>\n```\n\n**Parameters:**\n- `entry: string` — Pins the detached controller executable.\n- `args: readonly string[]` — Carries the owned release and operation inputs.\n- `awaitReply: () => Promise<boolean>` — Confirms that the update acknowledgement was written.\n\n**Returns:** `Promise<{ launched: true; updateId: string }>` — Returns the admitted update identity while the helper owns completion.\n\n**Errors:**\n- `SupervisorLifecycleError` when An update is already active or the helper cannot qualify the candidate.\n\n**Preconditions:**\n- The running managed daemon routes daemon.update to the transactional helper after candidate preparation and retains its response-written handshake. Shell and TUI update have a local controller route for a stopped installation.\n\n**Postconditions:**\n- Managed updates use the same release preparation and transaction for running and stopped cases. A stopped install stays stopped. Preserve existing IPC result shapes and omit the legacy self-shutdown timer for managed requests.\n\n## 3. Data model changes\n\n### 3.1 `InstallationMutationGate activation reservation` — field-add\n\nPersist one activation reservation per state root with exact owner, candidate and explicit start intent. Journal descriptor, provisional selector, exact registration, child admission, readiness and terminal outcome with identities. Previous journals remain decodable. Activation cleanup reverses only receipted owned mutations.\n\n**Call sites:**\n- `src/shared/installation-mutation-gate.ts`\n- `src/shared/managed-daemon-installation.ts`\n- `src/bin/insrc-daemon-control.ts`\n\n### 3.2 `UpdatePredecessor` — invariant-change\n\nPersist a tagged managed, legacy-job, legacy-direct, or legacy-stopped predecessor. All variants bind canonical state root, prior release/runtime and candidate pin, selector baseline or absence, and prior running state. Managed carries supervisor generation. Legacy-job carries descriptor path/hash, verified label, UID, launchd domain, program argv, working directory and RunAtLoad policy. Running legacy-job and legacy-direct carry exact process incarnation, authenticated socket peer and pinned PID/socket identities. Legacy-direct also carries rollback argv, cwd and a release-qualified environment recipe reconstructed from the supported launcher, without persisting credentials. Legacy-stopped carries proof of no live process and either a pinned idle job or verified absence. Decode historical predecessor.legacy as legacy-job and older enabled prior without legacy as managed. Reject unknown or contradictory variants. Persist each observed exit, its drain classification, and ownership-fence evidence before candidate bootstrap. A rollback route maps only verified original checkout-relative argv/cwd paths into the archived directory. It binds a single archived release and recorded job or direct launch to the update and keeps the canonical launcher fenced until terminal evidence.\n\n**Call sites:**\n- `src/shared/installation-mutation-gate.ts`\n- `src/daemon/managed-update-recovery.ts`\n- `src/daemon/legacy-launch-job.ts`\n- `src/daemon/legacy-daemon-cutover.ts`\n\n### 3.3 `Release qualification profile and exact rollback pin` — invariant-change\n\nThe release authority owns a signed, versioned profile for one configured source, ordered commit pair and tested build profile. A release pair can have multiple profiles. Exactly one applicable profile must verify a particular installation. An update reservation owns one verified profile receipt and one exact incumbent pin and binds both to its candidate, selector and state root. The profile verifies a complete measured inventory and accounts for variability. The local pin freezes raw bytes for rollback, and the receipt is reusable during recovery without remote network access. Historical journals retain their original verification rules. Versioned notes that lack the required portable proof cannot qualify a source-built variant. Record one immutable admission receipt per update with signing key, trust epoch and payload digest, verification time, qualification and reference digests, commit/tree pair, source, release profile, raw pins and exact update ID. Before a recorded fence, expiry, refresh failure or revocation forces refusal. After the fence, the recorded decision applies only to that transaction while its owner settles it within its admitted authorization window. If recovery begins without a durable success, it can verify and roll back offline using the receipt and raw pin. It needs fresh authorization to newly activate a candidate. If revocation is known before a new candidate activation, roll back. Durable success is reconciled offline and is never reinterpreted as uncommitted.\n\n**Call sites:**\n- `src/daemon/managed-release-staging.ts`\n- `src/daemon/managed-update-preparation.ts`\n- `src/daemon/release-compatibility.ts`\n- `src/daemon/managed-update-recovery.ts`\n\n## 4. Diagrams\n\n- [Sequence diagram](docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/sequence-diagram.html)\n\n## 5. Error paths\n\n**Error cases**\n\n- **An older launcher or updater can still mutate the legacy install** (recoverable)\n  - Detection: Resolve the canonical checkout and every supported launch route. Atomically exchange the canonical checkout entry with a gate-aware dispatcher on the same filesystem while the old daemon is still running. Preserve the displaced checkout separately. Before stopping, verify the dispatcher and archived checkout identities, an absent or owned legacy update marker, and absence of known old shell, detached helper and installer processes bound to the retired root, using verified argv and cwd. Repeat admission after the swap. An unrecognized launch path, unresolved process identity, live old mutator, or exchange failure makes exclusivity unproven.\n  - Response: The dispatcher rejects concurrent mutation while cutover owns the reservation. Qualify only predecessors that acquire the shared run-file guard before opening data and whose shipped old commands use the canonical absolute entry. Keep that guard through owned cleanup and transfer it to candidate startup before the legacy route can reacquire it. Refuse when another legacy route cannot be fenced. Preserve or restore the old service before releasing a failed admission.\n  - User impact: The supported update retries safely after a concurrent operation ends.\n- **Predecessor job or runtime does not match the qualified route** (recoverable)\n  - Detection: Match the verified launchd registration against its owned descriptor bytes and approved exact argv. Match direct socket peer and executable against the qualified launch recipe. Accept the documented recovery LaunchAgent only with its pinned tsx loader arguments, canonical entry, matching working directory, bounded owned descriptor and passive restart policy.\n  - Response: Reject foreign jobs, unknown loaders or args, conflicting restart policy and unverifiable direct rollback settings before disruption. Recheck the descriptor, PID incarnation and run-file identities immediately before each action.\n  - User impact: The updater reports the unsupported predecessor while preserving the current service.\n- **Exit is unconfirmed or graceful drain cannot be classified** (recoverable)\n  - Detection: Observe the exact predecessor exit independently of the broker and bind any qualified terminal evidence to the authenticated shutdown request and process incarnation. An RPC acknowledgement, socket close, PID disappearance, or generic log entry alone does not prove a graceful drain.\n  - Response: Withhold candidate admission until exact exit is proved. Journal the exit plus graceful, broker-denied, or unknown. Use graceful only for a qualified positive completion signal, broker-denied only for correlated watchdog evidence, and unknown otherwise. Both broker-denied and unknown require a release pair explicitly qualified for crash-consistent reopening. Report the observed classification in the update detail.\n  - User impact: The user can distinguish a verified shutdown from an exit whose drain could not be confirmed.\n- **Candidate bootstrap or readiness fails before a durable outcome** (recoverable)\n  - Detection: Registration, startup generation, owned run files, or candidate idle/readiness cannot be verified.\n  - Response: Reconcile the candidate under the reservation, Keep the canonical dispatcher fenced while restoring the predecessor via the archived route. Publish verified rollback before enabling guarded ordinary commands. Retain a fence when restoration is unverified.\n  - User impact: Verified rollback restores the previous service state and reports the failed update.\n- **Outcome publication throws or its acknowledgement is lost** (recoverable)\n  - Detection: Publication fails, or retry sees an active reservation without a verified terminal reply.\n  - Response: Keep the reservation. Re-read the exact matching durable outcome through existing recovery. A durable success verifies or completes activation without rollback. A durable rollback verifies the old state. Only a proven uncommitted transaction can unwind. Unknown ownership remains fenced.\n  - User impact: The updater reports an unconfirmed result until recovery determines the terminal state.\n- **Release qualification is missing, ambiguous, stale, revoked or invalid** (recoverable)\n  - Detection: Reject absent note, invalid signature or key, unsupported profile or verifier version, source or commit mismatch, conflicting profiles and any unaccounted runtime difference.\n  - Response: Report the failed verification before any incumbent shutdown, fence or selector mutation. Discard only owned preparation artifacts and preserve the incumbent.\n  - User impact: The daemon remains available with an update diagnostic and can retry after a qualified release is published.\n- **Installed runtime changes after independent verification** (recoverable)\n  - Detection: Recheck the original raw digest and exact file identities while holding update admission at the designated cutover and rollback boundaries.\n  - Response: Stop cutover before touching the incumbent when possible. After mutation use the existing exact rollback or fenced recovery. Refuse to execute any changed rollback copy.\n  - User impact: The update fails with a verification diagnostic.\n- **Legacy mutation competes with rollback or cutover authorization expires** (recoverable)\n  - Detection: Read the admitted trust receipt and launcher fence identities. Detect a concurrent old command through the guarded canonical route or a fresh candidate admission after expiry or revocation.\n  - Response: Reject the old command. Use only the private archive route for rollback, verify the prior state, publish terminal evidence, then permit guarded dispatch. If admission is no longer valid, recover offline by rollback unless the candidate already has a verified durable success.\n  - User impact: The previous verified service is restored or the installation remains fenced for recovery.\n\n**Edge cases**\n\n| Input | Expected |\n| :--- | :--- |\n| Fresh --no-start | Register the supervisor, enable the selector and verify idle with no daemon child. Subsequent normal start uses the same supervisor. |\n| Already-managed update when the daemon is stopped | The external controller prepares and commits the update using supervisor status; no daemon RPC is required. Keep the candidate idle. |\n| Legacy daemon remains running while the candidate is staged | Build outside the live root, preserve the running predecessor and only then acquire a cutover reservation. Failed fetch, build, or qualification leaves the running install unchanged. |\n| An unchanged older shell or IDE freshness client invokes legacy restart or daemon.update | An old client cannot acquire new preflight behavior before executing its existing shutdown sequence. The first upgrade is delivered by the current standard installer or the ordinary update action in updated IDE clients. The installer may be rerun on an existing installation without launchctl or file edits. Never present an old acknowledgement as migration success. |\n| Two qualified installs share a commit but have different build paths or raw native artifact bytes | Each matches independent expected execution-bearing bytes under the same tested profile and retains its own raw exact pin. |\n\n**Invariants to preserve**\n\n- One state root has at most one daemon process admitted to use its stores. [[c2]]\n- Committed success is never rolled back because the publication reply was lost. [[c4]]\n- Linux keeps its current lifecycle and update behavior. [[c1]]\n\n## 6. Test strategy\n\n**Test framework:** `Node.js test runner via tsx, installed shell integration fixtures, and real macOS launchd smoke tests in disposable state roots.`\n\n**Test levels**\n\n- **unit** — Verify admission, qualification, journal compatibility and outcome recovery.\n  - Subjects: `Predecessor variants and backward decoding`, `Explicit fresh activation start intent and owned partial publication`, `Release provenance, changed bytes and absent legacy declaration`, `Graceful, broker-denied and unknown drain evidence`, `Uncertain publication with durable success versus no outcome`\n- **integration** — Drive supported entry points and competing legacy operations through the real controller boundaries.\n  - Subjects: `Installer and updated CLI, VS Code and JetBrains route matrix`, `Running managed update IPC and stopped local managed update`, `Old shell/helper concurrent with canonical launcher exchange and old child attempting to open stores`, `Startup guard transfer, candidate bootstrap failure, rollback and repeated recovery`, `Linux normal install, update and restart unchanged`\n- **smoke** — Verify actual launchd and daemon state on macOS.\n  - Subjects: `Fresh install and verified ordinary restart`, `Fresh --no-start and later supervisor start`, `First supported update of a qualified prior build with broker denial`, `Direct install and passive recovery job with exact loader argv`, `Verified stopped and running rollback with configuration and store integrity`\n  - Fixtures: `Disposable macOS state roots and isolated launchd labels`, `Pinned released predecessors, including the regression and clean-drain cases`\n- **contract** — Verify release signatures, independent expected inventory, applicability, exact runtime coverage, and report provenance.\n  - Subjects: `Independent same-commit macOS build equivalence and tamper rejection`, `Changed native code, loadable data, bindings, signature policy, injected modules, symlinks and unidentified variance fail closed`, `Missing or stale release evidence prevents promotion and leaves the incumbent running`\n- **smoke** — Require real product builds before promoting a source-built profile.\n  - Subjects: `Release publication validates real running and stopped upgrades for every enabled profile`, `Real product passive and recovery job loader arguments, verified broker refusal, data-preserving rollback and subsequent managed update`\n  - Fixtures: `Two independent production installer builds of the same supported predecessor in different homes with observed native variance`, `Real predecessor and candidate installs using disposable homes and distinct launchd jobs`, `Qualification from an isolated release authority, plus immutable test receipts bound to promoted release metadata`\n- **integration** — Prove trust ordering and rollback fences at the real controller boundaries.\n  - Subjects: `Trust rotation, expiry, replay and offline rollback at the fence boundary`, `Invalid or missing authorization prevents bootstrap checkout execution, npm scripts and bridge invocation`, `A competing legacy command and interruption during rollback cannot reopen the launcher before durable outcome`\n  - Fixtures: `A trusted installer and distinct trusted/unauthorized signed Git origins with executable marker probes`, `A real archived legacy daemon, fresh and expired signed trust epochs, and controller crash points before outcome and before guarded dispatch`\n\n**Acceptance mapping**\n\n| Criterion | Proving tests |\n| :--- | :--- |\n| `ac1` | `Fresh install and verified ordinary restart`, `Fresh --no-start and later supervisor start` |\n| `ac2` | `Installer and updated CLI, VS Code and JetBrains route matrix`, `First supported update of a qualified prior build with broker denial`, `Direct install and passive recovery job with exact loader argv`, `Old shell/helper concurrent with canonical launcher exchange and old child attempting to open stores` |\n| `ac3` | `Running managed update IPC and stopped local managed update`, `Verified stopped and running rollback with configuration and store integrity`, `Uncertain publication with durable success versus no outcome`, `Linux normal install, update and restart unchanged` |\n| `ac4` | `Independent same-commit macOS build equivalence and tamper rejection`, `Release publication validates real running and stopped upgrades for every enabled profile`, `Trust rotation, expiry, replay and offline rollback at the fence boundary`, `Invalid or missing authorization prevents bootstrap checkout execution, npm scripts and bridge invocation`, `A competing legacy command and interruption during rollback cannot reopen the launcher before durable outcome` |\n\n## 7. Migration\n\n**State before:** The s1 discovery bundle identified whole-tree prior fingerprint qualification before managed migration. Two builds of the same legacy commit produced different native executable bytes. The configured origin was missing the qualification ref.\n\n**State after:** Current install and update entry points share a migration-capable controller and immutable releases. A supported first upgrade retains the previous release and establishes one verified per-user supervisor. User data remains in the existing state root.\n\n**Zero downtime:** no — **Data rewrite:** no\n\n**Steps**\n\n1. The release maintainer builds independent references, signs profile and product test receipt digests, and uploads qualification for the exact target commit. A promotion gate verifies the note and reference receipts against the intended head before advancing the channel ref. Publish the note before the branch moves, or publish both atomically. Re-fetch both from the ordinary updater endpoint and confirm the signed head and trust epoch agree. Unsupported profiles remain unavailable. Fixture keys never authorize production. — ↩ rollbackable\n2. Use the current standard installer for both fresh installs and first upgrades. Updated VS Code and JetBrains lifecycle Update on unmanaged Darwin dispatch the packaged migration-capable installer in existing-install mode with the configured branch and root. Updated freshness clients route unmanaged Darwin to that same action before sending any daemon.update RPC. A migration-capable shell or TUI starts the same external preflight on ordinary Update. For already-installed binaries that cannot obtain new code before shutdown, the supported first-upgrade action is the current standard installer, including the normal Install action in an updated IDE. No manual service administration is part of that path. The distributed first-stage verifier authenticates the exact bridge commit, tree and build inputs before checkout or running any candidate-controlled instructions. Updated IDEs ship the same first-stage verifier. — ↩ rollbackable\n3. Verify the signed release evidence and stage the candidate in a separate owned root. Verify the real incumbent against the supported profile, pin raw incumbent and candidate bytes, and check launchd admission. A failed verification leaves the existing daemon alone. Fresh install enters the activation reservation with explicit start intent. Refresh trust at admission and persist the profile receipt before the first mutation. Offline recovery can use that admitted evidence for verified rollback. — ↩ rollbackable\n4. For legacy cutover, reserve and atomically replace the canonical installed checkout entry with a gate-aware dispatcher while preserving its original directory identity. Recover either side of the exchange by journaled inode evidence. Recheck for in-flight old helpers, update markers, unsupported launch routes, and mismatched job registrations. The dispatcher has no old executable or mutable checkout target. Refuse when the old launcher or writer cannot be excluded. Keep the prior checkout pinned until rollback is no longer needed. — ↩ rollbackable\n5. Authenticate the running predecessor over the pinned socket and observe exact exit. While the canonical launcher remains fenced, acquire the legacy-compatible run-file guard before cleanup, reconcile only the recorded publications, and retain the guard until a verified supervisor has adopted it for startup. Transfer owner evidence under the same directory identity with no unguarded interval. Remove a verified passive old job after its child exits. Apply the stored outcome policy for graceful, broker-denied, or unknown exit. — ↩ rollbackable\n6. Journal the provisional selector and register the supervisor. Start a child for a normal fresh install or previously running update. Verify idle for --no-start or previously stopped update. Publish the matching durable terminal record before release. An already-managed shell/TUI update uses the external transaction even when stopped, and the running managed RPC uses the detached helper and acknowledgement handshake. — ↩ rollbackable\n7. Recover interrupted activation or cutover using the matching durable outcome. Keep the canonical dispatcher fenced. Reconcile the selector and restore the previous service only through the verified private archive route, then verify exact running or stopped state. Publish the terminal rollback receipt and outcome before the dispatcher resumes guarded legacy commands. Recover an interruption after publication without relaunching the old service. Keep the archived path stable for loaded jobs and later managed retries. Uncertain ownership retains the fence. A durable success is reconciled without rollback. — ↩ rollbackable\n\n**Backward compat:** Preserve the CLI flags, configured source, IDE IPC result shapes, supported user settings, Linux behavior and historical journal decoding. Existing binaries that stop before they can fetch the migration use the current normal installer for the first upgrade. The canonical installed launcher remains a compatible entry point after migration.\n\n## 8. Alternatives considered\n\n### 8.1 a1: Release-signed build verification profiles — **CHOSEN**\n\nUse independent release evidence for portable equivalence and an exact local pin for rollback.\n\nPublish a signed profile per tested predecessor and platform. Verify its complete runtime inventory against an independently built reference using exact hashes by default and bounded deterministic transformations only for verified build variance. Bind the original measured bytes to the cutover journal.\n\n### 8.2 a2: Exact release fingerprints only\n\nAccept an inventory of byte-identical prior builds.\n\nPublish one exact fingerprint for each independently archived prior package and continue requiring an exact installed match.\n\n**Rejected because:** An exact reference fingerprint rejects separately built valid native binaries.\n\n### 8.3 a3: Rebuild a rollback release from the old commit\n\nUse an independently verified replacement rollback build.\n\nFetch and rebuild the predecessor in a separate directory using pinned release inputs, then use that result as the rollback executable.\n\n**Rejected because:** A replacement rollback build leaves original executable provenance unverified and changes rollback identity.\n\n## 9. References\n\n- **[[c1]]** `code` `scripts/insrc-daemon-install.sh`\n- **[[c2]]** `code` `src/shared/managed-daemon-installation.ts`\n- **[[c3]]** `code` `src/daemon/managed-update-recovery.ts`\n- **[[c4]]** `code` `src/daemon/managed-update-transaction.ts`\n- **[[c5]]** `code` `src/bin/insrc-daemon-control.ts`\n- **[[c6]]** `code` `src/daemon/legacy-launch-job.ts`\n- **[[c7]]** `code` `src/daemon/legacy-daemon-cutover.ts`\n- **[[c8]]** `code` `src/daemon/update-runner.ts`\n- **[[c9]]** `code` `src/daemon/admin-handlers.ts`\n- **[[c10]]** `code` `src/daemon/release-compatibility.ts`\n- **[[c11]]** `code` `src/daemon/index.ts`\n- **[[c12]]** `code` `src/shared/daemon-run-files.ts`\n- **[[c13]]** `code` `scripts/daemon-ctl.sh`\n- **[[c14]]** `prior-artifact` `ISSUE-5d5478c61a25ac8f`\n- **[[c20]]** `code` `src/daemon/managed-release-staging.ts`\n- **[[c21]]** `code` `src/daemon/managed-update-preparation.ts`\n- **[[c22]]** `prior-artifact` `BUILD-5d5478c61a25ac8f-s1`\n- **[[c23]]** `code` `scripts/insrc-daemon-install.sh`\n- **[[c24]]** `code` `.npmrc`\n- **[[c25]]** `code` `src/daemon/legacy-launch-job.ts`\n"},"capturedAt":"2026-11-12T19:46:54.280Z"},"inventory":{"units":[{"id":"/body/hldContextSlice","selector":"/body/hldContextSlice","title":"hldContextSlice","kind":"section"},{"id":"/body/summary","selector":"/body/summary","title":"summary","kind":"section"},{"id":"/body/contractDetails","selector":"/body/contractDetails","title":"contractDetails","kind":"section"},{"id":"/body/dataModelChanges","selector":"/body/dataModelChanges","title":"dataModelChanges","kind":"section"},{"id":"/body/interactionWithShared","selector":"/body/interactionWithShared","title":"interactionWithShared","kind":"section"},{"id":"/body/errorPaths","selector":"/body/errorPaths","title":"errorPaths","kind":"section"},{"id":"/body/testStrategy","selector":"/body/testStrategy","title":"testStrategy","kind":"section"},{"id":"/body/migration","selector":"/body/migration","title":"migration","kind":"section"},{"id":"/body/alternativesConsidered","selector":"/body/alternativesConsidered","title":"alternativesConsidered","kind":"section"},{"id":"/body/chosenAlternative","selector":"/body/chosenAlternative","title":"chosenAlternative","kind":"section"},{"id":"/body/openQuestions","selector":"/body/openQuestions","title":"openQuestions","kind":"section"},{"id":"/body/sequenceDefinition","selector":"/body/sequenceDefinition","title":"sequenceDefinition","kind":"visual"},{"id":"/body/companions","selector":"/body/companions","title":"companions","kind":"visual"},{"id":"/body/alternativesConsidered/0","selector":"/body/alternativesConsidered/0","title":"a1","kind":"requirement"},{"id":"/body/alternativesConsidered/1","selector":"/body/alternativesConsidered/1","title":"a2","kind":"requirement"},{"id":"/body/alternativesConsidered/2","selector":"/body/alternativesConsidered/2","title":"a3","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/0","selector":"/body/sequenceDefinition/participants/0","title":"release","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/1","selector":"/body/sequenceDefinition/participants/1","title":"entry","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/2","selector":"/body/sequenceDefinition/participants/2","title":"control","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/3","selector":"/body/sequenceDefinition/participants/3","title":"old","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/4","selector":"/body/sequenceDefinition/participants/4","title":"new","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/5","selector":"/body/sequenceDefinition/participants/5","title":"child","kind":"requirement"},{"id":"/citations/0","selector":"/citations/0","title":"Citation 1","kind":"citation"},{"id":"/citations/1","selector":"/citations/1","title":"Citation 2","kind":"citation"},{"id":"/citations/2","selector":"/citations/2","title":"Citation 3","kind":"citation"},{"id":"/citations/3","selector":"/citations/3","title":"Citation 4","kind":"citation"},{"id":"/citations/4","selector":"/citations/4","title":"Citation 5","kind":"citation"},{"id":"/citations/5","selector":"/citations/5","title":"Citation 6","kind":"citation"},{"id":"/citations/6","selector":"/citations/6","title":"Citation 7","kind":"citation"},{"id":"/citations/7","selector":"/citations/7","title":"Citation 8","kind":"citation"},{"id":"/citations/8","selector":"/citations/8","title":"Citation 9","kind":"citation"},{"id":"/citations/9","selector":"/citations/9","title":"Citation 10","kind":"citation"},{"id":"/citations/10","selector":"/citations/10","title":"Citation 11","kind":"citation"},{"id":"/citations/11","selector":"/citations/11","title":"Citation 12","kind":"citation"},{"id":"/citations/12","selector":"/citations/12","title":"Citation 13","kind":"citation"},{"id":"/citations/13","selector":"/citations/13","title":"Citation 14","kind":"citation"},{"id":"/citations/14","selector":"/citations/14","title":"Citation 15","kind":"citation"},{"id":"/citations/15","selector":"/citations/15","title":"Citation 16","kind":"citation"},{"id":"/citations/16","selector":"/citations/16","title":"Citation 17","kind":"citation"},{"id":"/citations/17","selector":"/citations/17","title":"Citation 18","kind":"citation"},{"id":"/citations/18","selector":"/citations/18","title":"Citation 19","kind":"citation"},{"id":"/citations/19","selector":"/citations/19","title":"Citation 20","kind":"citation"},{"id":"document:line:25","selector":"document:line:25","title":"1. HLD context","kind":"section"},{"id":"document:line:158","selector":"document:line:158","title":"4. Diagrams","kind":"section"}]},"completedChunks":[{"chunkId":"scope","status":"passed","summary":"All assigned selectors were assessed. The current scope and chosen alternative trace the originating ISSUE’s fresh installation, ordinary supported updates, legacy and recovery jobs, direct installs, broker denial, rollback preservation and Linux compatibility. The initial predecessor/build profile, distributed trust prerequisites and guarded post-rollback routing make the supported migration boundary explicit. The cited BUILD motivates portable verification but is not presented as completed production qualification. No blocking scope defect was demonstrated.","findings":[],"inspectedReferences":["/body/hldContextSlice","/body/summary","/body/alternativesConsidered","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/alternativesConsidered/2","/body/chosenAlternative","/body/openQuestions","/citations/13","/citations/16","document:line:25","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md",".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md",".insrc/artifacts/ISSUE-5d5478c61a25ac8f.json",".insrc/artifacts/ISSUE-3992d2e1e26124dc.json",".insrc/artifacts/BUILD-5d5478c61a25ac8f-s1.json","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/TESTS.md","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:49","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:54","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:81","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:237","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:256","scripts/insrc-daemon-install.sh:1-245","src/daemon/managed-release-staging.ts:99-175",".npmrc","docs/daemon.md:124-167","git:ab6a96296ea6f2bde948636424218c0a23136c74:package.json","git:ab6a96296ea6f2bde948636424218c0a23136c74:src/daemon/index.ts",".insrc/tmp/design-review/macos-portable-qualification-5d5478c6.json"],"limitations":[],"advice":["Mention the initial arm64 macOS 27.0 predecessor profile in the product summary so readers can see the initial support boundary without consulting the detailed verification contract.","Label the rendered Epic and HLD metadata as framework bookkeeping; the substantive context correctly identifies the originating ISSUE and absence of a parent HLD."]},{"chunkId":"qualification","status":"changes_requested","summary":"Inspected every assigned selector and freshly assessed both prior qualification findings. The revised trust lifecycle covers admission, expiry, revocation and offline rollback. Native equivalence still lacks a transformation required by the actual independent-build evidence.","findings":[{"id":"qualification-linkedit-derived-variance","severity":"MED","location":"/body/contractDetails/api/0/postconditions/3; LLD.md:56","message":"The permitted native transformations do not account explicitly for layout and signature-header changes caused by different debug-path lengths. The actual fs-ext study builds have __LINKEDIT filesize 11464 versus 11496, LC_SYMTAB strsize 4112 versus 4136, LC_CODE_SIGNATURE dataoff 60016 versus 60048, and CodeDirectory codeLimit 60016 versus 60048. The LLD specifies debug-root/timestamp normalization and says page hashes and LC_UUID are the only remaining variable values; validating offsets, sizes and alignment does not define how these differing values enter the compared representation. An exact comparison therefore rejects the observed legitimate variants, while silently omitting these fields would exceed the defined allowances. Specify deterministic accounting and canonicalization for the derived layout fields, string-table references and signature coverage, preserving all execution-relevant relationships. Require a positive unequal-path-length case and negative inconsistent-offset/codeLimit cases.","evidenceReferences":["docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:54","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:56","/private/tmp/insrc-native-study-otoxp86z/first/node_modules/fs-ext/build/Release/fs_ext.node: load commands and parsed CodeDirectory","/private/tmp/insrc-native-study-otoxp86z/second-longer-path/node_modules/fs-ext/build/Release/fs_ext.node: load commands and parsed CodeDirectory","/private/tmp/insrc-native-study-otoxp86z/first.log","/private/tmp/insrc-native-study-otoxp86z/second-longer-path.log","src/daemon/managed-release-staging.ts: fingerprint and stageManagedRelease"]}],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/body/errorPaths","/body/testStrategy","/body/migration","/citations/9","/citations/14","/citations/15","/citations/18","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/macos-portable-qualification-5d5478c6.json","Checkpoint attempt 1: qualification-native-verifier and qualification-trust-lifecycle findings","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md","src/daemon/release-compatibility.ts","src/daemon/managed-release-staging.ts","src/daemon/managed-update-preparation.ts",".npmrc","src/daemon/managed-update-handoff.ts:1-155","src/daemon/managed-update-recovery.ts:1-245","src/shared/installation-mutation-gate.ts:1-130","src/daemon/legacy-launch-job.ts","scripts/insrc-daemon-install.sh:145-285","build-process-broker.mjs","copy-assets.mjs","package.json","src/daemon/__tests__/managed-release-staging.test.ts:1-140","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/TESTS.md","/private/tmp/insrc-native-study-otoxp86z/first.log","/private/tmp/insrc-native-study-otoxp86z/second-longer-path.log","/private/tmp/insrc-native-study-otoxp86z/first/node_modules/fs-ext/build/Release/fs_ext.node","/private/tmp/insrc-native-study-otoxp86z/second-longer-path/node_modules/fs-ext/build/Release/fs_ext.node"],"limitations":[],"advice":["Freeze concrete trust/qualification schemas, domain-tag bytes, length encoding and size limits alongside the shared signer/verifier implementation, with common signature test vectors.","Keep existing synthetic fixture passes distinct from the proposed real-product qualification matrix. No builds, tests or release activation were performed during this read-only design review."]},{"chunkId":"lifecycle","status":"changes_requested","summary":"The current contracts correct the prior rollback ordering defect by retaining the dispatcher fence through archived restoration and durable rollback publication. One remaining lifecycle gap allows the restored legacy daemon's update RPC to mutate lifecycle state before reaching that dispatcher.","findings":[{"id":"lifecycle-legacy-update-rpc-fence","severity":"MED","location":"/body/contractDetails/api/1/postconditions; /body/errorPaths/errorCases/7; /body/testStrategy","message":"The guarded canonical dispatcher does not fence the restored predecessor's public daemon.update handler. The explicitly supported predecessor ab6a96296ea6f2bde948636424218c0a23136c74 spawns its detached helper, writes daemon.update.lock and schedules its own shutdown after 250 ms without consulting InstallationMutationGate or waiting for the helper's admission. Therefore, a concurrent update RPC during archived rollback can disrupt the predecessor before terminal rollback publication even when the dispatcher rejects the eventual shell command. After rollback, the same path can stop the service before a later managed retry finishes qualification; if its reconstructed environment resolves the archive as the daemon root, it can also invoke archived mutating scripts directly. Define how this IPC route is mediated or excluded before predecessor readiness becomes public, including the rollback environment's launcher-root mapping. Add a real-predecessor RPC concurrency test before rollback publication and during a subsequent managed retry, asserting no premature shutdown, marker mutation or archived updater execution.","evidenceReferences":["docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:80","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:194","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:260","git:ab6a96296ea6f2bde948636424218c0a23136c74:src/daemon/update-runner.ts — DAEMON_ROOT, launchUpdate and makeUpdateHandlers","git:ab6a96296ea6f2bde948636424218c0a23136c74:src/daemon/admin-handlers.ts — UPDATE_SHUTDOWN_DELAY_MS and sharedAdminHandlers","src/daemon/legacy-launch-job.ts:restoreDirectLegacyService","src/daemon/__tests__/managed-update-transaction.test.ts:602 — rollback fixture implements shutdown and status, without the predecessor's update RPC"]}],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/body/interactionWithShared","/body/errorPaths","/body/testStrategy","/body/migration","/citations/1","/citations/2","/citations/3","/citations/4","/citations/5","/citations/6","/citations/10","/citations/11","/citations/19","/Users/subhagho/work/projects/insors/insrc/docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md",".insrc/artifacts/LLD-5d5478c61a25ac8f-s1.json",".insrc/tmp/design-review/macos-portable-qualification-5d5478c6.json — prior lifecycle assessment and current assignment","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/ISSUE.md","src/shared/managed-daemon-installation.ts","src/shared/installation-mutation-gate.ts","src/shared/daemon-run-files.ts","src/daemon/managed-update-recovery.ts","src/daemon/managed-update-transaction.ts","src/bin/insrc-daemon-control.ts","src/daemon/legacy-launch-job.ts","src/daemon/legacy-daemon-cutover.ts","src/daemon/legacy-cutover-admission.ts","src/daemon/legacy-run-guard.ts","src/daemon/legacy-drain-evidence.ts","src/daemon/fresh-managed-activation.ts","src/daemon/managed-update-launch.ts","src/daemon/managed-update-handoff.ts","src/daemon/index.ts — startup admission, managed update dispatch and shutdown lifecycle","src/daemon/update-runner.ts","src/daemon/admin-handlers.ts — legacy update handler","scripts/daemon-ctl.sh — launcher roots and update routing","src/daemon/__tests__/legacy-cutover-admission.test.ts — predecessor decoding and concurrent launcher tests","src/daemon/__tests__/managed-update-transaction.test.ts — test inventory and legacy rollback scenarios","src/daemon/__tests__/managed-update-handoff.test.ts — test inventory and response-written handshake scenarios","src/daemon/__tests__/fresh-managed-activation.test.ts — test inventory","src/daemon/__tests__/legacy-run-guard.test.ts — test inventory","src/daemon/__tests__/legacy-daemon-cutover.test.ts — test inventory","git:ab6a96296ea6f2bde948636424218c0a23136c74:src/daemon/update-runner.ts","git:ab6a96296ea6f2bde948636424218c0a23136c74:src/daemon/admin-handlers.ts"],"limitations":[],"advice":[]},{"chunkId":"entrypoints","status":"changes_requested","summary":"The revised design specifies independent bootstrap verification, client preflight routing, stopped-state preservation, and qualified release promotion. One managed-update ordering requirement conflicts with existing client acknowledgement deadlines.","findings":[{"id":"entrypoints-managed-preparation-ack-order","severity":"MED","location":"/body/migration/migrationSteps/5; /body/contractDetails/api/3/preconditions/0","message":"The launchManagedUpdate contract places candidate preparation before routing daemon.update to the detached helper. Preparation includes fetching, building, and inventory verification, but both IDE transports and the installed controller impose a 20-second acknowledgement deadline. A normal cold build can therefore lose its acknowledgement before the helper is launched, producing an unconfirmed update instead of the preserved launch handshake. Specify that the trusted installed helper reserves and acknowledges promptly, then performs preparation after confirmed reply delivery, with qualification still completed before shutdown or cutover. Retain the existing slow-preparation regression test in the acceptance mapping.","evidenceReferences":["docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:122","docs/standalone/enable-managed-daemon-lifecycle-macos-install-E202611115d5478c6/S001/LLD.md:261","src/shared/ipc-client.ts:244","jetbrains-plugin/src/main/kotlin/ai/insors/insrc/jetbrains/daemon/Uni