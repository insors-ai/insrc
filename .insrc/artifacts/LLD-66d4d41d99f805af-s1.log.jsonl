113424	{"artifactId":"LLD-66d4d41d99f805af-s1","entry":{"id":"122510ee8213f67ab3665350cfae1ba1d3bd3a888560da8ef7278c576b36f7d0","targetHeadHash":"ca01c70f7ec478ec3cfa8497114e2082414fe2fd362aed459b4b59af64db12fa","actor":{"id":"agent:design-review-daemon","kind":"agent","properties":{"party":"daemon"}},"timestamp":"2026-11-11T05:57:20.835Z","operation":"review","revision":{"number":1,"contentHash":"9b71c9482592782324a2d5c1b11c2851d013075398a0f7232c17bb517656cd7b"},"outcome":{"result":"block","summary":"Design review lld-66d4d41d99f805af-s1 attempt 1","data":{"kind":"design-chunk-review","reviewId":"lld-66d4d41d99f805af-s1","project":"/Users/subhagho/work/projects/insors/insrc","artifactId":"LLD-66d4d41d99f805af-s1","subject":{"project":"/Users/subhagho/work/projects/insors/insrc","artifactId":"LLD-66d4d41d99f805af-s1","kind":"LLD","canonicalPath":"/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-66d4d41d99f805af-s1.json","documentPath":"/Users/subhagho/work/projects/insors/insrc/docs/standalone/code-review-refuses-correction-packet-because-E2026111166d4d41d/S001/LLD.md","reviewer":"daemon","workflow":{"kind":"issue","rootArtifactId":"ISSUE-66d4d41d99f805af","requiredReferences":[{"role":"originating_issue","artifactId":"ISSUE-66d4d41d99f805af","path":"/Users/subhagho/work/projects/insors/insrc/docs/standalone/code-review-refuses-correction-packet-because-E2026111166d4d41d/ISSUE.md"}],"availableReferences":[],"notApplicableRoles":["PLAN","TASKS","BUILD","CR","DEF","HLD","sibling_stories"]}},"reviewer":"daemon","applicableAttempt":1,"status":"changes_requested","binding":{"sourceRevision":{"number":1,"contentHash":"9b71c9482592782324a2d5c1b11c2851d013075398a0f7232c17bb517656cd7b"},"reviewedContentIdentity":"f04acae3aca017bee2160550d08b773f614bd5030923801ab0fa645e303be83d","documentDigest":"7ae6a5eb3400574557cdea0ff0013f3a3d5c1fb9ea00f6ab2704d62fd1ae60a5","workflowDigest":"b665153295b61c5ab5a5d74cd2d06e1b1d6fec66822d6191cccd991391f17035","author":"controller"},"preservationDigest":"2f1a5c75fec522864c99e61016456f43fb14d5902940070cafb2034361a18118","schemaVersion":1,"submitted":{"artifactPath":"/Users/subhagho/work/projects/insors/insrc/docs/standalone/code-review-refuses-correction-packet-because-E2026111166d4d41d/S001/LLD.md","attempt":1},"attempts":[{"number":1,"status":"changes_requested","preparationKind":"planning","baseline":{"subjectFingerprints":{"canonical":"3b12d25ec04d7e575457c35afd06108bdcab1c34c36c0ec6cf4bdf114f419e60","document":"7ae6a5eb3400574557cdea0ff0013f3a3d5c1fb9ea00f6ab2704d62fd1ae60a5"},"contentIdentity":"f04acae3aca017bee2160550d08b773f614bd5030923801ab0fa645e303be83d","reviewedContent":{"canonical":"{\n  \"meta\": {\n    \"workflow\": \"design.story\",\n    \"runId\": \"wf-1794374944236-tuk6rf\",\n    \"repoPath\": \"/Users/subhagho/work/projects/insors/insrc\",\n    \"createdAt\": \"2026-11-11T05:33:02.016Z\",\n    \"epicCreatedAt\": \"2026-11-11T05:24:15.548Z\",\n    \"attribution\": {\n      \"outputs\": [\n        {\n          \"role\": \"(client)\",\n          \"tier\": \"core\",\n          \"runner\": \"cli-claude\",\n          \"model\": \"claude-opus-5-5\"\n        }\n      ]\n    },\n    \"elapsedMs\": 237155,\n    \"repoIndexedAt\": null,\n    \"schemaVersion\": 1,\n    \"epicHash\": \"66d4d41d99f805af\",\n    \"epicSlug\": \"code-review-refuses-correction-packet-because\",\n    \"storyId\": \"s1\",\n    \"hldBaseRunId\": \"wf-1794374944236-tuk6rf\",\n    \"hldEffectiveHash\": \"a011f9425f02b0eb90bf4cfe2fbacca7ad33bc2590dbfbd28b22cf15e1e24964\",\n    \"hldAmendmentsApplied\": [],\n    \"storyTitle\": \"Scope code-review projection to the packet instead of walking every interleaved commit\",\n    \"standalone\": true,\n    \"sizeClass\": \"bugfix\",\n    \"triageRationale\": \"Sized bugfix ISSUE-66d4d41d99f805af, approved 2026-11-11.\",\n    \"authoredBy\": \"controller\",\n    \"lifecycle\": {\n      \"status\": \"draft\",\n      \"revision\": {\n        \"number\": 1,\n        \"contentHash\": \"9b71c9482592782324a2d5c1b11c2851d013075398a0f7232c17bb517656cd7b\",\n        \"at\": \"2026-11-11T05:33:02.134Z\",\n        \"by\": {\n          \"id\": \"insrc:system\",\n          \"kind\": \"system\",\n          \"properties\": {}\n        }\n      },\n      \"signoffs\": []\n    },\n    \"revision\": 1\n  },\n  \"body\": {\n    \"summary\": {\n      \"prose\": \"Code-review admission proves that each selected change still exists at the pinned revision by checking that no unselected commit deleted or recreated the selected file. Today it does this by reading the file at every commit between the selected commit and the pin, so a busy branch with unrelated merges exhausts the projection budget. This Story asks git once per selected file for the commits that actually changed that file (full history, merges included) and checks only those, so cost follows changes to the reviewed files rather than unrelated work. Every existing outcome, limit and stored identity stays the same.\",\n      \"audience\": \"technical\"\n    },\n    \"hldContextSlice\": {\n      \"frameworkSummary\": \"Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\",\n      \"ownedContracts\": [],\n      \"consumedContracts\": [],\n      \"boundary\": {\n        \"storyId\": \"s1\",\n        \"owns\": [],\n        \"depends\": [],\n        \"internal\": \"Scope code-review projection to the packet instead of walking every interleaved commit\"\n      },\n      \"adjacentBoundaries\": [],\n      \"rolloutPhase\": \"standalone\",\n      \"nonFunctional\": {}\n    },\n    \"contractDetails\": {\n      \"surfaceLevel\": \"internal\",\n      \"api\": [\n        {\n          \"name\": \"git_path_history\",\n          \"signature\": \"git_path_history(input: { cwd?: string; path?: string; rev?: string; diffFilter?: 'A' | 'D' | 'M' | 'R'; firstParent?: boolean; reverse?: boolean; limit?: number; pickaxe?: string; fullHistory?: boolean }): ToolResult<GitPathHistoryData>\",\n          \"parameters\": [\n            {\n              \"name\": \"fullHistory\",\n              \"type\": \"boolean\",\n              \"purpose\": \"New. When true, pass --full-history so git does not simplify history: every commit whose path differs from at least one parent is listed, merges included, and side branches are followed even where a merge matches one parent. Absent or false keeps today's behaviour exactly.\",\n              \"optional\": true\n            },\n            {\n              \"name\": \"rev\",\n              \"type\": \"string\",\n              \"purpose\": \"Existing. A ref or a range such as '<from>..<to>'.\",\n              \"optional\": true\n            },\n            {\n              \"name\": \"path\",\n              \"type\": \"string\",\n              \"purpose\": \"Existing. Matched literally from the repository top (:(top,literal)).\",\n              \"optional\": true\n            }\n          ],\n          \"returns\": {\n            \"type\": \"GitPathHistoryData\",\n            \"meaning\": \"Unchanged shape: { commits: [{ sha, committerTime, subject }] }.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"git failure (existing readGit failure kinds)\",\n              \"condition\": \"git log exits non-zero or cannot spawn; unchanged.\"\n            }\n          ],\n          \"preconditions\": [\n            \"rev passes assertSafeArg('ref'); path passes assertSafeArg('path') (unchanged).\"\n          ],\n          \"postconditions\": [\n            \"With fullHistory absent, argv is identical to today's, so existing callers (src/workflow/git-calls.ts) are unaffected.\"\n          ]\n        },\n        {\n          \"name\": \"ReviewSources\",\n          \"signature\": \"interface ReviewSources { commit(oid: string, field?: string): Promise<readonly string[]>; isAncestor(origin: string, revision: string): Promise<boolean>; file(commit: string, path: string): Promise<PinnedBlob | null>; changedRanges(commit: string, parent: string | null, paths: readonly string[]): Promise<readonly ChangedRange[]>; pathChanges(from: string, to: string, path: string): Promise<readonly string[]> }\",\n          \"parameters\": [\n            {\n              \"name\": \"from\",\n              \"type\": \"string\",\n              \"purpose\": \"Full commit OID where the lineage leg starts (excluded from the result).\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"to\",\n              \"type\": \"string\",\n              \"purpose\": \"Full commit OID where the leg ends (included when it qualifies).\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"path\",\n              \"type\": \"string\",\n              \"purpose\": \"Repository-relative path, matched literally.\",\n              \"optional\": false\n            }\n          ],\n          \"returns\": {\n            \"type\": \"readonly string[]\",\n            \"meaning\": \"New required method pathChanges: the full OIDs of every commit reachable from `to` and not from `from` whose entry at `path` differs from at least one of its parents (git log --full-history from..to -- :(top,literal)path). Any commit not listed has the same entry at `path` as each of its parents. Order is not significant.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"TaskReviewInputError field=source\",\n              \"condition\": \"The git listing fails, or a listed line is not a full hexadecimal commit OID of the repository's hash length.\"\n            }\n          ],\n          \"preconditions\": [\n            \"from and to are full commit OIDs already verified by the caller.\"\n          ],\n          \"postconditions\": [\n            \"No file contents are read.\"\n          ]\n        },\n        {\n          \"name\": \"RegistryReviewSources\",\n          \"signature\": \"class RegistryReviewSources implements ReviewSources { pathChanges(from: string, to: string, path: string): Promise<readonly string[]> }\",\n          \"parameters\": [],\n          \"returns\": {\n            \"type\": \"readonly string[]\",\n            \"meaning\": \"Implements pathChanges with callTool(gitPathHistoryTool, { cwd: repoPath, rev: `${from}..${to}`, path, fullHistory: true }) and returns data.commits[].sha after validating each as a full OID.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"TaskReviewInputError field=source\",\n              \"condition\": \"Tool call unsuccessful or an invalid sha in the result (same field as the existing commit/file source errors).\"\n            }\n          ],\n          \"preconditions\": [],\n          \"postconditions\": [\n            \"Uses no subprocess path other than the typed tool, so the daemon's tool authority and the review worker's spawn bridge apply unchanged.\"\n          ]\n        },\n        {\n          \"name\": \"boundedProjectionSources\",\n          \"signature\": \"boundedProjectionSources(source: ReviewSources, budget: ProjectionBudget): ReviewSources\",\n          \"parameters\": [],\n          \"returns\": {\n            \"type\": \"ReviewSources\",\n            \"meaning\": \"The wrapper gains pathChanges: cached per JSON key [from, to, path]; an uncached call charges budget.read() once, like the other wrapped methods. No change to the other methods or to LIMITS.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"TaskReviewInputError field=projection_limit\",\n              \"condition\": \"Existing read limit exceeded (unchanged message 'Projection object/diff read limit').\"\n            }\n          ],\n          \"preconditions\": [],\n          \"postconditions\": [\n            \"Reads are still awaited serially.\"\n          ]\n        },\n        {\n          \"name\": \"pathContinuity\",\n          \"signature\": \"pathContinuity(path: string, from: string, to: string, origins: readonly SelectedChange[], sources: ReviewSources): Promise<void>\",\n          \"parameters\": [],\n          \"returns\": {\n            \"type\": \"Promise<void>\",\n            \"meaning\": \"Same outcome as today. New procedure: if from === to return. For each commit c in sources.pathChanges(from, to, path) with sources.isAncestor(from, c) true, and for each parent p of c (sources.commit(c)) with p === from or sources.isAncestor(from, p), read sources.file(p, path) and sources.file(c, path) and require equal existence unless c is a selected origin for this path (o.commit === c and o.path or o.previousPath equals path); otherwise scope_conflict.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"TaskReviewInputError field=scope_conflict\",\n              \"condition\": \"Unchanged message 'Unselected path disappearance or recreation interrupts lineage' on an existence flip at an unselected commit.\"\n            }\n          ],\n          \"preconditions\": [\n            \"Called by finalPath exactly as today.\"\n          ],\n          \"postconditions\": [\n            \"The edge set examined equals today's edge set restricted to edges where the path differs, which are the only edges where existence can differ; the comment above the function is updated to say why the full-history listing replaces the walk.\"\n          ]\n        }\n      ]\n    },\n    \"dataModelChanges\": [\n      {\n        \"entity\": \"ReviewSources\",\n        \"change\": \"field-add\",\n        \"details\": \"Adds required method pathChanges(from, to, path). Every implementer must provide it: RegistryReviewSources (production) and the test object literals that implement the interface; literals built from a fixture's sources bind it the same way they bind the other four methods, and stubs that throw when called add a throwing pathChanges.\",\n        \"callSites\": [\n          \"src/workflow/code-review/task-review/sources.ts:44-98\",\n          \"src/workflow/code-review/task-review/projection.ts:27-37\",\n          \"src/workflow/code-review/task-review/__tests__/contracts.test.ts:69\",\n          \"src/workflow/code-review/task-review/__tests__/selected-code.test.ts:24\",\n          \"src/workflow/code-review/task-review/__tests__/admission-checkpoint.test.ts:43\",\n          \"src/workflow/code-review/task-review/__tests__/projection-intervals.test.ts:75\",\n          \"src/workflow/code-review/task-review/__tests__/projection.test.ts:141\",\n          \"src/workflow/code-review/task-review/__tests__/coordinator.test.ts:31\",\n          \"src/workflow/code-review/task-review/__tests__/history.test.ts:128\",\n          \"src/workflow/code-review/task-review/__tests__/admission.test.ts:77\",\n          \"src/workflow/code-review/task-review/__tests__/ownership.test.ts:59\"\n        ]\n      }\n    ],\n    \"interactionWithShared\": [],\n    \"errorPaths\": {\n      \"errorCases\": [\n        {\n          \"scenario\": \"The full-history listing fails (git error, unreadable repository, timeout).\",\n          \"detection\": \"RegistryReviewSources.pathChanges sees callTool(gitPathHistoryTool, ...) return success false.\",\n          \"response\": \"Throw TaskReviewInputError with field 'source' and the tool's message, the same field the existing commit/file reads use; it is never relabeled as projection_limit or as a lineage conflict.\",\n          \"userImpact\": \"Review start is refused with a source error naming the git failure; nothing is saved.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"The listing returns a value that is not a full commit OID.\",\n          \"detection\": \"pathChanges checks every data.commits[].sha against /^[0-9a-f]{40}$|^[0-9a-f]{64}$/ and the length of the from/to OIDs.\",\n          \"response\": \"Throw TaskReviewInputError field 'source' ('Unexpected Git path history entry'); the listing is not used.\",\n          \"userImpact\": \"Refused start; no partial projection.\",\n          \"recoverable\": false\n        },\n        {\n          \"scenario\": \"A listed commit or its parent cannot be read.\",\n          \"detection\": \"Existing sources.commit / sources.file errors.\",\n          \"response\": \"Unchanged existing source errors.\",\n          \"userImpact\": \"Unchanged.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"An unselected commit on any branch between origin and pin deletes or recreates the selected path.\",\n          \"detection\": \"That commit's entry differs from a parent, so the full-history listing includes it; the existence comparison on that edge differs.\",\n          \"response\": \"scope_conflict 'Unselected path disappearance or recreation interrupts lineage' (unchanged).\",\n          \"userImpact\": \"Unchanged outcome.\",\n          \"recoverable\": false\n        },\n        {\n          \"scenario\": \"Read limit is reached because many commits really changed the selected files.\",\n          \"detection\": \"Existing ProjectionBudget.read / decode checks.\",\n          \"response\": \"Unchanged projection_limit errors; limits are not raised.\",\n          \"userImpact\": \"Refused start, now only when the reviewed files themselves changed that often.\",\n          \"recoverable\": false\n        }\n      ],\n      \"edgeCases\": [\n        {\n          \"input\": \"from equals to (selected commit is the pin).\",\n          \"expected\": \"No listing call; returns immediately, as today.\"\n        },\n        {\n          \"input\": \"A merge whose path matches one parent and differs from the other, where the differing parent descends from the origin.\",\n          \"expected\": \"Listed by --full-history; the differing edge is compared; a flip fails with scope_conflict.\"\n        },\n        {\n          \"input\": \"A merge whose path matches every parent.\",\n          \"expected\": \"Not listed; no reads; today's walk would also find equal existence on every edge, so the outcome is the same.\"\n        },\n        {\n          \"input\": \"A listed commit on a side branch that forked before the origin (not a descendant of the origin).\",\n          \"expected\": \"Skipped by isAncestor(from, c), exactly as today's walk never reaches it.\"\n        },\n        {\n          \"input\": \"A listed merge with one parent outside the origin's descendants.\",\n          \"expected\": \"That edge is skipped, as today.\"\n        },\n        {\n          \"input\": \"A selected origin commit for this path that adds or deletes it (selected move boundaries).\",\n          \"expected\": \"Exempt exactly as today (origins.some(o => o.commit === c && (o.path === path || o.previousPath === path))).\"\n        },\n        {\n          \"input\": \"A path with characters git treats as glob or magic.\",\n          \"expected\": \"Matched literally through git_path_history's existing :(top,literal) pathspec.\"\n        },\n        {\n          \"input\": \"Root commit in the range.\",\n          \"expected\": \"No parents, so nothing to compare, as today.\"\n        },\n        {\n          \"input\": \"git_path_history called by existing callers without fullHistory.\",\n          \"expected\": \"Identical argv and output to today.\"\n        }\n      ],\n      \"invariantsToPreserve\": [\n        {\n          \"text\": \"Every descendant edge between origin and pin where the selected path's existence differs is examined, merges and side branches included; simplified or first-parent history must not be used (the comment above pathContinuity).\",\n          \"source\": \"c2\"\n        },\n        {\n          \"text\": \"Projection limits stay 10000 reads, 100000 fragments and 64 MiB decoded bytes, and every uncached source call is charged and awaited serially.\",\n          \"source\": \"c2\"\n        },\n        {\n          \"text\": \"The only production ReviewSources implementer reaches git through typed tools via callTool.\",\n          \"source\": \"c1\"\n        },\n        {\n          \"text\": \"projectReviewScope's result and projectionIdentity depend only on revision, review set, entries and dispositions, so saved attempts keep the same identity.\",\n          \"source\": \"c1\"\n        },\n        {\n          \"text\": \"Existing git_path_history callers see no behaviour change.\",\n          \"source\": \"c3\"\n        }\n      ]\n    },\n    \"testStrategy\": {\n      \"testFramework\": \"node:test with node:assert/strict, run through npx tsx --test (Node 22); real temporary git repositories as fixtures, as in the existing projection.test.ts\",\n      \"testLevels\": [\n        {\n          \"level\": \"unit\",\n          \"purpose\": \"Pin git_path_history's new fullHistory flag against real git semantics and keep its default unchanged.\",\n          \"subjects\": [\n            \"git_path_history\"\n          ],\n          \"fixturesNeeded\": [\n            \"temporary repo: base commit with f; side branch deletes then recreates f, merged; second side branch deletes f, merged with -s ours\"\n          ]\n        },\n        {\n          \"level\": \"integration\",\n          \"purpose\": \"Exercise pathContinuity through projectReviewScope with RegistryReviewSources on real repositories: cost independent of untouched commits, and every existence-flip outcome kept.\",\n          \"subjects\": [\n            \"pathContinuity\",\n            \"boundedProjectionSources\",\n            \"RegistryReviewSources\",\n            \"ReviewSources\"\n          ],\n          \"fixturesNeeded\": [\n            \"temporary repo with a selected change followed by N commits and merges that touch only other files (N = 4 and N = 40)\",\n            \"temporary repo where a side branch forked after the origin deletes the selected file and is merged back keeping it\",\n            \"temporary repo where a side branch deletes and recreates the selected file and is merged\"\n          ]\n        },\n        {\n          \"level\": \"smoke\",\n          \"purpose\": \"Replay Story eedc4519199b24b4/s1's correction packet (pin 92491bba9) against this repository through prepareReviewPacket with RegistryReviewSources and the default budget.\",\n          \"subjects\": [\n            \"projectReviewScope\"\n          ],\n          \"fixturesNeeded\": [\n            \"the attempt-4 packet saved from the refused start\"\n          ]\n        }\n      ],\n      \"acceptanceMapping\": [\n        {\n          \"criterionId\": \"ac1\",\n          \"provingTests\": [\n            \"src/workflow/code-review/task-review/__tests__/projection-lineage.test.ts: lineage reads do not grow with interleaved commits that leave the selected path untouched\",\n            \"src/daemon/tools/builtins/git/__tests__/git-path-history-full.test.ts: fullHistory lists a side-branch deletion and the merge that default history omits\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac2\",\n          \"provingTests\": [\n            \"src/workflow/code-review/task-review/__tests__/projection-lineage.test.ts: a side-branch deletion merged back with the file kept still interrupts lineage\",\n            \"src/workflow/code-review/task-review/__tests__/projection-lineage.test.ts: a side-branch deletion and recreation merged back still interrupts lineage\",\n            \"src/workflow/code-review/task-review/__tests__/projection.test.ts: existing lineage, rename and recreation tests pass unchanged\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac3\",\n          \"provingTests\": [\n            \"src/workflow/code-review/task-review/__tests__/projection-lineage.test.ts: a path history failure is a source error, not a projection limit or lineage conflict\",\n            \"src/workflow/code-review/task-review/__tests__/projection-lineage.test.ts: the read limit still refuses with projection_limit when the selected file itself changed too often\",\n            \"src/daemon/tools/builtins/git/__tests__/git-path-history-full.test.ts: without fullHistory the listing is unchanged\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac4\",\n          \"provingTests\": [\n            \"src/workflow/code-review/task-review/__tests__/history.test.ts: existing saved-attempt tests pass unchanged\",\n            \"src/workflow/code-review/task-review/__tests__/admission.test.ts: existing admission tests pass unchanged\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac5\",\n          \"provingTests\": [\n            \"smoke: the eedc4519199b24b4/s1 correction packet at pin 92491bba9 prepares without projection_limit (reported)\"\n          ]\n        }\n      ]\n    },\n    \"migration\": {\n      \"stateBefore\": \"pathContinuity (src/workflow/code-review/task-review/projection.ts:51-64) walks every commit between a selected origin and the pin and reads the selected file at each commit and parent; reads are charged to ProjectionBudget (src/workflow/code-review/task-review/projection.ts:9), so a packet on a busy branch is refused with projection_limit (s1 bundles 1 and 2). git_path_history has no full-history option (s1 bundle 3).\",\n      \"stateAfter\": \"pathContinuity examines only commits from a full-history listing of the selected path (ReviewSources.pathChanges via git_path_history fullHistory), with identical outcomes, limits and projection identities. No stored data changes.\",\n      \"migrationSteps\": [\n        {\n          \"order\": 1,\n          \"action\": \"Add the optional fullHistory flag to git_path_history; existing callers pass nothing and get the same argv.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 2,\n          \"action\": \"Add pathChanges to ReviewSources, implement it in RegistryReviewSources and wrap it in boundedProjectionSources; bind it in every test literal.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 3,\n          \"action\": \"Switch pathContinuity to the listing-driven edge set and update its comment.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 4,\n          \"action\": \"Deploy by daemon update/restart; saved review attempts need no rewrite because their projection identity does not depend on the walk.\",\n          \"rollbackable\": true\n        }\n      ],\n      \"backwardCompat\": \"git_path_history: additive optional input; default behaviour unchanged. ReviewSources is internal to the daemon (no IPC or plugin exposure); its only production implementer is updated in the same change. Stored review checkpoints and history are not rewritten and re-prepare to the same identity.\",\n      \"zeroDowntime\": true,\n      \"dataRewriteRequired\": false\n    },\n    \"alternativesConsidered\": [\n      {\n        \"id\": \"a1\",\n        \"name\": \"Full-history touch list through git_path_history\",\n        \"oneLineSummary\": \"One full-history, path-limited listing per lineage leg names the only commits whose edges can change the path's existence; only those edges are read.\",\n        \"approach\": \"Add an optional fullHistory flag to the typed git_path_history tool (passes --full-history). Add a required pathChanges(from, to, path) method to ReviewSources that returns the commits in from..to whose literal path differs from at least one parent; RegistryReviewSources implements it with git_path_history { rev: 'from..to', path, fullHistory: true }. boundedProjectionSources caches it per (from, to, path) and charges one read. pathContinuity replaces its walk: for each listed commit that descends from the origin, and each parent that is the origin or descends from it, it compares existence exactly as today. Commits not listed leave the path identical on every edge, so they cannot interrupt lineage.\",\n        \"pros\": [\n          \"Cost follows the commits that touch the selected path, not the number of interleaved commits.\",\n          \"Keeps every edge check, merges included; git's full-history mode lists side-branch deletions that default history drops (probed).\",\n          \"Reuses an existing typed git tool, so daemon tool authority and the worker spawn bridge are unchanged.\",\n          \"Limits, errors and projection identity are untouched.\"\n        ],\n        \"cons\": [\n          \"Adds a required ReviewSources method, so about nine test literals must bind it.\",\n          \"Correctness rests on git's full-history semantics, which the tests must pin.\"\n        ],\n        \"costEstimate\": \"S\"\n      },\n      {\n        \"id\": \"a2\",\n        \"name\": \"Existence by object id, same walk\",\n        \"oneLineSummary\": \"Keep the per-commit walk but test existence with a content-free object lookup instead of reading whole blobs.\",\n        \"approach\": \"Add a ReviewSources method that reports whether commit:path exists (object id only, no content), and make pathContinuity call it instead of file(). The walk still visits every commit from origin to pin; only the decoded bytes disappear.\",\n        \"pros\": [\n          \"Smallest change to pathContinuity's structure.\",\n          \"Removes the decoded-byte growth.\"\n        ],\n        \"cons\": [\n          \"Reads still grow with every interleaved commit (commits x selected files), so a busy branch hits the 10000-read limit instead of the byte limit.\",\n          \"Does not meet ac1.\"\n        ],\n        \"costEstimate\": \"S\",\n        \"reasonRejected\": \"Moves the failure from bytes to reads; does not fix the cause (violates ac1: reads still grow per commit).\"\n      },\n      {\n        \"id\": \"a3\",\n        \"name\": \"Commit graph plus per-commit diffs\",\n        \"oneLineSummary\": \"List the ancestry-path graph once with git_rev_list, then diff each edge for the path with git_diff_tree.\",\n        \"approach\": \"Use git_rev_list --parents over from..to to get the graph and descendant set locally, then for each edge ask git_diff_tree whether the path was added or deleted.\",\n        \"pros\": [\n          \"Exact per-edge answers without decoding blobs.\",\n          \"Descendant test needs no isAncestor calls.\"\n        ],\n        \"cons\": [\n          \"Still one diff call per edge, so reads grow with interleaved commits.\",\n          \"Two tools and more code than a1 for no accuracy gain.\"\n        ],\n        \"costEstimate\": \"M\",\n        \"reasonRejected\": \"Exact but still linear in interleaved commits, with more code than a1 (violates ac1: one diff per edge).\"\n      }\n    ],\n    \"chosenAlternative\": \"a1\",\n    \"openQuestions\": []\n  },\n  \"citations\": [\n    {\n      \"id\": \"c1\",\n      \"kind\": \"analyze-bundle\",\n      \"ref\": \"s1 analyzeBundles[0]: callers of projectReviewScope and boundedProjectionSources; implementers of ReviewSources\",\n      \"quotedText\": \"The only production ReviewSources implementer is RegistryReviewSources\"\n    },\n    {\n      \"id\": \"c2\",\n      \"kind\": \"analyze-bundle\",\n      \"ref\": \"s1 analyzeBundles[1]: the continuity walk and its limits\",\n      \"quotedText\": \"Its comment requires inspecting every descendant edge, not log's simplified or first-parent history.\"\n    },\n    {\n      \"id\": \"c3\",\n      \"kind\": \"analyze-bundle\",\n      \"ref\": \"s1 analyzeBundles[2]: typed git tools available for a path-limited history listing\",\n      \"quotedText\": \"default simplified history omits a side-branch commit that deletes the path when the merge keeps the main side's file, while --full-history lists that commit\"\n    },\n    {\n      \"id\": \"c4\",\n      \"kind\": \"analyze-bundle\",\n      \"ref\": \"s1 analyzeBundles[3]: existing projection tests\"\n    },\n    {\n      \"id\": \"c5\",\n      \"kind\": \"prior-artifact\",\n      \"ref\": \"ISSUE-66d4d41d99f805af\"\n    },\n    {\n      \"id\": \"c6\",\n      \"kind\": \"prior-artifact\",\n      \"ref\": \"LLD-599f1d0bd42e0c37-s1\",\n      \"quotedText\": \"New internal projection counters are capped at 10000 distinct object/diff reads, 100000 projected fragments and 64 MiB cumulative decoded source bytes\"\n    },\n    {\n      \"id\": \"c7\",\n      \"kind\": \"prior-artifact\",\n      \"ref\": \"LLD-e4af63128c7cbec2-s1\",\n      \"quotedText\": \"projection budget increases/optimization\"\n    },\n    {\n      \"id\": \"c8\",\n      \"kind\": \"code\",\n      \"ref\": \"src/workflow/code-review/task-review/projection.ts:48-64\"\n    }\n  ]\n}\n","document":"<!-- insrc:artifact LLD-66d4d41d99f805af-s1 -->\n\n# LLD: STORY-66d4d41d99f805af-s1 — Scope code-review projection to the packet instead of walking every interleaved commit\n\n## Summary\n\n**Epic:** `code-review-refuses-correction-packet-because`\n**HLD base run:** `wf-1794374944236-tuk6rf`\n**HLD effective hash:** `a011f9425f02...`\n\nCode-review admission proves that each selected change still exists at the pinned revision by checking that no unselected commit deleted or recreated the selected file. Today it does this by reading the file at every commit between the selected commit and the pin, so a busy branch with unrelated merges exhausts the projection budget. This Story asks git once per selected file for the commits that actually changed that file (full history, merges included) and checks only those, so cost follows changes to the reviewed files rather than unrelated work. Every existing outcome, limit and stored identity stays the same.\n\n## Contents\n\n1. [HLD context](#1-hld-context)\n2. [Contract details](#2-contract-details)\n3. [Data model changes](#3-data-model-changes)\n4. [Error paths](#4-error-paths)\n5. [Test strategy](#5-test-strategy)\n6. [Migration](#6-migration)\n7. [Alternatives considered](#7-alternatives-considered)\n8. [References](#8-references)\n\n## 1. HLD context\n\n**Framework:** Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\n**Rollout phase:** standalone\n\n## 2. Contract details\n\n**Surface level:** internal\n\n### 2.1 `git_path_history`\n\n```typescript\ngit_path_history(input: { cwd?: string; path?: string; rev?: string; diffFilter?: 'A' | 'D' | 'M' | 'R'; firstParent?: boolean; reverse?: boolean; limit?: number; pickaxe?: string; fullHistory?: boolean }): ToolResult<GitPathHistoryData>\n```\n\n**Parameters:**\n- `fullHistory: boolean` _(optional)_ — New. When true, pass --full-history so git does not simplify history: every commit whose path differs from at least one parent is listed, merges included, and side branches are followed even where a merge matches one parent. Absent or false keeps today's behaviour exactly.\n- `rev: string` _(optional)_ — Existing. A ref or a range such as '<from>..<to>'.\n- `path: string` _(optional)_ — Existing. Matched literally from the repository top (:(top,literal)).\n\n**Returns:** `GitPathHistoryData` — Unchanged shape: { commits: [{ sha, committerTime, subject }] }.\n\n**Errors:**\n- `git failure (existing readGit failure kinds)` when git log exits non-zero or cannot spawn; unchanged.\n\n**Preconditions:**\n- rev passes assertSafeArg('ref'); path passes assertSafeArg('path') (unchanged).\n\n**Postconditions:**\n- With fullHistory absent, argv is identical to today's, so existing callers (src/workflow/git-calls.ts) are unaffected.\n\n### 2.2 `ReviewSources`\n\n```typescript\ninterface ReviewSources { commit(oid: string, field?: string): Promise<readonly string[]>; isAncestor(origin: string, revision: string): Promise<boolean>; file(commit: string, path: string): Promise<PinnedBlob | null>; changedRanges(commit: string, parent: string | null, paths: readonly string[]): Promise<readonly ChangedRange[]>; pathChanges(from: string, to: string, path: string): Promise<readonly string[]> }\n```\n\n**Parameters:**\n- `from: string` — Full commit OID where the lineage leg starts (excluded from the result).\n- `to: string` — Full commit OID where the leg ends (included when it qualifies).\n- `path: string` — Repository-relative path, matched literally.\n\n**Returns:** `readonly string[]` — New required method pathChanges: the full OIDs of every commit reachable from `to` and not from `from` whose entry at `path` differs from at least one of its parents (git log --full-history from..to -- :(top,literal)path). Any commit not listed has the same entry at `path` as each of its parents. Order is not significant.\n\n**Errors:**\n- `TaskReviewInputError field=source` when The git listing fails, or a listed line is not a full hexadecimal commit OID of the repository's hash length.\n\n**Preconditions:**\n- from and to are full commit OIDs already verified by the caller.\n\n**Postconditions:**\n- No file contents are read.\n\n### 2.3 `RegistryReviewSources`\n\n```typescript\nclass RegistryReviewSources implements ReviewSources { pathChanges(from: string, to: string, path: string): Promise<readonly string[]> }\n```\n\n**Returns:** `readonly string[]` — Implements pathChanges with callTool(gitPathHistoryTool, { cwd: repoPath, rev: `${from}..${to}`, path, fullHistory: true }) and returns data.commits[].sha after validating each as a full OID.\n\n**Errors:**\n- `TaskReviewInputError field=source` when Tool call unsuccessful or an invalid sha in the result (same field as the existing commit/file source errors).\n\n**Postconditions:**\n- Uses no subprocess path other than the typed tool, so the daemon's tool authority and the review worker's spawn bridge apply unchanged.\n\n### 2.4 `boundedProjectionSources`\n\n```typescript\nboundedProjectionSources(source: ReviewSources, budget: ProjectionBudget): ReviewSources\n```\n\n**Returns:** `ReviewSources` — The wrapper gains pathChanges: cached per JSON key [from, to, path]; an uncached call charges budget.read() once, like the other wrapped methods. No change to the other methods or to LIMITS.\n\n**Errors:**\n- `TaskReviewInputError field=projection_limit` when Existing read limit exceeded (unchanged message 'Projection object/diff read limit').\n\n**Postconditions:**\n- Reads are still awaited serially.\n\n### 2.5 `pathContinuity`\n\n```typescript\npathContinuity(path: string, from: string, to: string, origins: readonly SelectedChange[], sources: ReviewSources): Promise<void>\n```\n\n**Returns:** `Promise<void>` — Same outcome as today. New procedure: if from === to return. For each commit c in sources.pathChanges(from, to, path) with sources.isAncestor(from, c) true, and for each parent p of c (sources.commit(c)) with p === from or sources.isAncestor(from, p), read sources.file(p, path) and sources.file(c, path) and require equal existence unless c is a selected origin for this path (o.commit === c and o.path or o.previousPath equals path); otherwise scope_conflict.\n\n**Errors:**\n- `TaskReviewInputError field=scope_conflict` when Unchanged message 'Unselected path disappearance or recreation interrupts lineage' on an existence flip at an unselected commit.\n\n**Preconditions:**\n- Called by finalPath exactly as today.\n\n**Postconditions:**\n- The edge set examined equals today's edge set restricted to edges where the path differs, which are the only edges where existence can differ; the comment above the function is updated to say why the full-history listing replaces the walk.\n\n## 3. Data model changes\n\n### 3.1 `ReviewSources` — field-add\n\nAdds required method pathChanges(from, to, path). Every implementer must provide it: RegistryReviewSources (production) and the test object literals that implement the interface; literals built from a fixture's sources bind it the same way they bind the other four methods, and stubs that throw when called add a throwing pathChanges.\n\n**Call sites:**\n- `src/workflow/code-review/task-review/sources.ts:44-98`\n- `src/workflow/code-review/task-review/projection.ts:27-37`\n- `src/workflow/code-review/task-review/__tests__/contracts.test.ts:69`\n- `src/workflow/code-review/task-review/__tests__/selected-code.test.ts:24`\n- `src/workflow/code-review/task-review/__tests__/admission-checkpoint.test.ts:43`\n- `src/workflow/code-review/task-review/__tests__/projection-intervals.test.ts:75`\n- `src/workflow/code-review/task-review/__tests__/projection.test.ts:141`\n- `src/workflow/code-review/task-review/__tests__/coordinator.test.ts:31`\n- `src/workflow/code-review/task-review/__tests__/history.test.ts:128`\n- `src/workflow/code-review/task-review/__tests__/admission.test.ts:77`\n- `src/workflow/code-review/task-review/__tests__/ownership.test.ts:59`\n\n## 4. Error paths\n\n**Error cases**\n\n- **The full-history listing fails (git error, unreadable repository, timeout).** (recoverable)\n  - Detection: RegistryReviewSources.pathChanges sees callTool(gitPathHistoryTool, ...) return success false.\n  - Response: Throw TaskReviewInputError with field 'source' and the tool's message, the same field the existing commit/file reads use; it is never relabeled as projection_limit or as a lineage conflict.\n  - User impact: Review start is refused with a source error naming the git failure; nothing is saved.\n- **The listing returns a value that is not a full commit OID.** (terminal)\n  - Detection: pathChanges checks every data.commits[].sha against /^[0-9a-f]{40}$|^[0-9a-f]{64}$/ and the length of the from/to OIDs.\n  - Response: Throw TaskReviewInputError field 'source' ('Unexpected Git path history entry'); the listing is not used.\n  - User impact: Refused start; no partial projection.\n- **A listed commit or its parent cannot be read.** (recoverable)\n  - Detection: Existing sources.commit / sources.file errors.\n  - Response: Unchanged existing source errors.\n  - User impact: Unchanged.\n- **An unselected commit on any branch between origin and pin deletes or recreates the selected path.** (terminal)\n  - Detection: That commit's entry differs from a parent, so the full-history listing includes it; the existence comparison on that edge differs.\n  - Response: scope_conflict 'Unselected path disappearance or recreation interrupts lineage' (unchanged).\n  - User impact: Unchanged outcome.\n- **Read limit is reached because many commits really changed the selected files.** (terminal)\n  - Detection: Existing ProjectionBudget.read / decode checks.\n  - Response: Unchanged projection_limit errors; limits are not raised.\n  - User impact: Refused start, now only when the reviewed files themselves changed that often.\n\n**Edge cases**\n\n| Input | Expected |\n| :--- | :--- |\n| from equals to (selected commit is the pin). | No listing call; returns immediately, as today. |\n| A merge whose path matches one parent and differs from the other, where the differing parent descends from the origin. | Listed by --full-history; the differing edge is compared; a flip fails with scope_conflict. |\n| A merge whose path matches every parent. | Not listed; no reads; today's walk would also find equal existence on every edge, so the outcome is the same. |\n| A listed commit on a side branch that forked before the origin (not a descendant of the origin). | Skipped by isAncestor(from, c), exactly as today's walk never reaches it. |\n| A listed merge with one parent outside the origin's descendants. | That edge is skipped, as today. |\n| A selected origin commit for this path that adds or deletes it (selected move boundaries). | Exempt exactly as today (origins.some(o => o.commit === c && (o.path === path \\|\\| o.previousPath === path))). |\n| A path with characters git treats as glob or magic. | Matched literally through git_path_history's existing :(top,literal) pathspec. |\n| Root commit in the range. | No parents, so nothing to compare, as today. |\n| git_path_history called by existing callers without fullHistory. | Identical argv and output to today. |\n\n**Invariants to preserve**\n\n- Every descendant edge between origin and pin where the selected path's existence differs is examined, merges and side branches included; simplified or first-parent history must not be used (the comment above pathContinuity). [[c2]]\n- Projection limits stay 10000 reads, 100000 fragments and 64 MiB decoded bytes, and every uncached source call is charged and awaited serially. [[c2]]\n- The only production ReviewSources implementer reaches git through typed tools via callTool. [[c1]]\n- projectReviewScope's result and projectionIdentity depend only on revision, review set, entries and dispositions, so saved attempts keep the same identity. [[c1]]\n- Existing git_path_history callers see no behaviour change. [[c3]]\n\n## 5. Test strategy\n\n**Test framework:** `node:test with node:assert/strict, run through npx tsx --test (Node 22); real temporary git repositories as fixtures, as in the existing projection.test.ts`\n\n**Test levels**\n\n- **unit** — Pin git_path_history's new fullHistory flag against real git semantics and keep its default unchanged.\n  - Subjects: `git_path_history`\n  - Fixtures: `temporary repo: base commit with f; side branch deletes then recreates f, merged; second side branch deletes f, merged with -s ours`\n- **integration** — Exercise pathContinuity through projectReviewScope with RegistryReviewSources on real repositories: cost independent of untouched commits, and every existence-flip outcome kept.\n  - Subjects: `pathContinuity`, `boundedProjectionSources`, `RegistryReviewSources`, `ReviewSources`\n  - Fixtures: `temporary repo with a selected change followed by N commits and merges that touch only other files (N = 4 and N = 40)`, `temporary repo where a side branch forked after the origin deletes the selected file and is merged back keeping it`, `temporary repo where a side branch deletes and recreates the selected file and is merged`\n- **smoke** — Replay Story eedc4519199b24b4/s1's correction packet (pin 92491bba9) against this repository through prepareReviewPacket with RegistryReviewSources and the default budget.\n  - Subjects: `projectReviewScope`\n  - Fixtures: `the attempt-4 packet saved from the refused start`\n\n**Acceptance mapping**\n\n| Criterion | Proving tests |\n| :--- | :--- |\n| `ac1` | `src/workflow/code-review/task-review/__tests__/projection-lineage.test.ts: lineage reads do not grow with interleaved commits that leave the selected path untouched`, `src/daemon/tools/builtins/git/__tests__/git-path-history-full.test.ts: fullHistory lists a side-branch deletion and the merge that default history omits` |\n| `ac2` | `src/workflow/code-review/task-review/__tests__/projection-lineage.test.ts: a side-branch deletion merged back with the file kept still interrupts lineage`, `src/workflow/code-review/task-review/__tests__/projection-lineage.test.ts: a side-branch deletion and recreation merged back still interrupts lineage`, `src/workflow/code-review/task-review/__tests__/projection.test.ts: existing lineage, rename and recreation tests pass unchanged` |\n| `ac3` | `src/workflow/code-review/task-review/__tests__/projection-lineage.test.ts: a path history failure is a source error, not a projection limit or lineage conflict`, `src/workflow/code-review/task-review/__tests__/projection-lineage.test.ts: the read limit still refuses with projection_limit when the selected file itself changed too often`, `src/daemon/tools/builtins/git/__tests__/git-path-history-full.test.ts: without fullHistory the listing is unchanged` |\n| `ac4` | `src/workflow/code-review/task-review/__tests__/history.test.ts: existing saved-attempt tests pass unchanged`, `src/workflow/code-review/task-review/__tests__/admission.test.ts: existing admission tests pass unchanged` |\n| `ac5` | `smoke: the eedc4519199b24b4/s1 correction packet at pin 92491bba9 prepares without projection_limit (reported)` |\n\n## 6. Migration\n\n**State before:** pathContinuity (src/workflow/code-review/task-review/projection.ts:51-64) walks every commit between a selected origin and the pin and reads the selected file at each commit and parent; reads are charged to ProjectionBudget (src/workflow/code-review/task-review/projection.ts:9), so a packet on a busy branch is refused with projection_limit (s1 bundles 1 and 2). git_path_history has no full-history option (s1 bundle 3).\n\n**State after:** pathContinuity examines only commits from a full-history listing of the selected path (ReviewSources.pathChanges via git_path_history fullHistory), with identical outcomes, limits and projection identities. No stored data changes.\n\n**Zero downtime:** yes — **Data rewrite:** no\n\n**Steps**\n\n1. Add the optional fullHistory flag to git_path_history; existing callers pass nothing and get the same argv. — ↩ rollbackable\n2. Add pathChanges to ReviewSources, implement it in RegistryReviewSources and wrap it in boundedProjectionSources; bind it in every test literal. — ↩ rollbackable\n3. Switch pathContinuity to the listing-driven edge set and update its comment. — ↩ rollbackable\n4. Deploy by daemon update/restart; saved review attempts need no rewrite because their projection identity does not depend on the walk. — ↩ rollbackable\n\n**Backward compat:** git_path_history: additive optional input; default behaviour unchanged. ReviewSources is internal to the daemon (no IPC or plugin exposure); its only production implementer is updated in the same change. Stored review checkpoints and history are not rewritten and re-prepare to the same identity.\n\n## 7. Alternatives considered\n\n### 7.1 a1: Full-history touch list through git_path_history — **CHOSEN**\n\nOne full-history, path-limited listing per lineage leg names the only commits whose edges can change the path's existence; only those edges are read.\n\nAdd an optional fullHistory flag to the typed git_path_history tool (passes --full-history). Add a required pathChanges(from, to, path) method to ReviewSources that returns the commits in from..to whose literal path differs from at least one parent; RegistryReviewSources implements it with git_path_history { rev: 'from..to', path, fullHistory: true }. boundedProjectionSources caches it per (from, to, path) and charges one read. pathContinuity replaces its walk: for each listed commit that descends from the origin, and each parent that is the origin or descends from it, it compares existence exactly as today. Commits not listed leave the path identical on every edge, so they cannot interrupt lineage.\n\n### 7.2 a2: Existence by object id, same walk\n\nKeep the per-commit walk but test existence with a content-free object lookup instead of reading whole blobs.\n\nAdd a ReviewSources method that reports whether commit:path exists (object id only, no content), and make pathContinuity call it instead of file(). The walk still visits every commit from origin to pin; only the decoded bytes disappear.\n\n**Rejected because:** Moves the failure from bytes to reads; does not fix the cause (violates ac1: reads still grow per commit).\n\n### 7.3 a3: Commit graph plus per-commit diffs\n\nList the ancestry-path graph once with git_rev_list, then diff each edge for the path with git_diff_tree.\n\nUse git_rev_list --parents over from..to to get the graph and descendant set locally, then for each edge ask git_diff_tree whether the path was added or deleted.\n\n**Rejected because:** Exact but still linear in interleaved commits, with more code than a1 (violates ac1: one diff per edge).\n\n## 8. References\n\n- **[[c1]]** `analyze-bundle` `s1 analyzeBundles[0]: callers of projectReviewScope and boundedProjectionSources; implementers of ReviewSources` — \"The only production ReviewSources implementer is RegistryReviewSources\"\n- **[[c2]]** `analyze-bundle` `s1 analyzeBundles[1]: the continuity walk and its limits` — \"Its comment requires inspecting every descendant edge, not log's simplified or first-parent history.\"\n- **[[c3]]** `analyze-bundle` `s1 analyzeBundles[2]: typed git tools available for a path-limited history listing` — \"default simplified history omits a side-branch commit that deletes the path when the merge keeps the main side's file, while --full-history lists that commit\"\n- **[[c4]]** `analyze-bundle` `s1 analyzeBundles[3]: existing projection tests`\n- **[[c5]]** `prior-artifact` `ISSUE-66d4d41d99f805af`\n- **[[c6]]** `prior-artifact` `LLD-599f1d0bd42e0c37-s1` — \"New internal projection counters are capped at 10000 distinct object/diff reads, 100000 projected fragments and 64 MiB cumulative decoded source bytes\"\n- **[[c7]]** `prior-artifact` `LLD-e4af63128c7cbec2-s1` — \"projection budget increases/optimization\"\n- **[[c8]]** `code` `src/workflow/code-review/task-review/projection.ts:48-64`\n"},"capturedAt":"2026-11-11T05:33:24.060Z"},"inventory":{"units":[{"id":"/body/summary","selector":"/body/summary","title":"summary","kind":"section"},{"id":"/body/hldContextSlice","selector":"/body/hldContextSlice","title":"hldContextSlice","kind":"section"},{"id":"/body/contractDetails","selector":"/body/contractDetails","title":"contractDetails","kind":"section"},{"id":"/body/dataModelChanges","selector":"/body/dataModelChanges","title":"dataModelChanges","kind":"section"},{"id":"/body/interactionWithShared","selector":"/body/interactionWithShared","title":"interactionWithShared","kind":"section"},{"id":"/body/errorPaths","selector":"/body/errorPaths","title":"errorPaths","kind":"section"},{"id":"/body/testStrategy","selector":"/body/testStrategy","title":"testStrategy","kind":"section"},{"id":"/body/migration","selector":"/body/migration","title":"migration","kind":"section"},{"id":"/body/alternativesConsidered","selector":"/body/alternativesConsidered","title":"alternativesConsidered","kind":"section"},{"id":"/body/chosenAlternative","selector":"/body/chosenAlternative","title":"chosenAlternative","kind":"section"},{"id":"/body/openQuestions","selector":"/body/openQuestions","tit