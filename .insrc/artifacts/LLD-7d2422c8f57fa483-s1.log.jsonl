146137	{"artifactId":"LLD-7d2422c8f57fa483-s1","entry":{"id":"b31fc88285fa53d79093d7090fa070277df0cf101a420112d51d4b5e54f42abf","targetHeadHash":"fc5ae687ab4355e9bb839376a54a3477cf5abfefde9762391ed029ec7e9dcbfe","actor":{"id":"agent:design-review-daemon","kind":"agent","properties":{"party":"daemon"}},"timestamp":"2026-11-11T14:55:31.306Z","operation":"review","revision":{"number":1,"contentHash":"87f01de51142de175aa3fced08093badf6b874503d98e624444926a1774b39ea"},"outcome":{"result":"block","summary":"Design review lld-7d2422c8f57fa483-s1 attempt 1","data":{"kind":"design-chunk-review","reviewId":"lld-7d2422c8f57fa483-s1","project":"/Users/subhagho/work/projects/insors/insrc","artifactId":"LLD-7d2422c8f57fa483-s1","subject":{"project":"/Users/subhagho/work/projects/insors/insrc","artifactId":"LLD-7d2422c8f57fa483-s1","kind":"LLD","canonicalPath":"/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-7d2422c8f57fa483-s1.json","documentPath":"/Users/subhagho/work/projects/insors/insrc/docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md","reviewer":"daemon","workflow":{"kind":"issue","rootArtifactId":"ISSUE-7d2422c8f57fa483","requiredReferences":[{"role":"originating_issue","artifactId":"ISSUE-7d2422c8f57fa483","path":"/Users/subhagho/work/projects/insors/insrc/docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/ISSUE.md"}],"availableReferences":[],"notApplicableRoles":["PLAN","TASKS","BUILD","CR","DEF","HLD","sibling_stories"]}},"reviewer":"daemon","applicableAttempt":1,"status":"changes_requested","binding":{"sourceRevision":{"number":1,"contentHash":"87f01de51142de175aa3fced08093badf6b874503d98e624444926a1774b39ea"},"reviewedContentIdentity":"56d8ad685a5e98fa568b2aa4a74b7f65ba9c413c04a98fe35f30ced280a5e9e2","documentDigest":"653f2eae43a1687f8db517b4080613be136ca712f037acddaabb25b4e35dc113","workflowDigest":"6078c984a04538837d6c8bd8a19455d8fe137dc3d8569b38169232b8dadb4aeb","author":"controller"},"preservationDigest":"b0ccb2a37748a9f32acb42429af4e859f190a0ecf48cf606cf3992f1a8f6beab","schemaVersion":1,"submitted":{"artifactPath":"/Users/subhagho/work/projects/insors/insrc/docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md","attempt":1},"attempts":[{"number":1,"status":"changes_requested","preparationKind":"planning","baseline":{"subjectFingerprints":{"canonical":"369d97af26411813895e70d40da797e9c09b39ad09562cee1e6678a5f59b520a","document":"653f2eae43a1687f8db517b4080613be136ca712f037acddaabb25b4e35dc113"},"contentIdentity":"56d8ad685a5e98fa568b2aa4a74b7f65ba9c413c04a98fe35f30ced280a5e9e2","reviewedContent":{"canonical":"{\n  \"meta\": {\n    \"workflow\": \"design.story\",\n    \"runId\": \"wf-1794407632473-fqkai5\",\n    \"repoPath\": \"/Users/subhagho/work/projects/insors/insrc\",\n    \"createdAt\": \"2026-11-11T14:40:22.265Z\",\n    \"epicCreatedAt\": \"2026-11-11T14:26:38.657Z\",\n    \"attribution\": {\n      \"outputs\": [\n        {\n          \"role\": \"(client)\",\n          \"tier\": \"core\",\n          \"runner\": \"cli-claude\",\n          \"model\": \"claude-opus-5-5\"\n        }\n      ]\n    },\n    \"elapsedMs\": 389319,\n    \"repoIndexedAt\": null,\n    \"schemaVersion\": 1,\n    \"epicHash\": \"7d2422c8f57fa483\",\n    \"epicSlug\": \"code-review-reuse-refused-when-only\",\n    \"storyId\": \"s1\",\n    \"hldBaseRunId\": \"wf-1794407632473-fqkai5\",\n    \"hldEffectiveHash\": \"08ce4141d5399658b3512825848e496d9305bf07ca44d89c38bc740812c04148\",\n    \"hldAmendmentsApplied\": [],\n    \"storyTitle\": \"Let code-review reuse survive provenance-only test-row changes\",\n    \"standalone\": true,\n    \"sizeClass\": \"bugfix\",\n    \"triageRationale\": \"Sized bugfix ISSUE-7d2422c8f57fa483, approved 2026-11-11.\",\n    \"authoredBy\": \"controller\",\n    \"lifecycle\": {\n      \"status\": \"draft\",\n      \"revision\": {\n        \"number\": 1,\n        \"contentHash\": \"87f01de51142de175aa3fced08093badf6b874503d98e624444926a1774b39ea\",\n        \"at\": \"2026-11-11T14:40:22.646Z\",\n        \"by\": {\n          \"id\": \"insrc:system\",\n          \"kind\": \"system\",\n          \"properties\": {}\n        }\n      },\n      \"signoffs\": []\n    },\n    \"revision\": 1\n  },\n  \"body\": {\n    \"summary\": {\n      \"prose\": \"A code-review correction attempt may reuse an earlier task result only when the task's inputs are unchanged, but today that check also covers free-text provenance in each test row, so rewording or re-running tests blocks reuse. This Story versions the task identity: new attempts use a format whose test entries carry only the committed test file, its cases and its result, and record that format on the attempt. Attempts saved before the change keep their original format and validate exactly as before, and reuse across the two formats is refused with the usual reassess feedback.\",\n      \"audience\": \"technical\"\n    },\n    \"hldContextSlice\": {\n      \"frameworkSummary\": \"Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\",\n      \"ownedContracts\": [],\n      \"consumedContracts\": [],\n      \"boundary\": {\n        \"storyId\": \"s1\",\n        \"owns\": [],\n        \"depends\": [],\n        \"internal\": \"Let code-review reuse survive provenance-only test-row changes\"\n      },\n      \"adjacentBoundaries\": [],\n      \"rolloutPhase\": \"standalone\",\n      \"nonFunctional\": {}\n    },\n    \"contractDetails\": {\n      \"surfaceLevel\": \"internal\",\n      \"api\": [\n        {\n          \"name\": \"taskFinalIdentity\",\n          \"signature\": \"taskFinalIdentity(prepared: PreparedReviewPacket, assignment: TaskAssignment, format?: TaskIdentityFormat): string  // type TaskIdentityFormat = 'final-task-v1' | 'final-task-v2'\",\n          \"parameters\": [\n            {\n              \"name\": \"format\",\n              \"type\": \"TaskIdentityFormat\",\n              \"purpose\": \"Which input the hash covers. 'final-task-v1' (default, today's input) hashes each assigned test as { detail: <whole submitted row>, blobOid }. 'final-task-v2' hashes each assigned test as { file, cases, result, blobOid }; requirements (taskId, title, summary, acceptanceChecks), changes and documents are hashed exactly as in v1.\",\n              \"optional\": true\n            }\n          ],\n          \"returns\": {\n            \"type\": \"string\",\n            \"meaning\": \"Hex sha256 of the canonical task input in the given format; the format name is part of the hashed input, so v1 and v2 identities never coincide.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"TaskReviewInputError field=attribution\",\n              \"condition\": \"Existing checks: missing final task source identities, unknown assigned test, historical scope.\"\n            }\n          ],\n          \"preconditions\": [\n            \"prepared has a projection and finalTestBlobs for every packet test (unchanged).\"\n          ],\n          \"postconditions\": [\n            \"With format 'final-task-v1' the result is byte-identical to today's taskFinalIdentity.\"\n          ]\n        },\n        {\n          \"name\": \"bindTaskFinalIdentities\",\n          \"signature\": \"bindTaskFinalIdentities(review: AdmittedReview, input: readonly AcceptedTaskAttribution[]): Promise<readonly TaskAssignment[]>\",\n          \"parameters\": [],\n          \"returns\": {\n            \"type\": \"Promise<readonly TaskAssignment[]>\",\n            \"meaning\": \"Unchanged result. The identity format is the attempt header's taskIdentityFormat when present; otherwise 'final-task-v1' when the attempt is already accepted (saved before this change) and 'final-task-v2' when the mapping is being accepted now. A newly accepted mapping stores taskIdentityFormat: 'final-task-v2' alongside taskScopeIdentities in the same candidate; a re-bound accepted attempt must reproduce every stored key, including the format when present.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"TaskReviewInputError field=attribution\",\n              \"condition\": \"Existing: 'Accepted mapping cannot change within an attempt' when a re-bound attempt does not reproduce its stored identities or format.\"\n            }\n          ],\n          \"preconditions\": [],\n          \"postconditions\": [\n            \"Saved accepted attempts without taskIdentityFormat re-bind with v1 identities exactly as today.\"\n          ]\n        },\n        {\n          \"name\": \"requireReuseIdentity\",\n          \"signature\": \"requireReuseIdentity(review: AdmittedReview, assignment: TaskAssignment): void\",\n          \"parameters\": [],\n          \"returns\": {\n            \"type\": \"void\",\n            \"meaning\": \"Before comparing identities, requires the source attempt's identity format (its taskIdentityFormat, or 'final-task-v1' when absent) to equal the current attempt's. A differing format is refused at field origins/tasks/<index>/sourceAttempt/<n> with feedback naming the task and source attempt, saying its result was recorded under an earlier identity format, and asking to set action to reassess and omit sourceAttempt for this task. Otherwise the identity comparison and its existing feedback are unchanged, computed in the shared format.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"TaskReviewInputError field=origins/tasks/<index>/sourceAttempt/<n>\",\n              \"condition\": \"Format differs, or identity differs (existing reassess feedback).\"\n            }\n          ],\n          \"preconditions\": [],\n          \"postconditions\": [\n            \"A published reuse row and its source always carry identities of the same format, so the publication check in src/workflow/code-review/task-review/record.ts:76 stays a like-for-like equality.\"\n          ]\n        },\n        {\n          \"name\": \"taskInputFingerprint\",\n          \"signature\": \"taskInputFingerprint(prepared: PreparedReviewPacket, assignment: TaskAssignment): TaskInputFingerprint\",\n          \"parameters\": [],\n          \"returns\": {\n            \"type\": \"TaskInputFingerprint\",\n            \"meaning\": \"Transient diagnostic used by the reuse-rejection text. Its tests entries hash the v2 test fields ({ file, cases, result, blobOid }), so a rejection names only a test whose file, cases or result changed. Not persisted.\"\n          },\n          \"errors\": [],\n          \"preconditions\": [],\n          \"postconditions\": [\n            \"The rejection message format from ISSUE-146084d04395b88b is unchanged.\"\n          ]\n        }\n      ]\n    },\n    \"dataModelChanges\": [\n      {\n        \"entity\": \"ReviewAttempt.header (code-review checkpoint)\",\n        \"change\": \"field-add\",\n        \"details\": \"Optional taskIdentityFormat: 'final-task-v2', written when a mapping is accepted under this change; absent means 'final-task-v1'. Added to the header interface and to the strict header schema in src/workflow/code-review/task-review/contracts.ts. CR summaries, history snapshots and record schemas are unchanged: they copy and compare stored identities without recomputing them.\",\n        \"callSites\": [\n          \"src/workflow/code-review/task-review/contracts.ts:112\",\n          \"src/workflow/code-review/task-review/contracts.ts:130\",\n          \"src/workflow/code-review/task-review/attribution-binding.ts:121-140\"\n        ]\n      },\n      {\n        \"entity\": \"taskFinalInput (task reuse identity input)\",\n        \"change\": \"invariant-change\",\n        \"details\": \"New 'final-task-v2' input: each assigned test contributes { file, cases, result, blobOid } instead of the whole row. 'final-task-v1' is kept unchanged for saved attempts.\",\n        \"callSites\": [\n          \"src/workflow/code-review/task-review/attribution-binding.ts:23-34\",\n          \"src/workflow/code-review/task-review/attribution-binding.ts:109-119\"\n        ]\n      }\n    ],\n    \"interactionWithShared\": [],\n    \"errorPaths\": {\n      \"errorCases\": [\n        {\n          \"scenario\": \"A correction attempt reuses a task whose source attempt was recorded under the earlier identity format.\",\n          \"detection\": \"requireReuseIdentity compares the source attempt's taskIdentityFormat (absent = 'final-task-v1') with the current attempt's before comparing identities.\",\n          \"response\": \"TaskReviewInputError at origins/tasks/<index>/sourceAttempt/<n>: the task's result was recorded under an earlier identity format; set action to reassess and omit sourceAttempt for this task; retain eligible reuse for other tasks.\",\n          \"userImpact\": \"The reviewer reassesses that task once; later attempts can reuse it under the new format.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"A reused task's committed test file, cases or result changed.\",\n          \"detection\": \"The v2 identity of the current task differs from the source attempt's stored v2 identity.\",\n          \"response\": \"Existing reuse rejection (\\\"cannot reuse attempt N: relevant task inputs changed (tests <file>)\\\"), now naming only tests whose file, cases or result changed.\",\n          \"userImpact\": \"Unchanged: that task is reassessed.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"A saved accepted attempt is re-bound and its stored identities or format no longer reproduce.\",\n          \"detection\": \"bindTaskFinalIdentities' existing deep-equality of every candidate key against the saved header.\",\n          \"response\": \"Existing 'Accepted mapping cannot change within an attempt' error.\",\n          \"userImpact\": \"Unchanged fail-closed behaviour.\",\n          \"recoverable\": false\n        },\n        {\n          \"scenario\": \"A checkpoint header carries an unknown taskIdentityFormat value.\",\n          \"detection\": \"The strict header schema accepts only 'final-task-v2' for the optional field.\",\n          \"response\": \"Existing schema rejection of the checkpoint.\",\n          \"userImpact\": \"The checkpoint is refused rather than silently mis-hashed.\",\n          \"recoverable\": false\n        }\n      ],\n      \"edgeCases\": [\n        {\n          \"input\": \"Correction attempt on the same pin whose test rows differ only in evidenceReferences, executionDetails or command, source attempt in the new format.\",\n          \"expected\": \"Reuse is accepted; identities match.\"\n        },\n        {\n          \"input\": \"Saved attempt (no taskIdentityFormat) resumed or re-prepared after the change.\",\n          \"expected\": \"Re-binds with v1 identities and validates as today; no format is added.\"\n        },\n        {\n          \"input\": \"Attempt saved as pending before the change and accepted after it.\",\n          \"expected\": \"Accepted with v2 identities and taskIdentityFormat recorded.\"\n        },\n        {\n          \"input\": \"A task with no assigned tests.\",\n          \"expected\": \"v2 identity covers requirements, changes and documents only, as v1 does.\"\n        },\n        {\n          \"input\": \"Two tasks share one test row and one of them is reused.\",\n          \"expected\": \"Each task's identity covers its own assigned tests; unchanged shared rows keep both reusable.\"\n        },\n        {\n          \"input\": \"Test row cases reordered.\",\n          \"expected\": \"Treated as a change (cases are hashed as submitted), so reuse is refused; no reordering normalisation is added.\"\n        }\n      ],\n      \"invariantsToPreserve\": [\n        {\n          \"text\": \"Saved accepted attempts recompute exactly the identities they stored when re-bound (bindTaskFinalIdentities deep-equality).\",\n          \"source\": \"c1\"\n        },\n        {\n          \"text\": \"A published reuse row's identity equals its source attempt's stored identity for that task (record.ts:76).\",\n          \"source\": \"c2\"\n        },\n        {\n          \"text\": \"History snapshots and CR summaries copy stored identities without recomputing them.\",\n          \"source\": \"c2\"\n        },\n        {\n          \"text\": \"The three-submission attribution budget and the reassess feedback of ISSUE-146084d04395b88b are unchanged.\",\n          \"source\": \"c2\"\n        },\n        {\n          \"text\": \"Committed sources, documents, requirements and each test's committed file content remain part of the reuse identity.\",\n          \"source\": \"c1\"\n        }\n      ]\n    },\n    \"testStrategy\": {\n      \"testFramework\": \"node:test with node:assert/strict, run through npx tsx --test (Node 22), using the existing task-review publication fixture (src/workflow/code-review/task-review/__tests__/publication-fixture.ts) as in src/workflow/code-review/task-review/__tests__/attribution-binding.test.ts\",\n      \"testLevels\": [\n        {\n          \"level\": \"unit\",\n          \"purpose\": \"Pin the two identity formats: v1 is byte-identical to the pre-change identity, v2 ignores provenance-only test-row fields and still reacts to the test file blob, cases and result.\",\n          \"subjects\": [\n            \"taskFinalIdentity\",\n            \"taskInputFingerprint\"\n          ],\n          \"fixturesNeeded\": [\n            \"prepared review from the publication fixture with one task and one test row\"\n          ]\n        },\n        {\n          \"level\": \"integration\",\n          \"purpose\": \"Exercise bindTaskFinalIdentities, restoreAcceptedAssignments and requireReuseIdentity across attempts on a real fixture checkpoint: a v2 source reused after provenance-only edits; a v2 source refused after a real test change; a v1 (unmarked) saved attempt re-binding unchanged and refused as a reuse source with format feedback; the CR record validation accepting the published reuse row.\",\n          \"subjects\": [\n            \"bindTaskFinalIdentities\",\n            \"requireReuseIdentity\",\n            \"restoreAcceptedAssignments\"\n          ],\n          \"fixturesNeeded\": [\n            \"publication fixture checkpoint with an accepted attempt 1 (v2) and a correction attempt 2 whose test rows differ only in evidenceReferences, executionDetails and command\",\n            \"same, with attempt 2 changing a test's cases\",\n            \"a saved accepted attempt without taskIdentityFormat whose stored identities were computed by the v1 formula\"\n          ]\n        }\n      ],\n      \"acceptanceMapping\": [\n        {\n          \"criterionId\": \"ac1\",\n          \"provingTests\": [\n            \"src/workflow/code-review/task-review/__tests__/reuse-identity.test.ts: a correction attempt reuses a task when only provenance text in its test rows changed\",\n            \"src/workflow/code-review/task-review/__tests__/reuse-identity.test.ts: the v2 task identity ignores command, execution details and evidence references\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac2\",\n          \"provingTests\": [\n            \"src/workflow/code-review/task-review/__tests__/reuse-identity.test.ts: the v2 task identity changes with the test file, cases or result\",\n            \"src/workflow/code-review/task-review/__tests__/reuse-identity.test.ts: reuse is still refused with reassess feedback when a test's cases changed\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac3\",\n          \"provingTests\": [\n            \"src/workflow/code-review/task-review/__tests__/reuse-identity.test.ts: a saved attempt without an identity format re-binds with its stored v1 identities\",\n            \"src/workflow/code-review/task-review/__tests__/attribution-binding.test.ts: existing tests pass unchanged\",\n            \"src/workflow/code-review/task-review/__tests__/compatibility.test.ts: existing tests pass unchanged\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac4\",\n          \"provingTests\": [\n            \"src/workflow/code-review/task-review/__tests__/reuse-identity.test.ts: reuse from an attempt recorded under the earlier identity format is refused with reassess feedback\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac5\",\n          \"provingTests\": [\n            \"src/workflow/code-review/task-review/__tests__/reuse-identity.test.ts: a correction attempt reuses a task when only provenance text in its test rows changed\"\n          ]\n        }\n      ]\n    },\n    \"migration\": {\n      \"stateBefore\": \"The task reuse identity hashes the whole submitted test row (src/workflow/code-review/task-review/attribution-binding.ts:23-34, s1 bundle 1); saved attempts store those identities in taskScopeIdentities and are re-bound against them on restore, and publication checks reuse by identity equality (src/workflow/code-review/task-review/record.ts:76, s1 bundle 2).\",\n      \"stateAfter\": \"New accepted mappings store 'final-task-v2' identities and taskIdentityFormat on the attempt header; unmarked saved attempts keep 'final-task-v1'; reuse requires matching formats and identities.\",\n      \"migrationSteps\": [\n        {\n          \"order\": 1,\n          \"action\": \"Add the optional taskIdentityFormat field ('final-task-v2') to the attempt header interface and strict schema.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 2,\n          \"action\": \"Add the v2 identity input and make bindTaskFinalIdentities, requireReuseIdentity and taskInputFingerprint format-aware; v1 stays the default for unmarked accepted attempts.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 3,\n          \"action\": \"Deploy by daemon update/restart. No stored data is rewritten; existing checkpoints and CR history read as before.\",\n          \"rollbackable\": false,\n          \"prerequisiteFlags\": [\n            \"Rolling back to code without the field makes checkpoints that already carry taskIdentityFormat unreadable by the older strict schema; roll back only with no such checkpoints, or keep a reader that accepts the field.\"\n          ]\n        }\n      ],\n      \"backwardCompat\": \"Internal daemon contract only (no IPC or plugin surface). Saved attempts and CR history written before the change keep validating unchanged; results from those attempts cannot be reused by attempts accepted after the change and are reassessed once. Older daemon builds cannot read checkpoints that carry the new optional field.\",\n      \"zeroDowntime\": true,\n      \"dataRewriteRequired\": false\n    },\n    \"alternativesConsidered\": [\n      {\n        \"id\": \"a1\",\n        \"name\": \"Versioned task identity recorded on the attempt\",\n        \"oneLineSummary\": \"New attempts compute a 'final-task-v2' identity whose test entries carry only file, cases, result and the committed test blob, and record that format on the attempt header; saved attempts without the marker keep computing 'final-task-v1'.\",\n        \"approach\": \"taskFinalInput takes a format. 'final-task-v1' is today's input unchanged. 'final-task-v2' keeps requirements, changes and documents as today and replaces each test entry's detail with { file, cases, result } plus the committed test blobOid. bindTaskFinalIdentities computes identities in the attempt's format: the header's taskIdentityFormat when present, else 'final-task-v1' for an already accepted attempt, and 'final-task-v2' for a newly accepted mapping, which it records as taskIdentityFormat on the header. The strict attempt header schema gains the optional field. requireReuseIdentity refuses reuse when the source attempt's format differs from the current attempt's, with reassess feedback, before comparing identities; taskInputFingerprint uses the same v2 test fields so the rejection text names only real changes.\",\n        \"pros\": [\n          \"Saved attempts recompute exactly what they stored, so restore, validation and publication are unchanged for history.\",\n          \"Published reuse rows always compare identities of one format, so the record.ts equality check stays correct.\",\n          \"The format is explicit in the data rather than inferred.\"\n        ],\n        \"cons\": [\n          \"Adds one optional header field and its schema entry.\",\n          \"Results from attempts saved before the change cannot be reused by new attempts (they must be reassessed once).\"\n        ],\n        \"costEstimate\": \"S\"\n      },\n      {\n        \"id\": \"a2\",\n        \"name\": \"Infer the format by trial\",\n        \"oneLineSummary\": \"Compute both v1 and v2 identities when restoring and accept whichever matches the stored values; no stored marker.\",\n        \"approach\": \"On restore, accept the saved taskScopeIdentities when every one equals either the v1 or the v2 recomputation (all tasks in one format). New attempts store v2. Reuse compares the source's stored identity against the current task's identity in the format that matched for the source; cross-format reuse is refused.\",\n        \"pros\": [\n          \"No schema change.\"\n        ],\n        \"cons\": [\n          \"The format of an attempt is implicit and must be rediscovered on every read, including in record.ts and history checks.\",\n          \"Two hash computations per task on every restore.\"\n        ],\n        \"costEstimate\": \"S\",\n        \"reasonRejected\": \"Avoids a schema field but leaves the format implicit; it must be rediscovered wherever reuse is checked, including record.ts publication checks (ac4 partial).\"\n      },\n      {\n        \"id\": \"a3\",\n        \"name\": \"Separate reuse identity beside the integrity identity\",\n        \"oneLineSummary\": \"Keep taskScopeIdentities as today and add a second stored per-task reuse identity used only for reuse equality.\",\n        \"approach\": \"Add taskReuseIdentities (v2 inputs) to the attempt header, the CR summary and history snapshots; requireReuseIdentity and the record.ts reuse check compare reuse identities when both sides have them and fall back to the old identities otherwise.\",\n        \"pros\": [\n          \"The full-row integrity identity is kept for every attempt.\"\n        ],\n        \"cons\": [\n          \"New stored field in three schemas (header, CR summary, history snapshot) and a fallback path in publication checks.\",\n          \"More code and data than a1 for the same reuse outcome.\"\n        ],\n        \"costEstimate\": \"M\",\n        \"reasonRejected\": \"Correct but adds stored data in three schemas (header, CR summary, history snapshot) and a publication fallback for the same reuse outcome.\"\n      }\n    ],\n    \"chosenAlternative\": \"a1\",\n    \"openQuestions\": []\n  },\n  \"citations\": [\n    {\n      \"id\": \"c1\",\n      \"kind\": \"code\",\n      \"ref\": \"src/workflow/code-review/task-review/attribution-binding.ts:23-145\",\n      \"quotedText\": \"s1 bundle 1: taskFinalInput and taskFinalIdentity, requireReuseIdentity, the bindTaskFinalIdentities deep-equality check and restoreAcceptedAssignments.\"\n    },\n    {\n      \"id\": \"c2\",\n      \"kind\": \"code\",\n      \"ref\": \"src/workflow/code-review/task-review/record.ts:76\",\n      \"quotedText\": \"s1 bundle 2: a published reuse row's identity must equal the source attempt's stored identity; the attempt header schema is strict; the attribution budget is three submissions.\"\n    },\n    {\n      \"id\": \"c3\",\n      \"kind\": \"code\",\n      \"ref\": \"src/workflow/code-review/task-review/__tests__/attribution-binding.test.ts\",\n      \"quotedText\": \"s1 bundle 3: tests pinning reuse identity and rejection text.\"\n    },\n    {\n      \"id\": \"c4\",\n      \"kind\": \"prior-artifact\",\n      \"ref\": \"docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/ISSUE.md\"\n    },\n    {\n      \"id\": \"c5\",\n      \"kind\": \"step-output\",\n      \"ref\": \"s3 judgments (winner a1)\"\n    }\n  ]\n}\n","document":"<!-- insrc:artifact LLD-7d2422c8f57fa483-s1 -->\n\n# LLD: STORY-7d2422c8f57fa483-s1 — Let code-review reuse survive provenance-only test-row changes\n\n## Summary\n\n**Epic:** `code-review-reuse-refused-when-only`\n**HLD base run:** `wf-1794407632473-fqkai5`\n**HLD effective hash:** `08ce4141d539...`\n\nA code-review correction attempt may reuse an earlier task result only when the task's inputs are unchanged, but today that check also covers free-text provenance in each test row, so rewording or re-running tests blocks reuse. This Story versions the task identity: new attempts use a format whose test entries carry only the committed test file, its cases and its result, and record that format on the attempt. Attempts saved before the change keep their original format and validate exactly as before, and reuse across the two formats is refused with the usual reassess feedback.\n\n## Contents\n\n1. [HLD context](#1-hld-context)\n2. [Contract details](#2-contract-details)\n3. [Data model changes](#3-data-model-changes)\n4. [Error paths](#4-error-paths)\n5. [Test strategy](#5-test-strategy)\n6. [Migration](#6-migration)\n7. [Alternatives considered](#7-alternatives-considered)\n8. [References](#8-references)\n\n## 1. HLD context\n\n**Framework:** Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\n**Rollout phase:** standalone\n\n## 2. Contract details\n\n**Surface level:** internal\n\n### 2.1 `taskFinalIdentity`\n\n```typescript\ntaskFinalIdentity(prepared: PreparedReviewPacket, assignment: TaskAssignment, format?: TaskIdentityFormat): string  // type TaskIdentityFormat = 'final-task-v1' | 'final-task-v2'\n```\n\n**Parameters:**\n- `format: TaskIdentityFormat` _(optional)_ — Which input the hash covers. 'final-task-v1' (default, today's input) hashes each assigned test as { detail: <whole submitted row>, blobOid }. 'final-task-v2' hashes each assigned test as { file, cases, result, blobOid }; requirements (taskId, title, summary, acceptanceChecks), changes and documents are hashed exactly as in v1.\n\n**Returns:** `string` — Hex sha256 of the canonical task input in the given format; the format name is part of the hashed input, so v1 and v2 identities never coincide.\n\n**Errors:**\n- `TaskReviewInputError field=attribution` when Existing checks: missing final task source identities, unknown assigned test, historical scope.\n\n**Preconditions:**\n- prepared has a projection and finalTestBlobs for every packet test (unchanged).\n\n**Postconditions:**\n- With format 'final-task-v1' the result is byte-identical to today's taskFinalIdentity.\n\n### 2.2 `bindTaskFinalIdentities`\n\n```typescript\nbindTaskFinalIdentities(review: AdmittedReview, input: readonly AcceptedTaskAttribution[]): Promise<readonly TaskAssignment[]>\n```\n\n**Returns:** `Promise<readonly TaskAssignment[]>` — Unchanged result. The identity format is the attempt header's taskIdentityFormat when present; otherwise 'final-task-v1' when the attempt is already accepted (saved before this change) and 'final-task-v2' when the mapping is being accepted now. A newly accepted mapping stores taskIdentityFormat: 'final-task-v2' alongside taskScopeIdentities in the same candidate; a re-bound accepted attempt must reproduce every stored key, including the format when present.\n\n**Errors:**\n- `TaskReviewInputError field=attribution` when Existing: 'Accepted mapping cannot change within an attempt' when a re-bound attempt does not reproduce its stored identities or format.\n\n**Postconditions:**\n- Saved accepted attempts without taskIdentityFormat re-bind with v1 identities exactly as today.\n\n### 2.3 `requireReuseIdentity`\n\n```typescript\nrequireReuseIdentity(review: AdmittedReview, assignment: TaskAssignment): void\n```\n\n**Returns:** `void` — Before comparing identities, requires the source attempt's identity format (its taskIdentityFormat, or 'final-task-v1' when absent) to equal the current attempt's. A differing format is refused at field origins/tasks/<index>/sourceAttempt/<n> with feedback naming the task and source attempt, saying its result was recorded under an earlier identity format, and asking to set action to reassess and omit sourceAttempt for this task. Otherwise the identity comparison and its existing feedback are unchanged, computed in the shared format.\n\n**Errors:**\n- `TaskReviewInputError field=origins/tasks/<index>/sourceAttempt/<n>` when Format differs, or identity differs (existing reassess feedback).\n\n**Postconditions:**\n- A published reuse row and its source always carry identities of the same format, so the publication check in src/workflow/code-review/task-review/record.ts:76 stays a like-for-like equality.\n\n### 2.4 `taskInputFingerprint`\n\n```typescript\ntaskInputFingerprint(prepared: PreparedReviewPacket, assignment: TaskAssignment): TaskInputFingerprint\n```\n\n**Returns:** `TaskInputFingerprint` — Transient diagnostic used by the reuse-rejection text. Its tests entries hash the v2 test fields ({ file, cases, result, blobOid }), so a rejection names only a test whose file, cases or result changed. Not persisted.\n\n**Postconditions:**\n- The rejection message format from ISSUE-146084d04395b88b is unchanged.\n\n## 3. Data model changes\n\n### 3.1 `ReviewAttempt.header (code-review checkpoint)` — field-add\n\nOptional taskIdentityFormat: 'final-task-v2', written when a mapping is accepted under this change; absent means 'final-task-v1'. Added to the header interface and to the strict header schema in src/workflow/code-review/task-review/contracts.ts. CR summaries, history snapshots and record schemas are unchanged: they copy and compare stored identities without recomputing them.\n\n**Call sites:**\n- `src/workflow/code-review/task-review/contracts.ts:112`\n- `src/workflow/code-review/task-review/contracts.ts:130`\n- `src/workflow/code-review/task-review/attribution-binding.ts:121-140`\n\n### 3.2 `taskFinalInput (task reuse identity input)` — invariant-change\n\nNew 'final-task-v2' input: each assigned test contributes { file, cases, result, blobOid } instead of the whole row. 'final-task-v1' is kept unchanged for saved attempts.\n\n**Call sites:**\n- `src/workflow/code-review/task-review/attribution-binding.ts:23-34`\n- `src/workflow/code-review/task-review/attribution-binding.ts:109-119`\n\n## 4. Error paths\n\n**Error cases**\n\n- **A correction attempt reuses a task whose source attempt was recorded under the earlier identity format.** (recoverable)\n  - Detection: requireReuseIdentity compares the source attempt's taskIdentityFormat (absent = 'final-task-v1') with the current attempt's before comparing identities.\n  - Response: TaskReviewInputError at origins/tasks/<index>/sourceAttempt/<n>: the task's result was recorded under an earlier identity format; set action to reassess and omit sourceAttempt for this task; retain eligible reuse for other tasks.\n  - User impact: The reviewer reassesses that task once; later attempts can reuse it under the new format.\n- **A reused task's committed test file, cases or result changed.** (recoverable)\n  - Detection: The v2 identity of the current task differs from the source attempt's stored v2 identity.\n  - Response: Existing reuse rejection (\"cannot reuse attempt N: relevant task inputs changed (tests <file>)\"), now naming only tests whose file, cases or result changed.\n  - User impact: Unchanged: that task is reassessed.\n- **A saved accepted attempt is re-bound and its stored identities or format no longer reproduce.** (terminal)\n  - Detection: bindTaskFinalIdentities' existing deep-equality of every candidate key against the saved header.\n  - Response: Existing 'Accepted mapping cannot change within an attempt' error.\n  - User impact: Unchanged fail-closed behaviour.\n- **A checkpoint header carries an unknown taskIdentityFormat value.** (terminal)\n  - Detection: The strict header schema accepts only 'final-task-v2' for the optional field.\n  - Response: Existing schema rejection of the checkpoint.\n  - User impact: The checkpoint is refused rather than silently mis-hashed.\n\n**Edge cases**\n\n| Input | Expected |\n| :--- | :--- |\n| Correction attempt on the same pin whose test rows differ only in evidenceReferences, executionDetails or command, source attempt in the new format. | Reuse is accepted; identities match. |\n| Saved attempt (no taskIdentityFormat) resumed or re-prepared after the change. | Re-binds with v1 identities and validates as today; no format is added. |\n| Attempt saved as pending before the change and accepted after it. | Accepted with v2 identities and taskIdentityFormat recorded. |\n| A task with no assigned tests. | v2 identity covers requirements, changes and documents only, as v1 does. |\n| Two tasks share one test row and one of them is reused. | Each task's identity covers its own assigned tests; unchanged shared rows keep both reusable. |\n| Test row cases reordered. | Treated as a change (cases are hashed as submitted), so reuse is refused; no reordering normalisation is added. |\n\n**Invariants to preserve**\n\n- Saved accepted attempts recompute exactly the identities they stored when re-bound (bindTaskFinalIdentities deep-equality). [[c1]]\n- A published reuse row's identity equals its source attempt's stored identity for that task (record.ts:76). [[c2]]\n- History snapshots and CR summaries copy stored identities without recomputing them. [[c2]]\n- The three-submission attribution budget and the reassess feedback of ISSUE-146084d04395b88b are unchanged. [[c2]]\n- Committed sources, documents, requirements and each test's committed file content remain part of the reuse identity. [[c1]]\n\n## 5. Test strategy\n\n**Test framework:** `node:test with node:assert/strict, run through npx tsx --test (Node 22), using the existing task-review publication fixture (src/workflow/code-review/task-review/__tests__/publication-fixture.ts) as in src/workflow/code-review/task-review/__tests__/attribution-binding.test.ts`\n\n**Test levels**\n\n- **unit** — Pin the two identity formats: v1 is byte-identical to the pre-change identity, v2 ignores provenance-only test-row fields and still reacts to the test file blob, cases and result.\n  - Subjects: `taskFinalIdentity`, `taskInputFingerprint`\n  - Fixtures: `prepared review from the publication fixture with one task and one test row`\n- **integration** — Exercise bindTaskFinalIdentities, restoreAcceptedAssignments and requireReuseIdentity across attempts on a real fixture checkpoint: a v2 source reused after provenance-only edits; a v2 source refused after a real test change; a v1 (unmarked) saved attempt re-binding unchanged and refused as a reuse source with format feedback; the CR record validation accepting the published reuse row.\n  - Subjects: `bindTaskFinalIdentities`, `requireReuseIdentity`, `restoreAcceptedAssignments`\n  - Fixtures: `publication fixture checkpoint with an accepted attempt 1 (v2) and a correction attempt 2 whose test rows differ only in evidenceReferences, executionDetails and command`, `same, with attempt 2 changing a test's cases`, `a saved accepted attempt without taskIdentityFormat whose stored identities were computed by the v1 formula`\n\n**Acceptance mapping**\n\n| Criterion | Proving tests |\n| :--- | :--- |\n| `ac1` | `src/workflow/code-review/task-review/__tests__/reuse-identity.test.ts: a correction attempt reuses a task when only provenance text in its test rows changed`, `src/workflow/code-review/task-review/__tests__/reuse-identity.test.ts: the v2 task identity ignores command, execution details and evidence references` |\n| `ac2` | `src/workflow/code-review/task-review/__tests__/reuse-identity.test.ts: the v2 task identity changes with the test file, cases or result`, `src/workflow/code-review/task-review/__tests__/reuse-identity.test.ts: reuse is still refused with reassess feedback when a test's cases changed` |\n| `ac3` | `src/workflow/code-review/task-review/__tests__/reuse-identity.test.ts: a saved attempt without an identity format re-binds with its stored v1 identities`, `src/workflow/code-review/task-review/__tests__/attribution-binding.test.ts: existing tests pass unchanged`, `src/workflow/code-review/task-review/__tests__/compatibility.test.ts: existing tests pass unchanged` |\n| `ac4` | `src/workflow/code-review/task-review/__tests__/reuse-identity.test.ts: reuse from an attempt recorded under the earlier identity format is refused with reassess feedback` |\n| `ac5` | `src/workflow/code-review/task-review/__tests__/reuse-identity.test.ts: a correction attempt reuses a task when only provenance text in its test rows changed` |\n\n## 6. Migration\n\n**State before:** The task reuse identity hashes the whole submitted test row (src/workflow/code-review/task-review/attribution-binding.ts:23-34, s1 bundle 1); saved attempts store those identities in taskScopeIdentities and are re-bound against them on restore, and publication checks reuse by identity equality (src/workflow/code-review/task-review/record.ts:76, s1 bundle 2).\n\n**State after:** New accepted mappings store 'final-task-v2' identities and taskIdentityFormat on the attempt header; unmarked saved attempts keep 'final-task-v1'; reuse requires matching formats and identities.\n\n**Zero downtime:** yes — **Data rewrite:** no\n\n**Steps**\n\n1. Add the optional taskIdentityFormat field ('final-task-v2') to the attempt header interface and strict schema. — ↩ rollbackable\n2. Add the v2 identity input and make bindTaskFinalIdentities, requireReuseIdentity and taskInputFingerprint format-aware; v1 stays the default for unmarked accepted attempts. — ↩ rollbackable\n3. Deploy by daemon update/restart. No stored data is rewritten; existing checkpoints and CR history read as before. — ✕ non-rollbackable _(needs: `Rolling back to code without the field makes checkpoints that already carry taskIdentityFormat unreadable by the older strict schema; roll back only with no such checkpoints, or keep a reader that accepts the field.`)_\n\n**Backward compat:** Internal daemon contract only (no IPC or plugin surface). Saved attempts and CR history written before the change keep validating unchanged; results from those attempts cannot be reused by attempts accepted after the change and are reassessed once. Older daemon builds cannot read checkpoints that carry the new optional field.\n\n## 7. Alternatives considered\n\n### 7.1 a1: Versioned task identity recorded on the attempt — **CHOSEN**\n\nNew attempts compute a 'final-task-v2' identity whose test entries carry only file, cases, result and the committed test blob, and record that format on the attempt header; saved attempts without the marker keep computing 'final-task-v1'.\n\ntaskFinalInput takes a format. 'final-task-v1' is today's input unchanged. 'final-task-v2' keeps requirements, changes and documents as today and replaces each test entry's detail with { file, cases, result } plus the committed test blobOid. bindTaskFinalIdentities computes identities in the attempt's format: the header's taskIdentityFormat when present, else 'final-task-v1' for an already accepted attempt, and 'final-task-v2' for a newly accepted mapping, which it records as taskIdentityFormat on the header. The strict attempt header schema gains the optional field. requireReuseIdentity refuses reuse when the source attempt's format differs from the current attempt's, with reassess feedback, before comparing identities; taskInputFingerprint uses the same v2 test fields so the rejection text names only real changes.\n\n### 7.2 a2: Infer the format by trial\n\nCompute both v1 and v2 identities when restoring and accept whichever matches the stored values; no stored marker.\n\nOn restore, accept the saved taskScopeIdentities when every one equals either the v1 or the v2 recomputation (all tasks in one format). New attempts store v2. Reuse compares the source's stored identity against the current task's identity in the format that matched for the source; cross-format reuse is refused.\n\n**Rejected because:** Avoids a schema field but leaves the format implicit; it must be rediscovered wherever reuse is checked, including record.ts publication checks (ac4 partial).\n\n### 7.3 a3: Separate reuse identity beside the integrity identity\n\nKeep taskScopeIdentities as today and add a second stored per-task reuse identity used only for reuse equality.\n\nAdd taskReuseIdentities (v2 inputs) to the attempt header, the CR summary and history snapshots; requireReuseIdentity and the record.ts reuse check compare reuse identities when both sides have them and fall back to the old identities otherwise.\n\n**Rejected because:** Correct but adds stored data in three schemas (header, CR summary, history snapshot) and a publication fallback for the same reuse outcome.\n\n## 8. References\n\n- **[[c1]]** `code` `src/workflow/code-review/task-review/attribution-binding.ts:23-145` — \"s1 bundle 1: taskFinalInput and taskFinalIdentity, requireReuseIdentity, the bindTaskFinalIdentities deep-equality check and restoreAcceptedAssignments.\"\n- **[[c2]]** `code` `src/workflow/code-review/task-review/record.ts:76` — \"s1 bundle 2: a published reuse row's identity must equal the source attempt's stored identity; the attempt header schema is strict; the attribution budget is three submissions.\"\n- **[[c3]]** `code` `src/workflow/code-review/task-review/__tests__/attribution-binding.test.ts` — \"s1 bundle 3: tests pinning reuse identity and rejection text.\"\n- **[[c4]]** `prior-artifact` `docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/ISSUE.md`\n- **[[c5]]** `step-output` `s3 judgments (winner a1)`\n"},"capturedAt":"2026-11-11T14:40:32.348Z"},"inventory":{"units":[{"id":"/body/summary","selector":"/body/summary","title":"summary","kind":"section"},{"id":"/body/hldContextSlice","selector":"/body/hldContextSlice","title":"hldContextSlice","kind":"section"},{"id":"/body/contractDetails","selector":"/body/contractDetails","title":"contractDetails","kind":"section"},{"id":"/body/dataModelChanges","selector":"/body/dataModelChanges","title":"dataModelChanges","kind":"section"},{"id":"/body/interactionWithShared","selector":"/body/interactionWithShared","title":"interactionWithShared","kind":"section"},{"id":"/body/errorPaths","selector":"/body/errorPaths","title":"errorPaths","kind":"section"},{"id":"/body/testStrategy","selector":"/body/testStrategy","title":"testStrategy","kind":"section"},{"id":"/body/migration","selector":"/body/migration","title":"migration","kind":"section"},{"id":"/body/alternativesConsidered","selector":"/body/alternativesConsidered","title":"alternativesConsidered","kind":"section"},{"id":"/body/chosenAlternative","selector":"/body/chosenAlternative","title":"chosenAlternative","kind":"section"},{"id":"/body/openQuestions","selector":"/body/openQuestions","title":"openQuestions","kind":"section"},{"id":"/body/alternativesConsidered/0","selector":"/body/alternativesConsidered/0","title":"a1","kind":"requirement"},{"id":"/body/alternativesConsidered/1","selector":"/body/alternativesConsidered/1","title":"a2","kind":"requirement"},{"id":"/body/alternativesConsidered/2","selector":"/body/alternativesConsidered/2","title":"a3","kind":"requirement"},{"id":"/citations/0","selector":"/citations/0","title":"Citation 1","kind":"citation"},{"id":"/citations/1","selector":"/citations/1","title":"Citation 2","kind":"citation"},{"id":"/citations/2","selector":"/citations/2","title":"Citation 3","kind":"citation"},{"id":"/citations/3","selector":"/citations/3","title":"Citation 4","kind":"citation"},{"id":"/citations/4","selector":"/citations/4","title":"Citation 5","kind":"citation"},{"id":"document:line:24","selector":"document:line:24","title":"1. HLD context","kind":"section"}]},"completedChunks":[{"chunkId":"scope-summary","status":"passed","summary":"The LLD's summary, HLD-context framing, interactionWithShared and openQuestions fields are all faithful to the originating ISSUE-7d2422c8f57fa483 and internally consistent. The summary correctly restates the root cause (whole-row provenance hashed blocks reuse) and the fix intent (new identity format carries only file/cases/result/blobOid per test, ignoring command/executionDetails/evidenceReferences), matching the ISSUE's reproduction and fix-intent sections verbatim in substance. \"Standalone feature — no parent HLD\" at document:line:24 is the correct framing for an issue-workflow LLD (meta.standalone=true, sizeClass=bugfix in the canonical artifact), and no HLD shared contracts are invented. interactionWithShared=[] is consistent with the ISSUE's constraint to avoid editing src/workflow/code-review/task-review/admission.ts: code inspection confirms admission.ts only calls restoreAcceptedAssignments and taskInputFingerprint generically (admission.ts:19,49-50), both of which the LLD's own plan makes format-aware internally without requiring any edit to admission.ts itself, so the \"no edit\" boundary from ISSUE-e4af63128c7cbec2 is honoured. openQuestions=[] is justified: the two candidate open issues a reviewer might expect — cases-reordering semantics and cross-format reuse — are both explicitly resolved in the LLD's edge-case table and error-path 4, not left open, and no other material ambiguity surfaces in this chunk's scope. Citations to contracts.ts:112/:130 and attribution-binding.ts:23-34/:109-119 were spot-checked against the live source and are accurate (the schema at contracts.ts:130 is additionalProperties:false, so the planned field-add is correctly identified as necessary there). The Story also stays scoped to identity-format versioning with no creep into unrelated reuse/attribution mechanics.","findings":[],"inspectedReferences":["/body/summary","/body/hldContextSlice","document:line:24","/body/interactionWithShared","/body/openQuestions","/Users/subhagho/work/projects/insors/insrc/docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/ISSUE.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-7d2422c8f57fa483-s1.json","src/workflow/code-review/task-review/attribution-binding.ts:1-150","src/workflow/code-review/task-review/record.ts:1-100","src/workflow/code-review/task-review/contracts.ts:95-140","src/workflow/code-review/task-review/admission.ts:1-100"],"limitations":[],"advice":["Optional polish: hldContextSlice.boundary.internal just repeats the Story title verbatim rather than adding distinct boundary information; harmless but not informative for a standalone Story with no HLD boundary to describe."]},{"chunkId":"contract-details","status":"changes_requested","summary":"The v1-unchanged claims (2.1, today's taskFinalInput/taskFinalIdentity shape) match the current code in attribution-binding.ts. The error contract and field-naming conventions (TaskReviewInputError, origins/tasks/&lt;index&gt;/sourceAttempt/&lt;n&gt;) are consistent with existing taxonomy. However, two contract gaps risk defeating the fix's own primary scenario: (1) the \"current attempt's format\" that requireReuseIdentity must compare against the source's format is specified inconsistently between 2.2 and 2.3 for the newly-accepted (pending→accepted) path, where the header field is not yet persisted at call time; (2) taskInputFingerprint is unconditionally v2-shaped even when the actual identity comparison for the attempt in question runs in v1 format, so its diagnostic text can silently fail to name a real v1-relevant change.","findings":[{"id":"f1-format-resolution-gap","severity":"MED","location":"docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md §2.2-2.3 (contract: bindTaskFinalIdentities / requireReuseIdentity)","message":"2.2 resolves an attempt's format as: header.taskIdentityFormat when present; else v1 if the attempt is already accepted (a saved pre-change attempt being re-bound); else v2 if the mapping is being newly accepted now. 2.3 instead states the current attempt's format flatly as 'its taskIdentityFormat, or final-task-v1 when absent' with no mention of the pending/newly-accepted branch. In the code's actual call order (src/workflow/code-review/task-review/attribution-binding.ts:121-138), bindTaskFinalIdentities calls requireReuseIdentity (line 136) for every reuse assignment BEFORE Object.assign(review.attempt.header, candidate) (line 138) persists the new taskIdentityFormat onto the header. So for exactly the ac1 scenario — a fresh correction attempt (pending→accepted) reusing a v2-marked source after a provenance-only edit — requireReuseIdentity, read literally per 2.3, would see review.attempt.header.taskIdentityFormat still absent and resolve the CURRENT attempt to 'final-task-v1' (per 2.3's flat rule) instead of 'final-task-v2' (the format 2.2 says this same bind IS using for its own candidate identities). That mismatch (current=v1 vs source=v2) would wrongly trigger the new format-mismatch refusal on the very reuse the fix exists to allow. Because requireReuseIdentity's signature in 2.1/2.3 takes no format parameter, it must independently re-derive the resolved format using 2.2's full (header-present / already-accepted / newly-accepted) rule, not the simpler 'field-or-v1' rule 2.3 states; the LLD does not say so explicitly, leaving this exact threading up to the implementer and risking a silent regression of the bug this Story exists to fix.","evidenceReferences":["docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md §2.2 'the identity format is the attempt header's taskIdentityFormat when present; otherwise final-task-v1 when the attempt is already accepted ... and final-task-v2 when the mapping is being accepted now'","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md §2.3 'requires the source attempt's identity format (its taskIdentityFormat, or final-task-v1 when absent) to equal the current attempt's'","src/workflow/code-review/task-review/attribution-binding.ts:121-140 (bindTaskFinalIdentities: candidate built before requireReuseIdentity call at line 136; Object.assign persisting header.taskIdentityFormat happens after, at line 138)","src/workflow/code-review/task-review/attribution-binding.ts:131-133 (the only two states that reach this point are attributionState 'accepted' (re-bind) or 'pending' (new accept), matching 2.2's two branches but not 2.3's single flat rule)"]},{"id":"f2-fingerprint-format-mismatch","severity":"MED","location":"docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md §2.4 (contract: taskInputFingerprint) and the reuseMismatch diagnostic it feeds","message":"2.4 fixes taskInputFingerprint to always hash the v2-shaped test fields ({file, cases, result, blobOid}), with no format parameter and no conditioning on which format the actual reuse comparison used. But the underlying mismatch (reuseMismatch in src/workflow/code-review/task-review/attribution-binding.ts:49-61, used by requireReuseIdentity) can legitimately fire while the attempt pair being compared is still in 'final-task-v1' (the restoreAcceptedAssignments re-bind path for a saved pre-change attempt whose own reuse decision points at an earlier v1 attempt). In that v1-format case a real provenance-field change (command/executionDetails/evidenceReferences) is exactly what v1 treats as a content change and correctly refuses reuse over, yet the always-v2 fingerprint compares only {file,cases,result,blobOid}, sees no difference in those fields, and falls back to the generic 'source, test, document or assignment identity/order changed' text instead of naming the actual changed test — contradicting the Story's and ISSUE-146084d04395b88b's goal of keeping the rejection text naming the real cause. The LLD's postcondition only promises the message *format* is unchanged, not that its content stays accurate for a v1-current comparison; this is a real, demonstrable diagnostic-accuracy gap for the legacy/re-bind path, not just a hypothetical.","evidenceReferences":["docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md §2.4 '...its tests entries hash the v2 test fields ({ file, cases, result, blobOid }), so a rejection names only a test whose file, cases or result changed... Not persisted' and postcondition 'The rejection message format from ISSUE-146084d04395b88b is unchanged'","src/workflow/code-review/task-review/attribution-binding.ts:49-61 (reuseMismatch; before/after fingerprints compared per-field, falls back to the generic message when no field in before/after differs)","src/workflow/code-review/task-review/attribution-binding.ts:141-145 (restoreAcceptedAssignments calls bindTaskFinalIdentities, which calls requireReuseIdentity, for an already-accepted/v1 attempt's stored reuse decisions)","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/ISSUE.md 'Fix intent' — 'this revises what the fingerprint covers, keeping its rejection feedback' (implying accuracy of the named cause is part of what must be kept)"]}],"inspectedReferences":["/body/contractDetails","/Users/subhagho/work/projects/insors/insrc/docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/ISSUE.md","src/workflow/code-review/task-review/attribution-binding.ts","src/workflow/code-review/task-review/record.ts:1-100","src/workflow/code-review/task-review/contracts.ts"],"limitations":[],"advice":["Consider making requireReuseIdentity's format resolution explicit by either (a) giving it the same resolution helper bindTaskFinalIdentities uses (keyed off attributionState, not just the header field), stated identically in both 2.2 and 2.3, or (b) threading the already-resolved format down as an explicit parameter from bindTaskFinalIdentities into requireReuseIdentity so there is one source of truth instead of two independently-worded rules.","Consider making taskInputFingerprint format-aware (or at least noting in 2.4 that its v2-only shape is a deliberate simplification that may under-report for a still-live v1 comparison), so reviewers/implementers know the generic fallback message is an accepted tradeoff rather than an oversight for the rare v1 re-bind mismatch path."]},{"chunkId":"data-model-migration","status":"passed","summary":"The data-model-changes and migration sections of LLD-7d2422c8f57fa483-s1 are accurate and internally consistent against the current code. The cited call sites (contracts.ts:112, contracts.ts:130, attribution-binding.ts:23-34, 109-119, 121-140) correctly identify the header interface, the strict header schema, taskFinalInput, requireReuseIdentity and bindTaskFinalIdentities respectively. The claim that CR summaries/history snapshots/record schemas stay unchanged holds: record.ts:76's publication equality check compares only the stored `identity` string, and because the format name ('final-task-v1'/'final-task-v2') is baked into the canonicalized hash input (attribution-binding.ts taskFinalInput's `format` field), identity equality already implies format equality for any practical purpose — no separate format field is needed in the summary/record schema for correctness. The backward-compat statement is consistent with the strict, `additionalProperties:false` header schema (contracts.ts:130): an older build's schema has no `taskIdentityFormat` property, so decoding a new checkpoint that carries it fails closed, matching \"older daemon builds cannot read checkpoints carrying the new optional field.\" The zero-downtime/no-data-rewrite claims hold for the described deploy model (a single-process restart, no concurrent old/new code against the same checkpoint); the edge-case table already covers the two states an in-progress attempt can be in at a restart boundary (unmarked-accepted re-binds as v1; pending-at-deploy accepts as v2), so no attempt can straddle the format boundary in a way the design leaves unhandled.","findings":[{"id":"rollback-prereq-unguarded","severity":"LOW","location":"docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:186 (Migration step 3)","message":"Migration step 3 states the non-rollback risk is acceptable only when 'no such checkpoints exist' that carry taskIdentityFormat, but the LLD names no operational check (script, assertion, or runbook step) that verifies this precondition before a rollback is performed; today nothing in the codebase enforces or reports it. This is disclosed honestly as a caveat rather than a hidden gap, so it does not block, but the migration section would be stronger with an explicit verification step (e.g., grep/scan checkpoints for the field, or a documented manual runbook check) rather than leaving the precondition unverifiable in practice.","evidenceReferences":["docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:186","src/workflow/code-review/task-review/coordinator.ts (no rollback/preflight checkpoint-scan utility found)"]}],"inspectedReferences":["/body/dataModelChanges","/body/migration","/Users/subhagho/work/projects/insors/insrc/docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md","src/workflow/code-review/task-review/contracts.ts:106-148 (ReviewAttempt interface + CheckpointSchema, strict additionalProperties:false)","src/workflow/code-review/task-review/attribution-binding.ts:1-146 (taskFinalInput, taskFinalIdentity, taskInputFingerprint, requireReuseIdentity, bindTaskFinalIdentities, restoreAcceptedAssignments)","src/workflow/code-review/task-review/record.ts:1-101 (validateTaskBody reuse-source identity check at line 76)","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/ISSUE.md"],"limitations":[],"advice":["Consider adding one line to migration step 3 naming how an operator would check 'no such checkpoints carry taskIdentityFormat' before relying on that rollback prerequisite (e.g., a one-off grep across .insrc checkpoint storage, or noting that in practice the field only appears after the first newly-accepted mapping, so a time-boxed rollback window is safe)."]},{"chunkId":"error-paths","status":"changes_requested","summary":"The error-paths section covers the stated edge cases plausibly, and most assigned concerns resolve cleanly against the code (per-task test scoping has no cross-task coupling; invariants c1/c2 map to real enforcement points in attribution-binding.ts and record.ts; mixed-format submissions are handled per-task without cross-contamination). However, tracing the \"format differs\" error case against the actual control flow in bindTaskFinalIdentities/attribution-repair.ts shows the claimed \"one-time reassessment\" cost does not hold when a correction attempt needs to reassess more than one task carried over from a pre-fix (v1) source attempt in the same submission — this reproduces the exact budget-exhaustion failure mode the ISSUE reports, for the transition window this design itself introduces. A secondary citation-accuracy issue (the three-submission budget invariant cites record.ts:76, which does not contain that constant) is also flagged.","findings":[{"id":"f1-format-mismatch-recurs-per-task","severity":"HIGH","location":"docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md#4-error-paths (error case 1: \"A correction attempt reuses a task whose source attempt was recorded under the earlier identity format\")","message":"The error-paths section claims this case is a one-time cost (\"The reviewer reassesses that task once; later attempts can reuse it under the new format\"), but tracing the actual control flow shows it reproduces the ISSUE's budget-exhaustion failure mode whenever more than one task must be reassessed in the same correction attempt because its source carries the old (v1/absent) format. bindTaskFinalIdentities (attribution-binding.ts:136) calls requireReuseIdentity in a plain for-loop and requireReuseIdentity throws synchronously (TaskReviewInputError) on the FIRST mismatched task, aborting the whole candidate build before later tasks in the same loop are even checked — exactly the 'It throws at the first such task' mechanism the ISSUE's own root-cause section names as the cause of budget exhaustion. recordAttributionRejection (attribution-repair.ts:7-16) counts each such thrown error as one of only MAX_ATTRIBUTION_SUBMISSIONS=3 rejections, regardless of how many tasks are affected or how large the batch is. Concretely: a correction attempt submitted after this fix ships, trying to reuse t1/t2/t4 from a pre-fix (v1) attempt 1 (exactly the scenario in the ISSUE's own reproduction, projection-scope-66d4-s1), will fail on t1 alone in submission 1 (consuming 1/3), on t2 alone in submission 2 (consuming 2/3), and on t4 alone in submission 3 (consuming 3/3) — exhausting the budget with no task assessed, the identical symptom the ISSUE reports, just triggered by format instead of provenance text. The LLD's fix intent and migration section ('reassessed once') do not acknowledge or resolve this multi-task-per-submission recurrence for the transition window this design itself creates.","evidenceReferences":["docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:115-118","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:188 (Backward compat: \"results from those attempts cannot be reused by attempts accepted after the change and are reassessed once\")","src/workflow/code-review/task-review/attribution-binding.ts:136","src/workflow/code-review/task-review/attribution-repair.ts:6-16","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/ISSUE.md:9 (reproduction: \"t1, t2 and t4 ... unreusable, and attempts 2 and 3 both failed in attribution\")","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/ISSUE.md:14 (root cause: \"It throws at the first such task, and the attribution repair budget is three submissions\")"]},{"id":"f2-budget-citation-wrong-location","severity":"LOW","location":"docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md#4-error-paths (Invariants to preserve: \"The three-submission attribution budget and the reassess feedback of ISSUE-146084d04395b88b are unchanged. [[c2]]\")","message":"The invariant naming the three-submission attribution budget cites [[c2]], whose own entry in References (section 8) points only to src/workflow/code-review/task-review/record.ts:76. The MAX_ATTRIBUTION_SUBMISSIONS=3 constant this invariant is actually about lives in src/workflow/code-review/task-review/attribution-repair.ts:6 (cited as [[c3]] in the ISSUE, not referenced at all from this invariant). This is a citation-accuracy gap: a reader following [[c2]] to verify the budget claim lands on unrelated code (the publication reuse-identity-equality check), not the budget constant.","evidenceReferences":["docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:148","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:217","src/workflow/code-review/task-review/attribution-repair.ts:6","src/workflow/code-review/task-review/record.ts:76"]}],"inspectedReferences":["/body/errorPaths","/Users/subhagho/work/projects/insors/insrc/docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/ISSUE.md","src/workflow/code-review/task-review/attribution-binding.ts","src/workflow/code-review/task-review/record.ts","src/workflow/code-review/task-review/attribution-repair.ts"],"limitations":[],"advice":["The 'cases reordered is treated as a change' edge case is a defensible, explicitly-flagged scope decision (cases are part of what the ISSUE's fix intent says must still invalidate reuse), but it is not something the ISSUE itself asked for and could surprise a reviewer whose tooling reorders test cases non-semantically between submissions. Consider calling this out explicitly as a known limitation in the Story's user-facing notes, not just the edge-case table, since it is a new source of (correct, but maybe unexpected) reuse refusal.","To actually resolve concern f1 without expanding scope into admission.ts (off-limits per ISSUE-e4af63128c7cbec2), consider having requireReuseIdentity/bindTaskFinalIdentities collect ALL per-task mismatches (format or identity) before throwing, so a single submission's error names every affected task at once (not just the first) — this would let a reviewer fix a whole v1-sourced batch in one correction round instead of one task per round, closing the transition-window gap without touching the admission/budget machinery itself.","Two tasks sharing one test row is correctly isolated per-task today since taskFinalInput only hashes assignment.tests (each task's own assignment), confirmed by reading attribution-binding.ts:29; worth a short explicit test asserting this non-coupling given it is called out as its own edge case."]},{"chunkId":"test-strategy","status":"changes_requested","summary":"The test strategy's unit/integration levels are well-targeted at the two identity formats and the main reassess/reuse paths, but the acceptance mapping and declared edge cases have real gaps: ac5 has no proving test distinct from ac1 (identical test name reused verbatim), two declared edge cases (test-row cases reordered; task with no assigned tests) have no named proving test anywhere in the strategy, and the explicit postcondition that a v2 reuse row's publication equality at record.ts:76 stays like-for-like is not exercised by any named test. These are demonstrable deficiencies in the written test strategy against the LLD's own error-paths/edge-cases and postconditions, not merely optional improvements.","findings":[{"id":"ts-ac5-redundant","severity":"HIGH","location":"docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md#5-test-strategy (Acceptance mapping, ac5 row)","message":"ac5's single proving test is the exact same test name already listed as ac1's first proving test ('a correction attempt reuses a task when only provenance text in its test rows changed'). No test in the strategy is unique to ac5. If ac5 is a distinct acceptance criterion from ac1 (the mapping table treats them as separate rows), the strategy currently provides zero differentiated proof for it; if ac5 is actually identical to ac1, the acceptance list itself is redundant and the LLD does not say so. Either way the mapping as written does not demonstrate ac5 is met by anything beyond ac1's own test.","evidenceReferences":["docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:168","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:172",".insrc/artifacts/LLD-7d2422c8f57fa483-s1.json:287","​.insrc/artifacts/LLD-7d2422c8f57fa483-s1.json:315"]},{"id":"ts-edgecases-untested","severity":"MED","location":"docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md#4-error-paths (Edge cases table) vs #5-test-strategy","message":"Two edge cases the LLD itself declares as behavior to preserve — 'Test row cases reordered' (treated as a change, reuse refused) and 'A task with no assigned tests' (v2 identity covers requirements/changes/documents only) — have no named proving test anywhere in the test strategy's levels, fixtures or acceptance mapping. Both are stated outcomes the implementation must exhibit, but nothing in section 5 is assigned to verify either.","evidenceReferences":["docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:139","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:141","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:151-172"]},{"id":"ts-record76-reuse-row-untested","severity":"MED","location":"docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md#2.3-requireReuseIdentity (Postconditions) vs #5-test-strategy","message":"Section 2.3's postcondition states 'A published reuse row and its source always carry identities of the same format, so the publication check in src/workflow/code-review/task-review/record.ts:76 stays a like-for-like equality.' The integration test level's prose mentions 'the CR record validation accepting the published reuse row' but record.ts/record.test.ts is not listed as a subject, and no acceptance-mapping row or named test exercises a v2-format reuse row through the record.ts:76 publication-equality check. The existing compatibility.test.ts suite (checked) covers origin-absent/legacy publication paths, not a v2 reused-identity row, so this explicit postcondition is currently unverified by the written strategy.","evidenceReferences":["docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:79","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:160-162","src/workflow/code-review/task-review/__tests__/compatibility.test.ts:61-66"]},{"id":"ts-no-scale-repro","severity":"LOW","location":"docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md#5-test-strategy (integration level)","message":"The integration level does not include a fixture that reproduces the ISSUE's reported scale directly (3 tasks losing reuse eligibility across 2 failed correction attempts exhausting the 3-submission attribution budget). Coverage is per-task/per-identity rather than an end-to-end regression of the originally observed multi-task failure mode; since the fix is categorical (per-task identity comparison), this is not required for correctness, but a scale-matching regression test would more directly guard against recurrence of the reported incident.","evidenceReferences":["docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/ISSUE.md:9","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:159-162"]}],"inspectedReferences":["/body/testStrategy","/Users/subhagho/work/projects/insors/insrc/docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/ISSUE.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-7d2422c8f57fa483-s1.json","/Users/subhagho/work/projects/insors/insrc/src/workflow/code-review/task-review/__tests__/compatibility.test.ts"],"limitations":[],"advice":["Consider either removing ac5 as a separately listed criterion (folding it into ac1) or adding a test that proves something ac1's test does not, so the mapping table's rows are each backed by distinct evidence.","Add one named unit test each for the 'cases reordered' and 'no assigned tests' edge cases so the strategy's own declared behaviors are checked, not just asserted in prose.","Add a record.ts-focused test (or extend an existing one) that publishes a reuse row computed under 'final-task-v2' and asserts the publication equality check at record.ts:76 accepts it, directly covering the 2.3 postcondition.","Optional: add one integration fixture closer to the ISSUE's reported scale (multiple provenance-only-changed tasks in one correction attempt) as a direct regression guard, though it is not required given the categorical per-task fix."]},{"chunkId":"alternatives-citations","status":"changes_requested","summary":"Citations c1 and c3 ground accurately against current source. The chosen alternative (a1) is coherent and its contrast with a3 (three schemas vs. one) is proportionate and accurate. Two issues found: (1) a2's rejection rationale claims record.ts:76's publication check needs to \"rediscover\" the identity format, but the actual code at that line (and the LLD's own 2.3 postcondition) shows it performs pure stored-identity equality with no format awareness required under either a1 or a2 — the stated con does not hold for that specific location. (2) The LLD omits any discussion of a \"narrow/reduce scope\" alternative (e.g. simply dropping provenance fields from v1 without versioning), leaving that path's rejection or non-consideration unexplained. Citation c2 (record.ts:76) bundles three distinct facts under one line pointer, only one of which (identity equality) is actually present at that line.","findings":[{"id":"a2-con-inaccurate","severity":"MED","location":"docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md §7.2 (a2 rejection) and §2.3 postcondition","message":"a2's rejection states the implicit format 'must be rediscovered wherever reuse is checked, including record.ts publication checks (ac4 partial).' But record.ts:76 (`source.taskScopeIdentities?.find(...).identity===row.identity`) only compares two already-computed stored identity strings for equality — it never recomputes or needs to know which format produced them, in either a1 or a2. The LLD's own §2.3 postcondition for the CHOSEN alternative confirms this: 'the publication check in record.ts:76 stays a like-for-like equality' precisely because format-matching is enforced upstream (in requireReuseIdentity), not because record.ts itself discovers a format. Since a1 and a2 would both leave record.ts equally format-oblivious, this specific claimed drawback of a2 is not accurate as stated and should either be removed or re-grounded in the real risk of a2 (fragile trial-based format inference at restore when v1/v2 outputs could coincide, or the 'all tasks in one format' constraint being awkward to enforce) rather than attributed to record.ts.","evidenceReferences":["src/workflow/code-review/task-review/record.ts:76","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:73-79 (§2.3 requireReuseIdentity contract + postcondition)","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:204 (a2 rejection text)"]},{"id":"missing-reduce-scope-alternative","severity":"LOW","location":"docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md §7 (Alternatives considered)","message":"The alternatives list covers two ways to version/split the identity (a2, a3) but never addresses the simpler option of narrowing the v1 identity itself (dropping provenance-only test-row fields from the single, unversioned format) without introducing a format marker at all. That path's obvious con — it would retroactively change what every saved identity means, breaking re-binding of attempts saved before the change (violating ac3) — is implicit in the Migration section's backward-compat requirement but is never named as a considered-and-rejected alternative. Naming it briefly would make the alternatives survey complete.","evidenceReferences":["docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:190-212 (§7 Alternatives considered)","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:188 (Backward compat: saved attempts validate unchanged)"]},{"id":"c2-citation-bundling-imprecise","severity":"LOW","location":"docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:217 ([[c2]] reference)","message":"[[c2]] cites a single line, record.ts:76, for three distinct facts: '(a) a published reuse row's identity must equal the source attempt's stored identity, (b) the attempt header schema is strict, (c) the attribution budget is three submissions.' Only fact (a) is actually present at record.ts:76; the strict-schema fact lives in contracts.ts's Type.Object(...,{additionalProperties:false}) schemas, and the three-submission budget is MAX_ATTRIBUTION_SUBMISSIONS in attribution-repair.ts:6 (as the originating ISSUE's own c3 citation correctly locates it). Bundling unrelated facts under one line pointer makes the citation harder to verify at a glance; citing each fact at its own location (as the ISSUE did) would be more precise.","evidenceReferences":["src/workflow/code-review/task-review/record.ts:76","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/ISSUE.md:28 ([[c3]] attribution-repair.ts:6)","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:217"]}],"inspectedReferences":["/body/alternativesConsidered","/body/chosenAlternative","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/alternativesConsidered/2","/citations/0","/citations/1","/citations/2","/citations/3","/citations/4","/Users/subhagho/work/projects/insors/insrc/docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/ISSUE.md","src/workflow/code-review/task-review/attribution-binding.ts","src/workflow/code-review/task-review/record.ts:60-81","src/workflow/code-review/task-review/contracts.ts (schema definitions, lines 1-158)","src/workflow/code-review/task-review/__tests__/attribution-binding.test.ts (lines 58-135)"],"limitations":[],"advice":["Consider rewriting a2's rejection to cite the real risk (trial-based format inference at restore time could be ambiguous or fragile, especially under the 'all tasks must agree on one format' constraint) rather than a record.ts dependency that does not exist under either alternative.","Consider citing the strict-schema and three-submission-budget facts at their own locations (contracts.ts schema definitions; attribution-repair.ts:6) instead of bundling them into the record.ts:76 citation."]},{"chunkId":"final-consistency","status":"changes_requested","summary":"Aggregating all six substantive chunks: scope-summary and data-model-migration passed (one LOW each); contract-details, error-paths, test-strategy and alternatives-citations all returned changes_requested, with two HIGH findings (budget-exhaustion recurrence in the transition window; a redundant ac5 proving test) and four MED findings (format-resolution ambiguity in 2.2/2.3; an always-v2 fingerprint that can misreport for a live v1 comparison; two untested declared edge cases / an unverified publication postcondition; an inaccurate a2-rejection rationale). The fix's core mechanism (versioned per-task identity, format recorded on the attempt header) is coherent and does not reintroduce editing of admission.ts, and the three-submission budget / ISSUE-146084d04395b88b rejection-feedback format are referenced consistently (not altered) across contractDetails, errorPaths and testStrategy — no direct textual contradiction exists between those sections. However, cross-checking the error-paths HIGH finding against the Migration section surfaces one additional, document-wide consistency gap: the same inaccurate \"reassessed once\" cost claim that error-paths flags as HIGH (because requireReuseIdentity throws synchronously on the first task reassessed per submission, so more than one v1-sourced task in one correction attempt reproduces the ISSUE's own budget-exhaustion failure mode) is restated verbatim and unreconciled in §6 Migration's \"Backward compat\" line — the document is internally consistent in repeating the claim, but consistently wrong about it in both places it appears, which is worse than an isolated local error because a reader who checks only §6 would not learn of the gap flagged in §4. No other cross-section contradiction was found (data-model/migration backward-compat claims are consistent with the schema-strictness claims; no section reintroduces admission.ts edits; scope/summary framing matches the ISSUE verbatim).","findings":[{"id":"fc1-migration-repeats-unreconciled-reassess-once-claim","severity":"MED","location":"docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md#6-migration (Backward compat line) cross-checked against #4-error-paths (error case 1)","message":"The error-paths chunk's HIGH finding (f1-format-mismatch-recurs-per-task) demonstrates that, because bindTaskFinalIdentities calls requireReuseIdentity in a plain loop that throws synchronously on the FIRST task whose source attempt carries the earlier identity format (attribution-binding.ts:136), a correction attempt that needs to reassess MORE THAN ONE v1-sourced task in the same submission will exhaust the three-submission attribution budget one task at a time — reproducing the exact budget-exhaustion failure mode the originating ISSUE reports (t1/t2/t4 across attempts 2 and 3), just triggered by the v1→v2 transition instead of provenance wording. This is not confined to §4: the Migration section's own 'Backward compat' line makes the identical, equally unqualified claim — 'results from those attempts cannot be reused by attempts accepted after the change and are reassessed once' — with no cross-reference to the multi-task caveat and no acknowledgment that for a batch of several pre-fix-format tasks the reassessment cost is NOT a flat one-time cost per task but a budget-consuming serial failure identical in shape to the bug this Story exists to close. Because this claim recurs, uncorrected, in two independent sections (§4 and §6) rather than being isolated to one, a reader who only checks the migration/rollout framing (as an operator doing the deploy would) has no way to learn of the transition-window risk that the error-paths chunk already identified as HIGH.","evidenceReferences":["docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:188 ('results from those attempts cannot be reused by attempts accepted after the change and are reassessed once')","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:117-118 (same claim in §4 error case 1: 'The reviewer reassesses that task once; later attempts can reuse it under the new format')","src/workflow/code-review/task-review/attribution-binding.ts:136 (requireReuseIdentity invoked per task inside bindTaskFinalIdentities' loop, throws synchronously on first mismatch)","src/workflow/code-review/task-review/attribution-repair.ts:6-16 (MAX_ATTRIBUTION_SUBMISSIONS=3; each thrown TaskReviewInputError consumes one submission regardless of how many tasks remain unassessed)","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/ISSUE.md:9 (original reproduction: t1, t2, t4 unreusable; attempts 2 and 3 both failed in attribution)","checkpoint /Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/lld-7d2422c8f57fa483-s1.json, completedChunks[error-paths].findings[0] (f1-format-mismatch-recurs-per-task, HIGH)"]}],"inspectedReferences":["/Users/subhagho/work/projects/insors/insrc/docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/lld-7d2422c8f57fa483-s1.json","/Users/subhagho/work/projects/insors/insrc/docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/ISSUE.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-7d2422c8f57fa483-s1.json","completedChunks[scope-summary]","completedChunks[contract-details]","completedChunks[data-model-migration]","completedChunks[error-paths]","completedChunks[test-strategy]","completedChunks[alternatives-citations]","src/workflow/code-review/task-review/attribution-binding.ts:109-146","src/workflow/code-review/task-review/attribution-repair.ts:6-16","src/workflow/code-review/task-review/record.ts:60-81","src/workflow/code-review/task-review/contracts.ts:106-148"],"limitations":[],"advice":["Before approval, the two outstanding HIGH findings from substantive chunks should be resolved first since they gate correctness/coverage: error-paths' f1-format-mismatch-recurs-per-task (the fix's transition window can reproduce the exact budget-exhaustion bug this Story closes, for a batch of >1 v1-sourced tasks in one correction attempt) and test-strategy's ts-ac5-redundant (ac5 has no proving test distinct from ac1, so it is currently unverified as written).","The four MED findings (contract-details' f1-format-resolution-gap and f2-fingerprint-format-mismatch; test-strategy's ts-edgecases-untested and ts-record76-reuse-row-untested; alternatives-citations' a2-con-inaccurate) are all independently actionable and do not conflict with each other or with this chunk's own finding; addressing f1-format-resolution-gap (make requireReuseIdentity's format resolution explicit/shared with bindTaskFinalIdentities) would likely also materially reduce the risk surfaced by fc1 here, since a clearer, centrally-resolved format would make it easier to batch-detect and report all mismatched tasks in one submission instead of throwing on the first.","Low-severity items (rollback-prereq-unguarded, f2-budget-citation-wrong-location, ts-no-scale-repro, missing-reduce-scope-alternative, c2-citation-bundling-imprecise) are polish-level and can be deferred to a follow-up revision without blocking this round."]}],"progress":{"status":"changes_requested","phase":"complete","completedChunks":7,"totalChunks":7,"lastMeaningfulActivityAt":null,"activeToolCount":0,"requiresUserInput":false,"checkpointPath":"/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/lld-7d2422c8f57fa483-s1.json","sequence":0,"reviewElapsedMs":0,"unitElapsedMs":null,"observedAt":"2026-11-11T14:55:31.260Z","freshness":"stored"},"startedAt":"2026-11-11T14:40:32.356Z","reviewer":"daemon","model":"claude-sonnet-5","unit":{"unitId":"final-consistency","phase":"chunk_review","executionId":"ae2e1c5a-475a-411b-92fa-3edac83a9acd","dispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[]},"plan":{"chunks":[{"id":"scope-summary","title":"Scope, summary and HLD-context fit against the originating ISSUE","selectors":["/body/summary","/body/hldContextSlice","document:line:24","/body/interactionWithShared","/body/openQuestions"],"concerns":["Does the summary faithfully restate the ISSUE's root cause (whole-row provenance hashed) and fix intent (ignore provenance-only fields, keep file/cases/result/blobOid)?","Is 'Standalone feature — no parent HLD' correct for an issue-workflow LLD (no DEF/HLD required per the review scope)?","Does interactionWithShared being empty match the constraint that this fix must not touch src/workflow/code-review/task-review/admission.ts (ISSUE-e4af63128c7cbec2 boundary)?","Are there any open questions that should have been raised but weren't (e.g., the cases-reordering edge case, cross-format reuse semantics)?","Does the Story scope stay within what the ISSUE asked for, without scope creep into unrelated reuse/attribution mechanics?"],"dependsOn":[],"purpose":"substantive"},{"id":"contract-details","title":"API contract: taskFinalIdentity, bindTaskFinalIdentities, requireReuseIdentity, taskInputFingerprint","selectors":["/body/contractDetails"],"concerns":["Verify against src/workflow/code-review/task-review/attribution-binding.ts that the current (v1) taskFinalIdentity/taskFinalInput shape and bindTaskFinalIdentities/requireReuseIdentity logic match what the LLD describes as 'today's' behavior, so the v1-unchanged claim is accurate.","Is the format-selection rule for bindTaskFinalIdentities unambiguous: header.taskIdentityFormat when present; else v1 for an already-accepted attempt; v2 for a newly-accepted mapping? Any gap for an attempt that is neither 'already accepted' nor 'being accepted now' (e.g., a rejected/pending-non-accepted candidate)?","requireReuseIdentity's format-mismatch error path: does comparing the *source* attempt's format against the *current* attempt's format (rather than against the task being reassessed) correctly handle every attempt-pairing, including multiple source attempts in one correction?","taskInputFingerprint says it 'Not persisted' and reuses v2 fields unconditionally — does this diagnostic apply correctly even when the *current* attempt is itself using v1 (e.g., an old saved attempt being re-examined), or could it mismatch the format actually used for comparison?","Is the error contract (TaskReviewInputError field=...) consistent with the existing error taxonomy in the codebase (check error class and field strings against src/workflow/code-review/task-review/attribution-binding.ts and related contracts.ts)?","Are preconditions/postconditions sufficient to pin the v1-byte-identical guarantee (postcondition in 2.1) against actual current code, not just asserted in prose?"],"dependsOn":["scope-summary"],"purpose":"substantive"},{"id":"data-model-migration","title":"Data model changes (taskIdentityFormat field-add, taskFinalInput invariant-change) and migration/rollback plan","selectors":["/body/dataModelChanges","/body/migration"],"concerns":["Confirm the call-site line ranges cited (contracts.ts:112, contracts.ts:130, attribution-binding.ts:121-140, attribution-binding.ts:23-34, attribution-binding.ts:109-119) actually correspond to the header schema, header interface and binding logic described — stale or wrong line numbers would misdirect the builder.","Does 'CR summaries, history snapshots and record schemas are unchanged' hold given record.ts:76's publication equality check — would a v2-identity reuse row ever need the CR summary/history schema to carry the format too, to avoid ambiguity later (even if not required by this fix)?","Is the backward-compat statement (older daemon builds cannot read checkpoints carrying the new optional field) consistent with the strict header schema's closed/additionalProperties behavior — verify against contracts.ts's actual schema strictness.","Migration step 3 is marked non-rollbackable with a stated prerequisite; is that prerequisite actually operationally checkable (i.e., does anything enforce 'no such checkpoints exist' before rollback), or is this just a documented risk with no guard?","Zero-downtime / no-data-rewrite claims — do they hold given that in-flight attempts (pending, not yet accepted) at deploy time could straddle the format boundary?"],"dependsOn":["contract-details"],"purpose":"substantive"},{"id":"error-paths","title":"Error cases, edge cases and invariants vs. the ISSUE's reproduction and prior ISSUE-146084d04395b88b constraints","selectors":["/body/errorPaths"],"concerns":["Does the 'format differs' error case fully resolve the ISSUE's reproduction (removing one evidence reference made t1/t2/t4 unreusable and exhausted the 3-submission budget) — i.e., for an attempt-1 source already saved as v1 before this change, is the one-time reassessment actually a one-time cost or could it recur across further correction attempts, re-triggering the same budget-exhaustion failure mode the ISSUE reports?","The 'cases reordered is treated as a change' edge case — is this a deliberate, justified scope decision (not asked for by the ISSUE, which only mentions provenance fields) or does it risk NOT satisfying the ISSUE's expected behavior if a reviewer's tool reorders cases non-semantically?","Is 'Two tasks share one test row and one of them is reused' edge case consistent with how taskFinalInput is actually computed per-task in attribution-binding.ts (hashing only the task's own assigned tests) — confirm no hidden global-identity coupling across tasks.","Do the stated invariants (c1/c2) fully cover ISSUE-146084d04395b88b's constraints — the three-submission budget and 'fail-closed acceptance' — with concrete enforcement points, not just assertion?","Is there an error case for a mixed-format correction attempt where multiple source attempts (some v1, some v2) are referenced by different tasks in the same submission — does any task's acceptance affect another's format binding incorrectly?"],"dependsOn":["contract-details"],"purpose":"substantive"},{"id":"test-strategy","title":"Test strategy, fixtures and acceptance-criteria mapping","selectors":["/body/testStrategy"],"concerns":["Does every acceptance criterion (ac1-ac5) have a genuinely distinct proving test, or is ac5 fully redundant with ac1's first test (same test name listed for both) — if redundant, is ac5 actually tested by anything unique?","Is there a test for the mixed-format / per-attempt budget-exhaustion scenario directly reproducing the ISSUE's repro steps (3 tasks losing reuse eligibility, 2 correction attempts both failing in attribution)? The integration level mentions a v1 saved attempt 'refusing as reuse source with format feedback' but not an end-to-end repro of the original bug at the scale reported.","Are the 'cases reordered' and 'task with no assigned tests' edge cases (listed in errorPaths) actually covered by any named test, or do they lack proving tests entirely?","Does the integration-level fixture plan adequately exercise restoreAcceptedAssignments for the v1 (unmarked) saved-attempt re-bind path without regressing existing attribution-binding.test.ts/compatibility.test.ts coverage (ac3)?","Is the CR record.ts:76 publication-equality path (for a v2 reuse row) actually exercised by a named test, given it's called out as an explicit postcondition in 2.3?"],"dependsOn":["contract-details","error-paths"],"purpose":"substantive"},{"id":"alternatives-citations","title":"Alternatives considered, chosen alternative rationale, and citation accuracy","selectors":["/body/alternativesConsidered","/body/chosenAlternative","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/alternativesConsidered/2","/citations/0","/citations/1","/citations/2","/citations/3","/citations/4"],"concerns":["Is the rejection rationale for a2 (format implicit, must be rediscovered in record.ts) accurate — does record.ts's publication check at line 76 actually need to know the format to do a like-for-like comparison, or would stored-identity equality alone suffice without format-awareness (i.e., is the stated con real)?","Is a3's rejection (three schemas touched) proportionate given a1 itself also touches the header schema plus two call sites — confirm the cost delta claimed between a1 and a3 is accurate.","Do the cited line ranges (c1: attribution-binding.ts:23-145, c2: record.ts:76) actually contain the described content when checked against the current file — citations in LLDs must ground claims, not just approximate them.","Is omitting a 'do nothing / reduce scope of reuse comparison' alternative (e.g., simply excluding provenance fields from v1 without versioning) justified — the LLD doesn't explain why an unversioned field-narrowing (breaking all old stored identities) was not considered or was implicitly rejected."],"dependsOn":["scope-summary"],"purpose":"substantive"},{"id":"final-consistency","title":"Whole-LLD consistency and alignment with the originating ISSUE","selectors":[],"concerns":["Cross-check that every fix-intent element of ISSUE-7d2422c8f57fa483 (provenance-only changes no longer block reuse; real file/cases/result changes still force reassessment; saved attempts stay readable/valid; admission.ts untouched) is addressed consistently across contract details, data model, error paths and tests with no contradictions.","Confirm no section reintroduces editing of src/workflow/code-review/task-review/admission.ts (the explicit constraint from ISSUE-e4af63128c7cbec2).","Confirm the three-submission attribution budget and ISSUE-146084d04395b88b's rejection-feedback format are referenced consistently (not altered) across contractDetails, errorPaths and testStrategy.","Check for any internal contradiction between the migration section's backward-compat claims and the data-model section's schema strictness claims.","Aggregate findings from substantive chunks into an overall verdict."],"dependsOn":["scope-summary","contract-details","data-model-migration","error-paths","test-strategy","alternatives-citations"],"purpose":"consistency"}],"coverageExplanation":"Every inventory unit from the checkpoint (\"/body/summary\" through \"document:line:24\", including the three alternativesConsidered array elements and five citations) is assigned to exactly one substantive chunk based on which part of the document it documents: scope/summary/HLD-context/interaction/open-questions go to scope-summary; the API surface goes to contract-details; schema/migration go to data-model-migration; error/edge cases/invariants go to error-paths; test strategy/acceptance mapping go to test-strategy; and alternatives plus all citations (which substantiate the alternatives/claims) go to alternatives-citations. The final-consistency chunk has empty selectors and depends on all six substantive chunks to check cross-cutting alignment with the originating ISSUE as a whole-artifact pass, per the required dependency ordering (consistency chunk last, depending on every substantive chunk).","finalConsistencyChunkId":"final-consistency","coverage":[{"unitId":"/body/summary","chunkIds":["scope-summary"]},{"unitId":"/body/hldContextSlice","chunkIds":["scope-summary"]},{"unitId":"/body/contractDetails","chunkIds":["contract-details"]},{"unitId":"/body/dataModelChanges","chunkIds":["data-model-migration"]},{"unitId":"/body/interactionWithShared","chunkIds":["scope-summary"]},{"unitId":"/body/errorPaths","chunkIds":["error-paths"]},{"unitId":"/body/testStrategy","chunkIds":["test-strategy"]},{"unitId":"/body/migration","chunkIds":["data-model-migration"]},{"unitId":"/body/alternativesConsidered","chunkIds":["alternatives-citations"]},{"unitId":"/body/chosenAlternative","chunkIds":["alternatives-citations"]},{"unitId":"/body/openQuestions","chunkIds":["scope-summary"]},{"unitId":"/body/alternativesConsidered/0","chunkIds":["alternatives-citations"]},{"unitId":"/body/alternativesConsidered/1","chunkIds":["alternatives-citations"]},{"unitId":"/body/alternativesConsidered/2","chunkIds":["alternatives-citations"]},{"unitId":"/citations/0","chunkIds":["alternatives-citations"]},{"unitId":"/citations/1","chunkIds":["alternatives-citations"]},{"unitId":"/citations/2","chunkIds":["alternatives-citations"]},{"unitId":"/citations/3","chunkIds":["alternatives-citations"]},{"unitId":"/citations/4","chunkIds":["alternatives-citations"]},{"unitId":"document:line:24","chunkIds":["scope-summary"]}]},"unitSummaries":[{"unitId":"planning","phase":"planning","automaticDispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[],"actionIds":[]},{"unitId":"scope-summary","phase":"chunk_review","automaticDispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[],"actionIds":[]},{"unitId":"contract-details","phase":"chunk_review","automaticDispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[],"actionIds":[]},{"unitId":"data-model-migration","phase":"chunk_review","automaticDispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[],"actionIds":[]},{"unitId":"error-paths","phase":"chunk_review","automaticDispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[],"actionIds":[]},{"unitId":"test-strategy","phase":"chunk_review","automaticDispatches":2,"retriesUsed":1,"userDirectedDispatches":0,"diagnostics":[{"code":"invalid_output","summary":"Status contradicts findings or mandatory verification limits: received changes_requested, expected incomplete; limitations=2, HIGH/MED=3"}],"actionIds":[]},{"unitId":"alternatives-citations","phase":"chunk_review","automaticDispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[],"actionIds":[]},{"unitId":"final-consistency","phase":"chunk_review","automaticDispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[],"actionIds":[]}],"report":{"reviewId":"lld-7d2422c8f57fa483-s1","attempt":1,"artifactId":"LLD-7d2422c8f57fa483-s1","status":"changes_requested","counts":{"HIGH":2,"MED":6,"LOW":5},"chunks":[{"chunkId":"scope-summary","status":"passed","summary":"The LLD's summary, HLD-context framing, interactionWithShared and openQuestions fields are all faithful to the originating ISSUE-7d2422c8f57fa483 and internally consistent. The summary correctly restates the root cause (whole-row provenance hashed blocks reuse) and the fix intent (new identity format carries only file/cases/result/blobOid per test, ignoring command/executionDetails/evidenceReferences), matching the ISSUE's reproduction and fix-intent sections verbatim in substance. \"Standalone feature — no parent HLD\" at document:line:24 is the correct framing for an issue-workflow LLD (meta.standalone=true, sizeClass=bugfix in the canonical artifact), and no HLD shared contracts are invented. interactionWithShared=[] is consistent with the ISSUE's constraint to avoid editing src/workflow/code-review/task-review/admission.ts: code inspection confirms admission.ts only calls restoreAcceptedAssignments and taskInputFingerprint generically (admission.ts:19,49-50), both of which the LLD's own plan makes format-aware internally without requiring any edit to admission.ts itself, so the \"no edit\" boundary from ISSUE-e4af63128c7cbec2 is honoured. openQuestions=[] is justified: the two candidate open issues a reviewer might expect — cases-reordering semantics and cross-format reuse — are both explicitly resolved in the LLD's edge-case table and error-path 4, not left open, and no other material ambiguity surfaces in this chunk's scope. Citations to contracts.ts:112/:130 and attribution-binding.ts:23-34/:109-119 were spot-checked against the live source and are accurate (the schema at contracts.ts:130 is additionalProperties:false, so the planned field-add is correctly identified as necessary there). The Story also stays scoped to identity-format versioning with no creep into unrelated reuse/attribution mechanics.","findings":[],"inspectedReferences":["/body/summary","/body/hldContextSlice","document:line:24","/body/interactionWithShared","/body/openQuestions","/Users/subhagho/work/projects/insors/insrc/docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/ISSUE.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-7d2422c8f57fa483-s1.json","src/workflow/code-review/task-review/attribution-binding.ts:1-150","src/workflow/code-review/task-review/record.ts:1-100","src/workflow/code-review/task-review/contracts.ts:95-140","src/workflow/code-review/task-review/admission.ts:1-100"],"limitations":[],"advice":["Optional polish: hldContextSlice.boundary.internal just repeats the Story title verbatim rather than adding distinct boundary information; harmless but not informative for a standalone Story with no HLD boundary to describe."]},{"chunkId":"contract-details","status":"changes_requested","summary":"The v1-unchanged claims (2.1, today's taskFinalInput/taskFinalIdentity shape) match the current code in attribution-binding.ts. The error contract and field-naming conventions (TaskReviewInputError, origins/tasks/&lt;index&gt;/sourceAttempt/&lt;n&gt;) are consistent with existing taxonomy. However, two contract gaps risk defeating the fix's own primary scenario: (1) the \"current attempt's format\" that requireReuseIdentity must compare against the source's format is specified inconsistently between 2.2 and 2.3 for the newly-accepted (pending→accepted) path, where the header field is not yet persisted at call time; (2) taskInputFingerprint is unconditionally v2-shaped even when the actual identity comparison for the attempt in question runs in v1 format, so its diagnostic text can silently fail to name a real v1-relevant change.","findings":[{"id":"f1-format-resolution-gap","severity":"MED","location":"docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md §2.2-2.3 (contract: bindTaskFinalIdentities / requireReuseIdentity)","message":"2.2 resolves an attempt's format as: header.taskIdentityFormat when present; else v1 if the attempt is already accepted (a saved pre-change attempt being re-bound); else v2 if the mapping is being newly accepted now. 2.3 instead states the current attempt's format flatly as 'its taskIdentityFormat, or final-task-v1 when absent' with no mention of the pending/newly-accepted branch. In the code's actual call order (src/workflow/code-review/task-review/attribution-binding.ts:121-138), bindTaskFinalIdentities calls requireReuseIdentity (line 136) for every reuse assignment BEFORE Object.assign(review.attempt.header, candidate) (line 138) persists the new taskIdentityFormat onto the header. So for exactly the ac1 scenario — a fresh correction attempt (pending→accepted) reusing a v2-marked source after a provenance-only edit — requireReuseIdentity, read literally per 2.3, would see review.attempt.header.taskIdentityFormat still absent and resolve the CURRENT attempt to 'final-task-v1' (per 2.3's flat rule) instead of 'final-task-v2' (the format 2.2 says this same bind IS using for its own candidate identities). That mismatch (current=v1 vs source=v2) would wrongly trigger the new format-mismatch refusal on the very reuse the fix exists to allow. Because requireReuseIdentity's signature in 2.1/2.3 takes no format parameter, it must independently re-derive the resolved format using 2.2's full (header-present / already-accepted / newly-accepted) rule, not the simpler 'field-or-v1' rule 2.3 states; the LLD does not say so explicitly, leaving this exact threading up to the implementer and risking a silent regression of the bug this Story exists to fix.","evidenceReferences":["docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md §2.2 'the identity format is the attempt header's taskIdentityFormat when present; otherwise final-task-v1 when the attempt is already accepted ... and final-task-v2 when the mapping is being accepted now'","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md §2.3 'requires the source attempt's identity format (its taskIdentityFormat, or final-task-v1 when absent) to equal the current attempt's'","src/workflow/code-review/task-review/attribution-binding.ts:121-140 (bindTaskFinalIdentities: candidate built before requireReuseIdentity call at line 136; Object.assign persisting header.taskIdentityFormat happens after, at line 138)","src/workflow/code-review/task-review/attribution-binding.ts:131-133 (the only two states that reach this point are attributionState 'accepted' (re-bind) or 'pending' (new accept), matching 2.2's two branches but not 2.3's single flat rule)"]},{"id":"f2-fingerprint-format-mismatch","severity":"MED","location":"docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md §2.4 (contract: taskInputFingerprint) and the reuseMismatch diagnostic it feeds","message":"2.4 fixes taskInputFingerprint to always hash the v2-shaped test fields ({file, cases, result, blobOid}), with no format parameter and no conditioning on which format the actual reuse comparison used. But the underlying mismatch (reuseMismatch in src/workflow/code-review/task-review/attribution-binding.ts:49-61, used by requireReuseIdentity) can legitimately fire while the attempt pair being compared is still in 'final-task-v1' (the restoreAcceptedAssignments re-bind path for a saved pre-change attempt whose own reuse decision points at an earlier v1 attempt). In that v1-format case a real provenance-field change (command/executionDetails/evidenceReferences) is exactly what v1 treats as a content change and correctly refuses reuse over, yet the always-v2 fingerprint compares only {file,cases,result,blobOid}, sees no difference in those fields, and falls back to the generic 'source, test, document or assignment identity/order changed' text instead of naming the actual changed test — contradicting the Story's and ISSUE-146084d04395b88b's goal of keeping the rejection text naming the real cause. The LLD's postcondition only promises the message *format* is unchanged, not that its content stays accurate for a v1-current comparison; this is a real, demonstrable diagnostic-accuracy gap for the legacy/re-bind path, not just a hypothetical.","evidenceReferences":["docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md §2.4 '...its tests entries hash the v2 test fields ({ file, cases, result, blobOid }), so a rejection names only a test whose file, cases or result changed... Not persisted' and postcondition 'The rejection message format from ISSUE-146084d04395b88b is unchanged'","src/workflow/code-review/task-review/attribution-binding.ts:49-61 (reuseMismatch; before/after fingerprints compared per-field, falls back to the generic message when no field in before/after differs)","src/workflow/code-review/task-review/attribution-binding.ts:141-145 (restoreAcceptedAssignments calls bindTaskFinalIdentities, which calls requireReuseIdentity, for an already-accepted/v1 attempt's stored reuse decisions)","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/ISSUE.md 'Fix intent' — 'this revises what the fingerprint covers, keeping its rejection feedback' (implying accuracy of the named cause is part of what must be kept)"]}],"inspectedReferences":["/body/contractDetails","/Users/subhagho/work/projects/insors/insrc/docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/ISSUE.md","src/workflow/code-review/task-review/attribution-binding.ts","src/workflow/code-review/task-review/record.ts:1-100","src/workflow/code-review/task-review/contracts.ts"],"limitations":[],"advice":["Consider making requireReuseIdentity's format resolution explicit by either (a) giving it the same resolution helper bindTaskFinalIdentities uses (keyed off attributionState, not just the header field), stated identically in both 2.2 and 2.3, or (b) threading the already-resolved format down as an explicit parameter from bindTaskFinalIdentities into requireReuseIdentity so there is one source of truth instead of two independently-worded rules.","Consider making taskInputFingerprint format-aware (or at least noting in 2.4 that its v2-only shape is a deliberate simplification that may under-report for a still-live v1 comparison), so reviewers/implementers know the generic fallback message is an accepted tradeoff rather than an oversight for the rare v1 re-bind mismatch path."]},{"chunkId":"data-model-migration","status":"passed","summary":"The data-model-changes and migration sections of LLD-7d2422c8f57fa483-s1 are accurate and internally consistent against the current code. The cited call sites (contracts.ts:112, contracts.ts:130, attribution-binding.ts:23-34, 109-119, 121-140) correctly identify the header interface, the strict header schema, taskFinalInput, requireReuseIdentity and bindTaskFinalIdentities respectively. The claim that CR summaries/history snapshots/record schemas stay unchanged holds: record.ts:76's publication equality check compares only the stored `identity` string, and because the format name ('final-task-v1'/'final-task-v2') is baked into the canonicalized hash input (attribution-binding.ts taskFinalInput's `format` field), identity equality already implies format equality for any practical purpose — no separate format field is needed in the summary/record schema for correctness. The backward-compat statement is consistent with the strict, `additionalProperties:false` header schema (contracts.ts:130): an older build's schema has no `taskIdentityFormat` property, so decoding a new checkpoint that carries it fails closed, matching \"older daemon builds cannot read checkpoints carrying the new optional field.\" The zero-downtime/no-data-rewrite claims hold for the described deploy model (a single-process restart, no concurrent old/new code against the same checkpoint); the edge-case table already covers the two states an in-progress attempt can be in at a restart boundary (unmarked-accepted re-binds as v1; pending-at-deploy accepts as v2), so no attempt can straddle the format boundary in a way the design leaves unhandled.","findings":[{"id":"rollback-prereq-unguarded","severity":"LOW","location":"docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:186 (Migration step 3)","message":"Migration step 3 states the non-rollback risk is acceptable only when 'no such checkpoints exist' that carry taskIdentityFormat, but the LLD names no operational check (script, assertion, or runbook step) that verifies this precondition before a rollback is performed; today nothing in the codebase enforces or reports it. This is disclosed honestly as a caveat rather than a hidden gap, so it does not block, but the migration section would be stronger with an explicit verification step (e.g., grep/scan checkpoints for the field, or a documented manual runbook check) rather than leaving the precondition unverifiable in practice.","evidenceReferences":["docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:186","src/workflow/code-review/task-review/coordinator.ts (no rollback/preflight checkpoint-scan utility found)"]}],"inspectedReferences":["/body/dataModelChanges","/body/migration","/Users/subhagho/work/projects/insors/insrc/docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md","src/workflow/code-review/task-review/contracts.ts:106-148 (ReviewAttempt interface + CheckpointSchema, strict additionalProperties:false)","src/workflow/code-review/task-review/attribution-binding.ts:1-146 (taskFinalInput, taskFinalIdentity, taskInputFingerprint, requireReuseIdentity, bindTaskFinalIdentities, restoreAcceptedAssignments)","src/workflow/code-review/task-review/record.ts:1-101 (validateTaskBody reuse-source identity check at line 76)","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/ISSUE.md"],"limitations":[],"advice":["Consider adding one line to migration step 3 naming how an operator would check 'no such checkpoints carry taskIdentityFormat' before relying on that rollback prerequisite (e.g., a one-off grep across .insrc checkpoint storage, or noting that in practice the field only appears after the first newly-accepted mapping, so a time-boxed rollback window is safe)."]},{"chunkId":"error-paths","status":"changes_requested","summary":"The error-paths section covers the stated edge cases plausibly, and most assigned concerns resolve cleanly against the code (per-task test scoping has no cross-task coupling; invariants c1/c2 map to real enforcement points in attribution-binding.ts and record.ts; mixed-format submissions are handled per-task without cross-contamination). However, tracing the \"format differs\" error case against the actual control flow in bindTaskFinalIdentities/attribution-repair.ts shows the claimed \"one-time reassessment\" cost does not hold when a correction attempt needs to reassess more than one task carried over from a pre-fix (v1) source attempt in the same submission — this reproduces the exact budget-exhaustion failure mode the ISSUE reports, for the transition window this design itself introduces. A secondary citation-accuracy issue (the three-submission budget invariant cites record.ts:76, which does not contain that constant) is also flagged.","findings":[{"id":"f1-format-mismatch-recurs-per-task","severity":"HIGH","location":"docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md#4-error-paths (error case 1: \"A correction attempt reuses a task whose source attempt was recorded under the earlier identity format\")","message":"The error-paths section claims this case is a one-time cost (\"The reviewer reassesses that task once; later attempts can reuse it under the new format\"), but tracing the actual control flow shows it reproduces the ISSUE's budget-exhaustion failure mode whenever more than one task must be reassessed in the same correction attempt because its source carries the old (v1/absent) format. bindTaskFinalIdentities (attribution-binding.ts:136) calls requireReuseIdentity in a plain for-loop and requireReuseIdentity throws synchronously (TaskReviewInputError) on the FIRST mismatched task, aborting the whole candidate build before later tasks in the same loop are even checked — exactly the 'It throws at the first such task' mechanism the ISSUE's own root-cause section names as the cause of budget exhaustion. recordAttributionRejection (attribution-repair.ts:7-16) counts each such thrown error as one of only MAX_ATTRIBUTION_SUBMISSIONS=3 rejections, regardless of how many tasks are affected or how large the batch is. Concretely: a correction attempt submitted after this fix ships, trying to reuse t1/t2/t4 from a pre-fix (v1) attempt 1 (exactly the scenario in the ISSUE's own reproduction, projection-scope-66d4-s1), will fail on t1 alone in submission 1 (consuming 1/3), on t2 alone in submission 2 (consuming 2/3), and on t4 alone in submission 3 (consuming 3/3) — exhausting the budget with no task assessed, the identical symptom the ISSUE reports, just triggered by format instead of provenance text. The LLD's fix intent and migration section ('reassessed once') do not acknowledge or resolve this multi-task-per-submission recurrence for the transition window this design itself creates.","evidenceReferences":["docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:115-118","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:188 (Backward compat: \"results from those attempts cannot be reused by attempts accepted after the change and are reassessed once\")","src/workflow/code-review/task-review/attribution-binding.ts:136","src/workflow/code-review/task-review/attribution-repair.ts:6-16","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/ISSUE.md:9 (reproduction: \"t1, t2 and t4 ... unreusable, and attempts 2 and 3 both failed in attribution\")","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/ISSUE.md:14 (root cause: \"It throws at the first such task, and the attribution repair budget is three submissions\")"]},{"id":"f2-budget-citation-wrong-location","severity":"LOW","location":"docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md#4-error-paths (Invariants to preserve: \"The three-submission attribution budget and the reassess feedback of ISSUE-146084d04395b88b are unchanged. [[c2]]\")","message":"The invariant naming the three-submission attribution budget cites [[c2]], whose own entry in References (section 8) points only to src/workflow/code-review/task-review/record.ts:76. The MAX_ATTRIBUTION_SUBMISSIONS=3 constant this invariant is actually about lives in src/workflow/code-review/task-review/attribution-repair.ts:6 (cited as [[c3]] in the ISSUE, not referenced at all from this invariant). This is a citation-accuracy gap: a reader following [[c2]] to verify the budget claim lands on unrelated code (the publication reuse-identity-equality check), not the budget constant.","evidenceReferences":["docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:148","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:217","src/workflow/code-review/task-review/attribution-repair.ts:6","src/workflow/code-review/task-review/record.ts:76"]}],"inspectedReferences":["/body/errorPaths","/Users/subhagho/work/projects/insors/insrc/docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/ISSUE.md","src/workflow/code-review/task-review/attribution-binding.ts","src/workflow/code-review/task-review/record.ts","src/workflow/code-review/task-review/attribution-repair.ts"],"limitations":[],"advice":["The 'cases reordered is treated as a change' edge case is a defensible, explicitly-flagged scope decision (cases are part of what the ISSUE's fix intent says must still invalidate reuse), but it is not something the ISSUE itself asked for and could surprise a reviewer whose tooling reorders test cases non-semantically between submissions. Consider calling this out explicitly as a known limitation in the Story's user-facing notes, not just the edge-case table, since it is a new source of (correct, but maybe unexpected) reuse refusal.","To actually resolve concern f1 without expanding scope into admission.ts (off-limits per ISSUE-e4af63128c7cbec2), consider having requireReuseIdentity/bindTaskFinalIdentities collect ALL per-task mismatches (format or identity) before throwing, so a single submission's error names every affected task at once (not just the first) — this would let a reviewer fix a whole v1-sourced batch in one correction round instead of one task per round, closing the transition-window gap without touching the admission/budget machinery itself.","Two tasks sharing one test row is correctly isolated per-task today since taskFinalInput only hashes assignment.tests (each task's own assignment), confirmed by reading attribution-binding.ts:29; worth a short explicit test asserting this non-coupling given it is called out as its own edge case."]},{"chunkId":"test-strategy","status":"changes_requested","summary":"The test strategy's unit/integration levels are well-targeted at the two identity formats and the main reassess/reuse paths, but the acceptance mapping and declared edge cases have real gaps: ac5 has no proving test distinct from ac1 (identical test name reused verbatim), two declared edge cases (test-row cases reordered; task with no assigned tests) have no named proving test anywhere in the strategy, and the explicit postcondition that a v2 reuse row's publication equality at record.ts:76 stays like-for-like is not exercised by any named test. These are demonstrable deficiencies in the written test strategy against the LLD's own error-paths/edge-cases and postconditions, not merely optional improvements.","findings":[{"id":"ts-ac5-redundant","severity":"HIGH","location":"docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md#5-test-strategy (Acceptance mapping, ac5 row)","message":"ac5's single proving test is the exact same test name already listed as ac1's first proving test ('a correction attempt reuses a task when only provenance text in its test rows changed'). No test in the strategy is unique to ac5. If ac5 is a distinct acceptance criterion from ac1 (the mapping table treats them as separate rows), the strategy currently provides zero differentiated proof for it; if ac5 is actually identical to ac1, the acceptance list itself is redundant and the LLD does not say so. Either way the mapping as written does not demonstrate ac5 is met by anything beyond ac1's own test.","evidenceReferences":["docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:168","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:172",".insrc/artifacts/LLD-7d2422c8f57fa483-s1.json:287","​.insrc/artifacts/LLD-7d2422c8f57fa483-s1.json:315"]},{"id":"ts-edgecases-untested","severity":"MED","location":"docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md#4-error-paths (Edge cases table) vs #5-test-strategy","message":"Two edge cases the LLD itself declares as behavior to preserve — 'Test row cases reordered' (treated as a change, reuse refused) and 'A task with no assigned tests' (v2 identity covers requirements/changes/documents only) — have no named proving test anywhere in the test strategy's levels, fixtures or acceptance mapping. Both are stated outcomes the implementation must exhibit, but nothing in section 5 is assigned to verify either.","evidenceReferences":["docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:139","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:141","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:151-172"]},{"id":"ts-record76-reuse-row-untested","severity":"MED","location":"docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md#2.3-requireReuseIdentity (Postconditions) vs #5-test-strategy","message":"Section 2.3's postcondition states 'A published reuse row and its source always carry identities of the same format, so the publication check in src/workflow/code-review/task-review/record.ts:76 stays a like-for-like equality.' The integration test level's prose mentions 'the CR record validation accepting the published reuse row' but record.ts/record.test.ts is not listed as a subject, and no acceptance-mapping row or named test exercises a v2-format reuse row through the record.ts:76 publication-equality check. The existing compatibility.test.ts suite (checked) covers origin-absent/legacy publication paths, not a v2 reused-identity row, so this explicit postcondition is currently unverified by the written strategy.","evidenceReferences":["docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:79","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:160-162","src/workflow/code-review/task-review/__tests__/compatibility.test.ts:61-66"]},{"id":"ts-no-scale-repro","severity":"LOW","location":"docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md#5-test-strategy (integration level)","message":"The integration level does not include a fixture that reproduces the ISSUE's reported scale directly (3 tasks losing reuse eligibility across 2 failed correction attempts exhausting the 3-submission attribution budget). Coverage is per-task/per-identity rather than an end-to-end regression of the originally observed multi-task failure mode; since the fix is categorical (per-task identity comparison), this is not required for correctness, but a scale-matching regression test would more directly guard against recurrence of the reported incident.","evidenceReferences":["docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/ISSUE.md:9","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:159-162"]}],"inspectedReferences":["/body/testStrategy","/Users/subhagho/work/projects/insors/insrc/docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/ISSUE.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-7d2422c8f57fa483-s1.json","/Users/subhagho/work/projects/insors/insrc/src/workflow/code-review/task-review/__tests__/compatibility.test.ts"],"limitations":[],"advice":["Consider either removing ac5 as a separately listed criterion (folding it into ac1) or adding a test that proves something ac1's test does not, so the mapping table's rows are each backed by distinct evidence.","Add one named unit test each for the 'cases reordered' and 'no assigned tests' edge cases so the strategy's own declared behaviors are checked, not just asserted in prose.","Add a record.ts-focused test (or extend an existing one) that publishes a reuse row computed under 'final-task-v2' and asserts the publication equality check at record.ts:76 accepts it, directly covering the 2.3 postcondition.","Optional: add one integration fixture closer to the ISSUE's reported scale (multiple provenance-only-changed tasks in one correction attempt) as a direct regression guard, though it is not required given the categorical per-task fix."]},{"chunkId":"alternatives-citations","status":"changes_requested","summary":"Citations c1 and c3 ground accurately against current source. The chosen alternative (a1) is coherent and its contrast with a3 (three schemas vs. one) is proportionate and accurate. Two issues found: (1) a2's rejection rationale claims record.ts:76's publication check needs to \"rediscover\" the identity format, but the actual code at that line (and the LLD's own 2.3 postcondition) shows it performs pure stored-identity equality with no format awareness required under either a1 or a2 — the stated con does not hold for that specific location. (2) The LLD omits any discussion of a \"narrow/reduce scope\" alternative (e.g. simply dropping provenance fields from v1 without versioning), leaving that path's rejection or non-consideration unexplained. Citation c2 (record.ts:76) bundles three distinct facts under one line pointer, only one of which (identity equality) is actually present at that line.","findings":[{"id":"a2-con-inaccurate","severity":"MED","location":"docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md §7.2 (a2 rejection) and §2.3 postcondition","message":"a2's rejection states the implicit format 'must be rediscovered wherever reuse is checked, including record.ts publication checks (ac4 partial).' But record.ts:76 (`source.taskScopeIdentities?.find(...).identity===row.identity`) only compares two already-computed stored identity strings for equality — it never recomputes or needs to know which format produced them, in either a1 or a2. The LLD's own §2.3 postcondition for the CHOSEN alternative confirms this: 'the publication check in record.ts:76 stays a like-for-like equality' precisely because format-matching is enforced upstream (in requireReuseIdentity), not because record.ts itself discovers a format. Since a1 and a2 would both leave record.ts equally format-oblivious, this specific claimed drawback of a2 is not accurate as stated and should either be removed or re-grounded in the real risk of a2 (fragile trial-based format inference at restore when v1/v2 outputs could coincide, or the 'all tasks in one format' constraint being awkward to enforce) rather than attributed to record.ts.","evidenceReferences":["src/workflow/code-review/task-review/record.ts:76","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:73-79 (§2.3 requireReuseIdentity contract + postcondition)","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:204 (a2 rejection text)"]},{"id":"missing-reduce-scope-alternative","severity":"LOW","location":"docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md §7 (Alternatives considered)","message":"The alternatives list covers two ways to version/split the identity (a2, a3) but never addresses the simpler option of narrowing the v1 identity itself (dropping provenance-only test-row fields from the single, unversioned format) without introducing a format marker at all. That path's obvious con — it would retroactively change what every saved identity means, breaking re-binding of attempts saved before the change (violating ac3) — is implicit in the Migration section's backward-compat requirement but is never named as a considered-and-rejected alternative. Naming it briefly would make the alternatives survey complete.","evidenceReferences":["docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:190-212 (§7 Alternatives considered)","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:188 (Backward compat: saved attempts validate unchanged)"]},{"id":"c2-citation-bundling-imprecise","severity":"LOW","location":"docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:217 ([[c2]] reference)","message":"[[c2]] cites a single line, record.ts:76, for three distinct facts: '(a) a published reuse row's identity must equal the source attempt's stored identity, (b) the attempt header schema is strict, (c) the attribution budget is three submissions.' Only fact (a) is actually present at record.ts:76; the strict-schema fact lives in contracts.ts's Type.Object(...,{additionalProperties:false}) schemas, and the three-submission budget is MAX_ATTRIBUTION_SUBMISSIONS in attribution-repair.ts:6 (as the originating ISSUE's own c3 citation correctly locates it). Bundling unrelated facts under one line pointer makes the citation harder to verify at a glance; citing each fact at its own location (as the ISSUE did) would be more precise.","evidenceReferences":["src/workflow/code-review/task-review/record.ts:76","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/ISSUE.md:28 ([[c3]] attribution-repair.ts:6)","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:217"]}],"inspectedReferences":["/body/alternativesConsidered","/body/chosenAlternative","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/alternativesConsidered/2","/citations/0","/citations/1","/citations/2","/citations/3","/citations/4","/Users/subhagho/work/projects/insors/insrc/docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/ISSUE.md","src/workflow/code-review/task-review/attribution-binding.ts","src/workflow/code-review/task-review/record.ts:60-81","src/workflow/code-review/task-review/contracts.ts (schema definitions, lines 1-158)","src/workflow/code-review/task-review/__tests__/attribution-binding.test.ts (lines 58-135)"],"limitations":[],"advice":["Consider rewriting a2's rejection to cite the real risk (trial-based format inference at restore time could be ambiguous or fragile, especially under the 'all tasks must agree on one format' constraint) rather than a record.ts dependency that does not exist under either alternative.","Consider citing the strict-schema and three-submission-budget facts at their own locations (contracts.ts schema definitions; attribution-repair.ts:6) instead of bundling them into the record.ts:76 citation."]},{"chunkId":"final-consistency","status":"changes_requested","summary":"Aggregating all six substantive chunks: scope-summary and data-model-migration passed (one LOW each); contract-details, error-paths, test-strategy and alternatives-citations all returned changes_requested, with two HIGH findings (budget-exhaustion recurrence in the transition window; a redundant ac5 proving test) and four MED findings (format-resolution ambiguity in 2.2/2.3; an always-v2 fingerprint that can misreport for a live v1 comparison; two untested declared edge cases / an unverified publication postcondition; an inaccurate a2-rejection rationale). The fix's core mechanism (versioned per-task identity, format recorded on the attempt header) is coherent and does not reintroduce editing of admission.ts, and the three-submission budget / ISSUE-146084d04395b88b rejection-feedback format are referenced consistently (not altered) across contractDetails, errorPaths and testStrategy — no direct textual contradiction exists between those sections. However, cross-checking the error-paths HIGH finding against the Migration section surfaces one additional, document-wide consistency gap: the same inaccurate \"reassessed once\" cost claim that error-paths flags as HIGH (because requireReuseIdentity throws synchronously on the first task reassessed per submission, so more than one v1-sourced task in one correction attempt reproduces the ISSUE's own budget-exhaustion failure mode) is restated verbatim and unreconciled in §6 Migration's \"Backward compat\" line — the document is internally consistent in repeating the claim, but consistently wrong about it in both places it appears, which is worse than an isolated local error because a reader who checks only §6 would not learn of the gap flagged in §4. No other cross-section contradiction was found (data-model/migration backward-compat claims are consistent with the schema-strictness claims; no section reintroduces admission.ts edits; scope/summary framing matches the ISSUE verbatim).","findings":[{"id":"fc1-migration-repeats-unreconciled-reassess-once-claim","severity":"MED","location":"docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md#6-migration (Backward compat line) cross-checked against #4-error-paths (error case 1)","message":"The error-paths chunk's HIGH finding (f1-format-mismatch-recurs-per-task) demonstrates that, because bindTaskFinalIdentities calls requireReuseIdentity in a plain loop that throws synchronously on the FIRST task whose source attempt carries the earlier identity format (attribution-binding.ts:136), a correction attempt that needs to reassess MORE THAN ONE v1-sourced task in the same submission will exhaust the three-submission attribution budget one task at a time — reproducing the exact budget-exhaustion failure mode the originating ISSUE reports (t1/t2/t4 across attempts 2 and 3), just triggered by the v1→v2 transition instead of provenance wording. This is not confined to §4: the Migration section's own 'Backward compat' line makes the identical, equally unqualified claim — 'results from those attempts cannot be reused by attempts accepted after the change and are reassessed once' — with no cross-reference to the multi-task caveat and no acknowledgment that for a batch of several pre-fix-format tasks the reassessment cost is NOT a flat one-time cost per task but a budget-consuming serial failure identical in shape to the bug this Story exists to close. Because this claim recurs, uncorrected, in two independent sections (§4 and §6) rather than being isolated to one, a reader who only checks the migration/rollout framing (as an operator doing the deploy would) has no way to learn of the transition-window risk that the error-paths chunk already identified as HIGH.","evidenceReferences":["docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:188 ('results from those attempts cannot be reused by attempts accepted after the change and are reassessed once')","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md:117-118 (same claim in §4 error case 1: 'The reviewer reassesses that task once; later attempts can reuse it under the new format')","src/workflow/code-review/task-review/attribution-binding.ts:136 (requireReuseIdentity invoked per task inside bindTaskFinalIdentities' loop, throws synchronously on first mismatch)","src/workflow/code-review/task-review/attribution-repair.ts:6-16 (MAX_ATTRIBUTION_SUBMISSIONS=3; each thrown TaskReviewInputError consumes one submission regardless of how many tasks remain unassessed)","docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/ISSUE.md:9 (original reproduction: t1, t2, t4 unreusable; attempts 2 and 3 both failed in attribution)","checkpoint /Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/lld-7d2422c8f57fa483-s1.json, completedChunks[error-paths].findings[0] (f1-format-mismatch-recurs-per-task, HIGH)"]}],"inspectedReferences":["/Users/subhagho/work/projects/insors/insrc/docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/lld-7d2422c8f57fa483-s1.json","/Users/subhagho/work/projects/insors/insrc/docs/standalone/code-review-reuse-refused-when-only-E202611117d2422c8/ISSUE.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-7d2422c8f57fa483-s1.json","completedChunks[scope-summary]","completedChunks[contract-details]","completedChunks[data-model-migration]","completedChunks[error-paths]","completedChunks[test-strategy]","completedChunks[alternatives-citations]","src/workflow/code-review/task-review/attribution-binding.ts:109-146","src/workflow/code-review/task-review/attribution-repair.ts:6-16","src/workflow/code-review/task-review/record.ts:60-81","src/workflow/code-review/task-review/contracts.ts:106-148"],"limitations":[],"advice":["Before approval, the two outstanding HIGH findings from substantive chunks should be resolved first since they gate correctness/coverage: error-paths' f1-format-mismatch-recurs-per-task (the fix's transition window can reproduce the exact budget-exhaustion bug this Story closes, for a batch of >1 v1-sourced tasks in one correction attempt) and test-strategy's ts-ac5-redundant (ac5 has no proving test distinct from ac1, so it is currently unverified as written).","The four MED findings (contract-details' f1-format-resolution-gap and f2-fingerprint-format-mismatch; test-strategy's ts-edgecases-untested and ts-record76-reuse-row-untested; alternatives-citations' a2-con-inaccurate) are all independently actionable and do not conflict with each other or with this chunk's own finding; addressing f1-format-resolution-gap (make requireReuseIdentity's format resolution explicit/shared with bindTaskFinalIdentities) would likely also materially reduce the risk surfaced by fc1 here, since a clearer, centrally-resolved format would make it easier to batch-detect and report all mismatched tasks in one submission instead of throwing on the first.","Low-severity items (rollback-prereq-unguarded, f2-budget-citation-wrong-location, ts-no-scale-repro, missing-reduce-scope-alternative, c2-citation-bundling-imprecise) are polish-level and can be deferred to a follow-up revision without blocking this round."]}],"limitations":[],"reviewer":"daemon","reviewedContentIdentity":"56d8ad685a5e98fa568b2aa4a74b7f65ba9c413c04a98fe35f30ced280a5e9e2"},"finishedAt":"2026-11-11T14:55:31.260Z"}]}}}}
