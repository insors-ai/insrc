75898	{"artifactId":"LLD-8a036e6436ae82ab-s1","entry":{"id":"f5e2101cefd83b5ca05ed8b25dda9fed756735c00ee812b78648a0f6befede8b","targetHeadHash":"d429534676cdda3e6f79c2983910a104ab246a6e03d353e49f275060a627946a","actor":{"id":"agent:design-review-daemon","kind":"agent","properties":{"party":"daemon"}},"timestamp":"2026-11-14T06:45:51.902Z","operation":"review","revision":{"number":1,"contentHash":"2dd78f3d13eaf700bc75a67b14aaac46226bd75aaa4cc4d721764c51f4fc4821"},"outcome":{"result":"block","summary":"Design review macos-prebuilt-8a036e64 attempt 1","data":{"kind":"design-chunk-review","reviewId":"macos-prebuilt-8a036e64","project":"/Users/subhagho/work/projects/insors/insrc","artifactId":"LLD-8a036e6436ae82ab-s1","subject":{"project":"/Users/subhagho/work/projects/insors/insrc","artifactId":"LLD-8a036e6436ae82ab-s1","kind":"LLD","canonicalPath":"/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-8a036e6436ae82ab-s1.json","documentPath":"/Users/subhagho/work/projects/insors/insrc/docs/standalone/pilot-prebuilt-macos-daemon-releases-E202611148a036e64/S001/LLD.md","reviewer":"daemon","workflow":{"kind":"standalone","rootArtifactId":"LLD-8a036e6436ae82ab-s1","requiredReferences":[],"availableReferences":[],"notApplicableRoles":["PLAN","TASKS","BUILD","CR","DEF","HLD","sibling_stories"]}},"reviewer":"daemon","applicableAttempt":1,"status":"incomplete","binding":{"sourceRevision":{"number":1,"contentHash":"2dd78f3d13eaf700bc75a67b14aaac46226bd75aaa4cc4d721764c51f4fc4821"},"reviewedContentIdentity":"50227a472660f3c2ab3ee9deb4372b0e4eb8dd0a415d8d7f28b4ee976a140252","documentDigest":"96288de7b6822b01b095007a3a36cf0262136b278069863da72b8e7d68f6eeed","workflowDigest":"e4fad166bad262dca41daca75f07929276d85912fd42f9feca3fc089d92c885a","author":"controller"},"preservationDigest":"1b312995b89787c61fbf0378ab5252d2a9e4dec1222803129bae7d52a25766a1","schemaVersion":2,"submitted":{"artifactPath":"/Users/subhagho/work/projects/insors/insrc/docs/standalone/pilot-prebuilt-macos-daemon-releases-E202611148a036e64/S001/LLD.md","attempt":1},"attempts":[{"number":1,"status":"incomplete","preparationKind":"planning","baseline":{"subjectFingerprints":{"canonical":"d94fb8b7f602bd69038b311412ed7f548b848b04eaf36e5b9fe468bbe81fcd5f","document":"96288de7b6822b01b095007a3a36cf0262136b278069863da72b8e7d68f6eeed"},"contentIdentity":"50227a472660f3c2ab3ee9deb4372b0e4eb8dd0a415d8d7f28b4ee976a140252","reviewedContent":{"canonical":"{\n  \"meta\": {\n    \"workflow\": \"design.story\",\n    \"runId\": \"wf-1794638228206-o4i31o\",\n    \"repoPath\": \"/Users/subhagho/work/projects/insors/insrc\",\n    \"createdAt\": \"2026-11-14T06:38:49.736Z\",\n    \"epicCreatedAt\": \"2026-11-14T06:38:49.736Z\",\n    \"attribution\": {\n      \"outputs\": [\n        {\n          \"role\": \"(client)\",\n          \"tier\": \"core\",\n          \"runner\": \"cli-codex\",\n          \"model\": \"unknown\"\n        }\n      ]\n    },\n    \"elapsedMs\": 101207,\n    \"repoIndexedAt\": null,\n    \"schemaVersion\": 1,\n    \"epicHash\": \"8a036e6436ae82ab\",\n    \"epicSlug\": \"pilot-prebuilt-macos-daemon-releases\",\n    \"storyId\": \"s1\",\n    \"hldBaseRunId\": \"wf-1794638228206-o4i31o\",\n    \"hldEffectiveHash\": \"8a036e6436ae82abeac5a637b65daf39f86c2c682d26a03594657128d82b29c9\",\n    \"hldAmendmentsApplied\": [],\n    \"storyTitle\": \"Pilot prebuilt macOS daemon releases\",\n    \"standalone\": true,\n    \"sizeClass\": \"feature\",\n    \"triageRationale\": \"A single opt-in macOS arm64 release path connects two surfaces, release automation and existing install/lifecycle; it requires several tasks but no new daemon subsystem or Linux story.\",\n    \"authoredBy\": \"controller\",\n    \"lifecycle\": {\n      \"status\": \"draft\",\n      \"revision\": {\n        \"number\": 1,\n        \"contentHash\": \"2dd78f3d13eaf700bc75a67b14aaac46226bd75aaa4cc4d721764c51f4fc4821\",\n        \"at\": \"2026-11-14T06:38:49.849Z\",\n        \"by\": {\n          \"id\": \"insrc:system\",\n          \"kind\": \"system\",\n          \"properties\": {}\n        }\n      },\n      \"signoffs\": []\n    },\n    \"revision\": 1\n  },\n  \"body\": {\n    \"summary\": {\n      \"audience\": \"technical\",\n      \"prose\": \"An opt-in macOS arm64 path stages verified prebuilt bytes into the managed lifecycle. Existing source delivery remains the default. No pilot workflow runs tests on Actions.\"\n    },\n    \"hldContextSlice\": {\n      \"frameworkSummary\": \"Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\",\n      \"ownedContracts\": [],\n      \"consumedContracts\": [],\n      \"boundary\": {\n        \"storyId\": \"s1\",\n        \"owns\": [],\n        \"depends\": [],\n        \"internal\": \"Pilot prebuilt macOS daemon releases\"\n      },\n      \"adjacentBoundaries\": [],\n      \"rolloutPhase\": \"standalone\",\n      \"nonFunctional\": {}\n    },\n    \"contractDetails\": {\n      \"api\": [\n        {\n          \"name\": \"Build candidate\",\n          \"signature\": \"commit SHA + version → candidate run ID, artifact ID and archive digest\",\n          \"parameters\": [],\n          \"returns\": {\n            \"type\": \"result\",\n            \"meaning\": \"Success identifies the exact artifact; failure stops the operation.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"ReleaseGate\",\n              \"condition\": \"Invalid, inconsistent or missing evidence or incompatible target.\"\n            }\n          ],\n          \"preconditions\": [\n            \"Use trusted workflow on protected branch; resolve and verify exact full commit and allowed version.\",\n            \"The build job has no signing or publishing credentials.\"\n          ],\n          \"postconditions\": [\n            \"Package pinned Node 22, compiled entrypoints, required assets, production dependencies and native helper/supervisor binaries; record target and minimum macOS version.\",\n            \"Upload exactly one archive and bounded build metadata; do not execute test suites.\"\n          ]\n        },\n        {\n          \"name\": \"Record local qualification\",\n          \"signature\": \"candidate identity + results → release qualification record\",\n          \"parameters\": [],\n          \"returns\": {\n            \"type\": \"result\",\n            \"meaning\": \"Success identifies the exact artifact; failure stops the operation.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"ReleaseGate\",\n              \"condition\": \"Invalid, inconsistent or missing evidence or incompatible target.\"\n            }\n          ],\n          \"preconditions\": [\n            \"Verify the run, artifact and SHA-256 before using the bundle on a dedicated test install.\",\n            \"Run appropriate source tests against the same commit and exact candidate install, migration, restart and rollback checks.\"\n          ],\n          \"postconditions\": [\n            \"Record commit, version, platform, digest, run/artifact IDs, macOS version and pass evidence.\"\n          ]\n        },\n        {\n          \"name\": \"Promote candidate\",\n          \"signature\": \"approved qualification record → signed manifest and GitHub prerelease\",\n          \"parameters\": [],\n          \"returns\": {\n            \"type\": \"result\",\n            \"meaning\": \"Success identifies the exact artifact; failure stops the operation.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"ReleaseGate\",\n              \"condition\": \"Invalid, inconsistent or missing evidence or incompatible target.\"\n            }\n          ],\n          \"preconditions\": [\n            \"Separate protected workflow; fetch exact artifact by run and artifact ID, recompute SHA-256 and verify it against approved qualification.\",\n            \"Fail if required publish protection unavailable; no fallback to branch head, latest candidate or rebuild.\"\n          ],\n          \"postconditions\": [\n            \"Sign canonical manifest and publish the exact qualified bytes as a prerelease. Fail closed on existing conflicting tag/version/assets.\"\n          ]\n        },\n        {\n          \"name\": \"Stage prebuilt release\",\n          \"signature\": \"opt-in version + trusted manifest and archive → managed candidate\",\n          \"parameters\": [],\n          \"returns\": {\n            \"type\": \"result\",\n            \"meaning\": \"Success identifies the exact artifact; failure stops the operation.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"ReleaseGate\",\n              \"condition\": \"Invalid, inconsistent or missing evidence or incompatible target.\"\n            }\n          ],\n          \"preconditions\": [\n            \"Verify project signature with pinned public trust before parsing trusted claims; verify version, platform, compatibility and archive digest before extraction.\",\n            \"Reject unsafe entries; stage in a private directory on same volume, with no writes to live state until existing lifecycle gates pass.\"\n          ],\n          \"postconditions\": [\n            \"Use managed pinning, activation, health checks and recovery while retaining the previous qualified installation for safe rollback.\"\n          ]\n        }\n      ],\n      \"surfaceLevel\": \"public\"\n    },\n    \"dataModelChanges\": [\n      {\n        \"entity\": \"Candidate identity\",\n        \"change\": \"new\",\n        \"details\": \"One Actions build produces one archive for a commit, version and target. Local qualification and the protected promotion job both consume the same run ID, artifact ID and SHA-256.\",\n        \"callSites\": []\n      },\n      {\n        \"entity\": \"Signed release manifest v1\",\n        \"change\": \"new\",\n        \"details\": \"One release manifest declares archive name, exact size, SHA-256, commit, release version and sequence, channel, target/OS minimum, Node and compatibility metadata. Its detached project signature authenticates the manifest, which authenticates the one archive. Installed trust pins project keys; key recovery and rotation are explicit release operations.\",\n        \"callSites\": [\n          \"src/bin/insrc-release-bootstrap.ts\"\n        ]\n      }\n    ],\n    \"interactionWithShared\": [],\n    \"errorPaths\": {\n      \"errorCases\": [\n        {\n          \"scenario\": \"Artifact was substituted, expired or lost\",\n          \"detection\": \"Recompute digest and require the exact approved artifact ID and run ID.\",\n          \"response\": \"Stop; build a new candidate and qualify it locally.\",\n          \"userImpact\": \"No release is published.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Candidate cannot start after draining predecessor\",\n          \"detection\": \"Managed identity and bounded readiness checks fail.\",\n          \"response\": \"Restore the pinned predecessor only when compatibility and current lifecycle safeguards permit; otherwise retain the journal and surface recovery instructions.\",\n          \"userImpact\": \"Controlled rollback or actionable stop.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Invalid manifest, unsupported target or corrupt archive\",\n          \"detection\": \"Signature, schema, platform, sequence and digest checks precede extraction and activation.\",\n          \"response\": \"Fail closed before touching active installation.\",\n          \"userImpact\": \"Current installation remains usable.\",\n          \"recoverable\": true\n        }\n      ],\n      \"edgeCases\": [\n        {\n          \"input\": \"Two promotion attempts for one version\",\n          \"expected\": \"Serialize publication; identical already released bytes may be reported as already published, conflicting bytes fail.\"\n        },\n        {\n          \"input\": \"Archive paths or links could leave the staging directory\",\n          \"expected\": \"Reject before writing outside the private staging boundary.\"\n        },\n        {\n          \"input\": \"Migration from a dirty source checkout\",\n          \"expected\": \"Keep previous clone and existing state intact; refuse unsafe migration rather than overwriting it.\"\n        }\n      ],\n      \"invariantsToPreserve\": []\n    },\n    \"testStrategy\": {\n      \"testLevels\": [\n        {\n          \"level\": \"contract\",\n          \"purpose\": \"Verify fail-closed package trust and promotion\",\n          \"subjects\": [\n            \"Local malicious-manifest, archive entry, and digest mismatch fixtures\",\n            \"Local workflow lint and protected-input/promotion tests\"\n          ]\n        },\n        {\n          \"level\": \"live\",\n          \"purpose\": \"Qualify exact archive on a real Apple Silicon Mac\",\n          \"subjects\": [\n            \"Fresh install, clone migration with state, supervisor restart, rollback after failed upgrade\",\n            \"Verify installed runtime needs no host Git, npm or compiler\"\n          ]\n        }\n      ],\n      \"acceptanceMapping\": [\n        {\n          \"criterionId\": \"ac1\",\n          \"provingTests\": [\n            \"Local workflow lint, build metadata and no-hosted-test inspection\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac2\",\n          \"provingTests\": [\n            \"Local exact candidate lifecycle on a dedicated Mac profile\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac3\",\n          \"provingTests\": [\n            \"Local promotion mismatch and rejected archive negative tests\"\n          ]\n        }\n      ],\n      \"testFramework\": \"Local Node test runner, shell integration checks and a documented Apple Silicon qualification run. GitHub workflows build and promote; no test jobs or test commands.\"\n    },\n    \"migration\": {\n      \"stateBefore\": \"Existing source installs plus new opted-in hosts.\",\n      \"stateAfter\": \"Same daemon state and client endpoints; chosen pilot installs use a verified prebuilt release.\",\n      \"migrationSteps\": [\n        {\n          \"order\": 1,\n          \"action\": \"Stage and verify in isolation; preflight filesystem and predecessor compatibility.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 2,\n          \"action\": \"Run managed activation with journal and exact predecessor pin, retaining source checkout.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 3,\n          \"action\": \"Verify new generation via readiness and exercise restart on dedicated host; restore compatible predecessor if activation fails.\",\n          \"rollbackable\": true\n        }\n      ],\n      \"backwardCompat\": \"No state format or IPC change; supported predecessor pairs must be explicit and verified. Do not change ordinary source installs.\",\n      \"zeroDowntime\": false,\n      \"dataRewriteRequired\": false\n    },\n    \"alternativesConsidered\": [\n      {\n        \"id\": \"a1\",\n        \"name\": \"Promote a qualified candidate archive\",\n        \"oneLineSummary\": \"Promote one immutable artifact by digest.\",\n        \"approach\": \"Build once in GitHub Actions, qualify the archive locally, sign the manifest and publish those exact bytes after approval.\",\n        \"pros\": [\n          \"One test-to-release identity\",\n          \"No hosted test runs\"\n        ],\n        \"cons\": [\n          \"Requires artifact retention and an explicit approval handoff\"\n        ],\n        \"costEstimate\": \"M\"\n      },\n      {\n        \"id\": \"a2\",\n        \"name\": \"Bundle source and compile on install\",\n        \"oneLineSummary\": \"Distribute a signed source snapshot.\",\n        \"approach\": \"Keep host compilation and replace the Git checkout with a versioned signed source archive.\",\n        \"pros\": [\n          \"Mostly reuses current machinery\"\n        ],\n        \"cons\": [\n          \"Still requires a host compiler\",\n          \"Local qualification cannot cover the bytes built on another host\"\n        ],\n        \"costEstimate\": \"S\",\n        \"reasonRejected\": \"Does not deliver prebuilt runtime.\"\n      }\n    ],\n    \"chosenAlternative\": \"a1\",\n    \"openQuestions\": [],\n    \"sequenceDefinition\": {\n      \"narrative\": \"Shows the trust boundary and the exact artifact passing from build through local qualification, promotion and installation.\",\n      \"participants\": [\n        {\n          \"id\": \"build\",\n          \"label\": \"Candidate build\",\n          \"description\": \"GitHub Actions builds without signing or publish privileges\"\n        },\n        {\n          \"id\": \"local\",\n          \"label\": \"Local Mac\",\n          \"description\": \"Release operator validates this exact archive locally\"\n        },\n        {\n          \"id\": \"promote\",\n          \"label\": \"Protected promotion\",\n          \"description\": \"Verifies approval inputs and signs manifest\"\n        },\n        {\n          \"id\": \"release\",\n          \"label\": \"GitHub Release\",\n          \"description\": \"Stores the published manifest and bundle\"\n        },\n        {\n          \"id\": \"install\",\n          \"label\": \"Pilot installer\",\n          \"description\": \"Verifies download and hands staged candidate to managed lifecycle\"\n        }\n      ],\n      \"messages\": [\n        {\n          \"from\": \"build\",\n          \"to\": \"local\",\n          \"label\": \"Provide candidate run, artifact ID and digest\",\n          \"description\": \"Operator downloads and checks digest before executing tests\"\n        },\n        {\n          \"from\": \"local\",\n          \"to\": \"promote\",\n          \"label\": \"Submit qualification and approved digest\",\n          \"description\": \"Local results identify one commit, version, run, artifact and digest\"\n        },\n        {\n          \"from\": \"promote\",\n          \"to\": \"build\",\n          \"label\": \"Retrieve candidate by exact identity\",\n          \"description\": \"Promotion checks the archived bytes again and does not rebuild\"\n        },\n        {\n          \"from\": \"promote\",\n          \"to\": \"release\",\n          \"label\": \"Publish qualified bytes and signed manifest\",\n          \"description\": \"Archive and manifest correspond to the approved digest\"\n        },\n        {\n          \"from\": \"release\",\n          \"to\": \"install\",\n          \"label\": \"Deliver versioned bundle\",\n          \"description\": \"Installer verifies signature, target and digest before extraction and activation\"\n        }\n      ]\n    },\n    \"companions\": [\n      {\n        \"kind\": \"diagram-mermaid\",\n        \"relPath\": \"docs/standalone/pilot-prebuilt-macos-daemon-releases-E202611148a036e64/S001/sequence-diagram.html\",\n        \"title\": \"Sequence diagram\"\n      }\n    ]\n  },\n  \"citations\": [\n    {\n      \"id\": \"c1\",\n      \"kind\": \"code\",\n      \"ref\": \"scripts/insrc-daemon-install.sh\"\n    },\n    {\n      \"id\": \"c2\",\n      \"kind\": \"code\",\n      \"ref\": \"scripts/prepare-source-release.mjs\"\n    },\n    {\n      \"id\": \"c3\",\n      \"kind\": \"code\",\n      \"ref\": \"src/bin/insrc-release-bootstrap.ts\"\n    },\n    {\n      \"id\": \"c4\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/managed-release-staging.ts\"\n    },\n    {\n      \"id\": \"c5\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/managed-update-preparation.ts\"\n    },\n    {\n      \"id\": \"c6\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/fresh-managed-activation.ts\"\n    },\n    {\n      \"id\": \"c7\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/managed-update-handoff.ts\"\n    },\n    {\n      \"id\": \"c8\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/managed-update-recovery.ts\"\n    },\n    {\n      \"id\": \"c9\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/__tests__/managed-release-staging.test.ts\"\n    },\n    {\n      \"id\": \"c10\",\n      \"kind\": \"code\",\n      \"ref\": \".github/workflows/ci.yml\"\n    },\n    {\n      \"id\": \"c11\",\n      \"kind\": \"stakeholder\",\n      \"ref\": \"User request: run release qualification tests locally; use GitHub Actions for building, signing and publication.\"\n    }\n  ]\n}\n","document":"<!-- insrc:artifact LLD-8a036e6436ae82ab-s1 -->\n\n# LLD: STORY-8a036e6436ae82ab-s1 — Pilot prebuilt macOS daemon releases\n\n## Summary\n\n**Epic:** `pilot-prebuilt-macos-daemon-releases`\n**HLD base run:** `wf-1794638228206-o4i31o`\n**HLD effective hash:** `8a036e6436ae...`\n\nAn opt-in macOS arm64 path stages verified prebuilt bytes into the managed lifecycle. Existing source delivery remains the default. No pilot workflow runs tests on Actions.\n\n## Contents\n\n1. [HLD context](#1-hld-context)\n2. [Contract details](#2-contract-details)\n3. [Data model changes](#3-data-model-changes)\n4. [Diagrams](#4-diagrams)\n5. [Error paths](#5-error-paths)\n6. [Test strategy](#6-test-strategy)\n7. [Migration](#7-migration)\n8. [Alternatives considered](#8-alternatives-considered)\n9. [References](#9-references)\n\n## 1. HLD context\n\n**Framework:** Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\n**Rollout phase:** standalone\n\n## 2. Contract details\n\n**Surface level:** public\n\n### 2.1 `Build candidate`\n\n```typescript\ncommit SHA + version → candidate run ID, artifact ID and archive digest\n```\n\n**Returns:** `result` — Success identifies the exact artifact; failure stops the operation.\n\n**Errors:**\n- `ReleaseGate` when Invalid, inconsistent or missing evidence or incompatible target.\n\n**Preconditions:**\n- Use trusted workflow on protected branch; resolve and verify exact full commit and allowed version.\n- The build job has no signing or publishing credentials.\n\n**Postconditions:**\n- Package pinned Node 22, compiled entrypoints, required assets, production dependencies and native helper/supervisor binaries; record target and minimum macOS version.\n- Upload exactly one archive and bounded build metadata; do not execute test suites.\n\n### 2.2 `Record local qualification`\n\n```typescript\ncandidate identity + results → release qualification record\n```\n\n**Returns:** `result` — Success identifies the exact artifact; failure stops the operation.\n\n**Errors:**\n- `ReleaseGate` when Invalid, inconsistent or missing evidence or incompatible target.\n\n**Preconditions:**\n- Verify the run, artifact and SHA-256 before using the bundle on a dedicated test install.\n- Run appropriate source tests against the same commit and exact candidate install, migration, restart and rollback checks.\n\n**Postconditions:**\n- Record commit, version, platform, digest, run/artifact IDs, macOS version and pass evidence.\n\n### 2.3 `Promote candidate`\n\n```typescript\napproved qualification record → signed manifest and GitHub prerelease\n```\n\n**Returns:** `result` — Success identifies the exact artifact; failure stops the operation.\n\n**Errors:**\n- `ReleaseGate` when Invalid, inconsistent or missing evidence or incompatible target.\n\n**Preconditions:**\n- Separate protected workflow; fetch exact artifact by run and artifact ID, recompute SHA-256 and verify it against approved qualification.\n- Fail if required publish protection unavailable; no fallback to branch head, latest candidate or rebuild.\n\n**Postconditions:**\n- Sign canonical manifest and publish the exact qualified bytes as a prerelease. Fail closed on existing conflicting tag/version/assets.\n\n### 2.4 `Stage prebuilt release`\n\n```typescript\nopt-in version + trusted manifest and archive → managed candidate\n```\n\n**Returns:** `result` — Success identifies the exact artifact; failure stops the operation.\n\n**Errors:**\n- `ReleaseGate` when Invalid, inconsistent or missing evidence or incompatible target.\n\n**Preconditions:**\n- Verify project signature with pinned public trust before parsing trusted claims; verify version, platform, compatibility and archive digest before extraction.\n- Reject unsafe entries; stage in a private directory on same volume, with no writes to live state until existing lifecycle gates pass.\n\n**Postconditions:**\n- Use managed pinning, activation, health checks and recovery while retaining the previous qualified installation for safe rollback.\n\n## 3. Data model changes\n\n### 3.1 `Candidate identity` — new\n\nOne Actions build produces one archive for a commit, version and target. Local qualification and the protected promotion job both consume the same run ID, artifact ID and SHA-256.\n\n\n### 3.2 `Signed release manifest v1` — new\n\nOne release manifest declares archive name, exact size, SHA-256, commit, release version and sequence, channel, target/OS minimum, Node and compatibility metadata. Its detached project signature authenticates the manifest, which authenticates the one archive. Installed trust pins project keys; key recovery and rotation are explicit release operations.\n\n**Call sites:**\n- `src/bin/insrc-release-bootstrap.ts`\n\n## 4. Diagrams\n\n- [Sequence diagram](docs/standalone/pilot-prebuilt-macos-daemon-releases-E202611148a036e64/S001/sequence-diagram.html)\n\n## 5. Error paths\n\n**Error cases**\n\n- **Artifact was substituted, expired or lost** (recoverable)\n  - Detection: Recompute digest and require the exact approved artifact ID and run ID.\n  - Response: Stop; build a new candidate and qualify it locally.\n  - User impact: No release is published.\n- **Candidate cannot start after draining predecessor** (recoverable)\n  - Detection: Managed identity and bounded readiness checks fail.\n  - Response: Restore the pinned predecessor only when compatibility and current lifecycle safeguards permit; otherwise retain the journal and surface recovery instructions.\n  - User impact: Controlled rollback or actionable stop.\n- **Invalid manifest, unsupported target or corrupt archive** (recoverable)\n  - Detection: Signature, schema, platform, sequence and digest checks precede extraction and activation.\n  - Response: Fail closed before touching active installation.\n  - User impact: Current installation remains usable.\n\n**Edge cases**\n\n| Input | Expected |\n| :--- | :--- |\n| Two promotion attempts for one version | Serialize publication; identical already released bytes may be reported as already published, conflicting bytes fail. |\n| Archive paths or links could leave the staging directory | Reject before writing outside the private staging boundary. |\n| Migration from a dirty source checkout | Keep previous clone and existing state intact; refuse unsafe migration rather than overwriting it. |\n\n## 6. Test strategy\n\n**Test framework:** `Local Node test runner, shell integration checks and a documented Apple Silicon qualification run. GitHub workflows build and promote; no test jobs or test commands.`\n\n**Test levels**\n\n- **contract** — Verify fail-closed package trust and promotion\n  - Subjects: `Local malicious-manifest, archive entry, and digest mismatch fixtures`, `Local workflow lint and protected-input/promotion tests`\n- **live** — Qualify exact archive on a real Apple Silicon Mac\n  - Subjects: `Fresh install, clone migration with state, supervisor restart, rollback after failed upgrade`, `Verify installed runtime needs no host Git, npm or compiler`\n\n**Acceptance mapping**\n\n| Criterion | Proving tests |\n| :--- | :--- |\n| `ac1` | `Local workflow lint, build metadata and no-hosted-test inspection` |\n| `ac2` | `Local exact candidate lifecycle on a dedicated Mac profile` |\n| `ac3` | `Local promotion mismatch and rejected archive negative tests` |\n\n## 7. Migration\n\n**State before:** Existing source installs plus new opted-in hosts.\n\n**State after:** Same daemon state and client endpoints; chosen pilot installs use a verified prebuilt release.\n\n**Zero downtime:** no — **Data rewrite:** no\n\n**Steps**\n\n1. Stage and verify in isolation; preflight filesystem and predecessor compatibility. — ↩ rollbackable\n2. Run managed activation with journal and exact predecessor pin, retaining source checkout. — ↩ rollbackable\n3. Verify new generation via readiness and exercise restart on dedicated host; restore compatible predecessor if activation fails. — ↩ rollbackable\n\n**Backward compat:** No state format or IPC change; supported predecessor pairs must be explicit and verified. Do not change ordinary source installs.\n\n## 8. Alternatives considered\n\n### 8.1 a1: Promote a qualified candidate archive — **CHOSEN**\n\nPromote one immutable artifact by digest.\n\nBuild once in GitHub Actions, qualify the archive locally, sign the manifest and publish those exact bytes after approval.\n\n### 8.2 a2: Bundle source and compile on install\n\nDistribute a signed source snapshot.\n\nKeep host compilation and replace the Git checkout with a versioned signed source archive.\n\n**Rejected because:** Does not deliver prebuilt runtime.\n\n## 9. References\n\n- **[[c1]]** `code` `scripts/insrc-daemon-install.sh`\n- **[[c2]]** `code` `scripts/prepare-source-release.mjs`\n- **[[c3]]** `code` `src/bin/insrc-release-bootstrap.ts`\n- **[[c4]]** `code` `src/daemon/managed-release-staging.ts`\n- **[[c5]]** `code` `src/daemon/managed-update-preparation.ts`\n- **[[c6]]** `code` `src/daemon/fresh-managed-activation.ts`\n- **[[c7]]** `code` `src/daemon/managed-update-handoff.ts`\n- **[[c8]]** `code` `src/daemon/managed-update-recovery.ts`\n- **[[c9]]** `code` `src/daemon/__tests__/managed-release-staging.test.ts`\n- **[[c10]]** `code` `.github/workflows/ci.yml`\n- **[[c11]]** `stakeholder` `User request: run release qualification tests locally; use GitHub Actions for building, signing and publication.`\n"},"capturedAt":"2026-11-14T06:39:02.884Z"},"inventory":{"units":[{"id":"/body/summary","selector":"/body/summary","title":"summary","kind":"section"},{"id":"/body/hldContextSlice","selector":"/body/hldContextSlice","title":"hldContextSlice","kind":"section"},{"id":"/body/contractDetails","selector":"/body/contractDetails","title":"contractDetails","kind":"section"},{"id":"/body/dataModelChanges","selector":"/body/dataModelChanges","title":"dataModelChanges","kind":"section"},{"id":"/body/interactionWithShared","selector":"/body/interactionWithShared","title":"interactionWithShared","kind":"section"},{"id":"/body/errorPaths","selector":"/body/errorPaths","title":"errorPaths","kind":"section"},{"id":"/body/testStrategy","selector":"/body/testStrategy","title":"testStrategy","kind":"section"},{"id":"/body/migration","selector":"/body/migration","title":"migration","kind":"section"},{"id":"/body/alternativesConsidered","selector":"/body/alternativesConsidered","title":"alternativesConsidered","kind":"section"},{"id":"/body/chosenAlternative","selector":"/body/chosenAlternative","title":"chosenAlternative","kind":"section"},{"id":"/body/openQuestions","selector":"/body/openQuestions","title":"openQuestions","kind":"section"},{"id":"/body/sequenceDefinition","selector":"/body/sequenceDefinition","title":"sequenceDefinition","kind":"visual"},{"id":"/body/companions","selector":"/body/companions","title":"companions","kind":"visual"},{"id":"/body/alternativesConsidered/0","selector":"/body/alternativesConsidered/0","title":"a1","kind":"requirement"},{"id":"/body/alternativesConsidered/1","selector":"/body/alternativesConsidered/1","title":"a2","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/0","selector":"/body/sequenceDefinition/participants/0","title":"build","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/1","selector":"/body/sequenceDefinition/participants/1","title":"local","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/2","selector":"/body/sequenceDefinition/participants/2","title":"promote","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/3","selector":"/body/sequenceDefinition/participants/3","title":"release","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/4","selector":"/body/sequenceDefinition/participants/4","title":"install","kind":"requirement"},{"id":"/citations/0","selector":"/citations/0","title":"Citation 1","kind":"citation"},{"id":"/citations/1","selector":"/citations/1","title":"Citation 2","kind":"citation"},{"id":"/citations/2","selector":"/citations/2","title":"Citation 3","kind":"citation"},{"id":"/citations/3","selector":"/citations/3","title":"Citation 4","kind":"citation"},{"id":"/citations/4","selector":"/citations/4","title":"Citation 5","kind":"citation"},{"id":"/citations/5","selector":"/citations/5","title":"Citation 6","kind":"citation"},{"id":"/citations/6","selector":"/citations/6","title":"Citation 7","kind":"citation"},{"id":"/citations/7","selector":"/citations/7","title":"Citation 8","kind":"citation"},{"id":"/citations/8","selector":"/citations/8","title":"Citation 9","kind":"citation"},{"id":"/citations/9","selector":"/citations/9","title":"Citation 10","kind":"citation"},{"id":"/citations/10","selector":"/citations/10","title":"Citation 11","kind":"citation"},{"id":"document:line:25","selector":"document:line:25","title":"1. HLD context","kind":"section"},{"id":"document:line:121","selector":"document:line:121","title":"4. Diagrams","kind":"section"}]},"completedChunks":[{"chunkId":"release-supply","status":"incomplete","summary":"The LLD consistently describes a build → local qualification → protected promotion flow that reuses the exact candidate identity, and its stakeholder citation is reflected in the stated division of work. However, the qualification record and approval handoff lack a defined, verifiable contract, and the diagram’s actual rendering could not be verified.","findings":[{"id":"release-supply-qualification-binding","severity":"MED","location":"LLD.md §2.2–2.3, §3.1–3.2","message":"Promotion requires an “approved qualification record” and says it verifies the artifact against that approval, but the LLD specifies neither the record’s schema and trusted storage/transport nor how approval is authenticated and bound to the run ID, artifact ID, and digest. The candidate identity alone does not define evidence that the protected workflow can verify. Consequently, the central local-qualification gate is not implementable or auditable from this contract, despite the manifest’s specified signature binding the manifest to the archive.","evidenceReferences":["LLD.md §2.2: qualification returns a generic “release qualification record” and records pass evidence without defining its contract.","LLD.md §2.3: promotion consumes an “approved qualification record” and verifies against it, without specifying approval provenance or qualification-record verification.","LLD.md §3.1–3.2: candidate identity and signed manifest fields are described, but neither defines a qualification evidence or approval binding.","scripts/prepare-source-release.mjs: the existing source-release promotion contract validates concrete evidence files and their hashes against commit/tree; it does not define the new archive candidate qualification record."]}],"inspectedReferences":["/body/summary","/body/contractDetails","/body/dataModelChanges","/body/interactionWithShared","/body/sequenceDefinition/participants/0","/body/sequenceDefinition/participants/1","/body/sequenceDefinition/participants/2","/body/sequenceDefinition/participants/3","/citations/1","/citations/2","/citations/10","/Users/subhagho/work/projects/insors/insrc/docs/standalone/pilot-prebuilt-macos-daemon-releases-E202611148a036e64/S001/LLD.md","LLD.md §2.1–2.4","LLD.md §3.1–3.2","LLD.md §4–6","LLD.md §9 citations c2, c3, c11","sequence-diagram.html Mermaid source","scripts/prepare-source-release.mjs","src/bin/insrc-release-bootstrap.ts","src/daemon/managed-release-staging.ts","src/daemon/managed-update-preparation.ts",".github/workflows/ci.yml"],"limitations":["Could not verify the sequence diagram’s rendered visual; only its HTML and Mermaid source were inspected."],"advice":["Define the qualification evidence record and approval contract, including trusted provenance, immutable or authenticated transport, and explicit binding to the candidate run ID, artifact ID, and archive digest."]},{"chunkId":"install-lifecycle","status":"incomplete","summary":"The LLD recognizes the main lifecycle safeguards: opt-in staging, trust and digest checks before extraction, compatibility preflight, retained predecessor pins, and journaled activation with bounded readiness checks. However, the installation contract does not define the concrete prebuilt archive verification and extraction boundary or how its manifest compatibility metadata feeds the existing managed update and recovery contracts. The sequence companion’s rendered visual was not verified.","findings":[{"id":"install-lifecycle-prebuilt-contract","severity":"MED","location":"LLD.md §2.4, §3.2, §5, §7","message":"The stage contract promises a signed prebuilt archive will enter the managed lifecycle, but leaves the critical install-side contract underspecified: it does not say which trusted verifier validates the manifest schema, version/sequence floor and compatibility claims, how those claims become the exact predecessor/candidate pair required by managed activation, or what archive entry types and filesystem checks extraction permits. The existing managed update path is built around a qualified checkout and checks exact compatibility pairs and pinned release inventories before cutover; a new archive path needs to specify how it satisfies those same gates. Without that mapping, safe extraction, compatibility admission, and rollback cannot be implemented or audited from this LLD.","evidenceReferences":["LLD.md §2.4 only lists broad verification and staging preconditions; it does not define archive format, verifier interface, extraction rules, or metadata-to-compatibility mapping.","LLD.md §3.2 names manifest fields and detached signature but does not define parsing/sequence-floor enforcement or how compatibility metadata becomes a qualified pair.","src/daemon/managed-release-staging.ts: stageManagedRelease expects a clean checkout, qualified release profiles and exact prior/candidate compatibility, then pins runtime inventory.","src/daemon/managed-update-handoff.ts: recordManagedUpdatePins and stageManagedUpdate durably record release pins and compatibility before changing the predecessor.","src/daemon/managed-update-recovery.ts: rollback verifies pinned release inventory and restores selector, service/job, and prior generation through journaled steps.","src/bin/insrc-release-bootstrap.ts: current bootstrap authenticates source release authorization and persists sequence floors; the LLD does not specify how the new archive verifier integrates with these safeguards."]}],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/body/errorPaths","/body/migration","/body/sequenceDefinition/participants/4","/citations/0","/citations/2","/citations/3","/citations/4","/citations/5","/citations/6","/citations/7","/citations/8","/Users/subhagho/work/projects/insors/insrc/docs/standalone/pilot-prebuilt-macos-daemon-releases-E202611148a036e64/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/macos-prebuilt-8a036e64.json","LLD.md §2.4, §3.2, §5, §7","scripts/insrc-daemon-install.sh","src/bin/insrc-release-bootstrap.ts","src/daemon/managed-release-staging.ts","src/daemon/managed-update-preparation.ts","src/daemon/fresh-managed-activation.ts","src/daemon/managed-update-handoff.ts","src/daemon/managed-update-recovery.ts","src/daemon/release-compatibility.ts","src/daemon/__tests__/managed-release-staging.test.ts","sequence-diagram.html Mermaid source"],"limitations":["Could not verify the sequence diagram’s rendered visual; only the HTML companion/source was inspected."],"advice":["Specify the archive format and exact validation/extraction rules, identify the verifier and trust/sequence-floor boundary, map manifest compatibility claims into the existing qualified predecessor/candidate and pin contracts, and state which journaled activation and recovery path handles the staged release."]},{"chunkId":"verification-and-design-evidence","status":"incomplete","summary":"The test strategy and alternatives support the chosen build-once, locally qualified candidate flow, but the security and lifecycle claims are not mapped to sufficiently specific negative tests. The sequence companion source matches the stated flow, but I could not verify its rendered diagram.","findings":[{"id":"verification-negative-case-coverage","severity":"MED","location":"LLD.md §5–6, especially the ac3 acceptance mapping","message":"The LLD claims signature, schema, target, sequence, digest, and unsafe-entry checks, but the test plan names only general malicious-manifest, archive-entry, and digest-mismatch fixtures. It does not identify evidence for signature tampering, unsupported targets, sequence rollback/replay, or traversal and link entries. The broad ac3 mapping (“promotion mismatch and rejected archive negative tests”) does not show that these distinct fail-closed conditions are covered, leaving key security acceptance claims without traceable proof.","evidenceReferences":["LLD.md §5: invalid-manifest error handling claims signature, schema, platform, sequence, and digest checks before extraction.","LLD.md §5 edge cases: archive paths or links leaving staging must be rejected.","LLD.md §6 contract subjects name general malicious-manifest, archive-entry, and digest-mismatch fixtures without enumerating those cases.","LLD.md §6 acceptance mapping for ac3 names only general promotion-mismatch and rejected-archive negative tests."]}],"inspectedReferences":["/body/testStrategy","/body/alternativesConsidered","/body/chosenAlternative","/body/openQuestions","/body/sequenceDefinition","/body/companions","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/sequenceDefinition/participants/0","/body/sequenceDefinition/participants/1","/body/sequenceDefinition/participants/2","/body/sequenceDefinition/participants/3","/body/sequenceDefinition/participants/4","/citations/9","document:line:121","/Users/subhagho/work/projects/insors/insrc/docs/standalone/pilot-prebuilt-macos-daemon-releases-E202611148a036e64/S001/LLD.md","LLD.md §5–6","sequence-diagram.html Mermaid source",".github/workflows/ci.yml","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-8a036e6436ae82ab-s1.json"],"limitations":["Could not verify the sequence diagram’s rendered visual; I inspected its HTML and Mermaid source only."],"advice":["List concrete qualification and rejection cases under the test subjects and map each security and lifecycle claim to its proving test. The alternatives and chosen approach are consistent with the stakeholder constraint to qualify locally and publish the exact candidate."]},{"chunkId":"standalone-scope-and-repository-fit","status":"incomplete","summary":"The LLD keeps the opt-in prebuilt path distinct from the existing source installer, but its acceptance mapping is not traceable to stated criteria, and its declared bootstrap call site currently handles signed source releases rather than prebuilt archives. The sequence diagram’s rendering could not be verified, so this review is incomplete.","findings":[{"id":"standalone-acceptance-traceability","severity":"MED","location":"LLD §6, Acceptance mapping","message":"The mapping uses ac1–ac3 without defining their acceptance text in the LLD or the captured scope. The cited stakeholder request specifies local qualification and GitHub-based build/sign/publication, but does not define these three criteria. As written, reviewers cannot determine whether each criterion is fully covered by its listed proving tests or whether requirements are omitted.","evidenceReferences":["LLD §6: acceptance mapping lists ac1–ac3 with test names but no criterion text","Canonical artifact body.testStrategy.acceptanceMapping","Canonical artifact citations[10]: stakeholder request states release qualification is local and GitHub Actions handles build, signing, and publication"]},{"id":"bootstrap-callsite-source-prebuilt-mismatch","severity":"MED","location":"LLD §3.2, Signed release manifest v1 — Call sites","message":"The only declared call site, `src/bin/insrc-release-bootstrap.ts`, currently authenticates a signed Git source-release tag and authorizes a Git checkout. It does not verify a detached signature over an archive manifest or validate/extract a prebuilt archive. The design should specify how this call site will support the new archive contract, or identify a prebuilt-specific entry point, so the proposed manifest contract does not appear to be implemented by an incompatible existing bootstrap.","evidenceReferences":["LLD §3.2: manifest claims a detached project signature over archive metadata and names `src/bin/insrc-release-bootstrap.ts` as its call site","src/bin/insrc-release-bootstrap.ts:11, 99–151 — source-release verifier, signed Git tag, candidate branch head, and source-release receipt","src/bin/insrc-release-bootstrap.ts:154–160 — checks out the authorized source release"]},{"id":"standalone-hld-provenance-conflict","severity":"LOW","location":"LLD Summary and §1 HLD context","message":"The document gives an HLD base run and effective hash in its summary, while §1 says this standalone feature has no parent HLD and no shared HLD contracts. Clarify whether those values are workflow provenance or an upstream design reference; the current wording makes the standalone context difficult to trace.","evidenceReferences":["LLD Summary: HLD base run `wf-1794638228206-o4i31o` and effective hash","LLD §1: “Standalone feature — no parent HLD.”","Canonical artifact meta: `standalone: true` with populated `hldBaseRunId` and `hldEffectiveHash`"]}],"inspectedReferences":["/body/hldContextSlice","document:line:25","/citations/0","/citations/1","/citations/2","/citations/3","/citations/4","/citations/5","/citations/6","/citations/7","/citations/8","/citations/9","/citations/10","/Users/subhagho/work/projects/insors/insrc/docs/standalone/pilot-prebuilt-macos-daemon-releases-E202611148a036e64/S001/LLD.md","docs/standalone/pilot-prebuilt-macos-daemon-releases-E202611148a036e64/S001/LLD.md","scripts/insrc-daemon-install.sh","scripts/prepare-source-release.mjs","src/bin/insrc-release-bootstrap.ts","src/daemon/managed-release-staging.ts","src/daemon/managed-update-preparation.ts","src/daemon/fresh-managed-activation.ts","src/daemon/managed-update-handoff.ts","src/daemon/managed-update-recovery.ts","src/daemon/__tests__/managed-release-staging.test.ts",".github/workflows/ci.yml","docs/standalone/pilot-prebuilt-macos-daemon-releases-E202611148a036e64/S001/sequence-diagram.html","README.md","docs/daemon.md","package.json",".insrc/artifacts/LLD-8a036e6436ae82ab-s1.json",".insrc/tmp/design-review/macos-prebuilt-8a036e64.json"],"limitations":["The sequence diagram HTML was inspected as source, but the browser access host was unavailable, so its rendered appearance and layout could not be verified."],"advice":[]},{"chunkId":"final-consistency","status":"incomplete","summary":"The LLD and sequence source describe the same broad build → local qualification → protected promotion → opt-in installation flow. The cross-chunk gaps already identified remain material: the qualification approval is not bound by a defined verifiable contract, and the archive verification and compatibility claims are not mapped into the managed lifecycle. I could not verify the sequence diagram’s rendered appearance.","findings":[],"inspectedReferences":["/Users/subhagho/work/projects/insors/insrc/docs/standalone/pilot-prebuilt-macos-daemon-releases-E202611148a036e64/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/macos-prebuilt-8a036e64.json","LLD.md §2–7","docs/standalone/pilot-prebuilt-macos-daemon-releases-E202611148a036e64/S001/sequence-diagram.html: Mermaid sequence source","src/bin/insrc-release-bootstrap.ts","src/daemon/release-compatibility.ts","src/daemon/managed-release-staging.ts"],"limitations":["The sequence diagram’s rendered appearance and layout could not be verified; only its HTML and Mermaid source were inspected."],"advice":["See the existing findings `release-supply-qualification-binding`, `install-lifecycle-prebuilt-contract`, `verification-negative-case-coverage`, `standalone-acceptance-traceability`, and `bootstrap-callsite-source-prebuilt-mismatch`; this consistency pass found no separate issue to add."]}],"progress":{"status":"incomplete","phase":"complete","completedChunks":5,"totalChunks":5,"lastMeaningfulActivityAt":null,"activeToolCount":0,"requiresUserInput":false,"checkpointPath":"/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/macos-prebuilt-8a036e64.json","sequence":0,"reviewElapsedMs":0,"unitElapsedMs":null,"observedAt":"2026-11-14T06:45:51.873Z","freshness":"stored"},"startedAt":"2026-11-14T06:39:02.843Z","reviewer":"daemon","model":"gpt-6-luna","unit":{"unitId":"final-consistency","phase":"chunk_review","executionId":"ec97a4e6-1c47-4b12-b9ec-ebafeafed586","dispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[]},"plan":{"chunks":[{"id":"release-supply","title":"Candidate build, qualification, and promotion contracts","selectors":["/body/summary","/body/contractDetails","/body/dataModelChanges","/body/interactionWithShared","/body/sequenceDefinition/participants/0","/body/sequenceD