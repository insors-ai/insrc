84716	{"artifactId":"LLD-97adabf6bd47b036-s1","entry":{"id":"d4eea071523c144a0ccf9d24c089e9ef0c8958710d381171a36ec8473c0d418c","targetHeadHash":"cb695374b8d91b83be8c200b82fb2c1018fa75b2eefe5a6f22325d87efc0d4d6","actor":{"id":"agent:design-review-daemon","kind":"agent","properties":{"party":"daemon"}},"timestamp":"2026-11-09T16:53:00.115Z","operation":"review","revision":{"number":1,"contentHash":"a6954ba4f6bc63f3eb1f03f50750573fbffd49db85ecb2d6b0ff440ef849dd03"},"outcome":{"result":"block","summary":"Design review catalog-model-effort-lld-97adabf6 attempt 1","data":{"kind":"design-chunk-review","schemaVersion":1,"reviewId":"catalog-model-effort-lld-97adabf6","project":"/Users/subhagho/work/projects/insors/insrc","artifactId":"LLD-97adabf6bd47b036-s1","subject":{"project":"/Users/subhagho/work/projects/insors/insrc","artifactId":"LLD-97adabf6bd47b036-s1","kind":"LLD","canonicalPath":"/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-97adabf6bd47b036-s1.json","documentPath":"/Users/subhagho/work/projects/insors/insrc/docs/standalone/apply-catalog-model-effort-choices-daemon-E2026110997adabf6/S001/LLD.md","reviewer":"daemon","workflow":{"kind":"issue","rootArtifactId":"ISSUE-97adabf6bd47b036","requiredReferences":[{"role":"originating_issue","artifactId":"ISSUE-97adabf6bd47b036","path":"/Users/subhagho/work/projects/insors/insrc/docs/standalone/apply-catalog-model-effort-choices-daemon-E2026110997adabf6/ISSUE.md"}],"availableReferences":[],"notApplicableRoles":["PLAN","TASKS","BUILD","CR","DEF","HLD","sibling_stories"]}},"submitted":{"artifactPath":"/Users/subhagho/work/projects/insors/insrc/docs/standalone/apply-catalog-model-effort-choices-daemon-E2026110997adabf6/S001/LLD.md","attempt":1},"reviewer":"daemon","attempts":[{"number":1,"status":"incomplete","preparationKind":"planning","baseline":{"subjectFingerprints":{"canonical":"55babfb862528f3fd7bf8127ac3bf0fd232e5afc6662a80a41db186ab48ff906","document":"a6b27c2eebb5df6ba6f5c64ded7b5aa9ceef115c3aa19455b44f6854403d4e9c"},"contentIdentity":"67346643855c882010518f215c6f5d5bf9a48133ba66514151dcc83c2ec37cbf","reviewedContent":{"canonical":"{\n  \"meta\": {\n    \"workflow\": \"design.story\",\n    \"runId\": \"wf-1794242207248-a8o0ow\",\n    \"repoPath\": \"/Users/subhagho/work/projects/insors/insrc\",\n    \"createdAt\": \"2026-11-09T16:40:54.831Z\",\n    \"epicCreatedAt\": \"2026-11-09T16:34:12.401Z\",\n    \"attribution\": {\n      \"outputs\": [\n        {\n          \"role\": \"(client)\",\n          \"tier\": \"core\",\n          \"runner\": \"cli-codex\",\n          \"model\": \"unknown\"\n        }\n      ]\n    },\n    \"elapsedMs\": 246931,\n    \"repoIndexedAt\": null,\n    \"schemaVersion\": 1,\n    \"epicHash\": \"97adabf6bd47b036\",\n    \"epicSlug\": \"apply-catalog-model-effort-choices-daemon\",\n    \"storyId\": \"s1\",\n    \"hldBaseRunId\": \"wf-1794242207248-a8o0ow\",\n    \"hldEffectiveHash\": \"ee344877596b3291c33121f352169db6e38d0842dd80db098328a7ee7d358a21\",\n    \"hldAmendmentsApplied\": [],\n    \"storyTitle\": \"Apply catalog model and effort choices in daemon and VS Code\",\n    \"standalone\": true,\n    \"authoredBy\": \"controller\",\n    \"revision\": 1\n  },\n  \"body\": {\n    \"hldContextSlice\": {\n      \"frameworkSummary\": \"Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\",\n      \"ownedContracts\": [],\n      \"consumedContracts\": [],\n      \"boundary\": {\n        \"storyId\": \"s1\",\n        \"owns\": [],\n        \"depends\": [],\n        \"internal\": \"Apply catalog model and effort choices in daemon and VS Code\"\n      },\n      \"adjacentBoundaries\": [],\n      \"rolloutPhase\": \"standalone\",\n      \"nonFunctional\": {}\n    },\n    \"summary\": {\n      \"prose\": \"Apply catalog-backed selections at the Vibe session boundary and recover the VS Code chat picker when the daemon catalog becomes available.\",\n      \"audience\": \"technical\"\n    },\n    \"contractDetails\": {\n      \"surfaceLevel\": \"internal-shared\",\n      \"api\": [\n        {\n          \"name\": \"Vibe session launch\",\n          \"signature\": \"runVibeSession(request: VibeRunRequest, transport: VibeSessionTransport): Promise<VibeRunResult>\",\n          \"parameters\": [\n            {\n              \"name\": \"request\",\n              \"type\": \"VibeRunRequest\",\n              \"purpose\": \"Existing prompt, working directory, permissions, attachments, native session, optional model and effort, and cancellation.\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"transport\",\n              \"type\": \"VibeSessionTransport\",\n              \"purpose\": \"Caller-owned local process adapter for the installed Vibe app-server binary.\",\n              \"optional\": false\n            }\n          ],\n          \"returns\": {\n            \"type\": \"Promise<VibeRunResult>\",\n            \"meaning\": \"Verified effective selection, native session identity, and the same bounded events and outcome each caller consumes.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"selection-unavailable\",\n              \"condition\": \"Local protocol lacks a required capability, a catalog model cannot be mapped to an unambiguous allowed alias, or the runtime does not confirm the requested choice.\"\n            },\n            {\n              \"type\": \"launch-failed\",\n              \"condition\": \"Process startup, authentication, protocol, timeout, or tool-scope parity fails.\"\n            }\n          ],\n          \"preconditions\": [\n            \"Catalog models and effort levels remain sourced from models.definitions and the daemon registry. Discovery is limited to the local Vibe session and never grants access to a model absent from the catalog.\",\n            \"Explicit choices use the app-server path. Default-only invocations retain the existing headless behavior. Preserve the caller's existing working directory, tool approvals, attachment access, budgets, and abort signal.\"\n          ],\n          \"postconditions\": [\n            \"Use one local process and at most one Vibe session per invocation. Start a new session or resume the supplied native ID without sending the prompt. Resolve catalog ID and aliases against the session's model choices, apply config/model/write with session_only true, and verify runtime model and effort before turn/start. A default model with explicit effort uses the verified effective model and its catalog levels.\",\n            \"Model aliases are accepted only when they resolve to the intended catalog ID. A returned failure, policy rejection, or mismatched effective selection stops before prompt delivery. Existing CLI credentials and configuration files are preserved.\",\n            \"Translate bounded native events into current daemon and VS Code outputs, including text, reasoning, tool activity and session identity. Preserve resume identity. Cancel or time out the owned turn and child, and distinguish failure after dispatch from a safe pre-dispatch refusal. Never replay an uncertain prompt.\"\n          ]\n        },\n        {\n          \"name\": \"Chat catalog refresh and selection\",\n          \"signature\": \"refreshRunCatalog(): Promise<void>; reconcileRunConfig(next: RunConfig, catalog: RunCatalog): RunConfig\",\n          \"parameters\": [\n            {\n              \"name\": \"next\",\n              \"type\": \"RunConfig\",\n              \"purpose\": \"Proposed session provider, model and effort.\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"catalog\",\n              \"type\": \"RunCatalog\",\n              \"purpose\": \"Latest valid daemon definitions projected onto available chat providers.\",\n              \"optional\": false\n            }\n          ],\n          \"returns\": {\n            \"type\": \"RunConfig\",\n            \"meaning\": \"A selection whose effort is supported by the selected model, or its default effort.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"catalog-unavailable\",\n              \"condition\": \"The daemon is disconnected or fails its catalog request.\"\n            }\n          ],\n          \"preconditions\": [\n            \"Provider discovery remains based on locally available chat adapters. Daemon tier settings retain their existing config gateway and model validation.\"\n          ],\n          \"postconditions\": [\n            \"Coalesce concurrent catalog refreshes. Retry after reconnect or reopening the picker. Preserve the last valid catalog during transient failures and display a loading or unavailable state when there is no catalog. Ignore late or disposed responses.\",\n            \"Commit model and effort together. Retain the old effort only when the selected catalog model allows it. Show default as the only effort until a specific model is known. Preserve existing persisted chat selection until a valid catalog can evaluate it, and keep session identity, transcript, and in-flight turns intact.\"\n          ]\n        }\n      ]\n    },\n    \"dataModelChanges\": [\n      {\n        \"entity\": \"VibeRunRequest and effective selection\",\n        \"change\": \"new\",\n        \"details\": \"Transient one-to-one ownership from a daemon run or VS Code turn to an owned Vibe process and session. A resumed session is referenced by its existing native ID. The returned model and effort confirm the request before dispatch. Credentials and existing saved settings stay in Vibe.\",\n        \"callSites\": [\n          \"src/agent/providers/cli-provider.ts\",\n          \"vscode-plugin/src/chat/cli-adapter.ts\"\n        ]\n      },\n      {\n        \"entity\": \"VS Code chat run configuration\",\n        \"change\": \"invariant-change\",\n        \"details\": \"One session retains a provider, optional catalog model and optional supported effort. Many sessions can read the same in-memory catalog projection. Existing persisted fields and wire messages remain compatible.\",\n        \"callSites\": [\n          \"vscode-plugin/src/chat/chat-panel.ts\",\n          \"vscode-plugin/src/extension.ts\"\n        ]\n      }\n    ],\n    \"interactionWithShared\": [],\n    \"errorPaths\": {\n      \"errorCases\": [\n        {\n          \"scenario\": \"Catalog fetch fails or the daemon reconnects during a fetch\",\n          \"detection\": \"Read rejects, times out, or returns for an obsolete refresh generation.\",\n          \"response\": \"Keep the last valid catalog if present, expose unavailable state otherwise, and retry on reconnect or picker open.\",\n          \"userImpact\": \"Model choices return without reopening the chat.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Vibe lacks a required method or cannot apply the selected model or effort\",\n          \"detection\": \"Capability negotiation, a negative mutation response, or read-back differs from the requested selection.\",\n          \"response\": \"Stop before submitting the prompt and surface a concise error that names the unsupported choice. Do not use an implicit default for an explicit selection.\",\n          \"userImpact\": \"The user can choose an available value or clear the override without losing the chat.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Vibe process exits or times out during an accepted turn\",\n          \"detection\": \"Transport closes, terminal event reports failure, or the owned deadline expires.\",\n          \"response\": \"Report the existing caller-specific failure, release the child, preserve received output and session identity, and avoid replay.\",\n          \"userImpact\": \"The user can inspect partial output and decide whether to retry.\",\n          \"recoverable\": true\n        }\n      ],\n      \"edgeCases\": [\n        {\n          \"input\": \"Model changes from a high-effort choice to a model offering no effort choices\",\n          \"expected\": \"Persist the new model with default effort in one update.\"\n        },\n        {\n          \"input\": \"A saved model and effort are restored while the catalog is unavailable\",\n          \"expected\": \"Preserve the saved selection and defer validation until a successful refresh.\"\n        },\n        {\n          \"input\": \"No explicit model or effort was chosen\",\n          \"expected\": \"Preserve the existing headless defaults and output path.\"\n        },\n        {\n          \"input\": \"Existing Vibe session resumes with a supported selection different from its prior settings\",\n          \"expected\": \"Confirm the selection in that session before starting its next turn. Preserve native session identity and caller policy.\"\n        }\n      ],\n      \"invariantsToPreserve\": [\n        {\n          \"text\": \"Daemon tiers and VS Code read model and effort definitions from the existing catalog projection.\",\n          \"source\": \"c1\"\n        },\n        {\n          \"text\": \"Existing run paths retain their prompt, provider authentication, policy, session resume, and cancellation behavior.\",\n          \"source\": \"c1\"\n        }\n      ]\n    },\n    \"testStrategy\": {\n      \"testLevels\": [\n        {\n          \"level\": \"unit\",\n          \"purpose\": \"Protect catalog lifecycle and model-specific selection.\",\n          \"subjects\": [\n            \"Chat recovers from a failed catalog request without losing session state\",\n            \"Chat validates effort on model switch and session restore\"\n          ]\n        },\n        {\n          \"level\": \"integration\",\n          \"purpose\": \"Qualify both existing execution entry points with a fake Vibe process and verify preflight, output and cleanup.\",\n          \"subjects\": [\n            \"Daemon and chat apply verified Vibe model and effort to new and resumed turns\",\n            \"Vibe preflight failures never submit or replay the prompt\",\n            \"Vibe protocol path preserves caller permissions, attachments, and terminal output\"\n          ],\n          \"fixturesNeeded\": [\n            \"Scripted local app-server protocol fixture with capability, configuration, event, and cancellation cases.\"\n          ]\n        },\n        {\n          \"level\": \"smoke\",\n          \"purpose\": \"Check the installed CLI contract using an isolated session with no cloud prompt.\",\n          \"subjects\": [\n            \"Installed Vibe confirms a session-only model and effort without changing saved configuration\"\n          ]\n        }\n      ],\n      \"acceptanceMapping\": [\n        {\n          \"criterionId\": \"ac1\",\n          \"provingTests\": [\n            \"Daemon and chat apply verified Vibe model and effort to new and resumed turns\",\n            \"Installed Vibe confirms a session-only model and effort without changing saved configuration\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac2\",\n          \"provingTests\": [\n            \"Chat recovers from a failed catalog request without losing session state\",\n            \"Chat validates effort on model switch and session restore\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac3\",\n          \"provingTests\": [\n            \"Vibe preflight failures never submit or replay the prompt\",\n            \"Vibe protocol path preserves caller permissions, attachments, and terminal output\"\n          ]\n        }\n      ],\n      \"testFramework\": \"Node test runner with tsx, injected fake child process and chat panel fixtures.\"\n    },\n    \"migration\": {\n      \"stateBefore\": \"The s1 structural-map bundle identified the existing catalog RPC, two Vibe launch paths, and VS Code chat's one-shot catalog and independent selection fields.\",\n      \"stateAfter\": \"The same catalog drives validated choices. Explicit Vibe selections use verified session-only settings, and a chat can recover its catalog after a daemon reconnect.\",\n      \"migrationSteps\": [\n        {\n          \"order\": 1,\n          \"action\": \"Qualify the local Vibe protocol and execution policy parity. Deploy the daemon and VS Code builds with shared selection handling and typed preflight failures.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 2,\n          \"action\": \"Reload the VS Code extension and restart the daemon through normal release operations when the build is installed. Retain existing model tier and chat records.\",\n          \"rollbackable\": true\n        }\n      ],\n      \"backwardCompat\": \"Existing catalog RPC and saved config shapes remain valid. Older Vibe builds retain the default headless path and report unsupported explicit choices if session-only settings cannot be verified. A mixed daemon and extension release uses the same existing catalog wire shape. Rollback restores the prior selection behavior without migrating data.\",\n      \"zeroDowntime\": false,\n      \"dataRewriteRequired\": false\n    },\n    \"alternativesConsidered\": [\n      {\n        \"id\": \"a1\",\n        \"name\": \"Session-only Vibe settings\",\n        \"oneLineSummary\": \"Apply explicit effort through the local Vibe app server and retain the headless path for default settings.\",\n        \"approach\": \"Reuse the served catalog and current execution adapters. Use the local Vibe session API for explicit model and effort overrides, verify the effective settings before sending a prompt, and keep the chat catalog retry and selection validation in the host.\",\n        \"pros\": [\n          \"Uses the installed protocol's session-only setting for new and resumed sessions.\",\n          \"Preserves CLI authentication and user and project defaults.\"\n        ],\n        \"cons\": [\n          \"Requires a bounded protocol adapter and event parity tests for both callers.\"\n        ],\n        \"costEstimate\": \"M\"\n      },\n      {\n        \"id\": \"a2\",\n        \"name\": \"Child environment configuration\",\n        \"oneLineSummary\": \"Pass model and effort through a child-process Vibe configuration layer.\",\n        \"approach\": \"Keep the headless adapter and use Vibe's environment configuration for the selected model and per-model thinking value. Use the same chat picker validation and reload behavior.\",\n        \"pros\": [\n          \"Keeps the existing headless output and cancellation mapping.\"\n        ],\n        \"cons\": [\n          \"Vibe validates model environment entries as complete model records. Reconstructing them risks changing unrelated provider settings, and resumed sessions may keep a higher-precedence setting.\"\n        ],\n        \"costEstimate\": \"M\",\n        \"reasonRejected\": \"The sparse environment route cannot reliably preserve complete model settings or precedence on resume.\"\n      }\n    ],\n    \"chosenAlternative\": \"a1\",\n    \"openQuestions\": [],\n    \"sequenceDefinition\": {\n      \"id\": \"catalog-model-selection\",\n      \"narrative\": \"The two execution callers apply and verify a Vibe session override before dispatching a prompt. The chat picker refreshes the existing catalog and reconciles the selected effort.\",\n      \"participants\": [\n        {\n          \"id\": \"chat\",\n          \"label\": \"VS Code chat host\",\n          \"description\": \"Owns picker state and sends a validated run selection.\"\n        },\n        {\n          \"id\": \"daemon\",\n          \"label\": \"Daemon and model catalog\",\n          \"description\": \"Serves the catalog and resolves the daemon's selected tier.\"\n        },\n        {\n          \"id\": \"adapter\",\n          \"label\": \"Local Vibe session adapter\",\n          \"description\": \"Owns a local child and gates prompt dispatch on verified settings.\"\n        },\n        {\n          \"id\": \"vibe\",\n          \"label\": \"Installed Vibe app server\",\n          \"description\": \"Opens or resumes a session and applies local session-only settings.\"\n        }\n      ],\n      \"messages\": [\n        {\n          \"from\": \"chat\",\n          \"to\": \"daemon\",\n          \"label\": \"Read models.definitions\",\n          \"description\": \"Read the catalog when opening the picker or reconnecting.\"\n        },\n        {\n          \"from\": \"daemon\",\n          \"to\": \"chat\",\n          \"label\": \"Catalog or recoverable error\",\n          \"kind\": \"return\",\n          \"description\": \"Keep a last valid catalog and retry if the request fails.\"\n        },\n        {\n          \"from\": \"chat\",\n          \"to\": \"adapter\",\n          \"label\": \"Start selected chat turn\",\n          \"description\": \"Pass the model, allowed effort, resume identity and existing execution policy.\"\n        },\n        {\n          \"from\": \"daemon\",\n          \"to\": \"adapter\",\n          \"label\": \"Start selected daemon run\",\n          \"description\": \"The alternate caller passes the resolved tier and its existing run policy.\"\n        },\n        {\n          \"from\": \"adapter\",\n          \"to\": \"vibe\",\n          \"label\": \"Open or resume without a prompt\",\n          \"description\": \"Negotiate capabilities and obtain the local session identity.\"\n        },\n        {\n          \"from\": \"adapter\",\n          \"to\": \"vibe\",\n          \"label\": \"Apply and verify session-only model and effort\",\n          \"description\": \"Resolve the catalog alias and verify the active model and effort before any turn.\"\n        },\n        {\n          \"from\": \"vibe\",\n          \"to\": \"adapter\",\n          \"label\": \"Effective selection or rejection\",\n          \"kind\": \"return\",\n          \"description\": \"A rejection stops the adapter before it sends the prompt.\"\n        },\n        {\n          \"from\": \"adapter\",\n          \"to\": \"vibe\",\n          \"label\": \"Start turn once\",\n          \"description\": \"Dispatch only after effective values match and existing execution policy is applied.\"\n        },\n        {\n          \"from\": \"vibe\",\n          \"to\": \"adapter\",\n          \"label\": \"Bounded events and terminal outcome\",\n          \"kind\": \"return\",\n          \"description\": \"Preserve existing caller outputs and cancellation semantics.\"\n        }\n      ]\n    },\n    \"companions\": [\n      {\n        \"kind\": \"diagram-mermaid\",\n        \"relPath\": \"docs/standalone/apply-catalog-model-effort-choices-daemon-E2026110997adabf6/S001/sequence-diagram.html\",\n        \"title\": \"Sequence diagram\"\n      }\n    ]\n  },\n  \"citations\": [\n    {\n      \"id\": \"c1\",\n      \"kind\": \"analyze-bundle\",\n      \"ref\": \"s1:structural-map\"\n    },\n    {\n      \"id\": \"c2\",\n      \"kind\": \"prior-artifact\",\n      \"ref\": \"docs/standalone/apply-catalog-model-effort-choices-daemon-E2026110997adabf6/ISSUE.md\"\n    },\n    {\n      \"id\": \"c3\",\n      \"kind\": \"code\",\n      \"ref\": \"src/assets/models/cloud-model-catalog.json\"\n    },\n    {\n      \"id\": \"c4\",\n      \"kind\": \"doc\",\n      \"ref\": \"https://docs.mistral.ai/vibe/code/cli/work-with-cli\"\n    },\n    {\n      \"id\": \"c5\",\n      \"kind\": \"doc\",\n      \"ref\": \"https://docs.mistral.ai/vibe/code/cli/configuration-reference\"\n    },\n    {\n      \"id\": \"c6\",\n      \"kind\": \"code\",\n      \"ref\": \"/Users/subhagho/.local/share/uv/tools/mistral-vibe/lib/python3.14/site-packages/vibe/app_server/protocol.py\"\n    }\n  ]\n}\n","document":"<!-- insrc:artifact LLD-97adabf6bd47b036-s1 -->\n\n# LLD: STORY-97adabf6bd47b036-s1 — Apply catalog model and effort choices in daemon and VS Code\n\n## Summary\n\n**Epic:** `apply-catalog-model-effort-choices-daemon`\n**HLD base run:** `wf-1794242207248-a8o0ow`\n**HLD effective hash:** `ee344877596b...`\n\nApply catalog-backed selections at the Vibe session boundary and recover the VS Code chat picker when the daemon catalog becomes available.\n\n## Contents\n\n1. [HLD context](#1-hld-context)\n2. [Contract details](#2-contract-details)\n3. [Data model changes](#3-data-model-changes)\n4. [Diagrams](#4-diagrams)\n5. [Error paths](#5-error-paths)\n6. [Test strategy](#6-test-strategy)\n7. [Migration](#7-migration)\n8. [Alternatives considered](#8-alternatives-considered)\n9. [References](#9-references)\n\n## 1. HLD context\n\n**Framework:** Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\n**Rollout phase:** standalone\n\n## 2. Contract details\n\n**Surface level:** internal-shared\n\n### 2.1 `Vibe session launch`\n\n```typescript\nrunVibeSession(request: VibeRunRequest, transport: VibeSessionTransport): Promise<VibeRunResult>\n```\n\n**Parameters:**\n- `request: VibeRunRequest` — Existing prompt, working directory, permissions, attachments, native session, optional model and effort, and cancellation.\n- `transport: VibeSessionTransport` — Caller-owned local process adapter for the installed Vibe app-server binary.\n\n**Returns:** `Promise<VibeRunResult>` — Verified effective selection, native session identity, and the same bounded events and outcome each caller consumes.\n\n**Errors:**\n- `selection-unavailable` when Local protocol lacks a required capability, a catalog model cannot be mapped to an unambiguous allowed alias, or the runtime does not confirm the requested choice.\n- `launch-failed` when Process startup, authentication, protocol, timeout, or tool-scope parity fails.\n\n**Preconditions:**\n- Catalog models and effort levels remain sourced from models.definitions and the daemon registry. Discovery is limited to the local Vibe session and never grants access to a model absent from the catalog.\n- Explicit choices use the app-server path. Default-only invocations retain the existing headless behavior. Preserve the caller's existing working directory, tool approvals, attachment access, budgets, and abort signal.\n\n**Postconditions:**\n- Use one local process and at most one Vibe session per invocation. Start a new session or resume the supplied native ID without sending the prompt. Resolve catalog ID and aliases against the session's model choices, apply config/model/write with session_only true, and verify runtime model and effort before turn/start. A default model with explicit effort uses the verified effective model and its catalog levels.\n- Model aliases are accepted only when they resolve to the intended catalog ID. A returned failure, policy rejection, or mismatched effective selection stops before prompt delivery. Existing CLI credentials and configuration files are preserved.\n- Translate bounded native events into current daemon and VS Code outputs, including text, reasoning, tool activity and session identity. Preserve resume identity. Cancel or time out the owned turn and child, and distinguish failure after dispatch from a safe pre-dispatch refusal. Never replay an uncertain prompt.\n\n### 2.2 `Chat catalog refresh and selection`\n\n```typescript\nrefreshRunCatalog(): Promise<void>; reconcileRunConfig(next: RunConfig, catalog: RunCatalog): RunConfig\n```\n\n**Parameters:**\n- `next: RunConfig` — Proposed session provider, model and effort.\n- `catalog: RunCatalog` — Latest valid daemon definitions projected onto available chat providers.\n\n**Returns:** `RunConfig` — A selection whose effort is supported by the selected model, or its default effort.\n\n**Errors:**\n- `catalog-unavailable` when The daemon is disconnected or fails its catalog request.\n\n**Preconditions:**\n- Provider discovery remains based on locally available chat adapters. Daemon tier settings retain their existing config gateway and model validation.\n\n**Postconditions:**\n- Coalesce concurrent catalog refreshes. Retry after reconnect or reopening the picker. Preserve the last valid catalog during transient failures and display a loading or unavailable state when there is no catalog. Ignore late or disposed responses.\n- Commit model and effort together. Retain the old effort only when the selected catalog model allows it. Show default as the only effort until a specific model is known. Preserve existing persisted chat selection until a valid catalog can evaluate it, and keep session identity, transcript, and in-flight turns intact.\n\n## 3. Data model changes\n\n### 3.1 `VibeRunRequest and effective selection` — new\n\nTransient one-to-one ownership from a daemon run or VS Code turn to an owned Vibe process and session. A resumed session is referenced by its existing native ID. The returned model and effort confirm the request before dispatch. Credentials and existing saved settings stay in Vibe.\n\n**Call sites:**\n- `src/agent/providers/cli-provider.ts`\n- `vscode-plugin/src/chat/cli-adapter.ts`\n\n### 3.2 `VS Code chat run configuration` — invariant-change\n\nOne session retains a provider, optional catalog model and optional supported effort. Many sessions can read the same in-memory catalog projection. Existing persisted fields and wire messages remain compatible.\n\n**Call sites:**\n- `vscode-plugin/src/chat/chat-panel.ts`\n- `vscode-plugin/src/extension.ts`\n\n## 4. Diagrams\n\n- [Sequence diagram](docs/standalone/apply-catalog-model-effort-choices-daemon-E2026110997adabf6/S001/sequence-diagram.html)\n\n## 5. Error paths\n\n**Error cases**\n\n- **Catalog fetch fails or the daemon reconnects during a fetch** (recoverable)\n  - Detection: Read rejects, times out, or returns for an obsolete refresh generation.\n  - Response: Keep the last valid catalog if present, expose unavailable state otherwise, and retry on reconnect or picker open.\n  - User impact: Model choices return without reopening the chat.\n- **Vibe lacks a required method or cannot apply the selected model or effort** (recoverable)\n  - Detection: Capability negotiation, a negative mutation response, or read-back differs from the requested selection.\n  - Response: Stop before submitting the prompt and surface a concise error that names the unsupported choice. Do not use an implicit default for an explicit selection.\n  - User impact: The user can choose an available value or clear the override without losing the chat.\n- **Vibe process exits or times out during an accepted turn** (recoverable)\n  - Detection: Transport closes, terminal event reports failure, or the owned deadline expires.\n  - Response: Report the existing caller-specific failure, release the child, preserve received output and session identity, and avoid replay.\n  - User impact: The user can inspect partial output and decide whether to retry.\n\n**Edge cases**\n\n| Input | Expected |\n| :--- | :--- |\n| Model changes from a high-effort choice to a model offering no effort choices | Persist the new model with default effort in one update. |\n| A saved model and effort are restored while the catalog is unavailable | Preserve the saved selection and defer validation until a successful refresh. |\n| No explicit model or effort was chosen | Preserve the existing headless defaults and output path. |\n| Existing Vibe session resumes with a supported selection different from its prior settings | Confirm the selection in that session before starting its next turn. Preserve native session identity and caller policy. |\n\n**Invariants to preserve**\n\n- Daemon tiers and VS Code read model and effort definitions from the existing catalog projection. [[c1]]\n- Existing run paths retain their prompt, provider authentication, policy, session resume, and cancellation behavior. [[c1]]\n\n## 6. Test strategy\n\n**Test framework:** `Node test runner with tsx, injected fake child process and chat panel fixtures.`\n\n**Test levels**\n\n- **unit** — Protect catalog lifecycle and model-specific selection.\n  - Subjects: `Chat recovers from a failed catalog request without losing session state`, `Chat validates effort on model switch and session restore`\n- **integration** — Qualify both existing execution entry points with a fake Vibe process and verify preflight, output and cleanup.\n  - Subjects: `Daemon and chat apply verified Vibe model and effort to new and resumed turns`, `Vibe preflight failures never submit or replay the prompt`, `Vibe protocol path preserves caller permissions, attachments, and terminal output`\n  - Fixtures: `Scripted local app-server protocol fixture with capability, configuration, event, and cancellation cases.`\n- **smoke** — Check the installed CLI contract using an isolated session with no cloud prompt.\n  - Subjects: `Installed Vibe confirms a session-only model and effort without changing saved configuration`\n\n**Acceptance mapping**\n\n| Criterion | Proving tests |\n| :--- | :--- |\n| `ac1` | `Daemon and chat apply verified Vibe model and effort to new and resumed turns`, `Installed Vibe confirms a session-only model and effort without changing saved configuration` |\n| `ac2` | `Chat recovers from a failed catalog request without losing session state`, `Chat validates effort on model switch and session restore` |\n| `ac3` | `Vibe preflight failures never submit or replay the prompt`, `Vibe protocol path preserves caller permissions, attachments, and terminal output` |\n\n## 7. Migration\n\n**State before:** The s1 structural-map bundle identified the existing catalog RPC, two Vibe launch paths, and VS Code chat's one-shot catalog and independent selection fields.\n\n**State after:** The same catalog drives validated choices. Explicit Vibe selections use verified session-only settings, and a chat can recover its catalog after a daemon reconnect.\n\n**Zero downtime:** no — **Data rewrite:** no\n\n**Steps**\n\n1. Qualify the local Vibe protocol and execution policy parity. Deploy the daemon and VS Code builds with shared selection handling and typed preflight failures. — ↩ rollbackable\n2. Reload the VS Code extension and restart the daemon through normal release operations when the build is installed. Retain existing model tier and chat records. — ↩ rollbackable\n\n**Backward compat:** Existing catalog RPC and saved config shapes remain valid. Older Vibe builds retain the default headless path and report unsupported explicit choices if session-only settings cannot be verified. A mixed daemon and extension release uses the same existing catalog wire shape. Rollback restores the prior selection behavior without migrating data.\n\n## 8. Alternatives considered\n\n### 8.1 a1: Session-only Vibe settings — **CHOSEN**\n\nApply explicit effort through the local Vibe app server and retain the headless path for default settings.\n\nReuse the served catalog and current execution adapters. Use the local Vibe session API for explicit model and effort overrides, verify the effective settings before sending a prompt, and keep the chat catalog retry and selection validation in the host.\n\n### 8.2 a2: Child environment configuration\n\nPass model and effort through a child-process Vibe configuration layer.\n\nKeep the headless adapter and use Vibe's environment configuration for the selected model and per-model thinking value. Use the same chat picker validation and reload behavior.\n\n**Rejected because:** The sparse environment route cannot reliably preserve complete model settings or precedence on resume.\n\n## 9. References\n\n- **[[c1]]** `analyze-bundle` `s1:structural-map`\n- **[[c2]]** `prior-artifact` `docs/standalone/apply-catalog-model-effort-choices-daemon-E2026110997adabf6/ISSUE.md`\n- **[[c3]]** `code` `src/assets/models/cloud-model-catalog.json`\n- **[[c4]]** `doc` `https://docs.mistral.ai/vibe/code/cli/work-with-cli`\n- **[[c5]]** `doc` `https://docs.mistral.ai/vibe/code/cli/configuration-reference`\n- **[[c6]]** `code` `/Users/subhagho/.local/share/uv/tools/mistral-vibe/lib/python3.14/site-packages/vibe/app_server/protocol.py`\n"},"capturedAt":"2026-11-09T16:41:37.206Z"},"inventory":{"units":[{"id":"/body/hldContextSlice","selector":"/body/hldContextSlice","title":"hldContextSlice","kind":"section"},{"id":"/body/summary","selector":"/body/summary","title":"summary","kind":"section"},{"id":"/body/contractDetails","selector":"/body/contractDetails","title":"contractDetails","kind":"section"},{"id":"/body/dataModelChanges","selector":"/body/dataModelChanges","title":"dataModelChanges","kind":"section"},{"id":"/body/interactionWithShared","selector":"/body/interactionWithShared","title":"interactionWithShared","kind":"section"},{"id":"/body/errorPaths","selector":"/body/errorPaths","title":"errorPaths","kind":"section"},{"id":"/body/testStrategy","selector":"/body/testStrategy","title":"testStrategy","kind":"section"},{"id":"/body/migration","selector":"/body/migration","title":"migration","kind":"section"},{"id":"/body/alternativesConsidered","selector":"/body/alternativesConsidered","title":"alternativesConsidered","kind":"section"},{"id":"/body/chosenAlternative","selector":"/body/chosenAlternative","title":"chosenAlternative","kind":"section"},{"id":"/body/openQuestions","selector":"/body/openQuestions","title":"openQuestions","kind":"section"},{"id":"/body/sequenceDefinition","selector":"/body/sequenceDefinition","title":"sequenceDefinition","kind":"visual"},{"id":"/body/companions","selector":"/body/companions","title":"companions","kind":"visual"},{"id":"/body/alternativesConsidered/0","selector":"/body/alternativesConsidered/0","title":"a1","kind":"requirement"},{"id":"/body/alternativesConsidered/1","selector":"/body/alternativesConsidered/1","title":"a2","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/0","selector":"/body/sequenceDefinition/participants/0","title":"chat","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/1","selector":"/body/sequenceDefinition/participants/1","title":"daemon","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/2","selector":"/body/sequenceDefinition/participants/2","title":"adapter","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/3","selector":"/body/sequenceDefinition/participants/3","title":"vibe","kind":"requirement"},{"id":"/citations/0","selector":"/citations/0","title":"Citation 1","kind":"citation"},{"id":"/citations/1","selector":"/citations/1","title":"Citation 2","kind":"citation"},{"id":"/citations/2","selector":"/citations/2","title":"Citation 3","kind":"citation"},{"id":"/citations/3","selector":"/citations/3","title":"Citation 4","kind":"citation"},{"id":"/citations/4","selector":"/citations/4","title":"Citation 5","kind":"citation"},{"id":"/citations/5","selector":"/citations/5","title":"Citation 6","kind":"citation"},{"id":"document:line:25","selector":"document:line:25","title":"1. HLD context","kind":"section"},{"id":"document:line:99","selector":"document:line:99","title":"4. Diagrams","kind":"section"}]},"completedChunks":[{"chunkId":"scope","status":"incomplete","summary":"The assigned live and canonical sections align with the originating ISSUE’s three symptoms and fix intent. No demonstrated scope defect was found. Verification of the cited structural-map analysis remains incomplete because its bundle could not be located.","findings":[],"inspectedReferences":["/body/hldContextSlice","/body/summary","/body/interactionWithShared","/body/openQuestions","/citations/0","/citations/1","document:line:25","/Users/subhagho/work/projects/insors/insrc/docs/standalone/apply-catalog-model-effort-choices-daemon-E2026110997adabf6/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-97adabf6bd47b036-s1.json","/Users/subhagho/work/projects/insors/insrc/docs/standalone/apply-catalog-model-effort-choices-daemon-E2026110997adabf6/ISSUE.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/ISSUE-97adabf6bd47b036.json","src/agent/providers/cli-provider.ts:715","vscode-plugin/src/chat/cli-adapter.ts:1023","vscode-plugin/src/chat/chat-panel.ts:326","vscode-plugin/src/chat/chat-panel.ts:3221","src/daemon/model-definitions.ts:147","src/assets/models/cloud-model-catalog.json:43","/Users/subhagho/.local/share/uv/tools/mistral-vibe/lib/python3.14/site-packages/vibe/app_server/protocol.py:1456","/Users/subhagho/.insrc/workflow-runs/97adabf6bd47b036/design.story-wf-1794242207248-a8o0ow.jsonl"],"limitations":["The analysis evidence referenced by /citations/0 as s1:structural-map could not be located in the repository or persisted workflow/analyze files. The workflow log records completion of context.assemble but contains no bundle content. Current code corroborates the reported launch and picker defects, but the cited bundle’s contents and provenance could not be verified."],"advice":["Give c1 a retrievable bundle identifier or persisted evidence path.","Clarify that empty shared-interaction sections mean no parent-HLD or sibling contracts; existing catalog IPC and execution-adapter dependencies remain applicable and are described elsewhere.","Keep installed-protocol and execution-policy qualification as a prerequisite to implementation: the inspected protocol declares session-only model and effort mutation, while end-to-end runtime parity still requires the planned qualification."]},{"chunkId":"vibe","status":"changes_requested","summary":"The installed Vibe implementation supports the selected session-only approach, including model aliases, effort mutation and runtime read-back. Catalog authority and local CLI authentication remain intact. The daemon retry integration needs an explicit contract to prevent replay after uncertain dispatch.","findings":[{"id":"vibe-001","severity":"MED","location":"/body/contractDetails/api/0/errors","message":"The design requires distinguishing pre-dispatch refusal from failure after dispatch and never replaying an uncertain prompt, but its error contract exposes only selection-unavailable and launch-failed, without dispatch certainty or a non-retryable marker. This matters at the existing daemon boundary: complete() and runEditSession() use withTransientRetry(), and runReviewSession() also retries failures based on error text. Reporting a post-dispatch connection failure through the existing caller-specific failure path can therefore launch another session and submit the prompt again. Specify the dispatch-state/error representation, the retry guards in these callers, and regression coverage for a lost turn/start response and a transient failure after accepted dispatch.","evidenceReferences":[".insrc/artifacts/LLD-97adabf6bd47b036-s1.json#/body/contractDetails/api/0",".insrc/artifacts/LLD-97adabf6bd47b036-s1.json#/body/errorPaths/errorCases/2",".insrc/artifacts/LLD-97adabf6bd47b036-s1.json#/body/testStrategy","src/agent/providers/cli-provider.ts:309 — withTransientRetry classifies errors by transienceText","src/agent/providers/cli-provider.ts:504 — runEditSession uses withTransientRetry","src/agent/providers/cli-provider.ts:570 — review-session retry handling","src/agent/providers/cli-provider.ts:1049 — transienceText falls back to the error message"]}],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/body/errorPaths","/body/testStrategy","/body/migration","/body/alternativesConsidered","/body/chosenAlternative","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/citations/2","/citations/3","/citations/4","/citations/5","/Users/subhagho/work/projects/insors/insrc/docs/standalone/apply-catalog-model-effort-choices-daemon-E2026110997adabf6/S001/LLD.md",".insrc/artifacts/LLD-97adabf6bd47b036-s1.json","docs/standalone/apply-catalog-model-effort-choices-daemon-E2026110997adabf6/ISSUE.md","src/agent/providers/cli-provider.ts","vscode-plugin/src/chat/cli-adapter.ts","vscode-plugin/src/chat/chat-panel.ts","vscode-plugin/src/chat/__tests__/cli-adapter.test.ts","src/assets/models/cloud-model-catalog.json","src/daemon/model-definitions.ts","vscode-plugin/tsconfig.json","vscode-plugin/esbuild.mjs","https://docs.mistral.ai/vibe/code/cli/work-with-cli","https://docs.mistral.ai/vibe/code/cli/configuration-reference","/Users/subhagho/.local/share/uv/tools/mistral-vibe/lib/python3.14/site-packages/vibe/app_server/protocol.py","/Users/subhagho/.local/share/uv/tools/mistral-vibe/lib/python3.14/site-packages/vibe/app_server/_connection_protocol.py","/Users/subhagho/.local/share/uv/tools/mistral-vibe/lib/python3.14/site-packages/vibe/app_server/config.py","/Users/subhagho/.local/share/uv/tools/mistral-vibe/lib/python3.14/site-packages/vibe/app_server/server.py","/Users/subhagho/.local/share/uv/tools/mistral-vibe/lib/python3.14/site-packages/vibe/app_server/_unified_harness_backend_adapter.py","/Users/subhagho/.local/share/uv/tools/mistral-vibe/lib/python3.14/site-packages/vibe/core/config/layers/environment.py","/Users/subhagho/.local/share/uv/tools/mistral-vibe/lib/python3.14/site-packages/vibe/core/config/orchestrator.py"],"limitations":[],"advice":["Make qualification fixtures explicitly cover daemon read-only tool filtering, headless approval denial, chat attachment roots, cancellation during preflight, deadline expiry, bounded event handling and the default-only fallback.","Record the qualified Vibe version and capability-detection mechanism. The installed initialize response exposes server identity and process ID, so method availability should not be assumed from an advertised method list.","Define the shared request/result/transport types and their module location, including caller-specific event and process-lifecycle mappings, before implementation."]},{"chunkId":"chat","status":"changes_requested","summary":"All assigned sections and the catalog citation were inspected against the originating ISSUE and current chat implementation. The design captures the intended behavior, but leaves provider-aware reconciliation and the extension/webview recovery integration insufficiently specified.","findings":[{"id":"chat-001","severity":"MED","location":"/body/contractDetails/api/1/signature","message":"reconcileRunConfig(next: RunConfig, catalog: RunCatalog) lacks the provider needed to select the applicable model list. The existing RunConfig contains only model and effort; provider belongs to ChatSession, while the catalog projection contains multiple providers. The parameter description incorrectly says RunConfig includes provider. Define a provider-aware input or explicit provider argument and the catalog type, retaining the existing persisted shape. Apply the same reconciliation to new-chat, set-run-config and restored selections so provider switches cannot carry an incompatible effort.","evidenceReferences":[".insrc/artifacts/LLD-97adabf6bd47b036-s1.json#/body/contractDetails/api/1","vscode-plugin/src/chat/session-store.ts:294 — RunConfig contains only optional model and effort","vscode-plugin/src/chat/session-store.ts:110 — ChatSession owns provider","vscode-plugin/src/chat/chat-panel.ts:110 — runCatalogView produces per-provider model lists","vscode-plugin/src/chat/chat-panel.ts:2501 — provider switching carries the previous effort","vscode-plugin/src/chat/chat-panel.ts:3190 — new-chat and set-run-config mutation paths"]},{"id":"chat-002","severity":"MED","location":"/body/contractDetails/api/1/postconditions","message":"The recovery contract requires reconnect and picker-open retries, loading/unavailable states and stale-response protection, but does not define the integration that delivers them. The current IpcClient has no reconnect subscription, the host receives only a definitions callback, and picker opening occurs entirely inside the webview without notifying the host. Catalog results currently replace the entire HTML document. Specify the reconnect observation mechanism, picker-open intent, catalog/status delivery and ready-handshake behavior, plus refresh-generation ownership across disposal/reopen. Define how updates preserve the active view and in-flight turn, and add an integration test that drives the actual picker/host boundary through initial failure and recovery; the listed host unit tests alone do not establish this path.","evidenceReferences":[".insrc/artifacts/LLD-97adabf6bd47b036-s1.json#/body/contractDetails/api/1/postconditions",".insrc/artifacts/LLD-97adabf6bd47b036-s1.json#/body/testStrategy","src/shared/ipc-client.ts:149 — IpcClient exposes request methods and optional streams, without reconnect notifications","vscode-plugin/src/extension.ts:880 — chat receives only the definitions request callback","vscode-plugin/src/chat/chat-panel.ts:327 — successful catalog loading calls setHtml(renderShell())","vscode-plugin/src/chat/chat-panel.ts:2454 — catalog is parsed once at webview bootstrap","vscode-plugin/src/chat/chat-panel.ts:2507 — picker opening does not notify the host","vscode-plugin/src/chat/chat-panel.ts:3513 — webview reload requires the ready handshake","vscode-plugin/src/chat/protocol.ts:109 — run-config carries selection but no catalog/status","vscode-plugin/src/chat/__tests__/chat-panel.test.ts:1965 — existing picker wiring coverage checks generated script text"]}],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/body/errorPaths","/body/testStrategy","/body/migration","/citations/2","/Users/subhagho/work/projects/insors/insrc/docs/standalone/apply-catalog-model-effort-choices-daemon-E2026110997adabf6/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-97adabf6bd47b036-s1.json","/Users/subhagho/work/projects/insors/insrc/docs/standalone/apply-catalog-model-effort-choices-daemon-E2026110997adabf6/ISSUE.md","src/assets/models/cloud-model-catalog.json","src/daemon/model-definitions.ts","src/shared/ipc-client.ts:149","vscode-plugin/src/extension.ts:806","vscode-plugin/src/extension.ts:880","vscode-plugin/src/chat/chat-panel.ts","vscode-plugin/src/chat/session-store.ts:110","vscode-plugin/src/chat/session-store.ts:294","vscode-plugin/src/chat/protocol.ts","vscode-plugin/src/chat/webview-channel.ts","vscode-plugin/src/models/definitions.ts","vscode-plugin/src/surfaces/status-surface.ts","vscode-plugin/src/chat/__tests__/chat-panel.test.ts:1734","vscode-plugin/src/chat/__tests__/chat-panel.test.ts:1947","vscode-plugin/src/chat/__tests__/chat-panel.test.ts:5824","vscode-plugin/src/chat/__tests__/chat-panel.test.ts:5880","vscode-plugin/src/chat/__tests__/chat-panel.test.ts:8240"],"limitations":[],"advice":["Specify the outcome when a successful catalog refresh finds a saved model missing or rejected, including what is persisted and communicated to the user.","Expand lifecycle test cases to name concurrent refresh coalescing, reconnect during an outstanding request, late responses after disposal/reopen, last-valid retention, empty effort lists and preservation of an already-dispatched turn's selection.","The existing picker layout can support this change without a separate UX mock. Document the loading/unavailable labels and remove the current Vibe note that describes effort as informational."]},{"chunkId":"visuals","status":"incomplete","summary":"All assigned selectors were inspected. The generated companion preserves the canonical participants, messages and descriptions, and agrees with the LLD’s catalog exchange, alternate callers, session ownership and pre-dispatch verification contract. No demonstrated defect was found in this assignment. Actual visual verification remains incomplete.","findings":[],"inspectedReferences":["/body/sequenceDefinition","/body/companions","/body/sequenceDefinition/participants/0","/body/sequenceDefinition/participants/1","/body/sequenceDefinition/participants/2","/body/sequenceDefinition/participants/3","document:line:99","/Users/subhagho/work/projects/insors/insrc/docs/standalone/apply-catalog-model-effort-choices-daemon-E2026110997adabf6/S001/LLD.md","/Users/subhagho/work/projects/