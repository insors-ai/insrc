tor":"/body/sequenceDefinition/participants/2","title":"adapter","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/3","selector":"/body/sequenceDefinition/participants/3","title":"vibe","kind":"requirement"},{"id":"/citations/0","selector":"/citations/0","title":"Citation 1","kind":"citation"},{"id":"/citations/1","selector":"/citations/1","title":"Citation 2","kind":"citation"},{"id":"/citations/2","selector":"/citations/2","title":"Citation 3","kind":"citation"},{"id":"/citations/3","selector":"/citations/3","title":"Citation 4","kind":"citation"},{"id":"/citations/4","selector":"/citations/4","title":"Citation 5","kind":"citation"},{"id":"/citations/5","selector":"/citations/5","title":"Citation 6","kind":"citation"},{"id":"/citations/6","selector":"/citations/6","title":"Citation 7","kind":"citation"},{"id":"/citations/7","selector":"/citations/7","title":"Citation 8","kind":"citation"},{"id":"/citations/8","selector":"/citations/8","title":"Citation 9","kind":"citation"},{"id":"/citations/9","selector":"/citations/9","title":"Citation 10","kind":"citation"},{"id":"/citations/10","selector":"/citations/10","title":"Citation 11","kind":"citation"},{"id":"document:line:25","selector":"document:line:25","title":"1. HLD context","kind":"section"},{"id":"document:line:107","selector":"document:line:107","title":"4. Diagrams","kind":"section"}]},"completedChunks":[{"chunkId":"scope","status":"passed","summary":"All assigned selectors were inspected in the current live and canonical LLD. Scope and acceptance coverage align with the originating ISSUE, including structured-completion dispatch safety and preservation of schema-correction retries. Catalog citations are supported by current code. Generated HLD ancestry metadata does not establish an additional upstream requirement for this standalone issue.","findings":[],"inspectedReferences":["/body/hldContextSlice","/body/summary","/body/interactionWithShared","/body/openQuestions","/citations/0","/citations/1","document:line:25","/Users/subhagho/work/projects/insors/insrc/docs/standalone/apply-catalog-model-effort-choices-daemon-E2026110997adabf6/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-97adabf6bd47b036-s1.json","/Users/subhagho/work/projects/insors/insrc/docs/standalone/apply-catalog-model-effort-choices-daemon-E2026110997adabf6/ISSUE.md","src/daemon/model-definitions.ts:109-156 — registry projection preserves model IDs, aliases and effort lists","src/assets/models/cloud-model-catalog.json — provider-specific model and effort definitions","src/agent/providers/cli-provider.ts:309-340 — transient retry boundary","src/agent/providers/cli-provider.ts:459-479 — structured Vibe completion","src/agent/providers/cli-provider.ts:549-592 — separate review retry boundary","src/agent/providers/cli-provider.ts:707-747 — existing Vibe model selection and launch","src/agent/providers/structured-output.ts:199-280 — call-error conversion, validation retries and final wrapping","vscode-plugin/src/chat/chat-panel.ts:326-339 — initial catalog request and failure behavior","vscode-plugin/src/chat/chat-panel.ts:3200-3239 — independent model and effort mutations","docs/standalone/apply-catalog-model-effort-choices-daemon-E2026110997adabf6/S001/LLD.md:53-87 — execution safety and catalog recovery contracts","docs/standalone/apply-catalog-model-effort-choices-daemon-E2026110997adabf6/S001/LLD.md:144-162 — acceptance mapping and structured-completion regression coverage","docs/standalone/apply-catalog-model-effort-choices-daemon-E2026110997adabf6/S001/sequence-diagram.html — generated sequence source",".insrc/tmp/design-review/catalog-model-effort-lld-97adabf6-evidence/sequence-fit.png — inspected supplied rendering showing all four participants and nine messages"],"limitations":[],"advice":[]},{"chunkId":"vibe","status":"passed","summary":"All assigned selectors were inspected against the originating ISSUE, current callers, retry helpers, installed Vibe source and cited documentation. The revised design addresses both carried retry defects: dispatch certainty remains monotonic across the named retry boundaries, uncertain or accepted failures propagate unchanged, and successfully received invalid output retains schema correction. Installed-source evidence supports the proposed handshake, session-only mutation and runtime verification. Smoke qualification is now correctly prospective. No blocking design defect was demonstrated.","findings":[],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/body/errorPaths","/body/testStrategy","/body/migration","/body/alternativesConsidered","/body/chosenAlternative","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/citations/2","/citations/3","/citations/4","/citations/5","/citations/6","/citations/9","/Users/subhagho/work/projects/insors/insrc/docs/standalone/apply-catalog-model-effort-choices-daemon-E2026110997adabf6/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-97adabf6bd47b036-s1.json","/Users/subhagho/work/projects/insors/insrc/docs/standalone/apply-catalog-model-effort-choices-daemon-E2026110997adabf6/ISSUE.md","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/catalog-model-effort-lld-97adabf6.json","src/agent/providers/cli-provider.ts:280-340 — complete and transient retry boundary","src/agent/providers/cli-provider.ts:459-479 — completeStructuredVibe","src/agent/providers/cli-provider.ts:502-592 — edit and separate review retry boundaries","src/agent/providers/cli-provider.ts:623-646 — review schema-correction loop","src/agent/providers/cli-provider.ts:707-747 — existing Vibe selection and subprocess launch","src/agent/providers/structured-output.ts:199-280 — provider-error conversion, correction retries and final wrapping","src/agent/providers/__tests__/cli-vibe.test.ts","src/shared/types.ts:92 — completion cancellation contract","src/shared/types.ts:192 — LLMProvider interface