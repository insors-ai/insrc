85416	{"artifactId":"LLD-dae67bfc7da310cc-s1","entry":{"id":"a085b1ffb0231753f3ac546b151bab679b38bc7e29cda3142d18b087b165fdb9","targetHeadHash":"986957142ccf5ad26e1e35928c7d785cc1fd7b7337787b1dc73c8ab76db11398","actor":{"id":"agent:design-review-daemon","kind":"agent","properties":{"party":"daemon"}},"timestamp":"2026-11-16T12:22:05.511Z","operation":"review","revision":{"number":1,"contentHash":"f3cfa3334250e7c0a2b4c4c67cce759175c746283a6b6bb8ccfab8748c2f8a7a"},"outcome":{"result":"block","summary":"Design review remove-reviews-dae67bfc-lld attempt 1","data":{"kind":"design-chunk-review","reviewId":"remove-reviews-dae67bfc-lld","project":"/home/subho/work/dev/insors/insrc","artifactId":"LLD-dae67bfc7da310cc-s1","subject":{"project":"/home/subho/work/dev/insors/insrc","artifactId":"LLD-dae67bfc7da310cc-s1","kind":"LLD","canonicalPath":"/home/subho/work/dev/insors/insrc/.insrc/artifacts/LLD-dae67bfc7da310cc-s1.json","documentPath":"/home/subho/work/dev/insors/insrc/docs/standalone/remove-design-code-review-implementations-while-E20261116dae67bfc/S001/LLD.md","reviewer":"daemon","workflow":{"kind":"standalone","rootArtifactId":"LLD-dae67bfc7da310cc-s1","requiredReferences":[],"availableReferences":[],"notApplicableRoles":["PLAN","TASKS","BUILD","CR","DEF","HLD","sibling_stories"]}},"reviewer":"daemon","applicableAttempt":1,"status":"incomplete","binding":{"sourceRevision":{"number":1,"contentHash":"f3cfa3334250e7c0a2b4c4c67cce759175c746283a6b6bb8ccfab8748c2f8a7a"},"reviewedContentIdentity":"415b6db7c8b61601171689d894cf571ee139861635bf1d0e25606967f12df0a0","documentDigest":"f7f45a2e136a6d6100edd19ef0020a1a7bb122269bee19be515d22d2934c0162","workflowDigest":"467ed29a3750e3af472c7d98d659a3ecb8ac8d9b23f31727e5fd7205fafb77f6","author":"controller"},"preservationDigest":"ae1bbd31f2b5a6c2d4ae20e0cbdc35f4ed71198ce7d9a9cfe8e1b628c37fb4b7","schemaVersion":2,"submitted":{"artifactPath":"/home/subho/work/dev/insors/insrc/.insrc/artifacts/LLD-dae67bfc7da310cc-s1.json","attempt":1},"attempts":[{"number":1,"status":"incomplete","preparationKind":"planning","baseline":{"subjectFingerprints":{"canonical":"1dcbe52de6ffb29c68bfd637573b4e31a20cd044bcd17d1937262483060559ef","document":"f7f45a2e136a6d6100edd19ef0020a1a7bb122269bee19be515d22d2934c0162"},"contentIdentity":"415b6db7c8b61601171689d894cf571ee139861635bf1d0e25606967f12df0a0","reviewedContent":{"canonical":"{\n  \"meta\": {\n    \"workflow\": \"design.story\",\n    \"runId\": \"wf-1794830844170-7po9fb\",\n    \"repoPath\": \"/home/subho/work/dev/insors/insrc\",\n    \"createdAt\": \"2026-11-16T12:10:41.975Z\",\n    \"epicCreatedAt\": \"2026-11-16T12:10:41.975Z\",\n    \"attribution\": {\n      \"outputs\": [\n        {\n          \"role\": \"(client)\",\n          \"tier\": \"core\",\n          \"runner\": \"cli-codex\",\n          \"model\": \"unknown\"\n        }\n      ]\n    },\n    \"elapsedMs\": 189752,\n    \"repoIndexedAt\": null,\n    \"schemaVersion\": 1,\n    \"epicHash\": \"dae67bfc7da310cc\",\n    \"epicSlug\": \"remove-design-code-review-implementations-while\",\n    \"storyId\": \"s1\",\n    \"hldBaseRunId\": \"wf-1794830844170-7po9fb\",\n    \"hldEffectiveHash\": \"dae67bfc7da310cc391a0a55da2942f3a26d78105aaf3fb8daebf06ec8f07c34\",\n    \"hldAmendmentsApplied\": [],\n    \"storyTitle\": \"Remove design and code review implementations while retaining unavailable endpoints\",\n    \"standalone\": true,\n    \"sizeClass\": \"feature\",\n    \"triageRationale\": \"One cohesive cross-cutting removal with multiple build tasks and explicit endpoint/gate compatibility choices, not a new subsystem. Graph analysis identifies review engines, daemon services/workers, MCP, CLI and workflow approval dependencies. Source inspection shows preexisting partial retirement stubs; scope must finish the removal rather than duplicate it. Graph is incomplete, so source import/registration audit is required.\",\n    \"authoredBy\": \"controller\",\n    \"lifecycle\": {\n      \"status\": \"draft\",\n      \"revision\": {\n        \"number\": 1,\n        \"contentHash\": \"f3cfa3334250e7c0a2b4c4c67cce759175c746283a6b6bb8ccfab8748c2f8a7a\",\n        \"at\": \"2026-11-16T12:10:45.068Z\",\n        \"by\": {\n          \"id\": \"insrc:system\",\n          \"kind\": \"system\",\n          \"properties\": {}\n        }\n      },\n      \"signoffs\": []\n    },\n    \"revision\": 1\n  },\n  \"body\": {\n    \"summary\": {\n      \"audience\": \"technical\",\n      \"prose\": \"Remove all executable design-review and code-review implementations, keeping their public MCP and daemon IPC contracts as unavailable endpoints. Every review operation throws a family-specific Error stating that the functionality is being rewritten before review validation or side effects. Historical artifacts and generic artifact viewing/human approval remain; review-required transitions cannot silently pass. Removal includes transitive review-only workers, services, preparation, checkpoints, publication, cleanup, activation, prompts and tests.\"\n    },\n    \"hldContextSlice\": {\n      \"frameworkSummary\": \"Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\",\n      \"ownedContracts\": [],\n      \"consumedContracts\": [],\n      \"boundary\": {\n        \"storyId\": \"s1\",\n        \"owns\": [],\n        \"depends\": [],\n        \"internal\": \"Remove design and code review implementations while retaining unavailable endpoints\"\n      },\n      \"adjacentBoundaries\": [],\n      \"rolloutPhase\": \"standalone\",\n      \"nonFunctional\": {}\n    },\n    \"contractDetails\": {\n      \"surfaceLevel\": \"public\",\n      \"api\": []\n    },\n    \"dataModelChanges\": [\n      {\n        \"entity\": \"Review runtime ownership\",\n        \"change\": \"invariant-change\",\n        \"details\": \"Delete runtime review execution and ownership relationships: endpoints no longer create sessions, attempts, workers, contexts or cleanup claims. Many preserved endpoints delegate directly to one stateless error helper; no endpoint owns mutable review state. Remove review-only dependencies while retaining only schemas/types needed for endpoint inputs and historical artifact reads. Historical records, hashes and parent-child artifact relationships remain unchanged.\",\n        \"callSites\": [\n          \"src/daemon/review-service.ts\",\n          \"src/daemon/threads/review-workers.ts\",\n          \"src/daemon/task-review-rpc.ts\",\n          \"src/daemon/code-review-rpc.ts\",\n          \"src/daemon/workflow-review-rpc.ts\"\n        ]\n      }\n    ],\n    \"interactionWithShared\": [],\n    \"errorPaths\": {\n      \"errorCases\": [\n        {\n          \"scenario\": \"Any current or legacy design/code review operation is invoked\",\n          \"detection\": \"Dispatch reaches a retained review endpoint or retained internal compatibility stub.\",\n          \"response\": \"Throw Error with exactly 'Design review functionality is being rewritten.' or 'Code review functionality is being rewritten.' through the existing IPC/MCP error transport. Do not report success, create runtime state, call providers or touch checkpoint files.\",\n          \"userImpact\": \"Review is unavailable until rewritten; clients display the error without polling or retrying indefinitely.\",\n          \"recoverable\": false\n        },\n        {\n          \"scenario\": \"Approval or Story completion requires review evidence that no longer exists\",\n          \"detection\": \"The existing gate determines that required clean independent review is absent.\",\n          \"response\": \"Return an actionable review-unavailable refusal through the existing gate; preserve only explicit human override mechanisms already supported and record their reason. Do not auto-approve or fabricate evidence.\",\n          \"userImpact\": \"User must explicitly choose an existing permitted override or wait for the rewrite.\",\n          \"recoverable\": true\n        }\n      ],\n      \"edgeCases\": [\n        {\n          \"input\": \"Existing review-id, resumable attempt, cancel, progress, cleanup, publish or activation request\",\n          \"expected\": \"Same rewritten exception; no old runtime recovery, history mutation or checkpoint cleanup.\"\n        },\n        {\n          \"input\": \"Malformed review input reaching a registered handler\",\n          \"expected\": \"No review-specific parsing or execution; throw rewritten exception. Transport-level schema validation remains the existing public contract.\"\n        },\n        {\n          \"input\": \"Historical review artifacts opened via generic artifact views\",\n          \"expected\": \"Remain readable with their original stored data. Retain minimal read/serialization contracts; no live review engine is reintroduced.\"\n        },\n        {\n          \"input\": \"Unrelated workflow/analyze/build requests\",\n          \"expected\": \"Continue through ordinary paths without loading review engines or spawning review workers.\"\n        }\n      ],\n      \"invariantsToPreserve\": [\n        {\n          \"text\": \"Preserve public endpoint schemas and current client compatibility identified by the s1 structural/import analysis; failure replaces review behavior, not endpoint identity.\",\n          \"source\": \"c1\"\n        },\n        {\n          \"text\": \"Preserve workflow core and shared artifact storage identified by the s1 module profile; no historical artifact schema migration or record deletion.\",\n          \"source\": \"c1\"\n        }\n      ]\n    },\n    \"testStrategy\": {\n      \"testFramework\": \"Node.js node:test with tsx; *.test.ts convention\",\n      \"testLevels\": [\n        {\n          \"level\": \"contract\",\n          \"purpose\": \"Prove endpoint names/input schemas remain registered and valid review calls all return the exact rewritten error, including legacy and current operation phases.\",\n          \"subjects\": [\n            \"MCP insrc_review_step and insrc_code_review_step\",\n            \"Daemon designReview.*, codeReview.task.*, codeReview.run, codeReview.grounding, codeReview.freshness, workflow.review, workflow.reviewArtifact and workflow.resolveFinding\"\n          ],\n          \"fixturesNeeded\": [\n            \"Frozen pre-change endpoint and MCP schema inventory\",\n            \"Valid minimal requests per preserved endpoint\"\n          ]\n        },\n        {\n          \"level\": \"integration\",\n          \"purpose\": \"Prove failure happens without worker/provider/storage/cleanup work and unrelated daemon/workflow paths still operate.\",\n          \"subjects\": [\n            \"Daemon handler registry and step host\",\n            \"Review worker startup/recovery shutdown wiring\",\n            \"Workflow approval and Story completion unavailable/override behavior\",\n            \"Historical generic artifact viewing\"\n          ],\n          \"fixturesNeeded\": [\n            \"Fail-on-call provider/worker/file mutation seams\",\n            \"Temporary historical review artifact and unrelated artifact fixtures\"\n          ]\n        },\n        {\n          \"level\": \"smoke\",\n          \"purpose\": \"Verify strict compilation, production build and current IDE error propagation after implementation deletion.\",\n          \"subjects\": [\n            \"npm run build\",\n            \"Focused workflow/daemon/MCP regression suites\",\n            \"VS Code and JetBrains client contract checks\"\n          ]\n        }\n      ],\n      \"acceptanceMapping\": [\n        {\n          \"criterionId\": \"ac1\",\n          \"provingTests\": [\n            \"Preserved endpoint inventory and exact rewritten exception contract\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac2\",\n          \"provingTests\": [\n            \"No review execution/preparation/recovery/cleanup side effects; import/deletion audit\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac3\",\n          \"provingTests\": [\n            \"Approval/completion never fabricate a clean review; historical artifacts remain unchanged\"\n          ]\n        }\n      ]\n    },\n    \"migration\": {\n      \"stateBefore\": \"s1.analyzeBundles[0] identifies current review modules and daemon/MCP/workflow consumers, with a partially retired helper but surviving runtime services and workers. Graph coverage is incomplete; source audit must freeze the full callable endpoint and import inventory before deletion.\",\n      \"stateAfter\": \"Only endpoint registrations, minimal input/historical serialization contracts and a stateless rewritten-error helper remain for design/code review. No engines, review-specific runtime resource ownership, preparation, worker processes, resume, publish, cleanup or activation execute. Historical artifacts are untouched. Review-dependent gates explicitly remain unavailable except existing human-authorized overrides.\",\n      \"migrationSteps\": [\n        {\n          \"order\": 1,\n          \"action\": \"Record endpoint/schema inventory, historical artifact hashes and dirty-file baseline; reconcile overlap with existing review edits without overwriting others' changes.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 2,\n          \"action\": \"Wire preserved current and legacy endpoints to rewritten exceptions; detach live review startup, RPC service and router ownership integrations in the same buildable change.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 3,\n          \"action\": \"Delete review execution/runtime modules, prompts and obsolete implementation tests; retain only necessary endpoint schemas and historical serializers. Audit imports, packages, configuration and both current IDE clients.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 4,\n          \"action\": \"Adapt approval/completion to explicit unavailable behavior and existing reasoned human overrides; update operational guidance. Do not execute removed cleanup against existing checkpoints.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 5,\n          \"action\": \"Run endpoint/no-side-effect contracts, focused integration suites, production build and relevant current client checks. Restart the daemon only after authorized deployment so in-flight old reviews are not interrupted without notice.\",\n          \"rollbackable\": true\n        }\n      ],\n      \"backwardCompat\": \"Public method names and MCP input schemas remain callable. Successful review outputs are intentionally replaced by transported Error messages: 'Design review functionality is being rewritten.' and 'Code review functionality is being rewritten.' No success or completion is fabricated. Existing artifacts remain readable through generic views, with no migration/deletion. Historical checkpoints remain inert. Existing IDE clients must show the error and cease polling that failed operation. Any stale generated out/ review code must be removed from build output/package so deleted sources are not shipped. Rollback restores code from version control without rewriting history.\",\n      \"zeroDowntime\": false,\n      \"dataRewriteRequired\": false\n    },\n    \"alternativesConsidered\": [\n      {\n        \"id\": \"a1\",\n        \"name\": \"Direct endpoint tombstones\",\n        \"oneLineSummary\": \"Retain the registered endpoints and minimal contract types; delete implementation and wire every review operation directly to a throwing helper.\",\n        \"approach\": \"Each existing public MCP/IPC method remains registered with its current input schema and produces a consistent thrown Error explaining that its review family is being rewritten. Delete engines and runtime ownership rather than preserving disabled implementations. Historical read/render schemas remain only where required for general artifact handling. Approval/completion consumers report unavailable review evidence and require explicit existing human override paths; they never synthesize a pass.\",\n        \"pros\": [\n          \"Smallest complete removal with predictable client-visible behavior\",\n          \"No worker, provider, checkpoint or cleanup side effects from review calls\",\n          \"Reuses current registration and error transports\"\n        ],\n        \"cons\": [\n          \"Requires exhaustive audit of indirect callers and import dependencies\",\n          \"Review-dependent operations may remain blocked until an explicit override or the rewrite\"\n        ],\n        \"costEstimate\": \"L\"\n      },\n      {\n        \"id\": \"a2\",\n        \"name\": \"Dedicated unavailable review adapter\",\n        \"oneLineSummary\": \"Delete implementation and route all preserved endpoints through a new adapter exposing the former service interface.\",\n        \"approach\": \"Replace the review service with an unavailable adapter implementing all former methods, while deleting engines and workers. Existing RPC wrappers retain the service-shaped dependency; review-dependent approvals receive an explicit unavailable result. Preserve historical formats and error transports.\",\n        \"pros\": [\n          \"Central service-shaped compatibility seam\",\n          \"Groups unavailable operations behind one adapter\"\n        ],\n        \"cons\": [\n          \"Retains unnecessary service abstraction for functionality explicitly removed\",\n          \"More surface to maintain and audit than direct endpoint tombstones\"\n        ],\n        \"costEstimate\": \"L\",\n        \"reasonRejected\": \"Meets endpoint compatibility but unnecessarily retains a service interface after deleting functionality.\"\n      }\n    ],\n    \"chosenAlternative\": \"a1\",\n    \"openQuestions\": []\n  },\n  \"citations\": [\n    {\n      \"id\": \"c1\",\n      \"kind\": \"analyze-bundle\",\n      \"ref\": \"s1.analyzeBundles[0]\",\n      \"quotedText\": \"Analyzer completed a workflow module profile, import graph and convention pass. Review implementation resides under code-review and review; external graph consumers include daemon review-service, review-workers, task/design/workflow/code RPC, build/approval paths, MCP schema and current VS Code client. Stored graph reports 526 incoming and 480 outgoing edges for workflow, but index coverage is incomplete. Source audit is needed to enumerate all endpoints and consumers; an existing review-unavailable helper indicates partial retirement already exists. No new subsystem or persistent schema is needed.\"\n    },\n    {\n      \"id\": \"c2\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/handler-runtime.ts:699-727\"\n    },\n    {\n      \"id\": \"c3\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/design-review-rpc.ts\"\n    },\n    {\n      \"id\": \"c4\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/task-review-rpc.ts\"\n    },\n    {\n      \"id\": \"c5\",\n      \"kind\": \"code\",\n      \"ref\": \"src/workflow/review-unavailable.ts\"\n    },\n    {\n      \"id\": \"c6\",\n      \"kind\": \"stakeholder\",\n      \"ref\": \"User instruction, 2026-11-16: both design and code review functionality needs to be completely removed; only keep endpoints and raise an exception stating it is being rewritten.\"\n    }\n  ]\n}\n","document":"<!-- insrc:artifact LLD-dae67bfc7da310cc-s1 -->\n\n# LLD: STORY-dae67bfc7da310cc-s1 — Remove design and code review implementations while retaining unavailable endpoints\n\n## Summary\n\n**Epic:** `remove-design-code-review-implementations-while`\n**HLD base run:** `wf-1794830844170-7po9fb`\n**HLD effective hash:** `dae67bfc7da3...`\n\nRemove all executable design-review and code-review implementations, keeping their public MCP and daemon IPC contracts as unavailable endpoints. Every review operation throws a family-specific Error stating that the functionality is being rewritten before review validation or side effects. Historical artifacts and generic artifact viewing/human approval remain; review-required transitions cannot silently pass. Removal includes transitive review-only workers, services, preparation, checkpoints, publication, cleanup, activation, prompts and tests.\n\n## Contents\n\n1. [HLD context](#1-hld-context)\n2. [Contract details](#2-contract-details)\n3. [Data model changes](#3-data-model-changes)\n4. [Error paths](#4-error-paths)\n5. [Test strategy](#5-test-strategy)\n6. [Migration](#6-migration)\n7. [Alternatives considered](#7-alternatives-considered)\n8. [References](#8-references)\n\n## 1. HLD context\n\n**Framework:** Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\n**Rollout phase:** standalone\n\n## 2. Contract details\n\n**Surface level:** public\n\n## 3. Data model changes\n\n### 3.1 `Review runtime ownership` — invariant-change\n\nDelete runtime review execution and ownership relationships: endpoints no longer create sessions, attempts, workers, contexts or cleanup claims. Many preserved endpoints delegate directly to one stateless error helper; no endpoint owns mutable review state. Remove review-only dependencies while retaining only schemas/types needed for endpoint inputs and historical artifact reads. Historical records, hashes and parent-child artifact relationships remain unchanged.\n\n**Call sites:**\n- `src/daemon/review-service.ts`\n- `src/daemon/threads/review-workers.ts`\n- `src/daemon/task-review-rpc.ts`\n- `src/daemon/code-review-rpc.ts`\n- `src/daemon/workflow-review-rpc.ts`\n\n## 4. Error paths\n\n**Error cases**\n\n- **Any current or legacy design/code review operation is invoked** (terminal)\n  - Detection: Dispatch reaches a retained review endpoint or retained internal compatibility stub.\n  - Response: Throw Error with exactly 'Design review functionality is being rewritten.' or 'Code review functionality is being rewritten.' through the existing IPC/MCP error transport. Do not report success, create runtime state, call providers or touch checkpoint files.\n  - User impact: Review is unavailable until rewritten; clients display the error without polling or retrying indefinitely.\n- **Approval or Story completion requires review evidence that no longer exists** (recoverable)\n  - Detection: The existing gate determines that required clean independent review is absent.\n  - Response: Return an actionable review-unavailable refusal through the existing gate; preserve only explicit human override mechanisms already supported and record their reason. Do not auto-approve or fabricate evidence.\n  - User impact: User must explicitly choose an existing permitted override or wait for the rewrite.\n\n**Edge cases**\n\n| Input | Expected |\n| :--- | :--- |\n| Existing review-id, resumable attempt, cancel, progress, cleanup, publish or activation request | Same rewritten exception; no old runtime recovery, history mutation or checkpoint cleanup. |\n| Malformed review input reaching a registered handler | No review-specific parsing or execution; throw rewritten exception. Transport-level schema validation remains the existing public contract. |\n| Historical review artifacts opened via generic artifact views | Remain readable with their original stored data. Retain minimal read/serialization contracts; no live review engine is reintroduced. |\n| Unrelated workflow/analyze/build requests | Continue through ordinary paths without loading review engines or spawning review workers. |\n\n**Invariants to preserve**\n\n- Preserve public endpoint schemas and current client compatibility identified by the s1 structural/import analysis; failure replaces review behavior, not endpoint identity. [[c1]]\n- Preserve workflow core and shared artifact storage identified by the s1 module profile; no historical artifact schema migration or record deletion. [[c1]]\n\n## 5. Test strategy\n\n**Test framework:** `Node.js node:test with tsx; *.test.ts convention`\n\n**Test levels**\n\n- **contract** — Prove endpoint names/input schemas remain registered and valid review calls all return the exact rewritten error, including legacy and current operation phases.\n  - Subjects: `MCP insrc_review_step and insrc_code_review_step`, `Daemon designReview.*, codeReview.task.*, codeReview.run, codeReview.grounding, codeReview.freshness, workflow.review, workflow.reviewArtifact and workflow.resolveFinding`\n  - Fixtures: `Frozen pre-change endpoint and MCP schema inventory`, `Valid minimal requests per preserved endpoint`\n- **integration** — Prove failure happens without worker/provider/storage/cleanup work and unrelated daemon/workflow paths still operate.\n  - Subjects: `Daemon handler registry and step host`, `Review worker startup/recovery shutdown wiring`, `Workflow approval and Story completion unavailable/override behavior`, `Historical generic artifact viewing`\n  - Fixtures: `Fail-on-call provider/worker/file mutation seams`, `Temporary historical review artifact and unrelated artifact fixtures`\n- **smoke** — Verify strict compilation, production build and current IDE error propagation after implementation deletion.\n  - Subjects: `npm run build`, `Focused workflow/daemon/MCP regression suites`, `VS Code and JetBrains client contract checks`\n\n**Acceptance mapping**\n\n| Criterion | Proving tests |\n| :--- | :--- |\n| `ac1` | `Preserved endpoint inventory and exact rewritten exception contract` |\n| `ac2` | `No review execution/preparation/recovery/cleanup side effects; import/deletion audit` |\n| `ac3` | `Approval/completion never fabricate a clean review; historical artifacts remain unchanged` |\n\n## 6. Migration\n\n**State before:** s1.analyzeBundles[0] identifies current review modules and daemon/MCP/workflow consumers, with a partially retired helper but surviving runtime services and workers. Graph coverage is incomplete; source audit must freeze the full callable endpoint and import inventory before deletion.\n\n**State after:** Only endpoint registrations, minimal input/historical serialization contracts and a stateless rewritten-error helper remain for design/code review. No engines, review-specific runtime resource ownership, preparation, worker processes, resume, publish, cleanup or activation execute. Historical artifacts are untouched. Review-dependent gates explicitly remain unavailable except existing human-authorized overrides.\n\n**Zero downtime:** no — **Data rewrite:** no\n\n**Steps**\n\n1. Record endpoint/schema inventory, historical artifact hashes and dirty-file baseline; reconcile overlap with existing review edits without overwriting others' changes. — ↩ rollbackable\n2. Wire preserved current and legacy endpoints to rewritten exceptions; detach live review startup, RPC service and router ownership integrations in the same buildable change. — ↩ rollbackable\n3. Delete review execution/runtime modules, prompts and obsolete implementation tests; retain only necessary endpoint schemas and historical serializers. Audit imports, packages, configuration and both current IDE clients. — ↩ rollbackable\n4. Adapt approval/completion to explicit unavailable behavior and existing reasoned human overrides; update operational guidance. Do not execute removed cleanup against existing checkpoints. — ↩ rollbackable\n5. Run endpoint/no-side-effect contracts, focused integration suites, production build and relevant current client checks. Restart the daemon only after authorized deployment so in-flight old reviews are not interrupted without notice. — ↩ rollbackable\n\n**Backward compat:** Public method names and MCP input schemas remain callable. Successful review outputs are intentionally replaced by transported Error messages: 'Design review functionality is being rewritten.' and 'Code review functionality is being rewritten.' No success or completion is fabricated. Existing artifacts remain readable through generic views, with no migration/deletion. Historical checkpoints remain inert. Existing IDE clients must show the error and cease polling that failed operation. Any stale generated out/ review code must be removed from build output/package so deleted sources are not shipped. Rollback restores code from version control without rewriting history.\n\n## 7. Alternatives considered\n\n### 7.1 a1: Direct endpoint tombstones — **CHOSEN**\n\nRetain the registered endpoints and minimal contract types; delete implementation and wire every review operation directly to a throwing helper.\n\nEach existing public MCP/IPC method remains registered with its current input schema and produces a consistent thrown Error explaining that its review family is being rewritten. Delete engines and runtime ownership rather than preserving disabled implementations. Historical read/render schemas remain only where required for general artifact handling. Approval/completion consumers report unavailable review evidence and require explicit existing human override paths; they never synthesize a pass.\n\n### 7.2 a2: Dedicated unavailable review adapter\n\nDelete implementation and route all preserved endpoints through a new adapter exposing the former service interface.\n\nReplace the review service with an unavailable adapter implementing all former methods, while deleting engines and workers. Existing RPC wrappers retain the service-shaped dependency; review-dependent approvals receive an explicit unavailable result. Preserve historical formats and error transports.\n\n**Rejected because:** Meets endpoint compatibility but unnecessarily retains a service interface after deleting functionality.\n\n## 8. References\n\n- **[[c1]]** `analyze-bundle` `s1.analyzeBundles[0]` — \"Analyzer completed a workflow module profile, import graph and convention pass. Review implementation resides under code-review and review; external graph consumers include daemon review-service, revi\"\n- **[[c2]]** `code` `src/daemon/handler-runtime.ts:699-727`\n- **[[c3]]** `code` `src/daemon/design-review-rpc.ts`\n- **[[c4]]** `code` `src/daemon/task-review-rpc.ts`\n- **[[c5]]** `code` `src/workflow/review-unavailable.ts`\n- **[[c6]]** `stakeholder` `User instruction, 2026-11-16: both design and code review functionality needs to be completely removed; only keep endpoints and raise an exception stating it is being rewritten.`\n"},"capturedAt":"2026-11-16T12:10:56.388Z"},"inventory":{"units":[{"id":"/body/summary","selector":"/body/summary","title":"summary","kind":"section"},{"id":"/body/hldContextSlice","selector":"/body/hldContextSlice","title":"hldContextSlice","kind":"section"},{"id":"/body/contractDetails","selector":"/body/contractDetails","title":"contractDetails","kind":"section"},{"id":"/body/dataModelChanges","selector":"/body/dataModelChanges","title":"dataModelChanges","kind":"section"},{"id":"/body/interactionWithShared","selector":"/body/interactionWithShared","title":"interactionWithShared","kind":"section"},{"id":"/body/errorPaths","selector":"/body/errorPaths","title":"errorPaths","kind":"section"},{"id":"/body/testStrategy","selector":"/body/testStrategy","title":"testStrategy","kind":"section"},{"id":"/body/migration","selector":"/body/migration","title":"migration","kind":"section"},{"id":"/body/alternativesConsidered","selector":"/body/alternativesConsidered","title":"alternativesConsidered","kind":"section"},{"id":"/body/chosenAlternative","selector":"/body/chosenAlternative","title":"chosenAlternative","kind":"section"},{"id":"/body/openQuestions","selector":"/body/openQuestions","title":"openQuestions","kind":"section"},{"id":"/body/alternativesConsidered/0","selector":"/body/alternativesConsidered/0","title":"a1","kind":"requirement"},{"id":"/body/alternativesConsidered/1","selector":"/body/alternativesConsidered/1","title":"a2","kind":"requirement"},{"id":"/citations/0","selector":"/citations/0","title":"Citation 1","kind":"citation"},{"id":"/citations/1","selector":"/citations/1","title":"Citation 2","kind":"citation"},{"id":"/citations/2","selector":"/citations/2","title":"Citation 3","kind":"citation"},{"id":"/citations/3","selector":"/citations/3","title":"Citation 4","kind":"citation"},{"id":"/citations/4","selector":"/citations/4","title":"Citation 5","kind":"citation"},{"id":"/citations/5","selector":"/citations/5","title":"Citation 6","kind":"citation"},{"id":"document:line:24","selector":"document:line:24","title":"1. HLD context","kind":"section"}]},"completedChunks":[{"chunkId":"scope-framing","status":"changes_requested","summary":"Summary and HLD-context framing are consistent with the stakeholder instruction and the repo's standalone/no-HLD status, and verified call sites (design-review-rpc.ts, task-review-rpc.ts, handler-runtime.ts:699-727, workflow-review-rpc.ts) confirm the described partial-retirement state. The main gap is contractDetails: the structured `api` field is left empty even though the entire design's load-bearing claim (ac1) is an exact preserved-endpoint inventory, and that inventory is not fully reconstructable from prose elsewhere in the document either.","findings":[{"id":"empty-contract-api-surface","severity":"MED","location":"/body/contractDetails (api: [])","message":"contractDetails.surfaceLevel is 'public' but contractDetails.api is empty, leaving the single most consequential claim of this LLD — the exact set of MCP/daemon endpoints that must keep working with unchanged schemas while being rewired to throw — undocumented in the designated structured field. The document scatters partial endpoint lists instead (Error-paths test subjects list insrc_review_step/insrc_code_review_step plus designReview.*, codeReview.task.*, codeReview.run, codeReview.grounding, codeReview.freshness, workflow.review/reviewArtifact/resolveFinding), and even that prose list is incomplete against the live code: handler-runtime.ts also registers 'workflow.reviewDecision' (src/workflow/review-decision.ts, approve/reject/feedback from the review pane) which is review-adjacent but not mentioned anywhere, so a reader cannot tell from the document alone whether it was deliberately scoped out or missed. Given ac1 is specifically 'preserved endpoint inventory and exact rewritten exception contract', this inventory should be enumerated once, completely, in contractDetails.api (or an equivalent explicit list), not left for the reader to reassemble from Test strategy and Error paths prose.","evidenceReferences":["/body/contractDetails","src/daemon/handler-runtime.ts:699-727 (designReview.*, codeReview.task.*, codeReview.grounding, codeReview.freshness)","src/daemon/handler-runtime.ts:656 (workflow.reviewDecision -> ../workflow/review-decision.js)","/body/testStrategy/testLevels/0/subjects"]}],"inspectedReferences":["/body/summary","/body/hldContextSlice","/body/contractDetails","/body/openQuestions","document:line:24","/citations/5","/home/subho/work/dev/insors/insrc/docs/standalone/remove-design-code-review-implementations-while-E20261116dae67bfc/S001/LLD.md","src/daemon/handler-runtime.ts:699-727","src/daemon/design-review-rpc.ts","src/daemon/task-review-rpc.ts","src/workflow/review-unavailable.ts","src/daemon/workflow-review-rpc.ts","src/mcp/design-review/handler.ts","src/workflow/review-decision.ts"],"limitations":[],"advice":["Consider whether 'workflow.reviewDecision' and the 'team.refresh/claim/release' human-review-pane endpoints are intentionally out of scope (they appear to be a distinct human-approval feature, not automated design/code review execution) and, if so, say so explicitly in contractDetails or the summary so reviewers and builders don't have to infer it.","openQuestions is empty and appears genuinely so for this chunk's concerns — the standalone/no-HLD framing and stakeholder-match are both well grounded; no unresolved ambiguity was found here beyond the endpoint-inventory completeness noted above."]},{"chunkId":"data-model-error-handling","status":"incomplete","summary":"test","findings":[{"id":"test1","severity":"LOW","location":"x","message":"y","evidenceReferences":["z"]}],"inspectedReferences":["a"],"limitations":["Required coverage not reported: /body/dataModelChanges","Required coverage not reported: /body/interactionWithShared","Required coverage not reported: /body/errorPaths","Required coverage not reported: /citations/0","Required coverage not reported: /citations/1","Required coverage not reported: /citations/2","Required coverage not reported: /citations/3","Required coverage not reported: /citations/4","Required coverage not reported: /home/subho/work/dev/insors/insrc/docs/standalone/remove-design-code-review-implementations-while-E20261116dae67bfc/S001/LLD.md"],"advice":[]},{"chunkId":"test-migration-strategy","status":"changes_requested","summary":"Test strategy and migration are mostly coherent and traceable to the stakeholder instruction, and the backward-compat build-hygiene claim (removing stale out/ review code) is already satisfied by the repo's existing scripts/clean-output.mjs, which wipes out/ before every tsc build. However, the migration's claim to \"detach live review startup, RPC service and router ownership integrations\" in step 2 names no owning module for that startup/shutdown wiring — the actual integration point (src/daemon/index.ts, constructing ProductionReviews/ThreadServices and driving shutdown) is absent from both the data-model call-site list and the migration steps, which is a real gap given how central that wiring is. The acceptance-mapping and zero-downtime/in-flight-review points raised in the chunk concerns are weaker — adequate for a PLAN-not-applicable standalone LLD and resolvable by a more careful reading, respectively — so I kept those as advisory rather than blocking.","findings":[{"id":"migration-missing-daemon-index-ownership","severity":"MED","location":"/body/migration (Steps, step 2) and /body/dataModelChanges (3.1 Call sites)","message":"Migration step 2 requires detaching 'live review startup, RPC service and router ownership integrations' 'in the same buildable change' as wiring endpoints to exceptions, and the state-after claims 'No engines, review-specific runtime resource ownership, preparation, worker processes... execute.' But neither the data-model call-site list (3.1: review-service.ts, threads/review-workers.ts, task-review-rpc.ts, code-review-rpc.ts, workflow-review-rpc.ts) nor the migration steps name src/daemon/index.ts, which is the actual module that constructs the review runtime at daemon startup (ThreadServices for reviews, `new ProductionReviews({services:reviewServices,...})`, `installProductionReviews(reviews)`), wires it into the shared progress runtime (`registerReviewProducers`), and owns its shutdown (`reviews.stopAdmission(); reviewClosing=reviews.shutdown()`). Because this file is the one place worker/service lifecycle is actually started and torn down, omitting it from both the call-site inventory and the migration steps leaves the single most consequential piece of 'detach live review startup... ownership' work undocumented — a builder following only the LLD's named call sites could leave daemon startup still constructing the full review runtime (ThreadServices, ProductionReviews, worker tracking) even after endpoints are rewired to throw, contradicting the 'no worker processes... execute' state-after claim.","evidenceReferences":["src/daemon/index.ts:274 (ThreadServices construction for reviews)","src/daemon/index.ts:420-428 (new ProductionReviews(...), installProductionReviews(reviews))","src/daemon/index.ts:515 (registerReviewProducers(runtime.coordinator) wired into shared progress runtime)","src/daemon/index.ts:676,695 (reviews.stopAdmission(); reviewClosing=reviews.shutdown())","/body/dataModelChanges/0/callSites","/body/migration/migrationSteps/1"]}],"inspectedReferences":["/body/testStrategy","/body/migration","/home/subho/work/dev/insors/insrc/docs/standalone/remove-design-code-review-implementations-while-E20261116dae67bfc/S001/LLD.md","/home/subho/work/dev/insors/insrc/.insrc/tmp/design-review/remove-reviews-dae67bfc-lld.json","src/daemon/index.ts","src/daemon/review-service.ts","src/daemon/task-review-rpc.ts","src/workflow/review-unavailable.ts","package.json","scripts/clean-output.mjs"],"limitations":[],"advice":["Acceptance mapping (ac1/ac2/ac3) ties criteria to prose subject descriptions that largely restate the corresponding test level's purpose rather than naming concrete test files/assertions. Given PLAN is not applicable for this standalone LLD, this is acceptable as design-level traceability (file-level test mapping is properly a build-time concern, matching the build gate's own test-mapping mechanism), but tightening the acceptance-mapping column to point at specific planned test files (even if not yet written) would strengthen self-sufficiency.","The apparent tension between 'restart the daemon only after authorized deployment so in-flight old reviews are not interrupted without notice' (migration step 5) and the edge-case table's 'same rewritten exception; no old runtime recovery' for resumable/cancel/progress requests is resolvable: the former is about giving operational notice before a restart that will interrupt in-flight sessions, not about in-flight sessions surviving the restart. Consider rewording step 5 slightly (e.g. 'so operators and clients are given notice before in-flight old reviews are interrupted') to remove the ambiguity for a future reader.","The backward-compat requirement to remove stale generated out/ review code is already satisfied by the existing scripts/clean-output.mjs (invoked at the start of `npm run build`), so the smoke-level 'npm run build' check in the test strategy already exercises it; no change needed, just noting the traceability is sound."]},{"chunkId":"alternatives-decision","status":"passed","summary":"Alternatives a1 (chosen) and a2 are substantively distinct, not a cosmetic relabeling: a1's \"stateless error helper\" (3.1) is a single shared function directly invoked by endpoint handlers with their own existing input types, while a2's rejected \"adapter exposing the former service interface\" requires defining and maintaining a class/interface that mimics every method of the former review service, plus RPC wrappers that keep a service-shaped dependency on it. That is a real extra abstraction layer the design correctly avoids, so the stated rejection reason (\"unnecessarily retains a service interface after deleting functionality\") is grounded rather than arbitrary. The identical costEstimate \"L\" on both alternatives is plausible rather than an oversight, since the dominant cost driver named elsewhere in the document (migration step 3's \"audit imports, packages, configuration and both current IDE clients,\" step 1's endpoint/schema inventory) is the same exhaustive-audit work regardless of which shape the compatibility seam takes; the document just does not say so explicitly. Neither point rises to a demonstrated defect in the chosen design or its documented rationale.","findings":[],"inspectedReferences":["/body/alternativesConsidered","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/chosenAlternative","/home/subho/work/dev/insors/insrc/docs/standalone/remove-design-code-review-implementations-while-E20261116dae67bfc/S001/LLD.md","/body/dataModelChanges","section 3.1 Review runtime ownership call sites"],"limitations":[],"advice":["Consider adding one sentence to the a1/a2 comparison spelling out that a1's helper is a plain function invoked ad hoc by handlers (no shared type contract to keep in sync) whereas a2's adapter must replicate every former service method's signature as a typed interface — the distinction is real but currently requires the reader to infer it from differing prose (\"stateless error helper\" vs \"adapter exposing the former service interface\") rather than a stated comparison.","Consider noting briefly why costEstimate is identical ('L') for both alternatives — e.g. that the dominant cost is the shared endpoint/import audit (migration steps 1 and 3) rather than the adapter-vs-helper implementation choice itself — so a reader doesn't read the tie as an unexamined estimate."]},{"chunkId":"final-consistency","status":"incomplete","summary":"The document's own cross-section traceability holds up well for the error-path vs. migration sequencing question, the ac1-ac3 mapping, and the end-to-end reflection of the stakeholder instruction (c6) — no new contradictions found there. However, one dependency chunk this consistency check relies on (data-model-error-handling) contains placeholder/toy content rather than a genuine review (summary \"test\", finding id \"test1\" at location \"x\" with message \"y\"/evidence \"z\", and its own limitations admit required coverage of /body/dataModelChanges, /body/interactionWithShared, /body/errorPaths and citations c1-c4 was \"not reported\"). That chunk's own plan explicitly intended to check the citation/call-site concern this final chunk is also asked to verify, so I verified it independently: section 3.1's \"Call sites\" list omits both src/daemon/design-review-rpc.ts (c3) and src/daemon/handler-runtime.ts (c2) even though handler-runtime.ts:699-708 dispatches every designReview.* operation straight into design-review-rpc.ts, and the parallel files task-review-rpc.ts (c4) and code-review-rpc.ts are both included in that same list — a real, document-internal inconsistency in the data model's ownership/call-site inventory, not a cosmetic citation-marker gap. Because the data-model-error-handling chunk's output cannot be relied on, the full extent of cross-chunk reconciliation for dataModelChanges/errorPaths/citations c1-c4 (including whether the invariants' sole reliance on c1 given its own 'incomplete coverage' caveat is adequately mitigated beyond migration step 1's audit) could not be completed from accepted feedback alone and is reported as a limitation rather than assumed resolved.","findings":[{"id":"call-sites-omit-review-rpc-and-dispatch-files","severity":"MED","location":"/home/subho/work/dev/insors/insrc/docs/standalone/remove-design-code-review-implementations-while-E20261116dae67bfc/S001/LLD.md section 3.1 'Call sites' (lines 39-45) vs section 8 'References' (lines 130-137)","message":"Section 3.1 ('Review runtime ownership') lists five call sites — review-service.ts, threads/review-workers.ts, task-review-rpc.ts, code-review-rpc.ts, workflow-review-rpc.ts — but omits src/daemon/design-review-rpc.ts (cited as c3) and src/daemon/handler-runtime.ts (cited as c2, lines 699-727). This is inconsistent on its face: handler-runtime.ts:699-708 is the actual dispatch table that routes every designReview.start/cancel/progress/assignment/plan/impact/activity/result/recover/failure RPC method into design-review-rpc.ts's designReviewOperation function, exactly mirroring how task-review-rpc.ts (c4, included in 3.1) and code-review-rpc.ts (included in 3.1) are the dispatch targets for their own RPC families. Since 3.1 is the single place this LLD declares which modules own/create the runtime review state being deleted, and since the design-review family is explicitly in scope per the stakeholder instruction (c6), omitting its dispatch file and its RPC implementation file from the call-site inventory leaves the data model's 'Review runtime ownership' entity incomplete relative to its own References section and its own stated migration step 3 ('audit imports... delete review execution/runtime modules').","evidenceReferences":["/body/dataModelChanges/0/callSites","/citations/1 (c2: src/daemon/handler-runtime.ts:699-727)","/citations/2 (c3: src/daemon/design-review-rpc.ts)","src/daemon/handler-runtime.ts:699-708 (designReview.* -> design-review-rpc.ts designReviewOperation)","/home/subho/work/dev/insors/insrc/docs/standalone/remove-design-code-review-implementations-while-E20261116dae67bfc/S001/LLD.md"]}],"inspectedReferences":["/home/subho/work/dev/insors/insrc/docs/standalone/remove-design-code-review-implementations-while-E20261116dae67bfc/S001/LLD.md","/home/subho/work/dev/insors/insrc/.insrc/tmp/design-review/remove-reviews-dae67bfc-lld.json","src/daemon/handler-runtime.ts:699-708","src/daemon/design-review-rpc.ts","/body/dataModelChanges/0/callSites","/body/errorPaths","/body/migration","/citations/5 (c6)"],"limitations":["The accepted feedback for the 'data-model-error-handling' chunk (recorded in the checkpoint) is placeholder/toy content — status 'incomplete', summary literally 'test', a single finding with id 'test1', location 'x', message 'y', evidence 'z' — and its own limitations list required coverage as 'not reported' for /body/dataModelChanges, /body/interactionWithShared, /body/errorPaths and /citations/0 through /citations/4. That chunk's plan intended to check whether the invariants' sole reliance on citation c1 is adequate given c1's own acknowledged 'incomplete graph coverage' caveat, and whether other citations (c2-c5) are properly reflected in the data model and error paths beyond the one call-site/dispatch-file gap I verified independently above. Because no genuine chunk review exists for that area, I cannot confirm this concern was fully reconciled across the whole document from accepted feedback alone, and a fresh substantive review of that chunk's scope is needed before this consistency check can be considered complete."],"advice":["Have the data-model-error-handling chunk re-run as a genuine review (its current accepted feedback is placeholder data and should not be treated as having verified anything about dataModelChanges, interactionWithShared, errorPaths, or citations c1-c4).","When section 3.1's call-site list is corrected, also add design-review-rpc.ts and handler-runtime.ts so the 'Review runtime ownership' entity's call sites are symmetric with the References section and with the already-included task-review-rpc.ts/code-review-rpc.ts pair — this directly supports migration step 3's audit and ac2's 'import/deletion audit' acceptance criterion.","The apparent tension between error-path guarantees (no runtime state/provider calls/checkpoint touches on any invocation) and migration's non-zero-downtime restart (step 5) is not a real contradiction: the guarantees apply once the rewritten code is deployed and running, while step 5's notice-before-restart language is about the old binary's in-flight sessions prior to that deployment taking effect — this is already the interpretation the test-migration-strategy chunk reached, and I found no cross-chunk disagreement with it.","ac1-ac3 each trace to a concrete commitment (ac1 to the error-path exact-exception response plus the endpoint-name/schema preservation invariant; ac2 to the 'no runtime state/provider calls' response and migration steps 2-3; ac3 to the second error case and migration step 4's override-only approval behavior) — no orphaned acceptance criterion found, modulo the already-flagged (scope-framing chunk) gap that the concrete endpoint list proving ac1 is not enumerated in contractDetails.api.","c6 (the stakeholder instruction) is fully and consistently reflected: both design and code review are named throughout (summary, error cases, test levels, migration steps), endpoints are explicitly retained (contract details, backward-compat section), and the exact exception behavior on invocation is specified verbatim in the error-cases response — no component of c6 is dropped or contradicted elsewhere in the document."]}],"progress":{"status":"incomplete","phase":"complete","completedChunks":5,"totalChunks":5,"lastMeaningfulActivityAt":null,"activeToolCount":0,"requiresUserInput":false,"checkpointPath":"/home/subho/work/dev/insors/insrc/.insrc/tmp/design-review/remove-reviews-dae67bfc-lld.json","sequence":0,"reviewElapsedMs":0,"unitElapsedMs":null,"observedAt":"2026-11-16T12:22:05.493Z","freshness":"stored"},"startedAt":"2026-11-16T12:10:56.348Z","reviewer":"daemon","model":"claude-sonnet-5","unit":{"unitId":"final-consistency","phase":"chunk_review","executionId":"05b4e688-13f7-4097-8d03-e9fadfbf7231","dispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[]},"plan":{"chunks":[{"id":"scope-framing","title":"Scope, HLD context, contract surface, and framing","selectors":["/body/summary","/body/hldContextSlice","/body/contractDetails","/body/openQuestions","document:line:24","/citations/5"],"concerns":["Summary states removal scope (design+code review, keep endpoints as unavailable, retain historical artifacts/approval) matches stakeholder instruction c6 and actual repo structure under src/daemon and src/workflow.","Standalone framing (no HLD) is appropriate given triage sizeClass feature and standalone workflow kind; verify no epic/HLD ancestry is wrongly invoked.","Contract surface level 'public' with empty api[] — check whether omitting an explicit endpoint/method inventory in contractDetails.api leaves the actual preserved surface (MCP + daemon IPC method names) undocumented versus only named in prose (data model call sites, test strategy subjects).","openQuestions is empty — verify no outstanding design ambiguity (e.g., exact scope of 'legacy' endpoints, which daemon handlers are in-scope) was left unresolved without being surfaced."],"dependsOn":[],"purpose":"substantive"},{"id":"data-model-error-handling","title":"Data model changes, interaction with shared, and error paths","selectors":["/body/dataModelChanges","/body/interactionWithShared","/body/errorPaths","/citations/0","/citations/1","/citations/2","/citations/3","/citations/4"],"concerns":["Call sites listed (review-service.ts, threads/review-workers.ts, task-review-rpc.ts, code-review-rpc.ts, workflow-review-rpc.ts) should be verified against actual repo files/paths cited in references (c2 handler-runtime.ts:699-727, c3 design-review-rpc.ts, c4 task-review-rpc.ts, c5 review-unavailable.ts) for consistency — note c2/c3 are cited in References but not listed as call sites in 3.1, and c4's filename appears in both call sites and references while design-review-rpc.ts (c3) does not appear as a call site despite being a 'design' RPC file.","interactionWithShared is empty — for a standalone LLD removing cross-cutting daemon/MCP/workflow surfaces, verify whether any genuinely shared contract interaction (e.g., workflow approval gate, generic artifact viewer) should have been declared here rather than left implicit in errorPaths.","Error response mandates throwing one of two exact literal strings through 'existing IPC/MCP error transport' — verify this is achievable for every preserved endpoint uniformly (sync throw vs async RPC/MCP response wrapping) and that it doesn't silently swallow/relabel existing transport-level error codes needed by current IDE clients.","Edge case table covers resumable/legacy operations and malformed input, but does not explicitly address partially-completed in-flight sessions/workers at the moment of deployment (acknowledged partially in migration step 5's 'restart after authorized deployment' language) — check cross-reference adequacy.","Invariants cite c1 (analyze bundle) for both preserved endpoint schemas/client compatibility and preserved workflow core/artifact storage; verify the analyze bundle text (526 incoming/480 outgoing edges, incomplete coverage) actually supports a confident invariant claim or whether the stated 'graph coverage is incomplete' caveat undermines the invariant's certainty without a stated mitigation beyond migration step 1's audit."],"dependsOn":["scope-framing"],"purpose":"substantive"},{"id":"test-migration-strategy","title":"Test strategy and migration plan","selectors":["/body/testStrategy","/body/migration"],"concerns":["Acceptance mapping ties ac1/ac2/ac3 to named proving tests described only as prose subjects/fixtures, not concrete test file paths or Task-level detail — verify this level of detail is adequate for a standalone LLD or whether a PLAN-level decomposition was implicitly expected (PLAN is marked not applicable, so this LLD must be self-sufficient on acceptance traceability).","Migration steps 1-5 are sequenced (freeze inventory -> wire endpoints to exceptions -> delete implementation -> adapt approval/completion -> validate), but step 2 (detach live review startup/RPC/router ownership) and step 3 (delete review execution/runtime modules) both claim to be done 'in the same buildable change' / sequentially without specifying how the daemon avoids an intermediate broken state (dangling worker references) between steps 2 and 3 if split across commits.","Zero downtime is 'no' and migration step 5 requires restarting the daemon only after authorized deployment 'so in-flight old reviews are not interrupted without notice' — check this user-impact statement against errorPaths/edge-case table, which says ALL existing review-id/resumable/cancel/progress requests immediately get the rewritten exception with no resumption, which appears to contradict an implication that in-flight reviews could still progress until restart.","Backward compat section requires removing 'stale generated out/ review code' from build output/package — verify this concrete build-hygiene requirement is reflected in the test strategy's smoke level (npm run build check) as actual proof, not just implied."],"dependsOn":["data-model-error-handling"],"purpose":"substantive"},{"id":"alternatives-decision","title":"Alternatives considered and chosen approach","selectors":["/body/alternativesConsidered","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/chosenAlternative"],"concerns":["Alternative a1 (chosen) and a2 differ mainly on whether a dedicated adapter interface is retained; verify the rejection rationale for a2 ('unnecessarily retains a service interface') is substantive given that a1 itself retains 'one stateless error helper' delegated to by 'many preserved endpoints' (section 3.1), which is arguably a similar shared compatibility seam under a different name — check whether the distinction is clearly justified rather than cosmetic.","Both alternatives carry identical costEstimate 'L' with no quantified tradeoff beyond qualitative pros/cons — verify this is adequate given the removal touches ~five call sites plus MCP/daemon registries across two IDE clients, or whether the estimate undersells audit effort flagged elsewhere (migration step 1, step 3 'audit imports, packages, configuration and both current IDE clients')."],"dependsOn":["data-model-error-handling"],"purpose":"substantive"},{"id":"final-consistency","title":"Cross-section consistency and overall traceability","selectors":[],"concerns":["Check for contradictions between error-path guarantees (no runtime state, no provider calls, no checkpoint touches) and migration steps (which describe an interim state after step 2 but before step 3, and a non-zero-downtime restart) across the whole document.","Confirm every acceptance criterion (ac1-ac3) is traceable to a concrete error-path, data-model or test-strategy commitment, and that the single stated invariant source (c1) is not over-relied upon given its own 'incomplete coverage' caveat.","Confirm citations are consistently and correctly used: c2 (handler-runtime.ts) and c3 (design-review-rpc.ts) are listed in References but never inline-cited in body text via [[c2]]/[[c3]] markers, unlike c1; verify whether this is an authoring gap in traceability.","Confirm no requirement, acceptance criterion, or scope statement is orphaned relative to the user's original stakeholder instruction (c6): both design AND code review removed, endpoints kept, exception on invocation — check this is fully and consistently reflected end-to-end."],"dependsOn":["scope-framing","data-model-error-handling","test-migration-strategy","alternatives-decision"],"purpose":"consistency"}],"coverageExplanation":"Every inventory unit maps to at least one substantive chunk. Section-level units (summary, hldContextSlice, contractDetails, openQuestions, document:line:24) sit in scope-framing since they jointly establish what the Story covers and under what framework. dataModelChanges, interactionWithShared and errorPaths form one substantive chunk because the error-handling behavior is the direct consequence of the data-model ownership change, and they share supporting code citations (c1-c5, i.e. /citations/0 through /citations/4) that document call sites and the rewritten-error helper referenced in those same sections. testStrategy and migration are grouped since acceptance proof and rollout sequencing must be checked together for consistency between claimed behavior and verification steps. alternativesConsidered (plus its two sub-items /body/alternativesConsidered/0 and /1) and chosenAlternative form the decision-rationale chunk. The stakeholder citation (/citations/5, c6) is covered under scope-framing since it is the originating instruction that frames the whole Story's scope. The final consistency chunk has empty selectors (whole-document check) and depends on all four substantive chunks, so it does not substitute for their unit coverage but adds cross-chunk checks.","finalConsistencyChunkId":"final-consistency","coverage":[{"unitId":"/body/summary","chunkIds":["scope-framing"]},{"unitId":"/body/hldContextSlice","chunkIds":["scope-framing"]},{"unitId":"/body/contractDetails","chunkIds":["scope-framing"]},{"unitId":"/body/dataModelChanges","chunkIds":["data-model-error-handling"]},{"unitId":"/body/interactionWithShared","chunkIds":["data-model-error-handling"]},{"unitId":"/body/errorPaths","chunkIds":["data-model-error-handling"]},{"unitId":"/body/testStrategy","chunkIds":["test-migration-strategy"]},{"unitId":"/body/migration","chunkIds":["test-migration-strategy"]},{"unitId":"/body/alternativesConsidered","chunkIds":["alternatives-decision"]},{"unitId":"/body/chosenAlternative","chunkIds":["alternatives-decision"]},{"unitId":"/body/openQuestions","chunkIds":["scope-framing"]},{"unitId":"/body/alternativesConsidered/0","chunkIds":["alternatives-decision"]},{"unitId":"/body/alternativesConsidered/1","chunkIds":["alternatives-decision"]},{"unitId":"/citations/0","chunkIds":["data-model-error-handling"]},{"unitId":"/citations/1","chunkIds":["data-model-error-handling"]},{"unitId":"/citations/2","chunkIds":["data-model-error-handling"]},{"unitId":"/citations/3","chunkIds":["data-model-error-handling"]},{"unitId":"/citations/4","chunkIds":["data-model-error-handling"]},{"unitId":"/citations/5","chunkIds":["scope-framing"]},{"unitId":"document:line:24","chunkIds":["scope-framing"]}]},"unitSummaries":[{"unitId":"planning","phase":"planning","automaticDispatches":2,"retriesUsed":1,"userDirectedDispatches":0,"diagnostics":[{"code":"invalid_output","summary":"Unit /citations/0 lacks matching substantive coverage"}],"actionIds":[]},{"unitId":"scope-framing","phase":"chunk_review","automaticDispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[],"actionIds":[]},{"unitId":"data-model-error-handling","phase":"chunk_review","automaticDispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[],"actionIds":[]},{"unitId":"test-migration-strategy","phase":"chunk_review","automaticDispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[],"actionIds":[]},{"unitId":"alternatives-decision","phase":"chunk_review","automaticDispatches":2,"retriesUsed":1,"userDirectedDispatches":0,"diagnostics":[{"code":"invalid_output","summary":"Finding id test1 is already used"}],"actionIds":[]},{"unitId":"final-consistency","phase":"chunk_review","automaticDispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[],"actionIds":[]}],"report":{"reviewId":"remove-reviews-dae67bfc-lld","attempt":1,"artifactId":"LLD-dae67bfc7da310cc-s1","status":"incomplete","counts":{"HIGH":0,"MED":3,"LOW":1},"chunks":[{"chunkId":"scope-framing","status":"changes_requested","summary":"Summary and HLD-context framing are consistent with the stakeholder instruction and the repo's standalone/no-HLD status, and verified call sites (design-review-rpc.ts, task-review-rpc.ts, handler-runtime.ts:699-727, workflow-review-rpc.ts) confirm the described partial-retirement state. The main gap is contractDetails: the structured `api` field is left empty even though the entire design's load-bearing claim (ac1) is an exact preserved-endpoint inventory, and that inventory is not fully reconstructable from prose elsewhere in the document either.","findings":[{"id":"empty-contract-api-surface","severity":"MED","location":"/body/contractDetails (api: [])","message":"contractDetails.surfaceLevel is 'public' but contractDetails.api is empty, leaving the single most consequential claim of this LLD — the exact set of MCP/daemon endpoints that must keep working with unchanged schemas while being rewired to throw — undocumented in the designated structured field. The document scatters partial endpoint lists instead (Error-paths test subjects list insrc_review_step/insrc_code_review_step plus designReview.*, codeReview.task.*, codeReview.run, codeReview.grounding, codeReview.freshness, workflow.review/reviewArtifact/resolveFinding), and even that prose list is incomplete against the live code: handler-runtime.ts also registers 'workflow.reviewDecision' (src/workflow/review-decision.ts, approve/reject/feedback from the review pane) which is review-adjacent but not mentioned anywhere, so a reader cannot tell from the document alone whether it was deliberately scoped out or missed. Given ac1 is specifically 'preserved endpoint inventory and exact rewritten exception contract', this inventory should be enumerated once, completely, in contractDetails.api (or an equivalent explicit list), not left for the reader to reassemble from Test strategy and Error paths prose.","evidenceReferences":["/body/contractDetails","src/daemon/handler-runtime.ts:699-727 (designReview.*, codeReview.task.*, codeReview.grounding, codeReview.freshness)","src/daemon/handler-runtime.ts:656 (workflow.reviewDecision -> ../workflow/review-decision.js)","/body/testStrategy/testLevels/0/subjects"]}],"inspectedReferences":["/body/summary","/body/hldContextSlice","/body/contractDetails","/body/openQuestions","document:line:24","/citations/5","/home/subho/work/dev/insors/insrc/docs/standalone/remove-design-code-review-implementations-while-E20261116dae67bfc/S001/LLD.md","src/daemon/handler-runtime.ts:699-727","src/daemon/design-review-rpc.ts","src/daemon/task-review-rpc.ts","src/workflow/review-unavailable.ts","src/daemon/workflow-review-rpc.ts","src/mcp/design-review/handler.ts","src/workflow/review-decision.ts"],"limitations":[],"advice":["Consider whether 'workflow.reviewDecision' and the 'team.refresh/claim/release' human-review-pane endpoints are intentionally out of scope (they appear to be a distinct human-approval feature, not automated design/code review execution) and, if so, say so explicitly in contractDetails or the summary so reviewers and builders don't have to infer it.","openQuestions is empty and appears genuinely so for this chunk's concerns — the standalone/no-HLD framing and stakeholder-match are both well grounded; no unresolved ambiguity was found here beyond the endpoint-inventory completeness noted above."]},{"chunkId":"data-model-error-handling","status":"incomplete","summary":"test","findings":[{"id":"test1","severity":"LOW","location":"x","message":"y","evidenceReferences":["z"]}],"inspectedReferences":["a"],"limitations":["Required coverage not reported: /body/dataModelChanges","Required coverage not reported: /body/interactionWithShared","Required coverage not reported: /body/errorPaths","Required coverage not reported: /citations/0","Required coverage not reported: /citations/1","Required coverage not reported: /citations/2","Required coverage not reported: /citations/3","Required coverage not reported: /citations/4","Required coverage not reported: /home/subho/work/dev/insors/insrc/docs/standalone/remove-design-code-review-implementations-while-E20261116dae67bfc/S001/LLD.md"],"advice":[]},{"chunkId":"test-migration-strategy","status":"changes_requested","summary":"Test strategy and migration are mostly coherent and traceable to the stakeholder instruction, and the backward-compat build-hygiene claim (removing stale out/ review code) is already satisfied by the repo's existing scripts/clean-output.mjs, which wipes out/ before every tsc build. However, the migration's claim to \"detach live review startup, RPC service and router ownership integrations\" in step 2 names no owning module for that startup/shutdown wiring — the actual integration point (src/daemon/index.ts, constructing ProductionReviews/ThreadServices and driving shutdown) is absent from both the data-model call-site list and the migration steps, which is a real gap given how central that wiring is. The acceptance-mapping and zero-downtime/in-flight-review points raised in the chunk concerns are weaker — adequate for a PLAN-not-applicable standalone LLD and resolvable by a more careful reading, respectively — so I kept those as advisory rather than blocking.","findings":[{"id":"migration-missing-daemon-index-ownership","severity":"MED","location":"/body/migration (Steps, step 2) and /body/dataModelChanges (3.1 Call sites)","message":"Migration step 2 requires detaching 'live review startup, RPC service and router ownership integrations' 'in the same buildable change' as wiring endpoints to exceptions, and the state-after claims 'No engines, review-specific runtime resource ownership, preparation, worker processes... execute.' But neither the data-model call-site list (3.1: review-service.ts, threads/review-workers.ts, task-review-rpc.ts, code-review-rpc.ts, workflow-review-rpc.ts) nor the migration steps name src/daemon/index.ts, which is the actual module that constructs the review runtime at daemon startup (ThreadServices for reviews, `new ProductionReviews({services:reviewServices,...})`, `installProductionReviews(reviews)`), wires it into the shared progress runtime (`registerReviewProducers`), and owns its shutdown (`reviews.stopAdmission(); reviewClosing=reviews.shutdown()`). Because this file is the one place worker/service lifecycle is actually started and torn down, omitting it from both the call-site inventory and the migration steps leaves the single most consequential piece of 'detach live review startup... ownership' work undocumented — a builder following only the LLD's named call sites could leave daemon startup still constructing the full review runtime (ThreadServices, ProductionReviews, worker tracking) even after endpoints are rewired to throw, contradicting the 'no worker processes... execute' state-after claim.","evidenceReferences":["src/daemon/index.ts:274 (ThreadServices construction for reviews)","src/daemon/index.ts:420-428 (new ProductionReviews(...), installProductionReviews(reviews))","src/daemon/index.ts:515 (registerReviewProducers(runtime.coordinator) wired into shared progress runtime)","src/daemon/index.ts:676,695 (reviews.stopAdmission(); reviewClosing=reviews.shutdown())","/body/dataModelChanges/0/callSites","/body/migration/migrationSteps/1"]}],"inspectedReferences":["/body/testStrategy","/body/migration","/home/subho/work/dev/insors/insrc/docs/standalone/remove-design-code-review-implementations-while-E20261116dae67bfc/S001/LLD.md","/home/subho/work/dev/insors/insrc/.insrc/tmp/design-review/remove-reviews-dae67bfc-lld.json","src/daemon/index.ts","src/daemon/review-service.ts","src/daemon/task-review-rpc.ts","src/workflow/review-unavailable.ts","package.json","scripts/clean-output.mjs"],"limitations":[],"advice":["Acceptance mapping (ac1/ac2/ac3) ties criteria to prose subject descriptions that largely restate the corresponding test level's purpose rather than naming concrete test files/assertions. Given PLAN is not applicable for this standalone LLD, this is acceptable as design-level traceability (file-level test mapping is properly a build-time concern, matching the build gate's own test-mapping mechanism), but tightening the acceptance-mapping column to point at specific planned test files (even if not yet written) would strengthen self-sufficiency.","The apparent tension between 'restart the daemon only after authorized deployment so in-flight old reviews are not interrupted without notice' (migration step 5) and the edge-case table's 'same rewritten exception; no old runtime recovery' for resumable/cancel/progress requests is resolvable: the former is about giving operational notice before a restart that will interrupt in-flight sessions, not about in-flight sessions surviving the restart. Consider rewording step 5 slightly (e.g. 'so operators and clients are given notice before in-flight old reviews are interrupted') to remove the ambiguity for a future reader.","The backward-compat requirement to remove stale generated out/ review code is already satisfied by the existing scripts/clean-output.mjs (invoked at the start of `npm run build`), so the smoke-level 'npm run build' check in the test strategy already exercises it; no change needed, just noting the traceability is sound."]},{"chunkId":"alternatives-decision","status":"passed","summary":"Alternatives a1 (chosen) and a2 are substantively distinct, not a cosmetic relabeling: a1's \"stateless error helper\" (3.1) is a single shared function directly invoked by endpoint handlers with their own existing input types, while a2's rejected \"adapter exposing the former service interface\" requires defining and maintaining a class/interface that mimics every method of the former review service, plus RPC wrappers that keep a service-shaped dependency on it. That is a real extra abstraction layer the design correctly avoids, so the stated rejection reason (\"unnecessarily retains a service interface after deleting functionality\") is grounded rather than arbitrary. The identical costEstimate \"L\" on both alternatives is plausible rather than an oversight, since the dominant cost driver named elsewhere in the document (migration step 3's \"audit imports, packages, configuration and both current IDE clients,\" step 1's endpoint/schema inventory) is the same exhaustive-audit work regardless of which shape the compatibility seam takes; the document just does not say so explicitly. Neither point rises to a demonstrated defect in the chosen design or its documented rationale.","findings":[],"inspectedReferences":["/body/alternativesConsidered","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/chosenAlternative","/home/subho/work/dev/insors/insrc/docs/standalone/remove-design-code-review-implementations-while-E20261116dae67bfc/S001/LLD.md","/body/dataModelChanges","section 3.1 Review runtime ownership call sites"],"limitations":[],"advice":["Consider adding one sentence to the a1/a2 comparison spelling out that a1's helper is a plain function invoked ad hoc by handlers (no shared type contract to keep in sync) whereas a2's adapter must replicate every former service method's signature as a typed interface — the distinction is real but currently requires the reader to infer it from differing prose (\"stateless error helper\" vs \"adapter exposing the former service interface\") rather than a stated comparison.","Consider noting briefly why costEstimate is identical ('L') for both alternatives — e.g. that the dominant cost is the shared endpoint/import audit (migration steps 1 and 3) rather than the adapter-vs-helper implementation choice itself — so a reader doesn't read the tie as an unexamined estimate."]},{"chunkId":"final-consistency","status":"incomplete","summary":"The document's own cross-section traceability holds up well for the error-path vs. migration sequencing question, the ac1-ac3 mapping, and the end-to-end reflection of the stakeholder instruction (c6) — no new contradictions found there. However, one dependency chunk this consistency check relies on (data-model-error-handling) contains placeholder/toy content rather than a genuine review (summary \"test\", finding id \"test1\" at location \"x\" with message \"y\"/evidence \"z\", and its own limitations admit required coverage of /body/dataModelChanges, /body/interactionWithShared, /body/errorPaths and citations c1-c4 was \"not reported\"). That chunk's own plan explicitly intended to check the citation/call-site concern this final chunk is also asked to verify, so I verified it independently: section 3.1's \"Call sites\" list omits both src/daemon/design-review-rpc.ts (c3) and src/daemon/handler-runtime.ts (c2) even though handler-runtime.ts:699-708 dispatches every designReview.* operation straight into design-review-rpc.ts, and the parallel files task-review-rpc.ts (c4) and code-review-rpc.ts are both included in that same list — a real, document-internal inconsistency in the data model's ownership/call-site inventory, not a cosmetic citation-marker gap. Because the data-model-error-handling chunk's output cannot be relied on, the full extent of cross-chunk reconciliation for dataModelChanges/errorPaths/citations c1-c4 (including whether the invariants' sole reliance on c1 given its own 'incomplete coverage' caveat is adequately mitigated beyond migration step 1's audit) could not be completed from accepted feedback alone and is reported as a limitation rather than assumed resolved.","findings":[{"id":"call-sites-omit-review-rpc-and-dispatch-files","severity":"MED","location":"/home/subho/work/dev/insors/insrc/docs/standalone/remove-design-code-review-implementations-while-E20261116dae67bfc/S001/LLD.md section 3.1 'Call sites' (lines 39-45) vs section 8 'References' (lines 130-137)","message":"Section 3.1 ('Review runtime ownership') lists five call sites — review-service.ts, threads/review-workers.ts, task-review-rpc.ts, code-review-rpc.ts, workflow-review-rpc.ts — but omits src/daemon/design-review-rpc.ts (cited as c3) and src/daemon/handler-runtime.ts (cited as c2, lines 699-727). This is inconsistent on its face: handler-runtime.ts:699-708 is the actual dispatch table that routes every designReview.start/cancel/progress/assignment/plan/impact/activity/result/recover/failure RPC method into design-review-rpc.ts's designReviewOperation function, exactly mirroring how task-review-rpc.ts (c4, included in 3.1) and code-review-rpc.ts (included in 3.1) are the dispatch targets for their own RPC families. Since 3.1 is the single place this LLD declares which modules own/create the runtime review state being deleted, and since the design-review family is explicitly in scope per the stakeholder instruction (c6), omitting its dispatch file and its RPC implementation file from the call-site inventory leaves the data model's 'Review runtime ownership' entity incomplete relative to its own References section and its own stated migration step 3 ('audit imports... delete review execution/runtime modules').","evidenceReferences":["/body/dataModelChanges/0/callSites","/citations/1 (c2: src/daemon/handler-runtime.ts:699-727)","/citations/2 (c3: src/daemon/design-review-rpc.ts)","src/daemon/handler-runtime.ts:699-708 (designReview.* -> design-review-rpc.ts designReviewOperation)","/home/subho/work/dev/insors/insrc/docs/standalone/remove-design-code-review-implementations-while-E20261116dae67bfc/S001/LLD.md"]}],"inspectedReferences":["/home/subho/work/dev/insors/insrc/docs/standalone/remove-design-code-review-implementations-while-E20261116dae67bfc/S001/LLD.md","/home/subho/work/dev/insors/insrc/.insrc/tmp/design-review/remove-reviews-dae67bfc-lld.json","src/daemon/handler-runtime.ts:699-708","src/daemon/design-review-rpc.ts","/body/dataModelChanges/0/callSites","/body/errorPaths","/body/migration","/citations/5 (c6)"],"limitations":["The accepted feedback for the 'data-model-error-handling' chunk (recorded in the checkpoint) is placeholder/toy content — status 'incomplete', summary literally 'test', a single finding with id 'test1', location 'x', message 'y', evidence 'z' — and its own limitations list required coverage as 'not reported' for /body/dataModelChanges, /body/interactionWithShared, /body/errorPaths and /citations/0 through /citations/4. That chunk's plan intended to check whether the invariants' sole reliance on citation c1 is adequate given c1's own acknowledged 'incomplete graph coverage' caveat, and whether other citations (c2-c5) are properly reflected in the data model and error paths beyond the one call-site/dispatch-file gap I verified independently above. Because no genuine chunk review exists for that area, I cannot confirm this concern was fully reconciled across the whole document from accepted feedback alone, and a fresh substantive review of that chunk's scope is needed before this consistency check can be considered complete."],"advice":["Have the data-model-error-handling chunk re-run as a genuine review (its current accepted feedback is placeholder data and should not be treated as having verified anything about dataModelChanges, interactionWithShared, errorPaths, or citations c1-c4).","When section 3.1's call-site list is corrected, also add design-review-rpc.ts and handler-runtime.ts so the 'Review runtime ownership' entity's call sites are symmetric with the References section and with the already-included task-review-rpc.ts/code-review-rpc.ts pair — this directly supports migration step 3's audit and ac2's 'import/deletion audit' acceptance criterion.","The apparent tension between error-path guarantees (no runtime state/provider calls/checkpoint touches on any invocation) and migration's non-zero-downtime restart (step 5) is not a real contradiction: the guarantees apply once the rewritten code is deployed and running, while step 5's notice-before-restart language is about the old binary's in-flight sessions prior to that deployment taking effect — this is already the interpretation the test-migration-strategy chunk reached, and I found no cross-chunk disagreement with it.","ac1-ac3 each trace to a concrete commitment (ac1 to the error-path exact-exception response plus the endpoint-name/schema preservation invariant; ac2 to the 'no runtime state/provider calls' response and migration steps 2-3; ac3 to the second error case and migration step 4's override-only approval behavior) — no orphaned acceptance criterion found, modulo the already-flagged (scope-framing chunk) gap that the concrete endpoint list proving ac1 is not enumerated in contractDetails.api.","c6 (the stakeholder instruction) is fully and consistently reflected: both design and code review are named throughout (summary, error cases, test levels, migration steps), endpoints are explicitly retained (contract details, backward-compat section), and the exact exception behavior on invocation is specified verbatim in the error-cases response — no component of c6 is dropped or contradicted elsewhere in the document."]}],"limitations":["Required coverage not reported: /body/dataModelChanges","Required coverage not reported: /body/interactionWithShared","Required coverage not reported: /body/errorPaths","Required coverage not reported: /citations/0","Required coverage not reported: /citations/1","Required coverage not reported: /citations/2","Required coverage not reported: /citations/3","Required coverage not reported: /citations/4","Required coverage not reported: /home/subho/work/dev/insors/insrc/docs/standalone/remove-design-code-review-implementations-while-E20261116dae67bfc/S001/LLD.md","The accepted feedback for the 'data-model-error-handling' chunk (recorded in the checkpoint) is placeholder/toy content — status 'incomplete', summary literally 'test', a single finding with id 'test1', location 'x', message 'y', evidence 'z' — and its own limitations list required coverage as 'not reported' for /body/dataModelChanges, /body/interactionWithShared, /body/errorPaths and /citations/0 through /citations/4. That chunk's plan intended to check whether the invariants' sole reliance on citation c1 is adequate given c1's own acknowledged 'incomplete graph coverage' caveat, and whether other citations (c2-c5) are properly reflected in the data model and error paths beyond the one call-site/dispatch-file gap I verified independently above. Because no genuine chunk review exists for that area, I cannot confirm this concern was fully reconciled across the whole document from accepted feedback alone, and a fresh substantive review of that chunk's scope is needed before this consistency check can be considered complete."],"reviewer":"daemon","reviewedContentIdentity":"415b6db7c8b61601171689d894cf571ee139861635bf1d0e25606967f12df0a0"},"finishedAt":"2026-11-16T12:22:05.493Z","publication":{"reviewId":"remove-reviews-dae67bfc-lld","attempt":1,"state":"pending"},"submitted":{"artifactPath":"/home/subho/work/dev/insors/insrc/.insrc/artifacts/LLD-dae67bfc7da310cc-s1.json","attempt":1},"actionId":"start-1","operation":"start","acceptedAt":"2026-11-16T12:10:56.348Z","resourceGuard":{"daemonInstance":"47d1d69b-f31e-4ea1-87cb-64613c5efece","openLeases":[]}}],"admissionFailures":[]}}}}
