535969	{"artifactId":"LLD-e4af63128c7cbec2-s1","entry":{"id":"1caa63dca46edc88c33d97beafc0ddce487a41ad910b375e8fcacd9f6a2eaa81","targetHeadHash":"c07427ff2bf2491c588574e3445c1079c9306375b1f3dce6ec6c25f44b6f467c","actor":{"id":"agent:design-review-daemon","kind":"agent","properties":{"party":"daemon"}},"timestamp":"2026-11-09T05:29:06.173Z","operation":"review","revision":{"number":3,"contentHash":"75676e0b76ae5f8aac40c39e690932438e9b7e6bdd0876227c01203eeaf75def"},"outcome":{"result":"block","summary":"Design review review-worker-isolation-lld-20261109 attempt 3","data":{"kind":"design-chunk-review","schemaVersion":1,"reviewId":"review-worker-isolation-lld-20261109","project":"/home/subho/work/dev/insors/insrc","artifactId":"LLD-e4af63128c7cbec2-s1","subject":{"project":"/home/subho/work/dev/insors/insrc","artifactId":"LLD-e4af63128c7cbec2-s1","kind":"LLD","canonicalPath":"/home/subho/work/dev/insors/insrc/.insrc/artifacts/LLD-e4af63128c7cbec2-s1.json","documentPath":"/home/subho/work/dev/insors/insrc/docs/standalone/isolate-each-code-design-review-its-E20261109e4af6312/S001/LLD.md","reviewer":"daemon","workflow":{"kind":"issue","rootArtifactId":"ISSUE-e4af63128c7cbec2","requiredReferences":[{"role":"originating_issue","artifactId":"ISSUE-e4af63128c7cbec2","path":"/home/subho/work/dev/insors/insrc/docs/standalone/isolate-each-code-design-review-its-E20261109e4af6312/ISSUE.md"}],"availableReferences":[],"notApplicableRoles":["PLAN","TASKS","BUILD","CR","DEF","HLD","sibling_stories"]}},"submitted":{"artifactPath":"/home/subho/work/dev/insors/insrc/.insrc/artifacts/LLD-e4af63128c7cbec2-s1.json","attempt":1},"reviewer":"daemon","attempts":[{"number":1,"status":"incomplete","preparationKind":"planning","baseline":{"subjectFingerprints":{"canonical":"f756675f5491651a6ae31f571d49e01d50e17b71093d1ca48b82cc1533860453","document":"31689f930d7cecb7433b1f11a94e8dfbbd8ad04447da7285287c806706cd3c28"},"contentIdentity":"c24c6ad9f1ee0109aaf1511cf9e00922b019feffecf34235c44d004f9960027f","reviewedContent":{"canonical":"{\n  \"meta\": {\n    \"workflow\": \"design.story\",\n    \"runId\": \"wf-1794198632679-vj371t\",\n    \"repoPath\": \"/home/subho/work/dev/insors/insrc\",\n    \"createdAt\": \"2026-11-09T04:39:31.815Z\",\n    \"epicCreatedAt\": \"2026-11-09T04:29:20.389Z\",\n    \"attribution\": {\n      \"outputs\": [\n        {\n          \"role\": \"(client)\",\n          \"tier\": \"core\",\n          \"runner\": \"cli-codex\",\n          \"model\": \"unknown\"\n        }\n      ]\n    },\n    \"elapsedMs\": 536232,\n    \"repoIndexedAt\": null,\n    \"schemaVersion\": 1,\n    \"epicHash\": \"e4af63128c7cbec2\",\n    \"epicSlug\": \"isolate-each-code-design-review-its\",\n    \"storyId\": \"s1\",\n    \"hldBaseRunId\": \"wf-1794198632679-vj371t\",\n    \"hldEffectiveHash\": \"6d5c2ef6c93ae81b8446135a783926720589ae3e588f330dd3a10a6564dc64a2\",\n    \"hldAmendmentsApplied\": [],\n    \"storyTitle\": \"Isolate each code and design review in its own worker thread\",\n    \"standalone\": true,\n    \"sizeClass\": \"feature\",\n    \"authoredBy\": \"controller\",\n    \"revision\": 1\n  },\n  \"body\": {\n    \"summary\": {\n      \"audience\": \"technical\",\n      \"prose\": \"Each code or design review runs in a dedicated daemon-owned worker, independent of chat-session threads and other reviews. Submission is durably acknowledged before expensive scope/subject admission, with progress and technical failures visible throughout. Existing review coordinators, judging policies, trusted controller ownership and human approval gates remain authoritative; this change relocates execution and adds the missing admission lifecycle.\"\n    },\n    \"hldContextSlice\": {\n      \"frameworkSummary\": \"Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\",\n      \"ownedContracts\": [],\n      \"consumedContracts\": [],\n      \"boundary\": {\n        \"storyId\": \"s1\",\n        \"owns\": [],\n        \"depends\": [],\n        \"internal\": \"Isolate each code and design review in its own worker thread\"\n      },\n      \"adjacentBoundaries\": [],\n      \"rolloutPhase\": \"standalone\",\n      \"nonFunctional\": {}\n    },\n    \"contractDetails\": {\n      \"surfaceLevel\": \"internal-shared\",\n      \"api\": [\n        {\n          \"name\": \"startTaskReview\",\n          \"signature\": \"startTaskReview(raw: unknown, trusted?: TrustedRpcContext, deps?: TaskReviewRpcDeps): Promise<unknown>\",\n          \"parameters\": [\n            {\n              \"name\": \"raw\",\n              \"type\": \"unknown\",\n              \"purpose\": \"Existing code-review request; structurally validate bounded repo/reviewId/attempt/pinned packet before dispatch.\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"trusted\",\n              \"type\": \"TrustedRpcContext\",\n              \"purpose\": \"Host-supplied caller and controller lifetime authority; never accepted from request fields.\",\n              \"optional\": true\n            },\n            {\n              \"name\": \"deps\",\n              \"type\": \"TaskReviewRpcDeps\",\n              \"purpose\": \"Existing test/provider seam; test workers use explicit serializable fixtures rather than cloning closures.\",\n              \"optional\": true\n            }\n          ],\n          \"returns\": {\n            \"type\": \"Promise<unknown>\",\n            \"meaning\": \"Existing acknowledgment identity/path/reviewer fields with status pending once the worker has durably saved an admission-phase attempt; this acknowledges submission, not verified scope. Progress reports scope_preparation with task null until attribution is known. Admission failure is terminal technical feedback, never passed review.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"TaskReviewError\",\n              \"condition\": \"Malformed/oversized request, unregistered/noncanonical repo, wrong owner, conflicting review identity or worker boot/persistence failure before durable acknowledgment.\"\n            }\n          ],\n          \"preconditions\": [\n            \"Approved source route and author-party checks are preserved, with authority determined by host data rather than caller claims.\",\n            \"Main registry reserves canonical repo + review family + reviewId; both review families also retain existing subject/cleanup exclusions.\"\n          ],\n          \"postconditions\": [\n            \"Expensive committed-source reads/projection and all coordinator execution occur on the dedicated review worker.\",\n            \"No model call is dispatched before full source/route admission succeeds.\",\n            \"Daemon review remains live after submitter disconnect; controller-review owner disconnect retains existing explicit recovery requirements.\"\n          ]\n        },\n        {\n          \"name\": \"designReviewStep\",\n          \"signature\": \"designReviewStep(raw: unknown, trusted?: TrustedRpcContext, deps?: DesignReviewRpcDeps): Promise<unknown>\",\n          \"parameters\": [\n            {\n              \"name\": \"raw\",\n              \"type\": \"unknown\",\n              \"purpose\": \"Existing design start/recover/progress/controller exchange with unchanged artifact workflow requirements.\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"trusted\",\n              \"type\": \"TrustedRpcContext\",\n              \"purpose\": \"Host-only controller identity/lifetime and client model-selection context.\",\n              \"optional\": true\n            },\n            {\n              \"name\": \"deps\",\n              \"type\": \"DesignReviewRpcDeps\",\n              \"purpose\": \"Preserved dependency injection boundary.\",\n              \"optional\": true\n            }\n          ],\n          \"returns\": {\n            \"type\": \"Promise<unknown>\",\n            \"meaning\": \"Start/recover acknowledges a durable admission-phase submission before expensive subject/history checks. Progress and exchange requests route to that review worker; completed results remain read-only when the worker has exited.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"DesignReviewError\",\n              \"condition\": \"Existing subject/owner/action conflict, malformed request, unavailable worker or admission persistence failure. Post-ack technical errors are stored and returned by progress.\"\n            }\n          ],\n          \"preconditions\": [\n            \"Artifact subject resolves to registered repo and host-authorized path; design artifact lease remains process-wide despite moving coordinator state into workers.\",\n            \"Main bridge validates connection identity and action envelope; workers cannot mint caller authority.\"\n          ],\n          \"postconditions\": [\n            \"Planning, chunk execution, impact/recovery analysis and publication execute only in the owner worker.\",\n            \"Existing latest-artifact monitoring, user-directed restart policy and bounded technical retries remain unchanged.\",\n            \"Code and design review method routes cannot silently fall back to main/session execution, including when optional session threading is disabled.\"\n          ]\n        }\n      ]\n    },\n    \"dataModelChanges\": [\n      {\n        \"entity\": \"Per-review worker ownership registry\",\n        \"change\": \"new\",\n        \"details\": \"Proposed src/daemon/threads/review-workers.ts and src/daemon/threads/review-worker.ts host one existing family coordinator per canonical (repo,family,reviewId). Reuse startWorker, workerScript, startDaemonWorker, HubClient, serveRequests, status-board and supervisor hooks. The registry owns 0..N active worker entries; each active entry owns exactly one worker and one review identity; a worker owns exactly one review, never a pool or a session. An attempt sequence reuses its live owner; after termination, explicit resume/recover/publication retry may spawn a replacement only after the prior worker is gone and its resources are reclaimed. Main registry entries hold threadId, worker incarnation, family, repo, reviewId, attempt, subject/cleanup scope, trusted owner bridge, last published bounded progress and reclaimed promise. These are process-lifetime routing facts, not a second durable review ledger. Use a worker incarnation tied to the registered MessagePort to reject stale exit/progress/result messages; clients cannot supply it. Do not use startClassWorker's singleton class target for per-review routing. Add a review role/identity to existing thread registry/status types where needed, and carry existing session attribution for diagnostics without attaching the worker lifetime to the chat worker.\",\n        \"callSites\": [\n          \"src/daemon/threads/workers.ts\",\n          \"src/daemon/threads/worker-entry.ts\",\n          \"src/daemon/threads/channel.ts\",\n          \"src/daemon/threads/router.ts\",\n          \"src/daemon/threads/status-board.ts\",\n          \"src/daemon/threads/supervisor.ts\"\n        ]\n      },\n      {\n        \"entity\": \"Durable admission-phase checkpoint attempt\",\n        \"change\": \"field-add\",\n        \"details\": \"Extend each family's checkpoint attempt contract with an explicit admission variant rather than creating sidecar packet files or a second authoritative store. Existing admitted attempts retain their current submitted/review-response form and immutable history; historical current-format checkpoints remain readable without rewriting their reviewed content. An admission variant contains the existing immutable submitted input once, attempt number/review identity, operation/action identity, acceptedAt, status pending|running|failed|interrupted, bounded progress, source-validation state unverified, and optional typed technical error. Task/chunk selection and source fingerprints are absent until actually established; absence is not empty successful scope. It cannot carry review findings, a passing verdict, accepted scope or an approval binding. Worker saves this variant atomically before acknowledgment, then qualifies route, pins, source history, subject and capacity using current checks. On success atomically replace the same current attempt with the ordinary admitted variant, transferring the same submitted input and retaining admission timing; only then permit provider work. On failure retain the admission variant and exact input with a bounded code/field/summary. Readers, recovery, capacity and cleanup must discriminate both variants before accessing task/chunk fields. The schema/version gate must advertise the new format; updated readers accept existing qualified history, while an older binary must refuse unsupported admission variants rather than misread them as successful review. Failed admission consumes its attempt identity: corrected inputs require the next explicit attempt; identical interrupted admission resumes only via existing explicit resume/recover semantics. No automatic inference retry and no same-attempt input replacement.\",\n        \"schemaDiff\": \"CheckpointAttempt = AdmissionAttempt | ExistingQualifiedAttempt; AdmissionAttempt.phase='admission'; validation='unverified'; submitted remains exact and bounded. Only ExistingQualifiedAttempt may own accepted task/chunk scope, finalScope identity or BUILD/artifact approval binding. Format capability/version must be updated in registered schema and readers.\",\n        \"callSites\": [\n          \"src/workflow/code-review/task-review/coordinator.ts\",\n          \"src/workflow/code-review/task-review/admission.ts\",\n          \"src/workflow/code-review/task-review/checkpoint.ts\",\n          \"src/workflow/code-review/task-review/contracts.ts\",\n          \"src/workflow/review/design-review/checkpoint.ts\",\n          \"src/workflow/review/design-review/contracts.ts\",\n          \"src/workflow/review/design-review/coordinator.ts\"\n        ]\n      },\n      {\n        \"entity\": \"Submission and acknowledgment ordering\",\n        \"change\": \"invariant-change\",\n        \"details\": \"Sequence: caller -> main existing MCP/RPC adapter -> cheap canonical identity/size/trusted-owner validation and atomic in-memory review reservation -> start one registered worker -> worker structural validation and atomic admission-checkpoint save -> durable-submission acknowledgment -> worker expensive admission -> ordinary qualified checkpoint -> existing family execution -> publication -> bounded final progress -> worker drain/reclaim. Failure before durable save is returned synchronously and releases reservation after worker exit; no acknowledgment is claimed. Response loss after save is discoverable by progress and identical submission replay returns the existing acknowledgment without rerunning work; changed payload for the same pinned attempt is rejected. Observation by another session does not steal controller authority. Main can serve cached worker progress during expensive admission; cache is a bounded projection of durable state with freshness/time and must not fabricate progress. A worker that never completes startup returns a named start failure under existing worker startup supervision, with no silent main-thread fallback. Reuse scope_preparation/task-null for code admission progress; map design admission to an explicit pre-plan state in its reader contract. Clients must display pending admission and distinguish it from completed empty scope.\",\n        \"callSites\": [\n          \"src/daemon/task-review-rpc.ts\",\n          \"src/daemon/design-review-rpc.ts\",\n          \"src/daemon/threads/router.ts\",\n          \"src/daemon/threads/channel.ts\",\n          \"src/workflow/code-review/task-review/progress.ts\",\n          \"src/workflow/review/design-review/progress.ts\"\n        ]\n      },\n      {\n        \"entity\": \"Trusted controller and tool context bridge\",\n        \"change\": \"invariant-change\",\n        \"details\": \"Keep host connection authority and controller action validation in main-daemon entrypoints. AbortSignal, closures, providers and live sockets are not structured-cloned. Main creates an internal owner handle bound to authenticated connection identity and registered worker port; worker reconstructs a local AbortController from explicit owner-loss/cancellation notifications. Carry only bounded serializable client/model context and existing action/execution/sequence envelopes. Use existing nested routing for daemon-owned services, approved tool execution and permission requests; worker tools preserve existing checks, callbacks and source provenance. A review worker may receive only its own review's exchanges; verify repo/family/reviewId/attempt, worker incarnation and controller owner before forwarding. Untrusted fields cannot impersonate a controller or choose reviewer party. Controller disconnect interrupts only that review according to current protocol; daemon-authored/background reviewer execution survives observer disconnect. Main keeps durable subject/cleanup authority coherent across review workers; global design-artifact leases cannot remain worker-local module globals. Use existing review-state/host ownership services for cross-worker fencing, not new user trust keys.\",\n        \"callSites\": [\n          \"src/daemon/task-review-rpc.ts\",\n          \"src/daemon/design-review-rpc.ts\",\n          \"src/daemon/threads/review-state-contract.ts\",\n          \"src/daemon/threads/main-services.ts\",\n          \"src/daemon/threads/worker-requests.ts\",\n          \"src/daemon/threads/router.ts\"\n        ]\n      },\n      {\n        \"entity\": \"Recovery, publication and approval readers\",\n        \"change\": \"invariant-change\",\n        \"details\": \"Preserve existing task/chunk semantics and permanent CR/design report history. Technical admission failure is rendered as admission failure with no model/task/chunk verdict; add a bounded explicitly non-review admission-failure history section to the existing report contracts where needed so next attempts can retain it without manufacturing task results. Only admitted whole-story/current-artifact independent passing evidence can satisfy approval. Failed admission never binds BUILD or invalidates a prior approval as newly reviewed content. Progress/read-only history remain accessible after worker exit from atomic checkpoints/permanent reports; readers discriminate admission variants without rerunning Git qualification. Publication retries start a dedicated recovery worker if necessary, consume durable feedback only and do not redispatch models. Cleanup after successful approval first fences the specific existing story/artifact scope across workers, drains or refuses active admission/execution/publication, then uses existing evidence-preserving deletion rules in a dedicated worker; never broad-delete other review files. Historical retry/approval paths that currently requalify checkpoints synchronously must route the costly work to that worker too. An already-published review read should not spawn a provider.\",\n        \"callSites\": [\n          \"src/workflow/code-review/task-review/admission.ts\",\n          \"src/workflow/code-review/task-review/coordinator.ts\",\n          \"src/workflow/code-review/task-review/progress-view.ts\",\n          \"src/workflow/review/design-review/coordinator.ts\",\n          \"src/workflow/review/design-review/checkpoint.ts\",\n          \"src/workflow/review/design-review/publication.ts\",\n          \"src/workflow/review/design-review/cleanup.ts\",\n          \"src/daemon/threads/review-state-contract.ts\"\n        ]\n      },\n      {\n        \"entity\": \"Worker exit and resource ownership\",\n        \"change\": \"invariant-change\",\n        \"details\": \"One supervisor owns each review worker's runtime lifetime. Completion drains saves/publication and native provider/tool children before terminating the worker; release registry/subject/cleanup reservations only after exit and lock/store reclamation. On unexpected worker death, main marks only its cached projection interrupted, leaves the last atomic checkpoint intact, and reports explicit recovery required. The next explicit resume/recover starts one replacement only after prior worker and process resources are fenced/reclaimed; it re-reads the latest checkpoint and preserves accepted task/chunk results. During admission there are no provider children; interruption retains exact unverified input. Do not fabricate family feedback or task completion on worker crash. Use existing provider/process cleanup capabilities, never PID-kill fallbacks; prove child disposal before replacement can dispatch another provider. Daemon shutdown drains/stops all review workers through existing supervisor lifecycle and leaves recoverable checkpoints. Required review workers operate even when optional chat/session-worker routing is disabled; inability to initialize necessary safe worker services is an explicit unavailable error, never legacy execution. OS worker-resource failures are explicit and targeted; no new review pool, global review serialization or activation flag.\",\n        \"callSites\": [\n          \"src/daemon/threads/workers.ts\",\n          \"src/daemon/threads/worker-entry.ts\",\n          \"src/daemon/threads/supervisor.ts\",\n          \"src/daemon/threads/main-services.ts\",\n          \"src/workflow/code-review/task-review/coordinator.ts\",\n          \"src/workflow/review/design-review/coordinator.ts\"\n        ]\n      },\n      {\n        \"entity\": \"Files and scope boundaries\",\n        \"change\": \"invariant-change\",\n        \"details\": \"Proposed new runtime files are src/daemon/threads/review-workers.ts (owner registry/dispatch) and src/daemon/threads/review-worker.ts (single-review worker entrypoint); add focused tests under src/daemon/threads/__tests__. Adapt existing main review RPC adapters, router/method classification/supervisor/status types, family checkpoint/admission/read/publication/cleanup contracts and MCP progress readers/schemas as required. Test families remain existing code/design modules, not a third engine. Live VS Code and JetBrains clients must tolerate/render admission progress and preserve IPC method names/payload identities if shared DTOs change; no deprecated insrc-ide work. No token-accounting code, review judgment algorithm changes, timeout expansion, projection budget increases/optimization, or automatic restarting of another session's reviews. The current TU1 S1 64MiB failure still requires a separately bounded valid scope/implementation correction; worker isolation makes it visible rather than fixing that limit.\",\n        \"callSites\": [\n          \"src/daemon/threads/router.ts\",\n          \"src/daemon/threads/method-class.ts\",\n          \"src/daemon/task-review-rpc.ts\",\n          \"src/daemon/design-review-rpc.ts\"\n        ]\n      }\n    ],\n    \"interactionWithShared\": [],\n    \"errorPaths\": {\n      \"errorCases\": [\n        {\n          \"scenario\": \"Malformed, oversized, wrong-repository or forged-owner submission\",\n          \"detection\": \"Existing schema/size guards plus canonical repo and trusted host identity checks fail before worker dispatch or worker durable save.\",\n          \"response\": \"Return existing typed refusal; do not claim durable acceptance, start a provider or create an approval binding. Reclaim any failed bootstrap worker before release.\",\n          \"userImpact\": \"Actionable refusal without hidden review work.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Worker cannot boot or admission checkpoint cannot be saved\",\n          \"detection\": \"Worker startup error/exit or rejected atomic checkpoint write before acknowledged persistence.\",\n          \"response\": \"Return worker-start/admission-storage error, retain any prior history, wait for targeted resource reclamation and release reservation. Never fall back to main/session execution.\",\n          \"userImpact\": \"Submission is not accepted; explicit retry is safe after cause is corrected.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Expensive admission rejects pins, source projection, subject or capacity after acknowledgment\",\n          \"detection\": \"Existing family qualification checks throw; including current projection decoded-byte/operation limits.\",\n          \"response\": \"Persist terminal admission failure with exact immutable request and bounded diagnostic; no provider dispatch and no synthetic task/chunk result. Progress/read/report clearly identifies technical admission failure. A changed input needs a new explicit sequential attempt.\",\n          \"userImpact\": \"Failure remains discoverable after MCP return; scope is not silently weakened.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Duplicate start or acknowledgment lost\",\n          \"detection\": \"Main reservation and saved attempt identity/digest distinguish identical replay, conflicting same-attempt input and genuinely active work.\",\n          \"response\": \"Identical acknowledged request returns existing submission identity without restarting work; conflicting payload is refused. Existing same-review exclusion remains, independently of other review IDs.\",\n          \"userImpact\": \"No duplicate model calls or accidental overwrite after reconnect.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Review worker crashes while admission, execution or publication is active\",\n          \"detection\": \"Registered worker exit/error and incarnation check; checkpoint remains last atomic save and process cleanup reports whether children/locks/stores are reclaimed.\",\n          \"response\": \"Report only that review interrupted from the main progress projection; preserve last checkpoint and published history. Require explicit resume/recover. Do not create replacement or dispatch models before old worker and children are fenced/reclaimed; never synthesize success.\",\n          \"userImpact\": \"Other reviews and chat sessions continue; completed feedback is retained.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Controller disconnect, forged exchange or stale worker message\",\n          \"detection\": \"Main-owned connection lifecycle, owner-bound action envelope and registered worker port/incarnation mismatch.\",\n          \"response\": \"Forward loss only to the owning controller review under existing recovery rules; reject forged/stale messages before they mutate checkpoint/status. Daemon reviewer does not inherit observer-disconnect cancellation.\",\n          \"userImpact\": \"Authority and independent reviewer semantics survive the thread move.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Approval cleanup races review admission/execution/publication\",\n          \"detection\": \"Main cross-worker story/artifact lease and existing evidence-preserving cleanup guard observe a live owner or unresolved worker reclamation.\",\n          \"response\": \"Return targeted busy/retained result; do not delete active checkpoint. Retry cleanup after target is inactive; unrelated workers do not receive cancellation.\",\n          \"userImpact\": \"No loss of current review evidence or interference with another session.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Unsupported admission format encountered by reader, recovery or older daemon\",\n          \"detection\": \"Checkpoint variant/version capability gate cannot decode admission or qualified attempt safely.\",\n          \"response\": \"Return explicit unsupported-format error and preserve bytes; no blind downgrade, successful-empty interpretation or automatic history rewrite.\",\n          \"userImpact\": \"Operator can upgrade/recover without losing evidence.\",\n          \"recoverable\": true\n        }\n      ],\n      \"edgeCases\": [\n        {\n          \"input\": \"Code/code, design/design or mixed code/design reviews in different sessions, including two from one session\",\n          \"expected\": \"Distinct valid review identities run on distinct worker threadIds, with independent admission/progress and provider lifetimes; existing same-artifact design exclusion still applies.\"\n        },\n        {\n          \"input\": \"Optional session-worker routing is disabled\",\n          \"expected\": \"Reviews still require dedicated worker execution; initialize required safe worker services or return explicit unavailable, never execute heavy work on main.\"\n        },\n        {\n          \"input\": \"Progress query during a deliberately blocked admission computation\",\n          \"expected\": \"Return pending scope preparation, task null, timestamps/freshness and no invented total; unrelated review and daemon status calls complete without waiting for admission.\"\n        },\n        {\n          \"input\": \"Existing qualified checkpoint from before this change\",\n          \"expected\": \"Updated readers accept it unchanged; explicit recovery runs in a dedicated worker. Historical review inputs, findings and source pins remain immutable.\"\n        },\n        {\n          \"input\": \"Worker exits after checkpoint save but before caller receives acknowledgment\",\n          \"expected\": \"Progress/retry discovers the durable admission; identical replay does not dispatch another inference. Recovery is explicit if owner died.\"\n        },\n        {\n          \"input\": \"Publication fails after all task/chunk results were durably recorded\",\n          \"expected\": \"Retain pending publication and feedback; explicit publication retry runs in one recovery worker without models.\"\n        }\n      ],\n      \"invariantsToPreserve\": [\n        {\n          \"text\": \"Code-review final source pin and changed-block scope verification, checkpoint input immutability and independent party selection remain mandatory; admission status cannot satisfy BUILD approval.\",\n          \"source\": \"c1\"\n        },\n        {\n          \"text\": \"Design latest-subject monitoring, user-directed artifact-change restart, impact-aware corrections and bounded technical retry behavior remain in the existing coordinator.\",\n          \"source\": \"c2\"\n        },\n        {\n          \"text\": \"Workers are daemon-owned, join shared store/lock guards and reclaim resources on exit; IPC clients never directly open daemon stores.\",\n          \"source\": \"c3\"\n        },\n        {\n          \"text\": \"Controller identity comes from trusted host context and observing a review does not transfer ownership; only targeted controller loss changes its review lifecycle.\",\n          \"source\": \"c1\"\n        },\n        {\n          \"text\": \"Existing family progress/checkpoint recovery tests remain applicable; cross-worker movement must preserve saved partial feedback and explicit recovery.\",\n          \"source\": \"c4\"\n        }\n      ]\n    },\n    \"testStrategy\": {\n      \"testFramework\": \"node:test with node:assert/strict, executed by Node 22.22.1 and tsx; extend the existing daemon-thread and code/design-review test suites. Actual worker-thread fixtures with deterministic barriers and stubbed providers; no cloud calls for regression tests.\",\n      \"testLevels\": [\n        {\n          \"level\": \"unit\",\n          \"purpose\": \"Prove exact review ownership, input pinning and schema discrimination without provider dispatch.\",\n          \"subjects\": [\n            \"Proposed src/daemon/threads/__tests__/review-workers.test.ts: reserve one canonical repo/family/reviewId, distinct worker incarnations and correct subject/cleanup exclusions; reject stale-port and forged-owner exchanges.\",\n            \"Extend family checkpoint/admission/capacity tests: durable admission variant cannot be read as qualified scope, cannot pass approval, retains exact input, fails safely at unchanged projection bounds, and round-trips historical qualified checkpoints.\"\n          ],\n          \"fixturesNeeded\": [\n            \"Small pinned review packets and design artifact subjects from existing fixtures.\",\n            \"Admission-phase, failed-admission, interrupted-admission and current qualified-history fixtures; no raw prompt transcripts.\"\n          ]\n        },\n        {\n          \"level\": \"integration\",\n          \"purpose\": \"Demonstrate actual isolation and acknowledgment ordering using real worker threads, not only mocked callbacks.\",\n          \"subjects\": [\n            \"Proposed src/daemon/threads/__tests__/review-worker-isolation.test.ts: block review A's expensive admission inside its worker after durable acknowledgment; before releasing its barrier, prove daemon status/progress and review B execute on different threadIds.\",\n            \"Run code/code, design/design and code/design permutations from different sessions and from the same session; same-subject exclusion is tested independently of valid parallel reviews.\",\n            \"Prove accepted response follows atomic admission save but precedes expensive source/subject work; progress has scope_preparation/task-null and does not claim total or passing verdict.\",\n            \"Exercise existing start/resume/recover/progress/controller-exchange/publication/cleanup entrypoints through real MCP-step/RPC routing; assert no old main-thread-only route remains and threads-disabled optional session mode never causes fallback.\"\n          ],\n          \"fixturesNeeded\": [\n            \"Real compiled worker entrypoint, existing channel/store-guard/lock fixtures, isolated temporary repo/checkpoints.\",\n            \"Worker admission barrier/CPU-block probe and parent-side acknowledgment ordering assertions; generous outer test timeout used only as a test failure guard.\"\n          ]\n        },\n        {\n          \"level\": \"integration\",\n          \"purpose\": \"Preserve failure, cancellation, cleanup, trusted authority and restart semantics across workers.\",\n          \"subjects\": [\n            \"Proposed src/daemon/threads/__tests__/review-worker-recovery.test.ts: crash before durable save, after save before ack, during qualified task/chunk execution and during publication; prove targeted interruption, saved feedback retention and explicit replacement after reclamation.\",\n            \"Owner disconnect interrupts controller review only; daemon review survives observer disconnect; forged and delayed old-worker messages cannot mutate the replacement.\",\n            \"Same-input replay after lost ack never duplicates dispatch; changed input in pinned attempt is refused; failed admission proceeds only on explicit next attempt, interrupted identical admission on explicit recovery.\",\n            \"Prove provider/tool child release and lock/store reclamation before replacement dispatch; same-scope approval cleanup refuses active work while unrelated reviews stay alive.\",\n            \"Existing code/design ownership, checkpoint, progress, recovery, publication and completion-gate regressions continue to pass.\"\n          ],\n          \"fixturesNeeded\": [\n            \"Controlled worker crash points, fake native CLI child with observable termination, provider-call counters.\",\n            \"Two independent reviews with separate checkpoints; owner-abort and stale-incarnation messages.\"\n          ]\n        },\n        {\n          \"level\": \"contract\",\n          \"purpose\": \"Keep all registered review surfaces and live IDE clients aligned with admission progress and historical evidence.\",\n          \"subjects\": [\n            \"Schema/IPC fixtures prove code and design acknowledgments preserve identity and status meaning, admission-failure results are technical only, unknown/unsupported checkpoint formats are explicit and no unverified input grants approval.\",\n            \"Live vscode-plugin and jetbrains-plugin review DTO/renderer tests tolerate/display admission progress and do not convert pending null-task scope to complete or zero-work success.\",\n            \"Packaging build includes the new worker entrypoint and starts it from compiled out/ paths; existing workerScript source fallback remains development-only behavior.\"\n          ],\n          \"fixturesNeeded\": [\n            \"Existing shared review wire fixtures plus admission-progress and technical-failure variants.\"\n          ]\n        },\n        {\n          \"level\": \"smoke\",\n          \"purpose\": \"Qualify deployed behavior without uncontrolled review rounds or model costs.\",\n          \"subjects\": [\n            \"After update/restart, observe concurrent code/design reviews on distinct daemon worker threadIds, acknowledge promptly before a controlled long admission, and keep main/session progress responsive. Use stubbed or paused review fixtures for isolation, not repeated cloud reviews.\",\n            \"Resume TU1 S1 only after deployment and a separately valid bounded source-projection scope; do not claim this story removes the 64MiB failure.\"\n          ],\n          \"fixturesNeeded\": [\n            \"Updated daemon with compiled review workers; retained checkpoints; no live review killed without targeted user-authorized action.\"\n          ]\n        }\n      ],\n      \"acceptanceMapping\": [\n        {\n          \"criterionId\": \"ac1\",\n          \"provingTests\": [\n            \"One worker per review for both families: real code/code, design/design, mixed-family and same-session permutations; distinct runtime threadIds and no main/session fallback.\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac2\",\n          \"provingTests\": [\n            \"Durable ack precedes blocked expensive admission; main progress/status and second review complete while first worker is blocked; saved admission failure survives reconnect.\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac3\",\n          \"provingTests\": [\n            \"Trusted-owner bridge refuses forged/stale exchanges; controller disconnect and daemon-observer disconnect retain existing different semantics; no source/pin/approval bypass.\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac4\",\n          \"provingTests\": [\n            \"Crash/restart/recovery fixture retains task/chunk feedback and exact input, requires explicit recovery, and starts replacement only after worker/child/resource reclamation.\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac5\",\n          \"provingTests\": [\n            \"Duplicate input replay is idempotent, changed pinned input refused, subject/cleanup exclusion is shared across workers, and cancel/cleanup affect only target review.\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac6\",\n          \"provingTests\": [\n            \"Historical checkpoint and permanent report compatibility; worker compiled-package smoke; live IDE admission DTO fixtures; unchanged projection-bound refusal remains explicit.\"\n          ]\n        }\n      ]\n    },\n    \"migration\": {\n      \"stateBefore\": \"s1 discovery (c1–c4) locates both current main-owned review entrypoints and coordinators, existing worker lifecycle/status primitives, and checkpoint/recovery tests. Code-review start qualifies the committed packet before saving a checkpoint and acknowledging; expensive history projection can outlive MCP 300s. Existing current-format checkpoints contain qualified attempts only; per-review module state and design-subject fencing currently live with main-daemon coordinators.\",\n      \"stateAfter\": \"Every code/design review is owned by one dedicated worker from durable admission through execution/publication/recovery. Main host owns routing, trusted connection authority, cross-worker exclusions and progress projections. Existing family checkpoints support explicit unverified admission attempts and qualified history, and updated readers preserve old qualified attempts. Public method names/review identities remain stable; clients display pending admission without treating it as successful empty review. No inference, projection or approval bypass is introduced.\",\n      \"migrationSteps\": [\n        {\n          \"order\": 1,\n          \"action\": \"Build the family checkpoint/read/report schema extensions and worker infrastructure together with tests; validate historical qualified fixtures and unverified-admission approval refusal before enabling production routes. No production checkpoint rewrite or activation flag.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 2,\n          \"action\": \"Complete mandatory independent code review and human BUILD approval; publish the unified daemon/MCP/schema and live client changes. Coordinate active reviews before restart: let them finish or explicitly interrupt the selected work with preserved checkpoints. Do not terminate another session's review implicitly.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 3,\n          \"action\": \"Update/restart daemon and reconnect MCP discovery so all hosts read the new admission variant. Route all new and recovered reviews to dedicated workers immediately; optional session threading does not select a review fallback. Read-only completed records remain accessible without inference.\",\n          \"rollbackable\": false\n        },\n        {\n          \"order\": 4,\n          \"action\": \"Run compiled-worker and concurrent isolation qualification, confirm targeted resource cleanup and durable admission failures, then resume blocked TU1 work only with separately valid scope. If operational rollback is necessary after new admission records exist, retain upgraded checkpoint readers and those files; do not blind-downgrade to a binary unable to decode them.\",\n          \"rollbackable\": false\n        }\n      ],\n      \"backwardCompat\": \"Preserve existing MCP/RPC method names, reviewId/attempt/action/execution/sequence identity and reviewer independence. Extend registered output/read schemas and client fixtures for admission visibility; code pending status/scope_preparation remain pending and unverified, not a passing verdict. Updated readers accept historical qualified checkpoints and permanent results unchanged. New admission variants are version/capability checked and unsupported readers refuse explicitly. Existing attempt bytes and input pins are not rewritten; only current lifecycle transitions use the new variant. Publication histories distinguish technical admission failures from real task/chunk assessments. A state-preserving rollback after first new-format write must keep compatible readers; there is no legacy-review fallback.\",\n      \"zeroDowntime\": false,\n      \"dataRewriteRequired\": false\n    },\n    \"alternativesConsidered\": [\n      {\n        \"id\": \"a1\",\n        \"name\": \"One per-review worker host with family-specific adapters\",\n        \"oneLineSummary\": \"Use one worker entrypoint and supervisor registry; each worker owns exactly one code or design review and delegates to that family's existing coordinator.\",\n        \"approach\": \"Reuse src/daemon/threads/workers.ts startup/reclamation and hub transport. The main daemon maintains trusted ownership/routing and per-review reservations; a worker hosts one existing review-family coordinator and its admission/execution/publication. Extend each family's existing checkpoint with a bounded durable admission variant, not another canonical review ledger. Forward trusted controller exchanges to the owner worker through the main authority bridge. Preserve family-specific review schemas and recovery behavior; add only the shared execution-lifecycle envelope required for isolation.\",\n        \"pros\": [\n          \"Meets one-thread-per-review for both families without duplicating lifecycle supervision.\",\n          \"Keeps review judging, checkpoint histories and family-specific policies in existing coordinators.\",\n          \"Reuses daemon startup, store/lock safety and status plumbing.\"\n        ],\n        \"cons\": [\n          \"Requires explicit trusted-controller signal/identity bridging and migration-aware admission readers.\",\n          \"A shared host must be narrowly scoped so it does not become a third review engine.\"\n        ],\n        \"costEstimate\": \"L\"\n      },\n      {\n        \"id\": \"a2\",\n        \"name\": \"Separate code-review and design-review worker hosts\",\n        \"oneLineSummary\": \"Use distinct worker entrypoints and adapter types for the two review families under the existing daemon worker infrastructure.\",\n        \"approach\": \"Main-daemon routing launches a code-only or design-only worker for each review identity. Both hosts independently implement durable admission dispatch, progress forwarding, trusted-controller bridging and worker-exit recovery, while reusing common thread/channel primitives. Existing review coordinators continue to own model/review semantics and persistent family histories.\",\n        \"pros\": [\n          \"Family protocols remain physically separate and workers load only the relevant coordinator.\",\n          \"Allows family-specific runtime setup without branching inside the host.\"\n        ],\n        \"cons\": [\n          \"Duplicates admission/ownership/exit lifecycle orchestration and mixed-family concurrency tests.\",\n          \"More integration paths must remain behaviorally identical for guarantees shared by all reviews.\"\n        ],\n        \"costEstimate\": \"L\",\n        \"reasonRejected\": \"Duplicates admission/ownership/exit lifecycle orchestration across two hosts; a1 fully reuses one lifecycle path while preserving family-specific coordinators.\"\n      }\n    ],\n    \"chosenAlternative\": \"a1\",\n    \"openQuestions\": [],\n    \"erDefinition\": {\n      \"id\": \"review-worker-ownership\",\n      \"narrative\": \"Shows execution ownership and durable recovery boundaries: a daemon registry owns independent workers; each worker serves one review identity, and that identity retains its ordered checkpoint attempts after worker exit. Trusted controller authority is routed through the registry rather than copied as a live socket into workers.\",\n      \"classes\": {\n        \"DaemonReviewRegistry\": {\n          \"description\": \"Main-daemon process authority for review routing, subject leases and worker incarnations.\",\n          \"attributes\": {\n            \"registryId\": {\n              \"description\": \"Daemon instance identity; not a user credential.\",\n              \"range\": \"string\",\n              \"identifier\": true\n            },\n            \"workers\": {\n              \"description\": \"Active per-review worker entries owned by this registry; removed only after drain/reclamation.\",\n              \"range\": \"ReviewWorker\",\n              \"multivalued\": true,\n              \"minimum_cardinality\": 0\n            },\n            \"controllerOwners\": {\n              \"description\": \"Host-validated controller connection handles; observing sessions do not gain ownership.\",\n              \"range\": \"ControllerOwner\",\n              \"multivalued\": true\n            }\n          }\n        },\n        \"ReviewWorker\": {\n          \"description\": \"Ephemeral worker thread, dedicated to exactly one review and one current registered incarnation.\",\n          \"attributes\": {\n            \"threadId\": {\n              \"description\": \"Runtime worker thread identity.\",\n              \"range\": \"integer\",\n              \"identifier\": true\n            },\n            \"review\": {\n              \"description\": \"Exactly one review identity owned for execution; registry prevents duplicate live owners.\",\n              \"range\": \"ReviewIdentity\",\n              \"required\": true,\n              \"minimum_cardinality\": 1,\n              \"maximum_cardinality\": 1\n            }\n          }\n        },\n        \"ReviewIdentity\": {\n          \"description\": \"Canonical repo/family/reviewId scope with durable ordered attempts independent of worker lifetime.\",\n          \"attributes\": {\n            \"key\": {\n              \"description\": \"Composite canonical repo, family and reviewId.\",\n              \"range\": \"string\",\n              \"identifier\": true\n            },\n            \"attempts\": {\n              \"description\": \"Ordered immutable attempt inputs and admission/qualified state in the existing family checkpoint.\",\n              \"range\": \"CheckpointAttempt\",\n              \"multivalued\": true,\n              \"minimum_cardinality\": 1\n            }\n          }\n        },\n        \"CheckpointAttempt\": {\n          \"description\": \"Durable admission or qualified family attempt; only qualified results can bind approval.\",\n          \"attributes\": {\n            \"number\": {\n              \"description\": \"Sequential attempt number within the review identity.\",\n              \"range\": \"integer\",\n              \"required\": true\n            },\n            \"phase\": {\n              \"description\": \"Admission or qualified review state; not a verdict.\",\n              \"range\": \"string\",\n              \"required\": true\n            },\n            \"submitted\": {\n              \"description\": \"Exact bounded immutable input, stored once for this attempt.\",\n              \"range\": \"string\",\n              \"required\": true\n            }\n          }\n        },\n        \"ControllerOwner\": {\n          \"description\": \"Main-host validated connection owner; local worker signal is derived from its lifecycle notifications.\",\n          \"attributes\": {\n            \"ownerId\": {\n              \"description\": \"Opaque trusted host connection handle, never client-supplied authority.\",\n              \"range\": \"string\",\n              \"identifier\": true\n            },\n            \"reviews\": {\n              \"description\": \"Controller-reviewed identities owned by this connection; disconnect affects only those identities under existing rules.\",\n              \"range\": \"ReviewIdentity\",\n              \"multivalued\": true,\n              \"minimum_cardinality\": 0\n            }\n          }\n        }\n      }\n    },\n    \"sequenceDefinition\": {\n      \"id\": \"review-worker-admission\",\n      \"narrative\": \"Shows durable submission acknowledgment preceding expensive admission, then normal review execution in an isolated worker. The main daemon retains trusted routing and can serve progress without waiting for the worker's source qualification.\",\n      \"participants\": [\n        {\n          \"id\": \"caller\",\n          \"label\": \"Chat / MCP caller\",\n          \"description\": \"Originating session; observing disconnect does not end daemon-reviewed work.\"\n        },\n        {\n          \"id\": \"main\",\n          \"label\": \"Main daemon review registry\",\n          \"description\": \"Trusted ownership, unique review reservation and worker routing; no source-history verification.\"\n        },\n        {\n          \"id\": \"worker\",\n          \"label\": \"Dedicated review worker\",\n          \"description\": \"One worker for this review, hosting the existing family coordinator.\"\n        },\n        {\n          \"id\": \"checkpoint\",\n          \"label\": \"Existing family checkpoint\",\n          \"description\": \"Atomic durable input and admission/review attempt state.\"\n        },\n        {\n          \"id\": \"provider\",\n          \"label\": \"Existing review provider\",\n          \"description\": \"CLI/controller review path used only after full admission.\"\n        }\n      ],\n      \"messages\": [\n        {\n          \"from\": \"caller\",\n          \"to\": \"main\",\n          \"label\": \"start(repo, family, reviewId, attempt, input)\",\n          \"kind\": \"call\",\n          \"description\": \"Existing identity and bounded schema request, with host-derived controller authority.\"\n        },\n        {\n          \"from\": \"main\",\n          \"to\": \"worker\",\n          \"label\": \"reserve identity; start one worker; send trusted submission\",\n          \"kind\": \"call\",\n          \"description\": \"Reuse daemon worker startup; no session-thread or main fallback.\"\n        },\n        {\n          \"from\": \"worker\",\n          \"to\": \"checkpoint\",\n          \"label\": \"atomically persist immutable admission attempt\",\n          \"kind\": \"call\",\n          \"description\": \"Unverified input is durable but cannot authorize model work or approval.\"\n        },\n        {\n          \"from\": \"checkpoint\",\n          \"to\": \"worker\",\n          \"label\": \"durable write confirmed\",\n          \"kind\": \"return\",\n          \"description\": \"Persistence failure returns refusal instead of accepted acknowledgment.\"\n        },\n        {\n          \"from\": \"worker\",\n          \"to\": \"main\",\n          \"label\": \"submission accepted + checkpoint path\",\n          \"kind\": \"return\",\n          \"description\": \"Reply occurs before expensive source/subject qualification.\"\n        },\n        {\n          \"from\": \"main\",\n          \"to\": \"caller\",\n          \"label\": \"pending acknowledgment\",\n          \"kind\": \"return\",\n          \"description\": \"Caller can poll; no assumption of admitted scope or successful review.\"\n        },\n        {\n          \"from\": \"worker\",\n          \"to\": \"checkpoint\",\n          \"label\": \"qualify source/subject; persist qualified or technical-failure state\",\n          \"kind\": \"call\",\n          \"description\": \"All existing projection, route, capacity and subject checks run on the worker.\"\n        },\n        {\n          \"from\": \"caller\",\n          \"to\": \"main\",\n          \"label\": \"progress\",\n          \"kind\": \"call\",\n          \"description\": \"Available during slow admission from bounded worker-published state.\"\n        },\n        {\n          \"from\": \"main\",\n          \"to\": \"caller\",\n          \"label\": \"pending admission / fresh progress / explicit failure\",\n          \"kind\": \"return\",\n          \"description\": \"No synthetic task count or passing verdict.\"\n        },\n        {\n          \"from\": \"worker\",\n          \"to\": \"provider\",\n          \"label\": \"existing review execution only after admitted checkpoint\",\n          \"kind\": \"call\",\n          \"description\": \"Family coordinator preserves task/chunk ordering, trust and retry policy.\"\n        },\n        {\n          \"from\": \"worker\",\n          \"to\": \"checkpoint\",\n          \"label\": \"feedback + publication state saved\",\n          \"kind\": \"call\",\n          \"description\": \"Completed feedback and source pins remain durable for explicit recovery.\"\n        },\n        {\n          \"from\": \"worker\",\n          \"to\": \"main\",\n          \"label\": \"terminal progress; drain children; exit/reclaim\",\n          \"kind\": \"return\",\n          \"description\": \"Release registry ownership only after saves and worker/process resources are safe.\"\n        }\n      ]\n    },\n    \"componentDependencyDefinition\": {\n      \"id\": \"review-worker-boundaries\",\n      \"narrative\": \"Separates main-daemon authority from per-review execution while reusing the existing worker infrastructure and review engines. There may be many worker instances; each instance selects exactly one family adapter.\",\n      \"components\": [\n        {\n          \"id\": \"main\",\n          \"label\": \"Main review registry / authority\",\n          \"description\": \"Proposed main-owned per-review routing and controller lifecycle bridge.\",\n          \"path\": \"src/daemon/threads/review-workers.ts\"\n        },\n        {\n          \"id\": \"worker\",\n          \"label\": \"One worker per review\",\n          \"description\": \"Proposed worker host; never a singleton class target or session worker.\",\n          \"path\": \"src/daemon/threads/review-worker.ts\"\n        },\n        {\n          \"id\": \"threads\",\n          \"label\": \"Existing worker transport / lifecycle\",\n          \"description\": \"Startup, hub, status, maintenance, locks and store reclamation.\",\n          \"path\": \"src/daemon/threads\"\n        },\n        {\n          \"id\": \"code\",\n          \"label\": \"Existing code-review coordinator\",\n          \"description\": \"Committed scope, attribution, task reviews, progress and publication.\",\n          \"path\": \"src/workflow/code-review/task-review/coordinator.ts\"\n        },\n        {\n          \"id\": \"design\",\n          \"label\": \"Existing design-review coordinator\",\n          \"description\": \"Latest artifact, coherent chunks, impact/recovery and publication.\",\n          \"path\": \"src/workflow/review/design-review/coordinator.ts\"\n        },\n        {\n          \"id\": \"checkpoints\",\n          \"label\": \"Existing family checkpoints\",\n          \"description\": \"Durable admission and qualified attempts; no second canonical review ledger.\",\n          \"path\": \"src/workflow\"\n        }\n      ],\n      \"dependencies\": [\n        {\n          \"from\": \"main\",\n          \"to\": \"threads\",\n          \"label\": \"reuse worker startup and supervision\"\n        },\n        {\n          \"from\": \"main\",\n          \"to\": \"worker\",\n          \"label\": \"route only this review's trusted commands\"\n        },\n        {\n          \"from\": \"worker\",\n          \"to\": \"threads\",\n          \"label\": \"join daemon guards and hub services\"\n        },\n        {\n          \"from\": \"worker\",\n          \"to\": \"code\",\n          \"label\": \"code family only\"\n        },\n        {\n          \"from\": \"worker\",\n          \"to\": \"design\",\n          \"label\": \"design family only\"\n        },\n        {\n          \"from\": \"code\",\n          \"to\": \"checkpoints\",\n          \"label\": \"atomic family admission/history\"\n        },\n        {\n          \"from\": \"design\",\n          \"to\": \"checkpoints\",\n          \"label\": \"atomic family admission/history\"\n        }\n      ]\n    },\n    \"adherence\": {\n      \"dimensions\": [\n        \"diagram-er\",\n        \"diagram-sequence\",\n        \"diagram-component\",\n        \"functional-coverage\"\n      ]\n    },\n    \"companions\": [\n      {\n        \"kind\": \"diagram-mermaid\",\n        \"relPath\": \"docs/standalone/isolate-each-code-design-review-its-E20261109e4af6312/S001/er-model.html\",\n        \"title\": \"ER model\"\n      },\n      {\n        \"kind\": \"diagram-mermaid\",\n        \"relPath\": \"docs/standalone/isolate-each-code-design-review-its-E20261109e4af6312/S001/sequence-diagram.html\",\n        \"title\": \"Sequence diagram\"\n      },\n      {\n        \"kind\": \"diagram-mermaid\",\n        \"relPath\": \"docs/standalone/isolate-each-code-design-review-its-E20261109e4af6312/S001/component-dependency.html\",\n        \"title\": \"Component dependencies\"\n      }\n    ]\n  },\n  \"citations\": [\n    {\n      \"id\": \"c1\",\n      \"kind\": \"code\",\n      \"ref\": \"src/workflow/code-review/task-review/coordinator.ts\",\n      \"quotedText\": \"s1 code discovery: src/daemon/task-review-rpc.ts and src/workflow/code-review/task-review/coordinator.ts; verified committed-source admission, per-review reservation, background scheduling and trusted controller integration.\"\n    },\n    {\n      \"id\": \"c2\",\n      \"kind\": \"code\",\n      \"ref\": \"src/workflow/review/design-review/coordinator.ts\",\n      \"quotedText\": \"s1 code discovery: src/daemon/design-review-rpc.ts and src/workflow/review/design-review; coordinator, checkpoint, recovery, subject and publication modules.\"\n    },\n    {\n      \"id\": \"c3\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/threads/workers.ts\",\n      \"quotedText\": \"s1 worker reuse discovery: src/daemon/threads/workers.ts, src/daemon/threads/worker-entry.ts, src/daemon/threads/channel.ts, src/daemon/threads/status-board.ts, src/daemon/threads/router.ts, src/daemon/threads/main-services.ts and src/daemon/threads/supervisor.ts.\"\n    },\n    {\n      \"id\": \"c4\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/threads/__tests__/review-state-concurrency.test.ts\",\n      \"quotedText\": \"s1 test discovery plus direct source corroboration: existing code/design ownership, admission, checkpoint, progress and recovery suites and src/daemon/threads/__tests__/review-state-concurrency.test.ts; graph test lookup limited/off-topic results not used as coverage proof.\"\n    },\n    {\n      \"id\": \"c5\",\n      \"kind\": \"prior-artifact\",\n      \"ref\": \".insrc/artifacts/ISSUE-e4af63128c7cbec2.json\"\n    },\n    {\n      \"id\": \"c6\",\n      \"kind\": \"stakeholder\",\n      \"ref\": \"User requires a separate worker thread for every review, both code and design, rather than main-daemon or per-chat-thread execution.\"\n    }\n  ]\n}\n","document":"<!-- insrc:artifact LLD-e4af63128c7cbec2-s1 -->\n\n# LLD: STORY-e4af63128c7cbec2-s1 — Isolate each code and design review in its own worker thread\n\n## Summary\n\n**Epic:** `isolate-each-code-design-review-its`\n**HLD base run:** `wf-1794198632679-vj371t`\n**HLD effective hash:** `6d5c2ef6c93a...`\n\nEach code or design review runs in a dedicated daemon-owned worker, independent of chat-session threads and other reviews. Submission is durably acknowledged before expensive scope/subject admission, with progress and technical failures visible throughout. Existing review coordinators, judging policies, trusted controller ownership and human approval gates remain authoritative; this change relocates execution and adds the missing admission lifecycle.\n\n## Contents\n\n1. [HLD context](#1-hld-context)\n2. [Contract details](#2-contract-details)\n3. [Data model changes](#3-data-model-changes)\n4. [Diagrams](#4-diagrams)\n5. [Error paths](#5-error-paths)\n6. [Test strategy](#6-test-strategy)\n7. [Migration](#7-migration)\n8. [Alternatives considered](#8-alternatives-considered)\n9. [References](#9-references)\n\n## 1. HLD context\n\n**Framework:** Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\n**Rollout phase:** standalone\n\n## 2. Contract details\n\n**Surface level:** internal-shared\n\n### 2.1 `startTaskReview`\n\n```typescript\nstartTaskReview(raw: unknown, trusted?: TrustedRpcContext, deps?: TaskReviewRpcDeps): Promise<unknown>\n```\n\n**Parameters:**\n- `raw: unknown` — Existing code-review request; structurally validate bounded repo/reviewId/attempt/pinned packet before dispatch.\n- `trusted: TrustedRpcContext` _(optional)_ — Host-supplied caller and controller lifetime authority; never accepted from request fields.\n- `deps: TaskReviewRpcDeps` _(optional)_ — Existing test/provider seam; test workers use explicit serializable fixtures rather than cloning closures.\n\n**Returns:** `Promise<unknown>` — Existing acknowledgment identity/path/reviewer fields with status pending once the worker has durably saved an admission-phase attempt; this acknowledges submission, not verified scope. Progress reports scope_preparation with task null until attribution is known. Admission failure is terminal technical feedback, never passed review.\n\n**Errors:**\n- `TaskReviewError` when Malformed/oversized request, unregistered/noncanonical repo, wrong owner, conflicting review identity or worker boot/persistence failure before durable acknowledgment.\n\n**Preconditions:**\n- Approved source route and author-party checks are preserved, with authority determined by host data rather than caller claims.\n- Main registry reserves canonical repo + review family + reviewId; both review families also retain existing subject/cleanup exclusions.\n\n**Postconditions:**\n- Expensive committed-source reads/projection and all coordinator execution occur on the dedicated review worker.\n- No model call is dispatched before full source/route admission succeeds.\n- Daemon review remains live after submitter disconnect; controller-review owner disconnect retains existing explicit recovery requirements.\n\n### 2.2 `designReviewStep`\n\n```typescript\ndesignReviewStep(raw: unknown, trusted?: TrustedRpcContext, deps?: DesignReviewRpcDeps): Promise<unknown>\n```\n\n**Parameters:**\n- `raw: unknown` — Existing design start/recover/progress/controller exchange with unchanged artifact workflow requirements.\n- `trusted: TrustedRpcContext` _(optional)_ — Host-only controller identity/lifetime and client model-selection context.\n- `deps: DesignReviewRpcDeps` _(optional)_ — Preserved dependency injection boundary.\n\n**Returns:** `Promise<unknown>` — Start/recover acknowledges a durable admission-phase submission before expensive subject/history checks. Progress and exchange requests route to that review worker; completed results remain read-only when the worker has exited.\n\n**Errors:**\n- `DesignReviewError` when Existing subject/owner/action conflict, malformed request, unavailable worker or admission persistence failure. Post-ack technical errors are stored and returned by progress.\n\n**Preconditions:**\n- Artifact subject resolves to registered repo and host-authorized path; design artifact lease remains process-wide despite moving coordinator state into workers.\n- Main bridge validates connection identity and action envelope; workers cannot mint caller authority.\n\n**Postconditions:**\n- Planning, chunk execution, impact/recovery analysis and publication execute only in the owner worker.\n- Existing latest-artifact monitoring, user-directed restart policy and bounded technical retries remain unchanged.\n- Code and design review method routes cannot silently fall back to main/session execution, including when optional session threading is disabled.\n\n## 3. Data model changes\n\n### 3.1 `Per-review worker ownership registry` — new\n\nProposed src/daemon/threads/review-workers.ts and src/daemon/threads/review-worker.ts host one existing family coordinator per canonical (repo,family,reviewId). Reuse startWorker, workerScript, startDaemonWorker, HubClient, serveRequests, status-board and supervisor hooks. The registry owns 0..N active worker entries; each active entry owns exactly one worker and one review identity; a worker owns exactly one review, never a pool or a session. An attempt sequence reuses its live owner; after termination, explicit resume/recover/publication retry may spawn a replacement only after the prior worker is gone and its resources are reclaimed. Main registry entries hold threadId, worker incarnation, family, repo, reviewId, attempt, subject/cleanup scope, trusted owner bridge, last published bounded progress and reclaimed promise. These are process-lifetime routing facts, not a second durable review ledger. Use a worker incarnation tied to the registered MessagePort to reject stale exit/progress/result messages; clients cannot supply it. Do not use startClassWorker's singleton class target for per-review routing. Add a review role/identity to existing thread registry/status types where needed, and carry existing session attribution for diagnostics without attaching the worker lifetime to the chat worker.\n\n**Call sites:**\n- `src/daemon/threads/workers.ts`\n- `src/daemon/threads/worker-entry.ts`\n- `src/daemon/threads/channel.ts`\n- `src/daemon/threads/router.ts`\n- `src/daemon/threads/status-board.ts`\n- `src/daemon/threads/supervisor.ts`\n\n### 3.2 `Durable admission-phase checkpoint attempt` — field-add\n\nExtend each family's checkpoint attempt contract with an explicit admission variant rather than creating sidecar packet files or a second authoritative store. Existing admitted attempts retain their current submitted/review-response form and immutable history; historical current-format checkpoints remain readable without rewriting their reviewed content. An admission variant contains the existing immutable submitted input once, attempt number/review identity, operation/action identity, acceptedAt, status pending|running|failed|interrupted, bounded progress, source-validation state unverified, and optional typed technical error. Task/chunk selection and source fingerprints are absent until actually established; absence is not empty successful scope. It cannot carry review findings, a passing verdict, accepted scope or an approval binding. Worker saves this variant atomically before acknowledgment, then qualifies route, pins, source history, subject and capacity using current checks. On success atomically replace the same current attempt with the ordinary admitted variant, transferring the same submitted input and retaining admission timing; only then permit provider work. On failure retain the admission variant and exact input with a bounded code/field/summary. Readers, recovery, capacity and cleanup must discriminate both variants before accessing task/chunk fields. The schema/version gate must advertise the new format; updated readers accept existing qualified history, while an older binary must refuse unsupported admission variants rather than misread them as successful review. Failed admission consumes its attempt identity: corrected inputs require the next explicit attempt; identical interrupted admission resumes only via existing explicit resume/recover semantics. No automatic inference retry and no same-attempt input replacement.\n\n```\nCheckpointAttempt = AdmissionAttempt | ExistingQualifiedAttempt; AdmissionAttempt.phase='admission'; validation='unverified'; submitted remains exact and bounded. Only ExistingQualifiedAttempt may own accepted task/chunk scope, finalScope identity or BUILD/artifact approval binding. Format capability/version must be updated in registered schema and readers.\n```\n\n**Call sites:**\n- `src/workflow/code-review/task-review/coordinator.ts`\n- `src/workflow/code-review/task-review/admission.ts`\n- `src/workflow/code-review/task-review/checkpoint.ts`\n- `src/workflow/code-review/task-review/contracts.ts`\n- `src/workflow/review/design-review/checkpoint.ts`\n- `src/workflow/review/design-review/contracts.ts`\n- `src/workflow/review/design-review/coordinator.ts`\n\n### 3.3 `Submission and acknowledgment ordering` — invariant-change\n\nSequence: caller -> main existing MCP/RPC adapter -> cheap canonical identity/size/trusted-owner validation and atomic in-memory review reservation -> start one registered worker -> worker structural validation and atomic admission-checkpoint save -> durable-submission acknowledgment -> worker expensive admission -> ordinary qualified checkpoint -> existing family execution -> publication -> bounded final progress -> worker drain/reclaim. Failure before durable save is returned synchronously and releases reservation after worker exit; no acknowledgment is claimed. Response loss after save is discoverable by progress and identical submission replay returns the existing acknowledgment without rerunning work; changed payload for the same pinned attempt is rejected. Observation by another session does not steal controller authority. Main can serve cached worker progress during expensive admission; cache is a bounded projection of durable state with freshness/time and must not fabricate progress. A worker that never completes startup returns a named start failure under existing worker startup supervision, with no silent main-thread fallback. Reuse scope_preparation/task-null for code admission progress; map design admission to an explicit pre-plan state in its reader contract. Clients must display pending admission and distinguish it from completed empty scope.\n\n**Call sites:**\n- `src/daemon/task-review-rpc.ts`\n- `src/daemon/design-review-rpc.ts`\n- `src/daemon/threads/router.ts`\n- `src/daemon/threads/channel.ts`\n- `src/workflow/code-review/task-review/progress.ts`\n- `src/workflow/review/design-review/progress.ts`\n\n### 3.4 `Trusted controller and tool context bridge` — invariant-change\n\nKeep host connection authority and controller action validation in main-daemon entrypoints. AbortSignal, closures, providers and live sockets are not structured-cloned. Main creates an internal owner handle bound to authenticated connection identity and registered worker port; worker reconstructs a local AbortController from explicit owner-loss/cancellation notifications. Carry only bounded serializable client/model context and existing action/execution/sequence envelopes. Use existing nested routing for daemon-owned services, approved tool execution and permission requests; worker tools preserve existing checks, callbacks and source provenance. A review worker may receive only its own review's exchanges; verify repo/family/reviewId/attempt, worker incarnation and controller owner before forwarding. Untrusted fields cannot impersonate a controller or choose reviewer party. Controller disconnect interrupts only that review according to current protocol; daemon-authored/background reviewer execution survives observer disconnect. Main keeps durable subject/cleanup authority coherent across review workers; global design-artifact leases cannot remain worker-local module globals. Use existing review-state/host ownership services for cross-worker fencing, not new user trust keys.\n\n**Call sites:**\n- `src/daemon/task-review-rpc.ts`\n- `src/daemon/design-review-rpc.ts`\n- `src/daemon/threads/review-state-contract.ts`\n- `src/daemon/threads/main-services.ts`\n- `src/daemon/threads/worker-requests.ts`\n- `src/daemon/threads/router.ts`\n\n### 3.5 `Recovery, publication and approval readers` — invariant-change\n\nPreserve existing task/chunk semantics and permanent CR/design report history. Technical admission failure is rendered as admission failure with no model/task/chunk verdict; add a bounded explicitly non-review admission-failure history section to the existing report contracts where needed so next attempts can retain it without manufacturing task results. Only admitted whole-story/current-artifact independent passing evidence can satisfy approval. Failed admission never binds BUILD or invalidates a prior approval as newly reviewed content. Progress/read-only history remain accessible after worker exit from atomic checkpoints/permanent reports; readers discriminate admission variants without rerunning Git qualification. Publication retries start a dedicated recovery worker if necessary, consume durable feedback only and do not redispatch models. Cleanup after successful approval first fences the specific existing story/artifact scope across workers, drains or refuses active admission/execution/publication, then uses existing evidence-preserving deletion rules in a dedicated worker; never broad-delete other review files. Historical retry/approval paths that currently requalify checkpoints synchronously must route the costly work to that worker too. An already-published review read should not spawn a provider.\n\n**Call sites:**\n- `src/workflow/code-review/task-review/admission.ts`\n- `src/workflow/code-review/task-review/coordinator.ts`\n- `src/workflow/code-review/task-review/progress-view.ts`\n- `src/workflow/review/design-review/coordinator.ts`\n- `src/workflow/review/design-review/checkpoint.ts`\n- `src/workflow/review/design-review/publication.ts`\n- `src/workflow/review/design-review/cleanup.ts`\n- `src/daemon/threads/review-state-contract.ts`\n\n### 3.6 `Worker exit and resource ownership` — invariant-change\n\nOne supervisor owns each review worker's runtime lifetime. Completion drains saves/publication and native provider/tool children before terminating the worker; release registry/subject/cleanup reservations only after exit and lock/store reclamation. On unexpected worker death, main marks only its cached projection interrupted, leaves the last atomic checkpoint intact, and reports explicit recovery required. The next explicit resume/recover starts one replacement only after prior worker and process resources are fenced/reclaimed; it re-reads the latest checkpoint and preserves accepted task/chunk results. During admission there are no provider children; interruption retains exact unverified input. Do not fabricate family feedback or task completion on worker crash. Use existing provider/process cleanup capabilities, never PID-kill fallbacks; prove child disposal before replacement can dispatch another provider. Daemon shutdown drains/stops all review workers through existing supervisor lifecycle and leaves recoverable checkpoints. Required review workers operate even when optional chat/session-worker routing is disabled; inability to initialize necessary safe worker services is an explicit unavailable error, never legacy execution. OS worker-resource failures are explicit and targeted; no new review pool, global review serialization or activation flag.\n\n**Call sites:**\n- `src/daemon/threads/workers.ts`\n- `src/daemon/threads/worker-entry.ts`\n- `src/daemon/threads/supervisor.ts`\n- `src/daemon/threads/main-services.ts`\n- `src/workflow/code-review/task-review/coordinator.ts`\n- `src/workflow/review/design-review/coordinator.ts`\n\n### 3.7 `Files and scope boundaries` — invariant-change\n\nProposed new runtime files are src/daemon/threads/review-workers.ts (owner registry/dispatch) and src/daemon/threads/review-worker.ts (single-review worker entrypoint); add focused tests under src/daemon/threads/__tests__. Adapt existing main review RPC adapters, router/method classification/supervisor/status types, family checkpoint/admission/read/publication/cleanup contracts and MCP progress readers/schemas as required. Test families remain existing code/design modules, not a third engine. Live VS Code and JetBrains clients must tolerate/render admission progress and preserve IPC method names/payload identities if shared DTOs change; no deprecated insrc-ide work. No token-accounting code, review judgment algorithm changes, timeout expansion, projection budget increases/optimization, or automatic restarting of another session's reviews. The current TU1 S1 64MiB failure still requires a separately bounded valid scope/implementation correction; worker isolation makes it visible rather than fixing that limit.\n\n**Call sites:**\n- `src/daemon/threads/router.ts`\n- `src/daemon/threads/method-class.ts`\n- `src/daemon/task-review-rpc.ts`\n- `src/daemon/design-review-rpc.ts`\n\n## 4. Diagrams\n\n- [ER model](docs/standalone/isolate-each-code-design-review-its-E20261109e4af6312/S001/er-model.html)\n- [Sequence diagram](docs/standalone/isolate-each-code-design-review-its-E20261109e4af6312/S001/sequence-diagram.html)\n- [Component dependencies](docs/standalone/isolate-each-code-design-review-its-E20261109e4af6312/S001/component-dependency.html)\n\n## 5. Error paths\n\n**Error cases**\n\n- **Malformed, oversized, wrong-repository or forged-owner submission** (recoverable)\n  - Detection: Existing schema/size guards plus canonical repo and trusted host identity checks fail before worker dispatch or worker durable save.\n  - Response: Return existing typed refusal; do not claim durable acceptance, start a provider or create an approval binding. Reclaim any failed bootstrap worker before release.\n  - User impact: Actionable refusal without hidden review work.\n- **Worker cannot boot or admission checkpoint cannot be saved** (recoverable)\n  - Detection: Worker startup error/exit or rejected atomic checkpoint write before acknowledged persistence.\n  - Response: Return worker-start/admission-storage error, retain any prior history, wait for targeted resource reclamation and release reservation. Never fall back to main/session execution.\n  - User impact: Submission is not accepted; explicit retry is safe after cause is corrected.\n- **Expensive admission rejects pins, source projection, subject or capacity after acknowledgment** (recoverable)\n  - Detection: Existing family qualification checks throw; including current projection decoded-byte/operation limits.\n  - Response: Persist terminal admission failure with exact immutable request and bounded diagnostic; no provider dispatch and no synthetic task/chunk result. Progress/read/report clearly identifies technical admission failure. A changed input needs a new explicit sequential attempt.\n  - User impact: Failure remains discoverable after MCP return; scope is not silently weakened.\n- **Duplicate start or acknowledgment lost** (recoverable)\n  - Detection: Main reservation and saved attempt identity/digest distinguish identical replay, conflicting same-attempt input and genuinely active work.\n  - Response: Identical acknowledged request returns existing submission identity without restarting work; conflicting payload is refused. Existing same-review exclusion remains, independently of other review IDs.\n  - User impact: No duplicate model calls or accidental overwrite after reconnect.\n- **Review worker crashes while admission, execution or publication is active** (recoverable)\n  - Detection: Registered worker exit/error and incarnation check; checkpoint remains last atomic save and process cleanup reports whether children/locks/stores are reclaimed.\n  - Response: Report only that review interrupted from the main progress projection; preserve last checkpoint and published history. Require explicit resume/recover. Do not create replacement or dispatch models before old worker and children are fenced/reclaimed; never synthesize success.\n  - User impact: Other reviews and chat sessions continue; completed feedback is retained.\n- **Controller disconnect, forged exchange or stale worker message** (recoverable)\n  - Detection: Main-owned connection lifecycle, owner-bound action envelope and registered worker port/incarnation mismatch.\n  - Response: Forward loss only to the owning controller review under existing recovery rules; reject forged/stale messages before they mutate checkpoint/status. Daemon reviewer does not inherit observer-disconnect cancellation.\n  - User impact: Authority and independent reviewer semantics survive the thread move.\n- **Approval cleanup races review admission/execution/publication** (recoverable)\n  - Detection: Main cross-worker story/artifact lease and existing evidence-preserving cleanup guard observe a live owner or unresolved worker reclamation.\n  - Response: Return targeted busy/retained result; do not delete active checkpoint. Retry cleanup after target is inactive; unrelated workers do not receive cancellation.\n  - User impact: No loss of current review evidence or interference with another session.\n- **Unsupported admission format encountered by reader, recovery or older daemon** (recoverable)\n  - Detection: Checkpoint variant/version capability gate cannot decode admission or qualified attempt safely.\n  - Response: Return explicit unsupported-format error and preserve bytes; no blind downgrade, successful-empty interpretation or automatic history rewrite.\n  - User impact: Operator can upgrade/recover without losing evidence.\n\n**Edge cases**\n\n| Input | Expected |\n| :--- | :--- |\n| Code/code, design/design or mixed code/design reviews in different sessions, including two from one session | Distinct valid review identities run on distinct worker threadIds, with independent admission/progress and provider lifetimes; existing same-artifact design exclusion still applies. |\n| Optional session-worker routing is disabled | Reviews still require dedicated worker execution; initialize required safe worker services or return explicit unavailable, never execute heavy work on main. |\n| Progress query during a deliberately blocked admission computation | Return pending scope preparation, task null, timestamps/freshness and no invented total; unrelated review and daemon status calls complete without waiting for admission. |\n| Existing qualified checkpoint from before this change | Updated readers accept it unchanged; explicit recovery runs in a dedicated worker. Historical review inputs, findings and source pins remain immutable. |\n| Worker exits after checkpoint save but before caller receives acknowledgment | Progress/retry discovers the durable admission; identical replay does not dispatch another inference. Recovery is explicit if owner died. |\n| Publication fails after all task/chunk results were durably recorded | Retain pending publication and feedback; explicit publication retry runs in one recovery worker without models. |\n\n**Invariants to preserve**\n\n- Code-review final source pin and changed-block scope verification, checkpoint input immutability and independent party selection remain mandatory; admission status cannot satisfy BUILD approval. [[c1]]\n- Design latest-subject monitoring, user-directed artifact-change restart, impact-aware corrections and bounded technical retry behavior remain in the existing coordinator. [[c2]]\n- Workers are daemon-owned, join shared store/lock guards and reclaim resources on exit; IPC clients never directly open daemon stores. [[c3]]\n- Controller identity comes from trusted host context and observing a review does not transfer ownership; only targeted controller loss changes its review lifecycle. [[c1]]\n- Existing family progress/checkpoint recovery tests remain applicable; cross-worker movement must preserve saved partial feedback and explicit recovery. [[c4]]\n\n## 6. Test strategy\n\n**Test framework:** `node:test with node:assert/strict, executed by Node 22.22.1 and tsx; extend the existing daemon-thread and code/design-review test suites. Actual worker-thread fixtures with deterministic barriers and stubbed providers; no cloud calls for regression tests.`\n\n**Test levels**\n\n- **unit** — Prove exact review ownership, input pinning and schema discrimination without provider dispatch.\n  - Subjects: `Proposed src/daemon/threads/__tests__/review-workers.test.ts: reserve one canonical repo/family/reviewId, distinct worker incarnations and correct subject/cleanup exclusions; reject stale-port and forged-owner exchanges.`, `Extend family checkpoint/admission/capacity tests: durable admission variant cannot be read as qualified scope, cannot pass approval, retains exact input, fails safely at unchanged projection bounds, and round-trips historical qualified checkpoints.`\n  - Fixtures: `Small pinned review packets and design artifact subjects from existing fixtures.`, `Admission-phase, failed-admission, interrupted-admission and current qualified-history fixtures; no raw prompt transcripts.`\n- **integration** — Demonstrate actual isolation and acknowledgment ordering using real worker threads, not only mocked callbacks.\n  - Subjects: `Proposed src/daemon/threads/__tests__/review-worker-isolation.test.ts: block review A's expensive admission inside its worker after durable acknowledgment; before releasing its barrier, prove daemon status/progress and review B execute on different threadIds.`, `Run code/code, design/design and code/design permutations from different sessions and from the same session; same-subject exclusion is tested independently of valid parallel reviews.`, `Prove accepted response follows atomic admission save but precedes expensive source/subject work; progress has scope_preparation/task-null and does not claim total or passing verdict.`, `Exercise existing start/resume/recover/progress/controller-exchange/publication/cleanup entrypoints through real MCP-step/RPC routing; assert no old main-thread-only route remains and threads-disabled optional session mode never causes fallback.`\n  - Fixtures: `Real compiled worker entrypoint, existing channel/store-guard/lock fixtures, isolated temporary repo/checkpoints.`, `Worker admission barrier/CPU-block probe and parent-side acknowledgment ordering assertions; generous outer test timeout used only as a test failure guard.`\n- **integration** — Preserve failure, cancellation, cleanup, trusted authority and restart semantics across workers.\n  - Subjects: `Proposed src/daemon/threads/__tests__/review-worker-recovery.test.ts: crash before durable save, after save before ack, during qualified task/chunk execution and during publication; prove targeted interruption, saved feedback retention and explicit replacement after reclamation.`, `Owner disconnect interrupts controller review only; daemon review survives observer disconnect; forged and delayed old-worker messages cannot mutate the replacement.`, `Same-input replay after lost ack never duplicates dispatch; changed input in pinned attempt is refused; failed admission proceeds only on explicit next attempt, interrupted identical admission on explicit recovery.`, `Prove provider/tool child release and lock/store reclamation before replacement dispatch; same-scope approval cleanup refuses active work while unrelated reviews stay alive.`, `Existing code/design ownership, checkpoint, progress, recovery, publication and completion-gate regressions continue to pass.`\n  - Fixtures: `Controlled worker crash points, fake native CLI child with observable termination, provider-call counters.`, `Two independent reviews with separate checkpoints; owner-abort and stale-incarnation messages.`\n- **contract** — Keep all registered review surfaces and live IDE clients aligned with admission progress and historical evidence.\n  - Subjects: `Schema/IPC fixtures prove code and design acknowledgments preserve identity and status meaning, admission-failure results are technical only, unknown/unsupported checkpoint formats are explicit and no unverified input grants approval.`, `Live vscode-plugin and jetbrains-plugin review DTO/renderer tests tolerate/display admission progress and do not convert pending null-task scope to complete or zero-work success.`, `Packaging build includes the new worker entrypoint and starts it from compiled out/ paths; existing workerScript source fallback remains development-only behavior.`\n  - Fixtures: `Existing shared review wire fixtures plus admission-progress and technical-failure variants.`\n- **smoke** — Qualify deployed behavior without uncontrolled review rounds or model costs.\n  - Subjects: `After update/restart, observe concurrent code/design reviews on distinct daemon worker threadIds, acknowledge promptly before a controlled long admission, and keep main/session progress responsive. Use stubbed or paused review fixtures for isolation, not repeated cloud reviews.`, `Resume TU1 S1 only after deployment and a separately valid bounded source-projection scope; do not claim this story removes the 64MiB failure.`\n  - Fixtures: `Updated daemon with compiled review workers; retained checkpoints; no live review killed without targeted user-authorized action.`\n\n**Acceptance mapping**\n\n| Criterion | Proving tests |\n| :--- | :--- |\n| `ac1` | `One worker per review for both families: real code/code, design/design, mixed-family and same-session permutations; distinct runtime threadIds and no main/session fallback.` |\n| `ac2` | `Durable ack precedes blocked expensive admission; main progress/status and second review complete while first worker is blocked; saved admission failure survives reconnect.` |\n| `ac3` | `Trusted-owner bridge refuses forged/stale exchanges; controller disconnect and daemon-observer disconnect retain existing different semantics; no source/pin/approval bypass.` |\n| `ac4` | `Crash/restart/recovery fixture retains task/chunk feedback and exact input, requires explicit recovery, and starts replacement only after worker/child/resource reclamation.` |\n| `ac5` | `Duplicate input replay is idempotent, changed pinned input refused, subject/cleanup exclusion is shared across workers, and cancel/cleanup affect only target review.` |\n| `ac6` | `Historical checkpoint and permanent report compatibility; worker compiled-package smoke; live IDE admission DTO fixtures; unchanged projection-bound refusal remains explicit.` |\n\n## 7. Migration\n\n**State before:** s1 discovery (c1–c4) locates both current main-owned review entrypoints and coordinators, existing worker lifecycle/status primitives, and checkpoint/recovery tests. Code-review start qualifies the committed packet before saving a checkpoint and acknowledging; expensive history projection can outlive MCP 300s. Existing current-format checkpoints contain qualified attempts only; per-review module state and design-subject fencing currently live with main-daemon coordinators.\n\n**State after:** Every code/design review is owned by one dedicated worker from durable admission through execution/publication/recovery. Main host owns routing, trusted connection authority, cross-worker exclusions and progress projections. Existing family checkpoints support explicit unverified admission attempts and qualified history, and updated readers preserve old qualified attempts. Public method names/review identities remain stable; clients display pending admission without treating it as successful empty review. No inference, projection or approval bypass is introduced.\n\n**Zero downtime:** no — **Data rewrite:** no\n\n**Steps**\n\n1. Build the family checkpoint/read/report schema extensions and worker infrastructure together with tests; validate historical qualified fixtures and unverified-admission approval refusal before enabling production routes. No production checkpoint rewrite or activation flag. — ↩ rollbackable\n2. Complete mandatory independent code review and human BUILD approval; publish the unified daemon/MCP/schema and live client changes. Coordinate active reviews before restart: let them finish or explicitly interrupt the selected work with preserved checkpoints. Do not terminate another session's review implicitly. — ↩ rollbackable\n3. Update/restart daemon and reconnect MCP discovery so all hosts read the new admission variant. Route all new and recovered reviews to dedicated workers immediately; optional session threading does not select a review fallback. Read-only completed records remain accessible without inference. — ✕ non-rollbackable\n4. Run compiled-worker and concurrent isolation qualification, confirm targeted resource cleanup and durable admission failures, then resume blocked TU1 work only with separately valid scope. If operational rollback is necessary after new admission records exist, retain upgraded checkpoint readers and those files; do not blind-downgrade to a binary unable to decode them. — ✕ non-rollbackable\n\n**Backward compat:** Preserve existing MCP/RPC method names, reviewId/attempt/action/execution/sequence identity and reviewer independence. Extend registered output/read schemas and client fixtures for admission visibility; code pending status/scope_preparation remain pending and unverified, not a passing verdict. Updated readers accept historical qualified checkpoints and permanent results unchanged. New admission variants are version/capability checked and unsupported readers refuse explicitly. Existing attempt bytes and input pins are not rewritten; only current lifecycle transitions use the new variant. Publication histories distinguish technical admission failures from real task/chunk assessments. A state-preserving rollback after first new-format write must keep compatible readers; there is no legacy-review fallback.\n\n## 8. Alternatives considered\n\n### 8.1 a1: One per-review worker host with family-specific adapters — **CHOSEN**\n\nUse one worker entrypoint and supervisor registry; each worker owns exactly one code or design review and delegates to that family's existing coordinator.\n\nReuse src/daemon/threads/workers.ts startup/reclamation and hub transport. The main daemon maintains trusted ownership/routing and per-review reservations; a worker hosts one existing review-family coordinator and its admission/execution/publication. Extend each family's existing checkpoint with a bounded durable admission variant, not another canonical review ledger. Forward trusted controller exchanges to the owner worker through the main authority bridge. Preserve family-specific review schemas and recovery behavior; add only the shared execution-lifecycle envelope required for isolation.\n\n### 8.2 a2: Separate code-review and design-review worker hosts\n\nUse distinct worker entrypoints and adapter types for the two review families under the existing daemon worker infrastructure.\n\nMain-daemon routing launches a code-only or design-only worker for each review identity. Both hosts independently implement durable admission dispatch, progress forwarding, trusted-controller bridging and worker-exit recovery, while reusing common thread/channel primitives. Existing review coordinators continue to own model/review semantics and persistent family histories.\n\n**Rejected because:** Duplicates admission/ownership/exit lifecycle orchestration across two hosts; a1 fully reuses one lifecycle path while preserving family-specific coordinators.\n\n## 9. References\n\n- **[[c1]]** `code` `src/workflow/code-review/task-review/coordinator.ts` — \"s1 code discovery: src/daemon/task-review-rpc.ts and src/workflow/code-review/task-review/coordinator.ts; verified committed-source admission, per-review reservation, background scheduling and trusted\"\n- **[[c2]]** `code` `src/workflow/review/design-review/coordinator.ts` — \"s1 code discovery: src/daemon/design-review-rpc.ts and src/workflow/review/design-review; coordinator, checkpoint, recovery, subject and publication modules.\"\n- **[[c3]]** `code` `src/daemon/threads/workers.ts` — \"s1 worker reuse discovery: src/daemon/threads/workers.ts, src/daemon/threads/worker-entry.ts, src/daemon/threads/channel.ts, src/daemon/threads/status-board.ts, src/daemon/threads/router.ts, src/daemo\"\n- **[[c4]]** `code` `src/daemon/threads/__tests__/review-state-concurrency.test.ts` — \"s1 test discovery plus direct source corroboration: existing code/design ownership, admission, checkpoint, progress and recovery suites and src/daemon/threads/__tests__/review-state-concurrency.test.t\"\n- **[[c5]]** `prior-artifact` `.insrc/artifacts/ISSUE-e4af63128c7cbec2.json`\n- **[[c6]]** `stakeholder` `User requires a separate worker thread for every review, both code and design, rather than main-daemon or per-chat-thread execution.`\n"},"capturedAt":"2026-11-09T04:39:49.296Z"},"inventory":{"units":[{"id":"/body/summary","selector":"/body/summary","title":"summary","kind":"section"},{"id":"/body/hldContextSlice","selector":"/body/hldContextSlice","title":"hldContextSlice","kind":"section"},{"id":"/body/contractDetails","selector":"/body/contractDetails","title":"contractDetails","kind":"section"},{"id":"/body/dataModelChanges","selector":"/body/dataModelChanges","title":"dataModelChanges","kind":"section"},{"id":"/body/interactionWithShared","selector":"/body/interactionWithShared","title":"interactionWithShared","kind":"section"},{"id":"/body/errorPaths","selector":"/body/errorPaths","title":"errorPaths","kind":"section"},{"id":"/body/testStrategy","selector":"/body/testStrategy","title":"testStrategy","kind":"section"},{"id":"/body/migration","selector":"/body/migration","title":"migration","kind":"section"},{"id":"/body/alternativesConsidered","selector":"/body/alternativesConsidered","title":"alternativesConsidered","kind":"section"},{"id":"/body/chosenAlternative","selector":"/body/chosenAlternative","title":"chosenAlternative","kind":"section"},{"id":"/body/openQuestions","selector":"/body/openQuestions","title":"openQuestions","kind":"section"},{"id":"/body/erDefinition","selector":"/body/erDefinition","title":"erDefinition","kind":"visual"},{"id":"/body/sequenceDefinition","selector":"/body/sequenceDefinition","title":"sequenceDefinition","kind":"visual"},{"id":"/body/componentDependencyDefinition","selector":"/body/componentDependencyDefinition","title":"componentDependencyDefinition","kind":"visual"},{"id":"/body/adherence","selector":"/body/adherence","title":"adherence","kind":"visual"},{"id":"/body/companions","selector":"/body/companions","title":"companions","kind":"visual"},{"id":"/body/alternativesConsidered/0","selector":"/body/alternativesConsidered/0","title":"a1","kind":"requirement"},{"id":"/body/alternativesConsidered/1","selector":"/body/alternativesConsidered/1","title":"a2","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/0","selector":"/body/sequenceDefinition/participants/0","title":"caller","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/1","selector":"/body/sequenceDefinition/participants/1","title":"main","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/2","selector":"/body/sequenceDefinition/participants/2","title":"worker","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/3","selector":"/body/sequenceDefinition/participants/3","title":"checkpoint","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/4","selector":"/body/sequenceDefinition/participants/4","title":"provider","kind":"requirement"},{"id":"/body/componentDependencyDefinition/components/0","selector":"/body/componentDependencyDefinition/components/0","title":"main","kind":"requirement"},{"id":"/body/componentDependencyDefinition/components/1","selector":"/body/componentDependencyDefinition/components/1","title":"worker","kind":"requirement"},{"id":"/body/componentDependencyDefinition/components/2","selector":"/body/componentDependencyDefinition/components/2","title":"threads","kind":"requirement"},{"id":"/body/componentDependencyDefinition/components/3","selector":"/body/componentDependencyDefinition/components/3","title":"code","kind":"requirement"},{"id":"/body/componentDependencyDefinition/components/4","selector":"/body/componentDependencyDefinition/components/4","title":"design","kind":"requirement"},{"id":"/body/componentDependencyDefinition/components/5","selector":"/body/componentDependencyDefinition/components/5","title":"checkpoints","kind":"requirement"},{"id":"/citations/0","selector":"/citations/0","title":"Citation 1","kind":"citation"},{"id":"/citations/1","selector":"/citations/1","title":"Citation 2","kind":"citation"},{"id":"/citations/2","selector":"/citations/2","title":"Citation 3","kind":"citation"},{"id":"/citations/3","selector":"/citations/3","title":"Citation 4","kind":"citation"},{"id":"/citations/4","selector":"/citations/4","title":"Citation 5","kind":"citation"},{"id":"/citations/5","selector":"/citations/5","title":"Citation 6","kind":"citation"},{"id":"document:line:25","selector":"document:line:25","title":"1. HLD context","kind":"section"},{"id":"document:line:175","selector":"document:line:175","title":"4. Diagrams","kind":"section"}]},"completedChunks":[{"chunkId":"scope","status":"passed","summary":"The assigned scope and architectural choice align with the originating ISSUE. Both review families receive dedicated workers, durable acknowledgment precedes expensive admission, and existing projection limits, explicit recovery, trusted ownership and human approval gates remain intact. The shared host preserves family-specific coordinators without introducing another review engine. Upstream and stakeholder citations support the stated intent; no blocking defects were found in this chunk.","findings":[],"inspectedReferences":["/body/summary","/body/hldContextSlice","/body/interactionWithShared","/body/alternativesConsidered","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/chosenAlternative","/body/openQuestions","/citations/4","/citations/5","document:line:25","/home/subho/work/dev/insors/insrc/docs/standalone/isolate-each-code-design-review-its-E20261109e4af6312/S001/LLD.md","/home/subho/work/dev/insors/insrc/.insrc/artifacts/LLD-e4af63128c7cbec2-s1.json","/home/subho/work/dev/insors/insrc/docs/standalone/isolate-each-code-design-review-its-E20261109e4af6312/ISSUE.md","/home/subho/work/dev/insors/insrc/.insrc/artifacts/ISSUE-e4af63128c7cbec2.json","src/daemon/threads/router.ts:246","src/daemon/threads/workers.ts:61","src/daemon/threads/worker-entry.ts:78","src/daemon/task-review-rpc.ts:56","src/daemon/design-review-rpc.ts:17","src/workflow/code-review/task-review/coordinator.ts:83","src/workflow/code-review/task-review/coordinator.ts:137"],"limitations":[],"advice":[]},{"chunkId":"runtime","status":"incomplete","summary":"The assigned runtime contracts preserve review identity, trusted ownership, family coordinators and explicit recovery. Two lifecycle gaps remain: crash-safe child-process reclamation lacks an implementable ownership mechanism, and the claimed startup supervision does not bound a worker that never becomes ready. Component definitions and generated source were inspected; actual rendering could not be verified.","findings":[{"id":"runtime-001","severity":"HIGH","location":"/body/dataModelChanges/5 — Worker exit and resource ownership; LLD.md:155","message":"The design requires child disposal after unexpected worker death before replacement, but delegates this to existing provider/process cleanup capabilities that cannot enforce it. runInProcessGroup owns the detached child, abort listener and exit cleanup entirely inside the calling worker; activity-mode reviews have no timeout. If that worker crashes or is terminated, main has neither a child handle nor a registered disposal operation. StartedWorker.reclaimed only covers locks and store permits. Specify a crash-surviving process ownership/disposal protocol, including spawn-registration races and confirmed disposal before releasing reservations or dispatching a replacement. Otherwise recovery must either remain fenced indefinitely or risk overlapping orphaned CLI/tool work.","evidenceReferences":["docs/standalone/isolate-each-code-design-review-its-E20261109e4af6312/S001/LLD.md:155","src/shared/process-group.ts:108 — detached child creation and worker-local kill closure","src/shared/process-group.ts:118 — activity mode has no timeout","src/shared/process-group.ts:125 — cancellation depends on a local AbortSignal listener","src/shared/process-group.ts:143 — exit cleanup is a local child callback","src/agent/providers/cli-provider.ts:610 — review activity execution uses runInProcessGroup","src/daemon/threads/workers.ts:80 — reclamation includes locks and stores only","src/daemon/threads/supervisor.ts — terminateAll terminates workers without child-process reclamation"]},{"id":"runtime-002","severity":"MED","location":"/body/dataModelChanges/2 — Submission and acknowledgment ordering","message":"The LLD promises a named start failure when a worker never completes startup 'under existing worker startup supervision', but the reused startup path has no readiness deadline. startWorker settles only on worker-ready or exit; Supervisor adds no timeout. A live worker blocked before readiness therefore holds the submission and registry reservation indefinitely, recreating the timeout/already-running failure before durable acknowledgment. Define parent-owned bounded startup supervision, targeted termination and reclamation, late-ready rejection, and a real-worker test that never sends readiness.","evidenceReferences":["docs/standalone/isolate-each-code-design-review-its-E20261109e4af6312/S001/LLD.md — section 3.3","src/daemon/threads/workers.ts:82 — startup promise","src/daemon/threads/workers.ts:86 — rejection requires worker exit","src/daemon/threads/workers.ts:95 — resolution requires worker-ready","src/daemon/threads/supervisor.ts — start and startOrReplace await startup without a deadline","src/daemon/threads/__tests__/supervisor.test.ts:215 — startup-failure coverage exercises an exiting worker","docs/standalone/isolate-each-code-design-review-its-E20261109e4af6312/ISSUE.md — acknowledgment timeout and retained reservation reproduction"]}],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/body/errorPaths","/body/testStrategy","/body/componentDependencyDefinition","/body/componentDependencyDefinition/components/0","/body/componentDependencyDefinition/components/1","/body/componentDependencyDefinition/components/2","/body/componentDependencyDefinition/components/3","/body/componentDependencyDefinition/components/4","/body/componentDependencyDefinition/components/5","/citations/0","/citations/1","/citations/2","/citations/3","/home/subho/work/dev/insors/insrc/docs/standalone/isolate-each-code-design-review-its-E20261109e4af6312/S001/LLD.md","/home/subho/work/dev/insors/insrc/.insrc/artifacts/LLD-e4af63128c7cbec2-s1.json","/home/subho/work/dev/insors/insrc/docs/standalone/isolate-each-code-design-review-its-E20261109e4af6312/ISSUE.md","docs/standalone/isolate-each-code-design-review-its-E20261109e4af6312/S001/component-dependency.html — generated Mermaid source","src/daemon/task-review-rpc.ts","src/daemon/design-review-rpc.ts","src/daemon/threads/workers.ts","src/daemon/threads/worker-entry.ts","src/daemon/threads/channel.ts","src/daemon/threads/router.ts","src/daemon/threads/method-class.ts","src/daemon/threads/status-board.ts","src/daemon/threads/supervisor.ts","src/daemon/threads/main-services.ts","src/daemon/threads/worker-requests.ts","src/daemon/threads/review