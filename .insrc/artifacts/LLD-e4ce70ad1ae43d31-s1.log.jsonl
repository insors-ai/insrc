155448	{"artifactId":"LLD-e4ce70ad1ae43d31-s1","entry":{"id":"0a86255980fc3b02a8bd2f6d0d3671b53baeb6d1396bdf373c373de69418b36d","targetHeadHash":"13d2ffb6809213fcbf03ae68cffeca2cb87dd24080eaa13c340c7f2606c05b66","actor":{"id":"agent:design-review-daemon","kind":"agent","properties":{"party":"daemon"}},"timestamp":"2026-11-11T05:16:31.549Z","operation":"review","revision":{"number":1,"contentHash":"8dc412f8a1973f7bfdb646b134f1b481fb4aaef054895a609e91007f6720cb69"},"outcome":{"result":"block","summary":"Design review review-e4ce70ad-s1-a1 attempt 1","data":{"kind":"design-chunk-review","reviewId":"review-e4ce70ad-s1-a1","project":"/Users/subhagho/work/projects/insors/insrc","artifactId":"LLD-e4ce70ad1ae43d31-s1","subject":{"project":"/Users/subhagho/work/projects/insors/insrc","artifactId":"LLD-e4ce70ad1ae43d31-s1","kind":"LLD","canonicalPath":"/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-e4ce70ad1ae43d31-s1.json","documentPath":"/Users/subhagho/work/projects/insors/insrc/docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/LLD.md","reviewer":"daemon","workflow":{"kind":"standalone","rootArtifactId":"LLD-e4ce70ad1ae43d31-s1","requiredReferences":[],"availableReferences":[],"notApplicableRoles":["PLAN","TASKS","BUILD","CR","DEF","HLD","sibling_stories"]}},"reviewer":"daemon","applicableAttempt":1,"status":"changes_requested","binding":{"sourceRevision":{"number":1,"contentHash":"8dc412f8a1973f7bfdb646b134f1b481fb4aaef054895a609e91007f6720cb69"},"reviewedContentIdentity":"b40e051e40ce0a5a8438cc225f760698b18739d31c00cb8bbee686a72e9fd966","documentDigest":"bfcc0cd023f3cdc0dd8ef6ac0954cc4e9d892ec6a83b0bd9f973089856a3847a","workflowDigest":"2696f291d70fe5c9567ebed115dd93a5b2d22e9f8659a22a823ffc84155657eb","author":"controller"},"preservationDigest":"50e999ba87a72b60dbe888ba0255cdd317cddbc2eb3bceb76a3ba5e383d0c508","schemaVersion":1,"submitted":{"artifactPath":"/Users/subhagho/work/projects/insors/insrc/docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/LLD.md","attempt":1},"attempts":[{"number":1,"status":"changes_requested","preparationKind":"planning","baseline":{"subjectFingerprints":{"canonical":"97f1b24fbe3c27e252cb117a0e07706fb7156604b585444153f4bb0cb7ca9a9b","document":"bfcc0cd023f3cdc0dd8ef6ac0954cc4e9d892ec6a83b0bd9f973089856a3847a"},"contentIdentity":"b40e051e40ce0a5a8438cc225f760698b18739d31c00cb8bbee686a72e9fd966","reviewedContent":{"canonical":"{\n  \"meta\": {\n    \"workflow\": \"design.story\",\n    \"runId\": \"wf-1794371848631-1ts897\",\n    \"repoPath\": \"/Users/subhagho/work/projects/insors/insrc\",\n    \"createdAt\": \"2026-11-11T04:42:53.469Z\",\n    \"epicCreatedAt\": \"2026-11-11T04:42:53.469Z\",\n    \"attribution\": {\n      \"outputs\": [\n        {\n          \"role\": \"(client)\",\n          \"tier\": \"core\",\n          \"runner\": \"cli-claude\",\n          \"model\": \"unknown\"\n        }\n      ]\n    },\n    \"elapsedMs\": 324327,\n    \"repoIndexedAt\": null,\n    \"schemaVersion\": 1,\n    \"epicHash\": \"e4ce70ad1ae43d31\",\n    \"epicSlug\": \"show-human-readable-timestamp-dev-chat\",\n    \"storyId\": \"s1\",\n    \"hldBaseRunId\": \"wf-1794371848631-1ts897\",\n    \"hldEffectiveHash\": \"e4ce70ad1ae43d313a8540be7c257ea59a68f2f3096235009bd57c183aa0e92b\",\n    \"hldAmendmentsApplied\": [],\n    \"storyTitle\": \"Show a human-readable timestamp in the dev-chat who-row (user left, provider right, smaller font)\",\n    \"standalone\": true,\n    \"sizeClass\": \"small\",\n    \"triageRationale\": \"One cohesive UX add: an optional ts on the transcript row, rendered as a smaller, opposite-end-aligned time in the existing who-row. It touches a small, known set of files inside the single chat module (render-registry.ts host mirror + webview string + CSS, session-store.ts TranscriptEntry, the row-creation sites in chat-panel/turn-lifecycle/session-file-store, and the parity tests), with one obvious approach (optional field, default-now, render in whoRow) and no new contract or storage-schema change — a session-file-store row simply gains an optional field. That is a small (one story, few tasks), not trivial: it spans more than one file and needs the host/webview parity kept.\",\n    \"authoredBy\": \"controller\",\n    \"lifecycle\": {\n      \"status\": \"draft\",\n      \"revision\": {\n        \"number\": 1,\n        \"contentHash\": \"8dc412f8a1973f7bfdb646b134f1b481fb4aaef054895a609e91007f6720cb69\",\n        \"at\": \"2026-11-11T04:42:53.702Z\",\n        \"by\": {\n          \"id\": \"insrc:system\",\n          \"kind\": \"system\",\n          \"properties\": {}\n        }\n      },\n      \"signoffs\": []\n    },\n    \"revision\": 1\n  },\n  \"body\": {\n    \"alternativesConsidered\": [\n      {\n        \"id\": \"a1\",\n        \"name\": \"Render existing `at` in the who-row (smallest, no data change)\",\n        \"oneLineSummary\": \"Format the already-persisted `at` ISO field in whoRow as a small muted span at the opposite end of the label; zero changes to TranscriptEntry, creation sites, or persistence.\",\n        \"approach\": \"Reuse the existing `at: string` (ISO) on every TranscriptEntry (session-store.ts:31-103). Host toViewModel (render-registry.ts:116-194) passes `at` through on user/assistant RowViewModel meta; the webview whoRow (render-registry.ts:407-409, called from msgRow :404-439) takes an optional `at` and renders a `<span class='insrc-when'>` formatted with `new Date(at).toLocaleTimeString()`. Opposite-end placement: the user message row is right-aligned (insrc-msg--user, detected by transcript-pager.ts:79), so the time span is PREPENDED (left end); the assistant row is left-aligned, so the span is APPENDED with margin-left:auto (right end). New CSS `.insrc-when{font-size:10px;opacity:.65;margin:0 6px;align-self:center;}` beside `.insrc-who` (11px). Missing/invalid `at` renders no span.\",\n        \"pros\": [\n          \"No protocol or persisted-data change at all — `at` exists on every row already and is set at creation (chat-panel.ts:2889, :3178).\",\n          \"Smallest diff: host toViewModel meta + webview whoRow + one CSS rule + parity tests; old sessions render real historical times.\",\n          \"Old session files need no backfill; rows with unparseable `at` degrade to today's markup.\"\n        ],\n        \"cons\": [\n          \"toLocaleTimeString output varies by OS locale (acceptable for a chat timestamp); formatting runs in both the host mirror and the webview string, so the parity test must pin both paths.\",\n          \"Parity surface grows by one field on two renderers (host meta + webview string).\"\n        ],\n        \"costEstimate\": \"S\"\n      },\n      {\n        \"id\": \"a2\",\n        \"name\": \"New optional `ts` field on the row\",\n        \"oneLineSummary\": \"Add `ts?: number` to TranscriptEntry + RowViewModel and render it in whoRow, defaulting to `at` when absent.\",\n        \"approach\": \"Add an optional `ts?: number` (epoch ms) to the user/assistant TranscriptEntry variant and to RowViewModel, populated with Date.now() at the same creation sites that set `at`; whoRow renders from `ts` when present, falling back to parsing `at`. This adds a second timestamp field purely for rendering convenience.\",\n        \"pros\": [\n          \"Epoch ms is cheap to format in both host and webview.\",\n          \"Matches the request's literal suggestion of an optional ts field on the row.\"\n        ],\n        \"cons\": [\n          \"Duplicates `at` — two sources of truth for one fact, must be kept in sync at every creation site (chat-panel.ts:2889, :3178, plus markers/diffs).\",\n          \"Touches session-store.ts type, creation sites, session-file-store load path, and both renderers — strictly more surface than a1 for zero user-visible gain.\",\n          \"Optional field on a persisted row still needs a load-path decision for old files (default undefined).\"\n        ],\n        \"costEstimate\": \"S\",\n        \"reasonRejected\": \"Meets the visible requirement but duplicates `at` as `ts`, adding type + creation-site + load-path surface for zero user-visible gain; only partially satisfies the no-protocol/storage-change, parity, and old-session constraints (s3 rank 2).\"\n      },\n      {\n        \"id\": \"a3\",\n        \"name\": \"Tooltip-only timestamp on the who-label\",\n        \"oneLineSummary\": \"Put the formatted time in the label span's title attribute; nothing new is drawn.\",\n        \"approach\": \"Render the timestamp as a `title` tooltip on the existing who-label span (render-registry.ts:407-409): set `title = new Date(at).toLocaleString()`; no new DOM node, no CSS.\",\n        \"pros\": [\n          \"Trivial diff; zero layout risk.\"\n        ],\n        \"cons\": [\n          \"Not visible without hover — does not meet the requirement to SHOW the time in the who-row.\",\n          \"No opposite-end placement and no smaller font element at all.\"\n        ],\n        \"costEstimate\": \"XS\",\n        \"reasonRejected\": \"Cheapest (XS) but violates the core requirement — hover-only tooltip, the time is not shown in the who-row; also no opposite-end placement and no smaller-font element (s3 rank 4).\"\n      },\n      {\n        \"id\": \"a4\",\n        \"name\": \"Pre-format `when` in host toViewModel, webview prints it\",\n        \"oneLineSummary\": \"Host formats `at` into a short `when` string in RowViewModel.meta; whoRow renders that string as the small opposite-end span.\",\n        \"approach\": \"Format once in the host: toViewModel emits a pre-formatted `when: string` (HH:MM via a fixed Intl.DateTimeFormat) in RowViewModel.meta; the webview whoRow prints `meta.when` verbatim and never calls Date/toLocale itself.\",\n        \"pros\": [\n          \"Single formatting implementation, single place to test the string.\",\n          \"Webview renderer stays dumb (no Date calls in the injected string), which suits the strict-CSP fake-DOM tests.\"\n        ],\n        \"cons\": [\n          \"Host owns the locale/format choice; the parity test must pin the exact formatted string, slightly more test code than passing `at` raw.\",\n          \"Webview locale adjustment is lost (irrelevant in practice — the webview shares the host locale).\"\n        ],\n        \"costEstimate\": \"S\",\n        \"reasonRejected\": \"Ties a1 behaviorally on every acceptance axis but loses on diff size: formatter plus string-pinning test live in the host mirror, while a1 passes the raw ISO `at` through the view-model and keeps row data untouched end to end (s3 rank 2).\"\n      }\n    ],\n    \"chosenAlternative\": \"a1\",\n    \"contractDetails\": {\n      \"api\": [\n        {\n          \"errors\": [],\n          \"name\": \"toViewModel\",\n          \"parameters\": [\n            {\n              \"name\": \"entry\",\n              \"optional\": false,\n              \"purpose\": \"TranscriptEntry | TurnEvent being rendered; its existing `at` ISO string is now surfaced on user/assistant rows\",\n              \"type\": \"TranscriptEntry | TurnEvent\"\n            }\n          ],\n          \"postconditions\": [\n            \"User and assistant-text RowViewModels carry meta.at = entry.at (verbatim ISO string); all other row kinds unchanged\"\n          ],\n          \"preconditions\": [\n            \"entry.role is 'user' or 'assistant' for the at pass-through\"\n          ],\n          \"returns\": {\n            \"meaning\": \"RowViewModel for the transcript row; user/assistant variants gain meta.at\",\n            \"type\": \"RowViewModel\"\n          },\n          \"signature\": \"toViewModel(entry: TranscriptEntry | TurnEvent): RowViewModel — host mirror, vscode-plugin/src/chat/render-registry.ts:116-194\"\n        },\n        {\n          \"errors\": [],\n          \"name\": \"whoRow (webview renderer string)\",\n          \"parameters\": [\n            {\n              \"name\": \"role\",\n              \"optional\": false,\n              \"purpose\": \"ChatRole 'user' | 'assistant' selecting glyph, label and time placement\",\n              \"type\": \"ChatRole\"\n            },\n            {\n              \"name\": \"glyph\",\n              \"optional\": false,\n              \"purpose\": \"❯ for user, ◆ for assistant\",\n              \"type\": \"string\"\n            },\n            {\n              \"name\": \"label\",\n              \"optional\": false,\n              \"purpose\": \"'you' / provider label\",\n              \"type\": \"string\"\n            },\n            {\n              \"name\": \"at\",\n              \"optional\": true,\n              \"purpose\": \"ISO timestamp from the row; when absent/invalid no time span is rendered\",\n              \"type\": \"string | undefined\"\n            }\n          ],\n          \"postconditions\": [\n            \"who-row contains a span.insrc-when with toLocaleTimeString(HH:MM) of `at`, PREPENDED for user (label row is right-aligned) and APPENDED with margin-left:auto for assistant (label row is left-aligned)\",\n            \"Row with missing/invalid at renders exactly as before (no span, no throw)\"\n          ],\n          \"preconditions\": [\n            \"msgRow built the row for a user/assistant message\"\n          ],\n          \"returns\": {\n            \"meaning\": \"The .insrc-who div for the message row\",\n            \"type\": \"HTMLElement (fake-DOM in tests)\"\n          },\n          \"signature\": \"whoRow(role, glyph, label, at?) — inside the webview renderer string, vscode-plugin/src/chat/render-registry.ts:407-409, called from msgRow:404-439\"\n        }\n      ],\n      \"summary\": {\n        \"audience\": \"technical\",\n        \"prose\": \"The dev-chat who-row (the 'you ❯' / '◆ provider' label above each message bubble) gains a small, muted, human-readable time at the opposite end of the label: left side on the right-aligned user row, right side on the left-aligned assistant/provider row. The timestamp is NOT new data — every TranscriptEntry already persists `at` (ISO) — so this story is render-only: surface `at` through the host toViewModel mirror and the webview whoRow string, format it with toLocaleTimeString, and style the new span smaller than the 11px label.\"\n      },\n      \"surfaceLevel\": \"internal\"\n    },\n    \"dataModelChanges\": [\n      {\n        \"callSites\": [\n          \"vscode-plugin/src/chat/render-registry.ts:116-194\",\n          \"vscode-plugin/src/chat/render-registry.ts:404-439\",\n          \"vscode-plugin/src/chat/chat-panel.ts:2889\",\n          \"vscode-plugin/src/chat/chat-panel.ts:3178\"\n        ],\n        \"change\": \"field-add\",\n        \"details\": \"RowViewModel user/assistant variants gain `meta.at?: string` carrying the TranscriptEntry's existing `at` ISO verbatim. TranscriptEntry itself is UNCHANGED (`at` already exists on every variant, vscode-plugin/src/chat/session-store.ts:31-103); session-file-store persistence untouched; old rows render their real historical time.\",\n        \"entity\": \"RowViewModel (meta) / TranscriptEntry.at (consumed, unmodified)\"\n      },\n      {\n        \"callSites\": [\n          \"vscode-plugin/src/chat/render-registry.ts:407-409\",\n          \"vscode-plugin/src/chat/chat-panel.ts\"\n        ],\n        \"change\": \"field-add\",\n        \"details\": \"New CSS class .insrc-when{font-size:10px;opacity:.65;margin:0 6px;align-self:center;} placed beside .insrc-who (11px); placement rule: user row prepends the span (left end of the right-aligned user who-row), assistant row appends with margin-left:auto (right end of the left-aligned assistant who-row).\",\n        \"entity\": \".insrc-when (webview CSS class + whoRow span)\"\n      }\n    ],\n    \"errorPaths\": {\n      \"edgeCases\": [\n        {\n          \"expected\": \"No .insrc-when span is rendered; the who-row is identical to the pre-story markup (regression guard for old session files and hand-edited stores).\",\n          \"input\": \"Persisted TranscriptEntry from an old session file lacking a parseable `at` (empty string, non-ISO, or far-future date)\"\n        },\n        {\n          \"expected\": \"Assistant rows created live from assistant-delta events (vscode-plugin/src/chat/chat-panel.ts:3178) carry at=now() and show the current time; rows replayed from disk via transcript-pager show the stored historical time.\",\n          \"input\": \"Live vs replayed assistant rows — same renderer, different `at` source\"\n        },\n        {\n          \"expected\": \"Time span is prepended (left end of the right-aligned user who-row, insrc-msg--user); user label + glyph stay at the right in their existing order.\",\n          \"input\": \"role='user' who-row\"\n        },\n        {\n          \"expected\": \"Time span is appended (right end, margin-left:auto) after glyph+label; the assistant who-row stays left-aligned.\",\n          \"input\": \"role='assistant' who-row\"\n        },\n        {\n          \"expected\": \"Tool-result, permission-outcome, selection-outcome, diff and marker rows never get a time span — whoRow is only called from the user/assistant msgRow path.\",\n          \"input\": \"Non-message row kinds (marker, tool-result, permission-outcome, selection-outcome, diff)\"\n        }\n      ],\n      \"errorCases\": [\n        {\n          \"detection\": \"In whoRow, `at` is parsed with `new Date(at)` and validated with `isNaN(d.getTime())`; an absent or unparseable `at` yields null and no span is created.\",\n          \"recoverable\": true,\n          \"response\": \"Render no .insrc-when span; the who-row falls back to the exact pre-story markup. No throw — the renderer's existing try/catch fallback still applies on top.\",\n          \"scenario\": \"A row with missing or invalid `at` reaches the webview whoRow (old session file, hand-edited store, clock skew)\",\n          \"userImpact\": \"No timestamp on that one row; everything else renders normally.\"\n        }\n      ],\n      \"invariantsToPreserve\": [\n        {\n          \"source\": \"c1\",\n          \"text\": \"TranscriptEntry already carries `at: string` on EVERY variant, set at creation (chat-panel.ts:2889 user, :3178 assistant) and persisted by session-file-store — this story must not add, rename, or reformat that field (s1 bundle: vscode-plugin/src/chat/session-store.ts:31-103).\"\n        },\n        {\n          \"source\": \"c1\",\n          \"text\": \"Host toViewModel and the webview renderer string are mirrors pinned by parity tests (vscode-plugin/src/chat/__tests__/render-registry.test.ts, __tests__/transcript-pager.test.ts) — any whoRow change must land in both and keep the parity tests green (s1 bundle: render-registry.ts:116-194, :404-439).\"\n        },\n        {\n          \"source\": \"c1\",\n          \"text\": \"User message rows are right-aligned via the insrc-msg--user class (detected at transcript-pager.ts:79) and assistant rows are left-aligned by default — the time span must go to the OPPOSITE end of each row's label without changing the row alignment itself (s1 bundle).\"\n        }\n      ]\n    },\n    \"hldContextSlice\": {\n      \"adjacentBoundaries\": [],\n      \"boundary\": {\n        \"depends\": [],\n        \"internal\": \"Show a human-readable timestamp in the dev-chat who-row (user left, provider right, smaller font)\",\n        \"owns\": [],\n        \"storyId\": \"s1\"\n      },\n      \"consumedContracts\": [],\n      \"frameworkSummary\": \"Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\",\n      \"nonFunctional\": {},\n      \"ownedContracts\": [],\n      \"rolloutPhase\": \"standalone\"\n    },\n    \"interactionWithShared\": [],\n    \"migration\": {\n      \"backwardCompat\": \"Full. The change is render-only: no TranscriptEntry field is added, removed, or reformatted, so session files written by older versions load unchanged and simply render their stored `at` time, and a build without this change renders rows as before because nothing new is persisted. Rows with a missing/unparseable `at` render the old markup (no span), so hand-edited or future stores degrade gracefully. Rollback is reverting the renderer commit; nothing is rewritten.\",\n      \"dataRewriteRequired\": false,\n      \"migrationSteps\": [\n        {\n          \"action\": \"No data migration: every persisted TranscriptEntry already has `at` (set at creation; s1 bundle c1 — session-store.ts:31-103, chat-panel.ts:2889/:3178), so no backfill of session files is needed. Renderers degrade to the old markup for any row whose `at` is missing/unparseable.\",\n          \"order\": 1,\n          \"rollbackable\": true\n        },\n        {\n          \"action\": \"Ship the renderer change (host toViewModel meta.at + webview whoRow span.insrc-when + .insrc-when CSS) as one commit. Rollback = revert that commit; old rows keep their `at` and nothing is rewritten.\",\n          \"order\": 2,\n          \"rollbackable\": true\n        }\n      ],\n      \"stateAfter\": \"User/assistant who-rows render a small muted .insrc-when time (formatted from the row's existing `at`) at the opposite end of the label — left on the right-aligned user row, right on the left-aligned assistant row. Non-message rows and rows without a parseable `at` are unchanged.\",\n      \"stateBefore\": \"The who-row renders only glyph+label ('you ❯' / '◆ provider'); TranscriptEntry rows already persist `at` (ISO) on every variant but it is never displayed (s1 bundle: session-store.ts:31-103, chat-panel.ts:2889/:3178, render-registry.ts:404-439).\",\n      \"zeroDowntime\": true\n    },\n    \"openQuestions\": [],\n    \"summary\": {\n      \"audience\": \"technical\",\n      \"prose\": \"The dev-chat who-row (the 'you ❯' / '◆ provider' label above each message bubble) gains a small, muted, human-readable time at the opposite end of the label: left side on the right-aligned user row, right side on the left-aligned assistant/provider row. The timestamp is NOT new data — every TranscriptEntry already persists `at` (ISO) — so this story is render-only: surface `at` through the host toViewModel mirror and the webview whoRow string, format it with toLocaleTimeString, and style the new span smaller than the 11px label.\"\n    },\n    \"testStrategy\": {\n      \"acceptanceMapping\": [\n        {\n          \"criterionId\": \"ac1\",\n          \"provingTests\": [\n            \"vscode-plugin/src/chat/__tests__/render-registry.test.ts: who-row shows span.insrc-when with the formatted time for a user row (span is the FIRST child — left end)\",\n            \"vscode-plugin/src/chat/__tests__/render-registry.test.ts: who-row shows span.insrc-when for an assistant row (span is the LAST child — right end via margin-left:auto)\",\n            \"vscode-plugin/src/chat/__tests__/transcript-pager.test.ts: a replayed stored row keeps its `at` and renders the same span\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac2\",\n          \"provingTests\": [\n            \"vscode-plugin/src/chat/__tests__/render-registry.test.ts: invalid/empty `at` renders no span.insrc-when and the who-row markup is unchanged (fallback test)\",\n            \"vscode-plugin/src/chat/__tests__/render-registry.test.ts: parity test — host toViewModel meta.at === the `at` passed to the webview whoRow\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac3\",\n          \"provingTests\": [\n            \"vscode-plugin/src/chat/__tests__/render-registry.test.ts: .insrc-when CSS present with font-size smaller than .insrc-who (10px vs 11px)\",\n            \"vscode-plugin/src/chat/__tests__/render-registry.test.ts: non-message rows (marker / tool-result / permission-outcome / diff) render no time span\"\n          ]\n        }\n      ],\n      \"testFramework\": \"node:test via `npx tsx --test` — repo convention reported by convention.detect on vscode-plugin/src/chat: tests are `*.test.ts` under `__tests__/`\",\n      \"testLevels\": [\n        {\n          \"fixturesNeeded\": [\n            \"the fake-DOM harness already in vscode-plugin/src/chat/__tests__/render-registry.test.ts (label()/line() row helpers)\",\n            \"a TranscriptEntry fixture with a fixed ISO `at`, e.g. '2026-11-11T04:18:13.568Z'\"\n          ],\n          \"level\": \"unit\",\n          \"purpose\": \"Pin the who-row rendering: time span presence, placement (first vs last child), formatted text, absent-`at` fallback, non-message rows unaffected, and host/webview parity for meta.at.\",\n          \"subjects\": [\n            \"vscode-plugin/src/chat/render-registry.ts (host toViewModel + webview renderer string whoRow/msgRow)\",\n            \"vscode-plugin/src/chat/__tests__/render-registry.test.ts\"\n          ]\n        },\n        {\n          \"fixturesNeeded\": [\n            \"a restored session fixture with a stored transcript row (transcript-pager.test.ts already builds `restored(...)` views)\"\n          ],\n          \"level\": \"integration\",\n          \"purpose\": \"Replay path: a persisted row with `at` renders the time in the paged transcript; live assistant-delta rows (chat-panel.ts:3178) get at=now() and render too.\",\n          \"subjects\": [\n            \"vscode-plugin/src/chat/transcript-pager.ts\",\n            \"vscode-plugin/src/chat/__tests__/transcript-pager.test.ts\",\n            \"vscode-plugin/src/chat/chat-panel.ts:2889\",\n            \"vscode-plugin/src/chat/chat-panel.ts:3178 (creation sites, unchanged — regression only)\"\n          ]\n        }\n      ]\n    },\n    \"uxDefinition\": {\n      \"body\": [\n        {\n          \"description\": \"Post-change who-row for a user message: the row is right-aligned, so the small time span sits at the LEFT end, opposite the label.\",\n          \"items\": [\n            {\n              \"description\": \"The time rendered as span.insrc-when, prepended for the user row (left end of the right-aligned row).\",\n              \"text\": \"[ 04:18 ]\",\n              \"type\": \"TextBlock\",\n              \"weight\": \"bolder\"\n            },\n            {\n              \"description\": \"The existing user label with its glyph, unchanged, at the right end of the row.\",\n              \"text\": \"you ❯\",\n              \"type\": \"TextBlock\",\n              \"weight\": \"bolder\"\n            }\n          ],\n          \"type\": \"Container\"\n        },\n        {\n          \"description\": \"Post-change who-row for a provider/assistant message: the row is left-aligned, so the small time span sits at the RIGHT end, opposite the label.\",\n          \"items\": [\n            {\n              \"description\": \"The existing provider label with its glyph, unchanged, at the left end of the row.\",\n              \"text\": \"◆ claude\",\n              \"type\": \"TextBlock\",\n              \"weight\": \"bolder\"\n            },\n            {\n              \"description\": \"The time rendered as span.insrc-when, appended with margin-left:auto for the assistant row (right end of the left-aligned row).\",\n              \"text\": \"[ 04:18 ]\",\n              \"type\": \"TextBlock\",\n              \"weight\": \"bolder\"\n            }\n          ],\n          \"type\": \"Container\"\n        },\n        {\n          \"description\": \".insrc-when is font-size:10px with opacity:.65, smaller and more muted than the 11px .insrc-who label. Rows without a parseable `at` render no span at all — the who-row falls back to the exact previous markup.\",\n          \"text\": \".insrc-when { font-size: 10px; opacity: .65; } vs .insrc-who { font-size: 11px; } — missing/unparseable `at` renders no span.\",\n          \"type\": \"TextBlock\",\n          \"wrap\": true\n        }\n      ],\n      \"narrative\": \"Shows the changed who-row layout for both roles so a reviewer can assess the opposite-end placement and the smaller font at a glance: the user label sits at the right of a right-aligned row with the time at its left; the provider label sits at the left of a left-aligned row with the time at its right.\",\n      \"type\": \"AdaptiveCard\",\n      \"version\": \"1.5\"\n    },\n    \"companions\": [\n      {\n        \"kind\": \"ux-mock\",\n        \"relPath\": \"docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/ux-mock.html\",\n        \"title\": \"UX mock\"\n      }\n    ]\n  },\n  \"citations\": [\n    {\n      \"id\": \"c1\",\n      \"kind\": \"step-output\",\n      \"quotedText\": \"Every TranscriptEntry variant already carries `readonly at: string`, set at creation (user rows chat-panel.ts:2889, assistant-delta rows chat-panel.ts:3178); rendering is dual (host toViewModel vs webview whoRow) and parity-pinned by __tests__/render-registry.test.ts + __tests__/transcript-pager.test.ts; user rows right-aligned via insrc-msg--user (transcript-pager.ts:79). Consequence: the timestamp is render-only.\",\n      \"ref\": \"s1 context.assemble — analyzeBundles[0] (design.story e4ce70ad1ae43d31/s1)\"\n    },\n    {\n      \"id\": \"c2\",\n      \"kind\": \"code\",\n      \"ref\": \"vscode-plugin/src/chat/session-store.ts:31-103\"\n    },\n    {\n      \"id\": \"c3\",\n      \"kind\": \"code\",\n      \"ref\": \"vscode-plugin/src/chat/render-registry.ts:61-68\"\n    },\n    {\n      \"id\": \"c4\",\n      \"kind\": \"code\",\n      \"ref\": \"vscode-plugin/src/chat/render-registry.ts:116-194\"\n    },\n    {\n      \"id\": \"c5\",\n      \"kind\": \"code\",\n      \"ref\": \"vscode-plugin/src/chat/render-registry.ts:404-439\"\n    },\n    {\n      \"id\": \"c6\",\n      \"kind\": \"code\",\n      \"ref\": \"vscode-plugin/src/chat/render-registry.ts:407-409\"\n    },\n    {\n      \"id\": \"c7\",\n      \"kind\": \"code\",\n      \"ref\": \"vscode-plugin/src/chat/chat-panel.ts:2889\"\n    },\n    {\n      \"id\": \"c8\",\n      \"kind\": \"code\",\n      \"ref\": \"vscode-plugin/src/chat/chat-panel.ts:3178\"\n    },\n    {\n      \"id\": \"c9\",\n      \"kind\": \"code\",\n      \"ref\": \"vscode-plugin/src/chat/transcript-pager.ts:79\"\n    },\n    {\n      \"id\": \"c10\",\n      \"kind\": \"code\",\n      \"ref\": \"vscode-plugin/src/chat/session-file-store.ts\"\n    },\n    {\n      \"id\": \"c11\",\n      \"kind\": \"code\",\n      \"ref\": \"vscode-plugin/src/chat/__tests__/render-registry.test.ts\"\n    },\n    {\n      \"id\": \"c12\",\n      \"kind\": \"code\",\n      \"ref\": \"vscode-plugin/src/chat/__tests__/transcript-pager.test.ts\"\n    },\n    {\n      \"id\": \"c13\",\n      \"kind\": \"step-output\",\n      \"ref\": \"s2 alternatives.enumerate + s3 alternatives.judge — 4 alternatives a1-a4 scored against 6 constraints, winner a1\"\n    },\n    {\n      \"id\": \"c14\",\n      \"kind\": \"step-output\",\n      \"ref\": \"s8 checklist.verify — all 22 items passed, none missed/ambiguous\"\n    }\n  ]\n}\n","document":"<!-- insrc:artifact LLD-e4ce70ad1ae43d31-s1 -->\n\n# LLD: STORY-e4ce70ad1ae43d31-s1 — Show a human-readable timestamp in the dev-chat who-row (user left, provider right, smaller font)\n\n## Summary\n\n**Epic:** `show-human-readable-timestamp-dev-chat`\n**HLD base run:** `wf-1794371848631-1ts897`\n**HLD effective hash:** `e4ce70ad1ae4...`\n\nThe dev-chat who-row (the 'you ❯' / '◆ provider' label above each message bubble) gains a small, muted, human-readable time at the opposite end of the label: left side on the right-aligned user row, right side on the left-aligned assistant/provider row. The timestamp is NOT new data — every TranscriptEntry already persists `at` (ISO) — so this story is render-only: surface `at` through the host toViewModel mirror and the webview whoRow string, format it with toLocaleTimeString, and style the new span smaller than the 11px label.\n\n## Contents\n\n1. [HLD context](#1-hld-context)\n2. [Contract details](#2-contract-details)\n3. [Data model changes](#3-data-model-changes)\n4. [Error paths](#4-error-paths)\n5. [Test strategy](#5-test-strategy)\n6. [Migration](#6-migration)\n7. [Alternatives considered](#7-alternatives-considered)\n8. [UX](#8-ux)\n9. [References](#9-references)\n\n## 1. HLD context\n\n**Framework:** Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\n**Rollout phase:** standalone\n\n## 2. Contract details\n\n**Surface level:** internal\n\n### 2.1 `toViewModel`\n\n```typescript\ntoViewModel(entry: TranscriptEntry | TurnEvent): RowViewModel — host mirror, vscode-plugin/src/chat/render-registry.ts:116-194\n```\n\n**Parameters:**\n- `entry: TranscriptEntry | TurnEvent` — TranscriptEntry | TurnEvent being rendered; its existing `at` ISO string is now surfaced on user/assistant rows\n\n**Returns:** `RowViewModel` — RowViewModel for the transcript row; user/assistant variants gain meta.at\n\n**Preconditions:**\n- entry.role is 'user' or 'assistant' for the at pass-through\n\n**Postconditions:**\n- User and assistant-text RowViewModels carry meta.at = entry.at (verbatim ISO string); all other row kinds unchanged\n\n### 2.2 `whoRow (webview renderer string)`\n\n```typescript\nwhoRow(role, glyph, label, at?) — inside the webview renderer string, vscode-plugin/src/chat/render-registry.ts:407-409, called from msgRow:404-439\n```\n\n**Parameters:**\n- `role: ChatRole` — ChatRole 'user' | 'assistant' selecting glyph, label and time placement\n- `glyph: string` — ❯ for user, ◆ for assistant\n- `label: string` — 'you' / provider label\n- `at: string | undefined` _(optional)_ — ISO timestamp from the row; when absent/invalid no time span is rendered\n\n**Returns:** `HTMLElement (fake-DOM in tests)` — The .insrc-who div for the message row\n\n**Preconditions:**\n- msgRow built the row for a user/assistant message\n\n**Postconditions:**\n- who-row contains a span.insrc-when with toLocaleTimeString(HH:MM) of `at`, PREPENDED for user (label row is right-aligned) and APPENDED with margin-left:auto for assistant (label row is left-aligned)\n- Row with missing/invalid at renders exactly as before (no span, no throw)\n\n## 3. Data model changes\n\n### 3.1 `RowViewModel (meta) / TranscriptEntry.at (consumed, unmodified)` — field-add\n\nRowViewModel user/assistant variants gain `meta.at?: string` carrying the TranscriptEntry's existing `at` ISO verbatim. TranscriptEntry itself is UNCHANGED (`at` already exists on every variant, vscode-plugin/src/chat/session-store.ts:31-103); session-file-store persistence untouched; old rows render their real historical time.\n\n**Call sites:**\n- `vscode-plugin/src/chat/render-registry.ts:116-194`\n- `vscode-plugin/src/chat/render-registry.ts:404-439`\n- `vscode-plugin/src/chat/chat-panel.ts:2889`\n- `vscode-plugin/src/chat/chat-panel.ts:3178`\n\n### 3.2 `.insrc-when (webview CSS class + whoRow span)` — field-add\n\nNew CSS class .insrc-when{font-size:10px;opacity:.65;margin:0 6px;align-self:center;} placed beside .insrc-who (11px); placement rule: user row prepends the span (left end of the right-aligned user who-row), assistant row appends with margin-left:auto (right end of the left-aligned assistant who-row).\n\n**Call sites:**\n- `vscode-plugin/src/chat/render-registry.ts:407-409`\n- `vscode-plugin/src/chat/chat-panel.ts`\n\n## 4. Error paths\n\n**Error cases**\n\n- **A row with missing or invalid `at` reaches the webview whoRow (old session file, hand-edited store, clock skew)** (recoverable)\n  - Detection: In whoRow, `at` is parsed with `new Date(at)` and validated with `isNaN(d.getTime())`; an absent or unparseable `at` yields null and no span is created.\n  - Response: Render no .insrc-when span; the who-row falls back to the exact pre-story markup. No throw — the renderer's existing try/catch fallback still applies on top.\n  - User impact: No timestamp on that one row; everything else renders normally.\n\n**Edge cases**\n\n| Input | Expected |\n| :--- | :--- |\n| Persisted TranscriptEntry from an old session file lacking a parseable `at` (empty string, non-ISO, or far-future date) | No .insrc-when span is rendered; the who-row is identical to the pre-story markup (regression guard for old session files and hand-edited stores). |\n| Live vs replayed assistant rows — same renderer, different `at` source | Assistant rows created live from assistant-delta events (vscode-plugin/src/chat/chat-panel.ts:3178) carry at=now() and show the current time; rows replayed from disk via transcript-pager show the stored historical time. |\n| role='user' who-row | Time span is prepended (left end of the right-aligned user who-row, insrc-msg--user); user label + glyph stay at the right in their existing order. |\n| role='assistant' who-row | Time span is appended (right end, margin-left:auto) after glyph+label; the assistant who-row stays left-aligned. |\n| Non-message row kinds (marker, tool-result, permission-outcome, selection-outcome, diff) | Tool-result, permission-outcome, selection-outcome, diff and marker rows never get a time span — whoRow is only called from the user/assistant msgRow path. |\n\n**Invariants to preserve**\n\n- TranscriptEntry already carries `at: string` on EVERY variant, set at creation (chat-panel.ts:2889 user, :3178 assistant) and persisted by session-file-store — this story must not add, rename, or reformat that field (s1 bundle: vscode-plugin/src/chat/session-store.ts:31-103). [[c1]]\n- Host toViewModel and the webview renderer string are mirrors pinned by parity tests (vscode-plugin/src/chat/__tests__/render-registry.test.ts, __tests__/transcript-pager.test.ts) — any whoRow change must land in both and keep the parity tests green (s1 bundle: render-registry.ts:116-194, :404-439). [[c1]]\n- User message rows are right-aligned via the insrc-msg--user class (detected at transcript-pager.ts:79) and assistant rows are left-aligned by default — the time span must go to the OPPOSITE end of each row's label without changing the row alignment itself (s1 bundle). [[c1]]\n\n## 5. Test strategy\n\n**Test framework:** `node:test via `npx tsx --test` — repo convention reported by convention.detect on vscode-plugin/src/chat: tests are `*.test.ts` under `__tests__/``\n\n**Test levels**\n\n- **unit** — Pin the who-row rendering: time span presence, placement (first vs last child), formatted text, absent-`at` fallback, non-message rows unaffected, and host/webview parity for meta.at.\n  - Subjects: `vscode-plugin/src/chat/render-registry.ts (host toViewModel + webview renderer string whoRow/msgRow)`, `vscode-plugin/src/chat/__tests__/render-registry.test.ts`\n  - Fixtures: `the fake-DOM harness already in vscode-plugin/src/chat/__tests__/render-registry.test.ts (label()/line() row helpers)`, `a TranscriptEntry fixture with a fixed ISO `at`, e.g. '2026-11-11T04:18:13.568Z'`\n- **integration** — Replay path: a persisted row with `at` renders the time in the paged transcript; live assistant-delta rows (chat-panel.ts:3178) get at=now() and render too.\n  - Subjects: `vscode-plugin/src/chat/transcript-pager.ts`, `vscode-plugin/src/chat/__tests__/transcript-pager.test.ts`, `vscode-plugin/src/chat/chat-panel.ts:2889`, `vscode-plugin/src/chat/chat-panel.ts:3178 (creation sites, unchanged — regression only)`\n  - Fixtures: `a restored session fixture with a stored transcript row (transcript-pager.test.ts already builds `restored(...)` views)`\n\n**Acceptance mapping**\n\n| Criterion | Proving tests |\n| :--- | :--- |\n| `ac1` | `vscode-plugin/src/chat/__tests__/render-registry.test.ts: who-row shows span.insrc-when with the formatted time for a user row (span is the FIRST child — left end)`, `vscode-plugin/src/chat/__tests__/render-registry.test.ts: who-row shows span.insrc-when for an assistant row (span is the LAST child — right end via margin-left:auto)`, `vscode-plugin/src/chat/__tests__/transcript-pager.test.ts: a replayed stored row keeps its `at` and renders the same span` |\n| `ac2` | `vscode-plugin/src/chat/__tests__/render-registry.test.ts: invalid/empty `at` renders no span.insrc-when and the who-row markup is unchanged (fallback test)`, `vscode-plugin/src/chat/__tests__/render-registry.test.ts: parity test — host toViewModel meta.at === the `at` passed to the webview whoRow` |\n| `ac3` | `vscode-plugin/src/chat/__tests__/render-registry.test.ts: .insrc-when CSS present with font-size smaller than .insrc-who (10px vs 11px)`, `vscode-plugin/src/chat/__tests__/render-registry.test.ts: non-message rows (marker / tool-result / permission-outcome / diff) render no time span` |\n\n## 6. Migration\n\n**State before:** The who-row renders only glyph+label ('you ❯' / '◆ provider'); TranscriptEntry rows already persist `at` (ISO) on every variant but it is never displayed (s1 bundle: session-store.ts:31-103, chat-panel.ts:2889/:3178, render-registry.ts:404-439).\n\n**State after:** User/assistant who-rows render a small muted .insrc-when time (formatted from the row's existing `at`) at the opposite end of the label — left on the right-aligned user row, right on the left-aligned assistant row. Non-message rows and rows without a parseable `at` are unchanged.\n\n**Zero downtime:** yes — **Data rewrite:** no\n\n**Steps**\n\n1. No data migration: every persisted TranscriptEntry already has `at` (set at creation; s1 bundle c1 — session-store.ts:31-103, chat-panel.ts:2889/:3178), so no backfill of session files is needed. Renderers degrade to the old markup for any row whose `at` is missing/unparseable. — ↩ rollbackable\n2. Ship the renderer change (host toViewModel meta.at + webview whoRow span.insrc-when + .insrc-when CSS) as one commit. Rollback = revert that commit; old rows keep their `at` and nothing is rewritten. — ↩ rollbackable\n\n**Backward compat:** Full. The change is render-only: no TranscriptEntry field is added, removed, or reformatted, so session files written by older versions load unchanged and simply render their stored `at` time, and a build without this change renders rows as before because nothing new is persisted. Rows with a missing/unparseable `at` render the old markup (no span), so hand-edited or future stores degrade gracefully. Rollback is reverting the renderer commit; nothing is rewritten.\n\n## 7. Alternatives considered\n\n### 7.1 a1: Render existing `at` in the who-row (smallest, no data change) — **CHOSEN**\n\nFormat the already-persisted `at` ISO field in whoRow as a small muted span at the opposite end of the label; zero changes to TranscriptEntry, creation sites, or persistence.\n\nReuse the existing `at: string` (ISO) on every TranscriptEntry (session-store.ts:31-103). Host toViewModel (render-registry.ts:116-194) passes `at` through on user/assistant RowViewModel meta; the webview whoRow (render-registry.ts:407-409, called from msgRow :404-439) takes an optional `at` and renders a `<span class='insrc-when'>` formatted with `new Date(at).toLocaleTimeString()`. Opposite-end placement: the user message row is right-aligned (insrc-msg--user, detected by transcript-pager.ts:79), so the time span is PREPENDED (left end); the assistant row is left-aligned, so the span is APPENDED with margin-left:auto (right end). New CSS `.insrc-when{font-size:10px;opacity:.65;margin:0 6px;align-self:center;}` beside `.insrc-who` (11px). Missing/invalid `at` renders no span.\n\n### 7.2 a2: New optional `ts` field on the row\n\nAdd `ts?: number` to TranscriptEntry + RowViewModel and render it in whoRow, defaulting to `at` when absent.\n\nAdd an optional `ts?: number` (epoch ms) to the user/assistant TranscriptEntry variant and to RowViewModel, populated with Date.now() at the same creation sites that set `at`; whoRow renders from `ts` when present, falling back to parsing `at`. This adds a second timestamp field purely for rendering convenience.\n\n**Rejected because:** Meets the visible requirement but duplicates `at` as `ts`, adding type + creation-site + load-path surface for zero user-visible gain; only partially satisfies the no-protocol/storage-change, parity, and old-session constraints (s3 rank 2).\n\n### 7.3 a3: Tooltip-only timestamp on the who-label\n\nPut the formatted time in the label span's title attribute; nothing new is drawn.\n\nRender the timestamp as a `title` tooltip on the existing who-label span (render-registry.ts:407-409): set `title = new Date(at).toLocaleString()`; no new DOM node, no CSS.\n\n**Rejected because:** Cheapest (XS) but violates the core requirement — hover-only tooltip, the time is not shown in the who-row; also no opposite-end placement and no smaller-font element (s3 rank 4).\n\n### 7.4 a4: Pre-format `when` in host toViewModel, webview prints it\n\nHost formats `at` into a short `when` string in RowViewModel.meta; whoRow renders that string as the small opposite-end span.\n\nFormat once in the host: toViewModel emits a pre-formatted `when: string` (HH:MM via a fixed Intl.DateTimeFormat) in RowViewModel.meta; the webview whoRow prints `meta.when` verbatim and never calls Date/toLocale itself.\n\n**Rejected because:** Ties a1 behaviorally on every acceptance axis but loses on diff size: formatter plus string-pinning test live in the host mirror, while a1 passes the raw ISO `at` through the view-model and keeps row data untouched end to end (s3 rank 2).\n\n## 8. UX\n\n- [UX mock](docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/ux-mock.html)\n\n## 9. References\n\n- **[[c1]]** `step-output` `s1 context.assemble — analyzeBundles[0] (design.story e4ce70ad1ae43d31/s1)` — \"Every TranscriptEntry variant already carries `readonly at: string`, set at creation (user rows chat-panel.ts:2889, assistant-delta rows chat-panel.ts:3178); rendering is dual (host toViewModel vs web\"\n- **[[c2]]** `code` `vscode-plugin/src/chat/session-store.ts:31-103`\n- **[[c3]]** `code` `vscode-plugin/src/chat/render-registry.ts:61-68`\n- **[[c4]]** `code` `vscode-plugin/src/chat/render-registry.ts:116-194`\n- **[[c5]]** `code` `vscode-plugin/src/chat/render-registry.ts:404-439`\n- **[[c6]]** `code` `vscode-plugin/src/chat/render-registry.ts:407-409`\n- **[[c7]]** `code` `vscode-plugin/src/chat/chat-panel.ts:2889`\n- **[[c8]]** `code` `vscode-plugin/src/chat/chat-panel.ts:3178`\n- **[[c9]]** `code` `vscode-plugin/src/chat/transcript-pager.ts:79`\n- **[[c10]]** `code` `vscode-plugin/src/chat/session-file-store.ts`\n- **[[c11]]** `code` `vscode-plugin/src/chat/__tests__/render-registry.test.ts`\n- **[[c12]]** `code` `vscode-plugin/src/chat/__tests__/transcript-pager.test.ts`\n- **[[c13]]** `step-output` `s2 alternatives.enumerate + s3 alternatives.judge — 4 alternatives a1-a4 scored against 6 constraints, winner a1`\n- **[[c14]]** `step-output` `s8 checklist.verify — all 22 items passed, none missed/ambiguous`\n"},"capturedAt":"2026-11-11T04:43:03.815Z"},"inventory":{"units":[{"id":"/body/alternativesConsidered","selector":"/body/alternativesConsidered","title":"alternativesConsidered","kind":"section"},{"id":"/body/chosenAlternative","selector":"/body/chosenAlternative","title":"chosenAlternative","kind":"section"},{"id":"/body/contractDetails","selector":"/body/contractDetails","title":"contractDetails","kind":"section"},{"id":"/body/dataModelChanges","selector":"/body/dataModelChanges","title":"dataModelChanges","kind":"section"},{"id":"/body/errorPaths","selector":"/body/errorPaths","title":"errorPaths","kind":"section"},{"id":"/body/hldContextSlice","selector":"/body/hldContextSlice","title":"hldContextSlice","kind":"section"},{"id":"/body/interactionWithShared","selector":"/body/interactionWithShared","title":"interactionWithShared","kind":"section"},{"id":"/body/migration","selector":"/body/migration","title":"migration","kind":"section"},{"id":"/body/openQuestions","selector":"/body/openQuestions","title":"openQuestions","kind":"section"},{"id":"/body/summary","selector":"/body/summary","title":"summary","kind":"section"},{"id":"/body/testStrategy","selector":"/body/testStrategy","title":"testStrategy","kind":"section"},{"id":"/body/uxDefinition","selector":"/body/uxDefinition","title":"uxDefinition","kind":"visual"},{"id":"/body/companions","selector":"/body/companions","title":"companions","kind":"visual"},{"id":"/body/alternativesConsidered/0","selector":"/body/alternativesConsidered/0","title":"a1","kind":"requirement"},{"id":"/body/alternativesConsidered/1","selector":"/body/alternativesConsidered/1","title":"a2","kind":"requirement"},{"id":"/body/alternativesConsidered/2","selector":"/body/alternativesConsidered/2","title":"a3","kind":"requirement"},{"id":"/body/alternativesConsidered/3","selector":"/body/alternativesConsidered/3","title":"a4","kind":"requirement"},{"id":"/citations/0","selector":"/citations/0","title":"Citation 1","kind":"citation"},{"id":"/citations/1","selector":"/citations/1","title":"Citation 2","kind":"citation"},{"id":"/citations/2","selector":"/citations/2","title":"Citation 3","kind":"citation"},{"id":"/citations/3","selector":"/citations/3","title":"Citation 4","kind":"citation"},{"id":"/citations/4","selector":"/citations/4","title":"Citation 5","kind":"citation"},{"id":"/citations/5","selector":"/citations/5","title":"Citation 6","kind":"citation"},{"id":"/citations/6","selector":"/citations/6","title":"Citation 7","kind":"citation"},{"id":"/citations/7","selector":"/citations/7","title":"Citation 8","kind":"citation"},{"id":"/citations/8","selector":"/citations/8","title":"Citation 9","kind":"citation"},{"id":"/citations/9","selector":"/citations/9","title":"Citation 10","kind":"citation"},{"id":"/citations/10","selector":"/citations/10","title":"Citation 11","kind":"citation"},{"id":"/citations/11","selector":"/citations/11","title":"Citation 12","kind":"citation"},{"id":"/citations/12","selector":"/citations/12","title":"Citation 13","kind":"citation"},{"id":"/citations/13","selector":"/citations/13","title":"Citation 14","kind":"citation"},{"id":"document:line:25","selector":"document:line:25","title":"1. HLD context","kind":"section"},{"id":"document:line:185","selector":"document:line:185","title":"8. UX","kind":"section"}]},"completedChunks":[{"chunkId":"scope-summary","status":"passed","summary":"The LLD correctly declares itself standalone (meta.standalone=true, hldContextSlice.frameworkSummary/rolloutPhase both say \"standalone\", boundary.owns/depends/consumedContracts/ownedContracts/adjacentBoundaries all empty) with no invented Epic/HLD ancestry — consistent with the workflow metadata and the \"Not applicable: DEF, HLD, sibling_stories\" scope given to this review. The summary's render-only framing (no new persisted data; `at` already exists on every TranscriptEntry, only surfaced through RowViewModel.meta and the webview whoRow string) is accurate and matches the contractDetails/dataModelChanges sections, and does not overreach into unrelated scope. openQuestions is genuinely empty — the one real design fork (reuse `at` vs. add a new `ts` field) was resolved explicitly as alternative a2, rejected with a stated rationale, not left as a silent open question. interactionWithShared is empty, which is appropriate for a standalone story with no sibling stories or shared HLD contracts to interact with.","findings":[{"id":"triage-rationale-mismatch","severity":"LOW","location":"LLD-e4ce70ad1ae43d31-s1.json meta.triageRationale vs body.chosenAlternative","message":"meta.triageRationale (written at triage time) describes the approach as adding 'an optional ts on the transcript row... a session-file-store row simply gains an optional field', which is alternative a2. The LLD body actually chose a1 (reuse the existing `at` field, no new TranscriptEntry/session-store field at all) and explicitly rejected a2 for duplicating `at`. The stale triage rationale is not part of the LLD body's scope framing itself and does not affect body/summary, hldContextSlice, interactionWithShared or openQuestions, but a reader comparing the two documents could be misled about what was actually designed/built.","evidenceReferences":[".insrc/artifacts/LLD-e4ce70ad1ae43d31-s1.json:30 (meta.triageRationale)",".insrc/artifacts/LLD-e4ce70ad1ae43d31-s1.json:115 (body.chosenAlternative=\"a1\")",".insrc/artifacts/LLD-e4ce70ad1ae43d31-s1.json:67-82 (alternative a2, rejected)"]}],"inspectedReferences":["/body/summary","/body/hldContextSlice","/body/interactionWithShared","/body/openQuestions","document:line:25","/Users/subhagho/work/projects/insors/insrc/docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/LLD.md",".insrc/artifacts/LLD-e4ce70ad1ae43d31-s1.json#body.summary",".insrc/artifacts/LLD-e4ce70ad1ae43d31-s1.json#body.hldContextSlice",".insrc/artifacts/LLD-e4ce70ad1ae43d31-s1.json#body.interactionWithShared",".insrc/artifacts/LLD-e4ce70ad1ae43d31-s1.json#body.openQuestions",".insrc/artifacts/LLD-e4ce70ad1ae43d31-s1.json#meta.standalone",".insrc/artifacts/LLD-e4ce70ad1ae43d31-s1.json#meta.triageRationale",".insrc/artifacts/LLD-e4ce70ad1ae43d31-s1.json#body.alternativesConsidered",".insrc/artifacts/LLD-e4ce70ad1ae43d31-s1.json#body.contractDetails",".insrc/artifacts/LLD-e4ce70ad1ae43d31-s1.json#body.dataModelChanges"],"limitations":[],"advice":["Consider refreshing meta.triageRationale (or noting in the LLD that the design superseded the triage's initial a2-shaped sizing) so the two documents don't drift on which approach was actually chosen — purely cosmetic, not blocking."]},{"chunkId":"contracts-data-model","status":"changes_requested","summary":"Verified the contractDetails and dataModelChanges sections of LLD-e4ce70ad1ae43d31-s1 against the actual render-registry.ts / chat-panel.ts / session-store.ts / transcript-pager.ts code. The TranscriptEntry.at field, chat-panel.ts creation sites (2889, 3178), and transcript-pager.ts:79 citations are accurate. However, the design's §2.1/§3.1 contract for `toViewModel` names and cites ONLY the exported, test-only host-side `toViewModel` (render-registry.ts:116-194) — the function actually used at runtime is a separate, textually-duplicated `toViewModel` embedded inside `renderRegistryWebviewSource()` (render-registry.ts:464-490), which the design never mentions or cites. Since a parity test (render-registry.test.ts:236) asserts the two implementations stay byte-for-byte equivalent, and since the webview copy is the one that actually executes in the shipped extension, the design's contract for making `meta.at` available to `whoRow` is materially incomplete. Additionally, the whoRow (cited 407-409, actually 406-411) and msgRow (cited 404-439, actually 416-439) line ranges are imprecise, and the label text in the Summary ('provider') doesn't match the literal code ('claude').","findings":[{"id":"f1-missing-webview-toviewmodel","severity":"HIGH","location":"docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/LLD.md §2.1 (toViewModel) and §3.1 (Call sites); vscode-plugin/src/chat/render-registry.ts:464-490","message":"The design's toViewModel contract and call-site list name only the exported host-side toViewModel (render-registry.ts:116-194), which is imported ONLY by render-registry.test.ts (chat-panel.ts never imports the named toViewModel, only renderRegistryWebviewSource and RENDER_REGISTRY_STYLE). The function that actually runs in the shipped extension is a second, hand-duplicated toViewModel embedded in the webview source string at render-registry.ts:464-490 (commented there as 'single-sourced mirror of the host toViewModel ... a parity test pins the two together'). That parity test is render-registry.test.ts:236. The design never cites or instructs editing this webview-side function, so following the contract as written would add meta.at only to the host mirror, breaking the parity test and/or leaving the live-rendered who-row (the actual user-visible path) without the at value whoRow needs.","evidenceReferences":["vscode-plugin/src/chat/render-registry.ts:116","vscode-plugin/src/chat/render-registry.ts:462-490","vscode-plugin/src/chat/chat-panel.ts:16","vscode-plugin/src/chat/__tests__/render-registry.test.ts:236","vscode-plugin/src/chat/transcript-pager.ts:100","docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/LLD.md lines 34-50","docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/LLD.md lines 78-82"]},{"id":"f2-whorow-line-range-imprecise","severity":"MED","location":"docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/LLD.md §2.2 (whoRow citation render-registry.ts:407-409)","message":"The design cites whoRow's definition as render-registry.ts:407-409, but the actual function spans lines 406-411: the signature function whoRow(role,glyph,label){ is at line 406 (outside the cited range) and the closing return w;} is at line 411 (also outside the range). The signature change the design requires (adding a 4th parameter at?) happens exactly at the line the citation omits.","evidenceReferences":["vscode-plugin/src/chat/render-registry.ts:406","vscode-plugin/src/chat/render-registry.ts:407-409","vscode-plugin/src/chat/render-registry.ts:411"]},{"id":"f3-msgrow-line-range-overbroad","severity":"MED","location":"docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/LLD.md §2.2 (msgRow citation render-registry.ts:404-439) and §3.1 call sites","message":"The design cites msgRow as render-registry.ts:404-439, but msgRow actually begins at line 416 (function msgRow(vm,host,role,inner){); lines 403-415 contain the unrelated isLong function, the whoRow function, and block comments. The actual whoRow call sites needing the new at argument are at line 419 (inside the cited range but not pinpointed), making the citation imprecise about where the real edit occurs.","evidenceReferences":["vscode-plugin/src/chat/render-registry.ts:403","vscode-plugin/src/chat/render-registry.ts:416","vscode-plugin/src/chat/render-registry.ts:419"]},{"id":"f4-label-text-mismatch","severity":"LOW","location":"docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/LLD.md Summary (line 11)","message":"The design's summary describes the who-row label as 'you' / 'provider', but the actual webview code's assistant label literal is 'claude', not 'provider' (render-registry.ts:419). This is cosmetic but indicates the label text wasn't checked against the literal strings being modified.","evidenceReferences":["docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/LLD.md line 11","vscode-plugin/src/chat/render-registry.ts:419"]},{"id":"f5-css-callsite-vague","severity":"LOW","location":"docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/LLD.md §3.2 call sites (chat-panel.ts, no line number)","message":"Section 3.2 lists chat-panel.ts (unqualified, no line) as a call site for the new .insrc-when CSS class. chat-panel.ts only injects the pre-built RENDER_REGISTRY_STYLE string constant into the webview HTML (chat-panel.ts:2368) — it is not itself an edit location for the CSS rule, which must be added inside the RENDER_REGISTRY_STYLE constant in render-registry.ts (lines 202-315). The vague citation could mislead an implementer into looking for a CSS edit location in chat-panel.ts.","evidenceReferences":["docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/LLD.md line 90","vscode-plugin/src/chat/chat-panel.ts:2368","vscode-plugin/src/chat/render-registry.ts:202-315"]}],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/Users/subhagho/work/projects/insors/insrc/docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/LLD.md","vscode-plugin/src/chat/render-registry.ts:61-68","vscode-plugin/src/chat/render-registry.ts:116-194","vscode-plugin/src/chat/render-registry.ts:202-315","vscode-plugin/src/chat/render-registry.ts:403-439","vscode-plugin/src/chat/render-registry.ts:462-490","vscode-plugin/src/chat/render-registry.ts:518-525","vscode-plugin/src/chat/chat-panel.ts:2875-2905","vscode-plugin/src/chat/chat-panel.ts:3165-3190","vscode-plugin/src/chat/chat-panel.ts:2368","vscode-plugin/src/chat/session-store.ts:31-103","vscode-plugin/src/chat/transcript-pager.ts:79","vscode-plugin/src/chat/transcript-pager.ts:100","vscode-plugin/src/chat/__tests__/render-registry.test.ts:204-236"],"limitations":[],"advice":["Cite both toViewModel implementations explicitly (host render-registry.ts:116-194 AND webview render-registry.ts:462-490) in §2.1/§3.1, and add the webview toViewModel's meta.at change as an explicit task/contract item so it isn't left to implementer discovery.","Tighten the whoRow citation to 406-411 and the msgRow citation to 416-439 (or explicitly separate the two ranges) so an implementer can navigate directly to the exact lines needing the signature/call-site change.","Fix the Summary's label text ('provider' -> 'claude') to match the literal string being modified, or generalize the wording to avoid a literal mismatch.","Replace the vague chat-panel.ts CSS call site in §3.2 with the precise RENDER_REGISTRY_STYLE constant location in render-registry.ts."]},{"chunkId":"error-handling","status":"changes_requested","summary":"Section 4 (Error paths) is mostly sound and verified against current code (textContent-only convention, try/catch fallback in renderRow, TranscriptEntry.at on every variant, isUserRow/alignment CSS, msgRow exclusivity to user/assistant rows). However the stated detection algorithm does not actually cover one of its own cited edge cases, and the \"live assistant row\" edge case misattributes a code site and is not achievable under the LLD's own contract scoping.","findings":[{"id":"far-future-date-not-detected","severity":"MED","location":"LLD.md §4 Error paths / Edge cases table, row 1 (\"empty string, non-ISO, or far-future date\")","message":"The stated detection logic — `new Date(at)` plus `isNaN(d.getTime())` — does NOT flag a far-future date as invalid: `new Date('9999-12-31T00:00:00Z')` parses successfully and `isNaN(d.getTime())` is false, so the algorithm will NOT suppress the span for that case. This directly contradicts the edge-case table's own expected outcome (\"No .insrc-when span is rendered\") for a far-future `at`. Either the detection algorithm needs an additional bound check (e.g. reject `at` values beyond some sane future window) or the edge-case row's expectation needs to be corrected to say a far-future date renders a (nonsensical but non-throwing) far-future time, not that it is suppressed.","evidenceReferences":["LLD.md:96-98 (detection: new Date(at) + isNaN(d.getTime()))","LLD.md:103-105 (edge-case table row: empty string, non-ISO, or far-future date -> No span)"]},{"id":"live-assistant-at-source-unsupported","severity":"MED","location":"LLD.md §4 Error paths / Edge cases table, row 2 (\"Live vs replayed assistant rows\")","message":"The edge case claims assistant rows \"created live from assistant-delta events (chat-panel.ts:3178) carry at=now() and show the current time.\" This is not supported by the LLD's own contract or the current code: (1) chat-panel.ts:3178 (`rowForEvent`) builds the DURABLE TranscriptEntry pushed into `s.transcript` for persistence — it is not the object the webview renders live. The live echo is the raw `TurnEvent` posted via `post({ type:'turn-event', event:{ kind:'assistant-delta', turnId, text } })` (chat-panel.ts:1545), which carries no `at` at all (TurnEvent's assistant-delta variant has no `at` field — vscode-plugin/src/chat/stream-events.ts:31). (2) Contract §2.1's own precondition scopes the at-pass-through to `entry.role === 'user' | 'assistant'` branches of toViewModel, explicitly NOT to the TurnEvent `kind === 'assistant-delta'` branch (render-registry.ts:155-157), so under the LLD's own contract the live-streaming row's RowViewModel never gets `meta.at` and would render with no time span (the same 'missing at' fallback), contradicting the edge case's claim that it 'shows the current time' while streaming.","evidenceReferences":["LLD.md:106 (edge-case table row 2)","vscode-plugin/src/chat/chat-panel.ts:3178 (rowForEvent builds the durable TranscriptEntry, not the live-posted event)","vscode-plugin/src/chat/chat-panel.ts:1545 (post({type:'turn-event', event:{kind:'assistant-delta',turnId,text}}) — no `at`)","vscode-plugin/src/chat/stream-events.ts:31 (TurnEvent assistant-delta variant has no `at` field)","vscode-plugin/src/chat/render-registry.ts:116-126 (toViewModel's at pass-through is written only inside the entry.role branches)","vscode-plugin/src/chat/render-registry.ts:155-157 (the TurnEvent kind==='assistant-delta' branch has no meta.at)"]},{"id":"alignment-citation-imprecise","severity":"LOW","location":"LLD.md §4 Invariants to preserve, third bullet","message":"The invariant cites `transcript-pager.ts:79` as where user rows are \"right-aligned via the insrc-msg--user class,\" but that line (`isUserRow`) only detects the class for the pager's trim/scroll bookkeeping — it does not implement or prove the alignment. The actual right-alignment rule is the CSS `.insrc-msg--user{align-items:flex-end;}` in chat-panel.ts:2376. The underlying claim (row is right-aligned) is correct and verified, but the citation points a future reader at the wrong evidence for alignment specifically.","evidenceReferences":["LLD.md:115","vscode-plugin/src/chat/transcript-pager.ts:79 (class detection only, not alignment)","vscode-plugin/src/chat/chat-panel.ts:2376 (.insrc-msg--user{align-items:flex-end;} — the actual alignment rule)"]}],"inspectedReferences":["/body/errorPaths","/Users/subhagho/work/projects/insors/insrc/docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/LLD.md","vscode-plugin/src/chat/render-registry.ts:1-200","vscode-plugin/src/chat/render-registry.ts:380-461","vscode-plugin/src/chat/render-registry.ts:505-506","vscode-plugin/src/chat/session-store.ts:1-110","vscode-plugin/src/chat/transcript-pager.ts:60-89","vscode-plugin/src/chat/chat-panel.ts:2880-2894","vscode-plugin/src/chat/chat-panel.ts:3170-3219","vscode-plugin/src/chat/chat-panel.ts:2370-2381","vscode-plugin/src/chat/stream-events.ts:29-35","vscode-plugin/src/chat/chat-panel.ts:1540-1556"],"limitations":[],"advice":["Section 4's invariant list could explicitly restate the existing textContent-only / no-innerHTML convention for the new span.insrc-when, even though it is inherited from the surrounding whoRow code and poses no injection risk today (the rendered text is always a locale-formatted Date string, never raw `at`).","Consider adding one more edge-case row explicitly describing the live-streaming assistant-delta row's time-span behavior (none, per the current contract scoping) so a future reader does not assume parity with the replayed-row behavior."]},{"chunkId":"test-strategy","status":"changes_requested","summary":"The test-strategy section itself is reasonably structured (correct framework, real fixtures for the replay path, a sensible unit/integration split), but it fails to catch a real functional gap in the upstream contract: the LIVE rendering paths for both roles never actually carry an `at` value, so the acceptance mapping's claim that live rows show a timestamp is unverifiable and, as currently coded, false. No proving test in the mapping exercises a genuinely live (non-replayed) row.","findings":[{"id":"ts-live-at-gap","severity":"HIGH","location":"docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/LLD.md#5-test-strategy (edge-case table row 'Live vs replayed assistant rows', acceptance mapping ac1)","message":"The test strategy's integration test and ac1 proving tests claim (via the edge-case table) that a LIVE assistant-delta row 'carries at=now() and show[s] the current time'. This is not true of the actual live code path and the LLD names no call site that would make it true, so no test can actually prove it as scoped. The live webview append for an assistant turn goes through `reg.renderRow(reg.toViewModel(ev))` on the raw TurnEvent (vscode-plugin/src/chat/chat-panel.ts:2651-2663); the TurnEvent 'assistant-delta' variant has no `at` field at all (vscode-plugin/src/chat/stream-events.ts:31), and toViewModel's assistant-delta branch (render-registry.ts:155-157 host, :480 webview) builds the RowViewModel with no `at`/`meta.at`. The row cited as the live example, chat-panel.ts:3178 (`rowForEvent`), only builds the entry used for DURABLE PERSISTENCE, not the one rendered live. Likewise the live USER-row echo goes over a dedicated `post({type:'user-row', text, key, rowIndex, ...})` message (chat-panel.ts:2898-2905) that carries no `at`, consumed by `reg.toViewModel({role:'user',text:m.text,attachments:m.attachments})` (chat-panel.ts:2677) — again no `at`. Section 2 (contracts) and section 3.1 (call sites) never name chat-panel.ts:2651-2663, :2677, or :2898-2905, nor the webview's own inline `toViewModel` mirror (render-registry.ts:464-490) that must independently gain the same `at` plumbing used by the host copy. Without design work at these sites, the acceptance-mapping row for ac1 that cites 'a replayed stored row keeps its at and renders the same span' is the ONLY test that can pass; no test proves a live row renders a time, contradicting the edge-case table's explicit claim and ac1's intent that the feature works during a live turn, not just after reload.","evidenceReferences":["docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/LLD.md:106 (edge-case table row)","docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/LLD.md:132-134 (ac1 proving tests)","vscode-plugin/src/chat/chat-panel.ts:2651-2663","vscode-plugin/src/chat/chat-panel.ts:2677","vscode-plugin/src/chat/chat-panel.ts:2898-2905","vscode-plugin/src/chat/chat-panel.ts:3176-3178","vscode-plugin/src/chat/stream-events.ts:31","vscode-plugin/src/chat/render-registry.ts:116,155-157","vscode-plugin/src/chat/render-registry.ts:404-411,464,480"]},{"id":"ts-fixture-mischaracterized","severity":"LOW","location":"docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/LLD.md#5-test-strategy (unit fixtures)","message":"The unit-test fixtures are described as 'the fake-DOM harness already in render-registry.test.ts (label()/line() row helpers)'. `line` is indeed a shared closure the harness exposes (vscode-plugin/src/chat/__tests__/render-registry.test.ts:79-89), but `label()` is a one-off local helper defined inside a single later diff-widget test (render-registry.test.ts:1219), not a generally reusable row-rendering fixture alongside `line`. Citing it as a shared 'row helper' overstates what the new who-row tests can actually reuse; the real reusable surface is `makeRegistry()`/`appended`/`line` plus `findByClass`/`allText`.","evidenceReferences":["docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/LLD.md:125","vscode-plugin/src/chat/__tests__/render-registry.test.ts:75-89","vscode-plugin/src/chat/__tests__/render-registry.test.ts:1219"]}],"inspectedReferences":["/body/testStrategy","/Users/subhagho/work/projects/insors/insrc/docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/LLD.md","vscode-plugin/src/chat/__tests__/render-registry.test.ts:1-728","vscode-plugin/src/chat/__tests__/transcript-pager.test.ts:198 (restored fixture)","vscode-plugin/src/chat/render-registry.ts:1-200","vscode-plugin/src/chat/render-registry.ts:395-490","vscode-plugin/src/chat/session-store.ts:31-103","vscode-plugin/src/chat/chat-panel.ts:2880-2920","vscode-plugin/src/chat/chat-panel.ts:3160-3190","vscode-plugin/src/chat/stream-events.ts:31,213","vscode-plugin/src/chat/transcript-pager.ts:70-85"],"limitations":[],"advice":["Add explicit call sites and contract text for threading `at` through the LIVE paths: (1) the 'user-row' postMessage payload (chat-panel.ts ~2898-2905) should carry the row's `at`, and the webview handler (chat-panel.ts:2677) should pass it into toViewModel's input; (2) either add an `at`/timestamp to the live 'assistant-delta' TurnEvent, or have the webview's toViewModel compute `at: new Date().toISOString()` at render time for that branch, mirroring the host.","Once the live-path plumbing is designed, add a named test to the acceptance mapping that actually renders a LIVE (non-replayed) user and assistant row and asserts a current-time span appears — the current mapping only proves the replay path for ac1.","Consider renaming the fixture description to reference `makeRegistry()`/`line`/`findByClass` rather than `label()`, which is test-local and unrelated to who-row rendering."]},{"chunkId":"migration-rollout","status":"passed","summary":"The migration section's three claims hold up against the actual code. (1) \"Zero downtime, no data rewrite\" is justified: RowViewModel is explicitly documented as \"never persisted\" (render-registry.ts:59,97) and derived at view time from the unmodified TranscriptEntry.at field, which is already a required string on every variant (session-store.ts:37,50,58,70,102) — no on-disk shape changes, so there is nothing to rewrite. (2) The single-commit rollback story is realistic given the actual scope: the only non-trivial edits are toViewModel (render-registry.ts:116-194) and the webview whoRow/msgRow source (render-registry.ts:404-439) plus one CSS rule; the chat-panel.ts:2889/:3178 creation sites already set `at` today and need no change (confirmed by reading those lines), so the change set is small enough for the stated single-commit revert. (3) The backward-compat/error-paths claim is consistent with the loader: session-store.ts's own comment states \"isSession does no per-row check\" and the store \"degrades to empty rather than throwing\" on a corrupt entry, so an old or hand-edited row genuinely can arrive at runtime with a missing/malformed `at` despite the TS type marking it required — exactly the scenario the error-paths section (section 4) handles via the isNaN(d.getTime()) guard and no-throw fallback.","findings":[],"inspectedReferences":["/body/migration","/Users/subhagho/work/projects/insors/insrc/docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/LLD.md","vscode-plugin/src/chat/render-registry.ts:55-194","vscode-plugin/src/chat/render-registry.ts:400-439","vscode-plugin/src/chat/session-store.ts:1-110","vscode-plugin/src/chat/chat-panel.ts:2880-2900","vscode-plugin/src/chat/chat-panel.ts:3165-3190","vscode-plugin/src/chat/transcript-pager.ts:70-89","vscode-plugin/src/chat/chat-panel.ts:2374-2381"],"limitations":[],"advice":["Section 3.1's \"Call sites\" list conflates the two field-producing sites (chat-panel.ts:2889, :3178, where `at` is already set and require no change) with the two field-consuming sites that actually change (render-registry.ts:116-194, :404-439). Splitting these into \"producers (unchanged)\" vs \"consumers (changed)\" would make the migration's small-diff/single-commit-rollback claim even more self-evidently verifiable without needing to cross-check chat-panel.ts.","The \"Zero downtime\" framing is boilerplate service terminology that doesn't map cleanly onto a client-side VS Code extension update; consider rephrasing as \"no persisted-data migration required, safe to roll forward/back at any time\" to avoid implying a service-availability concern that doesn't apply here. Non-blocking."]},{"chunkId":"alternatives","status":"passed","summary":"Reviewed the Alternatives section (§7) and chosenAlternative field. Four alternatives (a1-a4) are meaningfully distinct in mechanism (pass-through existing `at` vs new `ts` field vs tooltip-only vs host-pre-formatted string) and each pros/cons set fairly reflects a real trade-off against the captured scope (no protocol/storage change, host/webview parity, old-session compatibility). Rejection rationale for a2 (duplicate `ts` field), a3 (tooltip-only fails the visible-time requirement), and a4 (ties a1 on behavior but loses on diff footprint by moving formatting/pinning into the host) is sound and does not contradict a1's actual design. The chosen alternative a1's one-line summary and approach text match the detailed contract (§2.1-2.2: toViewModel passes `meta.at` verbatim, webview `whoRow` takes optional `at`, PREPEND for user/APPEND for assistant) and data-model (§3.1-3.2: field-add only, new `.insrc-when` CSS) sections with no drift. Canonical artifact body.chosenAlternative=\"a1\" and body.alternativesConsidered[0..3] match the live document verbatim (names, approach text, pros/cons for a1 confirmed by direct read of both files). Cross-checked current render-registry.ts code: whoRow currently takes 3 params (role, glyph, label) with no `at`/time span and no .insrc-when class yet, consistent with this being a not-yet-built design (adding the 4th optional param and span is exactly what §2.2/§7.1 propose) — no contradiction with existing code.","findings":[],"inspectedReferences":["/body/alternativesConsidered","/body/chosenAlternative","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/alternativesConsidered/2","/body/alternativesConsidered/3","/Users/subhagho/work/projects/insors/insrc/docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-e4ce70ad1ae43d31-s1.json","/Users/subhagho/work/projects/insors/insrc/vscode-plugin/src/chat/render-registry.ts:100-220","/Users/subhagho/work/projects/insors/insrc/vscode-plugin/src/chat/render-registry.ts:395-445","/Users/subhagho/work/projects/insors/insrc/vscode-plugin/src/chat/chat-panel.ts:2370-2380"],"limitations":[],"advice":["a2 and a4 both carry 's3 rank 2' in the live LLD text (§7.2, §7.4) — a tie at the same rank for two rejected alternatives is plausible if they scored identically, but a one-line note on why they tied (or a tie-break note) would remove reader ambiguity; this is cosmetic and does not affect the chosen alternative's correctness."]},{"chunkId":"ux-visual","status":"changes_requested","summary":"The uxDefinition (AdaptiveCard body) and its rendered companion ux-mock.html do not actually depict the opposite-end row placement or the smaller/muted-font distinction that contracts/data-model (§3.2, lines 84-90) claims. Both roles are modeled as a Container holding two vertically-stacked TextBlocks, both weight='bolder', with no ColumnSet/row layout and no font-size differentiation — AdaptiveCard's default Container stacking cannot express 'opposite ends of one row,' and weight alone cannot express the claimed 10px-vs-11px size contrast. The generated HTML mock (line 96 of ux-mock.html) confirms this: it renders the timestamp and label as two plain stacked lines of identical class/styling inside a bordered box, not a row with the label at one end and the time at the other, and with no visible size/opacity difference between them. The companion file itself is present and renders without error, and a UX artifact is correctly warranted for this layout-visible change, but its content does not prove the design it is meant to validate.","findings":[{"id":"ux1-layout-not-row","severity":"HIGH","location":"LLD-e4ce70ad1ae43d31-s1.json#/body/uxDefinition/body (items 0 and 1); LLD.md section 8 (UX) via the linked uxDefinition","message":"The uxDefinition models each role's who-row as a Container with two TextBlocks stacked vertically (AdaptiveCard Container default layout), not a horizontal row/ColumnSet with the label and timestamp pinned to opposite ends. Section 3.2 of the same LLD (lines 84-90) specifies the timestamp span is PREPENDED on the user row (left end of a right-aligned row) and APPENDED with margin-left:auto on the assistant row (right end of a left-aligned row) — a horizontal, opposite-end relationship that a vertically-stacked Container/TextBlock pair cannot represent. The uxDefinition therefore does not accurately depict the layout claim it is supposed to visualize.","evidenceReferences":["LLD-e4ce70ad1ae43d31-s1.json#/body/uxDefinition/body/0 (Container, items: TextBlock '[ 04:18 ]', TextBlock 'you ❯', both weight='bolder')","LLD-e4ce70ad1ae43d31-s1.json#/body/uxDefinition/body/1 (Container, items: TextBlock '◆ claude', TextBlock '[ 04:18 ]', both weight='bolder')","LLD.md:84-90 (section 3.2, opposite-end placement rule: PREPENDED left-end for user, APPENDED margin-left:auto right-end for assistant)","docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/ux-mock.html:96 (rendered output: two stacked <p class=\"ux-text ux-bolder\"> lines per container, not a row)"]},{"id":"ux2-no-font-size-contrast","severity":"MED","location":"LLD-e4ce70ad1ae43d31-s1.json#/body/uxDefinition/body (items 0 and 1, all weight='bolder'); ux-mock.html:96,100","message":"Section 3.2 and the error-path table claim the new timestamp span is smaller and more muted than the who-label (.insrc-when{font-size:10px;opacity:.65} vs .insrc-who{font-size:11px}). In the uxDefinition every TextBlock representing either the timestamp or the label is given the identical weight='bolder' with no size/weight distinction, so the mock cannot and does not show the timestamp as visually smaller or dimmer than the label. The rendered companion confirms this: both the '[ 04:18 ]' and 'you ❯' / '◆ claude' TextBlocks render through the same generic .ux-text.ux-bolder CSS rule (ux-mock.html:70, font-weight:700 only — no font-size variance), so the two elements are visually indistinguishable in size/weight despite the design's own prose (element #7 in the Description table) asserting a 10px-vs-11px, opacity-.65 contrast.","evidenceReferences":["LLD-e4ce70ad1ae43d31-s1.json#/body/uxDefinition/body/0/items/0 (weight: 'bolder')","LLD-e4ce70ad1ae43d31-s1.json#/body/uxDefinition/body/0/items/1 (weight: 'bolder')","docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/ux-mock.html:70 (.ux-bolder{font-weight:700} is the only weight-driven rule; no .ux-size-small/medium class applied to either TextBlock)","docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/ux-mock.html:100 (Description table item #7 asserts the 10px/11px, opacity .65 contrast that the rendered elements #2/#3 and #5/#6 do not visually show)"]}],"inspectedReferences":["/body/uxDefinition","/body/companions","document:line:185","/Users/subhagho/work/projects/insors/insrc/docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/LLD.md","LLD-e4ce70ad1ae43d31-s1.json (body.uxDefinition, body.companions, full artifact)","docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/ux-mock.html (header/ref table lines 85-90, rendered View section line 93-98, Description table line 100, embedded CSS rules line 70)","vscode-plugin/src/chat/render-registry.ts:404-439 (current, pre-story whoRow/msgRow implementation, for contrast with the claimed post-story layout)"],"limitations":[],"advice":["The UX artifact is correctly warranted here (this is a visible layout change) — no over- or under-specification concern on that axis.","The companion file itself loads and parses without error; the defect is in what the uxDefinition encodes, not in file integrity.","Consider modeling each who-row as an AdaptiveCard ColumnSet with two Columns (one width:'auto' for the label+glyph, one width:'stretch' or a spacer) so the mock can actually show opposite-end horizontal placement, and give the timestamp TextBlock a smaller `size` (e.g. 'small') plus `isSubtle:true` so the rendered mock visually matches the claimed 10px/opacity-.65 contrast against the 11px label."]},{"chunkId":"citations-traceability","status":"passed","summary":"All 14 citations (c1-c14) were checked against the live files/doc. The code citations (c2, c4, c7, c8, c9) are byte-exact line-range matches; c3 is an exact match but is orphaned (never referenced by location in body prose, only listed in References); c5/c6 point to the right general area but their line ranges are imprecise (c6's 407-409 omits the whoRow function's own signature/closing lines; c5's 404-439 bundles unrelated comments/the whoRow function together with msgRow under a single \"called from msgRow\" label). c10-c12 (session-file-store.ts, render-registry.test.ts, transcript-pager.test.ts) exist as named. c13/c14 are step-output citations (internal workflow reasoning, no external artifact supplied to cross-check) and are used consistently with the body's alternatives-ranking content; c14's \"22/22 passed\" is a self-reported checklist claim that cannot be independently verified from the LLD body alone, but no contradicting evidence was found in this chunk's substantive-dependency review (contracts/data-model/error-handling/test-strategy/ux all checked clean elsewhere in this attempt). No HIGH/MED defects found in citation accuracy; only LOW-severity precision/orphan issues.","findings":[{"id":"cite-c3-orphan","severity":"LOW","location":"LLD.md References #9 [[c3]]; citations[2]","message":"c3 (render-registry.ts:61-68, the RowViewModel interface) is listed in the References section and is an accurate line range, but is never cited by that specific location anywhere in the body prose (contractDetails/dataModelChanges reference the RowViewModel type by name but never quote its 61-68 location). It is effectively an orphaned citation.","evidenceReferences":["docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/LLD.md:193","vscode-plugin/src/chat/render-registry.ts:61-68"]},{"id":"cite-c6-imprecise-range","severity":"LOW","location":"LLD.md §2.2 whoRow signature; citations[5] (c6)","message":"c6 cites render-registry.ts:407-409 as the whoRow function location, but the actual function (`function whoRow(role,glyph,label){...return w;}`) spans lines 406-411 in the live file; 407-409 captures only the middle of the function body, omitting its declaration line and its final `if/return` lines.","evidenceReferences":["vscode-plugin/src/chat/render-registry.ts:406","vscode-plugin/src/chat/render-registry.ts:411","docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/LLD.md:54"]},{"id":"cite-c5-bundled-range","severity":"LOW","location":"LLD.md §2.2 / §3.1 \"called from msgRow:404-439\"; citations[4] (c5)","message":"c5 (render-registry.ts:404-439) is labeled as the msgRow function's range, but the actual msgRow function body is lines 416-439; lines 404-415 are comments plus the whole whoRow function (406-411), so the citation bundles two distinct functions and intervening comments under one \"msgRow\" label rather than citing msgRow's own span.","evidenceReferences":["vscode-plugin/src/chat/render-registry.ts:404","vscode-plugin/src/chat/render-registry.ts:416","vscode-plugin/src/chat/render-registry.ts:439","docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/LLD.md:54"]}],"inspectedReferences":["/citations/0","/citations/1","/citations/2","/citations/3","/citations/4","/citations/5","/citations/6","/citations/7","/citations/8","/citations/9","/citations/10","/citations/11","/citations/12","/citations/13","/Users/subhagho/work/projects/insors/insrc/docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/LLD.md","vscode-plugin/src/chat/session-store.ts:31-103","vscode-plugin/src/chat/render-registry.ts:61-68","vscode-plugin/src/chat/render-registry.ts:116-194","vscode-plugin/src/chat/render-registry.ts:404-439","vscode-plugin/src/chat/render-registry.ts:406-411","vscode-plugin/src/chat/chat-panel.ts:2888-2889","vscode-plugin/src/chat/chat-panel.ts:3177-3178","vscode-plugin/src/chat/transcript-pager.ts:79","vscode-plugin/src/chat/session-file-store.ts","vscode-plugin/src/chat/__tests__/render-registry.test.ts","vscode-plugin/src/chat/__tests__/transcript-pager.test.ts"],"limitations":[],"advice":["Tighten c5/c6 to the whoRow function's exact span (406-411) and cite msgRow separately as 416-439, so a reader jumping to the cited lines lands exactly on the named function rather than an adjacent one.","Either drop c3 or cite its 61-68 location explicitly in the body (e.g. in contractDetails or dataModelChanges) where RowViewModel's shape is discussed, so it is not left as a References-only entry."]},{"chunkId":"final-consistency","status":"changes_requested","summary":"Synthesized all 8 completed chunks (scope-summary, contracts-data-model, error-handling, test-strategy, migration-rollout, alternatives, ux-visual, citations-traceability) against the live LLD.md and the checkpoint's recorded findings. The artifact's standalone scope framing, alternatives rationale, and citation accuracy are sound (only LOW-severity precision issues there). Two independent clusters of material gap recur across chunks and corroborate rather than contradict each other: (1) the design's contract/call-site scope (contracts-data-model f1-missing-webview-toviewmodel, HIGH) never names the webview's own duplicate `toViewModel` mirror (render-registry.ts:464-490) or the live-row posting paths, and error-handling (live-assistant-at-source-unsupported, MED) plus test-strategy (ts-live-at-gap, HIGH) independently confirm from different angles that NEITHER a live user row NOR a live assistant-delta row actually carries an `at` value under the design as written — only rows loaded via replay from a persisted session file get the timestamp. This is a genuine missing-requirement concern against the originating ask (\"show a human-readable timestamp in the dev-chat who-row\"), since live chatting is the dev-chat's primary mode, not just session replay. (2) ux-visual's two HIGH/MED findings (ux1-layout-not-row, ux2-no-font-size-contrast) show the uxDefinition/mock directly contradicts the opposite-end-row and smaller-font claims stated in the same artifact's §3.2 data-model-changes section — a cross-section (data-model vs UX) contradiction already captured there and not restated here. One additional cross-chunk inconsistency not previously stated by any single chunk: migration-rollout (passed, no findings) asserts \\\"the only non-trivial edits are toViewModel (:116-194) and the webview whoRow/msgRow source (:404-439) plus one CSS rule\\\" and concludes the single-commit-rollback story is realistic \\\"given the actual scope\\\" — but that scope assessment is now known (from contracts-data-model's f1 and test-strategy's ts-live-at-gap, both HIGH) to omit at least three additional edit sites the live-path fix would require (the webview's inline toViewModel mirror at :464-490, and the live posting sites at chat-panel.ts:2651-2663/:2677/:2898-2905). migration-rollout's \\\"passed\\\" conclusion about change-set size and rollback simplicity is therefore built on an incomplete picture of the design's true edit surface. No new independent functional defect is raised here beyond what f1/live-assistant-at-source-unsupported/ts-live-at-gap already establish; this finding is specifically about the migration section's own scope claim being stale relative to those HIGH findings. Citation and alternative-analysis rigor (alternatives, citations-traceability chunks) is sufficient and shows no further unresolved concerns beyond the LOW precision items already on record.","findings":[{"id":"migration-scope-omits-live-path-gap","severity":"MED","location":"LLD.md §6 Migration (Steps, Backward compat) vs §2/§3 contracts-data-model findings f1-missing-webview-toviewmodel and §5 test-strategy finding ts-live-at-gap","message":"The migration-rollout chunk assessed the change set as limited to the host toViewModel (render-registry.ts:116-194), the webview whoRow/msgRow source (render-registry.ts:404-439), and one CSS rule, and concluded on that basis that the single-commit rollback story is realistic 'given the actual scope.' That scope is now shown by two HIGH findings from sibling chunks to be incomplete: contracts-data-model's f1-missing-webview-toviewmodel establishes that the webview's own duplicate toViewModel mirror (render-registry.ts:464-490) is a required, uncited edit site, and test-strategy's ts-live-at-gap further shows the live (non-replay) rendering paths (chat-panel.ts:2651-2663, :2677, :2898-2905) also need threading work the LLD never names. Migration-rollout's 'passed' verdict and small-diff/single-commit framing therefore rest on a change-set size that is smaller than the design's own (incompletely specified) true scope, which is a cross-chunk inconsistency within the artifact's own self-description of its size and risk, not merely a repetition of the underlying functional gap already flagged elsewhere.","evidenceReferences":["docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/LLD.md:146-151 (Migration Steps and Backward compat, 'the only non-trivial edits are... plus one CSS rule')","checkpoint completedChunks[migration-rollout].summary ('the only non-trivial edits are toViewModel... and the webview whoRow/msgRow source... plus one CSS rule')","checkpoint completedChunks[contracts-data-model].findings[0] (f1-missing-webview-toviewmodel, HIGH)","checkpoint completedChunks[test-strategy].findings[0] (ts-live-at-gap, HIGH)"]}],"inspectedReferences":["/Users/subhagho/work/projects/insors/insrc/docs/standalone/show-human-readable-timestamp-dev-chat-E20261111e4ce70ad/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/review-e4ce70ad-s1-a1.json","checkpoint completedChunks[scope-summary]","checkpoint completedChunks[contracts-data-model]","checkpoint completedChunks[error-handling]","checkpoint completedChunks[test-strategy]","checkpoint completedChunks[migration-rollout]","checkpoint completedChunks[alternatives]","checkpoint completedChunks[ux-visual]","checkpoint completedChunks[citations-traceability]"],"limitations":[],"advice":["Treat the live-rendering gap as the primary blocker across the whole review: resolve f1-missing-webview-toviewmodel (contracts-data-model), live-assistant-at-source-unsupported (error-handling), and ts-live-at-gap (test-strategy) together in one revision pass — they are three facets of the same root cause (the design only threads `at` through the replay/host path, never the webview inline toViewModel mirror or the live posting sites), and fixing them together will also let migration-rollout re-assess the true change-set size and rollback story.","The ux-visual chunk's ux1-layout-not-row and ux2-no-font-size-contrast findings already capture the data-model-vs-UX-mock contradiction (opposite-end placement and 10px/11px size contrast asserted in §3.2 but not depicted in the uxDefinition/mock); no further action needed here beyond what that chunk already requested.","Once the live-path and UX-mock revisions land, re-run migration-rollout's assessment specifically, since its 'small, single-commit, low-risk' framing was based on the pre-revision (incomplete) edit-site list.","All LOW-severity citation/line-range precision issues (f2, f3, f4, f5, far-future-date detection gap aside, alignment-citation-imprecise, cite-c3-orphan, cite-c5-bundled-range, cite-c6-imprecise-range, ts-fixture-mischaracterized, triage-rationale-mismatch) are cosmetic and can be fixed in the same revision pass without a separate review round."]}],"progress":{"status":"changes_requested","phase":"complete","completedChunks":9,"totalChunks":9,"lastMeaningfulActivityAt":null,"activeToolCount":0,"requiresUserInput":false,"checkpointPath":"/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/review-e4ce70ad-s1-a1.json","sequence":0,"reviewElapsedMs":0,"unitElapsedMs":null,"observedAt":"2026-11-11T05:16:31.519Z","freshness":"stored"},"startedAt":"2026-11-11T04:43:03.817Z","reviewer":"daemon","model":"claude-sonnet-5","unit":{"unitId":"final-consistency","phase":"chunk_review","executionId":"e41e5924-a0ea-436e-845b-64c8baf9880d","dispatche