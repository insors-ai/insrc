ntIdentity":"1c6308670f6b233a7745a95d4540dd26c2cdb4cddd46601c51619c779ddc35b2","reviewedContent":{"canonical":"{\n  \"meta\": {\n    \"workflow\": \"design.story\",\n    \"runId\": \"wf-1794217613853-k6h5hg\",\n    \"repoPath\": \"/Users/subhagho/work/projects/insors/insrc\",\n    \"createdAt\": \"2026-11-09T09:54:01.096Z\",\n    \"epicCreatedAt\": \"2026-11-09T05:00:05.847Z\",\n    \"attribution\": {\n      \"outputs\": [\n        {\n          \"role\": \"(client)\",\n          \"tier\": \"core\",\n          \"runner\": \"cli-claude\",\n          \"model\": \"claude-opus-5-5\"\n        }\n      ]\n    },\n    \"elapsedMs\": 426970,\n    \"repoIndexedAt\": null,\n    \"schemaVersion\": 1,\n    \"epicHash\": \"eedc4519199b24b4\",\n    \"epicSlug\": \"make-delivery-board-read-common-artifact\",\n    \"storyId\": \"s1\",\n    \"hldBaseRunId\": \"wf-1794217613853-k6h5hg\",\n    \"hldEffectiveHash\": \"00e0073dac380d9934d7056b9495494e8eb2c3eda914684f72b9d0d8bcc6751c\",\n    \"hldAmendmentsApplied\": [],\n    \"storyTitle\": \"Make the delivery board read the common artifact model and migrate old records\",\n    \"standalone\": true,\n    \"sizeClass\": \"bugfix\",\n    \"authoredBy\": \"controller\",\n    \"revision\": 1\n  },\n  \"body\": {\n    \"summary\": {\n      \"audience\": \"product\",\n      \"prose\": \"Approving a build now really completes the Story, its Tasks and, when every Story is done, its Epic, which never happened before. A repair run brings existing records up to date at any schema version: it gives old records a lifecycle, creates missing Epic and Story records, and marks approved work complete. The delivery board then reads Epic, Story and Task status from those records, stops reporting them as unreadable, and shows any record still in the old format as needing migration.\"\n    },\n    \"hldContextSlice\": {\n      \"frameworkSummary\": \"Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\",\n      \"ownedContracts\": [],\n      \"consumedContracts\": [],\n      \"boundary\": {\n        \"storyId\": \"s1\",\n        \"owns\": [],\n        \"depends\": [],\n        \"internal\": \"Make the delivery board read the common artifact model and migrate old records\"\n      },\n      \"adjacentBoundaries\": [],\n      \"rolloutPhase\": \"standalone\",\n      \"nonFunctional\": {}\n    },\n    \"contractDetails\": {\n      \"surfaceLevel\": \"internal-shared\",\n      \"api\": [\n        {\n          \"name\": \"rollUp\",\n          \"signature\": \"rollUp(id: string, reader: ChildStatusReader, evidence: CompletionEvidence): Promise<Status | undefined>\",\n          \"parameters\": [\n            {\n              \"name\": \"id\",\n              \"type\": \"string\",\n              \"purpose\": \"The TASK, STORY or EPIC head to evaluate\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"reader\",\n              \"type\": \"ChildStatusReader\",\n              \"purpose\": \"Reads child listings and statuses\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"evidence\",\n              \"type\": \"CompletionEvidence\",\n              \"purpose\": \"Build approval and code review facts\",\n              \"optional\": false\n            }\n          ],\n          \"returns\": {\n            \"type\": \"Promise<Status | undefined>\",\n            \"meaning\": \"'completed' when the completion condition holds. A STORY: its BUILD is approved and its code review is clean or overridden. A TASK and an EPIC keep their existing rules.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"UnreadableChildError\",\n              \"condition\": \"A head of the counted child kind cannot be read\"\n            }\n          ],\n          \"preconditions\": [\n            \"id parses as an artifact id\"\n          ],\n          \"postconditions\": [\n            \"A STORY's condition no longer depends on its Tasks or on having any Tasks\",\n            \"Reads only\"\n          ]\n        },\n        {\n          \"name\": \"completeIfRolledUp\",\n          \"signature\": \"completeIfRolledUp(id: string, by: Actor, ctx?: EvidenceContext): Promise<{ completed: string[] }>\",\n          \"parameters\": [\n            {\n              \"name\": \"id\",\n              \"type\": \"string\",\n              \"purpose\": \"The unit to start the walk at\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"by\",\n              \"type\": \"Actor\",\n              \"purpose\": \"Who the entries are attributed to\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"ctx\",\n              \"type\": \"EvidenceContext\",\n              \"purpose\": \"The approval's override reason and signoff hold\",\n              \"optional\": true\n            }\n          ],\n          \"returns\": {\n            \"type\": \"Promise<{ completed: string[] }>\",\n            \"meaning\": \"The units completed by this call\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"LifecycleConflictError\",\n              \"condition\": \"A head and its change log disagree\"\n            }\n          ],\n          \"preconditions\": [\n            \"The STORY head exists; the caller creates a missing one first\"\n          ],\n          \"postconditions\": [\n            \"A completed STORY's open Tasks are completed through the existing cascade\",\n            \"An EPIC completes when all its counted Stories are completed\"\n          ]\n        },\n        {\n          \"name\": \"completeThroughService\",\n          \"signature\": \"completeThroughService(jsonPath: string): Promise<void>\",\n          \"parameters\": [\n            {\n              \"name\": \"jsonPath\",\n              \"type\": \"string\",\n              \"purpose\": \"The approved record's path\",\n              \"optional\": false\n            }\n          ],\n          \"returns\": {\n            \"type\": \"Promise<void>\",\n            \"meaning\": \"Nothing; the approval itself always stands\"\n          },\n          \"errors\": [],\n          \"preconditions\": [\n            \"The record was just approved\"\n          ],\n          \"postconditions\": [\n            \"For a BUILD, missing EPIC and STORY heads exist before the walk starts\"\n          ]\n        },\n        {\n          \"name\": \"handleRepoConvert\",\n          \"signature\": \"handleRepoConvert(params: unknown, repoEnv: string | undefined): Promise<ConversionReport | { error: string }>\",\n          \"parameters\": [\n            {\n              \"name\": \"params\",\n              \"type\": \"RepoConvertParams\",\n              \"purpose\": \"repo and mode; mode gains 'repair-preview' and 'repair'\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"repoEnv\",\n              \"type\": \"string | undefined\",\n              \"purpose\": \"Fallback repository path\",\n              \"optional\": false\n            }\n          ],\n          \"returns\": {\n            \"type\": \"Promise<ConversionReport | { error: string }>\",\n            \"meaning\": \"The plan, and for 'repair' the result. Valid at any schema version.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"{ error: string }\",\n              \"condition\": \"Unknown mode, or a repository that is not a directory\"\n            }\n          ],\n          \"preconditions\": [],\n          \"postconditions\": [\n            \"'repair-preview' writes nothing\",\n            \"'repair' run twice leaves the second run with no changes\",\n            \"The schema marker and the existing preview and apply modes are unchanged\"\n          ]\n        },\n        {\n          \"name\": \"liftStoreFile\",\n          \"signature\": \"liftStoreFile(fileName: string, parsed: unknown): ArtifactRecord | RecordLoadFailure\",\n          \"parameters\": [\n            {\n              \"name\": \"fileName\",\n              \"type\": \"string\",\n              \"purpose\": \"The store file name\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"parsed\",\n              \"type\": \"unknown\",\n              \"purpose\": \"The parsed file\",\n              \"optional\": false\n            }\n          ],\n          \"returns\": {\n            \"type\": \"ArtifactRecord | RecordLoadFailure\",\n            \"meaning\": \"A record for every kind of the common model; a head with no lifecycle has approval state 'unmigrated'\"\n          },\n          \"errors\": [],\n          \"preconditions\": [],\n          \"postconditions\": [\n            \"No legacy approval field is read\"\n          ]\n        },\n        {\n          \"name\": \"buildWorkItemGraph\",\n          \"signature\": \"buildWorkItemGraph(recordSet: ArtifactRecordSet): WorkItemGraph\",\n          \"parameters\": [\n            {\n              \"name\": \"recordSet\",\n              \"type\": \"ArtifactRecordSet\",\n              \"purpose\": \"The loaded records\",\n              \"optional\": false\n            }\n          ],\n          \"returns\": {\n            \"type\": \"WorkItemGraph\",\n            \"meaning\": \"Items carry the status of their EPIC, STORY or TASK head when one exists\"\n          },\n          \"errors\": [],\n          \"preconditions\": [],\n          \"postconditions\": [\n            \"Unit records are not counted as a work item's evidence\",\n            \"A task's title and order come from its TASK head when the Story has one\"\n          ]\n        }\n      ]\n    },\n    \"dataModelChanges\": [\n      {\n        \"entity\": \"CompletionEvidence\",\n        \"change\": \"field-add\",\n        \"details\": \"Adds storyBuildApproved(epicHash, storyId): Promise<boolean>, true when the Story's BUILD status is approved or later. The repair supplies this same interface with storyCodeReview answering overridden, because a BUILD approved in the past already passed the gate of its time.\",\n        \"callSites\": [\n          \"src/workflow/artifact-core/lifecycle.ts:336\",\n          \"src/workflow/artifact-core/completion-evidence.ts:48\"\n        ]\n      },\n      {\n        \"entity\": \"DeliveryArtifactKind\",\n        \"change\": \"field-modify\",\n        \"details\": \"Adds EPIC, STORY, TASK and TASKS. Relationship: one EPIC head has many STORY heads (by epicHash); one STORY has zero or one TASKS head and zero or more TASK heads (by epicHash and storyId). A work item references at most one unit head of its own level, in the direction item to head. Existing kinds are unchanged, and TESTS stays skipped by name.\",\n        \"callSites\": [\n          \"src/workflow/delivery/types.ts\",\n          \"src/workflow/delivery/load.ts\",\n          \"src/workflow/delivery/graph.ts\"\n        ]\n      },\n      {\n        \"entity\": \"ApprovalState\",\n        \"change\": \"field-modify\",\n        \"details\": \"Adds 'unmigrated' for a head with no lifecycle. Additive for the plugin, which gains a display label.\",\n        \"callSites\": [\n          \"src/workflow/delivery/load.ts\",\n          \"src/workflow/delivery/gate.ts\",\n          \"vscode-plugin/src/delivery/delivery-contract.ts\"\n        ]\n      },\n      {\n        \"entity\": \"NoticeCode and AttentionReason\",\n        \"change\": \"field-modify\",\n        \"details\": \"Adds notice 'needs-migration', raised for an unmigrated record or a story with no STORY head, and attention reason 'needs-migration', so such a record is never counted as pending-decision.\",\n        \"callSites\": [\n          \"src/workflow/delivery/types.ts\",\n          \"src/workflow/delivery/gate.ts\",\n          \"vscode-plugin/src/delivery/delivery-contract.ts\"\n        ]\n      }\n    ],\n    \"interactionWithShared\": [],\n    \"errorPaths\": {\n      \"errorCases\": [\n        {\n          \"scenario\": \"The completion walk fails after a BUILD was approved\",\n          \"detection\": \"completeThroughService catches the rejection from completeIfRolledUp, for example a LifecycleConflictError\",\n          \"response\": \"The approval stands, the failure is logged and returned with the approval result, and a repair run or the next approval retries the walk\",\n          \"userImpact\": \"The build shows approved but its Story is not yet complete\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"A missing STORY or EPIC head cannot be created during approval\",\n          \"detection\": \"The store write rejects while the heads are being ensured\",\n          \"response\": \"The walk is skipped for that Story, the approval stands, and the failure is logged\",\n          \"userImpact\": \"The Story stays not complete until a repair run\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"A head is unreadable during repair\",\n          \"detection\": \"readRawHeads reports it as a problem\",\n          \"response\": \"That head is listed in the plan's problems and skipped; the other records are still repaired\",\n          \"userImpact\": \"The record stays out of the model and is listed for the operator\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"A head and its change log disagree during settling\",\n          \"detection\": \"LifecycleConflictError from the lifecycle service\",\n          \"response\": \"That unit is reported as a problem and left unchanged, and the run continues\",\n          \"userImpact\": \"That unit stays unsettled and is named in the report\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"The repair stops part-way\",\n          \"detection\": \"The process ends before the run returns\",\n          \"response\": \"A later run finds each remaining change by what the records lack and finishes it\",\n          \"userImpact\": \"None once the repair is run again\",\n          \"recoverable\": true\n        }\n      ],\n      \"edgeCases\": [\n        {\n          \"input\": \"A Story with no Plan and no Tasks whose BUILD is approved with a clean review\",\n          \"expected\": \"The Story completes; there are no Tasks to cascade to\"\n        },\n        {\n          \"input\": \"A Story whose latest Task round failed but whose BUILD a person approved with an override\",\n          \"expected\": \"The Story completes with the override recorded, and the Task is completed through the cascade\"\n        },\n        {\n          \"input\": \"A BUILD approved long ago with no code review record, during repair\",\n          \"expected\": \"The Story completes, attributed to insrc:migration, with the entry saying it was settled from the approved BUILD\"\n        },\n        {\n          \"input\": \"A BUILD still pending, during repair\",\n          \"expected\": \"The Story is left open and keeps its status\"\n        },\n        {\n          \"input\": \"A unit whose signoff policy still holds completion\",\n          \"expected\": \"It stays approved or draft and the walk stops there, as it does today\"\n        },\n        {\n          \"input\": \"An Epic with some Stories complete and some not\",\n          \"expected\": \"The Epic stays open and each Story shows its own status\"\n        },\n        {\n          \"input\": \"A withdrawn or superseded Task under a completed Story\",\n          \"expected\": \"It keeps its status and does not count\"\n        },\n        {\n          \"input\": \"A standalone Story with a store id written S001\",\n          \"expected\": \"Its unit heads use the lower-case form s1, and the records resolve to one work item\"\n        },\n        {\n          \"input\": \"A repair run on a repository with nothing to change\",\n          \"expected\": \"No file is written, and the report lists no changes\"\n        },\n        {\n          \"input\": \"A Story reopened after completion\",\n          \"expected\": \"Repair does not complete it again until its BUILD is approved again\"\n        }\n      ],\n      \"invariantsToPreserve\": [\n        {\n          \"text\": \"An approval always stands, whatever happens in the completion walk that follows it.\",\n          \"source\": \"c1\"\n        },\n        {\n          \"text\": \"A unit the signoff policy holds is not completed.\",\n          \"source\": \"c1\"\n        },\n        {\n          \"text\": \"The schema marker and the existing preview and apply modes of repo.convert keep their behaviour.\",\n          \"source\": \"c2\"\n        },\n        {\n          \"text\": \"conversion verification keeps reading the same loader and graph and reports no new differences.\",\n          \"source\": \"c3\"\n        },\n        {\n          \"text\": \"The delivery board reads only the lifecycle for approval and never a legacy approval field.\",\n          \"source\": \"c3\"\n        },\n        {\n          \"text\": \"Epic-level and Story-level records written by other parts of the system keep their ids and identity rules.\",\n          \"source\": \"c3\"\n        }\n      ]\n    },\n    \"testStrategy\": {\n      \"testFramework\": \"node:test with node:assert/strict, run through tsx\",\n      \"testLevels\": [\n        {\n          \"level\": \"unit\",\n          \"purpose\": \"The roll-up rule and the board's reading of the unit records\",\n          \"subjects\": [\n            \"rollUp: a STORY completes on an approved BUILD with a clean or overridden review, with or without Tasks\",\n            \"rollUp: a STORY stays open when the BUILD is pending or the review is blocked or missing\",\n            \"liftStoreFile: EPIC, STORY, TASK and TASKS records lift without a failure\",\n            \"liftStoreFile: a head with no lifecycle has approval state unmigrated\",\n            \"buildWorkItemGraph: items carry their unit's status, and unit records are not counted as evidence\",\n            \"gate: an unmigrated record raises needs-migration and never pending-decision\"\n          ],\n          \"fixturesNeeded\": [\n            \"In-memory records built with src/workflow/__tests__/lifecycle-fixtures.ts\"\n          ]\n        },\n        {\n          \"level\": \"integration\",\n          \"purpose\": \"Approval and repair against a real temporary artifact store\",\n          \"subjects\": [\n            \"approving a BUILD completes the Story, its open Tasks and, when all Stories are done, the Epic\",\n            \"approving a BUILD creates a missing STORY and EPIC head first\",\n            \"a failed completion walk leaves the approval standing\",\n            \"a held signoff keeps the unit open\",\n            \"repair preview writes nothing\",\n            \"repair at schema version 2 migrates heads with no lifecycle, keeping approved records approved\",\n            \"repair creates missing EPIC, STORY and TASKS records for standalone work\",\n            \"repair completes units from approved BUILD records and leaves pending ones open\",\n            \"a second repair run changes nothing\",\n            \"a repair stopped part-way finishes when run again\",\n            \"repo.convert preview and apply keep their behaviour at schema version 2\",\n            \"conversion verification reports no new differences\"\n          ],\n          \"fixturesNeeded\": [\n            \"A temporary repository with a store of old-format and common-format records\"\n          ]\n        },\n        {\n          \"level\": \"contract\",\n          \"purpose\": \"The snapshot stays aligned with the VS Code plugin\",\n          \"subjects\": [\n            \"the daemon delivery handler returns the new notice and attention values\",\n            \"the plugin's delivery contract type-checks and labels every new value\"\n          ]\n        },\n        {\n          \"level\": \"live\",\n          \"purpose\": \"The real repository after a repair\",\n          \"subjects\": [\n            \"workflow.delivery on this repository reports no unreadable new-format records, no unmigrated records, and approved work as complete\"\n          ]\n        }\n      ],\n      \"acceptanceMapping\": [\n        {\n          \"criterionId\": \"ac1\",\n          \"provingTests\": [\n            \"approving a BUILD completes the Story, its open Tasks and, when all Stories are done, the Epic\",\n            \"rollUp: a STORY completes on an approved BUILD with a clean or overridden review, with or without Tasks\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac2\",\n          \"provingTests\": [\n            \"liftStoreFile: EPIC, STORY, TASK and TASKS records lift without a failure\",\n            \"buildWorkItemGraph: items carry their unit's status, and unit records are not counted as evidence\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac3\",\n          \"provingTests\": [\n            \"repair at schema version 2 migrates heads with no lifecycle, keeping approved records approved\",\n            \"repair creates missing EPIC, STORY and TASKS records for standalone work\",\n            \"repair completes units from approved BUILD records and leaves pending ones open\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac4\",\n          \"provingTests\": [\n            \"repair preview writes nothing\",\n            \"a second repair run changes nothing\",\n            \"a repair stopped part-way finishes when run again\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac5\",\n          \"provingTests\": [\n            \"gate: an unmigrated record raises needs-migration and never pending-decision\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac6\",\n          \"provingTests\": [\n            \"the plugin's delivery contract type-checks and labels every new value\",\n            \"conversion verification reports no new differences\",\n            \"repo.convert preview and apply keep their behaviour at schema version 2\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac7\",\n          \"provingTests\": [\n            \"workflow.delivery on this repository reports no unreadable new-format records, no unmigrated records, and approved work as complete\"\n          ]\n        }\n      ]\n    },\n    \"migration\": {\n      \"stateBefore\": \"The board rejects EPIC, STORY, TASK and TASKS records as unknown kinds and derives stories and tasks from DEF, PLAN and BUILD records. On this repository 273 records have no lifecycle, every EPIC and STORY is draft, no Task is completed, and 252 approved builds have no STORY record. Conversion does nothing once the marker is at version 2. The records without a lifecycle were written by the installed daemon, which ran commit 5c5bc0cf1 from main, with no lifecycle code, until it moved to v2 on 2026-11-07; none has been created since.\",\n      \"stateAfter\": \"A BUILD approval completes its Story, open Tasks and, when all Stories are done, its Epic. Every record has a lifecycle, every approved build has its STORY and EPIC records, and approved work is marked completed. The board reads epic, story and task status from those records and shows no unknown-kind failures. Any record still without a lifecycle appears as needing migration.\",\n      \"migrationSteps\": [\n        {\n          \"order\": 1,\n          \"action\": \"Ship the changed roll-up rule, the approval-time creation of missing units and the repair mode together with the board change, and update the daemon and the plugin.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 2,\n          \"action\": \"Run repo.convert with mode repair-preview on the repository and read the listed changes and problems.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 3,\n          \"action\": \"Commit or set aside other work under the artifact store so that the repair's changes form their own commit.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 4,\n          \"action\": \"Run repo.convert with mode repair: give records a lifecycle, create missing EPIC, STORY and TASKS records, then complete units whose BUILD is approved.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 5,\n          \"action\": \"Run the repair again to confirm it reports no changes, and check workflow.delivery shows no unknown-kind or needs-migration notices.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 6,\n          \"action\": \"Commit the repaired records.\",\n          \"rollbackable\": true\n        }\n      ],\n      \"backwardCompat\": \"The repo.convert preview and apply modes and the schema marker are unchanged. The snapshot adds one approval state, one notice code and one attention reason, so an older plugin may show an unlabelled value until it is updated; it keeps working otherwise. Until the repair runs, an updated board shows the old records as needing migration, and shows Stories as not complete, so the repair should run straight after the update. Rollback of the records is by reverting the repair's commit, since heads and logs both live under the artifact store. Other repositories are unaffected until repaired.\",\n      \"zeroDowntime\": true,\n      \"dataRewriteRequired\": true\n    },\n    \"alternativesConsidered\": [\n      {\n        \"id\": \"a1\",\n        \"name\": \"BUILD approval is the completion act\",\n        \"oneLineSummary\": \"A Story completes when its current BUILD is approved with a clean or overridden code review, and completing it completes its open Tasks; the same rule settles existing records.\",\n        \"approach\": \"Change the Story roll-up so its condition is an approved BUILD plus a clean or overridden code review, instead of every Task already being completed. Completing the Story cascades to its open Tasks. BUILD approval creates a missing STORY or EPIC head before the walk. A repair mode of repo.convert, valid at any schema version, migrates records without a lifecycle, creates missing units and settles status by the same rule. The board loads the four record kinds and takes epic, story and task status from them.\",\n        \"pros\": [\n          \"Matches the documented rule that BUILD approval is the code-review-gated completion act\",\n          \"One rule covers planned Stories, Stories with no Plan, an approval with an override, and old Tasks with no build round\",\n          \"Reuses the existing cascade, completeIfRolledUp, migrateHeads and repo.convert\"\n        ],\n        \"cons\": [\n          \"Changes the roll-up rule, so a failed latest build round no longer holds back a Story whose BUILD a person approved\",\n          \"Touches the lifecycle, the conversion and the board in one Story\"\n        ],\n        \"costEstimate\": \"L\"\n      },\n      {\n        \"id\": \"a2\",\n        \"name\": \"Walk up from each Task, strict rule kept\",\n        \"oneLineSummary\": \"Keep the roll-up rule; on BUILD approval complete each Task whose latest build round passed, then walk up, with a separate rule for a Story with no Tasks.\",\n        \"approach\": \"Start the completion walk at every Task of the Story so each passing Task completes, and let the Story roll up as written. Add a special case for a Story with no Tasks. The repair mode applies the same walk to existing records. The board change is the same as a1.\",\n        \"pros\": [\n          \"Keeps the rule that every Task passed its own build\",\n          \"Smallest change to the lifecycle code\"\n        ],\n        \"cons\": [\n          \"A Story approved with an override over a failed Task never completes\",\n          \"816 Tasks have no build round, so most old Stories could never complete and would need a second historical rule\",\n          \"Needs a separate rule for Stories with no Tasks\"\n        ],\n        \"costEstimate\": \"M\",\n        \"reasonRejected\": \"Partial on status-from-lifecycles and covers-all-routes: 816 Tasks have no build round, and a Story approved with an override over a failed Task would never complete.\"\n      },\n      {\n        \"id\": \"a3\",\n        \"name\": \"Settle by migration only\",\n        \"oneLineSummary\": \"Leave live completion as it is and have a repeatable migration compute unit status from approved records.\",\n        \"approach\": \"Keep the current walk unchanged. Run the repair on demand or at daemon start to set epic, story and task status from approved BUILD records and code reviews. The board reads the unit statuses it finds.\",\n        \"pros\": [\n          \"Does not touch the approval path\"\n        ],\n        \"cons\": [\n          \"Status is stale between runs, so the board would wrong-foot users after every approval\",\n          \"Leaves the defect that completion never fires in place\"\n        ],\n        \"costEstimate\": \"M\",\n        \"reasonRejected\": \"Violates status-from-lifecycles: status is stale between runs, and the defect that completion never fires stays in place.\"\n      }\n    ],\n    \"chosenAlternative\": \"a1\",\n    \"openQuestions\": []\n  },\n  \"citations\": [\n    {\n      \"id\": \"c1\",\n      \"kind\": \"code\",\n      \"ref\": \"src/workflow/gates.ts:959\"\n    },\n    {\n      \"id\": \"c2\",\n      \"kind\": \"code\",\n      \"ref\": \"src/workflow/convert/plan.ts:121\"\n    },\n    {\n      \"id\": \"c3\",\n      \"kind\": \"code\",\n      \"ref\": \"src/workflow/delivery/load.ts:58\"\n    },\n    {\n      \"id\": \"c4\",\n      \"kind\": \"code\",\n      \"ref\": \"src/workflow/artifact-core/lifecycle.ts:336\"\n    },\n    {\n      \"id\": \"c5\",\n      \"kind\": \"code\",\n      \"ref\": \"src/workflow/convert/repair-amendments.ts:29\"\n    },\n    {\n      \"id\": \"c6\",\n      \"kind\": \"prior-artifact\",\n      \"ref\": \"docs/standalone/make-delivery-board-read-common-artifact-E20261109eedc4519/ISSUE.md\"\n    },\n    {\n      \"id\": \"c7\",\n      \"kind\": \"stakeholder\",\n      \"ref\": \"User decision on 2026-11-09 to make the unit statuses real and have the board read them\"\n    }\n  ]\n}\n","document":"<!-- insrc:artifact LLD-eedc4519199b24b4-s1 -->\n\n# LLD: STORY-eedc4519199b24b4-s1 — Make the delivery board read the common artifact model and migrate old records\n\n## Summary\n\n**Epic:** `make-delivery-board-read-common-artifact`\n**HLD base run:** `wf-1794217613853-k6h5hg`\n**HLD effective hash:** `00e0073dac38...`\n\nApproving a build now really completes the Story, its Tasks and, when every Story is done, its Epic, which never happened before. A repair run brings existing records up to date at any schema version: it gives old records a lifecycle, creates missing Epic and Story records, and marks approved work complete. The delivery board then reads Epic, Story and Task status from those records, stops reporting them as unreadable, and shows any record still in the old format as needing migration.\n\n## Contents\n\n1. [HLD context](#1-hld-context)\n2. [Contract details](#2-contract-details)\n3. [Data model changes](#3-data-model-changes)\n4. [Error paths](#4-error-paths)\n5. [Test strategy](#5-test-strategy)\n6. [Migration](#6-migration)\n7. [Alternatives considered](#7-alternatives-considered)\n8. [References](#8-references)\n\n## 1. HLD context\n\n**Framework:** Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\n**Rollout phase:** standalone\n\n## 2. Contract details\n\n**Surface level:** internal-shared\n\n### 2.1 `rollUp`\n\n```typescript\nrollUp(id: string, reader: ChildStatusReader, evidence: CompletionEvidence): Promise<Status | undefined>\n```\n\n**Parameters:**\n- `id: string` — The TASK, STORY or EPIC head to evaluate\n- `reader: ChildStatusReader` — Reads child listings and statuses\n- `evidence: CompletionEvidence` — Build approval and code review facts\n\n**Returns:** `Promise<Status | undefined>` — 'completed' when the completion condition holds. A STORY: its BUILD is approved and its code review is clean or overridden. A TASK and an EPIC keep their existing rules.\n\n**Errors:**\n- `UnreadableChildError` when A head of the counted child kind cannot be read\n\n**Preconditions:**\n- id parses as an artifact id\n\n**Postconditions:**\n- A STORY's condition no longer depends on its Tasks or on having any Tasks\n- Reads only\n\n### 2.2 `completeIfRolledUp`\n\n```typescript\ncompleteIfRolledUp(id: string, by: Actor, ctx?: EvidenceContext): Promise<{ completed: string[] }>\n```\n\n**Parameters:**\n- `id: string` — The unit to start the walk at\n- `by: Actor` — Who the entries are attributed to\n- `ctx: EvidenceContext` _(optional)_ — The approval's override reason and signoff hold\n\n**Returns:** `Promise<{ completed: string[] }>` — The units completed by this call\n\n**Errors:**\n- `LifecycleConflictError` when A head and its change log disagree\n\n**Preconditions:**\n- The STORY head exists; the caller creates a missing one first\n\n**Postconditions:**\n- A completed STORY's open Tasks are completed through the existing cascade\n- An EPIC completes when all its counted Stories are completed\n\n### 2.3 `completeThroughService`\n\n```typescript\ncompleteThroughService(jsonPath: string): Promise<void>\n```\n\n**Parameters:**\n- `jsonPath: string` — The approved record's path\n\n**Returns:** `Promise<void>` — Nothing; the approval itself always stands\n\n**Preconditions:**\n- The record was just approved\n\n**Postconditions:**\n- For a BUILD, missing EPIC and STORY heads exist before the walk starts\n\n### 2.4 `handleRepoConvert`\n\n```typescript\nhandleRepoConvert(params: unknown, repoEnv: string | undefined): Promise<ConversionReport | { error: string }>\n```\n\n**Parameters:**\n- `params: RepoConvertParams` — repo and mode; mode gains 'repair-preview' and 'repair'\n- `repoEnv: string | undefined` — Fallback repository path\n\n**Returns:** `Promise<ConversionReport | { error: string }>` — The plan, and for 'repair' the result. Valid at any schema version.\n\n**Errors:**\n- `{ error: string }` when Unknown mode, or a repository that is not a directory\n\n**Postconditions:**\n- 'repair-preview' writes nothing\n- 'repair' run twice leaves the second run with no changes\n- The schema marker and the existing preview and apply modes are unchanged\n\n### 2.5 `liftStoreFile`\n\n```typescript\nliftStoreFile(fileName: string, parsed: unknown): ArtifactRecord | RecordLoadFailure\n```\n\n**Parameters:**\n- `fileName: string` — The store file name\n- `parsed: unknown` — The parsed file\n\n**Returns:** `ArtifactRecord | RecordLoadFailure` — A record for every kind of the common model; a head with no lifecycle has approval state 'unmigrated'\n\n**Postconditions:**\n- No legacy approval field is read\n\n### 2.6 `buildWorkItemGraph`\n\n```typescript\nbuildWorkItemGraph(recordSet: ArtifactRecordSet): WorkItemGraph\n```\n\n**Parameters:**\n- `recordSet: ArtifactRecordSet` — The loaded records\n\n**Returns:** `WorkItemGraph` — Items carry the status of their EPIC, STORY or TASK head when one exists\n\n**Postconditions:**\n- Unit records are not counted as a work item's evidence\n- A task's title and order come from its TASK head when the Story has one\n\n## 3. Data model changes\n\n### 3.1 `CompletionEvidence` — field-add\n\nAdds storyBuildApproved(epicHash, storyId): Promise<boolean>, true when the Story's BUILD status is approved or later. The repair supplies this same interface with storyCodeReview answering overridden, because a BUILD approved in the past already passed the gate of its time.\n\n**Call sites:**\n- `src/workflow/artifact-core/lifecycle.ts:336`\n- `src/workflow/artifact-core/completion-evidence.ts:48`\n\n### 3.2 `DeliveryArtifactKind` — field-modify\n\nAdds EPIC, STORY, TASK and TASKS. Relationship: one EPIC head has many STORY heads (by epicHash); one STORY has zero or one TASKS head and zero or more TASK heads (by epicHash and storyId). A work item references at most one unit head of its own level, in the direction item to head. Existing kinds are unchanged, and TESTS stays skipped by name.\n\n**Call sites:**\n- `src/workflow/delivery/types.ts`\n- `src/workflow/delivery/load.ts`\n- `src/workflow/delivery/graph.ts`\n\n### 3.3 `ApprovalState` — field-modify\n\nAdds 'unmigrated' for a head with no lifecycle. Additive for the plugin, which gains a display label.\n\n**Call sites:**\n- `src/workflow/delivery/load.ts`\n- `src/workflow/delivery/gate.ts`\n- `vscode-plugin/src/delivery/delivery-contract.ts`\n\n### 3.4 `NoticeCode and AttentionReason` — field-modify\n\nAdds notice 'needs-migration', raised for an unmigrated record or a story with no STORY head, and attention reason 'needs-migration', so such a record is never counted as pending-decision.\n\n**Call sites:**\n- `src/workflow/delivery/types.ts`\n- `src/workflow/delivery/gate.ts`\n- `vscode-plugin/src/delivery/delivery-contract.ts`\n\n## 4. Error paths\n\n**Error cases**\n\n- **The completion walk fails after a BUILD was approved** (recoverable)\n  - Detection: completeThroughService catches the rejection from completeIfRolledUp, for example a LifecycleConflictError\n  - Response: The approval stands, the failure is logged and returned with the approval result, and a repair run or the next approval retries the walk\n  - User impact: The build shows approved but its Story is not yet complete\n- **A missing STORY or EPIC head cannot be created during approval** (recoverable)\n  - Detection: The store write rejects while the heads are being ensured\n  - Response: The walk is skipped for that Story, the approval stands, and the failure is logged\n  - User impact: The Story stays not complete until a repair run\n- **A head is unreadable during repair** (recoverable)\n  - Detection: readRawHeads reports it as a problem\n  - Response: That head is listed in the plan's problems and skipped; the other records are still repaired\n  - User impact: The record stays out of the model and is listed for the operator\n- **A head and its change log disagree during settling** (recoverable)\n  - Detection: LifecycleConflictError from the lifecycle service\n  - Response: That unit is reported as a problem and left unchanged, and the run continues\n  - User impact: That unit stays unsettled and is named in the report\n- **The repair stops part-way** (recoverable)\n  - Detection: The process ends before the run returns\n  - Response: A later run finds each remaining change by what the records lack and finishes it\n  - User impact: None once the repair is run again\n\n**Edge cases**\n\n| Input | Expected |\n| :--- | :--- |\n| A Story with no Plan and no Tasks whose BUILD is approved with a clean review | The Story completes; there are no Tasks to cascade to |\n| A Story whose latest Task round failed but whose BUILD a person approved with an override | The Story completes with the override recorded, and the Task is completed through the cascade |\n| A BUILD approved long ago with no code review record, during repair | The Story completes, attributed to insrc:migration, with the entry saying it was settled from the approved BUILD |\n| A BUILD still pending, during repair | The Story is left open and keeps its status |\n| A unit whose signoff policy still holds completion | It stays approved or draft and the walk stops there, as it does today |\n| An Epic with some Stories complete and some not | The Epic stays open and each Story shows its own status |\n| A withdrawn or superseded Task under a completed Story | It keeps its status and does not count |\n| A standalone Story with a store id written S001 | Its unit heads use the lower-case form s1, and the records resolve to one work item |\n| A repair run on a repository with nothing to change | No file is written, and the report lists no changes |\n| A Story reopened after completion | Repair does not complete it again until its BUILD is approved again |\n\n**Invariants to preserve**\n\n- An approval always stands, whatever happens in the completion walk that follows it. [[c1]]\n- A unit the signoff policy holds is not completed. [[c1]]\n- The schema marker and the existing preview and apply modes of repo.convert keep their behaviour. [[c2]]\n- conversion verification keeps reading the same loader and graph and reports no new differences. [[c3]]\n- The delivery board reads only the lifecycle for approval and never a legacy approval field. [[c3]]\n- Epic-level and Story-level records written by other parts of the system keep their ids and identity rules. [[c3]]\n\n## 5. Test strategy\n\n**Test framework:** `node:test with node:assert/strict, run through tsx`\n\n**Test levels**\n\n- **unit** — The roll-up rule and the board's reading of the unit records\n  - Subjects: `rollUp: a STORY completes on an approved BUILD with a clean or overridden review, with or without Tasks`, `rollUp: a STORY stays open when the BUILD is pending or the review is blocked or missing`, `liftStoreFile: EPIC, STORY, TASK and TASKS records lift without a failure`, `liftStoreFile: a head with no lifecycle has approval state unmigrated`, `buildWorkItemGraph: items carry their unit's status, and unit records are not counted as evidence`, `gate: an unmigrated record raises needs-migration and never pending-decision`\n  - Fixtures: `In-memory records built with src/workflow/__tests__/lifecycle-fixtures.ts`\n- **integration** — Approval and repair against a real temporary artifact store\n  - Subjects: `approving a BUILD completes the Story, its open Tasks and, when all Stories are done, the Epic`, `approving a BUILD creates a missing STORY and EPIC head first`, `a failed completion walk leaves the approval standing`, `a held signoff keeps the unit open`, `repair preview writes nothing`, `repair at schema version 2 migrates heads with no lifecycle, keeping approved records approved`, `repair creates missing EPIC, STORY and TASKS records for standalone work`, `repair completes units from approved BUILD records and leaves pending ones open`, `a second repair run changes nothing`, `a repair stopped part-way finishes when run again`, `repo.convert preview and apply keep their behaviour at schema version 2`, `conversion verification reports no new differences`\n  - Fixtures: `A temporary repository with a store of old-format and common-format records`\n- **contract** — The snapshot stays aligned with the VS Code plugin\n  - Subjects: `the daemon delivery handler returns the new notice and attention values`, `the plugin's delivery contract type-checks and labels every new value`\n- **live** — The real repository after a repair\n  - Subjects: `workflow.delivery on this repository reports no unreadable new-format records, no unmigrated records, and approved work as complete`\n\n**Acceptance mapping**\n\n| Criterion | Proving tests |\n| :--- | :--- |\n| `ac1` | `approving a BUILD completes the Story, its open Tasks and, when all Stories are done, the Epic`, `rollUp: a STORY completes on an approved BUILD with a clean or overridden review, with or without Tasks` |\n| `ac2` | `liftStoreFile: EPIC, STORY, TASK and TASKS records lift without a failure`, `buildWorkItemGraph: items carry their unit's status, and unit records are not counted as evidence` |\n| `ac3` | `repair at schema version 2 migrates heads with no lifecycle, keeping approved records approved`, `repair creates missing EPIC, STORY and TASKS records for standalone work`, `repair completes units from approved BUILD records and leaves pending ones open` |\n| `ac4` | `repair preview writes nothing`, `a second repair run changes nothing`, `a repair stopped part-way finishes when run again` |\n| `ac5` | `gate: an unmigrated record raises needs-migration and never pending-decision` |\n| `ac6` | `the plugin's delivery contract type-checks and labels every new value`, `conversion verification reports no new differences`, `repo.convert preview and apply keep their behaviour at schema version 2` |\n| `ac7` | `workflow.delivery on this repository reports no unreadable new-format records, no unmigrated records, and approved work as complete` |\n\n## 6. Migration\n\n**State before:** The board rejects EPIC, STORY, TASK and TASKS records as unknown kinds and derives stories and tasks from DEF, PLAN and BUILD records. On this repository 273 records have no lifecycle, every EPIC and STORY is draft, no Task is completed, and 252 approved builds have no STORY record. Conversion does nothing once the marker is at version 2. The records without a lifecycle were written by the installed daemon, which ran commit 5c5bc0cf1 from main, with no lifecycle code, until it moved to v2 on 2026-11-07; none has been created since.\n\n**State after:** A BUILD approval completes its Story, open Tasks and, when all Stories are done, its Epic. Every record has a lifecycle, every approved build has its STORY and EPIC records, and approved work is marked completed. The board reads epic, story and task status from those records and shows no unknown-kind failures. Any record still without a lifecycle appears as needing migration.\n\n**Zero downtime:** yes — **Data rewrite:** yes\n\n**Steps**\n\n1. Ship the changed roll-up rule, the approval-time creation of missing units and the repair mode together with the board change, and update the daemon and the plugin. — ↩ rollbackable\n2. Run repo.convert with mode repair-preview on the repository and read the listed changes and problems. — ↩ rollbackable\n3. Commit or set aside other work under the artifact store so that the repair's changes form their own commit. — ↩ rollbackable\n4. Run repo.convert with mode repair: give records a lifecycle, create missing EPIC, STORY and TASKS records, then complete units whose BUILD is approved. — ↩ rollbackable\n5. Run the repair again to confirm it reports no changes, and check workflow.delivery shows no unknown-kind or needs-migration notices. — ↩ rollbackable\n6. Commit the repaired records. — ↩ rollbackable\n\n**Backward compat:** The repo.convert preview and apply modes and the schema marker are unchanged. The snapshot adds one approval state, one notice code and one attention reason, so an older plugin may show an unlabelled value until it is updated; it keeps working otherwise. Until the repair runs, an updated board shows the old records as needing migration, and shows Stories as not complete, so the repair should run straight after the update. Rollback of the records is by reverting the repair's commit, since heads and logs both live under the artifact store. Other repositories are unaffected until repaired.\n\n## 7. Alternatives considered\n\n### 7.1 a1: BUILD approval is the completion act — **CHOSEN**\n\nA Story completes when its current BUILD is approved with a clean or overridden code review, and completing it completes its open Tasks; the same rule settles existing records.\n\nChange the Story roll-up so its condition is an approved BUILD plus a clean or overridden code review, instead of every Task already being completed. Completing the Story cascades to its open Tasks. BUILD approval creates a missing STORY or EPIC head before the walk. A repair mode of repo.convert, valid at any schema version, migrates records without a lifecycle, creates missing units and settles status by the same rule. The board loads the four record kinds and takes epic, story and task status from them.\n\n### 7.2 a2: Walk up from each Task, strict rule kept\n\nKeep the roll-up rule; on BUILD approval complete each Task whose latest build round passed, then walk up, with a separate rule for a Story with no Tasks.\n\nStart the completion walk at every Task of the Story so each passing Task completes, and let the Story roll up as written. Add a special case for a Story with no Tasks. The repair mode applies the same walk to existing records. The board change is the same as a1.\n\n**Rejected because:** Partial on status-from-lifecycles and covers-all-routes: 816 Tasks have no build round, and a Story approved with an override over a failed Task would never complete.\n\n### 7.3 a3: Settle by migration only\n\nLeave live completion as it is and have a repeatable migration compute unit status from approved records.\n\nKeep the current walk unchanged. Run the repair on demand or at daemon start to set epic, story and task status from approved BUILD records and code reviews. The board reads the unit statuses it finds.\n\n**Rejected because:** Violates status-from-lifecycles: status is stale between runs, and the defect that completion never fires stays in place.\n\n## 8. References\n\n- **[[c1]]** `code` `src/workflow/gates.ts:959`\n- **[[c2]]** `code` `src/workflow/convert/plan.ts:121`\n- **[[c3]]** `code` `src/workflow/delivery/load.ts:58`\n- **[[c4]]** `code` `src/workflow/artifact-core/lifecycle.ts:336`\n- **[[c5]]** `code` `src/workflow/convert/repair-amendments.ts:29`\n- **[[c6]]** `prior-artifact` `docs/standalone/make-delivery-board-read-common-artifact-E20261109eedc4519/ISSUE.md`\n- **[[c7]]** `stakeholder` `User decision on 2026-11-09 to make the unit statuses real and have the board read them`\n"},"capturedAt":"2026-11-09T09:54:08.853Z"},"inventory":{"units":[{"id":"/body/summary","selector":"/body/summary","title":"summary","kind":"section"},{"id":"/body/hldContextSlice","selector":"/body/hldContextSlice","title":"hldContextSlice","kind":"section"},{"id":"/body/contractDetails","selector":"/body/contractDetails","title":"contractDetails","kind":"section"},{"id":"/body/dataModelChanges","selector":"/body/dataModelChanges","title":"dataModelChanges","kind":"section"},{"id":"/body/interactionWithShared","selector":"/body/interactionWithShared","title":"interactionWithShared","kind":"section"},{"id":"/body/errorPaths","selector":"/body/errorPaths","title":"errorPaths","kind":"section"},{"id":"/body/testStrategy","selector":"/body/testStrategy","title":"testStrategy","kind":"section"},{"id":"/body/migration","selector":"/body/migration","title":"migration","kind":"section"},{"id":"/body/alternativesConsidered","selector":"/body/alternativesConsidered","title":"alternativesConsidered","kind":"section"},{"id":"/body/chosenAlternative","selector":"/body/chosenAlternative","title":"chosenAlternative","kind":"section"},{"id":"/body/openQuestions","selector":"/body/openQuestions","title":"openQuestions","kind":"section"},{"id":"/body/alternativesConsidered/0","selector":"/body/alternativesConsidered/0","title":"a1","kind":"requirement"},{"id":"/body/alternativesConsidered/1","selector":"/body/alternativesConsidered/1","title":"a2","kind":"requirement"},{"id":"/body/alternativesConsidered/2","selector":"/body/alternativesConsidered/2","title":"a3","kind":"requirement"},{"id":"/citations/0","selector":"/citations/0","title":"Citation 1","kind":"citation"},{"id":"/citations/1","selector":"/citations/1","title":"Citation 2","kind":"citation"},{"id":"/citations/2","selector":"/citations/2","title":"Citation 3","kind":"citation"},{"id":"/citations/3","selector":"/citations/3","title":"Citation 4","kind":"citation"},{"id":"/citations/4","selector":"/citations/4","title":"Citation 5","kind":"citation"},{"id":"/citations/5","selector":"/citations/5","title":"Citation 6","kind":"citation"},{"id":"/citations/6","selector":"/citations/6","title":"Citation 7","kind":"citation"},{"id":"document:line:24","selector":"document:line:24","title":"1. HLD context","kind":"section"}]},"completedChunks":[{"chunkId":"scope","status":"incomplete","summary":"The LLD addresses the issue's main loading, migration and lifecycle-status goals, and correctly treats this as standalone issue work without requiring HLD ancestry. However, the chosen completion model changes an applicable Task completion rule without reconciling that change, and stakeholder provenance could not be independently verified.","findings":[{"id":"scope-01","severity":"MED","location":"/body/alternativesConsidered/0","message":"The chosen model completes every open Task when the Story BUILD is approved with a clean or overridden code review, even when a Task's latest build failed. The applicable common-model design requires each Task to pass its gate and says rejected or unfinished children count against Story completion. The originating ISSUE requests accurate lifecycle status and repair, but does not explicitly replace these completion requirements. Although the LLD acknowledges changing the roll-up rule, it does not reconcile the upstream requirement or distinguish an ordinary clean code review from explicit authorization to override failed Task evidence. Define that policy change and its recorded override requirements, or preserve Task completion gating.","evidenceReferences":["docs/standalone/make-delivery-board-read-common-artifact-E20261109eedc4519/S001/LLD.md:282-294",".insrc/artifacts/LLD-eedc4519199b24b4-s1.json#/body/alternativesConsidered/0/cons","docs/plans/core-data-model.md:84-90","docs/plans/core-data-model.md:196","src/workflow/artifact-core/lifecycle.ts:336","docs/standalone/make-delivery-board-read-common-artifact-E20261109eedc4519/ISSUE.md#Fix intent"]}],"inspectedReferences":["/body/summary","/body/hldContextSlice","document:line:24","/body/alternativesConsidered","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/alternativesConsidered/2","/body/chosenAlternative","/body/openQuestions","/citations/5","/citations/6","/Users/subhagho/work/projects/insors/insrc/docs/standalone/make-delivery-board-read-common-artifact-E20261109eedc4519/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-eedc4519199b24b4-s1.json","/Users/subhagho/work/projects/insors/insrc/docs/standalone/make-delivery-board-read-common-artifact-E20261109eedc4519/ISSUE.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/ISSUE-eedc4519199b24b4.json","docs/plans/core-data-model.md","src/workflow/artifact-core/lifecycle.ts","src/workflow/artifact-core/lifecycle-service.ts","src/workflow/artifact-core/completion-evidence.ts","src/workflow/gates.ts","src/workflow/convert/tasks.ts","src/workflow/convert/units.ts","src/workflow/convert/apply.ts"],"limitations":["Stakeholder provenance for /citations/6 could not be independently verified. It names a user decision dated 2026-11-09 but supplies no message identifier, transcript path, quotation or linked decision record. The supplied context and located issue/LLD records do not establish the decision's exact scope, particularly whether it authorized completing failed Tasks through ordinary BUILD approval."],"advice":["Retain the standalone context clarification; the generated HLD metadata and section heading do not establish actual HLD ancestry.","Add a source reference for the historical daemon attribution used to close the originating issue's writer-investigation requirement. The cited commit has no artifact-core directory, but that alone does not establish which deployed process produced every affected record."]},{"chunkId":"completion","status":"changes_requested","summary":"The live completion design has three implementation gaps: the existing cascade excludes Tasks, completion failures lack a return contract, and missing sibling Story heads can cause premature Epic completion.","findings":[{"id":"completion-01","severity":"HIGH","location":"/body/contractDetails/api/1/postconditions","message":"The promised completion of open Tasks cannot use the existing cascade as specified. unitMembers includes Story records, TASKS and DIAG, but explicitly excludes TASK heads; existing tests confirm Tasks complete independently. Changing Story rollUp therefore allows the Story and Epic to complete while their Tasks remain open. Specify the Task cascade changes, including terminal-state exclusions, history attribution, reopen behavior and recovery after partial failure. The integration test should assert individual TASK lifecycles and logs.","evidenceReferences":["docs/standalone/make-delivery-board-read-common-artifact-E20261109eedc4519/S001/LLD.md:74","src/workflow/artifact-core/lifecycle.ts#unitMembers","src/workflow/artifact-core/lifecycle-service.ts#applyInQueue","src/workflow/artifact-core/lifecycle-service.ts#completeMember","src/workflow/artifact-core/__tests__/lifecycle-completion.test.ts:59","src/workflow/artifact-core/__tests__/lifecycle-completion.test.ts:109"]},{"id":"completion-02","severity":"MED","location":"/body/errorPaths/errorCases/0/response","message":"The error path promises that a completion failure is returned with the successful approval, but completeThroughService returns void and declares no errors or result data. Neither ApprovalResult nor WorkflowApproveResult currently has a completion outcome, and the current caller simply awaits the helper. Catching and logging would hide the failure; propagating it would prevent the caller receiving the successful approval result. Define an additive completion outcome and its propagation, and test that the caller receives both the standing approval and the failure details.","evidenceReferences":["docs/standalone/make-delivery-board-read-common-artifact-E20261109eedc4519/S001/LLD.md:79","docs/standalone/make-delivery-board-read-common-artifact-E20261109eedc4519/S001/LLD.md:187","src/workflow/gates.ts:545","src/workflow/gates.ts:881","src/workflow/gates.ts:956","src/workflow/gates.ts:1010"]},{"id":"completion-03","severity":"HIGH","location":"/body/contractDetails/api/2/postconditions","message":"Ensuring only the approved BUILD's Story and Epic heads is insufficient before retaining the existing Epic roll-up. The originating issue documents missing STORY heads for Stories listed in DEF. Current Epic roll-up counts only existing heads discovered through parent links. If an Epic declares two Stories but only the approved Story has a head, this walk can complete the Epic and freeze DEF/HLD while the other Story remains unfinished. Before aggregation, establish all declared Story heads or explicitly block completion on missing declared members. Include this mixed existing/missing sibling case in the approval integration tests.","evidenceReferences":["docs/standalone/make-delivery-board-read-common-artifact-E20261109eedc4519/S001/LLD.md:44","docs/standalone/make-delivery-board-read-common-artifact-E20261109eedc4519/S001/LLD.md:93","docs/standalone/make-delivery-board-read-common-artifact-E20261109eedc4519/ISSUE.md#Root cause","src/workflow/artifact-core/lifecycle.ts#countedChildren","src/workflow/artifact-core/lifecycle.ts#rollUp","src/workflow/artifact-core/store.ts#scanChildren","src/workflow/convert/units.ts#applyUnits"]}],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/body/interactionWithShared","/body/errorPaths","/body/testStrategy","/citations/0","/citations/3","/Users/subhagho/work/projects/insors/insrc/docs/standalone/make-delivery-board-read-common-artifact-E20261109eedc4519/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-eedc4519199b24b4-s1.json","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/delivery-board-lld-s1.json","docs/standalone/make-delivery-board-read-common-artifact-E20261109eedc4519/ISSUE.md","docs/plans/core-data-model.md","docs/epics/one-common-model-every-artifact-E202610192f27754d/HLD.md","docs/epics/one-common-model-every-artifact-E202610192f27754d/S003/LLD.md","src/workflow/artifact-core/lifecycle.ts","src/workflow/artifact-core/lifecycle-service.ts","src/workflow/artifact-core/completion-evidence.ts","src/workflow/artifact-core/approval-view.ts","src/workflow/artifact-core/store.ts","src/workflow/artifact-ids.ts","src/workflow/gates.ts","src/workflow/team/signoff.ts","src/workflow/convert/units.ts","src/workflow/code-review/gate.ts","src/workflow/code-review/task-review/completion.ts","src/workflow/artifact-core/__tests__/lifecycle-completion.test.ts","src/workflow/__tests__/gates-lifecycle-service.test.ts"],"limitations":[],"advice":["Expand the lifecycle test matrix to explicitly cover approval with a persisted review override followed by deferred signoff settlement, reopened BUILD records, normalized S001 identities, and withdrawn or superseded Tasks.","The relationship prose can suffice for these changes. No diagram definitions, companions or renderings were supplied in the canonical artifact or subject directory; no visual verification is claimed."]},{"chunkId":"repair","status":"changes_requested","summary":"The repair intent matches the issue, but the LLD leaves repair reporting and reconstruction rules insufficiently defined for the promised repeatability and coverage.","findings":[{"id":"repair-01","severity":"MED","location":"/body/contractDetails/api/3","message":"The new modes return ConversionReport, but that contract currently permits only preview/apply. ConversionChange has no settlement rule, and ConversionResult has no runtime repair-problem collection. The LLD changes none of these types while promising previewed completion changes, per-unit conflict reporting and a second-run report with no changes. Define the additive report contracts and distinguish planned, successfully applied, held and failed changes; otherwise callers cannot reliably determine what repair actually accomplished.","evidenceReferences":["src/workflow/convert/types.ts#ConversionReport","src/workflow/convert/types.ts#ConversionRule","src/workflow/convert/types.ts#ConversionResult","src/workflow/convert/apply.ts#applyConversion","src/daemon/repo-convert.ts#handleRepoConvert","/body/errorPaths/errorCases/3","/body/migration/migrationSteps/4"]},{"id":"repair-02","severity":"MED","location":"/body/migration/migrationSteps/3","message":"The reconstruction step promises missing units, including standalone work, without defining discovery and eligibility rules that cover them. Existing unitsRule/applyUnits discover Epics and Stories only from DEF, so they cannot reconstruct standalone work without DEF. Existing task reconstruction selects only PLAN status approved, excluding completed Plans, and createFromPlan returns immediately for an existing TASKS head at the same revision rather than restoring a missing TASK. Specify how repair discovers standalone ownership, handles completed Plans and reconciles incomplete existing task sets while preserving identities and terminal states. Add fixtures for these cases; the stated generic missing-TASKS test does not establish this coverage.","evidenceReferences":["docs/standalone/make-delivery-board-read-common-artifact-E20261109eedc4519/ISSUE.md#Fix intent","src/workflow/convert/units.ts#epicsOf","src/workflow/convert/units.ts#applyUnits","src/workflow/convert/tasks.ts#plannedStories","src/workflow/tasks/task-set.ts#readPlan","src/workflow/tasks/task-set.ts#createFromPlan","/body/testStrategy/testLevels/1"]}],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/body/errorPaths","/body/testStrategy","/body/migration","/citations/1","/citations/4","/Users/subhagho/work/projects/insors/insrc/docs/standalone/make-delivery-board-read-common-artifact-E20261109eedc4519/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-eedc4519199b24b4-s1.json","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/delivery-board-lld-s1.json","docs/standalone/make-delivery-board-read-common-artifact-E20261109eedc4519/ISSUE.md","docs/plans/core-data-model.md","docs/epics/one-common-model-every-artifact-E202610192f27754d/S009/LLD.md","src/daemon/repo-convert.ts","src/workflow/convert/run.ts","src/workflow/convert/types.ts","src/workflow/convert/plan.ts","src/workflow/convert/apply.ts","src/workflow/convert/repair-amendments.ts","src/workflow/convert/raw-heads.ts","src/workflow/convert/backfill.ts","src/workflow/convert/migrated-head.ts","src/workflow/convert/units.ts","src/workflow/convert/tasks.ts","src/workflow/convert/rename.ts","src/workflow/convert/legacy-view.ts","src/workflow/convert/verify.ts","src/workflow/artifact-core/lifecycle.ts","src/workflow/artifact-core/lifecycle-service.ts","src/workflow/artifact-core/completion-evidence.ts","src/workflow/tasks/task-set.ts","src/workflow/convert/__tests__/convert-repeat.test.ts","src/workflow/convert/__tests__/convert-lifecycle-backfill.test.ts","src/workflow/convert/__tests__/convert-verify.test.ts"],"limitations":[],"advice":["Expand repair tests to cover unreadable heads, head/log conflicts, reopened work, normalized identities and interruption during settlement. The existing lifecycle service can complete earlier members before a later member fails, so recovery assertions should inspect individual heads and logs.","The assigned repair contracts can be explained adequately through prose and tables. No diagram definitions or rendered companions are supplied in the subject directory; no visual verification is claimed."]},{"chunkId":"board","status":"changes_requested","summary":"The loader extension addresses the reported unknown kinds, but the design does not define how lifecycle status reaches the published snapshot and UI, or how Task identities and ordering survive re-planning.","findings":[{"id":"board-01","severity":"HIGH","location":"/body/contractDetails/api/5","message":"The graph promises to carry unit status, but no WorkItemNode or DeliveryItem field, snapshot propagation, stage precedence or client rendering contract is defined. Currently storyStage marks any approved BUILD complete, the plugin derives Epic completion from child stages, and Task rows display validation results. Consequently a held, reopened or missing STORY head can still appear complete, and Epic/Task lifecycle status cannot reach the UI through the specified changes. Define the published head/status representation, its precedence over BUILD-derived completion, missing-head behavior, and Epic/Task display behavior. Extend snapshot and client tests with deliberately conflicting BUILD and unit statuses; graph assertions and enum-label checks alone do not prove the originating issue's lifecycle-source requirement.","evidenceReferences":["docs/standalone/make-delivery-board-read-common-artifact-E20261109eedc4519/ISSUE.md#Fix intent","docs/standalone/make-delivery-board-read-common-artifact-E20261109eedc4519/S001/LLD.md:140","docs/standalone/make-delivery-board-read-common-artifact-E20261109eedc4519/S001/LLD.md:278","src/workflow/delivery/types.ts#WorkItemNode","src/workflow/delivery/types.ts#DeliveryItem","src/workflow/delivery/stage.ts#storyStage","src/workflow/delivery/snapshot.ts#assembleSnapshot","vscode-plugin/src/delivery/board-views.ts#leastAdvancedStage","vscode-plugin/src/delivery/board-details.ts#taskRows"]},{"id":"board-02","severity":"MED","location":"/body/contractDetails/api/5/postconditions","message":"Taking Task title and order from TASK heads is insufficient to join those heads to PLAN/BUILD evidence. Task artifact numbers differ from plan row ids after re-planning: the existing reconcile test maps row t9 to TASK t4 and later returning row t3 to TASK t5 while the old TASK t3 remains withdrawn. The current graph and gate join by numeric task id, and the client joins plan details through sourceIds; all would need explicit mapping through TaskPayload.planTaskId. Ordering also currently gets sorted by task number in the graph and gate, rather than TaskPayload.order. Specify TASKS membership, active versus withdrawn Task handling, row-to-artifact mapping, and preservation of execution order through snapshot and client rendering. Add a re-plan fixture proving correct status, validation, dependencies and order without duplicate synthetic tasks.","evidenceReferences":["docs/standalone/make-delivery-board-read-common-artifact-E20261109eedc4519/S001/LLD.md:144","src/workflow/tasks/types.ts#TaskPayload","src/workflow/tasks/types.ts#TasksPayload","src/workflow/tasks/task-set.ts#reconcile","src/workflow/tasks/__tests__/task-set-reconcile.test.ts","src/workflow/tasks/lookup.ts#taskHeadIdOf","src/workflow/delivery/graph.ts#addTasks","src/workflow/delivery/graph.ts#freeze","src/workflow/delivery/gate.ts#storyValidation","vscode-plugin/src/delivery/board-details.ts#taskRows","docs/plans/core-data-model.md:413"]}],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/body/interactionWithShared","/body/errorPaths","/body/testStrategy","/body/migration","/citations/2","/Users/subhagho/work/projects/insors/insrc/docs/standalone/make-delivery-board-read-common-artifact-E20261109eedc4519/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-eedc4519199b24b4-s1.json","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/delivery-board-lld-s1.json","docs/standalone/make-delivery-board-read-common-artifact-E20261109eedc4519/ISSUE.md","docs/plans/core-data-model.md","docs/epics/one-common-model-every-artifact-E202610192f27754d/S007/LLD.md","src/workflow/delivery/load.ts","src/workflow/delivery/types.ts","src/workflow/delivery/graph.ts","src/workflow/delivery/gate.ts","src/workflow/delivery/stage.ts","src/workflow/delivery/snapshot.ts","src/workflow/delivery/notice.ts","src/workflow/delivery/read.ts","src/workflow/delivery/handlers.ts","src/workflow/delivery/__tests__/contract.test.ts","src/workflow/delivery/__tests__/identity-contract.test.ts","src/workflow/delivery/__tests__/graph.test.ts","src/workflow/delivery/__tests__/gate.test.ts","src/workflow/convert/verify.ts","src/workflow/convert/__tests__/convert-verify.test.ts","src/workflow/tasks/types.ts","src/workflow/tasks/task-set.ts","src/workflow/tasks/lookup.ts","src/workflow/tasks/__tests__/task-set-reconcile.test.ts","vscode-plugin/src/delivery/delivery-contract.ts","vscode-plugin/src/delivery/delivery-client.ts","vscode-plugin/src/delivery/labels.ts","vscode-plugin/src/delivery/board-model.ts","vscode-plugin/src/delivery/board-views.ts","vscode-plugin/src/delivery/board-details.ts","vscode-plugin/src/delivery/__tests__/labels.test.ts","jetbrains-plugin/src/main/kotlin/ai/insors/insrc/jetbrains/daemon/DaemonGateway.kt"],"limitations":[],"advice":["Explicitly classify TASKS as structural membership data rather than an approval decision; its draft lifecycle should not introduce pending-decision attention.","No diagram definitions, companions or renderings are supplied in the canonical artifact or subject directory; no visual verification is claimed. Relationship prose can suffice, but the revised status contract should explain the visible states.","No current JetBrains workflow.delivery consumer was found. Preserve the shared sample snapshot contract test without adding a new JetBrains delivery feature to this fix.","The live repair acceptance run belongs to implementation validation and was not executed during this read-only design review."]},{"chunkId":"consistency","status":"incomplete","summary":"Inspected the current LLD, originating ISSUE, canonical records and all four completed chunk assessments. Both subject fingerprints match the checkpoint baseline. The earlier findings collectively cover the demonstrated completion, reconstruction, reporting and board-contract gaps; no additional distinct blocking defect was identified. Provenance verification remains incomplete.","findings":[],"inspectedReferences":["/Users/subhagho/work/projects/insors/insrc/docs/standalone/make-delivery-board-read-common-artifact-E20261109eedc4519/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/delivery-board-lld-s1.json","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-eedc4519199b24b4-s1.json","/Users/subhagho/work/projects/insors/insrc/docs/