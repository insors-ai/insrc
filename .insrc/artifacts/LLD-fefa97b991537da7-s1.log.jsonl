261363	{"artifactId":"LLD-fefa97b991537da7-s1","entry":{"id":"38b7f20b567ad0c542fdea904118f5565948722850c3e2709ad65f0cdac77fca","targetHeadHash":"6530a5020e407d8d056d4a8c6299e0ae7c89d9348a63ef12c4444edb1de4bea8","actor":{"id":"agent:design-review-daemon","kind":"agent","properties":{"party":"daemon"}},"timestamp":"2026-11-08T12:55:35.411Z","operation":"review","revision":{"number":2,"contentHash":"e97f4687126f5e3b60e0983c01a71a92888845c3ba639c62be474f96b1ef87cf"},"outcome":{"result":"block","summary":"Design review rv-fefa97b991537da7-s1 attempt 2","data":{"kind":"design-chunk-review","schemaVersion":1,"reviewId":"rv-fefa97b991537da7-s1","project":"/Users/subhagho/work/projects/insors/insrc","artifactId":"LLD-fefa97b991537da7-s1","subject":{"project":"/Users/subhagho/work/projects/insors/insrc","artifactId":"LLD-fefa97b991537da7-s1","kind":"LLD","canonicalPath":"/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-fefa97b991537da7-s1.json","documentPath":"/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md","reviewer":"daemon","workflow":{"kind":"issue","rootArtifactId":"ISSUE-fefa97b991537da7","requiredReferences":[{"role":"originating_issue","artifactId":"ISSUE-fefa97b991537da7","path":"/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/ISSUE.md"}],"availableReferences":[],"notApplicableRoles":["PLAN","TASKS","BUILD","CR","DEF","HLD","sibling_stories"]}},"submitted":{"artifactPath":"/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md","attempt":1},"reviewer":"daemon","attempts":[{"number":1,"status":"incomplete","preparationKind":"planning","baseline":{"subjectFingerprints":{"canonical":"23c70884813272294c76f4f45f491dc520ce22875230055707985aa8af8faca3","document":"bb3984de239d4ede99c2d74282bb639e3c015d790c2625513626a6a03b76e45f"},"contentIdentity":"d2ce2b5da84a1b6c35cf6e632c8c8a984d510bfaec6259ff15c62874d790a141","reviewedContent":{"canonical":"{\n  \"meta\": {\n    \"workflow\": \"design.story\",\n    \"runId\": \"wf-1794140341191-zaxlbk\",\n    \"repoPath\": \"/Users/subhagho/work/projects/insors/insrc\",\n    \"createdAt\": \"2026-11-08T12:23:57.250Z\",\n    \"epicCreatedAt\": \"2026-11-04T19:31:14.890Z\",\n    \"attribution\": {\n      \"outputs\": [\n        {\n          \"role\": \"(client)\",\n          \"tier\": \"core\",\n          \"runner\": \"cli-claude\",\n          \"model\": \"claude-opus-5-5\"\n        }\n      ]\n    },\n    \"elapsedMs\": 295634,\n    \"repoIndexedAt\": null,\n    \"schemaVersion\": 1,\n    \"epicHash\": \"fefa97b991537da7\",\n    \"epicSlug\": \"open-saved-connections-demand-read-all\",\n    \"storyId\": \"s1\",\n    \"hldBaseRunId\": \"wf-1794140341191-zaxlbk\",\n    \"hldEffectiveHash\": \"22924a2ab359704f8956be3be37a27f1645d4e47f854f964a00fa93714236055\",\n    \"hldAmendmentsApplied\": [],\n    \"storyTitle\": \"Open saved connections on demand and read all credentials with one keychain prompt per daemon run\",\n    \"standalone\": true,\n    \"sizeClass\": \"bugfix\",\n    \"triageRationale\": \"Sized bugfix ISSUE-fefa97b991537da7, approved 2026-11-04; rerun at the issue's full scope on the user's instruction, replacing the narrowed LLD-669ae7a31701e106-S001.\",\n    \"authoredBy\": \"controller\",\n    \"revision\": 1\n  },\n  \"body\": {\n    \"summary\": {\n      \"audience\": \"technical\",\n      \"prose\": \"The daemon stops touching the Keychain when it starts, and opens a repository's saved connections the first time a request needs them. All secrets move into one Keychain item that the main thread reads once per daemon run and serves to every thread from memory, so reading secrets prompts at most once however many connections and threads there are. Existing per-item secrets are copied in the first time each is used and stay readable if anything fails. A save rewrites that one item, so a user who answered Allow rather than Always Allow can see one further dialog on a save.\"\n    },\n    \"hldContextSlice\": {\n      \"frameworkSummary\": \"Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\",\n      \"ownedContracts\": [],\n      \"consumedContracts\": [],\n      \"boundary\": {\n        \"storyId\": \"s1\",\n        \"owns\": [],\n        \"depends\": [],\n        \"internal\": \"Open saved connections on demand and read all credentials with one keychain prompt per daemon run\"\n      },\n      \"adjacentBoundaries\": [],\n      \"rolloutPhase\": \"standalone\",\n      \"nonFunctional\": {}\n    },\n    \"contractDetails\": {\n      \"surfaceLevel\": \"internal\",\n      \"api\": [\n        {\n          \"name\": \"getKey\",\n          \"signature\": \"getKey(name: string): Promise<string | null>\",\n          \"parameters\": [\n            {\n              \"name\": \"name\",\n              \"type\": \"string\",\n              \"purpose\": \"Secret name, unchanged from today's account names.\",\n              \"optional\": false\n            }\n          ],\n          \"returns\": {\n            \"type\": \"Promise<string | null>\",\n            \"meaning\": \"The secret, from the vault held in memory, or null when no such secret exists.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"KeystoreUnavailableError\",\n              \"condition\": \"The Keychain refused or failed the vault read, or the vault item cannot be parsed. The cause is carried. Other requests are not blocked.\"\n            }\n          ],\n          \"preconditions\": [\n            \"On a session worker the call is forwarded over the worker's hub channel; only the owning thread calls keytar.\"\n          ],\n          \"postconditions\": [\n            \"At most one Keychain read of the vault item per successful daemon run, across all threads and concurrent callers.\",\n            \"A name absent from the vault, not retired and not yet looked up this run is read once from its legacy item and, when found, copied into the vault.\"\n          ]\n        },\n        {\n          \"name\": \"setKey\",\n          \"signature\": \"setKey(name: string, value: string): Promise<void>\",\n          \"parameters\": [\n            {\n              \"name\": \"name\",\n              \"type\": \"string\",\n              \"purpose\": \"Secret name.\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"value\",\n              \"type\": \"string\",\n              \"purpose\": \"Secret value.\",\n              \"optional\": false\n            }\n          ],\n          \"returns\": {\n            \"type\": \"Promise<void>\",\n            \"meaning\": \"Resolves after the vault item is written and memory updated.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"KeystoreUnavailableError\",\n              \"condition\": \"The vault could not be loaded or written. Memory keeps its previous value.\"\n            }\n          ],\n          \"preconditions\": [\n            \"Writes are serialised by the owner, so concurrent saves cannot lose an update.\"\n          ],\n          \"postconditions\": [\n            \"The Keychain item is written first; memory changes only after that succeeds.\"\n          ]\n        },\n        {\n          \"name\": \"deleteKey\",\n          \"signature\": \"deleteKey(name: string): Promise<void>\",\n          \"parameters\": [\n            {\n              \"name\": \"name\",\n              \"type\": \"string\",\n              \"purpose\": \"Secret name.\",\n              \"optional\": false\n            }\n          ],\n          \"returns\": {\n            \"type\": \"Promise<void>\",\n            \"meaning\": \"Resolves after the name is removed from the vault and recorded as retired.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"KeystoreUnavailableError\",\n              \"condition\": \"The vault could not be loaded or written. Memory is unchanged.\"\n            }\n          ],\n          \"preconditions\": [\n            \"Serialised with setKey by the owner.\"\n          ],\n          \"postconditions\": [\n            \"The name is recorded as retired, so a leftover legacy item cannot bring it back.\",\n            \"The legacy item is deleted best effort; a failure is logged by name only.\"\n          ]\n        },\n        {\n          \"name\": \"listKeys\",\n          \"signature\": \"listKeys(): Promise<string[]>\",\n          \"parameters\": [],\n          \"returns\": {\n            \"type\": \"Promise<string[]>\",\n            \"meaning\": \"Names held in the vault. A legacy item not yet copied in is not listed until it is first used or set.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"KeystoreUnavailableError\",\n              \"condition\": \"The vault could not be loaded.\"\n            }\n          ],\n          \"preconditions\": [],\n          \"postconditions\": [\n            \"keytar.findCredentials is no longer called anywhere.\"\n          ]\n        },\n        {\n          \"name\": \"ensureDefaultManagedRoot\",\n          \"signature\": \"ensureDefaultManagedRoot(root: string, ports?: StartupPorts): Promise<void>\",\n          \"parameters\": [\n            {\n              \"name\": \"root\",\n              \"type\": \"string\",\n              \"purpose\": \"Registered repository whose saved management a request needs.\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"ports\",\n              \"type\": \"StartupPorts\",\n              \"purpose\": \"Unchanged registration, keystore and enablement seams.\",\n              \"optional\": true\n            }\n          ],\n          \"returns\": {\n            \"type\": \"Promise<void>\",\n            \"meaning\": \"Unchanged: resolves once saved management for the root is installed, memoised per root; a rejected attempt is forgotten so the next call retries. What changes is the caller: the boot loop is removed and the main-thread request handlers call it.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"TicketError('secret-unavailable')\",\n              \"condition\": \"The Keychain refused or failed reading or creating the root's ticket key.\"\n            },\n            {\n              \"type\": \"ManagedStoreError('recovery-required') with cause KeystoreUnavailableError\",\n              \"condition\": \"A rollback-copy or connection-secret read failed in the Keychain; managementRejection reports it as 'secret-unavailable' from the cause.\"\n            },\n            {\n              \"type\": \"ManagedStoreError('recovery-required')\",\n              \"condition\": \"A legacy unmanaged registry, damaged metadata or any other integrity failure; unchanged.\"\n            }\n          ],\n          \"preconditions\": [\n            \"Called on the daemon main thread only, by owner and safeList and the listing and save paths, as capabilities already does.\"\n          ],\n          \"postconditions\": [\n            \"No call is made before server.listen, so a daemon start reads nothing from the Keychain.\",\n            \"Fresh initialization takes its ticket key before its first disk write, so a refused Keychain read leaves no partial state.\",\n            \"closeDefaultManagedRoots still closes every root opened on demand at shutdown.\"\n          ]\n        }\n      ]\n    },\n    \"dataModelChanges\": [\n      {\n        \"entity\": \"SecretVaultItem\",\n        \"change\": \"new\",\n        \"details\": \"One Keychain item under the new service 'insrc-vault', reserved account 'secrets', with a value of JSON: version 1, secrets (a map of name to value) and retired (names deleted after the vault existed). The separate service means keys.get, keys.set, keys.delete and keys.list can never address the vault item itself. Parsing failure is fail-closed: the item is never overwritten and reads report KeystoreUnavailableError.\",\n        \"schemaDiff\": \"+ service insrc-vault, account secrets: { version: 1, secrets: Record<string, string>, retired: string[] }\",\n        \"callSites\": [\n          \"src/shared/keystore.ts:10-40\"\n        ]\n      },\n      {\n        \"entity\": \"In-memory vault\",\n        \"change\": \"new\",\n        \"details\": \"Owned by the main thread, or by the process in the offline maintenance binary, which runs only while the daemon is stopped. Load is single-flight, so a pending dialog holds one load and concurrent callers await it. A refused or failed load is remembered for five minutes, in which reads fail at once with KeystoreUnavailableError, so a user who denies access is not prompted by every following request; after that the next request retries. Decrypted values stay in memory and pass between threads only over the in-process hub channel; nothing decrypted is written to disk or logged.\",\n        \"callSites\": [\n          \"src/shared/keystore.ts:10-40\",\n          \"src/daemon/threads/main-services.ts:207\",\n          \"src/daemon/threads/worker-entry.ts:81\"\n        ]\n      },\n      {\n        \"entity\": \"Worker keystore forwarding\",\n        \"change\": \"new\",\n        \"details\": \"A hub operation served by the main thread through serveHub for get, set, delete and list; worker-entry installs the forwarder, so getKey and its siblings keep their signatures on every thread. With daemon.threads.enabled off, the main thread uses the vault directly. No RPC method is added, so the method-class table is unchanged.\",\n        \"callSites\": [\n          \"src/daemon/threads/channel.ts:117\",\n          \"src/daemon/threads/main-services.ts:207\",\n          \"src/daemon/threads/worker-entry.ts:81\",\n          \"src/daemon/threads/method-class.ts:142-160\"\n        ]\n      },\n      {\n        \"entity\": \"Legacy per-item secrets\",\n        \"change\": \"invariant-change\",\n        \"details\": \"Items under service 'insrc' stop being the source of truth once copied, and migration never deletes them, so a failed or partial migration leaves them readable. Only an explicit deleteKey removes one. Rollback: delete the single vault item and every name falls back to its legacy item; secrets first saved after migration exist only in the vault and would need re-entering.\",\n        \"callSites\": [\n          \"src/shared/keystore.ts:10-40\",\n          \"src/daemon/db/secrets.ts:26-44\"\n        ]\n      },\n      {\n        \"entity\": \"keys.list handler\",\n        \"change\": \"invariant-change\",\n        \"details\": \"Reads names and values from the vault rather than running one Keychain read per name. No in-repo client calls keys.list today.\",\n        \"callSites\": [\n          \"src/daemon/handler-runtime.ts:1474-1503\"\n        ]\n      },\n      {\n        \"entity\": \"Daemon boot\",\n        \"change\": \"invariant-change\",\n        \"details\": \"The loop that opens every registered repository before server.listen is removed; closeDefaultManagedRoots stays registered for shutdown.\",\n        \"callSites\": [\n          \"src/daemon/index.ts:470-476\",\n          \"src/daemon/index.ts:539\"\n        ]\n      }\n    ],\n    \"interactionWithShared\": [],\n    \"errorPaths\": {\n      \"errorCases\": [\n        {\n          \"scenario\": \"The user denies the Keychain dialog, or the Keychain read of the vault item fails\",\n          \"detection\": \"keytar.getPassword rejects during the single-flight vault load\",\n          \"response\": \"Every waiting caller gets KeystoreUnavailableError with the cause. The failure is remembered for five minutes, in which reads fail at once without a dialog; the next read after that retries.\",\n          \"userImpact\": \"Requests needing a secret report the connection unavailable with the cause; requests needing no secret continue. The user is not prompted again by each following request.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"The vault item holds content that cannot be parsed or has an unknown version\",\n          \"detection\": \"JSON parsing or the version check fails after a successful Keychain read\",\n          \"response\": \"Fail closed: KeystoreUnavailableError, the item is never rewritten and no legacy fallback is used for that load, so a damaged item cannot be overwritten with a partial one.\",\n          \"userImpact\": \"Saved secrets are unavailable until the item is repaired or deleted; deleting it restores the legacy items.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Writing the vault item fails on a save or delete\",\n          \"detection\": \"keytar.setPassword rejects inside the serialised write\",\n          \"response\": \"KeystoreUnavailableError to that caller; memory keeps its previous value, so memory and Keychain stay consistent.\",\n          \"userImpact\": \"The save reports failure and the old value remains in force.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Copying a legacy secret into the vault fails during migration\",\n          \"detection\": \"keytar.setPassword rejects after the legacy read succeeded\",\n          \"response\": \"The value read is returned to the caller for this request and the name stays unmigrated; the legacy item is untouched and the copy is retried on a later run.\",\n          \"userImpact\": \"None for the request; the name may prompt again on a later run until the copy succeeds.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"A legacy item read is refused during migration\",\n          \"detection\": \"keytar.getPassword on the legacy service rejects\",\n          \"response\": \"KeystoreUnavailableError for that name only; the vault and other names are unaffected.\",\n          \"userImpact\": \"That connection is reported unavailable with the cause.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Opening a repository's saved connections fails on first use\",\n          \"detection\": \"ensureDefaultManagedRoot rejects with a keystore cause or an integrity failure\",\n          \"response\": \"The rejected attempt is forgotten, the request gets 'secret-unavailable' for a keystore cause and 'recovery-required' otherwise; fresh initialization has written nothing if its ticket key could not be taken.\",\n          \"userImpact\": \"That repository's request fails with its cause; the daemon and other repositories are unaffected.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"A worker's hub call to the vault owner fails or the channel closes\",\n          \"detection\": \"The hub request rejects on the worker\",\n          \"response\": \"KeystoreUnavailableError with the cause; the worker does not fall back to calling keytar itself.\",\n          \"userImpact\": \"That request fails; no extra Keychain access occurs.\",\n          \"recoverable\": true\n        }\n      ],\n      \"edgeCases\": [\n        {\n          \"input\": \"No vault item exists yet\",\n          \"expected\": \"keytar returns null with no dialog for a missing item; the vault starts empty and the item is created on the first write.\"\n        },\n        {\n          \"input\": \"A name exists nowhere, such as an unset web search key\",\n          \"expected\": \"getKey returns null; the absence is remembered for the run, not persisted, so no write is caused by a lookup.\"\n        },\n        {\n          \"input\": \"A name is deleted and an old legacy item for it remains\",\n          \"expected\": \"The retired list stops the legacy fallback, and getKey returns null.\"\n        },\n        {\n          \"input\": \"A retired name is saved again\",\n          \"expected\": \"setKey adds it to secrets and removes it from retired.\"\n        },\n        {\n          \"input\": \"Many threads ask for different secrets while the first dialog is open\",\n          \"expected\": \"They wait on the one load; exactly one Keychain read occurs and no request unrelated to secrets waits.\"\n        },\n        {\n          \"input\": \"daemon.threads.enabled is false\",\n          \"expected\": \"The main thread uses the vault directly with the same behaviour.\"\n        },\n        {\n          \"input\": \"The offline maintenance binary runs while the daemon is stopped\",\n          \"expected\": \"It uses its own in-process vault against the same item, with one read for that process.\"\n        },\n        {\n          \"input\": \"A plain listing of a repository with no management marker\",\n          \"expected\": \"No state is created and the Keychain is not touched, as designed in the narrowed LLD.\"\n        }\n      ],\n      \"invariantsToPreserve\": [\n        {\n          \"text\": \"getKey, setKey, deleteKey and listKeys keep their signatures, and the KeystoreLike port and its test seam keep working.\",\n          \"source\": \"c1\"\n        },\n        {\n          \"text\": \"ensureDefaultManagedRoot stays memoised per root and forgets a failed attempt.\",\n          \"source\": \"c3\"\n        },\n        {\n          \"text\": \"The CLI never opens the Keychain; only daemon code and the daemon-owned offline maintenance binary do.\",\n          \"source\": \"c4\"\n        },\n        {\n          \"text\": \"Hub traffic stays in-process between the main thread and its workers.\",\n          \"source\": \"c5\"\n        },\n        {\n          \"text\": \"A daemon shutdown still closes every root that was opened.\",\n          \"source\": \"c3\"\n        }\n      ]\n    },\n    \"testStrategy\": {\n      \"testFramework\": \"node:test\",\n      \"testLevels\": [\n        {\n          \"level\": \"unit\",\n          \"purpose\": \"The vault's load, read, write, retire and failure rules against a fake Keychain backend that counts calls.\",\n          \"subjects\": [\n            \"vault: concurrent reads perform one Keychain read\",\n            \"vault: a refused load fails at once for five minutes and then retries\",\n            \"vault: an unparseable item fails closed and is never rewritten\",\n            \"vault: a failed write leaves memory unchanged\",\n            \"vault: concurrent saves lose no update\",\n            \"vault: a retired name does not fall back to its legacy item\",\n            \"vault: a retired name saved again is readable\",\n            \"migration: a legacy secret is copied once and read from the vault afterwards\",\n            \"migration: a failed copy returns the value and leaves the legacy item readable\",\n            \"migration: an absent name causes no write\",\n            \"keystore: listKeys never calls findCredentials\"\n          ],\n          \"fixturesNeeded\": [\n            \"A fake Keychain backend that counts reads and writes and can refuse them\"\n          ]\n        },\n        {\n          \"level\": \"integration\",\n          \"purpose\": \"Thread ownership, on-demand opening and error mapping with real daemon wiring and the fake backend.\",\n          \"subjects\": [\n            \"threads: workers on two threads share one Keychain read\",\n            \"threads: a closed hub channel does not fall back to the Keychain\",\n            \"threads: a save on one worker is visible on another\",\n            \"boot: a daemon start reads nothing from the Keychain and opens its socket\",\n            \"on-demand: the first management request opens the repository and a later one does not reopen it\",\n            \"on-demand: a refused Keychain read reports secret-unavailable and the next request retries\",\n            \"on-demand: a refused first-time set-up leaves nothing on disk\",\n            \"on-demand: a plain listing of an unmanaged repository touches nothing\",\n            \"consumers: notify, web and keys handlers read through the vault\",\n            \"maintenance: the offline binary reads the vault once\"\n          ],\n          \"fixturesNeeded\": [\n            \"A temporary repository with seeded saved connections\",\n            \"The existing _setKeystoreForTests seam\"\n          ]\n        },\n        {\n          \"level\": \"live\",\n          \"purpose\": \"The real macOS behaviour no fake can show, run by a person.\",\n          \"subjects\": [\n            \"live: after a node upgrade one dialog appears across several connections and threads\"\n          ],\n          \"fixturesNeeded\": [\n            \"A macOS login Keychain with several saved connections\"\n          ]\n        }\n      ],\n      \"acceptanceMapping\": [\n        {\n          \"criterionId\": \"ac1\",\n          \"provingTests\": [\n            \"boot: a daemon start reads nothing from the Keychain and opens its socket\",\n            \"on-demand: the first management request opens the repository and a later one does not reopen it\",\n            \"on-demand: a refused Keychain read reports secret-unavailable and the next request retries\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac2\",\n          \"provingTests\": [\n            \"vault: concurrent reads perform one Keychain read\",\n            \"threads: workers on two threads share one Keychain read\",\n            \"threads: a save on one worker is visible on another\",\n            \"live: after a node upgrade one dialog appears across several connections and threads\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac3\",\n          \"provingTests\": [\n            \"consumers: notify, web and keys handlers read through the vault\",\n            \"maintenance: the offline binary reads the vault once\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac4\",\n          \"provingTests\": [\n            \"migration: a legacy secret is copied once and read from the vault afterwards\",\n            \"migration: a failed copy returns the value and leaves the legacy item readable\"\n          ]\n        }\n      ]\n    },\n    \"migration\": {\n      \"stateBefore\": \"Each secret is its own Keychain item under service 'insrc', read through keytar on every use (s1 symbol.locate), and main() opens every repository's saved connections before server.listen (s1 usage.example).\",\n      \"stateAfter\": \"One vault item under service 'insrc-vault' holds every secret and is read once per daemon run by the main thread; saved connections open on first use. Legacy items remain until an explicit delete.\",\n      \"migrationSteps\": [\n        {\n          \"order\": 1,\n          \"action\": \"Ship the vault with the legacy fallback: a name absent from the vault and not retired is read from its legacy item and copied in on first use.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 2,\n          \"action\": \"Remove the boot loop and open saved connections on first request.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 3,\n          \"action\": \"Each legacy secret is copied into the vault the first time it is used, showing at most one dialog for that item, once in its lifetime; no legacy item is deleted by migration.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 4,\n          \"action\": \"Rollback if the vault must be abandoned: delete the single vault item, or run the previous daemon version; both read the untouched legacy items. Secrets first saved after migration exist only in the vault and must be re-entered.\",\n          \"rollbackable\": true\n        }\n      ],\n      \"backwardCompat\": \"getKey, setKey, deleteKey and listKeys keep their signatures and the KeystoreLike port and test seam are unchanged. listKeys now reports vault names only, so a legacy item appears after first use; no in-repo client calls keys.list. A previous daemon version keeps reading legacy items and does not see the vault.\",\n      \"zeroDowntime\": false,\n      \"dataRewriteRequired\": false\n    },\n    \"alternativesConsidered\": [\n      {\n        \"id\": \"a1\",\n        \"name\": \"One Keychain item holding every secret, owned by the main thread\",\n        \"oneLineSummary\": \"A JSON map of all secrets lives in one Keychain item under a new service; the main thread loads it once on first need and serves every thread from memory.\",\n        \"approach\": \"getKey, setKey, deleteKey and listKeys keep their signatures but read and write a vault: one Keychain item (a new service, reserved account) whose value is a versioned JSON map of name to secret. The first read loads it once, single-flight, and later reads come from memory. On the main thread the vault lives in-process; on a worker the same functions forward over the worker's existing hub channel to it, so only one thread ever touches the Keychain. Writes update the item first and memory only after it succeeds, serialised so concurrent writes cannot lose an update. On a vault miss for a name not yet recorded, the legacy item is read once and copied in, and recorded as migrated; legacy items stay readable. The boot loop is removed and saved connections open on demand, as in the narrowed LLD.\",\n        \"pros\": [\n          \"Exactly the consolidated single item the issue asks for\",\n          \"Keychain stays the only place secrets rest, so nothing new is written to disk\",\n          \"Existing callers and the twenty test files using the port keep working\",\n          \"Reuses the existing worker hub channel\"\n        ],\n        \"cons\": [\n          \"A save rewrites the whole item, and macOS may show a further dialog for a write when the first dialog was answered Allow rather than Always Allow\",\n          \"A legacy item still prompts once when first migrated, once in its lifetime\",\n          \"Workers gain a hub round trip for every secret read\"\n        ],\n        \"costEstimate\": \"M\"\n      },\n      {\n        \"id\": \"a2\",\n        \"name\": \"One Keychain master key with secrets in an encrypted file\",\n        \"oneLineSummary\": \"The Keychain holds only an AES key; secrets live in an AES-GCM file under ~/.insrc, so saving a secret never touches the Keychain after the first read.\",\n        \"approach\": \"The vault keeps the same read and write surface and the same main-thread ownership, but its single Keychain item holds a random 256-bit key. Secrets are stored in one AES-GCM encrypted file written atomically under ~/.insrc; the key is read once per run and writes only re-encrypt the file. Migration and on-demand opening are as in a1.\",\n        \"pros\": [\n          \"Saving or removing a secret can never prompt once the key is in memory\",\n          \"Item size stays constant however many secrets are saved\"\n        ],\n        \"cons\": [\n          \"Introduces a new encrypted store with its own file format, integrity, atomic-write and permission rules to get right and review\",\n          \"Secrets become recoverable only with both the file and the key, a new loss mode, and daemon.backup would need to cover the file\",\n          \"Moves secrets out of the Keychain, a larger security decision than the issue asks for\"\n        ],\n        \"costEstimate\": \"L\",\n        \"reasonRejected\": \"Its only gain over a1 is no dialog on a save, at the cost of a partial on lossless migration and a new encrypted store on disk, a larger security decision than the issue asks for.\"\n      },\n      {\n        \"id\": \"a3\",\n        \"name\": \"One Keychain item cached separately on each thread\",\n        \"oneLineSummary\": \"The smallest change: the keystore module caches the single item in module scope, so each thread that needs a secret loads it for itself.\",\n        \"approach\": \"The keystore module holds the consolidated map in a module-level variable with no cross-thread forwarding. The main thread and each session worker load the item on their own first read and keep their own copy. Writes go to the Keychain and update only the writing thread's copy.\",\n        \"pros\": [\n          \"No hub operations or worker forwarding\",\n          \"Smallest amount of code\"\n        ],\n        \"cons\": [\n          \"Every session worker repeats the Keychain access, so a user who answers Allow is prompted once per thread, which fails the one-prompt requirement\",\n          \"A write on one thread leaves stale secrets on every other thread, which fails the consistency requirement\",\n          \"Two threads writing at once can lose an update to the shared item\"\n        ],\n        \"costEstimate\": \"S\",\n        \"reasonRejected\": \"Violates the one-prompt requirement: each thread does its own Keychain access and holds a stale copy after a write.\"\n      }\n    ],\n    \"chosenAlternative\": \"a1\",\n    \"openQuestions\": [],\n    \"sequenceDefinition\": {\n      \"narrative\": \"How the first secret read in a daemon run reaches the Keychain exactly once, whichever thread asks, and how later reads avoid it.\",\n      \"participants\": [\n        {\n          \"id\": \"client\",\n          \"label\": \"Client request\",\n          \"description\": \"A request that needs a saved secret.\"\n        },\n        {\n          \"id\": \"worker\",\n          \"label\": \"Session worker\",\n          \"description\": \"The thread running that session.\"\n        },\n        {\n          \"id\": \"main\",\n          \"label\": \"Main thread vault\",\n          \"description\": \"The one in-memory owner of all secrets.\"\n        },\n        {\n          \"id\": \"keychain\",\n          \"label\": \"macOS Keychain\",\n          \"description\": \"Holds the single vault item.\"\n        }\n      ],\n      \"messages\": [\n        {\n          \"from\": \"client\",\n          \"to\": \"worker\",\n          \"label\": \"request needing a secret\",\n          \"description\": \"No Keychain access has happened since the daemon started.\"\n        },\n        {\n          \"from\": \"worker\",\n          \"to\": \"main\",\n          \"label\": \"getKey over the hub channel\",\n          \"description\": \"The worker never calls the Keychain itself.\"\n        },\n        {\n          \"from\": \"main\",\n          \"to\": \"keychain\",\n          \"label\": \"read vault item once\",\n          \"description\": \"Single-flight, so concurrent callers wait on this one read; the user sees one dialog.\"\n        },\n        {\n          \"from\": \"keychain\",\n          \"to\": \"main\",\n          \"label\": \"all secrets\",\n          \"kind\": \"return\",\n          \"description\": \"Held in memory until the daemon exits.\"\n        },\n        {\n          \"from\": \"main\",\n          \"to\": \"worker\",\n          \"label\": \"secret\",\n          \"kind\": \"return\",\n          \"description\": \"Passed in-process only.\"\n        },\n        {\n          \"from\": \"worker\",\n          \"to\": \"main\",\n          \"label\": \"later getKey from any thread\",\n          \"description\": \"Served from memory with no Keychain access.\"\n        }\n      ]\n    },\n    \"companions\": [\n      {\n        \"kind\": \"diagram-mermaid\",\n        \"relPath\": \"docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/sequence-diagram.html\",\n        \"title\": \"Sequence diagram\"\n      }\n    ]\n  },\n  \"citations\": [\n    {\n      \"id\": \"c1\",\n      \"kind\": \"code\",\n      \"ref\": \"src/shared/keystore.ts:10-40\"\n    },\n    {\n      \"id\": \"c2\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/db/secrets.ts:26-44\"\n    },\n    {\n      \"id\": \"c3\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/db/management-defaults.ts\"\n    },\n    {\n      \"id\": \"c4\",\n      \"kind\": \"code\",\n      \"ref\": \"src/bin/insrc-connection-maintenance.ts:30\"\n    },\n    {\n      \"id\": \"c5\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/threads/channel.ts:117\"\n    },\n    {\n      \"id\": \"c6\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/index.ts:470-476\"\n    },\n    {\n      \"id\": \"c7\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/threads/method-class.ts:142-160\"\n    },\n    {\n      \"id\": \"c8\",\n      \"kind\": \"prior-artifact\",\n      \"ref\": \"ISSUE-fefa97b991537da7\"\n    },\n    {\n      \"id\": \"c9\",\n      \"kind\": \"prior-artifact\",\n      \"ref\": \"LLD-669ae7a31701e106-S001\"\n    }\n  ]\n}\n","document":"<!-- insrc:artifact LLD-fefa97b991537da7-s1 -->\n\n# LLD: STORY-fefa97b991537da7-s1 — Open saved connections on demand and read all credentials with one keychain prompt per daemon run\n\n## Summary\n\n**Epic:** `open-saved-connections-demand-read-all`\n**HLD base run:** `wf-1794140341191-zaxlbk`\n**HLD effective hash:** `22924a2ab359...`\n\nThe daemon stops touching the Keychain when it starts, and opens a repository's saved connections the first time a request needs them. All secrets move into one Keychain item that the main thread reads once per daemon run and serves to every thread from memory, so reading secrets prompts at most once however many connections and threads there are. Existing per-item secrets are copied in the first time each is used and stay readable if anything fails. A save rewrites that one item, so a user who answered Allow rather than Always Allow can see one further dialog on a save.\n\n## Contents\n\n1. [HLD context](#1-hld-context)\n2. [Contract details](#2-contract-details)\n3. [Data model changes](#3-data-model-changes)\n4. [Diagrams](#4-diagrams)\n5. [Error paths](#5-error-paths)\n6. [Test strategy](#6-test-strategy)\n7. [Migration](#7-migration)\n8. [Alternatives considered](#8-alternatives-considered)\n9. [References](#9-references)\n\n## 1. HLD context\n\n**Framework:** Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\n**Rollout phase:** standalone\n\n## 2. Contract details\n\n**Surface level:** internal\n\n### 2.1 `getKey`\n\n```typescript\ngetKey(name: string): Promise<string | null>\n```\n\n**Parameters:**\n- `name: string` — Secret name, unchanged from today's account names.\n\n**Returns:** `Promise<string | null>` — The secret, from the vault held in memory, or null when no such secret exists.\n\n**Errors:**\n- `KeystoreUnavailableError` when The Keychain refused or failed the vault read, or the vault item cannot be parsed. The cause is carried. Other requests are not blocked.\n\n**Preconditions:**\n- On a session worker the call is forwarded over the worker's hub channel; only the owning thread calls keytar.\n\n**Postconditions:**\n- At most one Keychain read of the vault item per successful daemon run, across all threads and concurrent callers.\n- A name absent from the vault, not retired and not yet looked up this run is read once from its legacy item and, when found, copied into the vault.\n\n### 2.2 `setKey`\n\n```typescript\nsetKey(name: string, value: string): Promise<void>\n```\n\n**Parameters:**\n- `name: string` — Secret name.\n- `value: string` — Secret value.\n\n**Returns:** `Promise<void>` — Resolves after the vault item is written and memory updated.\n\n**Errors:**\n- `KeystoreUnavailableError` when The vault could not be loaded or written. Memory keeps its previous value.\n\n**Preconditions:**\n- Writes are serialised by the owner, so concurrent saves cannot lose an update.\n\n**Postconditions:**\n- The Keychain item is written first; memory changes only after that succeeds.\n\n### 2.3 `deleteKey`\n\n```typescript\ndeleteKey(name: string): Promise<void>\n```\n\n**Parameters:**\n- `name: string` — Secret name.\n\n**Returns:** `Promise<void>` — Resolves after the name is removed from the vault and recorded as retired.\n\n**Errors:**\n- `KeystoreUnavailableError` when The vault could not be loaded or written. Memory is unchanged.\n\n**Preconditions:**\n- Serialised with setKey by the owner.\n\n**Postconditions:**\n- The name is recorded as retired, so a leftover legacy item cannot bring it back.\n- The legacy item is deleted best effort; a failure is logged by name only.\n\n### 2.4 `listKeys`\n\n```typescript\nlistKeys(): Promise<string[]>\n```\n\n**Returns:** `Promise<string[]>` — Names held in the vault. A legacy item not yet copied in is not listed until it is first used or set.\n\n**Errors:**\n- `KeystoreUnavailableError` when The vault could not be loaded.\n\n**Postconditions:**\n- keytar.findCredentials is no longer called anywhere.\n\n### 2.5 `ensureDefaultManagedRoot`\n\n```typescript\nensureDefaultManagedRoot(root: string, ports?: StartupPorts): Promise<void>\n```\n\n**Parameters:**\n- `root: string` — Registered repository whose saved management a request needs.\n- `ports: StartupPorts` _(optional)_ — Unchanged registration, keystore and enablement seams.\n\n**Returns:** `Promise<void>` — Unchanged: resolves once saved management for the root is installed, memoised per root; a rejected attempt is forgotten so the next call retries. What changes is the caller: the boot loop is removed and the main-thread request handlers call it.\n\n**Errors:**\n- `TicketError('secret-unavailable')` when The Keychain refused or failed reading or creating the root's ticket key.\n- `ManagedStoreError('recovery-required') with cause KeystoreUnavailableError` when A rollback-copy or connection-secret read failed in the Keychain; managementRejection reports it as 'secret-unavailable' from the cause.\n- `ManagedStoreError('recovery-required')` when A legacy unmanaged registry, damaged metadata or any other integrity failure; unchanged.\n\n**Preconditions:**\n- Called on the daemon main thread only, by owner and safeList and the listing and save paths, as capabilities already does.\n\n**Postconditions:**\n- No call is made before server.listen, so a daemon start reads nothing from the Keychain.\n- Fresh initialization takes its ticket key before its first disk write, so a refused Keychain read leaves no partial state.\n- closeDefaultManagedRoots still closes every root opened on demand at shutdown.\n\n## 3. Data model changes\n\n### 3.1 `SecretVaultItem` — new\n\nOne Keychain item under the new service 'insrc-vault', reserved account 'secrets', with a value of JSON: version 1, secrets (a map of name to value) and retired (names deleted after the vault existed). The separate service means keys.get, keys.set, keys.delete and keys.list can never address the vault item itself. Parsing failure is fail-closed: the item is never overwritten and reads report KeystoreUnavailableError.\n\n```\n+ service insrc-vault, account secrets: { version: 1, secrets: Record<string, string>, retired: string[] }\n```\n\n**Call sites:**\n- `src/shared/keystore.ts:10-40`\n\n### 3.2 `In-memory vault` — new\n\nOwned by the main thread, or by the process in the offline maintenance binary, which runs only while the daemon is stopped. Load is single-flight, so a pending dialog holds one load and concurrent callers await it. A refused or failed load is remembered for five minutes, in which reads fail at once with KeystoreUnavailableError, so a user who denies access is not prompted by every following request; after that the next request retries. Decrypted values stay in memory and pass between threads only over the in-process hub channel; nothing decrypted is written to disk or logged.\n\n**Call sites:**\n- `src/shared/keystore.ts:10-40`\n- `src/daemon/threads/main-services.ts:207`\n- `src/daemon/threads/worker-entry.ts:81`\n\n### 3.3 `Worker keystore forwarding` — new\n\nA hub operation served by the main thread through serveHub for get, set, delete and list; worker-entry installs the forwarder, so getKey and its siblings keep their signatures on every thread. With daemon.threads.enabled off, the main thread uses the vault directly. No RPC method is added, so the method-class table is unchanged.\n\n**Call sites:**\n- `src/daemon/threads/channel.ts:117`\n- `src/daemon/threads/main-services.ts:207`\n- `src/daemon/threads/worker-entry.ts:81`\n- `src/daemon/threads/method-class.ts:142-160`\n\n### 3.4 `Legacy per-item secrets` — invariant-change\n\nItems under service 'insrc' stop being the source of truth once copied, and migration never deletes them, so a failed or partial migration leaves them readable. Only an explicit deleteKey removes one. Rollback: delete the single vault item and every name falls back to its legacy item; secrets first saved after migration exist only in the vault and would need re-entering.\n\n**Call sites:**\n- `src/shared/keystore.ts:10-40`\n- `src/daemon/db/secrets.ts:26-44`\n\n### 3.5 `keys.list handler` — invariant-change\n\nReads names and values from the vault rather than running one Keychain read per name. No in-repo client calls keys.list today.\n\n**Call sites:**\n- `src/daemon/handler-runtime.ts:1474-1503`\n\n### 3.6 `Daemon boot` — invariant-change\n\nThe loop that opens every registered repository before server.listen is removed; closeDefaultManagedRoots stays registered for shutdown.\n\n**Call sites:**\n- `src/daemon/index.ts:470-476`\n- `src/daemon/index.ts:539`\n\n## 4. Diagrams\n\n- [Sequence diagram](docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/sequence-diagram.html)\n\n## 5. Error paths\n\n**Error cases**\n\n- **The user denies the Keychain dialog, or the Keychain read of the vault item fails** (recoverable)\n  - Detection: keytar.getPassword rejects during the single-flight vault load\n  - Response: Every waiting caller gets KeystoreUnavailableError with the cause. The failure is remembered for five minutes, in which reads fail at once without a dialog; the next read after that retries.\n  - User impact: Requests needing a secret report the connection unavailable with the cause; requests needing no secret continue. The user is not prompted again by each following request.\n- **The vault item holds content that cannot be parsed or has an unknown version** (recoverable)\n  - Detection: JSON parsing or the version check fails after a successful Keychain read\n  - Response: Fail closed: KeystoreUnavailableError, the item is never rewritten and no legacy fallback is used for that load, so a damaged item cannot be overwritten with a partial one.\n  - User impact: Saved secrets are unavailable until the item is repaired or deleted; deleting it restores the legacy items.\n- **Writing the vault item fails on a save or delete** (recoverable)\n  - Detection: keytar.setPassword rejects inside the serialised write\n  - Response: KeystoreUnavailableError to that caller; memory keeps its previous value, so memory and Keychain stay consistent.\n  - User impact: The save reports failure and the old value remains in force.\n- **Copying a legacy secret into the vault fails during migration** (recoverable)\n  - Detection: keytar.setPassword rejects after the legacy read succeeded\n  - Response: The value read is returned to the caller for this request and the name stays unmigrated; the legacy item is untouched and the copy is retried on a later run.\n  - User impact: None for the request; the name may prompt again on a later run until the copy succeeds.\n- **A legacy item read is refused during migration** (recoverable)\n  - Detection: keytar.getPassword on the legacy service rejects\n  - Response: KeystoreUnavailableError for that name only; the vault and other names are unaffected.\n  - User impact: That connection is reported unavailable with the cause.\n- **Opening a repository's saved connections fails on first use** (recoverable)\n  - Detection: ensureDefaultManagedRoot rejects with a keystore cause or an integrity failure\n  - Response: The rejected attempt is forgotten, the request gets 'secret-unavailable' for a keystore cause and 'recovery-required' otherwise; fresh initialization has written nothing if its ticket key could not be taken.\n  - User impact: That repository's request fails with its cause; the daemon and other repositories are unaffected.\n- **A worker's hub call to the vault owner fails or the channel closes** (recoverable)\n  - Detection: The hub request rejects on the worker\n  - Response: KeystoreUnavailableError with the cause; the worker does not fall back to calling keytar itself.\n  - User impact: That request fails; no extra Keychain access occurs.\n\n**Edge cases**\n\n| Input | Expected |\n| :--- | :--- |\n| No vault item exists yet | keytar returns null with no dialog for a missing item; the vault starts empty and the item is created on the first write. |\n| A name exists nowhere, such as an unset web search key | getKey returns null; the absence is remembered for the run, not persisted, so no write is caused by a lookup. |\n| A name is deleted and an old legacy item for it remains | The retired list stops the legacy fallback, and getKey returns null. |\n| A retired name is saved again | setKey adds it to secrets and removes it from retired. |\n| Many threads ask for different secrets while the first dialog is open | They wait on the one load; exactly one Keychain read occurs and no request unrelated to secrets waits. |\n| daemon.threads.enabled is false | The main thread uses the vault directly with the same behaviour. |\n| The offline maintenance binary runs while the daemon is stopped | It uses its own in-process vault against the same item, with one read for that process. |\n| A plain listing of a repository with no management marker | No state is created and the Keychain is not touched, as designed in the narrowed LLD. |\n\n**Invariants to preserve**\n\n- getKey, setKey, deleteKey and listKeys keep their signatures, and the KeystoreLike port and its test seam keep working. [[c1]]\n- ensureDefaultManagedRoot stays memoised per root and forgets a failed attempt. [[c3]]\n- The CLI never opens the Keychain; only daemon code and the daemon-owned offline maintenance binary do. [[c4]]\n- Hub traffic stays in-process between the main thread and its workers. [[c5]]\n- A daemon shutdown still closes every root that was opened. [[c3]]\n\n## 6. Test strategy\n\n**Test framework:** `node:test`\n\n**Test levels**\n\n- **unit** — The vault's load, read, write, retire and failure rules against a fake Keychain backend that counts calls.\n  - Subjects: `vault: concurrent reads perform one Keychain read`, `vault: a refused load fails at once for five minutes and then retries`, `vault: an unparseable item fails closed and is never rewritten`, `vault: a failed write leaves memory unchanged`, `vault: concurrent saves lose no update`, `vault: a retired name does not fall back to its legacy item`, `vault: a retired name saved again is readable`, `migration: a legacy secret is copied once and read from the vault afterwards`, `migration: a failed copy returns the value and leaves the legacy item readable`, `migration: an absent name causes no write`, `keystore: listKeys never calls findCredentials`\n  - Fixtures: `A fake Keychain backend that counts reads and writes and can refuse them`\n- **integration** — Thread ownership, on-demand opening and error mapping with real daemon wiring and the fake backend.\n  - Subjects: `threads: workers on two threads share one Keychain read`, `threads: a closed hub channel does not fall back to the Keychain`, `threads: a save on one worker is visible on another`, `boot: a daemon start reads nothing from the Keychain and opens its socket`, `on-demand: the first management request opens the repository and a later one does not reopen it`, `on-demand: a refused Keychain read reports secret-unavailable and the next request retries`, `on-demand: a refused first-time set-up leaves nothing on disk`, `on-demand: a plain listing of an unmanaged repository touches nothing`, `consumers: notify, web and keys handlers read through the vault`, `maintenance: the offline binary reads the vault once`\n  - Fixtures: `A temporary repository with seeded saved connections`, `The existing _setKeystoreForTests seam`\n- **live** — The real macOS behaviour no fake can show, run by a person.\n  - Subjects: `live: after a node upgrade one dialog appears across several connections and threads`\n  - Fixtures: `A macOS login Keychain with several saved connections`\n\n**Acceptance mapping**\n\n| Criterion | Proving tests |\n| :--- | :--- |\n| `ac1` | `boot: a daemon start reads nothing from the Keychain and opens its socket`, `on-demand: the first management request opens the repository and a later one does not reopen it`, `on-demand: a refused Keychain read reports secret-unavailable and the next request retries` |\n| `ac2` | `vault: concurrent reads perform one Keychain read`, `threads: workers on two threads share one Keychain read`, `threads: a save on one worker is visible on another`, `live: after a node upgrade one dialog appears across several connections and threads` |\n| `ac3` | `consumers: notify, web and keys handlers read through the vault`, `maintenance: the offline binary reads the vault once` |\n| `ac4` | `migration: a legacy secret is copied once and read from the vault afterwards`, `migration: a failed copy returns the value and leaves the legacy item readable` |\n\n## 7. Migration\n\n**State before:** Each secret is its own Keychain item under service 'insrc', read through keytar on every use (s1 symbol.locate), and main() opens every repository's saved connections before server.listen (s1 usage.example).\n\n**State after:** One vault item under service 'insrc-vault' holds every secret and is read once per daemon run by the main thread; saved connections open on first use. Legacy items remain until an explicit delete.\n\n**Zero downtime:** no — **Data rewrite:** no\n\n**Steps**\n\n1. Ship the vault with the legacy fallback: a name absent from the vault and not retired is read from its legacy item and copied in on first use. — ↩ rollbackable\n2. Remove the boot loop and open saved connections on first request. — ↩ rollbackable\n3. Each legacy secret is copied into the vault the first time it is used, showing at most one dialog for that item, once in its lifetime; no legacy item is deleted by migration. — ↩ rollbackable\n4. Rollback if the vault must be abandoned: delete the single vault item, or run the previous daemon version; both read the untouched legacy items. Secrets first saved after migration exist only in the vault and must be re-entered. — ↩ rollbackable\n\n**Backward compat:** getKey, setKey, deleteKey and listKeys keep their signatures and the KeystoreLike port and test seam are unchanged. listKeys now reports vault names only, so a legacy item appears after first use; no in-repo client calls keys.list. A previous daemon version keeps reading legacy items and does not see the vault.\n\n## 8. Alternatives considered\n\n### 8.1 a1: One Keychain item holding every secret, owned by the main thread — **CHOSEN**\n\nA JSON map of all secrets lives in one Keychain item under a new service; the main thread loads it once on first need and serves every thread from memory.\n\ngetKey, setKey, deleteKey and listKeys keep their signatures but read and write a vault: one Keychain item (a new service, reserved account) whose value is a versioned JSON map of name to secret. The first read loads it once, single-flight, and later reads come from memory. On the main thread the vault lives in-process; on a worker the same functions forward over the worker's existing hub channel to it, so only one thread ever touches the Keychain. Writes update the item first and memory only after it succeeds, serialised so concurrent writes cannot lose an update. On a vault miss for a name not yet recorded, the legacy item is read once and copied in, and recorded as migrated; legacy items stay readable. The boot loop is removed and saved connections open on demand, as in the narrowed LLD.\n\n### 8.2 a2: One Keychain master key with secrets in an encrypted file\n\nThe Keychain holds only an AES key; secrets live in an AES-GCM file under ~/.insrc, so saving a secret never touches the Keychain after the first read.\n\nThe vault keeps the same read and write surface and the same main-thread ownership, but its single Keychain item holds a random 256-bit key. Secrets are stored in one AES-GCM encrypted file written atomically under ~/.insrc; the key is read once per run and writes only re-encrypt the file. Migration and on-demand opening are as in a1.\n\n**Rejected because:** Its only gain over a1 is no dialog on a save, at the cost of a partial on lossless migration and a new encrypted store on disk, a larger security decision than the issue asks for.\n\n### 8.3 a3: One Keychain item cached separately on each thread\n\nThe smallest change: the keystore module caches the single item in module scope, so each thread that needs a secret loads it for itself.\n\nThe keystore module holds the consolidated map in a module-level variable with no cross-thread forwarding. The main thread and each session worker load the item on their own first read and keep their own copy. Writes go to the Keychain and update only the writing thread's copy.\n\n**Rejected because:** Violates the one-prompt requirement: each thread does its own Keychain access and holds a stale copy after a write.\n\n## 9. References\n\n- **[[c1]]** `code` `src/shared/keystore.ts:10-40`\n- **[[c2]]** `code` `src/daemon/db/secrets.ts:26-44`\n- **[[c3]]** `code` `src/daemon/db/management-defaults.ts`\n- **[[c4]]** `code` `src/bin/insrc-connection-maintenance.ts:30`\n- **[[c5]]** `code` `src/daemon/threads/channel.ts:117`\n- **[[c6]]** `code` `src/daemon/index.ts:470-476`\n- **[[c7]]** `code` `src/daemon/threads/method-class.ts:142-160`\n- **[[c8]]** `prior-artifact` `ISSUE-fefa97b991537da7`\n- **[[c9]]** `prior-artifact` `LLD-669ae7a31701e106-S001`\n"},"capturedAt":"2026-11-08T12:27:09.235Z"},"inventory":{"units":[{"id":"/body/summary","selector":"/body/summary","title":"summary","kind":"section"},{"id":"/body/hldContextSlice","selector":"/body/hldContextSlice","title":"hldContextSlice","kind":"section"},{"id":"/body/contractDetails","selector":"/body/contractDetails","title":"contractDetails","kind":"section"},{"id":"/body/dataModelChanges","selector":"/body/dataModelChanges","title":"dataModelChanges","kind":"section"},{"id":"/body/interactionWithShared","selector":"/body/interactionWithShared","title":"interactionWithShared","kind":"section"},{"id":"/body/errorPaths","selector":"/body/errorPaths","title":"errorPaths","kind":"section"},{"id":"/body/testStrategy","selector":"/body/testStrategy","title":"testStrategy","kind":"section"},{"id":"/body/migration","selector":"/body/migration","title":"migration","kind":"section"},{"id":"/body/alternativesConsidered","selector":"/body/alternativesConsidered","title":"alternativesConsidered","kind":"section"},{"id":"/body/chosenAlternative","selector":"/body/chosenAlternative","title":"chosenAlternative","kind":"section"},{"id":"/body/openQuestions","selector":"/body/openQuestions","title":"openQuestions","kind":"section"},{"id":"/body/sequenceDefinition","selector":"/body/sequenceDefinition","title":"sequenceDefinition","kind":"visual"},{"id":"/body/companions","selector":"/body/companions","title":"companions","kind":"visual"},{"id":"/body/alternativesConsidered/0","selector":"/body/alternativesConsidered/0","title":"a1","kind":"requirement"},{"id":"/body/alternativesConsidered/1","selector":"/body/alternativesConsidered/1","title":"a2","kind":"requirement"},{"id":"/body/alternativesConsidered/2","selector":"/body/alternativesConsidered/2","title":"a3","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/0","selector":"/body/sequenceDefinition/participants/0","title":"client","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/1","selector":"/body/sequenceDefinition/participants/1","title":"worker","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/2","selector":"/body/sequenceDefinition/participants/2","title":"main","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/3","selector":"/body/sequenceDefinition/participants/3","title":"keychain","kind":"requirement"},{"id":"/citations/0","selector":"/citations/0","title":"Citation 1","kind":"citation"},{"id":"/citations/1","selector":"/citations/1","title":"Citation 2","kind":"citation"},{"id":"/citations/2","selector":"/citations/2","title":"Citation 3","kind":"citation"},{"id":"/citations/3","selector":"/citations/3","title":"Citation 4","kind":"citation"},{"id":"/citations/4","selector":"/citations/4","title":"Citation 5","kind":"citation"},{"id":"/citations/5","selector":"/citations/5","title":"Citation 6","kind":"citation"},{"id":"/citations/6","selector":"/citations/6","title":"Citation 7","kind":"citation"},{"id":"/citations/7","selector":"/citations/7","title":"Citation 8","kind":"citation"},{"id":"/citations/8","selector":"/citations/8","title":"Citation 9","kind":"citation"},{"id":"document:line:25","selector":"document:line:25","title":"1. HLD context","kind":"section"},{"id":"document:line:191","selector":"document:line:191","title":"4. Diagrams","kind":"section"}]},"completedChunks":[{"chunkId":"scope","status":"changes_requested","summary":"The standalone issue ancestry is correct, and the chosen main-thread vault addresses startup blocking and shared ownership. However, the design weakens the originating issue’s central one-prompt requirement without recording an approved exception.","findings":[{"id":"scope-001","severity":"HIGH","location":"/body/summary; /body/alternativesConsidered/0; /body/chosenAlternative","message":"Chosen alternative a1 does not satisfy the issue’s one-prompt requirement. With existing per-item secrets, each first use reads a separate legacy item and copies it into the vault, so the reproduced nine-item installation can still require multiple prompts during one daemon run. The design also explicitly permits further prompts on saves. ISSUE fix intent 2 requires the first secret request to fetch every saved secret in one access, with no further request prompting until restart. These exceptions are acknowledged as costs but are neither resolved nor recorded as open decisions; openQuestions is empty. The cited prior LLD deferred the vault entirely, and its scope split does not authorize weakening the full-scope replacement. Resolve the migration and mutation prompt behavior against the requirement, or obtain and capture an explicit scope exception before presenting a1 as satisfying it.","evidenceReferences":["docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/ISSUE.md — Expected behavior and Fix intent 2",".insrc/artifacts/LLD-fefa97b991537da7-s1.json — /body/alternativesConsidered/0/cons","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:11","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:284",".insrc/artifacts/LLD-fefa97b991537da7-s1.json — /body/openQuestions",".insrc/artifacts/LLD-669ae7a31701e106-S001.json — /body/hldContextSlice/boundary/internal and /body/openQuestions"]}],"inspectedReferences":["/body/summary","/body/hldContextSlice","document:line:25","/body/alternativesConsidered","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/alternativesConsidered/2","/body/chosenAlternative","/body/openQuestions","/citations/7","/citations/8","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/ISSUE.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-fefa97b991537da7-s1.json","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-669ae7a31701e106-S001.json","src/shared/keystore.ts","src/daemon/db/management-defaults.ts","src/daemon/handler-runtime.ts:1474","src/daemon/tools/config.ts","src/bin/insrc-connection-maintenance.ts"],"limitations":[],"advice":[]},{"chunkId":"vault","status":"changes_requested","summary":"The vault preserves existing function signatures and establishes clear main-thread ownership and service isolation. However, migration races, failed-copy state, runtime schema validation and rollback preservation need concrete contracts and corresponding tests.","findings":[{"id":"vault-001","severity":"MED","location":"/body/contractDetails; /body/errorPaths; /body/testStrategy","message":"Migration lacks an ordering rule against saves and deletes. A getKey can observe a vault miss, await a legacy read, then copy an old value after setKey has saved a replacement or deleteKey has retired the name. Serializing Keychain writes alone does not prevent that stale copy from overwriting the replacement or resurrecting a deletion. Specify a shared mutation boundary with a fresh value/retirement check before committing migration, plus per-name single-flight behavior for simultaneous misses. Add interleaving tests for migration versus save/delete and concurrent migration copies; the current concurrent-saves test does not establish these guarantees.","evidenceReferences":["LLD.md §2.1: legacy fallback after a vault miss","LLD.md §2.2–2.3: serialization specified for saves and deletes","LLD.md §6: concurrent saves tested, migration/mutation interleavings omitted","src/daemon/db/secrets.ts: CredentialGenerations.stageSnapshot and recover use getKey, setKey and deleteKey for credential lifecycle operations","ISSUE.md: Fix intent 2 requires mutations to keep memory and Keychain consistent"]},{"id":"vault-002","severity":"MED","location":"/body/contractDetails/api/0; /body/errorPaths; /body/testStrategy","message":"The failed-copy behavior does not define how subsequent reads remain usable. getKey permits only one legacy lookup per name per run, while a failed copy returns the legacy value only 'for this request', leaves the name unmigrated and retries copying on a later run. No transient value cache is specified. Following those rules, a second read has neither a persisted vault value nor permission to read the legacy item again. Define separate per-name states for cached legacy values, true absence and lookup failure, including how set/delete invalidate them and whether later reads repeat a cached error or retry. Test repeated reads after failed copies and failed legacy reads, rather than only the initial request.","evidenceReferences":["LLD.md §2.1: a name not yet looked up this run is read once","LLD.md §5: failed migration copy returns the value for this request and retries on a later run","LLD.md §5: absent names are remembered for the run","LLD.md §5: refused legacy reads raise KeystoreUnavailableError","LLD.md §6: migration failure test subjects"]},{"id":"vault-003","severity":"MED","location":"/body/dataModelChanges/0; /body/errorPaths; /body/testStrategy","message":"Fail-closed validation covers JSON parsing and version checks but does not require validating the version-1 payload's shape. Valid JSON such as a version-1 item with non-string secret values, a missing secrets map or a non-array retired field passes those stated checks. Subsequent reads can violate Promise<string|null>, and mutations can fail unexpectedly or rewrite damaged content despite the preservation promise. Specify runtime validation of the complete payload, own-property lookup for arbitrary account names, and a policy for names present in both secrets and retired. Add malformed-but-parseable version-1 fixtures and assert that no mutation rewrites them.","evidenceReferences":["LLD.md §3.1: SecretVaultItem schema and fail-closed preservation promise","LLD.md §5: corruption detection names JSON parsing and version checking","LLD.md §6: only an unparseable-item test is specified","src/shared/keystore.ts: getKey accepts arbitrary string account names and returns string or null","src/daemon/tools/builtins/notify/index.ts: resolveSecretRef consumes string-valued getKey results"]},{"id":"vault-004","severity":"MED","location":"/body/dataModelChanges/3; /body/migration/migrationSteps/3","message":"The rollback instructions omit loss of post-migration changes to existing secrets and resurrection of deleted secrets. After an existing secret is copied, setKey updates only the vault, so deleting the vault or running the previous daemon restores its stale legacy value. If best-effort legacy deletion failed, abandoning the vault also removes the retirement record and restores a secret the user deleted. The documented caveat addresses only newly created secrets, yet every migration step is marked rollbackable. Define a preservation-aware rollback procedure or explicitly document these additional losses and deletion reversals; test existing unchanged, modified, deleted and newly created names.","evidenceReferences":["LLD.md §2.2: setKey writes the vault","LLD.md §2.3: legacy deletion is best effort","LLD.md §3.4: legacy items cease being authoritative after copying","LLD.md §7 step 4: rollback by deleting the vault or running the previous version; caveat only for newly saved secrets","ISSUE.md: Fix intent 4 requires migration without loss"]}],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/body/errorPaths","/body/testStrategy","/body/migration","/citations/0","/citations/1","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-fefa97b991537da7-s1.json","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/ISSUE.md","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/rv-fefa97b991537da7-s1.json","src/shared/keystore.ts","src/daemon/db/secrets.ts","src/daemon/handler-runtime.ts:1474","src/daemon/tools/config.ts","src/daemon/tools/builtins/notify/index.ts","src/daemon/tools/builtins/web/index.ts","src/bin/insrc-connection-maintenance.ts","src/daemon/threads/channel.ts","src/daemon/threads/main-services.ts","src/daemon/threads/worker-entry.ts"],"limitations":[],"advice":["Add explicit listKeys compatibility tests for unmigrated, migrated, retired and restored names. Its reduced enumeration behavior is documented, but the proposed test checks only that findCredentials is not called.","The scope chunk already records the one-prompt requirement mismatch. Migration step 3's 'once in its lifetime' wording should also be qualified for failed reads or copies, which the error paths allow to prompt again on later runs."]},{"chunkId":"runtime","status":"changes_requested","summary":"Removing the boot loop and retaining the per-root owner memo and shutdown hook fits the current daemon routing. However, exclusive vault ownership is not established across offline maintenance and daemon restart, and the proposed integration fixture bypasses the behavior it must verify.","findings":[{"id":"runtime-001","severity":"HIGH","location":"/body/dataModelChanges/1; /body/errorPaths/edgeCases","message":"The offline binary's exclusive ownership assumption is not enforced for its lifetime. It checks PID/socket absence only at admission, while adoption verifies only that the previous daemon exited and takes a repository-specific lease. A new daemon can start while maintenance waits for Keychain access, then update secrets for another repository or through keys.set. Both processes can hold independent snapshots of the same global vault; a subsequent whole-item write can erase the other process's changes. Specify process-wide exclusion covering maintenance admission through its final vault operation and daemon startup, including simultaneous maintenance processes, and test restart/write interleavings.","evidenceReferences":["LLD.md §3.2: offline maintenance owns an in-process vault while the daemon is stopped","src/bin/insrc-connection-maintenance.ts:15-32 — one-time PID/socket checks followed by adoption","src/daemon/db/management-adoption.ts:27-28 — checks previous daemon identity/liveness","src/daemon/db/management-adoption.ts:53 — repository-specific owner lease","src/cli/services/connection-maintenance.ts:26-39 — stops the previous daemon without holding a lifetime exclusion guard","src/daemon/index.ts:108-115 — startup uses daemonRunFiles.lease","src/daemon/run-file-ownership.ts — existing cross-process startup/publication guard","ISSUE.md — Fix intent 2 requires mutations to keep memory and Keychain consistent"]},{"id":"runtime-002","severity":"MED","location":"/body/testStrategy/testLevels/1","message":"The listed _setKeystoreForTests fixture cannot establish the promised integration coverage. It replaces the database credential port above shared/keystore, bypassing the vault entirely; notify, web and keys handlers import shared/keystore directly and are unaffected. Its module-local replacement also does not propagate into workers or the spawned maintenance process. Specify how the counting/refusing fake backend is injected below the vault in the actual owner process, how worker and maintenance tests receive it, and how tests detect accidental worker-local Keychain access. Otherwise the proposed tests can either bypass the new implementation or reach the real Keychain.","evidenceReferences":["LLD.md §6 — integration tests promise real daemon wiring with a fake backend and list _setKeystoreForTests as the seam","src/daemon/db/secrets.ts:25-42 — mutable database-only KeystoreLike replacement","src/shared/keystore.ts:8-38 — direct keytar calls without a backend injection seam","src/daemon/tools/builtins/notify/index.ts:18-32 — direct shared keystore import","src/daemon/tools/builtins/web/index.ts:16,68 — direct shared keystore import","src/daemon/handler-runtime.ts:1474-1503 — keys handlers import shared keystore directly","src/daemon/threads/worker-entry.ts — module state is per worker","src/cli/services/connection-maintenance.ts:53-54 — maintenance runs as a separate process"]}],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/body/interactionWithShared","/body/errorPaths","/body/testStrategy","/citations/0","/citations/2","/citations/3","/citations/4","/citations/5","/citations/6","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-fefa97b991537da7-s1.json","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/ISSUE.md","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/rv-fefa97b991537da7-s1.json",".insrc/artifacts/LLD-669ae7a31701e106-S001.json","src/shared/keystore.ts","src/daemon/db/management-defaults.ts","src/daemon/db/management-startup.ts","src/daemon/db/management-tickets.ts","src/daemon/db/management.ts","src/daemon/db/secrets.ts","src/daemon/db/pool-cache.ts","src/daemon/db/management-adoption.ts","src/daemon/db/__tests__/management-defaults.test.ts","src/daemon/connection-management-rpc.ts","src/daemon/db-rpc.ts","src/daemon/index.ts","src/daemon/handler-runtime.ts","src/daemon/threads/channel.ts","src/daemon/threads/main-services.ts","src/daemon/threads/worker-entry.ts","src/daemon/threads/session-worker.ts","src/daemon/threads/method-class.ts","src/daemon/threads/router.ts","src/daemon/tools/config.ts","src/daemon/tools/builtins/notify/index.ts","src/daemon/tools/builtins/web/index.ts","src/bin/insrc-connection-maintenance.ts","src/cli/services/connection-maintenance.ts","src/daemon/run-file-ownership.ts"],"limitations":[],"advice":["Expand the integration matrix to exercise owner, safeList, legacy listing and save independently, plus unrelated-request progress while a secret read is held and isolation between repositories. A generic first-management-request test can pass through capabilities while missing another entry point.","State the hub operation payload/results and error reconstruction explicitly. The existing channel transports error name/message as HubRemoteError and drops cause; the forwarder must deliberately restore the promised KeystoreUnavailableError behavior.","Clarify that an immediate request after denial retries the repository opener but receives the cached vault failure; only a request after the five-minute cooldown retries Keychain access."]},{"chunkId":"visuals","status":"incomplete","summary":"Inspected every assigned selector and the generated companion source. Participant responsibilities and descriptions are retained, but the sequence overstates the cached-read guarantee during migration. Actual rendering could not be verified.","findings":[{"id":"visuals-001","severity":"MED","location":"/body/sequenceDefinition/narrative; /body/sequenceDefinition/messages/2-5","message":"The sequence presents an unconditional first read returning 'all secrets' and every subsequent getKey avoiding Keychain access. The specified legacy fallback contradicts this flow: a missing vault starts empty, and each previously unused legacy name requires another Keychain read and potentially a migration write. This is especially relevant to the originating issue's existing multi-item installation. Qualify the illustrated path as an existing, fully populated vault and show or describe the missing-vault/legacy-name branch, including owner-only access and when subsequent reads actually become cached.","evidenceReferences":[".insrc/artifacts/LLD-fefa97b991537da7-s1.json: body.sequenceDefinition narrative and messages","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/sequence-diagram.html: embedded Mermaid and Messages description table","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:53 — legacy lookup on an uncached name","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:232 — missing vault starts empty","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:284-286 — per-name migration","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/ISSUE.md: Reproduction and Fix intent 2"]}],"inspectedReferences":["/body/sequenceDefinition","/body/sequenceDefinition/participants/0","/body/sequenceDefinition/participants/1","/body/sequenceDefinition/participants/2","/body/sequenceDefinition/participants/3","/body/companions","document:line:191","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-fefa97b991537da7-s1.json","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/ISSUE.md","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/sequence-diagram.html","src/shared/keystore.ts","src/daemon/db/management-defaults.ts","src/daemon/db/management-startup.ts","src/daemon/threads/worker-entry.ts"],"limitations":["Mandatory actual rendering verification of docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/sequence-diagram.html could not be completed: opening the local companion through the browser tool returned 'The browser access host is unavailable'. Source inspection confirmed the embedded sequence and retained descriptions, but does not establish successful rendering or visual readability."],"advice":["Extend the sequence to show the main-thread saved-management request invoking ensureDefaultManagedRoot after socket startup. The existing worker flow explains hub ownership, while this additional path would clarify the on-demand repository initialization boundary described in §2.5."]},{"chunkId":"consistency","status":"incomplete","summary":"Completed whole-artifact reconciliation against the originating ISSUE, cited prior LLD, canonical definitions, companion source and all four completed reviews. Existing findings cover the demonstrated blocking defects; no additional distinct finding is necessary. Mandatory diagram rendering verification remains incomplete.","findings":[],"inspectedReferences":["/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/rv-fefa97b991537da7-s1.json","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-fefa97b991537da7-s1.json","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/ISSUE.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-669ae7a31701e106-S001.json","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/sequence-diagram.html","src/shared/keystore.ts","src/daemon/db/management-defaults.ts"],"limitations":["Mandatory actual rendering verification of /Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/sequence-diagram.html remains outstanding. The completed visuals review records that browser access failed because the browser access host was unavailable. This consistency check inspected the embedded Mermaid and description tables, but cannot establish successful rendering or visual readability."],"advice":["Resolve scope-001 and visuals-001 together: the summary, selected alternative, migration text and sequence must express the same approved prompt guarantee. Per-name migration and mutation writes contradict the ISSUE's unconditional one-prompt behavior; the earlier narrowed LLD does not authorize that exception in this full-scope replacement.","Preserve the distinction noted by the runtime review: an immediate request after denial retries ensureDefaultManagedRoot but encounters the cached vault failure; Keychain access retries only after five minutes. State both phases explicitly in the integration test and acceptance mapping. The current unit cooldown test and repository retry contract can coexist.","Carry vault-001 through vault-004 and runtime-001 through runtime-002 into the final assessment without duplicating them. Together they identify missing migration ordering/state rules, corruption validation, rollback preservation, cross-process exclusion and a viable integration backend seam.","The generated companion retains the canonical sequence messages and descriptions; its misleading unconditional cached-read flow originates in the authored definition, as already recorded by visuals-001. Correcting only the HTML would leave the source inconsistent."]}],"progress":{"status":"incomplete","phase":"complete","completedChunks":5,"totalChunks":5,"lastMeaningfulActivityAt":null,"activeToolCount":0,"requiresUserInput":false,"checkpointPath":"/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/rv-fefa97b991537da7-s1.json","sequence":0,"reviewElapsedMs":0,"unitElapsedMs":null,"observedAt":"2026-11-08T12:34:50.102Z","freshness":"stored"},"startedAt":"2026-11-08T12:27:09.237Z","reviewer":"daemon","model":"gpt-6.1-sol","unit":{"unitId":"consistency","phase":"chunk_review","executionId":"b270e25e-10c3-4e23-a179-b51894ef8f1e","dispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[]},"plan":{"chunks":[{"id":"scope","title":"Issue requirements, scope and architectural choice","selectors":["/body/summary","/body/hldContextSlice","document:line:25","/body/alternativesConsidered","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/alternativesConsidered/2","/body/chosenAlternative","/body/openQuestions","/citations/7","/citations/8"],"concerns":["Compare the current LLD with the originating ISSUE reproduction, root causes and four fix intents; establish actual standalone issue ancestry without requiring Epic or HLD artifacts.","Check scope, non-goals and the selected alternative against the one-prompt requirement, on-demand opening, consumer coverage and lossless migration.","Inspect the cited prior LLD for applicable retained constraints and distinguish inherited requirements from superseded choices.","Assess unresolved decisions and consistency between summary, context, alternatives and chosen design."],"dependsOn":[],"purpose":"substantive"},{"id":"vault","title":"Vault contracts, mutation consistency and legacy migration","selectors":["/body/contractDetails","/body/dataModelChanges","/body/errorPaths","/body/testStrategy","/body/migration","/citations/0","/citations/1"],"concerns":["Inspect getKey, setKey, deleteKey and listKeys contracts against the actual keystore interface and connection-secret consumers.","Assess vault schema validation, reserved service isolation, ownership, single-flight loading, denial cooldown and fail-closed behavior.","Check serialization across saves, deletes and migration copies, including concurrent reads, missing names, retirement, failed writes and failed legacy reads or copies.","Evaluate migration preservation and rollback claims for existing, modified, deleted and newly created secrets, including prompt-count qualifications and listKeys compatibility.","Assess unit tests and acceptance mappings for the specified vault and migration behavior."],"dependsOn":["scope"],"purpose":"substantive"},{"id":"runtime","title":"On-demand repository lifecycle and shared thread ownership","selectors":["/body/contractDetails","/body/dataModelChanges","/body/interactionWithShared","/body/errorPaths","/body/testStrategy","/citations/0","/citations/2","/citations/3","/citations/4","/citations/5","/citations/6"],"concerns":["Trace removal of boot-time initialization and every required first-use entry point against actual daemon handlers, management initialization and shutdown wiring.","Inspect ensureDefaultManagedRoot memoization, retry behavior, integrity checks, error-cause mapping and ticket acquisition before disk writes.","Check the hub operation contract, main-thread ownership, worker forwarder installation order, channel failure behavior and operation with threads disabled.","Verify consumer coverage for keys handlers, tool configuration, notify, web and the offline maintenance binary, including the daemon-stopped ownership assumption.","Assess repository isolation and whether requests unrelated to secrets can proceed while secret access waits.","Assess integration tests, test seams and acceptance mappings for startup, first use, consumers and thread forwarding."],"dependsOn":["vault"],"purpose":"substantive"},{"id":"visuals","title":"Sequence definition and generated companion verification","selectors":["/body/sequenceDefinition","/body/sequenceDefinition/participants/0","/body/sequenceDefinition/participants/1","/body/sequenceDefinition/participants/2","/body/sequenceDefinition/participants/3","/body/companions","document:line:191"],"concerns":["Inspect the authored sequence definition, participant responsibilities and generated sequence-diagram.html companion.","Inspect actual rendering where available and explicitly record any mandatory rendering verification that cannot be completed.","Compare messages and ordering with the vault and runtime contracts, including lazy initialization, owner-only Keychain access and subsequent cached reads.","Assess whether the supplied visuals adequately explain relevant interaction boundaries and retain source and element descriptions."],"dependsOn":["vault","runtime"],"purpose":"substantive"},{"id":"consistency","title":"Whole-artifact requirements and contract consistency","selectors":[],"concerns":["Reconcile all substantive assessments against the actual originating ISSUE and applicable cited upstream design.","Check missing requirements, cross-section contradictions, shared contracts, ownership and dependency feasibility.","Reconcile one-prompt claims with migration, cooldown retries and writes; reconcile retry tests with specified failure caching.","Confirm acceptance coverage and consistency among prose, canonical definitions, generated companions and repository conventions.","Preserve verification limitations separately from demonstrated defects and apply the required final status precedence."],"dependsOn":["scope","vault","runtime","visuals"],"purpose":"consistency"}],"coverageExplanation":"Every inventory unit is assigned to at least one substantive chunk. Shared contract, data-model, error and test sections are assigned to both vault and runtime reviewers so each responsibility retains its interfaces, logic, failure handling and verification. Visual definitions and companions receive a dedicated substantive inspection after their behavioral dependencies. The final consistency chunk depends on every substantive chunk and does not substitute for unit coverage.","finalConsistencyChunkId":"consistency","coverage":[{"unitId":"/body/summary","chunkIds":["scope"]},{"unitId":"/body/hldContextSlice","chunkIds":["scope"]},{"unitId":"/body/contractDetails","chunkIds":["vault","runtime"]},{"unitId":"/body/dataModelChanges","chunkIds":["vault","runtime"]},{"unitId":"/body/interactionWithShared","chunkIds":["runtime"]},{"unitId":"/body/errorPaths","chunkIds":["vault","runtime"]},{"unitId":"/body/testStrategy","chunkIds":["vault","runtime"]},{"unitId":"/body/migration","chunkIds":["vault"]},{"unitId":"/body/alternativesConsidered","chunkIds":["scope"]},{"unitId":"/body/chosenAlternative","chunkIds":["scope"]},{"unitId":"/body/openQuestions","chunkIds":["scope"]},{"unitId":"/body/sequenceDefinition","chunkIds":["visuals"]},{"unitId":"/body/companions","chunkIds":["visuals"]},{"unitId":"/body/alternativesConsidered/0","chunkIds":["scope"]},{"unitId":"/body/alternativesConsidered/1","chunkIds":["scope"]},{"unitId":"/body/alternativesConsidered/2","chunkIds":["scope"]},{"unitId":"/body/sequenceDefinition/participants/0","chunkIds":["visuals"]},{"unitId":"/body/sequenceDefinition/participants/1","chunkIds":["visuals"]},{"unitId":"/body/sequenceDefinition/participants/2","chunkIds":["visuals"]},{"unitId":"/body/sequenceDefinition/participants/3","chunkIds":["visuals"]},{"unitId":"/citations/0","chunkIds":["vault","runtime"]},{"unitId":"/citations/1","chunkIds":["vault"]},{"unitId":"/citations/2","chunkIds":["runtime"]},{"unitId":"/citations/3","chunkIds":["runtime"]},{"unitId":"/citations/4","chunkIds":["runtime"]},{"unitId":"/citations/5","chunkIds":["runtime"]},{"unitId":"/citations/6","chunkIds":["runtime"]},{"unitId":"/citations/7","chunkIds":["scope"]},{"unitId":"/citations/8","chunkIds":["scope"]},{"unitId":"document:line:25","chunkIds":["scope"]},{"unitId":"document:line:191","chunkIds":["visuals"]}]},"unitSummaries":[{"unitId":"planning","phase":"planning","automaticDispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[],"actionIds":[]},{"unitId":"scope","phase":"chunk_review","automaticDispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[],"actionIds":[]},{"unitId":"vault","phase":"chunk_review","automaticDispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[],"actionIds":[]},{"unitId":"runtime","phase":"chunk_review","automaticDispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[],"actionIds":[]},{"unitId":"visuals","phase":"chunk_review","automaticDispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[],"actionIds":[]},{"unitId":"consistency","phase":"chunk_review","automaticDispatches":1,"retriesUsed":0,"userDirectedDispatches":0,"diagnostics":[],"actionIds":[]}],"report":{"reviewId":"rv-fefa97b991537da7-s1","attempt":1,"artifactId":"LLD-fefa97b991537da7-s1","status":"incomplete","counts":{"HIGH":2,"MED":6,"LOW":0},"chunks":[{"chunkId":"scope","status":"changes_requested","summary":"The standalone issue ancestry is correct, and the chosen main-thread vault addresses startup blocking and shared ownership. However, the design weakens the originating issue’s central one-prompt requirement without recording an approved exception.","findings":[{"id":"scope-001","severity":"HIGH","location":"/body/summary; /body/alternativesConsidered/0; /body/chosenAlternative","message":"Chosen alternative a1 does not satisfy the issue’s one-prompt requirement. With existing per-item secrets, each first use reads a separate legacy item and copies it into the vault, so the reproduced nine-item installation can still require multiple prompts during one daemon run. The design also explicitly permits further prompts on saves. ISSUE fix intent 2 requires the first secret request to fetch every saved secret in one access, with no further request prompting until restart. These exceptions are acknowledged as costs but are neither resolved nor recorded as open decisions; openQuestions is empty. The cited prior LLD deferred the vault entirely, and its scope split does not authorize weakening the full-scope replacement. Resolve the migration and mutation prompt behavior against the requirement, or obtain and capture an explicit scope exception before presenting a1 as satisfying it.","evidenceReferences":["docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/ISSUE.md — Expected behavior and Fix intent 2",".insrc/artifacts/LLD-fefa97b991537da7-s1.json — /body/alternativesConsidered/0/cons","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:11","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:284",".insrc/artifacts/LLD-fefa97b991537da7-s1.json — /body/openQuestions",".insrc/artifacts/LLD-669ae7a31701e106-S001.json — /body/hldContextSlice/boundary/internal and /body/openQuestions"]}],"inspectedReferences":["/body/summary","/body/hldContextSlice","document:line:25","/body/alternativesConsidered","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/alternativesConsidered/2","/body/chosenAlternative","/body/openQuestions","/citations/7","/citations/8","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/ISSUE.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-fefa97b991537da7-s1.json","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-669ae7a31701e106-S001.json","src/shared/keystore.ts","src/daemon/db/management-defaults.ts","src/daemon/handler-runtime.ts:1474","src/daemon/tools/config.ts","src/bin/insrc-connection-maintenance.ts"],"limitations":[],"advice":[]},{"chunkId":"vault","status":"changes_requested","summary":"The vault preserves existing function signatures and establishes clear main-thread ownership and service isolation. However, migration races, failed-copy state, runtime schema validation and rollback preservation need concrete contracts and corresponding tests.","findings":[{"id":"vault-001","severity":"MED","location":"/body/contractDetails; /body/errorPaths; /body/testStrategy","message":"Migration lacks an ordering rule against saves and deletes. A getKey can observe a vault miss, await a legacy read, then copy an old value after setKey has saved a replacement or deleteKey has retired the name. Serializing Keychain writes alone does not prevent that stale copy from overwriting the replacement or resurrecting a deletion. Specify a shared mutation boundary with a fresh value/retirement check before committing migration, plus per-name single-flight behavior for simultaneous misses. Add interleaving tests for migration versus save/delete and concurrent migration copies; the current concurrent-saves test does not establish these guarantees.","evidenceReferences":["LLD.md §2.1: legacy fallback after a vault miss","LLD.md §2.2–2.3: serialization specified for saves and deletes","LLD.md §6: concurrent saves tested, migration/mutation interleavings omitted","src/daemon/db/secrets.ts: CredentialGenerations.stageSnapshot and recover use getKey, setKey and deleteKey for credential lifecycle operations","ISSUE.md: Fix intent 2 requires mutations to keep memory and Keychain consistent"]},{"id":"vault-002","severity":"MED","location":"/body/contractDetails/api/0; /body/errorPaths; /body/testStrategy","message":"The failed-copy behavior does not define how subsequent reads remain usable. getKey permits only one legacy lookup per name per run, while a failed copy returns the legacy value only 'for this request', leaves the name unmigrated and retries copying on a later run. No transient value cache is specified. Following those rules, a second read has neither a persisted vault value nor permission to read the legacy item again. Define separate per-name states for cached legacy values, true absence and lookup failure, including how set/delete invalidate them and whether later reads repeat a cached error or retry. Test repeated reads after failed copies and failed legacy reads, rather than only the initial request.","evidenceReferences":["LLD.md §2.1: a name not yet looked up this run is read once","LLD.md §5: failed migration copy returns the value for this request and retries on a later run","LLD.md §5: absent names are remembered for the run","LLD.md §5: refused legacy reads raise KeystoreUnavailableError","LLD.md §6: migration failure test subjects"]},{"id":"vault-003","severity":"MED","location":"/body/dataModelChanges/0; /body/errorPaths; /body/testStrategy","message":"Fail-closed validation covers JSON parsing and version checks but does not require validating the version-1 payload's shape. Valid JSON such as a version-1 item with non-string secret values, a missing secrets map or a non-array retired field passes those stated checks. Subsequent reads can violate Promise<string|null>, and mutations can fail unexpectedly or rewrite damaged content despite the preservation promise. Specify runtime validation of the complete payload, own-property lookup for arbitrary account names, and a policy for names present in both secrets and retired. Add malformed-but-parseable version-1 fixtures and assert that no mutation rewrites them.","evidenceReferences":["LLD.md §3.1: SecretVaultItem schema and fail-closed preservation promise","LLD.md §5: corruption detection names JSON parsing and version checking","LLD.md §6: only an unparseable-item test is specified","src/shared/keystore.ts: getKey accepts arbitrary string account names and returns string or null","src/daemon/tools/builtins/notify/index.ts: resolveSecretRef consumes string-valued getKey results"]},{"id":"vault-004","severity":"MED","location":"/body/dataModelChanges/3; /body/migration/migrationSteps/3","message":"The rollback instructions omit loss of post-migration changes to existing secrets and resurrection of deleted secrets. After an existing secret is copied, setKey updates only the vault, so deleting the vault or running the previous daemon restores its stale legacy value. If best-effort legacy deletion failed, abandoning the vault also removes the retirement record and restores a secret the user deleted. The documented caveat addresses only newly created secrets, yet every migration step is marked rollbackable. Define a preservation-aware rollback procedure or explicitly document these additional losses and deletion reversals; test existing unchanged, modified, deleted and newly created names.","evidenceReferences":["LLD.md §2.2: setKey writes the vault","LLD.md §2.3: legacy deletion is best effort","LLD.md §3.4: legacy items cease being authoritative after copying","LLD.md §7 step 4: rollback by deleting the vault or running the previous version; caveat only for newly saved secrets","ISSUE.md: Fix intent 4 requires migration without loss"]}],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/body/errorPaths","/body/testStrategy","/body/migration","/citations/0","/citations/1","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-fefa97b991537da7-s1.json","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/ISSUE.md","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/rv-fefa97b991537da7-s1.json","src/shared/keystore.ts","src/daemon/db/secrets.ts","src/daemon/handler-runtime.ts:1474","src/daemon/tools/config.ts","src/daemon/tools/builtins/notify/index.ts","src/daemon/tools/builtins/web/index.ts","src/bin/insrc-connection-maintenance.ts","src/daemon/threads/channel.ts","src/daemon/threads/main-services.ts","src/daemon/threads/worker-entry.ts"],"limitations":[],"advice":["Add explicit listKeys compatibility tests for unmigrated, migrated, retired and restored names. Its reduced enumeration behavior is documented, but the proposed test checks only that findCredentials is not called.","The scope chunk already records the one-prompt requirement mismatch. Migration step 3's 'once in its lifetime' wording should also be qualified for failed reads or copies, which the error paths allow to prompt again on later runs."]},{"chunkId":"runtime","status":"changes_requested","summary":"Removing the boot loop and retaining the per-root owner memo and shutdown hook fits the current daemon routing. However, exclusive vault ownership is not established across offline maintenance and daemon restart, and the proposed integration fixture bypasses the behavior it must verify.","findings":[{"id":"runtime-001","severity":"HIGH","location":"/body/dataModelChanges/1; /body/errorPaths/edgeCases","message":"The offline binary's exclusive ownership assumption is not enforced for its lifetime. It checks PID/socket absence only at admission, while adoption verifies only that the previous daemon exited and takes a repository-specific lease. A new daemon can start while maintenance waits for Keychain access, then update secrets for another repository or through keys.set. Both processes can hold independent snapshots of the same global vault; a subsequent whole-item write can erase the other process's changes. Specify process-wide exclusion covering maintenance admission through its final vault operation and daemon startup, including simultaneous maintenance processes, and test restart/write interleavings.","evidenceReferences":["LLD.md §3.2: offline maintenance owns an in-process vault while the daemon is stopped","src/bin/insrc-connection-maintenance.ts:15-32 — one-time PID/socket checks followed by adoption","src/daemon/db/management-adoption.ts:27-28 — checks previous daemon identity/liveness","src/daemon/db/management-adoption.ts:53 — repository-specific owner lease","src/cli/services/connection-maintenance.ts:26-39 — stops the previous daemon without holding a lifetime exclusion guard","src/daemon/index.ts:108-115 — startup uses daemonRunFiles.lease","src/daemon/run-file-ownership.ts — existing cross-process startup/publication guard","ISSUE.md — Fix intent 2 requires mutations to keep memory and Keychain consistent"]},{"id":"runtime-002","severity":"MED","location":"/body/testStrategy/testLevels/1","message":"The listed _setKeystoreForTests fixture cannot establish the promised integration coverage. It replaces the database credential port above shared/keystore, bypassing the vault entirely; notify, web and keys handlers import shared/keystore directly and are unaffected. Its module-local replacement also does not propagate into workers or the spawned maintenance process. Specify how the counting/refusing fake backend is injected below the vault in the actual owner process, how worker and maintenance tests receive it, and how tests detect accidental worker-local Keychain access. Otherwise the proposed tests can either bypass the new implementation or reach the real Keychain.","evidenceReferences":["LLD.md §6 — integration tests promise real daemon wiring with a fake backend and list _setKeystoreForTests as the seam","src/daemon/db/secrets.ts:25-42 — mutable database-only KeystoreLike replacement","src/shared/keystore.ts:8-38 — direct keytar calls without a backend injection seam","src/daemon/tools/builtins/notify/index.ts:18-32 — direct shared keystore import","src/daemon/tools/builtins/web/index.ts:16,68 — direct shared keystore import","src/daemon/handler-runtime.ts:1474-1503 — keys handlers import shared keystore directly","src/daemon/threads/worker-entry.ts — module state is per worker","src/cli/services/connection-maintenance.ts:53-54 — maintenance runs as a separate process"]}],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/body/interactionWithShared","/body/errorPaths","/body/testStrategy","/citations/0","/citations/2","/citations/3","/citations/4","/citations/5","/citations/6","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-fefa97b991537da7-s1.json","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/ISSUE.md","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/rv-fefa97b991537da7-s1.json",".insrc/artifacts/LLD-669ae7a31701e106-S001.json","src/shared/keystore.ts","src/daemon/db/management-defaults.ts","src/daemon/db/management-startup.ts","src/daemon/db/management-tickets.ts","src/daemon/db/management.ts","src/daemon/db/secrets.ts","src/daemon/db/pool-cache.ts","src/daemon/db/management-adoption.ts","src/daemon/db/__tests__/management-defaults.test.ts","src/daemon/connection-management-rpc.ts","src/daemon/db-rpc.ts","src/daemon/index.ts","src/daemon/handler-runtime.ts","src/daemon/threads/channel.ts","src/daemon/threads/main-services.ts","src/daemon/threads/worker-entry.ts","src/daemon/threads/session-worker.ts","src/daemon/threads/method-class.ts","src/daemon/threads/router.ts","src/daemon/tools/config.ts","src/daemon/tools/builtins/notify/index.ts","src/daemon/tools/builtins/web/index.ts","src/bin/insrc-connection-maintenance.ts","src/cli/services/connection-maintenance.ts","src/daemon/run-file-ownership.ts"],"limitations":[],"advice":["Expand the integration matrix to exercise owner, safeList, legacy listing and save independently, plus unrelated-request progress while a secret read is held and isolation between repositories. A generic first-management-request test can pass through capabilities while missing another entry point.","State the hub operation payload/results and error reconstruction explicitly. The existing channel transports error name/message as HubRemoteError and drops cause; the forwarder must deliberately restore the promised KeystoreUnavailableError behavior.","Clarify that an immediate request after denial retries the repository opener but receives the cached vault failure; only a request after the five-minute cooldown retries Keychain access."]},{"chunkId":"visuals","status":"incomplete","summary":"Inspected every assigned selector and the generated companion source. Participant responsibilities and descriptions are retained, but the sequence overstates the cached-read guarantee during migration. Actual rendering could not be verified.","findings":[{"id":"visuals-001","severity":"MED","location":"/body/sequenceDefinition/narrative; /body/sequenceDefinition/messages/2-5","message":"The sequence presents an unconditional first read returning 'all secrets' and every subsequent getKey avoiding Keychain access. The specified legacy fallback contradicts this flow: a missing vault starts empty, and each previously unused legacy name requires another Keychain read and potentially a migration write. This is especially relevant to the originating issue's existing multi-item installation. Qualify the illustrated path as an existing, fully populated vault and show or describe the missing-vault/legacy-name branch, including owner-only access and when subsequent reads actually become cached.","evidenceReferences":[".insrc/artifacts/LLD-fefa97b991537da7-s1.json: body.sequenceDefinition narrative and messages","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/sequence-diagram.html: embedded Mermaid and Messages description table","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:53 — legacy lookup on an uncached name","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:232 — missing vault starts empty","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:284-286 — per-name migration","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/ISSUE.md: Reproduction and Fix intent 2"]}],"inspectedReferences":["/body/sequenceDefinition","/body/sequenceDefinition/participants/0","/body/sequenceDefinition/participants/1","/body/sequenceDefinition/participants/2","/body/sequenceDefinition/participants/3","/body/companions","document:line:191","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-fefa97b991537da7-s1.json","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/ISSUE.md","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/sequence-diagram.html","src/shared/keystore.ts","src/daemon/db/management-defaults.ts","src/daemon/db/management-startup.ts","src/daemon/threads/worker-entry.ts"],"limitations":["Mandatory actual rendering verification of docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/sequence-diagram.html could not be completed: opening the local companion through the browser tool returned 'The browser access host is unavailable'. Source inspection confirmed the embedded sequence and retained descriptions, but does not establish successful rendering or visual readability."],"advice":["Extend the sequence to show the main-thread saved-management request invoking ensureDefaultManagedRoot after socket startup. The existing worker flow explains hub ownership, while this additional path would clarify the on-demand repository initialization boundary described in §2.5."]},{"chunkId":"consistency","status":"incomplete","summary":"Completed whole-artifact reconciliation against the originating ISSUE, cited prior LLD, canonical definitions, companion source and all four completed reviews. Existing findings cover the demonstrated blocking defects; no additional distinct finding is necessary. Mandatory diagram rendering verification remains incomplete.","findings":[],"inspectedReferences":["/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/rv-fefa97b991537da7-s1.json","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-fefa97b991537da7-s1.json","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/ISSUE.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-669ae7a31701e106-S001.json","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/sequence-diagram.html","src/shared/keystore.ts","src/daemon/db/management-defaults.ts"],"limitations":["Mandatory actual rendering verification of /Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/sequence-diagram.html remains outstanding. The completed visuals review records that browser access failed because the browser access host was unavailable. This consistency check inspected the embedded Mermaid and description tables, but cannot establish successful rendering or visual readability."],"advice":["Resolve scope-001 and visuals-001 together: the summary, selected alternative, migration text and sequence must express the same approved prompt guarantee. Per-name migration and mutation writes contradict the ISSUE's unconditional one-prompt behavior; the earlier narrowed LLD does not authorize that exception in this full-scope replacement.","Preserve the distinction noted by the runtime review: an immediate request after denial retries ensureDefaultManagedRoot but encounters the cached vault failure; Keychain access retries only after five minutes. State both phases explicitly in the integration test and acceptance mapping. The current unit cooldown test and repository retry contract can coexist.","Carry vault-001 through vault-004 and runtime-001 through runtime-002 into the final assessment without duplicating them. Together they identify missing migration ordering/state rules, corruption validation, rollback preservation, cross-process exclusion and a viable integration backend seam.","The generated companion retains the canonical sequence messages and descriptions; its misleading unconditional cached-read flow originates in the authored definition, as already recorded by visuals-001. Correcting only the HTML would leave the source inconsistent."]}],"limitations":["Mandatory actual rendering verification of docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/sequence-diagram.html could not be completed: opening the local companion through the browser tool returned 'The browser access host is unavailable'. Source inspection confirmed the embedded sequence and retained descriptions, but does not establish successful rendering or visual readability.","Mandatory actual rendering verification of /Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/sequence-diagram.html remains outstanding. The completed visuals review records that browser access failed because the browser access host was unavailable. This consistency check inspected the embedded Mermaid and description tables, but cannot establish successful rendering or visual readability."],"reviewer":"daemon","reviewedContentIdentity":"d2ce2b5da84a1b6c35cf6e632c8c8a984d510bfaec6259ff15c62874d790a141"},"finishedAt":"2026-11-08T12:34:50.102Z"},{"number":2,"status":"incomplete","preparationKind":"impact","baseline":{"subjectFingerprints":{"canonical":"dcff699ae3bc17123a420d00368c90f78fed1af3f764ef8ab26cb72f1bf25af9","document":"337c659409fa8d31614a1dccd955856b79b356db9e787de74fa6be86bd0cd9b0"},"contentIdentity":"b9052f1142ff87b95aa661456e9b82210feb23ad1a54a9938abd7c82a54c7581","reviewedContent":{"canonical":"{\n  \"meta\": {\n    \"workflow\": \"design.story\",\n    \"runId\": \"wf-1794141425900-6qws00\",\n    \"repoPath\": \"/Users/subhagho/work/projects/insors/insrc\",\n    \"createdAt\": \"2026-11-08T12:43:46.995Z\",\n    \"epicCreatedAt\": \"2026-11-04T19:31:14.890Z\",\n    \"attribution\": {\n      \"outputs\": [\n        {\n          \"role\": \"(client)\",\n          \"tier\": \"core\",\n          \"runner\": \"cli-claude\",\n          \"model\": \"claude-opus-5-5\"\n        }\n      ]\n    },\n    \"elapsedMs\": 400602,\n    \"repoIndexedAt\": null,\n    \"schemaVersion\": 1,\n    \"epicHash\": \"fefa97b991537da7\",\n    \"epicSlug\": \"open-saved-connections-demand-read-all\",\n    \"storyId\": \"s1\",\n    \"hldBaseRunId\": \"wf-1794141425900-6qws00\",\n    \"hldEffectiveHash\": \"003154de9a05a0fba12ac723838674fea477d7b275d0db517beceabe53d06135\",\n    \"hldAmendmentsApplied\": [],\n    \"storyTitle\": \"Open saved connections on demand and read all credentials with one keychain prompt per daemon run\",\n    \"standalone\": true,\n    \"sizeClass\": \"bugfix\",\n    \"triageRationale\": \"Sized bugfix ISSUE-fefa97b991537da7; rerun at the issue's full scope on the user's instruction, revised after design review round 1 with stakeholder decision A.\",\n    \"authoredBy\": \"controller\",\n    \"envelope\": {\n      \"attachments\": []\n    },\n    \"revision\": 2\n  },\n  \"body\": {\n    \"summary\": {\n      \"audience\": \"technical\",\n      \"prose\": \"The daemon stops touching the Keychain when it starts, and opens a repository's saved connections the first time a request needs them. All secrets move into one Keychain item that the main thread reads once per daemon run and serves to every thread from memory. By stakeholder decision A (2026-11-08) two exceptions to one prompt are accepted: each existing per-item secret prompts once when it is first copied across, once in its lifetime, because macOS guards each old item separately, and a save may show one more dialog if the first was answered Allow rather than Always Allow.\"\n    },\n    \"hldContextSlice\": {\n      \"frameworkSummary\": \"Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\",\n      \"ownedContracts\": [],\n      \"consumedContracts\": [],\n      \"boundary\": {\n        \"storyId\": \"s1\",\n        \"owns\": [],\n        \"depends\": [],\n        \"internal\": \"Open saved connections on demand and read all credentials with one keychain prompt per daemon run\"\n      },\n      \"adjacentBoundaries\": [],\n      \"rolloutPhase\": \"standalone\",\n      \"nonFunctional\": {}\n    },\n    \"contractDetails\": {\n      \"surfaceLevel\": \"internal\",\n      \"api\": [\n        {\n          \"name\": \"getKey\",\n          \"signature\": \"getKey(name: string): Promise<string | null>\",\n          \"parameters\": [\n            {\n              \"name\": \"name\",\n              \"type\": \"string\",\n              \"purpose\": \"Secret name, unchanged from today's account names.\",\n              \"optional\": false\n            }\n          ],\n          \"returns\": {\n            \"type\": \"Promise<string | null>\",\n            \"meaning\": \"The secret from the vault held in memory or from this run's cached legacy value, or null when no such secret exists.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"KeystoreUnavailableError\",\n              \"condition\": \"The vault could not be loaded or validated, the offline maintenance tool holds the vault guard, or this name's legacy read failed. The cause is carried. Other requests are not blocked.\"\n            }\n          ],\n          \"preconditions\": [\n            \"On a session worker the call is forwarded over the worker's hub channel; only the owning thread calls keytar.\"\n          ],\n          \"postconditions\": [\n            \"At most one Keychain read of the vault item per successful daemon run, across all threads and concurrent callers.\",\n            \"A name absent from the vault and not retired has at most one legacy lookup in flight, and at most one successful legacy read per run.\"\n          ]\n        },\n        {\n          \"name\": \"setKey\",\n          \"signature\": \"setKey(name: string, value: string): Promise<void>\",\n          \"parameters\": [\n            {\n              \"name\": \"name\",\n              \"type\": \"string\",\n              \"purpose\": \"Secret name.\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"value\",\n              \"type\": \"string\",\n              \"purpose\": \"Secret value.\",\n              \"optional\": false\n            }\n          ],\n          \"returns\": {\n            \"type\": \"Promise<void>\",\n            \"meaning\": \"Resolves after the vault item is written and memory updated.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"KeystoreUnavailableError\",\n              \"condition\": \"The vault could not be loaded or written. Memory keeps its previous value.\"\n            }\n          ],\n          \"preconditions\": [\n            \"Runs in the owner's single mutation queue.\"\n          ],\n          \"postconditions\": [\n            \"The Keychain item is written first; memory changes only after that succeeds.\",\n            \"Any run state held for the name is cleared and the name leaves the retired list.\"\n          ]\n        },\n        {\n          \"name\": \"deleteKey\",\n          \"signature\": \"deleteKey(name: string): Promise<void>\",\n          \"parameters\": [\n            {\n              \"name\": \"name\",\n              \"type\": \"string\",\n              \"purpose\": \"Secret name.\",\n              \"optional\": false\n            }\n          ],\n          \"returns\": {\n            \"type\": \"Promise<void>\",\n            \"meaning\": \"Resolves after the name is removed from the vault and recorded as retired.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"KeystoreUnavailableError\",\n              \"condition\": \"The vault could not be loaded or written. Memory is unchanged.\"\n            }\n          ],\n          \"preconditions\": [\n            \"Runs in the owner's single mutation queue.\"\n          ],\n          \"postconditions\": [\n            \"The name is recorded as retired, so a leftover legacy item or an in-flight copy cannot bring it back.\",\n            \"The legacy item is deleted best effort; a failure is logged by name only.\"\n          ]\n        },\n        {\n          \"name\": \"listKeys\",\n          \"signature\": \"listKeys(): Promise<string[]>\",\n          \"parameters\": [],\n          \"returns\": {\n            \"type\": \"Promise<string[]>\",\n            \"meaning\": \"Names held in the vault. A legacy item not yet copied in is not listed until it is first used or set.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"KeystoreUnavailableError\",\n              \"condition\": \"The vault could not be loaded.\"\n            }\n          ],\n          \"preconditions\": [],\n          \"postconditions\": [\n            \"keytar.findCredentials is no longer called anywhere.\"\n          ]\n        },\n        {\n          \"name\": \"ensureDefaultManagedRoot\",\n          \"signature\": \"ensureDefaultManagedRoot(root: string, ports?: StartupPorts): Promise<void>\",\n          \"parameters\": [\n            {\n              \"name\": \"root\",\n              \"type\": \"string\",\n              \"purpose\": \"Registered repository whose saved management a request needs.\",\n              \"optional\": false\n            },\n            {\n              \"name\": \"ports\",\n              \"type\": \"StartupPorts\",\n              \"purpose\": \"Unchanged registration, keystore and enablement seams.\",\n              \"optional\": true\n            }\n          ],\n          \"returns\": {\n            \"type\": \"Promise<void>\",\n            \"meaning\": \"Unchanged: resolves once saved management for the root is installed, memoised per root; a rejected attempt is forgotten so the next call retries. What changes is the caller: the boot loop is removed and the main-thread request handlers call it.\"\n          },\n          \"errors\": [\n            {\n              \"type\": \"TicketError('secret-unavailable')\",\n              \"condition\": \"The Keychain refused or failed reading or creating the root's ticket key.\"\n            },\n            {\n              \"type\": \"ManagedStoreError('recovery-required') with cause KeystoreUnavailableError\",\n              \"condition\": \"A rollback-copy or connection-secret read failed in the Keychain; managementRejection reports it as 'secret-unavailable' from the cause.\"\n            },\n            {\n              \"type\": \"ManagedStoreError('recovery-required')\",\n              \"condition\": \"A legacy unmanaged registry, damaged metadata or any other integrity failure; unchanged.\"\n            }\n          ],\n          \"preconditions\": [\n            \"Called on the daemon main thread only, by owner and safeList and the listing and save paths, as capabilities already does.\"\n          ],\n          \"postconditions\": [\n            \"No call is made before server.listen, so a daemon start reads nothing from the Keychain.\",\n            \"Fresh initialization takes its ticket key before its first disk write, so a refused Keychain read leaves no partial state.\",\n            \"closeDefaultManagedRoots still closes every root opened on demand at shutdown.\"\n          ]\n        }\n      ]\n    },\n    \"dataModelChanges\": [\n      {\n        \"entity\": \"SecretVaultItem\",\n        \"change\": \"new\",\n        \"details\": \"One Keychain item under the new service 'insrc-vault', reserved account 'secrets', with a value of JSON: version 1, secrets (a map of name to value) and retired (names deleted after the vault existed). The separate service means keys.get, keys.set, keys.delete and keys.list can never address the vault item itself. On load the whole payload is validated: an object with version exactly 1, secrets an object whose values are all strings, retired an array of unique strings, and no name in both. Entries are held in a Map, so an arbitrary account name such as __proto__ is an ordinary key. Any validation failure is fail-closed: the item is never overwritten and reads report KeystoreUnavailableError.\",\n        \"schemaDiff\": \"+ service insrc-vault, account secrets: { version: 1, secrets: Record<string, string>, retired: string[] }\",\n        \"callSites\": [\n          \"src/shared/keystore.ts:10-40\"\n        ]\n      },\n      {\n        \"entity\": \"In-memory vault\",\n        \"change\": \"new\",\n        \"details\": \"Owned by the main thread, or by the offline maintenance process. Load is single-flight, so a pending dialog holds one load and concurrent callers await it. A refused or failed load is remembered for five minutes, in which reads fail at once with KeystoreUnavailableError, so a user who denies access is not prompted by every following request. Every change to the vault, including a migration copy, runs in one mutation queue that writes the Keychain item first and memory only after success. Decrypted values stay in memory and pass between threads only over the in-process hub channel; nothing decrypted is written to disk or logged.\",\n        \"callSites\": [\n          \"src/shared/keystore.ts:10-40\",\n          \"src/daemon/threads/main-services.ts:207\",\n          \"src/daemon/threads/worker-entry.ts:81\"\n        ]\n      },\n      {\n        \"entity\": \"Per-name run state\",\n        \"change\": \"new\",\n        \"details\": \"In memory for the run only, for a name absent from the vault and not retired. Lookup in flight: one legacy read per name, shared by concurrent callers. Copied: the legacy value entered the vault and the state is dropped. Cached value: the read succeeded but the copy failed, so this run's later reads are served from memory with no further Keychain access and the copy is retried on the next run. Absent: the legacy item does not exist, so null is returned for the rest of the run with no write. Failed: the legacy read was refused, so reads of that name fail at once for five minutes and then retry. A setKey or deleteKey clears the name's state. A copy commits inside the mutation queue only if the name is still neither in the vault nor retired, so a copy that lost a race with a save or delete is discarded.\",\n        \"callSites\": [\n          \"src/shared/keystore.ts:10-40\"\n        ]\n      },\n      {\n        \"entity\": \"Worker keystore forwarding\",\n        \"change\": \"new\",\n        \"details\": \"A hub operation served by the main thread through serveHub for get, set, delete and list; worker-entry installs the forwarder, so getKey and its siblings keep their signatures on every thread. With daemon.threads.enabled off, the main thread uses the vault directly. No RPC method is added, so the method-class table is unchanged.\",\n        \"callSites\": [\n          \"src/daemon/threads/channel.ts:117\",\n          \"src/daemon/threads/main-services.ts:207\",\n          \"src/daemon/threads/worker-entry.ts:81\",\n          \"src/daemon/threads/method-class.ts:142-160\"\n        ]\n      },\n      {\n        \"entity\": \"Vault run-file guard\",\n        \"change\": \"new\",\n        \"details\": \"A guard directory under ~/.insrc, created with acquireRunFileGuard. The offline maintenance binary acquires it first, then performs its existing pid and socket absence check, and holds it until exit. A daemon checks runFileGuardConflict before loading the vault and fails with KeystoreUnavailableError while it is held, without touching the Keychain and without the five-minute memory. The ordering closes the race: a daemon only loads the vault after its socket is open, so a maintenance run that acquires the guard either sees that socket and refuses, or holds the guard before the daemon's first load. A maintenance crash leaves the guard in place, fail-closed, and the error names its path for an operator to clear, as run-file guards already do.\",\n        \"callSites\": [\n          \"src/bin/insrc-connection-maintenance.ts:14-24\",\n          \"src/shared/daemon-run-files.ts:52\",\n          \"src/shared/daemon-run-files.ts:64\"\n        ]\n      },\n      {\n        \"entity\": \"Legacy per-item secrets\",\n        \"change\": \"invariant-change\",\n        \"details\": \"Items under service 'insrc' stop being the source of truth once copied, and migration never deletes them, so a failed or partial migration leaves them readable. Only an explicit deleteKey removes one. Abandoning the vault is a recovery that loses data: see the migration section.\",\n        \"callSites\": [\n          \"src/shared/keystore.ts:10-40\",\n          \"src/daemon/db/secrets.ts:26-44\"\n        ]\n      },\n      {\n        \"entity\": \"keys.list handler\",\n        \"change\": \"invariant-change\",\n        \"details\": \"Today it runs one Keychain read per name; it now reads names and values through the vault. No in-repo client calls keys.list today.\",\n        \"callSites\": [\n          \"src/daemon/handler-runtime.ts:1474-1503\"\n        ]\n      },\n      {\n        \"entity\": \"Daemon boot\",\n        \"change\": \"invariant-change\",\n        \"details\": \"Today the daemon opens every registered repository before server.listen; that loop is removed, and closeDefaultManagedRoots stays registered for shutdown.\",\n        \"callSites\": [\n          \"src/daemon/index.ts:470-476\",\n          \"src/daemon/index.ts:539\"\n        ]\n      }\n    ],\n    \"interactionWithShared\": [],\n    \"errorPaths\": {\n      \"errorCases\": [\n        {\n          \"scenario\": \"The user denies the Keychain dialog, or the Keychain read of the vault item fails\",\n          \"detection\": \"keytar.getPassword rejects during the single-flight vault load\",\n          \"response\": \"Every waiting caller gets KeystoreUnavailableError with the cause. The failure is remembered for five minutes, in which reads fail at once without a dialog; the next read after that retries.\",\n          \"userImpact\": \"Requests needing a secret report the connection unavailable with the cause; requests needing no secret continue.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"The vault item fails validation\",\n          \"detection\": \"JSON parsing, the version check or the whole-payload shape check fails after a successful Keychain read\",\n          \"response\": \"Fail closed: KeystoreUnavailableError, the item is never rewritten and no legacy fallback is used, so a damaged item cannot be replaced by a partial one.\",\n          \"userImpact\": \"Saved secrets are unavailable until the item is repaired or deliberately abandoned.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"The offline maintenance tool holds the vault guard when a daemon needs a secret\",\n          \"detection\": \"runFileGuardConflict reports the guard before the vault load\",\n          \"response\": \"KeystoreUnavailableError naming the guard, with no Keychain access and no five-minute memory, so the first request after the guard is released succeeds.\",\n          \"userImpact\": \"Requests needing a secret fail until maintenance ends; a crashed maintenance run leaves the guard for an operator to clear.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"The maintenance tool finds the daemon running after taking the guard\",\n          \"detection\": \"The existing pid and socket absence check, now made after the guard is acquired, finds a file\",\n          \"response\": \"The tool releases the guard and exits with its existing failure message, without touching the vault.\",\n          \"userImpact\": \"Maintenance does not run; management stays disabled pending recovery as today.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Writing the vault item fails on a save or delete\",\n          \"detection\": \"keytar.setPassword rejects inside the mutation queue\",\n          \"response\": \"KeystoreUnavailableError to that caller; memory keeps its previous value, so memory and Keychain stay consistent.\",\n          \"userImpact\": \"The save reports failure and the old value remains in force.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Copying a legacy secret into the vault fails\",\n          \"detection\": \"keytar.setPassword rejects inside the mutation queue after the legacy read succeeded\",\n          \"response\": \"The value is kept as this run's cached value for the name and returned; the legacy item is untouched and the copy is retried on the next run.\",\n          \"userImpact\": \"None this run; that name may prompt again on the next run until a copy succeeds.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"A legacy item read is refused during migration\",\n          \"detection\": \"keytar.getPassword on the legacy service rejects\",\n          \"response\": \"KeystoreUnavailableError for that name only, remembered for five minutes per name; the vault and other names are unaffected.\",\n          \"userImpact\": \"That connection is reported unavailable with the cause and is not re-prompted by each following request.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"Opening a repository's saved connections fails on first use\",\n          \"detection\": \"ensureDefaultManagedRoot rejects with a keystore cause or an integrity failure\",\n          \"response\": \"The rejected attempt is forgotten, the request gets 'secret-unavailable' for a keystore cause and 'recovery-required' otherwise; fresh initialization has written nothing if its ticket key could not be taken.\",\n          \"userImpact\": \"That repository's request fails with its cause; the daemon and other repositories are unaffected.\",\n          \"recoverable\": true\n        },\n        {\n          \"scenario\": \"A worker's hub call to the vault owner fails or the channel closes\",\n          \"detection\": \"The hub request rejects on the worker\",\n          \"response\": \"KeystoreUnavailableError with the cause; the worker does not fall back to calling keytar itself.\",\n          \"userImpact\": \"That request fails; no extra Keychain access occurs.\",\n          \"recoverable\": true\n        }\n      ],\n      \"edgeCases\": [\n        {\n          \"input\": \"No vault item exists yet\",\n          \"expected\": \"keytar returns null with no dialog for a missing item; the vault starts empty and the item is created on the first write.\"\n        },\n        {\n          \"input\": \"A name exists nowhere, such as an unset web search key\",\n          \"expected\": \"getKey returns null; the absence is remembered for the run, not persisted, so a lookup causes no write.\"\n        },\n        {\n          \"input\": \"A save or delete lands while a legacy read for the same name is in flight\",\n          \"expected\": \"The save or delete wins; the copy finds the name in the vault or retired inside the mutation queue and is discarded.\"\n        },\n        {\n          \"input\": \"Two callers miss the same name at once\",\n          \"expected\": \"They share one legacy read and one copy.\"\n        },\n        {\n          \"input\": \"A name is deleted and an old legacy item for it remains\",\n          \"expected\": \"The retired list stops the legacy fallback, and getKey returns null.\"\n        },\n        {\n          \"input\": \"A retired name is saved again\",\n          \"expected\": \"setKey adds it to secrets and removes it from retired.\"\n        },\n        {\n          \"input\": \"An account name such as __proto__ or constructor\",\n          \"expected\": \"It is an ordinary key, because entries are held in a Map.\"\n        },\n        {\n          \"input\": \"Many threads ask for different secrets while the first dialog is open\",\n          \"expected\": \"They wait on the one load; exactly one Keychain read of the vault occurs and requests needing no secret do not wait.\"\n        },\n        {\n          \"input\": \"daemon.threads.enabled is false\",\n          \"expected\": \"The main thread uses the vault directly with the same behaviour.\"\n        },\n        {\n          \"input\": \"A plain listing of a repository with no management marker\",\n          \"expected\": \"No state is created and the Keychain is not touched.\"\n        }\n      ],\n      \"invariantsToPreserve\": [\n        {\n          \"text\": \"getKey, setKey, deleteKey and listKeys keep their signatures, and the KeystoreLike port and its test seam keep working.\",\n          \"source\": \"c1\"\n        },\n        {\n          \"text\": \"ensureDefaultManagedRoot stays memoised per root and forgets a failed attempt.\",\n          \"source\": \"c3\"\n        },\n        {\n          \"text\": \"The CLI never opens the Keychain; only daemon code and the daemon-owned offline maintenance binary do.\",\n          \"source\": \"c4\"\n        },\n        {\n          \"text\": \"Hub traffic stays in-process between the main thread and its workers.\",\n          \"source\": \"c5\"\n        },\n        {\n          \"text\": \"A daemon shutdown still closes every root that was opened.\",\n          \"source\": \"c3\"\n        }\n      ]\n    },\n    \"testStrategy\": {\n      \"testFramework\": \"node:test\",\n      \"testLevels\": [\n        {\n          \"level\": \"unit\",\n          \"purpose\": \"The vault's load, read, write, retire, ordering and failure rules against a fake Keychain backend injected below the vault that counts calls.\",\n          \"subjects\": [\n            \"vault: concurrent reads perform one Keychain read\",\n            \"vault: a refused load fails at once for five minutes and then retries\",\n            \"vault: a payload with a bad version, missing secrets, a non-string value or a bad retired list fails closed and is never rewritten\",\n            \"vault: a name such as __proto__ is stored and read as an ordinary key\",\n            \"vault: a failed write leaves memory unchanged\",\n            \"vault: concurrent saves lose no update\",\n            \"vault: a retired name does not fall back to its legacy item\",\n            \"vault: a retired name saved again is readable\",\n            \"migration: a legacy secret is copied once and read from the vault afterwards\",\n            \"migration: concurrent misses of one name share one legacy read and one copy\",\n            \"migration: a save during a legacy read wins and the copy is discarded\",\n            \"migration: a delete during a legacy read wins and the copy is discarded\",\n            \"migration: a failed copy serves later reads from memory, keeps the legacy item and retries on the next run\",\n            \"migration: an absent name causes no write and no second lookup in the run\",\n            \"migration: a refused legacy read fails at once for five minutes for that name only\",\n            \"keystore: listKeys never calls findCredentials\"\n          ],\n          \"fixturesNeeded\": [\n            \"A fake Keychain backend that counts reads and writes, can refuse them and can hold a read open, installed through a test-only setter below the vault\"\n          ]\n        },\n        {\n          \"level\": \"integration\",\n          \"purpose\": \"Thread ownership, process exclusion, on-demand opening and error mapping in real processes, with the fake backend installed below the vault in the process that owns it.\",\n          \"subjects\": [\n            \"threads: workers on two threads share one Keychain read\",\n            \"threads: a worker never calls the backend directly\",\n            \"threads: a closed hub channel does not fall back to the Keychain\",\n            \"threads: a save on one worker is visible on another\",\n            \"guard: a daemon holding no vault fails requests while maintenance holds the guard and succeeds after release\",\n            \"guard: maintenance refuses and releases the guard when the daemon socket exists after acquiring it\",\n            \"boot: a daemon start reads nothing from the Keychain and opens its socket\",\n            \"on-demand: the first management request opens the repository and a later one does not reopen it\",\n            \"on-demand: a refused Keychain read reports secret-unavailable and the next request retries\",\n            \"on-demand: a refused first-time set-up leaves nothing on disk\",\n            \"on-demand: a plain listing of an unmanaged repository touches nothing\",\n            \"consumers: notify, web and keys handlers read through the vault\",\n            \"maintenance: the offline tool reads the vault once\"\n          ],\n          \"fixturesNeeded\": [\n            \"A node --import test preload that installs the fake backend in a spawned daemon or maintenance process, so no production switch is added, and that throws if the backend is called on a worker\",\n            \"A temporary repository with seeded saved connections\"\n          ]\n        },\n        {\n          \"level\": \"live\",\n          \"purpose\": \"The real macOS behaviour no fake can show, run by a person.\",\n          \"subjects\": [\n            \"live: after a node upgrade one dialog appears across several connections and threads once migration is complete\"\n          ],\n          \"fixturesNeeded\": [\n            \"A macOS login Keychain with several saved connections\"\n          ]\n        }\n      ],\n      \"acceptanceMapping\": [\n        {\n          \"criterionId\": \"ac1\",\n          \"provingTests\": [\n            \"boot: a daemon start reads nothing from the Keychain and opens its socket\",\n            \"on-demand: the first management request opens the repository and a later one does not reopen it\",\n            \"on-demand: a refused Keychain read reports secret-unavailable and the next request retries\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac2\",\n          \"provingTests\": [\n            \"vault: concurrent reads perform one Keychain read\",\n            \"threads: workers on two threads share one Keychain read\",\n            \"threads: a save on one worker is visible on another\",\n            \"live: after a node upgrade one dialog appears across several connections and threads once migration is complete\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac3\",\n          \"provingTests\": [\n            \"consumers: notify, web and keys handlers read through the vault\",\n            \"maintenance: the offline tool reads the vault once\",\n            \"guard: a daemon holding no vault fails requests while maintenance holds the guard and succeeds after release\"\n          ]\n        },\n        {\n          \"criterionId\": \"ac4\",\n          \"provingTests\": [\n            \"migration: a legacy secret is copied once and read from the vault afterwards\",\n            \"migration: a save during a legacy read wins and the copy is discarded\",\n            \"migration: a delete during a legacy read wins and the copy is discarded\",\n            \"migration: a failed copy serves later reads from memory, keeps the legacy item and retries on the next run\"\n          ]\n        }\n      ]\n    },\n    \"migration\": {\n      \"stateBefore\": \"Each secret is its own Keychain item under service 'insrc', read through keytar on every use (s1 symbol.locate), and main() opens every repository's saved connections before server.listen (s1 usage.example).\",\n      \"stateAfter\": \"One vault item under service 'insrc-vault' holds every secret and is read once per daemon run by the main thread; saved connections open on first use. Legacy items remain until an explicit delete.\",\n      \"migrationSteps\": [\n        {\n          \"order\": 1,\n          \"action\": \"Ship the vault with the legacy fallback: a name absent from the vault and not retired is read from its legacy item and copied in on first use.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 2,\n          \"action\": \"Remove the boot loop and open saved connections on first request.\",\n          \"rollbackable\": true\n        },\n        {\n          \"order\": 3,\n          \"action\": \"Each legacy secret is copied into the vault the first time it is used, showing at most one dialog for that item, once in its lifetime (accepted exception, stakeholder decision A); no legacy item is deleted by migration. Once any secret has been saved or deleted through the vault, going back loses data, as step 4 states.\",\n          \"rollbackable\": false\n        },\n        {\n          \"order\": 4,\n          \"action\": \"Recovery if the vault must be abandoned: delete the single vault item, or run the previous daemon version; both read the untouched legacy items. This is not a clean rollback. A secret first saved after migration is lost and must be re-entered; a secret changed after migration reverts to its older legacy value; a secret deleted after migration whose best-effort legacy delete failed comes back and must be deleted again.\",\n          \"rollbackable\": false\n        }\n      ],\n      \"backwardCompat\": \"getKey, setKey, deleteKey and listKeys keep their signatures and the KeystoreLike port and test seam are unchanged. listKeys now reports vault names only, so a legacy item appears after first use; no in-repo client calls keys.list. A previous daemon version keeps reading legacy items and does not see the vault, with the losses stated in step 4.\",\n      \"zeroDowntime\": false,\n      \"dataRewriteRequired\": false\n    },\n    \"alternativesConsidered\": [\n      {\n        \"id\": \"a1\",\n        \"name\": \"One Keychain item holding every secret, owned by the main thread\",\n        \"oneLineSummary\": \"A JSON map of all secrets lives in one Keychain item under a new service; the main thread loads it once on first need and serves every thread from memory.\",\n        \"approach\": \"getKey, setKey, deleteKey and listKeys keep their signatures but use a vault: one Keychain item under a new service whose value is a versioned JSON map of name to secret. The first read loads it once, single-flight, and later reads come from memory. Workers forward over their existing hub channel, so only one thread touches the Keychain. Every change to the vault, including a migration copy, runs through one mutation queue that writes the item first and memory only after success. A name absent from the vault and not retired is read from its legacy item, single-flight per name, and copied in through that queue after re-checking the current state, so a stale copy cannot overwrite a save or undo a delete. Legacy items stay readable. The offline maintenance tool holds a cross-process guard for its whole run. The boot loop is removed and saved connections open on demand.\",\n        \"pros\": [\n          \"The consolidated single item the issue asks for, chosen by the stakeholder as decision A\",\n          \"The Keychain stays the only place secrets rest\",\n          \"Existing callers keep their signatures\",\n          \"Reuses the worker hub channel and the run-file guard\"\n        ],\n        \"cons\": [\n          \"Accepted exception: a save rewrites the whole item, so macOS may show one more dialog when the first was answered Allow rather than Always Allow\",\n          \"Accepted exception: each legacy item prompts once when first copied, once in its lifetime, because macOS guards each legacy item separately\",\n          \"Workers gain a hub round trip for every secret read\"\n        ],\n        \"costEstimate\": \"M\"\n      },\n      {\n        \"id\": \"a2\",\n        \"name\": \"One Keychain master key with secrets in an encrypted file\",\n        \"oneLineSummary\": \"The Keychain holds only an AES key; secrets live in an AES-GCM file under ~/.insrc, so saving a secret never touches the Keychain after the first read.\",\n        \"approach\": \"The vault keeps the same read and write surface and the same main-thread ownership, but its single Keychain item holds a random 256-bit key. Secrets are stored in one AES-GCM encrypted file written atomically under ~/.insrc; the key is read once per run and writes only re-encrypt the file. Migration and on-demand opening are as in a1.\",\n        \"pros\": [\n          \"Saving or removing a secret can never prompt once the key is in memory\",\n          \"Item size stays constant however many secrets are saved\"\n        ],\n        \"cons\": [\n          \"Introduces a new encrypted store with its own file format, integrity, atomic-write and permission rules\",\n          \"Secrets become recoverable only with both the file and the key, and daemon.backup would need to cover the file\",\n          \"Moves secrets out of the Keychain, and legacy items still prompt once each on migration\"\n        ],\n        \"costEstimate\": \"L\",\n        \"reasonRejected\": \"Removes the save dialog but moves secrets to a new encrypted store, and is only partial on lossless migration; the stakeholder declined it in decision A.\"\n      },\n      {\n        \"id\": \"a3\",\n        \"name\": \"One Keychain item cached separately on each thread\",\n        \"oneLineSummary\": \"The smallest change: the keystore module caches the single item in module scope, so each thread that needs a secret loads it for itself.\",\n        \"approach\": \"The keystore module holds the consolidated map in a module-level variable with no cross-thread forwarding. The main thread and each session worker load the item on their own first read and keep their own copy. Writes go to the Keychain and update only the writing thread's copy.\",\n        \"pros\": [\n          \"No hub operations or worker forwarding\",\n          \"Smallest amount of code\"\n        ],\n        \"cons\": [\n          \"Every session worker repeats the Keychain access, so a user who answers Allow is prompted once per thread, which fails the one-prompt requirement\",\n          \"A write on one thread leaves stale secrets on every other thread\",\n          \"Two threads writing at once can lose an update to the shared item\"\n        ],\n        \"costEstimate\": \"S\",\n        \"reasonRejected\": \"Violates the one-prompt requirement: each thread does its own Keychain access and holds a stale copy after a write.\"\n      }\n    ],\n    \"chosenAlternative\": \"a1\",\n    \"openQuestions\": [],\n    \"sequenceDefinition\": {\n      \"narrative\": \"How a secret read reaches the Keychain. The normal path, once a name is in the vault, needs only the one vault read per run. The migration path applies only to a name not yet copied, and is the one-time prompt accepted in stakeholder decision A.\",\n      \"participants\": [\n        {\n          \"id\": \"client\",\n          \"label\": \"Client request\",\n          \"description\": \"A request that needs a saved secret.\"\n        },\n        {\n          \"id\": \"worker\",\n          \"label\": \"Session worker\",\n          \"description\": \"The thread running that session; it never calls the Keychain.\"\n        },\n        {\n          \"id\": \"main\",\n          \"label\": \"Main thread vault\",\n          \"description\": \"The one in-memory owner of all secrets and of the mutation queue.\"\n        },\n        {\n          \"id\": \"keychain\",\n          \"label\": \"macOS Keychain\",\n          \"description\": \"Holds the single vault item and, until copied, the legacy per-item secrets.\"\n        }\n      ],\n      \"messages\": [\n        {\n          \"from\": \"client\",\n          \"to\": \"worker\",\n          \"label\": \"request needing a secret\",\n          \"description\": \"No Keychain access has happened since the daemon started.\"\n        },\n        {\n          \"from\": \"worker\",\n          \"to\": \"main\",\n          \"label\": \"getKey over the hub channel\",\n          \"description\": \"Forwarded in-process.\"\n        },\n        {\n          \"from\": \"main\",\n          \"to\": \"keychain\",\n          \"label\": \"first need this run: read vault item once\",\n          \"description\": \"Single-flight, so concurrent callers wait on this one read and see one dialog.\"\n        },\n        {\n          \"from\": \"keychain\",\n          \"to\": \"main\",\n          \"label\": \"every secret copied so far\",\n          \"kind\": \"return\",\n          \"description\": \"Held in memory until the daemon exits.\"\n        },\n        {\n          \"from\": \"main\",\n          \"to\": \"keychain\",\n          \"label\": \"only if the name is not yet in the vault: read its legacy item\",\n          \"description\": \"One dialog for that item, once in its lifetime; one read per name however many callers miss it.\"\n        },\n        {\n          \"from\": \"keychain\",\n          \"to\": \"main\",\n          \"label\": \"legacy secret\",\n          \"kind\": \"return\",\n          \"description\": \"Or nothing, when no such item exists.\"\n        },\n        {\n          \"from\": \"main\",\n          \"to\": \"keychain\",\n          \"label\": \"mutation queue: write vault with the copy\",\n          \"description\": \"Skipped if a save or delete of that name won the race; a save or delete takes this same path.\"\n        },\n        {\n          \"from\": \"main\",\n          \"to\": \"worker\",\n          \"label\": \"secret\",\n          \"kind\": \"return\",\n          \"description\": \"Passed in-process only.\"\n        },\n        {\n          \"from\": \"worker\",\n          \"to\": \"main\",\n          \"label\": \"later getKey of a copied name, any thread\",\n          \"description\": \"Served from memory with no Keychain access.\"\n        }\n      ]\n    },\n    \"companions\": [\n      {\n        \"kind\": \"diagram-mermaid\",\n        \"relPath\": \"docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/sequence-diagram.html\",\n        \"title\": \"Sequence diagram\"\n      }\n    ]\n  },\n  \"citations\": [\n    {\n      \"id\": \"c1\",\n      \"kind\": \"code\",\n      \"ref\": \"src/shared/keystore.ts:10-40\"\n    },\n    {\n      \"id\": \"c2\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/db/secrets.ts:26-44\"\n    },\n    {\n      \"id\": \"c3\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/db/management-defaults.ts\"\n    },\n    {\n      \"id\": \"c4\",\n      \"kind\": \"code\",\n      \"ref\": \"src/bin/insrc-connection-maintenance.ts:14-30\"\n    },\n    {\n      \"id\": \"c5\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/threads/channel.ts:117\"\n    },\n    {\n      \"id\": \"c6\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/index.ts:470-476\"\n    },\n    {\n      \"id\": \"c7\",\n      \"kind\": \"code\",\n      \"ref\": \"src/daemon/threads/method-class.ts:142-160\"\n    },\n    {\n      \"id\": \"c8\",\n      \"kind\": \"code\",\n      \"ref\": \"src/shared/daemon-run-files.ts:64\"\n    },\n    {\n      \"id\": \"c9\",\n      \"kind\": \"prior-artifact\",\n      \"ref\": \"ISSUE-fefa97b991537da7\"\n    },\n    {\n      \"id\": \"c10\",\n      \"kind\": \"prior-artifact\",\n      \"ref\": \"LLD-669ae7a31701e106-S001\"\n    },\n    {\n      \"id\": \"c11\",\n      \"kind\": \"stakeholder\",\n      \"ref\": \"Decision A, 2026-11-08\",\n      \"quotedText\": \"Keep one Keychain item holding everything; accept that each legacy item prompts once when first copied, and that a save may show one more dialog if the first was answered Allow rather than Always Allow.\"\n    }\n  ]\n}\n","document":"<!-- insrc:artifact LLD-fefa97b991537da7-s1 -->\n\n# LLD: STORY-fefa97b991537da7-s1 — Open saved connections on demand and read all credentials with one keychain prompt per daemon run\n\n## Summary\n\n**Epic:** `open-saved-connections-demand-read-all`\n**HLD base run:** `wf-1794141425900-6qws00`\n**HLD effective hash:** `003154de9a05...`\n\nThe daemon stops touching the Keychain when it starts, and opens a repository's saved connections the first time a request needs them. All secrets move into one Keychain item that the main thread reads once per daemon run and serves to every thread from memory. By stakeholder decision A (2026-11-08) two exceptions to one prompt are accepted: each existing per-item secret prompts once when it is first copied across, once in its lifetime, because macOS guards each old item separately, and a save may show one more dialog if the first was answered Allow rather than Always Allow.\n\n## Contents\n\n1. [HLD context](#1-hld-context)\n2. [Contract details](#2-contract-details)\n3. [Data model changes](#3-data-model-changes)\n4. [Diagrams](#4-diagrams)\n5. [Error paths](#5-error-paths)\n6. [Test strategy](#6-test-strategy)\n7. [Migration](#7-migration)\n8. [Alternatives considered](#8-alternatives-considered)\n9. [References](#9-references)\n\n## 1. HLD context\n\n**Framework:** Standalone feature — no parent HLD. Design directly against the repo, grounded on the s1 analyze passes. There are no HLD shared contracts to honour.\n**Rollout phase:** standalone\n\n## 2. Contract details\n\n**Surface level:** internal\n\n### 2.1 `getKey`\n\n```typescript\ngetKey(name: string): Promise<string | null>\n```\n\n**Parameters:**\n- `name: string` — Secret name, unchanged from today's account names.\n\n**Returns:** `Promise<string | null>` — The secret from the vault held in memory or from this run's cached legacy value, or null when no such secret exists.\n\n**Errors:**\n- `KeystoreUnavailableError` when The vault could not be loaded or validated, the offline maintenance tool holds the vault guard, or this name's legacy read failed. The cause is carried. Other requests are not blocked.\n\n**Preconditions:**\n- On a session worker the call is forwarded over the worker's hub channel; only the owning thread calls keytar.\n\n**Postconditions:**\n- At most one Keychain read of the vault item per successful daemon run, across all threads and concurrent callers.\n- A name absent from the vault and not retired has at most one legacy lookup in flight, and at most one successful legacy read per run.\n\n### 2.2 `setKey`\n\n```typescript\nsetKey(name: string, value: string): Promise<void>\n```\n\n**Parameters:**\n- `name: string` — Secret name.\n- `value: string` — Secret value.\n\n**Returns:** `Promise<void>` — Resolves after the vault item is written and memory updated.\n\n**Errors:**\n- `KeystoreUnavailableError` when The vault could not be loaded or written. Memory keeps its previous value.\n\n**Preconditions:**\n- Runs in the owner's single mutation queue.\n\n**Postconditions:**\n- The Keychain item is written first; memory changes only after that succeeds.\n- Any run state held for the name is cleared and the name leaves the retired list.\n\n### 2.3 `deleteKey`\n\n```typescript\ndeleteKey(name: string): Promise<void>\n```\n\n**Parameters:**\n- `name: string` — Secret name.\n\n**Returns:** `Promise<void>` — Resolves after the name is removed from the vault and recorded as retired.\n\n**Errors:**\n- `KeystoreUnavailableError` when The vault could not be loaded or written. Memory is unchanged.\n\n**Preconditions:**\n- Runs in the owner's single mutation queue.\n\n**Postconditions:**\n- The name is recorded as retired, so a leftover legacy item or an in-flight copy cannot bring it back.\n- The legacy item is deleted best effort; a failure is logged by name only.\n\n### 2.4 `listKeys`\n\n```typescript\nlistKeys(): Promise<string[]>\n```\n\n**Returns:** `Promise<string[]>` — Names held in the vault. A legacy item not yet copied in is not listed until it is first used or set.\n\n**Errors:**\n- `KeystoreUnavailableError` when The vault could not be loaded.\n\n**Postconditions:**\n- keytar.findCredentials is no longer called anywhere.\n\n### 2.5 `ensureDefaultManagedRoot`\n\n```typescript\nensureDefaultManagedRoot(root: string, ports?: StartupPorts): Promise<void>\n```\n\n**Parameters:**\n- `root: string` — Registered repository whose saved management a request needs.\n- `ports: StartupPorts` _(optional)_ — Unchanged registration, keystore and enablement seams.\n\n**Returns:** `Promise<void>` — Unchanged: resolves once saved management for the root is installed, memoised per root; a rejected attempt is forgotten so the next call retries. What changes is the caller: the boot loop is removed and the main-thread request handlers call it.\n\n**Errors:**\n- `TicketError('secret-unavailable')` when The Keychain refused or failed reading or creating the root's ticket key.\n- `ManagedStoreError('recovery-required') with cause KeystoreUnavailableError` when A rollback-copy or connection-secret read failed in the Keychain; managementRejection reports it as 'secret-unavailable' from the cause.\n- `ManagedStoreError('recovery-required')` when A legacy unmanaged registry, damaged metadata or any other integrity failure; unchanged.\n\n**Preconditions:**\n- Called on the daemon main thread only, by owner and safeList and the listing and save paths, as capabilities already does.\n\n**Postconditions:**\n- No call is made before server.listen, so a daemon start reads nothing from the Keychain.\n- Fresh initialization takes its ticket key before its first disk write, so a refused Keychain read leaves no partial state.\n- closeDefaultManagedRoots still closes every root opened on demand at shutdown.\n\n## 3. Data model changes\n\n### 3.1 `SecretVaultItem` — new\n\nOne Keychain item under the new service 'insrc-vault', reserved account 'secrets', with a value of JSON: version 1, secrets (a map of name to value) and retired (names deleted after the vault existed). The separate service means keys.get, keys.set, keys.delete and keys.list can never address the vault item itself. On load the whole payload is validated: an object with version exactly 1, secrets an object whose values are all strings, retired an array of unique strings, and no name in both. Entries are held in a Map, so an arbitrary account name such as __proto__ is an ordinary key. Any validation failure is fail-closed: the item is never overwritten and reads report KeystoreUnavailableError.\n\n```\n+ service insrc-vault, account secrets: { version: 1, secrets: Record<string, string>, retired: string[] }\n```\n\n**Call sites:**\n- `src/shared/keystore.ts:10-40`\n\n### 3.2 `In-memory vault` — new\n\nOwned by the main thread, or by the offline maintenance process. Load is single-flight, so a pending dialog holds one load and concurrent callers await it. A refused or failed load is remembered for five minutes, in which reads fail at once with KeystoreUnavailableError, so a user who denies access is not prompted by every following request. Every change to the vault, including a migration copy, runs in one mutation queue that writes the Keychain item first and memory only after success. Decrypted values stay in memory and pass between threads only over the in-process hub channel; nothing decrypted is written to disk or logged.\n\n**Call sites:**\n- `src/shared/keystore.ts:10-40`\n- `src/daemon/threads/main-services.ts:207`\n- `src/daemon/threads/worker-entry.ts:81`\n\n### 3.3 `Per-name run state` — new\n\nIn memory for the run only, for a name absent from the vault and not retired. Lookup in flight: one legacy read per name, shared by concurrent callers. Copied: the legacy value entered the vault and the state is dropped. Cached value: the read succeeded but the copy failed, so this run's later reads are served from memory with no further Keychain access and the copy is retried on the next run. Absent: the legacy item does not exist, so null is returned for the rest of the run with no write. Failed: the legacy read was refused, so reads of that name fail at once for five minutes and then retry. A setKey or deleteKey clears the name's state. A copy commits inside the mutation queue only if the name is still neither in the vault nor retired, so a copy that lost a race with a save or delete is discarded.\n\n**Call sites:**\n- `src/shared/keystore.ts:10-40`\n\n### 3.4 `Worker keystore forwarding` — new\n\nA hub operation served by the main thread through serveHub for get, set, delete and list; worker-entry installs the forwarder, so getKey and its siblings keep their signatures on every thread. With daemon.threads.enabled off, the main thread uses the vault directly. No RPC method is added, so the method-class table is unchanged.\n\n**Call sites:**\n- `src/daemon/threads/channel.ts:117`\n- `src/daemon/threads/main-services.ts:207`\n- `src/daemon/threads/worker-entry.ts:81`\n- `src/daemon/threads/method-class.ts:142-160`\n\n### 3.5 `Vault run-file guard` — new\n\nA guard directory under ~/.insrc, created with acquireRunFileGuard. The offline maintenance binary acquires it first, then performs its existing pid and socket absence check, and holds it until exit. A daemon checks runFileGuardConflict before loading the vault and fails with KeystoreUnavailableError while it is held, without touching the Keychain and without the five-minute memory. The ordering closes the race: a daemon only loads the vault after its socket is open, so a maintenance run that acquires the guard either sees that socket and refuses, or holds the guard before the daemon's first load. A maintenance crash leaves the guard in place, fail-closed, and the error names its path for an operator to clear, as run-file guards already do.\n\n**Call sites:**\n- `src/bin/insrc-connection-maintenance.ts:14-24`\n- `src/shared/daemon-run-files.ts:52`\n- `src/shared/daemon-run-files.ts:64`\n\n### 3.6 `Legacy per-item secrets` — invariant-change\n\nItems under service 'insrc' stop being the source of truth once copied, and migration never deletes them, so a failed or partial migration leaves them readable. Only an explicit deleteKey removes one. Abandoning the vault is a recovery that loses data: see the migration section.\n\n**Call sites:**\n- `src/shared/keystore.ts:10-40`\n- `src/daemon/db/secrets.ts:26-44`\n\n### 3.7 `keys.list handler` — invariant-change\n\nToday it runs one Keychain read per name; it now reads names and values through the vault. No in-repo client calls keys.list today.\n\n**Call sites:**\n- `src/daemon/handler-runtime.ts:1474-1503`\n\n### 3.8 `Daemon boot` — invariant-change\n\nToday the daemon opens every registered repository before server.listen; that loop is removed, and closeDefaultManagedRoots stays registered for shutdown.\n\n**Call sites:**\n- `src/daemon/index.ts:470-476`\n- `src/daemon/index.ts:539`\n\n## 4. Diagrams\n\n- [Sequence diagram](docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/sequence-diagram.html)\n\n## 5. Error paths\n\n**Error cases**\n\n- **The user denies the Keychain dialog, or the Keychain read of the vault item fails** (recoverable)\n  - Detection: keytar.getPassword rejects during the single-flight vault load\n  - Response: Every waiting caller gets KeystoreUnavailableError with the cause. The failure is remembered for five minutes, in which reads fail at once without a dialog; the next read after that retries.\n  - User impact: Requests needing a secret report the connection unavailable with the cause; requests needing no secret continue.\n- **The vault item fails validation** (recoverable)\n  - Detection: JSON parsing, the version check or the whole-payload shape check fails after a successful Keychain read\n  - Response: Fail closed: KeystoreUnavailableError, the item is never rewritten and no legacy fallback is used, so a damaged item cannot be replaced by a partial one.\n  - User impact: Saved secrets are unavailable until the item is repaired or deliberately abandoned.\n- **The offline maintenance tool holds the vault guard when a daemon needs a secret** (recoverable)\n  - Detection: runFileGuardConflict reports the guard before the vault load\n  - Response: KeystoreUnavailableError naming the guard, with no Keychain access and no five-minute memory, so the first request after the guard is released succeeds.\n  - User impact: Requests needing a secret fail until maintenance ends; a crashed maintenance run leaves the guard for an operator to clear.\n- **The maintenance tool finds the daemon running after taking the guard** (recoverable)\n  - Detection: The existing pid and socket absence check, now made after the guard is acquired, finds a file\n  - Response: The tool releases the guard and exits with its existing failure message, without touching the vault.\n  - User impact: Maintenance does not run; management stays disabled pending recovery as today.\n- **Writing the vault item fails on a save or delete** (recoverable)\n  - Detection: keytar.setPassword rejects inside the mutation queue\n  - Response: KeystoreUnavailableError to that caller; memory keeps its previous value, so memory and Keychain stay consistent.\n  - User impact: The save reports failure and the old value remains in force.\n- **Copying a legacy secret into the vault fails** (recoverable)\n  - Detection: keytar.setPassword rejects inside the mutation queue after the legacy read succeeded\n  - Response: The value is kept as this run's cached value for the name and returned; the legacy item is untouched and the copy is retried on the next run.\n  - User impact: None this run; that name may prompt again on the next run until a copy succeeds.\n- **A legacy item read is refused during migration** (recoverable)\n  - Detection: keytar.getPassword on the legacy service rejects\n  - Response: KeystoreUnavailableError for that name only, remembered for five minutes per name; the vault and other names are unaffected.\n  - User impact: That connection is reported unavailable with the cause and is not re-prompted by each following request.\n- **Opening a repository's saved connections fails on first use** (recoverable)\n  - Detection: ensureDefaultManagedRoot rejects with a keystore cause or an integrity failure\n  - Response: The rejected attempt is forgotten, the request gets 'secret-unavailable' for a keystore cause and 'recovery-required' otherwise; fresh initialization has written nothing if its ticket key could not be taken.\n  - User impact: That repository's request fails with its cause; the daemon and other repositories are unaffected.\n- **A worker's hub call to the vault owner fails or the channel closes** (recoverable)\n  - Detection: The hub request rejects on the worker\n  - Response: KeystoreUnavailableError with the cause; the worker does not fall back to calling keytar itself.\n  - User impact: That request fails; no extra Keychain access occurs.\n\n**Edge cases**\n\n| Input | Expected |\n| :--- | :--- |\n| No vault item exists yet | keytar returns null with no dialog for a missing item; the vault starts empty and the item is created on the first write. |\n| A name exists nowhere, such as an unset web search key | getKey returns null; the absence is remembered for the run, not persisted, so a lookup causes no write. |\n| A save or delete lands while a legacy read for the same name is in flight | The save or delete wins; the copy finds the name in the vault or retired inside the mutation queue and is discarded. |\n| Two callers miss the same name at once | They share one legacy read and one copy. |\n| A name is deleted and an old legacy item for it remains | The retired list stops the legacy fallback, and getKey returns null. |\n| A retired name is saved again | setKey adds it to secrets and removes it from retired. |\n| An account name such as __proto__ or constructor | It is an ordinary key, because entries are held in a Map. |\n| Many threads ask for different secrets while the first dialog is open | They wait on the one load; exactly one Keychain read of the vault occurs and requests needing no secret do not wait. |\n| daemon.threads.enabled is false | The main thread uses the vault directly with the same behaviour. |\n| A plain listing of a repository with no management marker | No state is created and the Keychain is not touched. |\n\n**Invariants to preserve**\n\n- getKey, setKey, deleteKey and listKeys keep their signatures, and the KeystoreLike port and its test seam keep working. [[c1]]\n- ensureDefaultManagedRoot stays memoised per root and forgets a failed attempt. [[c3]]\n- The CLI never opens the Keychain; only daemon code and the daemon-owned offline maintenance binary do. [[c4]]\n- Hub traffic stays in-process between the main thread and its workers. [[c5]]\n- A daemon shutdown still closes every root that was opened. [[c3]]\n\n## 6. Test strategy\n\n**Test framework:** `node:test`\n\n**Test levels**\n\n- **unit** — The vault's load, read, write, retire, ordering and failure rules against a fake Keychain backend injected below the vault that counts calls.\n  - Subjects: `vault: concurrent reads perform one Keychain read`, `vault: a refused load fails at once for five minutes and then retries`, `vault: a payload with a bad version, missing secrets, a non-string value or a bad retired list fails closed and is never rewritten`, `vault: a name such as __proto__ is stored and read as an ordinary key`, `vault: a failed write leaves memory unchanged`, `vault: concurrent saves lose no update`, `vault: a retired name does not fall back to its legacy item`, `vault: a retired name saved again is readable`, `migration: a legacy secret is copied once and read from the vault afterwards`, `migration: concurrent misses of one name share one legacy read and one copy`, `migration: a save during a legacy read wins and the copy is discarded`, `migration: a delete during a legacy read wins and the copy is discarded`, `migration: a failed copy serves later reads from memory, keeps the legacy item and retries on the next run`, `migration: an absent name causes no write and no second lookup in the run`, `migration: a refused legacy read fails at once for five minutes for that name only`, `keystore: listKeys never calls findCredentials`\n  - Fixtures: `A fake Keychain backend that counts reads and writes, can refuse them and can hold a read open, installed through a test-only setter below the vault`\n- **integration** — Thread ownership, process exclusion, on-demand opening and error mapping in real processes, with the fake backend installed below the vault in the process that owns it.\n  - Subjects: `threads: workers on two threads share one Keychain read`, `threads: a worker never calls the backend directly`, `threads: a closed hub channel does not fall back to the Keychain`, `threads: a save on one worker is visible on another`, `guard: a daemon holding no vault fails requests while maintenance holds the guard and succeeds after release`, `guard: maintenance refuses and releases the guard when the daemon socket exists after acquiring it`, `boot: a daemon start reads nothing from the Keychain and opens its socket`, `on-demand: the first management request opens the repository and a later one does not reopen it`, `on-demand: a refused Keychain read reports secret-unavailable and the next request retries`, `on-demand: a refused first-time set-up leaves nothing on disk`, `on-demand: a plain listing of an unmanaged repository touches nothing`, `consumers: notify, web and keys handlers read through the vault`, `maintenance: the offline tool reads the vault once`\n  - Fixtures: `A node --import test preload that installs the fake backend in a spawned daemon or maintenance process, so no production switch is added, and that throws if the backend is called on a worker`, `A temporary repository with seeded saved connections`\n- **live** — The real macOS behaviour no fake can show, run by a person.\n  - Subjects: `live: after a node upgrade one dialog appears across several connections and threads once migration is complete`\n  - Fixtures: `A macOS login Keychain with several saved connections`\n\n**Acceptance mapping**\n\n| Criterion | Proving tests |\n| :--- | :--- |\n| `ac1` | `boot: a daemon start reads nothing from the Keychain and opens its socket`, `on-demand: the first management request opens the repository and a later one does not reopen it`, `on-demand: a refused Keychain read reports secret-unavailable and the next request retries` |\n| `ac2` | `vault: concurrent reads perform one Keychain read`, `threads: workers on two threads share one Keychain read`, `threads: a save on one worker is visible on another`, `live: after a node upgrade one dialog appears across several connections and threads once migration is complete` |\n| `ac3` | `consumers: notify, web and keys handlers read through the vault`, `maintenance: the offline tool reads the vault once`, `guard: a daemon holding no vault fails requests while maintenance holds the guard and succeeds after release` |\n| `ac4` | `migration: a legacy secret is copied once and read from the vault afterwards`, `migration: a save during a legacy read wins and the copy is discarded`, `migration: a delete during a legacy read wins and the copy is discarded`, `migration: a failed copy serves later reads from memory, keeps the legacy item and retries on the next run` |\n\n## 7. Migration\n\n**State before:** Each secret is its own Keychain item under service 'insrc', read through keytar on every use (s1 symbol.locate), and main() opens every repository's saved connections before server.listen (s1 usage.example).\n\n**State after:** One vault item under service 'insrc-vault' holds every secret and is read once per daemon run by the main thread; saved connections open on first use. Legacy items remain until an explicit delete.\n\n**Zero downtime:** no — **Data rewrite:** no\n\n**Steps**\n\n1. Ship the vault with the legacy fallback: a name absent from the vault and not retired is read from its legacy item and copied in on first use. — ↩ rollbackable\n2. Remove the boot loop and open saved connections on first request. — ↩ rollbackable\n3. Each legacy secret is copied into the vault the first time it is used, showing at most one dialog for that item, once in its lifetime (accepted exception, stakeholder decision A); no legacy item is deleted by migration. Once any secret has been saved or deleted through the vault, going back loses data, as step 4 states. — ✕ non-rollbackable\n4. Recovery if the vault must be abandoned: delete the single vault item, or run the previous daemon version; both read the untouched legacy items. This is not a clean rollback. A secret first saved after migration is lost and must be re-entered; a secret changed after migration reverts to its older legacy value; a secret deleted after migration whose best-effort legacy delete failed comes back and must be deleted again. — ✕ non-rollbackable\n\n**Backward compat:** getKey, setKey, deleteKey and listKeys keep their signatures and the KeystoreLike port and test seam are unchanged. listKeys now reports vault names only, so a legacy item appears after first use; no in-repo client calls keys.list. A previous daemon version keeps reading legacy items and does not see the vault, with the losses stated in step 4.\n\n## 8. Alternatives considered\n\n### 8.1 a1: One Keychain item holding every secret, owned by the main thread — **CHOSEN**\n\nA JSON map of all secrets lives in one Keychain item under a new service; the main thread loads it once on first need and serves every thread from memory.\n\ngetKey, setKey, deleteKey and listKeys keep their signatures but use a vault: one Keychain item under a new service whose value is a versioned JSON map of name to secret. The first read loads it once, single-flight, and later reads come from memory. Workers forward over their existing hub channel, so only one thread touches the Keychain. Every change to the vault, including a migration copy, runs through one mutation queue that writes the item first and memory only after success. A name absent from the vault and not retired is read from its legacy item, single-flight per name, and copied in through that queue after re-checking the current state, so a stale copy cannot overwrite a save or undo a delete. Legacy items stay readable. The offline maintenance tool holds a cross-process guard for its whole run. The boot loop is removed and saved connections open on demand.\n\n### 8.2 a2: One Keychain master key with secrets in an encrypted file\n\nThe Keychain holds only an AES key; secrets live in an AES-GCM file under ~/.insrc, so saving a secret never touches the Keychain after the first read.\n\nThe vault keeps the same read and write surface and the same main-thread ownership, but its single Keychain item holds a random 256-bit key. Secrets are stored in one AES-GCM encrypted file written atomically under ~/.insrc; the key is read once per run and writes only re-encrypt the file. Migration and on-demand opening are as in a1.\n\n**Rejected because:** Removes the save dialog but moves secrets to a new encrypted store, and is only partial on lossless migration; the stakeholder declined it in decision A.\n\n### 8.3 a3: One Keychain item cached separately on each thread\n\nThe smallest change: the keystore module caches the single item in module scope, so each thread that needs a secret loads it for itself.\n\nThe keystore module holds the consolidated map in a module-level variable with no cross-thread forwarding. The main thread and each session worker load the item on their own first read and keep their own copy. Writes go to the Keychain and update only the writing thread's copy.\n\n**Rejected because:** Violates the one-prompt requirement: each thread does its own Keychain access and holds a stale copy after a write.\n\n## 9. References\n\n- **[[c1]]** `code` `src/shared/keystore.ts:10-40`\n- **[[c2]]** `code` `src/daemon/db/secrets.ts:26-44`\n- **[[c3]]** `code` `src/daemon/db/management-defaults.ts`\n- **[[c4]]** `code` `src/bin/insrc-connection-maintenance.ts:14-30`\n- **[[c5]]** `code` `src/daemon/threads/channel.ts:117`\n- **[[c6]]** `code` `src/daemon/index.ts:470-476`\n- **[[c7]]** `code` `src/daemon/threads/method-class.ts:142-160`\n- **[[c8]]** `code` `src/shared/daemon-run-files.ts:64`\n- **[[c9]]** `prior-artifact` `ISSUE-fefa97b991537da7`\n- **[[c10]]** `prior-artifact` `LLD-669ae7a31701e106-S001`\n- **[[c11]]** `stakeholder` `Decision A, 2026-11-08` — \"Keep one Keychain item holding everything; accept that each legacy item prompts once when first copied, and that a save may show one more dialog if the first was answered Allow rather than Always Allo\"\n"},"capturedAt":"2026-11-08T12:43:52.675Z"},"inventory":{"units":[{"id":"/body/summary","selector":"/body/summary","title":"summary","kind":"section"},{"id":"/body/hldContextSlice","selector":"/body/hldContextSlice","title":"hldContextSlice","kind":"section"},{"id":"/body/contractDetails","selector":"/body/contractDetails","title":"contractDetails","kind":"section"},{"id":"/body/dataModelChanges","selector":"/body/dataModelChanges","title":"dataModelChanges","kind":"section"},{"id":"/body/interactionWithShared","selector":"/body/interactionWithShared","title":"interactionWithShared","kind":"section"},{"id":"/body/errorPaths","selector":"/body/errorPaths","title":"errorPaths","kind":"section"},{"id":"/body/testStrategy","selector":"/body/testStrategy","title":"testStrategy","kind":"section"},{"id":"/body/migration","selector":"/body/migration","title":"migration","kind":"section"},{"id":"/body/alternativesConsidered","selector":"/body/alternativesConsidered","title":"alternativesConsidered","kind":"section"},{"id":"/body/chosenAlternative","selector":"/body/chosenAlternative","title":"chosenAlternative","kind":"section"},{"id":"/body/openQuestions","selector":"/body/openQuestions","title":"openQuestions","kind":"section"},{"id":"/body/sequenceDefinition","selector":"/body/sequenceDefinition","title":"sequenceDefinition","kind":"visual"},{"id":"/body/companions","selector":"/body/companions","title":"companions","kind":"visual"},{"id":"/body/alternativesConsidered/0","selector":"/body/alternativesConsidered/0","title":"a1","kind":"requirement"},{"id":"/body/alternativesConsidered/1","selector":"/body/alternativesConsidered/1","title":"a2","kind":"requirement"},{"id":"/body/alternativesConsidered/2","selector":"/body/alternativesConsidered/2","title":"a3","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/0","selector":"/body/sequenceDefinition/participants/0","title":"client","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/1","selector":"/body/sequenceDefinition/participants/1","title":"worker","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/2","selector":"/body/sequenceDefinition/participants/2","title":"main","kind":"requirement"},{"id":"/body/sequenceDefinition/participants/3","selector":"/body/sequenceDefinition/participants/3","title":"keychain","kind":"requirement"},{"id":"/citations/0","selector":"/citations/0","title":"Citation 1","kind":"citation"},{"id":"/citations/1","selector":"/citations/1","title":"Citation 2","kind":"citation"},{"id":"/citations/2","selector":"/citations/2","title":"Citation 3","kind":"citation"},{"id":"/citations/3","selector":"/citations/3","title":"Citation 4","kind":"citation"},{"id":"/citations/4","selector":"/citations/4","title":"Citation 5","kind":"citation"},{"id":"/citations/5","selector":"/citations/5","title":"Citation 6","kind":"citation"},{"id":"/citations/6","selector":"/citations/6","title":"Citation 7","kind":"citation"},{"id":"/citations/7","selector":"/citations/7","title":"Citation 8","kind":"citation"},{"id":"/citations/8","selector":"/citations/8","title":"Citation 9","kind":"citation"},{"id":"/citations/9","selector":"/citations/9","title":"Citation 10","kind":"citation"},{"id":"/citations/10","selector":"/citations/10","title":"Citation 11","kind":"citation"},{"id":"document:line:25","selector":"document:line:25","title":"1. HLD context","kind":"section"},{"id":"document:line:208","selector":"document:line:208","title":"4. Diagrams","kind":"section"}]},"completedChunks":[{"chunkId":"scope","status":"changes_requested","summary":"The LLD restores the originating issue’s full scope, preserves standalone ancestry, and carries forward applicable constraints from the prior LLD. Decision A records migration and save exceptions, but the claimed lifetime migration-prompt bound contradicts the specified retry behavior.","findings":[{"id":"scope-002","severity":"MED","location":"/body/summary; /body/alternativesConsidered/0/cons","message":"The design promises that each legacy item prompts only once in its lifetime, but its failure behavior cannot preserve that bound. When a legacy read succeeds and its vault copy fails, the value is cached only for the current run and migration retries next run. If access was granted with Allow, that next legacy read can prompt again. A refused legacy read also retries after five minutes. Citation c11 records acceptance of a prompt when first copying each item, without addressing these repeated attempts, while openQuestions is empty. Qualify the lifetime claim to successful migration and explicitly reconcile retry prompts with the accepted exception, including corresponding acceptance coverage.","evidenceReferences":["docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:11 — once-in-a-lifetime migration exception","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:236 — failed copy caches the value this run and retries next run","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:240 — refused legacy reads retry after five minutes","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:313 — repeats the lifetime prompt bound",".insrc/artifacts/LLD-fefa97b991537da7-s1.json — /citations/10 and /body/openQuestions","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/ISSUE.md — Expected behavior and Fix intent 2"]}],"inspectedReferences":["/body/summary","/body/hldContextSlice","document:line:25","/body/alternativesConsidered","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/alternativesConsidered/2","/body/chosenAlternative","/body/openQuestions","/citations/8","/citations/9","/citations/10","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-fefa97b991537da7-s1.json","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/ISSUE.md","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261105669ae7a3/S001/LLD.md","src/shared/keystore.ts","src/daemon/db/management-defaults.ts","src/daemon/db/management-startup.ts","src/daemon/index.ts:470","src/daemon/handler-runtime.ts:1474","src/bin/insrc-connection-maintenance.ts","node_modules/keytar/src/keytar_mac.cc"],"limitations":[],"advice":[]},{"chunkId":"vault","status":"changes_requested","summary":"Inspected all assigned vault selectors against the originating issue, canonical artifact and current consumers. Mutation serialization, migration caching, retirement and recovery losses are now specified. Runtime mutation validation remains a gap that can turn one malformed IPC save into an unreadable consolidated vault.","findings":[{"id":"vault-005","severity":"MED","location":"/body/contractDetails/api/1; /body/dataModelChanges/0; /body/testStrategy","message":"The design validates the complete payload only on load, but does not require runtime validation of mutation arguments or the candidate payload before persistence. Current keys.set handlers merely cast unknown IPC params; keytar currently rejects non-string account/password arguments. Consolidation removes that protection because keytar receives fixed service/account strings and a serialized JSON string. For example, keys.set with {name:\"brave\",value:42} can persist a numeric secret under the specified write rules, then make the entire vault fail validation on restart, blocking unrelated credentials. Require runtime name/value validation at the vault owner boundary, or equivalent candidate-payload validation before every write, and test malformed IPC saves/deletes leave both memory and persisted content unchanged.","evidenceReferences":["docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:58 — setKey specifies TypeScript arguments and persistence ordering without runtime input validation","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:141 — whole-payload validation occurs on load and rejects non-string secret values","src/daemon/handler-runtime.ts:1474 — keys.set casts params and passes name/value directly to setKey","src/daemon/handler-runtime.ts:1488 — keys.delete likewise relies on a TypeScript cast","src/daemon/server.ts:95 — directDispatch passes request.params to the handler without method-specific validation","node_modules/keytar/src/main.cc:17 — existing native boundary rejects non-string usernames","node_modules/keytar/src/main.cc:25 — existing native boundary rejects non-string passwords",".insrc/artifacts/LLD-fefa97b991537da7-s1.json — /body/testStrategy/testLevels/0 covers malformed stored payloads, but not malformed mutation inputs"]}],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/body/errorPaths","/body/testStrategy","/body/migration","/citations/0","/citations/1","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-fefa97b991537da7-s1.json","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/ISSUE.md","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/rv-fefa97b991537da7-s1.json","docs/standalone/open-saved-connections-demand-read-all-E20261105669ae7a3/S001/LLD.md","src/shared/keystore.ts","src/daemon/db/secrets.ts","src/daemon/handler-runtime.ts:1474","src/daemon/server.ts","src/daemon/tools/config.ts","src/daemon/tools/builtins/notify/index.ts","src/daemon/tools/builtins/web/index.ts","src/daemon/db/management-defaults.ts","src/daemon/db/management-startup.ts","src/bin/insrc-connection-maintenance.ts","src/shared/daemon-run-files.ts","node_modules/keytar/lib/keytar.js","node_modules/keytar/src/main.cc"],"limitations":[],"advice":["Add explicit listKeys compatibility tests for unmigrated, migrated, failed-copy-cached, retired and restored names; the current enumeration test checks only that findCredentials is not called.","Explicitly include duplicate retired names and overlapping secrets/retired membership in malformed-payload fixtures, matching the newly stated validation contract.","The current scope review already records the lifetime migration-prompt contradiction as scope-002. Apply its qualification consistently to migration step 3 and distinguish immediate repository-open retries from Keychain retries after the cooldown."]},{"chunkId":"runtime","status":"passed","summary":"Inspected every assigned selector against the originating ISSUE, applicable prior LLD and current runtime code. The proposed lifecycle, main-thread vault ownership, maintenance guard and below-vault test injection are feasible. No additional blocking defect was demonstrated within this assignment.","findings":[],"inspectedReferences":["/body/contractDetails","/body/dataModelChanges","/body/interactionWithShared","/body/errorPaths","/body/testStrategy","/citations/0","/citations/2","/citations/3","/citations/4","/citations/5","/citations/6","/citations/7","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-fefa97b991537da7-s1.json","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/ISSUE.md","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/rv-fefa97b991537da7-s1.json","docs/standalone/open-saved-connections-demand-read-all-E20261105669ae7a3/S001/LLD.md","src/shared/keystore.ts","src/shared/daemon-run-files.ts","src/shared/daemon-process.ts","src/bin/insrc-connection-maintenance.ts","src/cli/services/connection-maintenance.ts","src/daemon/db/management-defaults.ts","src/daemon/db/management-startup.ts","src/daemon/db/management-tickets.ts","src/daemon/db/management.ts","src/daemon/db/management-adoption.ts","src/daemon/db/secrets.ts","src/daemon/db/pool-cache.ts","src/daemon/db/__tests__/management-defaults.test.ts","src/daemon/connection-management-rpc.ts","src/daemon/connection-session-rpc.ts","src/daemon/db-rpc.ts","src/daemon/handler-runtime.ts:1474","src/daemon/index.ts:468","src/daemon/index.ts:596","src/daemon/server.ts:283","src/daemon/shutdown.ts","src/daemon/run-file-ownership.ts","src/daemon/threads/channel.ts","src/daemon/threads/main-services.ts:207","src/daemon/threads/worker-entry.ts:66","src/daemon/threads/session-worker.ts:57","src/daemon/threads/workers.ts:73","src/daemon/threads/method-class.ts:368","src/daemon/tools/config.ts","src/daemon/tools/builtins/notify/index.ts:18","src/daemon/tools/builtins/web/index.ts:68","node_modules/keytar/src/async.cc"],"limitations":[],"advice":["Expand integration subjects to exercise owner, safeList, legacy listing and save independently; include threads-disabled operation, unrelated-request progress during a held read, repository isolation, concurrent maintenance admission and orphan-guard recovery. The current generic first-management-request subject could exercise capabilities alone.","Specify the hub operation payloads and forwarder error reconstruction explicitly. src/daemon/threads/channel.ts currently transports ordinary errors as name/message-only HubRemoteError instances and drops their cause; the forwarder should deliberately produce the promised KeystoreUnavailableError without worker-local fallback.","Clarify the retry test wording: an immediate request after denial retries the repository opener but receives the cached vault failure; Keychain access retries only after the five-minute cooldown.","Retain the prior LLD's explicit distinction between ticket-key, rollback-copy and connection-secret failures in integration assertions, including fixed client messages and unchanged recovery handling for missing secrets."]},{"chunkId":"visuals","status":"incomplete","summary":"Inspected the complete sequence definition, all four participants, and generated companion source. The companion preserves the authored messages and descriptions, but its legacy-path conditions conflict with the vault contracts. Actual rendering could not be verified.","findings":[{"id":"visuals-002","severity":"MED","location":"/body/sequenceDefinition/messages/4-6","message":"The legacy branch is guarded only by the name being absent from the vault. This also includes retired names and names with cached legacy results, for which the contracts prohibit another legacy lookup. The following copy message additionally lacks the condition that a legacy value was found, although the preceding return explicitly permits no value. The generated companion repeats these conditions. Specify that fallback requires a non-retired name without a reusable run result, and that persistence requires a found value plus the mutation-queue recheck. Otherwise the sequence directs unnecessary Keychain access for deleted or cached names and a write for an absent name, contradicting the deletion and no-write guarantees.","evidenceReferences":[".insrc/artifacts/LLD-fefa97b991537da7-s1.json: /body/sequenceDefinition/messages/4, /5 and /6","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/sequence-diagram.html: embedded Mermaid steps 5–7 and corresponding Messages descriptions","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:161 — cached, absent and retired-name rules","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:258 — absent lookup causes no write","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:261 — retired names must not fall back"]}],"inspectedReferences":["/body/sequenceDefinition","/body/sequenceDefinition/participants/0","/body/sequenceDefinition/participants/1","/body/sequenceDefinition/participants/2","/body/sequenceDefinition/participants/3","/body/companions","document:line:208","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-fefa97b991537da7-s1.json","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/ISSUE.md","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/sequence-diagram.html","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/rv-fefa97b991537da7-s1.json","src/daemon/db/management-defaults.ts","src/daemon/db/management-startup.ts","src/daemon/threads/method-class.ts","src/shared/keystore.ts"],"limitations":["Mandatory rendered inspection of /Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/sequence-diagram.html could not be completed: opening the companion through the browser tool returned 'The browser access host is unavailable'. Source and retained descriptions were inspected; layout, readability and successful diagram rendering remain unverified."],"advice":["Consider extending the sequence with the main-thread on-demand management-opening path and annotating the mutually exclusive offline maintenance owner. Those boundaries are described in the surrounding contracts but are outside this diagram's stated secret-read scope.","Clarify the Keychain participant description: legacy items remain after successful copying until explicitly deleted, rather than existing only 'until copied'."]},{"chunkId":"consistency","status":"incomplete","summary":"Reconciled the current LLD, originating ISSUE, applicable prior design, canonical content, generated companion source and all four accepted substantive reviews. Six prior findings are resolved by freshly inspected contracts; the scope finding is superseded by the current prompt-bound finding. The prior visual finding remains carried because fresh visual inspection has a mandatory rendering gap. Current substantive findings require changes; unavailable rendered verification makes the overall consistency result incomplete.","findings":[],"inspectedReferences":["/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/rv-fefa97b991537da7-s1.json","/Users/subhagho/work/projects/insors/insrc/.insrc/artifacts/LLD-fefa97b991537da7-s1.json","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/ISSUE.md","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261105669ae7a3/S001/LLD.md","/Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/sequence-diagram.html","src/shared/keystore.ts","src/shared/daemon-run-files.ts","src/bin/insrc-connection-maintenance.ts","src/daemon/handler-runtime.ts:1474","src/daemon/db/management-defaults.ts","src/daemon/db/management-startup.ts","node_modules/keytar/src/main.cc"],"limitations":["Mandatory rendered verification of /Users/subhagho/work/projects/insors/insrc/docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/sequence-diagram.html remains incomplete. The accepted fresh visuals chunk reports that browser access failed with 'The browser access host is unavailable'. This consistency inspection verified the embedded Mermaid and description tables, which cannot establish successful rendering, layout or readability. Consequently, visuals-001 cannot be resolved or superseded using the incomplete fresh visual inspection."],"advice":["Retain current findings scope-002, vault-005 and visuals-002 without duplicating them here. They respectively cover contradictory migration prompt bounds, malformed mutation inputs capable of corrupting the consolidated vault, and legacy sequence conditions inconsistent with retirement and cached-result contracts.","Apply scope-002 consistently to the summary, alternative a1, migration step 3, sequence narrative and generated message descriptions. Distinguish successful migration from failed-copy retries on later runs and refused-read retries after five minutes.","The repository opener's immediate retry and the keystore's five-minute cooldown can coexist: an immediate request retries opening but receives the cached keystore failure. Make this distinction explicit in the integration subject and acceptance mapping.","Preserve the runtime review's optional coverage recommendations for individual management entry points, unrelated-request progress, repository isolation and guard recovery. Preserve the vault review's enumeration and malformed-payload fixture recommendations.","The prior narrowed LLD supplies applicable lifecycle and error-handling constraints, but its earlier scope split does not limit this full-scope replacement. Decision A now records the migration and save exceptions; scope-002 identifies the remaining inconsistency in their stated bound."],"findingDecisions":[{"source":{"attempt":1,"chunkId":"scope","findingId":"scope-001"},"rationale":"Fresh scope inspection confirms that citation c11 and the summary now explicitly capture stakeholder decision A accepting legacy migration and save prompts. This addresses the original absence of an authorized exception. The remaining inaccurate lifetime bound is assessed by the real current replacement scope-002.","evidenceReferences":[".insrc/artifacts/LLD-fefa97b991537da7-s1.json: /citations/10 and /body/summary","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:11",".insrc/tmp/design-review/rv-fefa97b991537da7-s1.json: attempt 2 completedChunks scope, scope-002; limitations empty"],"action":"superseded","reviewedInChunkIds":["scope"],"supersededBy":{"chunkId":"scope","findingId":"scope-002"}},{"source":{"attempt":1,"chunkId":"vault","findingId":"vault-001"},"rationale":"The current design puts migration copies, saves and deletes in one mutation queue, requires a fresh vault/retirement check before copying, and specifies per-name single-flight reads. Its test strategy now includes concurrent misses and migration interleavings with saves and deletes. Fresh vault inspection has no mandatory gaps.","evidenceReferences":["docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:152","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:161","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:283",".insrc/tmp/design-review/rv-fefa97b991537da7-s1.json: attempt 2 completedChunks vault"],"action":"resolved","reviewedInChunkIds":["vault"]},{"source":{"attempt":1,"chunkId":"vault","findingId":"vault-002"},"rationale":"Per-name run state now distinguishes in-flight lookup, copied value, cached value after failed persistence, absence and failed read with cooldown. Successful mutations clear the state. Repeated failed-copy reads and refused legacy-read cooldowns have explicit test subjects. This resolves the missing subsequent-read behavior.","evidenceReferences":["docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:161","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:236","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:283",".insrc/tmp/design-review/rv-fefa97b991537da7-s1.json: attempt 2 completedChunks vault"],"action":"resolved","reviewedInChunkIds":["vault"]},{"source":{"attempt":1,"chunkId":"vault","findingId":"vault-003"},"rationale":"Load validation now requires version 1, string-valued secrets, unique string retirement entries and disjoint membership. Map storage handles arbitrary account names, and malformed stored payloads have fail-closed test subjects. The current vault-005 concerns a distinct mutation-input boundary and does not invalidate resolution of this stored-payload validation defect.","evidenceReferences":["docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:141","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:220","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:283",".insrc/tmp/design-review/rv-fefa97b991537da7-s1.json: attempt 2 completedChunks vault"],"action":"resolved","reviewedInChunkIds":["vault"]},{"source":{"attempt":1,"chunkId":"vault","findingId":"vault-004"},"rationale":"Migration now explicitly describes abandonment as data-losing recovery, including loss of new secrets, reversion of changed legacy values and resurrection after failed legacy deletion. Steps 3 and 4 are marked non-rollbackable, with the mutation boundary caveat stated. Fresh vault inspection confirms the misleading recovery claims are corrected.","evidenceReferences":["docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:187","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:313","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:314",".insrc/tmp/design-review/rv-fefa97b991537da7-s1.json: attempt 2 completedChunks vault"],"action":"resolved","reviewedInChunkIds":["vault"]},{"source":{"attempt":1,"chunkId":"runtime","findingId":"runtime-001"},"rationale":"The maintenance process now acquires the global guard before checking daemon control files and holds it through exit. Daemon vault loading occurs after socket publication and checks for that guard first. This ordering excludes simultaneous snapshots; atomic guard acquisition also excludes concurrent maintenance owners. Conflict, release and crash behavior are specified, with integration subjects. Fresh runtime inspection finds the protocol feasible without mandatory gaps.","evidenceReferences":["docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:178","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:224","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:286","src/shared/daemon-run-files.ts: acquireRunFileGuard and runFileGuardConflict",".insrc/tmp/design-review/rv-fefa97b991537da7-s1.json: attempt 2 completedChunks runtime"],"action":"resolved","reviewedInChunkIds":["runtime"]},{"source":{"attempt":1,"chunkId":"runtime","findingId":"runtime-002"},"rationale":"The test design replaces the above-vault database-port fixture with backend injection below the vault. A node --import preload installs it in spawned daemon and maintenance processes and rejects backend calls from workers. This exercises shared consumers and owner routing instead of bypassing the implementation. Fresh runtime inspection accepts its feasibility.","evidenceReferences":["docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:282","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:285","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/LLD.md:287",".insrc/tmp/design-review/rv-fefa97b991537da7-s1.json: attempt 2 completedChunks runtime"],"action":"resolved","reviewedInChunkIds":["runtime"]},{"source":{"attempt":1,"chunkId":"visuals","findingId":"visuals-001"},"rationale":"Current source qualifies the copied-name path and adds legacy messages, but the accepted fresh visuals inspection remains incomplete because rendering was unavailable. It also identifies incorrect legacy conditions as visuals-002. Preserve the prior origin unresolved rather than treating source revision intent or an inspection with mandatory gaps as sufficient resolution or supersession.","evidenceReferences":[".insrc/artifacts/LLD-fefa97b991537da7-s1.json: /body/sequenceDefinition","docs/standalone/open-saved-connections-demand-read-all-E20261104fefa97b9/S001/sequence-diagram.html: embedded Mermaid and Messages table",".insrc/tmp/design-review/rv-fefa97b991537da7-s1.json: attempt 2 completedChunks visuals, visuals-002 and rendering limitation"],"action":"carry"}]}],"progress":{"status":"incomplete","phase":"complete","completedChunks":5,"totalChunks":5,"lastMeaningfulActivityAt":null,"activeToolCount":0,"requiresUserInput":false,"checkpointPath":"/Users/subhagho/work/projects/insors/insrc/.insrc/tmp/design-review/rv-fefa97b991537da7-s1.json","sequence":0,"reviewElapsedMs":0,"unitElapsedMs":null,"observedAt":"2026-11-08T12:55:35.353Z","freshness":"stored"},"startedAt":"2026-11-08T12:43:52.685Z","reviewer":"daemon","model":"gpt-6.1-sol","unit":{"unitId":"consistency","phase":"chunk_review","executionId":"d97c1efe-c5aa-47a5-8306-6cb441d38e88","dispatches":2,"retriesUsed":1,"userDirectedDispatches":0,"diagnostics":[{"code":"invalid_output","summary":"Resolution requires accepted fresh inspection without mandatory gaps"}]},"plan":{"chunks":[{"id":"scope","title":"Issue requirements, scope and architectural choice","selectors":["/body/summary","/body/hldContextSlice","document:line:25","/body/alternativesConsidered","/body/alternativesConsidered/0","/body/alternativesConsidered/1","/body/alternativesConsidered/2","/body/chosenAlternative","/body/openQuestions","/citations/8","/citations/9","/citations/10"],"concerns":["Compare the LLD aga