  "body": {
    "title": "Add requirementsPath + noDeps fields to pkgAuditTool's inputSchema and auditArgv",
    "summary": "Add two optional inputSchema fields to pkgAuditTool (src/daemon/tools/builtins/pkg/index.ts): requirementsPath?: string and noDeps?: boolean. auditArgv gains the same two parameters: appends `-r <requirementsPath>` for pip/pipenv/poetry when provided, and `--no-deps` when noDeps is true. Both additive; omitted, every existing caller's behavior and argv is byte-for-byte unchanged.",
    "size": "S",
    "order": 1,
    "acceptanceChecks": [
      "auditArgv('pip', {requirementsPath:'/tmp/x.txt'}) includes '-r /tmp/x.txt' in argv",
      "auditArgv('pip', {noDeps:true}) includes '--no-deps' in argv",
      "auditArgv('npm') with no new params produces the identical argv as today (no requirementsPath/noDeps leakage into unrelated managers)",
      "pkgAuditTool's inputSchema declares both new fields as optional"
    ],
    "tests": [
      {
        "level": "unit",
        "name": "pkgAuditTool.execute: noDeps:true -> argv includes --no-deps"
      },
      {
        "level": "unit",
        "name": "pkgAuditTool.execute: noDeps omitted/false -> argv is identical to today"
      },
      {
        "level": "unit",
        "name": "auditArgv('pip', {requirementsPath}) appends -r <requirementsPath>"
      },
      {
        "level": "unit",
        "name": "auditArgv('npm') with no new params is unchanged from today"
      }
    ],
    "planTaskId": "t1"
  },
