  "body": {
    "title": "Implement the supervisor child lifecycle",
    "summary": "Build the per-user parent state machine, pinned child spawn, inherited channel, start/stop deadlines, exact escalation and reap, confirmed receipts and predecessor-bound replay. Start the supervisor idle and require journaled predecessor evidence during replacement.",
    "size": "M",
    "order": 4,
    "acceptanceChecks": [
      "A hung or partially initialized child cannot be replaced before exact reap",
      "An old stop or readiness frame cannot act on a newer generation"
    ],
    "tests": [
      {
        "level": "unit",
        "name": "Monotonic deadline, repeated requests and grace versus forced outcome"
      },
      {
        "level": "unit",
        "name": "Supervisor classifies idle stop, unavailable runtime, and confirmed failed exit"
      },
      {
        "level": "unit",
        "name": "Late ready cannot beat startup timeout or allow replacement before confirmed reap"
      },
      {
        "level": "integration",
        "name": "Delayed controller cannot stop the replacement generation"
      },
      {
        "level": "integration",
        "name": "Fresh supervisor first start requires durable predecessor evidence and an admitted owner"
      }
    ],
