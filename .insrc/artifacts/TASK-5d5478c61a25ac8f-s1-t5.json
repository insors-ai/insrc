      {
        "level": "unit",
        "name": "Uncertain publication with durable success versus no outcome"
      },
      {
        "level": "integration",
        "name": "Startup guard transfer, candidate bootstrap failure, rollback and repeated recovery"
      },
      {
        "level": "integration",
        "name": "Rollback restores an idle job without launching and refuses unqualified RunAtLoad"
      }
