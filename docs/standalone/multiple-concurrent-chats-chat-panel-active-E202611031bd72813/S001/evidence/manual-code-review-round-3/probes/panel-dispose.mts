import {createDocsReviewHost} from '../../../../../../../vscode-plugin/src/chat/docs-review-panel.ts';
const panels:any[]=[];let calls=0;const docs=['LLD-a','LLD-b'].map(id=>({id,kind:'LLD',title:id}));
const host=createDocsReviewHost({pollMs:0,client:{pending:async()=>docs,content:async(id:string)=>({markdown:'# '+id,docPath:'docs/'+id+'.md',blocked:false,openQuestions:[]}),decide:async()=>{calls++;return{artifactId:'LLD-b',outcome:'approved',recorded:true};}} as any,logger:{warn(){},error(){}},createPanel(){const p:any={posted:[]};panels.push(p);return{setHtml(){},postMessage(m:any){p.posted.push(m.payload);},onMessage(fn:any){p.send=fn;},onDidDispose(fn:any){p.dispose=fn;},reveal(){},dispose(){p.dispose?.();}};}});
const tick=()=>new Promise(r=>setTimeout(r,15));
try{host.open();host.openArtifact({artifactId:'LLD-a',mdPath:'docs/A.md',presentKey:'A'});host.openArtifact({artifactId:'LLD-b',mdPath:'docs/B.md',presentKey:'B'});await tick();await tick();const b=panels[2];const before=b.posted.filter((x:any)=>x.type==='docs-content').length;panels[0].dispose();b.send({v:1,payload:{type:'open-doc',artifactId:''}});await tick();b.send({v:1,payload:{type:'docs-decision',artifactId:'LLD-b',decision:'approve',comments:[]}});await tick();console.log(JSON.stringify({survivingPanelContentBefore:before,survivingPanelContentAfter:b.posted.filter((x:any)=>x.type==='docs-content').length,decisionReachedDaemon:calls,decisionReplies:b.posted.filter((x:any)=>x.type==='docs-decision-result').length}));}finally{host.dispose();}
