import {createChatPanelHost} from '../../../../../../../vscode-plugin/src/chat/chat-panel.ts';
import {createInMemoryChatSessionStore} from '../../../../../../../vscode-plugin/src/chat/session-store.ts';
import {fakeLiveProc} from '../../../../../../../vscode-plugin/src/chat/__tests__/fixtures.ts';
let send:any,onDispose=()=>{},n=0;const runs:any[]=[];const decisions:any[]=[];const posted:any[]=[];const store=createInMemoryChatSessionStore();
const ad:any={capabilities:{resume:false},decide(turnId:any,requestId:any){decisions.push({turnId,requestId,delivered:false});return{delivered:false};},cancel(){},async *run(req:any,opts:any){const i=++n;runs.push({sessionId:opts.sessionId,prompt:req.prompt});const p=fakeLiveProc(4300+i);opts.onSpawn?.({...p,cursor:{sessionId:opts.sessionId,turnId:'t'+i,generation:1,offset:0}});if(i%2===1){yield{kind:'approval-request',turnId:'t'+i,requestId:'shared',title:'action '+i,detail:'permission',command:'command-'+i,resolution:'in-turn'};await new Promise(r=>setTimeout(r,50));}p.exitNow();yield{kind:'done',turnId:'t'+i,ok:true};}};
const host=createChatPanelHost({createPanel:()=>({setHtml(){},postMessage(m:any){posted.push(m.payload);},onMessage(fn:any){send=fn;},onDidDispose(fn:any){onDispose=fn;},reveal(){},dispose(){onDispose();}}),store,providers:{available:['claude'],get(){return ad;}} as any,cwd:()=>'/repo',hostPid:77,isAlive:()=>false,processStartTime:()=>1});
const wait=async(fn:any)=>{for(let i=0;i<400;i++){if(fn())return;await new Promise(r=>setTimeout(r,5));}throw Error('wait timed out');};
try{host.open();send({v:1,payload:{type:'submit-turn',text:'first'}});await wait(()=>posted.filter(x=>x.event?.kind==='approval-request').length===1);const id=store.list()[0]!.id;send({v:1,payload:{type:'permission-decision',requestId:'shared',decision:'approve'}});await wait(()=>runs.length===2&&store.get(id)?.liveTurn===undefined);send({v:1,payload:{type:'submit-turn',text:'second'}});await wait(()=>posted.filter(x=>x.event?.kind==='approval-request').length===2);send({v:1,payload:{type:'permission-decision',requestId:'shared',decision:'approve'}});await new Promise(r=>setTimeout(r,120));console.log(JSON.stringify({expectedRuns:4,actualRuns:runs.length,decisions,runs,pending:store.get(id)?.pendingRequests}));}finally{host.dispose();}
