<idea-plugin>
    <id>ai.insors.insrc</id>
    <name>insrc</name>
    <vendor url="https://github.com/insors-ai/insrc">insors-ai</vendor>

    <description><![CDATA[
        Brings the insrc code-knowledge system into the JetBrains IDE family
        (IntelliJ IDEA, PyCharm, GoLand, WebStorm). A thin orchestrator that wires
        insrc's grounded-analyze and tracked-workflow capabilities into the IDE's
        own AI assistant and manages the backing daemon — it owns no reasoning of
        its own.
    ]]></description>

    <!--
      Depend ONLY on the common platform module (Story S001 / lc1, ac3): this is
      what makes the SINGLE artifact load and activate in IntelliJ IDEA, PyCharm,
      GoLand, and WebStorm alike. Do NOT add an IDE-specific module dependency
      (e.g. com.intellij.modules.java / .python / .go) — that would restrict the
      artifact to one IDE and break the single-integration guarantee.
    -->
    <depends>com.intellij.modules.platform</depends>

    <!--
      sc1 project-open lifecycle (Story S001 / t2): a ProjectActivity that fires
      onProjectOpened once per opened project, off the UI thread.
    -->
    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity
            implementation="ai.insors.insrc.jetbrains.platform.InsrcProjectOpenActivity"/>
    </extensions>

    <!--
      sc1 uninstall lifecycle (Story S001 / t2): register the plugin-state
      listener at app start so onPluginUninstalled fires on a true uninstall
      (never on a mere disable).
    -->
    <applicationListeners>
        <listener
            class="ai.insors.insrc.jetbrains.platform.InsrcAppLifecycle"
            topic="com.intellij.ide.AppLifecycleListener"/>
    </applicationListeners>
</idea-plugin>
