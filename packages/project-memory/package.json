{
  "name": "@insrc/project-memory",
  "version": "0.1.0",
  "description": "Independent embedded project-memory foundation",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.1 <23"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/host-node.d.ts",
      "import": "./dist/host-node.js"
    }
  },
  "files": [
