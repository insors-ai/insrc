#!/bin/bash
# Copyright (c) Procix Software India. Licensed under the MIT License.
set -euo pipefail
unset NODE_OPTIONS NODE_PATH
SELF="${BASH_SOURCE[0]}"
links=0
while [ -L "$SELF" ]; do
  links=$((links + 1)); [ "$links" -le 32 ] || { echo 'insrc launcher link cycle' >&2; exit 2; }
  HERE="$(cd "$(/usr/bin/dirname "$SELF")" && pwd -P)"
  link=$(/usr/bin/readlink "$SELF")
  case "$link" in /*) SELF="$link" ;; *) SELF="$HERE/$link" ;; esac
done
ROOT="$(cd "$(/usr/bin/dirname "$SELF")/.." && pwd -P)"
USER_CWD="$PWD"
[ -f "$ROOT/scripts/node-runtime-env.sh" ] || { echo 'Runtime bootstrap assets missing; reinstall using the matching packaged installer.' >&2; exit 2; }
. "$ROOT/scripts/node-runtime-env.sh"
MODE=
[ -e "$ROOT/.git" ] || MODE=bootstrap
insrc_source_toolchain "$ROOT/scripts" "$HOME/.insrc" "" "$MODE" || exit 2
if [ ! -e "$ROOT/.git" ]; then
  [ -f "$ROOT/scripts/verify-installed-runtime.mjs" ] || { echo 'Packaged runtime verifier missing; repair using the authenticated installer.' >&2; exit 2; }
  # The bootstrap runtime verifies the retained signed fingerprint BEFORE the
  # packaged runtime is executed. It never substitutes for the managed runtime.
  NODE_BIN=$("$NODE_BIN" "$ROOT/scripts/verify-installed-runtime.mjs" "$ROOT" "$HOME/.insrc") || exit 2
fi
[ -f "$ROOT/out/bin/insrc-mcp.js" ] || { echo 'Built MCP entry missing; rebuild before launching.' >&2; exit 2; }
exec "$NODE_BIN" "$ROOT/out/bin/insrc-mcp.js" "$@"
