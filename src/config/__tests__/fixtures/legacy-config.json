{
  "logLevel": "info",
  "ollama": {
    "host": "http://localhost:11434"
  },
  "models": {
    "local": "qwen3-coder:latest",
    "embedding": "qwen3-embedding:0.6b",
    "embeddingDim": "1024",
    "tiers": {
      "fast": "claude-haiku-4-5",
      "standard": "claude-sonnet-4-6",
      "powerful": "claude-opus-4-6"
    },
    "context": {
      "local": 16384,
      "localMaxOutput": 8192,
      "claude": 200000,
      "claudeMaxOutput": 8192,
      "charsPerToken": 3
    },
    "analyze": {
      "shaperProvider": "cli-claude",
      "roleTiers": {
        "design.hld.synthesize": "core",
        "review.claims.enumerate": "mid",
        "tracker.render": "cheap"
      },
      "byRepo": {
        "/Users/redacted/work/projects/example/repo": {
          "shaperProvider": "cli-claude",
          "coreFloor": "core"
        }
      }
    },
    "agents": {
      "implementation": {
        "propose": "cli-claude",
        "review": "cli-claude"
      }
    }
  },
  "permissions": {
    "mode": "validate"
  },
  "routing": {
    "mode": "static"
  },
  "legacyOrphanKey": "kept-blindly"
}
