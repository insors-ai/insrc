              "core"
            ],
            "default": "mid",
            "markdownDescription": "Model tier for the `design.framework.write` role (peripheral). Leave at the default to use the daemon's routing.",
            "scope": "machine"
          },
          "insrc.models.tasks.design.rollout.overview": {
            "type": "string",
            "enum": [
              "cheap",
              "mid",
              "core"
            ],
            "default": "mid",
            "markdownDescription": "Model tier for the `design.rollout.overview` role (peripheral). Leave at the default to use the daemon's routing.",
            "scope": "machine"
          },
          "insrc.models.tasks.synthesize": {
