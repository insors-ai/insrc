  "scripts": {
    "sync-assets": "cp ../scripts/insrc-daemon-install.sh assets/insrc-daemon-install.sh && cp ../src/prompts/steering-block.md assets/steering-block.md",
    "bundle": "npm run sync-assets && node esbuild.mjs",
    "build": "npm run sync-assets && tsc -p tsconfig.json",
    "test": "tsx --test 'src/**/__tests__/*.test.ts'",
    "vscode:prepublish": "tsc -p tsconfig.json && npm run bundle",
    "package": "npx --yes @vscode/vsce@3.2.1 package",
    "vscode:uninstall": "node ./out/uninstall.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
