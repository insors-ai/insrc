            ],
            "default": "mid",
            "markdownDescription": "Model tier for the `design.error.paths` role (peripheral). Leave at the default to use the daemon's routing.",
            "scope": "machine"
          },
          "insrc.models.tasks.design.test.strategy": {
            "type": "string",
            "enum": [
              "cheap",
              "mid",
              "core"
            ],
            "default": "mid",
            "markdownDescription": "Model tier for the `design.test.strategy` role (peripheral). Leave at the default to use the daemon's routing.",
            "scope": "machine"
          },
          "insrc.models.tasks.design.migration.write": {
            "type": "string",
            "enum": [
              "cheap",
              "mid",
              "core"
            ],
            "default": "mid",
            "markdownDescription": "Model tier for the `design.migration.write` role (peripheral). Leave at the default to use the daemon's routing.",
            "scope": "machine"
          },
          "insrc.models.tasks.design.framework.write": {
            "type": "string",
            "enum": [
