            "enum": [
              "cheap",
              "mid",
              "core"
            ],
            "default": "mid",
            "markdownDescription": "Model tier for the `synthesize` role (peripheral). Leave at the default to use the daemon's routing.",
            "scope": "machine"
          },
          "insrc.models.tasks.workflow.questions": {
