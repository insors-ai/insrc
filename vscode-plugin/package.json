{
  "name": "insrc-vscode",
  "displayName": "insrc",
  "description": "insrc for VS Code — grounded code-knowledge and the tracked workflow, wired into your AI assistant.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "insrc.daemon.install", "title": "Install daemon", "category": "insrc" },
      { "command": "insrc.daemon.start", "title": "Start daemon", "category": "insrc" },
      { "command": "insrc.daemon.stop", "title": "Stop daemon", "category": "insrc" },
      { "command": "insrc.daemon.restart", "title": "Restart daemon", "category": "insrc" },
      { "command": "insrc.daemon.update", "title": "Update daemon", "category": "insrc" },
      { "command": "insrc.hosts.wire", "title": "Wire AI hosts", "category": "insrc" },
      { "command": "insrc.workspace.register", "title": "Register workspace", "category": "insrc" }
    ]
  },
  "scripts": {
    "sync-assets": "cp ../scripts/insrc-daemon-install.sh assets/insrc-daemon-install.sh && cp ../src/prompts/steering-block.md assets/steering-block.md",
    "build": "npm run sync-assets && tsc -p tsconfig.json",
    "test": "tsx --test 'src/**/__tests__/*.test.ts'",
    "vscode:uninstall": "node ./out/uninstall.js"
  }
}
