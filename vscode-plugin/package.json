            "type": "string",
            "enum": [
              "cheap",
              "mid",
              "core"
            ],
            "default": "core",
            "markdownDescription": "Model tier for the `define.stories.compose` role (critical). Leave at the default to use the daemon's routing.",
            "scope": "machine"
          },
          "insrc.models.tasks.context.assemble": {
            "type": "string",
            "enum": [
              "cheap",
              "mid",
              "core"
            ],
            "default": "mid",
            "markdownDescription": "Model tier for the `context.assemble` role (peripheral). Leave at the default to use the daemon's routing.",
            "scope": "machine"
          },
          "insrc.models.tasks.design.decompose": {
            "type": "string",
            "enum": [
              "cheap",
              "mid",
              "core"
            ],
            "default": "mid",
            "markdownDescription": "Model tier for the `design.decompose` role (peripheral). Leave at the default to use the daemon's routing.",
            "scope": "machine"
          },
          "insrc.models.tasks.design.error.paths": {
