            ],
            "default": "core",
            "markdownDescription": "Model tier for the `review` role (critical). Leave at the default to use the daemon's routing.",
            "scope": "machine"
          },
          "insrc.models.tasks.build": {
            "type": "string",
            "enum": [
              "cheap",
              "mid",
              "core"
            ],
            "default": "core",
            "markdownDescription": "Model tier for the `build` role (critical). Leave at the default to use the daemon's routing.",
            "scope": "machine"
          },
          "insrc.models.tasks.define.scope.assess": {
            "type": "string",
            "enum": [
              "cheap",
