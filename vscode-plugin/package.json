              "core"
            ],
            "default": "core",
            "markdownDescription": "Model tier for the `define.scope.assess` role (critical). Leave at the default to use the daemon's routing.",
            "scope": "machine"
          },
          "insrc.models.tasks.define.epic.frame": {
            "type": "string",
            "enum": [
              "cheap",
              "mid",
              "core"
            ],
            "default": "core",
            "markdownDescription": "Model tier for the `define.epic.frame` role (critical). Leave at the default to use the daemon's routing.",
            "scope": "machine"
          },
